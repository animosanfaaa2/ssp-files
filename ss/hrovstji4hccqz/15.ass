Dialogue: 0,0:00:09.80,0:00:12.59,Default,,0,0,0,,Hadi hesaplaşalım baba.
Dialogue: 0,0:00:17.80,0:00:20.18,Default,,0,0,0,,EVE HOŞ GELDİNİZ\NYOZAKURA AİLESİ DİRİLİŞ PARTİSİ
Dialogue: 0,0:00:23.10,0:00:25.65,Default,,0,0,0,,Pekâlâ, kardeş kavgasını başlatalım.
Dialogue: 0,0:00:26.19,0:00:28.69,Default,,0,0,0,,Daha bayılmadınız demek.
Dialogue: 0,0:00:28.77,0:00:30.32,Default,,0,0,0,,Çok iyi eğitilmişsiniz.
Dialogue: 0,0:00:31.49,0:00:33.49,Default,,0,0,0,,"İyi eğitilmişsin" saçmalığını kes.
Dialogue: 0,0:00:34.03,0:00:38.12,Default,,0,0,0,,Beynin yıkanmış olmasına rağmen\Nbizi düşünerek kendini tuttun.
Dialogue: 0,0:00:39.16,0:00:42.54,Default,,0,0,0,,Sürüklemek zorunda kalsak bile\Nseni eve götüreceğiz. Pislik abi!
Dialogue: 0,0:00:43.41,0:00:45.25,Default,,0,0,0,,Ciddileşeceğim.
Dialogue: 0,0:00:51.67,0:00:53.38,Default,,0,0,0,,{\i1}Dinle Taiyo.{\i0}
Dialogue: 0,0:00:53.88,0:00:56.51,Default,,0,0,0,,{\i1}Abi Shinzo'yu kurtarmanın{\i0}\N{\i1}tek bir yolu var.{\i0}
Dialogue: 0,0:00:57.51,0:00:58.93,Default,,0,0,0,,{\i1}O da…{\i0}
Dialogue: 0,0:00:59.01,0:01:01.52,Default,,0,0,0,,Benim ona dokunmam.
Dialogue: 0,0:01:01.60,0:01:02.93,Default,,0,0,0,,Dokunmak mı?
Dialogue: 0,0:01:03.43,0:01:07.85,Default,,0,0,0,,İkisini ele geçiren güçte bir beyin yıkama\Nilaçla tersine çevrilemez.
Dialogue: 0,0:01:09.11,0:01:13.49,Default,,0,0,0,,Ona dokunmayı başarırsam bir şekilde\Nbunu yapmanın bir yolunu bulurum.
Dialogue: 0,0:01:14.11,0:01:18.49,Default,,0,0,0,,{\i1}Tamamdır. Kengo'nun ona dokunabilmesi için{\i0}\N{\i1}ne gerekiyorsa yapacağım.{\i0}
Dialogue: 0,0:01:18.57,0:01:20.95,Default,,0,0,0,,{\i1}Ama çok dikkatli olmalısın.{\i0}
Dialogue: 0,0:01:21.03,0:01:22.95,Default,,0,0,0,,{\i1}Çünkü abinin Çiçek Açma yeteneği…{\i0}
Dialogue: 0,0:01:24.00,0:01:25.04,Default,,0,0,0,,{\i1}Yıkım demektir.{\i0}
Dialogue: 0,0:01:26.46,0:01:29.63,Default,,0,0,0,,{\i1}Karşısına kim çıkarsa çıksın,{\i0}\N{\i1}onu bir anda yok edebilir.{\i0}
Dialogue: 0,0:01:30.29,0:01:32.67,Default,,0,0,0,,{\i1}Kengo'nun boynu zayıf, bu onu alt eder.{\i0}
Dialogue: 0,0:01:33.21,0:01:36.84,Default,,0,0,0,,{\i1}Aslında daha sert yaparsam{\i0}\N{\i1}kafasını uçurur.{\i0}
Dialogue: 0,0:01:36.93,0:01:40.35,Default,,0,0,0,,{\i1}Doğrudan üzerine gidersem{\i0}\N{\i1}beni tek darbede indirir.{\i0}
Dialogue: 0,0:01:40.43,0:01:41.97,Default,,0,0,0,,{\i1}Diğer yandan…{\i0}
Dialogue: 0,0:01:42.56,0:01:44.93,Default,,0,0,0,,{\i1}İlk darbeyi karşılayabilirim.{\i0}
Dialogue: 0,0:01:45.60,0:01:48.77,Default,,0,0,0,,{\i1}Geri savruldukları anda{\i0}\N{\i1}yer mi değiştirdiler yani?{\i0}
Dialogue: 0,0:01:50.40,0:01:51.40,Default,,0,0,0,,Dur bakalım.
Dialogue: 0,0:01:53.11,0:01:55.44,Default,,0,0,0,,{\i1}Çiçek Açma yeteneğin bir Özümseme.{\i0}
Dialogue: 0,0:01:55.53,0:01:58.49,Default,,0,0,0,,{\i1}Muhtemelen zihnimi okuyarak{\i0}\N{\i1}bir şey yapmayı planlıyorsunuz.{\i0}
Dialogue: 0,0:01:58.57,0:02:01.91,Default,,0,0,0,,{\i1}Beni yenmeyi umabilmenizin tek yolu bu.{\i0}
Dialogue: 0,0:02:01.99,0:02:02.99,Default,,0,0,0,,{\i1}Ama…{\i0}
Dialogue: 0,0:02:05.08,0:02:07.79,Default,,0,0,0,,Karşı hamle yapabilen\Nbir tek siz değilsiniz!
Dialogue: 0,0:02:08.50,0:02:10.79,Default,,0,0,0,,Tek bir yanlış hamlede dağılırsın.
Dialogue: 0,0:02:10.88,0:02:12.13,Default,,0,0,0,,Kımıldama, olur mu?
Dialogue: 0,0:02:24.18,0:02:26.43,Default,,0,0,0,,Sertleşmek harika bir Çiçek Açma türüdür.
Dialogue: 0,0:02:26.93,0:02:29.06,Default,,0,0,0,,Ama hâlâ gelişmen gereken noktalar var.
Dialogue: 0,0:02:36.69,0:02:40.20,Default,,0,0,0,,{\i1}İkisini de yok etmeden önce{\i0}\N{\i1}durabildiğime sevindim.{\i0}
Dialogue: 0,0:02:41.37,0:02:44.24,Default,,0,0,0,,Bana zaman kazandırdığın için\Nteşekkürler Taiyo!
Dialogue: 0,0:02:44.33,0:02:46.87,Default,,0,0,0,,Bütün bebek koleksiyonum, tam bin tane!
Dialogue: 0,0:02:46.95,0:02:49.58,Default,,0,0,0,,Onları kullanırsam parçalanırlar
Dialogue: 0,0:02:49.67,0:02:52.04,Default,,0,0,0,,Onları sana sunuyorum abi!
Dialogue: 0,0:02:52.58,0:02:54.21,Default,,0,0,0,,Bir protez!
Dialogue: 0,0:02:54.29,0:02:57.17,Default,,0,0,0,,Hadi bakalım! İşte en üst düzey dönüşümüm!
Dialogue: 0,0:02:57.26,0:03:00.09,Default,,0,0,0,,Mega Kengo Yumruğu!
Dialogue: 0,0:03:23.91,0:03:28.83,Default,,0,0,0,,MISSION: YOZAKURA FAMILY
Dialogue: 0,0:04:45.78,0:04:47.70,Default,,0,0,0,,{\i1}Gemiden fırlatıldım!{\i0}
Dialogue: 0,0:04:52.62,0:04:54.87,Default,,0,0,0,,{\i1}Suyun altında hareket etmek zor.{\i0}
Dialogue: 0,0:04:54.96,0:04:56.75,Default,,0,0,0,,{\i1}Şaşkın ve gerginsin.{\i0}
Dialogue: 0,0:04:57.25,0:04:59.96,Default,,0,0,0,,{\i1}Tüm bunları bu ana gelmek için yaptık.{\i0}
Dialogue: 0,0:05:01.42,0:05:03.09,Default,,0,0,0,,{\i1}Bekle abi.{\i0}
Dialogue: 0,0:05:03.84,0:05:05.84,Default,,0,0,0,,{\i1}Seni eve götürüyoruz.{\i0}
Dialogue: 0,0:05:08.60,0:05:12.72,Default,,0,0,0,,{\i1}Çiçek Açma yeteneğim Özümseme,{\i0}\N{\i1}sadece birinin anılarına girmek değil.{\i0}
Dialogue: 0,0:05:13.31,0:05:17.06,Default,,0,0,0,,{\i1}Doğrudan temasla{\i0}\N{\i1}kendi anılarımı da paylaşabiliyorum.{\i0}
Dialogue: 0,0:05:17.73,0:05:19.86,Default,,0,0,0,,{\i1}Beynin yıkandığında bozulan anıları{\i0}
Dialogue: 0,0:05:20.48,0:05:22.82,Default,,0,0,0,,{\i1}gerçek anılarla değiştireceğim.{\i0}
Dialogue: 0,0:05:32.29,0:05:35.83,Default,,0,0,0,,{\i1}Zihninin içini görmeye başlıyorum abi.{\i0}
Dialogue: 0,0:05:38.63,0:05:42.13,Default,,0,0,0,,{\i1}Zihin ışıltılı anılarla doludur.{\i0}
Dialogue: 0,0:05:42.71,0:05:45.92,Default,,0,0,0,,{\i1}Başkasının giremeyeceği gizli odadır.{\i0}
Dialogue: 0,0:05:46.97,0:05:48.80,Default,,0,0,0,,{\i1}Ama yalnızca ben…{\i0}
Dialogue: 0,0:05:51.56,0:05:54.14,Default,,0,0,0,,{\i1}başka birinin zihnine girebilirim.{\i0}
Dialogue: 0,0:05:54.85,0:05:56.27,Default,,0,0,0,,{\i1}Çok karanlık!{\i0}
Dialogue: 0,0:05:57.06,0:05:59.73,Default,,0,0,0,,Yolumdan çekil Kengo.
Dialogue: 0,0:06:00.56,0:06:02.98,Default,,0,0,0,,Yakında oraya,
Dialogue: 0,0:06:04.07,0:06:06.57,Default,,0,0,0,,mutlu olduğum zamana geri dönebileceğim.
Dialogue: 0,0:06:10.95,0:06:14.24,Default,,0,0,0,,{\i1}Sadece babamın amaçlarına{\i0}\N{\i1}hizmet edecek anılar kalmış.{\i0}
Dialogue: 0,0:06:14.33,0:06:17.41,Default,,0,0,0,,{\i1}En yeni anılar tamamen bastırılmış.{\i0}
Dialogue: 0,0:06:17.91,0:06:19.46,Default,,0,0,0,,{\i1}Bu nasıl oluyor?{\i0}
Dialogue: 0,0:06:21.33,0:06:26.26,Default,,0,0,0,,Unutmayı en çok istediğim anılarımı\Nbabam bile silemedi.
Dialogue: 0,0:06:27.01,0:06:30.51,Default,,0,0,0,,Çiçek açmayı başardığım günü\Nhatırlamıyorum.
Dialogue: 0,0:06:31.22,0:06:32.64,Default,,0,0,0,,En azından hatırlamamalıyım.
Dialogue: 0,0:06:33.18,0:06:35.85,Default,,0,0,0,,Ama kan kokusu ve çığlıklar
Dialogue: 0,0:06:35.93,0:06:37.56,Default,,0,0,0,,hâlâ kafamda duruyor.
Dialogue: 0,0:06:38.23,0:06:40.98,Default,,0,0,0,,{\i1}Hiç anının olmaması korkutucu, değil mi?{\i0}
Dialogue: 0,0:06:41.06,0:06:43.19,Default,,0,0,0,,{\i1}Bu hissi ben de iyi biliyorum.{\i0}
Dialogue: 0,0:06:43.27,0:06:44.52,Default,,0,0,0,,{\i1}Öyle mi baba?{\i0}
Dialogue: 0,0:06:44.61,0:06:47.19,Default,,0,0,0,,{\i1}Kendi geçmişim hakkında{\i0}\N{\i1}hiçbir şey bilmiyorum.{\i0}
Dialogue: 0,0:06:47.69,0:06:52.87,Default,,0,0,0,,{\i1}Doğduğum yer, büyüdüğüm yer,{\i0}\N{\i1}tek bir şey bile hatırlamıyorum.{\i0}
Dialogue: 0,0:06:53.45,0:06:57.00,Default,,0,0,0,,{\i1}Başta benim gibi bilinmeyen bir varlığı{\i0}\N{\i1}kabullendiği için{\i0}
Dialogue: 0,0:06:57.08,0:06:58.96,Default,,0,0,0,,{\i1}Rei'ye şaşırmıştım.{\i0}
Dialogue: 0,0:06:59.54,0:07:01.58,Default,,0,0,0,,{\i1}Ama şimdi nedenini anlayabiliyorum.{\i0}
Dialogue: 0,0:07:02.79,0:07:06.63,Default,,0,0,0,,{\i1}Kim olduğunu bilmediğin için{\i0}\N{\i1}kendini sevemiyorsan bile{\i0}
Dialogue: 0,0:07:06.71,0:07:09.59,Default,,0,0,0,,{\i1}ben seni çok iyi tanıyorum Shinzo{\i0}
Dialogue: 0,0:07:10.09,0:07:11.51,Default,,0,0,0,,{\i1}ve seni seviyorum.{\i0}
Dialogue: 0,0:07:14.60,0:07:15.81,Default,,0,0,0,,{\i1}Baba.{\i0}
Dialogue: 0,0:07:16.51,0:07:19.27,Default,,0,0,0,,O gün anlamalıydım.
Dialogue: 0,0:07:19.85,0:07:23.94,Default,,0,0,0,,Keşke babamın\No gün verdiği işaretleri anlasaydım.
Dialogue: 0,0:07:24.02,0:07:28.78,Default,,0,0,0,,Keşke onu daha çok dinleseydim\Nya da geçmişine bakmaya çalışsaydım.
Dialogue: 0,0:07:29.44,0:07:32.66,Default,,0,0,0,,Keşke babam için\Ndaha fazlasını yapabilseydim.
Dialogue: 0,0:07:33.28,0:07:38.08,Default,,0,0,0,,O zaman annem ve Mutsumi,\No korkunç şeyleri yaşamak zorunda olmazdı.
Dialogue: 0,0:07:39.12,0:07:43.67,Default,,0,0,0,,Ama korkum yoluma çıkmaya devam etti\Nve hiçbir şey yapamadım!
Dialogue: 0,0:07:44.17,0:07:47.00,Default,,0,0,0,,Her zaman kendi dertlerime gömülüyorum!
Dialogue: 0,0:07:47.55,0:07:48.92,Default,,0,0,0,,Ah!
Dialogue: 0,0:07:49.42,0:07:50.42,Default,,0,0,0,,Çok uzun sürdü.
Dialogue: 0,0:07:50.51,0:07:53.22,Default,,0,0,0,,Hepimiz suyun altındayız.
Dialogue: 0,0:07:54.39,0:07:56.26,Default,,0,0,0,,Bu yüzden fazla sürmesini istemiyorum.
Dialogue: 0,0:07:56.35,0:07:58.39,Default,,0,0,0,,Hep böylesin Kengo!
Dialogue: 0,0:07:58.47,0:07:59.64,Default,,0,0,0,,Çok soğuk ve havalı!
Dialogue: 0,0:07:59.72,0:08:03.10,Default,,0,0,0,,Benim gibi bir sakarın\Nne hissettiğini asla anlayamazsın!
Dialogue: 0,0:08:03.94,0:08:05.81,Default,,0,0,0,,Bu doğru değil.
Dialogue: 0,0:08:06.40,0:08:08.73,Default,,0,0,0,,Seni çok iyi tanıyorum abi.
Dialogue: 0,0:08:09.36,0:08:10.69,Default,,0,0,0,,Çok sakarsın
Dialogue: 0,0:08:11.28,0:08:12.74,Default,,0,0,0,,ve çok havalısın!
Dialogue: 0,0:08:15.20,0:08:19.70,Default,,0,0,0,,Bunu kendin hatırlamayabilirsin\Nama ben hatırlıyorum.
Dialogue: 0,0:08:20.41,0:08:22.79,Default,,0,0,0,,Çiçek Açma'nı ne tetikledi, biliyor musun?
Dialogue: 0,0:08:23.37,0:08:24.75,Default,,0,0,0,,Bendim.
Dialogue: 0,0:08:25.75,0:08:28.25,Default,,0,0,0,,Tek başıma bir görevde\Nneredeyse öldürülüyordum.
Dialogue: 0,0:08:28.34,0:08:30.76,Default,,0,0,0,,Yardımıma geldin
Dialogue: 0,0:08:31.42,0:08:33.17,Default,,0,0,0,,ve beni korumak için uyandın.
Dialogue: 0,0:08:34.30,0:08:35.72,Default,,0,0,0,,{\i1}Abi.{\i0}
Dialogue: 0,0:08:37.43,0:08:38.68,Default,,0,0,0,,{\i1}Kengo.{\i0}
Dialogue: 0,0:08:38.76,0:08:40.64,Default,,0,0,0,,{\i1}Çok şükür.{\i0}
Dialogue: 0,0:08:40.72,0:08:42.23,Default,,0,0,0,,{\i1}İyisin!{\i0}
Dialogue: 0,0:08:46.35,0:08:48.61,Default,,0,0,0,,{\i1}Abi!{\i0}
Dialogue: 0,0:08:49.90,0:08:53.19,Default,,0,0,0,,Unutmak isteyeceğini düşündüğümden\Nbunu senden gizledim.
Dialogue: 0,0:08:53.74,0:08:54.74,Default,,0,0,0,,Ama…
Dialogue: 0,0:08:55.53,0:08:59.70,Default,,0,0,0,,Benim için asla unutmak istemediğim\Nçok önemli bir anı bu.
Dialogue: 0,0:09:02.25,0:09:06.54,Default,,0,0,0,,Acı verici şeyleri unutmanın,\Nen sevdiğin anılara sığınmanın
Dialogue: 0,0:09:07.21,0:09:08.96,Default,,0,0,0,,hiçbir zararı yok.
Dialogue: 0,0:09:09.50,0:09:10.80,Default,,0,0,0,,Ama biliyor musun?
Dialogue: 0,0:09:10.88,0:09:12.67,Default,,0,0,0,,Güçlü yanın…
Dialogue: 0,0:09:14.34,0:09:15.76,Default,,0,0,0,,Eğlenceli yanın…
Dialogue: 0,0:09:16.43,0:09:17.89,Default,,0,0,0,,Tatlı yanın…
Dialogue: 0,0:09:20.76,0:09:24.81,Default,,0,0,0,,{\i1}Kengo'nun anıları zihnime mi akıyor?{\i0}
Dialogue: 0,0:09:25.39,0:09:28.56,Default,,0,0,0,,Bak, zihnin böyle zifirî karanlık değil.
Dialogue: 0,0:09:29.11,0:09:32.53,Default,,0,0,0,,Gerçek şu ki en güzel anılarla dolu!
Dialogue: 0,0:09:33.19,0:09:35.15,Default,,0,0,0,,Sen hatırlayamıyorsan
Dialogue: 0,0:09:36.45,0:09:38.16,Default,,0,0,0,,ben hatırlamanı sağlarım.
Dialogue: 0,0:09:45.62,0:09:47.00,Default,,0,0,0,,Kengo.
Dialogue: 0,0:09:48.50,0:09:49.88,Default,,0,0,0,,Şimdi geri dön
Dialogue: 0,0:09:50.96,0:09:52.50,Default,,0,0,0,,{\i1}Abi.{\i0}
Dialogue: 0,0:09:58.38,0:10:00.01,Default,,0,0,0,,{\i1}Geri dönmeye başladı!{\i0}
Dialogue: 0,0:10:00.60,0:10:05.02,Default,,0,0,0,,{\i1}Eksik kısımları doldurabilirsem{\i0}\N{\i1}beyin yıkamayı tersine çevirebilirim.{\i0}
Dialogue: 0,0:10:12.61,0:10:13.86,Default,,0,0,0,,İşte bu.
Dialogue: 0,0:10:14.36,0:10:15.99,Default,,0,0,0,,Yapabilirsin abi.
Dialogue: 0,0:10:29.92,0:10:32.21,Default,,0,0,0,,İyi denemeydi Kengo.
Dialogue: 0,0:10:32.75,0:10:34.55,Default,,0,0,0,,Çiçek Açma yeteneğin harika
Dialogue: 0,0:10:35.13,0:10:38.51,Default,,0,0,0,,{\i1}ama birinin aklına girebilecek{\i0}\N{\i1}tek kişi sen değilsin.{\i0}
Dialogue: 0,0:10:38.59,0:10:40.14,Default,,0,0,0,,{\i1}Yine mi!{\i0}
Dialogue: 0,0:10:42.51,0:10:43.68,Default,,0,0,0,,{\i1}Nefesi tükeniyor!{\i0}
Dialogue: 0,0:10:51.31,0:10:52.52,Default,,0,0,0,,Kengo?
Dialogue: 0,0:10:52.61,0:10:54.77,Default,,0,0,0,,Benim hatam. Şu anda benimle konuşma.
Dialogue: 0,0:10:55.36,0:10:59.82,Default,,0,0,0,,Nasıl yaptığını bilmiyorum\Nama ihtiyarın gücü beni engelliyor!
Dialogue: 0,0:10:59.90,0:11:02.24,Default,,0,0,0,,Direnmek için tek yapabildiğim bu!
Dialogue: 0,0:11:02.32,0:11:04.45,Default,,0,0,0,,Bunu çözemezsem işimiz biter!
Dialogue: 0,0:11:05.58,0:11:07.25,Default,,0,0,0,,Babamla ilgili bir şey yapmalıyım!
Dialogue: 0,0:11:07.79,0:11:10.00,Default,,0,0,0,,Anladım. Anlaşıldı.
Dialogue: 0,0:11:10.08,0:11:12.42,Default,,0,0,0,,Öncelikle, Shinzo'yu iyi yakaladın.
Dialogue: 0,0:11:12.50,0:11:14.42,Default,,0,0,0,,Gerisini bize bırak.
Dialogue: 0,0:11:15.21,0:11:17.01,Default,,0,0,0,,İşte böyle Futaba.
Dialogue: 0,0:11:17.51,0:11:19.38,Default,,0,0,0,,Babamla bir işim var.
Dialogue: 0,0:11:20.05,0:11:21.55,Default,,0,0,0,,Bunu bir kez söyleyeceğim.
Dialogue: 0,0:11:22.97,0:11:24.51,Default,,0,0,0,,Çekil önümden.
Dialogue: 0,0:11:26.22,0:11:27.81,Default,,0,0,0,,Defolup gidebilirsin.
Dialogue: 0,0:12:07.89,0:12:10.39,Default,,0,0,0,,Şu gemiyi parçalamamaya dikkat eder misin?
Dialogue: 0,0:12:11.23,0:12:13.73,Default,,0,0,0,,Biraz sakinleş.
Dialogue: 0,0:12:20.61,0:12:21.82,Default,,0,0,0,,Batan Rüzgâr.
Dialogue: 0,0:12:30.79,0:12:34.67,Default,,0,0,0,,Beni durdurmak istiyorsan\Nsen de Çiçek Açma'nı devreye sokmalısın.
Dialogue: 0,0:12:35.25,0:12:38.42,Default,,0,0,0,,Bunu yaparsam hepinizi sürüklerim.
Dialogue: 0,0:12:38.92,0:12:42.38,Default,,0,0,0,,Çiçek Açma yeteneğimi\No adamda kullanacağım.
Dialogue: 0,0:12:43.05,0:12:45.68,Default,,0,0,0,,Zaten bu işe karışmak bana düşmez.
Dialogue: 0,0:12:45.76,0:12:50.60,Default,,0,0,0,,Neyse ki çok yetenekli kardeşlerim var.
Dialogue: 0,0:12:51.14,0:12:54.39,Default,,0,0,0,,Hadi ama, ciddi misin?
Dialogue: 0,0:12:54.48,0:12:56.40,Default,,0,0,0,,Shion ve Nanao.
Dialogue: 0,0:12:56.48,0:13:00.02,Default,,0,0,0,,Sizin gibi arka saflarda savaşan iki kişi\Nbenimle yakın dövüşe mi girecek?
Dialogue: 0,0:13:01.11,0:13:05.24,Default,,0,0,0,,Çevredeki kuvvetleri kullanan\Nbir aiki tekniği, Çağlayan Saldırısı.
Dialogue: 0,0:13:05.86,0:13:09.78,Default,,0,0,0,,Aslında bu bizim\Nbilim ve bilgi kullanmamızla aynı.
Dialogue: 0,0:13:10.33,0:13:13.16,Default,,0,0,0,,Çok güçlüsün abla ama aptalsın.
Dialogue: 0,0:13:13.25,0:13:15.08,Default,,0,0,0,,Gardını düşürmesen iyi olur…
Dialogue: 0,0:13:22.21,0:13:25.09,Default,,0,0,0,,Hepimiz zekiyiz.
Dialogue: 0,0:13:27.80,0:13:30.68,Default,,0,0,0,,Tamam, antrenmana başlayalım.
Dialogue: 0,0:13:31.26,0:13:34.68,Default,,0,0,0,,Kardeşlerin olarak hiçbirimiz\Ngerçek yüzünü göremedik Abla Futaba
Dialogue: 0,0:13:34.77,0:13:37.40,Default,,0,0,0,,Bizim için zorlu bir savaş olacak,\Ndeğil mi Abla Shion?
Dialogue: 0,0:13:37.48,0:13:39.61,Default,,0,0,0,,{\i1}Evet, kesinlikle berbat bir oyun.{\i0}
Dialogue: 0,0:13:39.69,0:13:41.77,Default,,0,0,0,,Ama yenilmez bir oyun değil.
Dialogue: 0,0:13:41.86,0:13:44.40,Default,,0,0,0,,Sonsuz doğrulama ve toplama.
Dialogue: 0,0:13:44.49,0:13:47.36,Default,,0,0,0,,Oyunu bitirmek için gereken adımlar aynı.
Dialogue: 0,0:13:47.45,0:13:50.37,Default,,0,0,0,,Oyun tarzını da tahmin edebiliyorum.
Dialogue: 0,0:13:50.45,0:13:54.08,Default,,0,0,0,,Benim yapmam gereken tek şey analiz etmek.
Dialogue: 0,0:13:54.16,0:13:57.29,Default,,0,0,0,,Beyin hücrelerini yakma sakın.
Dialogue: 0,0:13:57.37,0:14:00.29,Default,,0,0,0,,Abi, geri çekilsen iyi olur.
Dialogue: 0,0:14:00.38,0:14:02.46,Default,,0,0,0,,Katılıyorum. Haklısın.
Dialogue: 0,0:14:02.55,0:14:05.26,Default,,0,0,0,,Maksimum güçte ne yapabileceğini\Nben bile bilmiyorum.
Dialogue: 0,0:14:10.51,0:14:12.39,Default,,0,0,0,,{\i1}Büyük ihtimalle bu zehirli gazdır.{\i0}
Dialogue: 0,0:14:18.48,0:14:21.19,Default,,0,0,0,,Abla Futaba, Çiçek Açma yeteneğin\Nher şeyi kucaklayıp
Dialogue: 0,0:14:21.27,0:14:23.69,Default,,0,0,0,,sonra da hiçliğe dönüştüren\NYüce Gönüllülük.
Dialogue: 0,0:14:23.78,0:14:25.69,Default,,0,0,0,,Şu anda çıkış yolu yok.
Dialogue: 0,0:14:25.78,0:14:31.16,Default,,0,0,0,,Bu yüzden seni geçebilmek için\Nvücudumu sürekli uyumlandırıyorum.
Dialogue: 0,0:14:31.95,0:14:34.20,Default,,0,0,0,,Bu oda benim bedenim.
Dialogue: 0,0:14:34.70,0:14:37.12,Default,,0,0,0,,Sonsuz miktarda zehirli gaz salacağım.
Dialogue: 0,0:14:37.21,0:14:39.17,Default,,0,0,0,,Onu sonsuza dek özümseyeceksin.
Dialogue: 0,0:14:40.21,0:14:42.34,Default,,0,0,0,,Kimin Çiçek Açma'sı daha fazla dayanacak?
Dialogue: 0,0:14:42.42,0:14:45.80,Default,,0,0,0,,İyiydi Nanao. Ne kadar erkeksisin.
Dialogue: 0,0:14:50.05,0:14:52.30,Default,,0,0,0,,Bir örümcek zehri.
Dialogue: 0,0:14:53.01,0:14:56.22,Default,,0,0,0,,Abi Kyoichiro'yu bile\Ndurdurabilecek bir koku bu.
Dialogue: 0,0:14:56.97,0:15:00.60,Default,,0,0,0,,Sana ulaşana kadar\Nevrimleşmeye devam edeceğim.
Dialogue: 0,0:15:04.11,0:15:06.36,Default,,0,0,0,,Çocuklar aileleri uğruna
Dialogue: 0,0:15:07.86,0:15:11.74,Default,,0,0,0,,çaresizce birbirleriyle kavga ediyorlar.
Dialogue: 0,0:15:14.91,0:15:16.83,Default,,0,0,0,,Sence bu yeterli değil mi?
Dialogue: 0,0:15:17.37,0:15:19.12,Default,,0,0,0,,Buna bir son verelim.
Dialogue: 0,0:15:19.21,0:15:20.41,Default,,0,0,0,,Son vermek istiyorum.
Dialogue: 0,0:15:21.04,0:15:22.17,Default,,0,0,0,,Rei…
Dialogue: 0,0:15:30.63,0:15:31.76,Default,,0,0,0,,Öyle deme!
Dialogue: 0,0:15:32.43,0:15:33.64,Default,,0,0,0,,İstediğin bu değil!
Dialogue: 0,0:15:34.39,0:15:35.51,Default,,0,0,0,,Bu…
Dialogue: 0,0:15:36.51,0:15:37.89,Default,,0,0,0,,Dayan!
Dialogue: 0,0:15:49.61,0:15:52.66,Default,,0,0,0,,Kristalleşme artık daha uzun sürüyor.
Dialogue: 0,0:15:52.74,0:15:54.57,Default,,0,0,0,,Fazla abartmasan iyi olur.
Dialogue: 0,0:15:56.24,0:15:57.70,Default,,0,0,0,,Haklısın.
Dialogue: 0,0:15:58.33,0:16:03.08,Default,,0,0,0,,Üzgünüm ama hücrelerim\Nne zaman pes edeceklerini bilmiyor.
Dialogue: 0,0:16:08.75,0:16:11.72,Default,,0,0,0,,Daha önce de söyledim,\Nbu odanın tamamı artık benim bedenim.
Dialogue: 0,0:16:12.84,0:16:16.97,Default,,0,0,0,,Sen ne kadar güçlüysen\Nben de o kadar güçlü olacağım abla.
Dialogue: 0,0:16:33.32,0:16:36.37,Default,,0,0,0,,Etkilendim Nanao.\Nİstediğin zaman şekil değiştirebiliyorsun.
Dialogue: 0,0:16:36.87,0:16:39.45,Default,,0,0,0,,Ama ne kadar şekil değiştirirsen değiştir,
Dialogue: 0,0:16:39.54,0:16:43.16,Default,,0,0,0,,bir şeklin olduğu sürece\Nasla elimden kurtulamazsın.
Dialogue: 0,0:16:45.42,0:16:47.38,Default,,0,0,0,,Bundan o kadar emin olmazdım.
Dialogue: 0,0:16:47.92,0:16:49.34,Default,,0,0,0,,{\i1}Analiz tamamlandı.{\i0}
Dialogue: 0,0:16:49.42,0:16:51.26,Default,,0,0,0,,Aferin Nanao.
Dialogue: 0,0:16:51.34,0:16:52.63,Default,,0,0,0,,Pekâlâ abla.
Dialogue: 0,0:16:52.72,0:16:54.88,Default,,0,0,0,,Mat etmeme izin verir misin?
Dialogue: 0,0:17:04.98,0:17:07.19,Default,,0,0,0,,İstediğin kadar dönüşebilir\Nve çoğalabilirsin
Dialogue: 0,0:17:07.27,0:17:08.90,Default,,0,0,0,,ama hiçbir şey değişmeyecek!
Dialogue: 0,0:17:16.36,0:17:18.20,Default,,0,0,0,,{\i1}Zahmetsizce yer değiştiriyorlar{\i0}
Dialogue: 0,0:17:18.70,0:17:21.79,Default,,0,0,0,,{\i1}ama sürekli mesafesini koruyan{\i0}\N{\i1}bir tane var.{\i0}
Dialogue: 0,0:17:30.04,0:17:31.67,Default,,0,0,0,,Şimdi.
Dialogue: 0,0:17:31.75,0:17:33.01,Default,,0,0,0,,Hologram.
Dialogue: 0,0:17:33.92,0:17:37.13,Default,,0,0,0,,Dövüş tekniğin her şeyi güce çevirebilir
Dialogue: 0,0:17:37.22,0:17:39.72,Default,,0,0,0,,ama var olmayan bir şeyi kullanamaz.
Dialogue: 0,0:17:39.80,0:17:42.97,Default,,0,0,0,,İşin içine var olmayan\Nbazı varlıkları da katarak
Dialogue: 0,0:17:43.06,0:17:45.02,Default,,0,0,0,,bir açıklık bulacağımıza eminim.
Dialogue: 0,0:17:46.98,0:17:49.86,Default,,0,0,0,,{\i1}Gerçek seni, sahte olanlardan ayıramam.{\i0}
Dialogue: 0,0:17:49.94,0:17:51.86,Default,,0,0,0,,{\i1}Ama fark etmez.{\i0}
Dialogue: 0,0:17:51.94,0:17:55.99,Default,,0,0,0,,{\i1}Bu savaş boyunca{\i0}\N{\i1}Yüce Gönüllülük tarafından emilen güç{\i0}
Dialogue: 0,0:17:56.07,0:17:58.32,Default,,0,0,0,,{\i1}tam olarak kontrolüm altında.{\i0}
Dialogue: 0,0:18:00.70,0:18:03.58,Default,,0,0,0,,Benimle dövüşmeye başladığın anda
Dialogue: 0,0:18:03.66,0:18:06.16,Default,,0,0,0,,zafer şansını kaybettin.
Dialogue: 0,0:18:11.92,0:18:13.50,Default,,0,0,0,,Büyük Bahar Esintisi!
Dialogue: 0,0:18:37.19,0:18:38.53,Default,,0,0,0,,Abla…
Dialogue: 0,0:18:40.24,0:18:41.66,Default,,0,0,0,,Seni yakaladım.
Dialogue: 0,0:18:47.20,0:18:49.87,Default,,0,0,0,,{\i1}Shion? Burada ne işin var?{\i0}
Dialogue: 0,0:18:51.63,0:18:52.92,Default,,0,0,0,,{\i1}Hareket edemiyorum!{\i0}
Dialogue: 0,0:18:57.09,0:18:58.47,Default,,0,0,0,,Bu…
Dialogue: 0,0:18:58.55,0:19:01.55,Default,,0,0,0,,Baharın İlk Esintisi küçük bir tayfun.
Dialogue: 0,0:19:01.64,0:19:04.10,Default,,0,0,0,,Bedeninin savrulup gitmemesinin nedeni
Dialogue: 0,0:19:04.18,0:19:08.18,Default,,0,0,0,,rüzgârsız bölge olan\N"fırtınanın gözünde" durman.
Dialogue: 0,0:19:08.27,0:19:10.44,Default,,0,0,0,,{\i1}Bedenimle eşleşmiş kopyalardan{\i0}
Dialogue: 0,0:19:10.52,0:19:13.90,Default,,0,0,0,,{\i1}çevreyle bütünleşerek saklanıyordum.{\i0}
Dialogue: 0,0:19:13.98,0:19:16.36,Default,,0,0,0,,{\i1}Nanao'nun gösterişli saldırıları,{\i0}
Dialogue: 0,0:19:16.44,0:19:20.11,Default,,0,0,0,,{\i1}optik kamuflajımı{\i0}\N{\i1}açığa çıkarmamak için bir hileydi.{\i0}
Dialogue: 0,0:19:24.62,0:19:29.54,Default,,0,0,0,,{\i1}Sonra da Nanao'nun tekniğini yok ederek{\i0}\N{\i1}bize bir açıklık sağlamanı bekledim.{\i0}
Dialogue: 0,0:19:30.25,0:19:31.87,Default,,0,0,0,,{\i1}Hepsi de{\i0}
Dialogue: 0,0:19:31.96,0:19:34.79,Default,,0,0,0,,seni kollarıma alabilmek içindi.
Dialogue: 0,0:19:35.84,0:19:37.59,Default,,0,0,0,,Annemin yaptığı gibi.
Dialogue: 0,0:19:47.22,0:19:50.43,Default,,0,0,0,,Öfke nöbeti geçirdiğinde\Nkimse seninle baş edemezdi.
Dialogue: 0,0:19:51.10,0:19:55.31,Default,,0,0,0,,Babam seni zapt etmeye çalıştığında\Ngenelde çok uzaklara savrulurdu.
Dialogue: 0,0:19:55.40,0:19:56.77,Default,,0,0,0,,{\i1}Senden nefret ediyorum baba!{\i0}
Dialogue: 0,0:19:57.36,0:20:00.32,Default,,0,0,0,,Ama nedense yalnızca annem…
Dialogue: 0,0:20:02.32,0:20:04.99,Default,,0,0,0,,Bırak beni anne!
Dialogue: 0,0:20:05.07,0:20:09.50,Default,,0,0,0,,Kyoichiro, kitabımı\Npatates cipsi yağıyla lekeledi!
Dialogue: 0,0:20:11.96,0:20:16.17,Default,,0,0,0,,Ben de onun odasını\Nkendi kanıyla lekeleyeceğim!
Dialogue: 0,0:20:17.00,0:20:21.63,Default,,0,0,0,,Kyoichiro'ya hak ettiği cezayı vereceğim,\Nsen yeter ki sakin ol.
Dialogue: 0,0:20:23.72,0:20:26.39,Default,,0,0,0,,-Buraya gel!\N-Bizimle uğraşma!
Dialogue: 0,0:20:28.22,0:20:31.89,Default,,0,0,0,,Diğer herkesi\Nöylece havaya uçurabiliyorken
Dialogue: 0,0:20:31.98,0:20:34.81,Default,,0,0,0,,neden senin kollarından\Nkurtulamıyorum anne?
Dialogue: 0,0:20:35.60,0:20:38.07,Default,,0,0,0,,Bu benim için de tam bir gizem.
Dialogue: 0,0:20:38.15,0:20:41.78,Default,,0,0,0,,Belki kavgalarınızı\Nbinlerce kez durdurduğum içindir.
Dialogue: 0,0:20:41.86,0:20:43.15,Default,,0,0,0,,Hatta on binlerce kez.
Dialogue: 0,0:20:43.24,0:20:46.12,Default,,0,0,0,,{\i1}Eskiden ben de savrulurdum.{\i0}
Dialogue: 0,0:20:46.20,0:20:49.45,Default,,0,0,0,,{\i1}Ama bunu defalarca yaşadıktan sonra,{\i0}
Dialogue: 0,0:20:49.54,0:20:52.41,Default,,0,0,0,,{\i1}sanırım bir şekilde çözdüm.{\i0}
Dialogue: 0,0:20:53.12,0:20:56.92,Default,,0,0,0,,Yalnızca benim bildiğim\Nseninle ilgili bir sır gibi.
Dialogue: 0,0:20:57.00,0:20:58.63,Default,,0,0,0,,Bu da beni mutlu ediyor.
Dialogue: 0,0:21:03.42,0:21:05.38,Default,,0,0,0,,Şu hâline bak Futaba!
Dialogue: 0,0:21:05.93,0:21:07.47,Default,,0,0,0,,Bırak beni.
Dialogue: 0,0:21:07.55,0:21:10.39,Default,,0,0,0,,Onu hemen öldüreceğim!
Dialogue: 0,0:21:10.47,0:21:11.68,Default,,0,0,0,,Kyoichiro!
Dialogue: 0,0:21:14.94,0:21:16.81,Default,,0,0,0,,Ne diyorsun abla?
Dialogue: 0,0:21:16.90,0:21:20.78,Default,,0,0,0,,Ekstansör kaslarının üzerindeki\Nkolların açısı ve uyguladığı kuvvet,
Dialogue: 0,0:21:20.86,0:21:24.11,Default,,0,0,0,,ağırlık merkezini nasıl kaydırdığı,\Nbedeninin ne kadar yakın olduğu…
Dialogue: 0,0:21:24.95,0:21:29.45,Default,,0,0,0,,Her bir anıyı yüzde 100 doğrulukla\Nkopyalamak için analiz ettim.
Dialogue: 0,0:21:29.95,0:21:31.58,Default,,0,0,0,,Bunlar annemin kolları.
Dialogue: 0,0:21:38.92,0:21:43.21,Default,,0,0,0,,Unutmak istediğim şeyleri hatırlatma.
Dialogue: 0,0:21:49.80,0:21:52.22,Default,,0,0,0,,Hepiniz Erik Bahçesi'ne dönün.
Dialogue: 0,0:22:02.36,0:22:05.07,Default,,0,0,0,,Ben babamı görmeye gidiyorum.
Dialogue: 0,0:24:17.03,0:24:19.04,Default,,0,0,0,,Alt yazı çevirmeni: Dilek Çil

