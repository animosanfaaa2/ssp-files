Dialogue: 0,0:00:10.88,0:00:12.84,Default,,0,0,0,,&rlm;-"تايو".\N-"تايو".
Dialogue: 0,0:00:12.93,0:00:14.51,Default,,0,0,0,,&rlm;أخي الكبير.
Dialogue: 0,0:00:16.76,0:00:19.60,Default,,0,0,0,,&rlm;أخي الكبير؟ أخي الكبير!
Dialogue: 0,0:00:20.68,0:00:22.31,Default,,0,0,0,,&rlm;هل أنت بخير يا أخي الكبير؟
Dialogue: 0,0:00:22.39,0:00:23.81,Default,,0,0,0,,&rlm;كان يراودك كابوس.
Dialogue: 0,0:00:23.89,0:00:24.90,Default,,0,0,0,,&rlm;ماذا؟
Dialogue: 0,0:00:24.98,0:00:27.27,Default,,0,0,0,,&rlm;أجل، أنا بخير.
Dialogue: 0,0:00:34.28,0:00:35.41,Default,,0,0,0,,&rlm;ما الخطب؟
Dialogue: 0,0:00:36.82,0:00:37.82,Default,,0,0,0,,&rlm;"هايكارو"؟
Dialogue: 0,0:00:37.91,0:00:38.91,Default,,0,0,0,,&rlm;ماذا؟
Dialogue: 0,0:00:39.49,0:00:41.33,Default,,0,0,0,,&rlm;أين أمي وأبي؟
Dialogue: 0,0:00:41.83,0:00:44.54,Default,,0,0,0,,&rlm;إنهما مستيقظان منذ ساعات.
Dialogue: 0,0:00:46.83,0:00:48.09,Default,,0,0,0,,&rlm;لقد أيقظته!
Dialogue: 0,0:00:48.17,0:00:49.55,Default,,0,0,0,,&rlm;صباح الخير يا "تايو".
Dialogue: 0,0:00:49.63,0:00:51.88,Default,,0,0,0,,&rlm;الفطور على الطاولة بالفعل.
Dialogue: 0,0:00:52.55,0:00:54.68,Default,,0,0,0,,&rlm;ليس من عادتك أن تفرط في النوم.
Dialogue: 0,0:00:58.30,0:00:59.55,Default,,0,0,0,,&rlm;هيا يا أخي الكبير.
Dialogue: 0,0:00:59.64,0:01:02.56,Default,,0,0,0,,&rlm;فلننته من تناول الفطور لنبدأ اللعب مجدداً!
Dialogue: 0,0:01:02.64,0:01:04.14,Default,,0,0,0,,&rlm;حسناً.
Dialogue: 0,0:01:19.91,0:01:24.83,Default,,0,0,0,,&rlm;مهمة الكشف عن عائلة يوزاكورا
Dialogue: 0,0:02:42.03,0:02:43.70,Default,,0,0,0,,&rlm;شكراً على الفطور!
Dialogue: 0,0:02:46.24,0:02:48.29,Default,,0,0,0,,&rlm;لحظة واحدة. تركت طعاماً في طبقك.
Dialogue: 0,0:02:48.37,0:02:50.96,Default,,0,0,0,,&rlm;إن لم تأكل جيداً، فلن تكبر أبداً.
Dialogue: 0,0:02:51.04,0:02:54.54,Default,,0,0,0,,&rlm;هذا صحيح! انظر إليّ. هذا طبقي الثاني!
Dialogue: 0,0:02:54.63,0:02:57.01,Default,,0,0,0,,&rlm;أليس هذا سبب بدانتك مؤخراً؟
Dialogue: 0,0:02:57.88,0:03:00.43,Default,,0,0,0,,&rlm;-هل ترى هذا أيضاً يا "هايكارو"؟\N-ماذا؟
Dialogue: 0,0:03:00.51,0:03:02.43,Default,,0,0,0,,&rlm;هل يزداد وزنك في منتصف عمرك؟
Dialogue: 0,0:03:02.51,0:03:03.72,Default,,0,0,0,,&rlm;حتى أنت يا حبيبتي؟
Dialogue: 0,0:03:03.80,0:03:07.72,Default,,0,0,0,,&rlm;أعترف أنني مؤخراً… لن أدعك تغير الموضوع!
Dialogue: 0,0:03:08.52,0:03:13.40,Default,,0,0,0,,&rlm;هيا يا "هايكارو"، سأساعدك في إنهاء طبقك.
Dialogue: 0,0:03:15.23,0:03:18.36,Default,,0,0,0,,&rlm;-انتبه!\N-شكراً يا "تايو"!
Dialogue: 0,0:03:18.44,0:03:19.90,Default,,0,0,0,,&rlm;يا للروعة يا أخي الكبير!
Dialogue: 0,0:03:19.99,0:03:21.49,Default,,0,0,0,,&rlm;هل اندلق عليك الشاي؟
Dialogue: 0,0:03:21.57,0:03:23.07,Default,,0,0,0,,&rlm;لا، أنا بخير.
Dialogue: 0,0:03:23.16,0:03:26.16,Default,,0,0,0,,&rlm;كيف… الآن…
Dialogue: 0,0:03:26.24,0:03:29.70,Default,,0,0,0,,&rlm;أعلم! لم لا نذهب جميعاً إلى مكان ما\Nفي عطلة نهاية هذا الأسبوع؟
Dialogue: 0,0:03:29.79,0:03:32.58,Default,,0,0,0,,&rlm;فكرة جيدة! إلى أين تريدان الذهاب؟
Dialogue: 0,0:03:32.67,0:03:34.88,Default,,0,0,0,,&rlm;أريد الذهاب للتخييم!
Dialogue: 0,0:03:34.96,0:03:36.67,Default,,0,0,0,,&rlm;التخييم؟
Dialogue: 0,0:03:36.75,0:03:39.21,Default,,0,0,0,,&rlm;بالتفكير في الأمر، لم نفعل ذلك مؤخراً.
Dialogue: 0,0:03:39.30,0:03:42.30,Default,,0,0,0,,&rlm;عندما كنت أصغر سناً،\Nكان حلمي أن أذهب للتخييم وحدي،
Dialogue: 0,0:03:42.38,0:03:46.43,Default,,0,0,0,,&rlm;فقرأت مجلات كثيرة واشتريت المعدات اللازمة،
Dialogue: 0,0:03:46.51,0:03:49.68,Default,,0,0,0,,&rlm;لكن انتهى بي الأمر إلى عدم استخدامها.
Dialogue: 0,0:03:49.77,0:03:51.89,Default,,0,0,0,,&rlm;هل تود هذا أيضاً يا "تايو"؟
Dialogue: 0,0:03:53.10,0:03:54.65,Default,,0,0,0,,&rlm;أنا لا أمانع أي شيء.
Dialogue: 0,0:03:54.73,0:03:56.61,Default,,0,0,0,,&rlm;ألن يعيق ذلك عملك يا أمي؟
Dialogue: 0,0:03:56.69,0:03:59.07,Default,,0,0,0,,&rlm;لن يعيقه إطلاقاً! أخذت إجازة لبعض الوقت.
Dialogue: 0,0:03:59.15,0:04:01.70,Default,,0,0,0,,&rlm;-هذا رائع!\N-أحسنت يا فتاة!
Dialogue: 0,0:04:01.78,0:04:03.03,Default,,0,0,0,,&rlm;سيكون الأمر ممتعاً!
Dialogue: 0,0:04:08.08,0:04:10.91,Default,,0,0,0,,&rlm;"اضغط!"
Dialogue: 0,0:04:11.75,0:04:13.96,Default,,0,0,0,,&rlm;"خسرت"
Dialogue: 0,0:04:14.04,0:04:16.50,Default,,0,0,0,,&rlm;بحقك يا أخي الكبير، ماذا تفعل؟
Dialogue: 0,0:04:16.59,0:04:18.38,Default,,0,0,0,,&rlm;خسرنا بسببك!
Dialogue: 0,0:04:18.46,0:04:19.92,Default,,0,0,0,,&rlm;آسف.
Dialogue: 0,0:04:20.51,0:04:24.76,Default,,0,0,0,,&rlm;لست على طبيعتك اليوم يا أخي الكبير.\Nإنك شارد الذهن طوال الوقت.
Dialogue: 0,0:04:24.84,0:04:27.47,Default,,0,0,0,,&rlm;آسف. لنلعب الجولة مجدداً!
Dialogue: 0,0:04:27.55,0:04:29.97,Default,,0,0,0,,&rlm;يا ويلي، ركز في اللعبة هذه المرة!
Dialogue: 0,0:04:30.06,0:04:31.48,Default,,0,0,0,,&rlm;عُلم!
Dialogue: 0,0:04:32.02,0:04:33.02,Default,,0,0,0,,{\an8}&rlm;"يجري التحميل"
Dialogue: 0,0:04:33.10,0:04:35.40,Default,,0,0,0,,{\an8}&rlm;المشكلة أنك تترك نفسك هدفاً سهلاً.
Dialogue: 0,0:04:35.48,0:04:38.23,Default,,0,0,0,,&rlm;عليك أن تنظر إلى ساحة اللعب كلها.
Dialogue: 0,0:04:38.94,0:04:41.82,Default,,0,0,0,,&rlm;حسناً. سنربح الجولة هذه المرة بلا شك!
Dialogue: 0,0:04:43.20,0:04:44.78,Default,,0,0,0,,&rlm;ماذا كان ذلك؟
Dialogue: 0,0:04:45.95,0:04:47.37,Default,,0,0,0,,&rlm;أشعر…
Dialogue: 0,0:04:47.45,0:04:50.37,Default,,0,0,0,,&rlm;كأنني نسيت شيئاً مهماً.
Dialogue: 0,0:04:53.21,0:04:54.87,Default,,0,0,0,,&rlm;فليكن ما يكن.
Dialogue: 0,0:05:13.98,0:05:16.35,Default,,0,0,0,,&rlm;الأخ الكبير "شينزو"! "كينغو"!
Dialogue: 0,0:05:20.44,0:05:21.69,Default,,0,0,0,,&rlm;إلى السفينة؟
Dialogue: 0,0:05:55.64,0:05:56.94,Default,,0,0,0,,&rlm;"موتسومي"!
Dialogue: 0,0:06:08.95,0:06:11.28,Default,,0,0,0,,&rlm;الأخ الكبير "كيويتشيرو"!\Nالأخت الكبيرة "فوتابا"!
Dialogue: 0,0:06:11.37,0:06:13.74,Default,,0,0,0,,&rlm;الأخ الكبير "شينزو"! الأخت الكبيرة "شيون"!
Dialogue: 0,0:06:13.83,0:06:15.66,Default,,0,0,0,,&rlm;"كينغو"! "ناناو"!
Dialogue: 0,0:06:20.58,0:06:21.79,Default,,0,0,0,,&rlm;كلهم؟
Dialogue: 0,0:06:24.38,0:06:27.30,Default,,0,0,0,,&rlm;أهذه قوة هذا الأب؟
Dialogue: 0,0:06:37.89,0:06:39.94,Default,,0,0,0,,&rlm;اكتمل مسح السفينة.
Dialogue: 0,0:06:40.02,0:06:44.15,Default,,0,0,0,,&rlm;أرصد تركيزات عالية من السوميناين\Nتنتشر في أرجاء السفينة كالعدوى.
Dialogue: 0,0:06:44.23,0:06:47.36,Default,,0,0,0,,&rlm;إن انفجرت كلها معاً،\Nفلن يقضي الانفجار على السفينة وحدها.
Dialogue: 0,0:06:47.44,0:06:50.11,Default,,0,0,0,,&rlm;بل سيطال كل المنطقة البحرية المحيطة.
Dialogue: 0,0:06:50.20,0:06:52.32,Default,,0,0,0,,&rlm;هل استطعت التواصل مع عائلة "يوزاكورا"؟
Dialogue: 0,0:06:52.41,0:06:56.04,Default,,0,0,0,,&rlm;احترقت كل الوحدات، لذا لا يمكن التواصل.
Dialogue: 0,0:06:56.12,0:06:57.87,Default,,0,0,0,,&rlm;يجب أن نذهب وننقذهم!
Dialogue: 0,0:06:57.95,0:06:59.12,Default,,0,0,0,,&rlm;انتظر يا "ريو".
Dialogue: 0,0:07:00.12,0:07:01.33,Default,,0,0,0,,&rlm;لا توقفني.
Dialogue: 0,0:07:02.21,0:07:06.30,Default,,0,0,0,,&rlm;لا يمكننا الدخول دون أن نعرف ما يجري.
Dialogue: 0,0:07:06.80,0:07:09.42,Default,,0,0,0,,&rlm;أتفق مع الرئيس في هذا.
Dialogue: 0,0:07:11.72,0:07:12.97,Default,,0,0,0,,&rlm;حسناً إذاً.
Dialogue: 0,0:07:13.97,0:07:17.10,Default,,0,0,0,,&rlm;"غيغا"، اتصلي بغرفة مراقبة الميناء.
Dialogue: 0,0:07:17.18,0:07:19.43,Default,,0,0,0,,&rlm;اطلبي منهم توسيع الحصار.
Dialogue: 0,0:07:19.52,0:07:20.85,Default,,0,0,0,,&rlm;عُلم!
Dialogue: 0,0:07:24.44,0:07:26.36,Default,,0,0,0,,&rlm;لنترك الباقي لهم.
Dialogue: 0,0:07:27.36,0:07:30.03,Default,,0,0,0,,&rlm;مهما يحدث،\Nبالطريقة التي تسير بها الأمور الآن،
Dialogue: 0,0:07:31.40,0:07:33.16,Default,,0,0,0,,&rlm;فالوحيد القادر على إنقاذ الآخرين…
Dialogue: 0,0:07:34.78,0:07:36.08,Default,,0,0,0,,&rlm;هو أنا!
Dialogue: 0,0:07:50.05,0:07:54.76,Default,,0,0,0,,&rlm;أهكذا تتعامل مع الاستقبال الذي أعددته لك؟\Nيا لقسوتك!
Dialogue: 0,0:07:54.84,0:07:57.22,Default,,0,0,0,,&rlm;بدأت تشبه "كيويتشيرو" في تصرفاتك.
Dialogue: 0,0:07:57.31,0:07:59.93,Default,,0,0,0,,&rlm;سيصل بعد قليل.
Dialogue: 0,0:08:21.29,0:08:23.75,Default,,0,0,0,,&rlm;أهلا بعودتك يا "تايو".
Dialogue: 0,0:08:24.83,0:08:26.13,Default,,0,0,0,,&rlm;حان وقت العشاء.
Dialogue: 0,0:08:26.63,0:08:27.96,Default,,0,0,0,,&rlm;اجلس الآن.
Dialogue: 0,0:08:40.01,0:08:41.89,Default,,0,0,0,,&rlm;ماذا فعلت بهم؟
Dialogue: 0,0:08:52.36,0:08:55.41,Default,,0,0,0,,&rlm;قدرة الازدهار خاصتي هي "الأحلام".
Dialogue: 0,0:08:57.32,0:08:58.95,Default,,0,0,0,,&rlm;ألم تعش حلماً كهذا بنفسك؟
Dialogue: 0,0:08:59.03,0:09:03.37,Default,,0,0,0,,&rlm;حلم مثالي يخلو من الألم والمعاناة.
Dialogue: 0,0:09:04.75,0:09:09.38,Default,,0,0,0,,&rlm;كل ما تغمره رائحة أزهار الكرز هذه\Nيخضع لحلمي.
Dialogue: 0,0:09:09.88,0:09:12.05,Default,,0,0,0,,&rlm;ولا أحد قادر على مقاومة تأثيره.
Dialogue: 0,0:09:12.13,0:09:16.76,Default,,0,0,0,,&rlm;إلا أنت وحدك،\Nإذ يجري دم "تسوبومي" في عروقك.
Dialogue: 0,0:09:20.68,0:09:23.93,Default,,0,0,0,,&rlm;أعدهم جميعاً إلى ما كانوا عليه!
Dialogue: 0,0:09:24.02,0:09:26.27,Default,,0,0,0,,&rlm;لقد أعدتهم بالفعل.
Dialogue: 0,0:09:26.77,0:09:29.40,Default,,0,0,0,,&rlm;إلى ما يجب أن تكون عليه عائلتي.
Dialogue: 0,0:09:30.36,0:09:31.86,Default,,0,0,0,,&rlm;أتسمي هذه عائلة؟
Dialogue: 0,0:09:32.57,0:09:34.11,Default,,0,0,0,,&rlm;العائلة هي…
Dialogue: 0,0:09:37.70,0:09:39.32,Default,,0,0,0,,&rlm;"قبر عائلة (آسانو)"
Dialogue: 0,0:09:40.03,0:09:41.99,Default,,0,0,0,,&rlm;العائلة هي…
Dialogue: 0,0:09:43.66,0:09:47.42,Default,,0,0,0,,&rlm;أنت مخطئ. هذه هي العائلة يا "تايو".
Dialogue: 0,0:09:49.54,0:09:51.46,Default,,0,0,0,,&rlm;وأنت أدرى الناس بذلك.
Dialogue: 0,0:09:51.96,0:09:54.09,Default,,0,0,0,,&rlm;العائلات ضعيفة وفانية.
Dialogue: 0,0:09:54.71,0:09:57.97,Default,,0,0,0,,&rlm;لهذا قررت إنشاء عائلة من الصفر.
Dialogue: 0,0:09:58.55,0:10:01.60,Default,,0,0,0,,&rlm;عائلة قوية لا يمكن تدميرها أبداً.
Dialogue: 0,0:10:26.79,0:10:28.21,Default,,0,0,0,,&rlm;ولكن تحركت بعد فوات الأوان.
Dialogue: 0,0:10:28.29,0:10:31.92,Default,,0,0,0,,&rlm;تباً لك يا "كاواشيتا".\Nأن تكون لديك الجرأة لفعل هذا…
Dialogue: 0,0:10:32.00,0:10:34.71,Default,,0,0,0,,&rlm;هذا الفتى لي.
Dialogue: 0,0:10:39.84,0:10:41.43,Default,,0,0,0,,&rlm;سأعيدك.
Dialogue: 0,0:10:46.93,0:10:48.23,Default,,0,0,0,,&rlm;هذا ليس حلماً.
Dialogue: 0,0:10:49.10,0:10:50.23,Default,,0,0,0,,&rlm;أتذكر هذا.
Dialogue: 0,0:10:51.35,0:10:53.36,Default,,0,0,0,,&rlm;ظننت أنني كنت أتوهم.
Dialogue: 0,0:10:54.02,0:10:56.65,Default,,0,0,0,,&rlm;يمكن للمسعفين التعامل مع الباقي.
Dialogue: 0,0:10:57.15,0:10:59.86,Default,,0,0,0,,&rlm;لكن في ذلك اليوم، أنا متأكد…
Dialogue: 0,0:11:00.78,0:11:01.82,Default,,0,0,0,,&rlm;من أن أحدهم كان…
Dialogue: 0,0:11:05.66,0:11:09.16,Default,,0,0,0,,&rlm;كنت أراقبك طوال هذا الوقت.
Dialogue: 0,0:11:10.46,0:11:12.63,Default,,0,0,0,,&rlm;رغم كل جهودي من داخل العائلة،
Dialogue: 0,0:11:12.71,0:11:15.67,Default,,0,0,0,,&rlm;لم أستطع كسر دوامة المآسي المتوارثة\Nفي عائلة "يوزاكورا".
Dialogue: 0,0:11:16.63,0:11:19.84,Default,,0,0,0,,&rlm;فاحتجت إلى إدخال دماء جديدة إلى العائلة.
Dialogue: 0,0:11:21.26,0:11:22.64,Default,,0,0,0,,&rlm;ولم أحتج إلى التفكير طويلاً.
Dialogue: 0,0:11:22.72,0:11:28.31,Default,,0,0,0,,&rlm;ولم يكن هناك أنسب لـ"موتسومي"\Nمن فتى بسيط وعفوي من الحي مثلك.
Dialogue: 0,0:11:37.82,0:11:41.57,Default,,0,0,0,,&rlm;أنا من اختارك.
Dialogue: 0,0:11:49.41,0:11:51.04,Default,,0,0,0,,&rlm;لا يهمني
Dialogue: 0,0:11:51.62,0:11:54.83,Default,,0,0,0,,&rlm;من سأضحي به ما دام ذلك يخدم مصالحكم.
Dialogue: 0,0:11:56.71,0:12:01.30,Default,,0,0,0,,&rlm;أنا من جعلك قوياً.
Dialogue: 0,0:12:08.35,0:12:12.56,Default,,0,0,0,,&rlm;صحيح أن الازدهار الساحق لـ10 آلاف زهرة\Nيمكنه مقاومة قدرة الازدهار خاصتي.
Dialogue: 0,0:12:13.10,0:12:17.44,Default,,0,0,0,,&rlm;لكن الآن بعد أن هزتك ذكرياتك،\Nتركت نفسك هدفاً سهلاً.
Dialogue: 0,0:12:18.07,0:12:20.90,Default,,0,0,0,,&rlm;أنت في منتصف حلم الآن
Dialogue: 0,0:12:21.44,0:12:23.45,Default,,0,0,0,,&rlm;لن تستيقظ منه أبداً.
Dialogue: 0,0:12:24.07,0:12:27.08,Default,,0,0,0,,&rlm;العائلة المثالية التي تخيلتها
Dialogue: 0,0:12:27.16,0:12:29.99,Default,,0,0,0,,&rlm;ستكتمل أخيراً هنا والآن.
Dialogue: 0,0:12:36.96,0:12:40.71,Default,,0,0,0,,&rlm;أهلاً بك يا "تايو" في عائلة "يوزاكورا".
Dialogue: 0,0:12:53.69,0:12:55.27,Default,,0,0,0,,&rlm;بئساً لهذا الوهم!
Dialogue: 0,0:13:05.74,0:13:07.66,Default,,0,0,0,,&rlm;دعني أريك
Dialogue: 0,0:13:08.32,0:13:12.54,Default,,0,0,0,,&rlm;النعيم الحقيقي حيث لا يُوجد أي شخص مفقود.
Dialogue: 0,0:13:13.66,0:13:16.17,Default,,0,0,0,,&rlm;يمكنك أن تهدأ.
Dialogue: 0,0:13:16.67,0:13:19.09,Default,,0,0,0,,&rlm;لست الملام على أي من هذا.
Dialogue: 0,0:13:19.17,0:13:20.63,Default,,0,0,0,,&rlm;لم تقترف أي خطأ.
Dialogue: 0,0:13:21.13,0:13:26.05,Default,,0,0,0,,&rlm;سلّم نفسك للحلم السعيد\Nالذي كنت تسعى إليه طوال هذا الوقت
Dialogue: 0,0:13:26.13,0:13:27.30,Default,,0,0,0,,&rlm;يا "تايو".
Dialogue: 0,0:13:27.97,0:13:31.06,Default,,0,0,0,,&rlm;لقد كبرت كثيراً يا "تايو".
Dialogue: 0,0:13:48.03,0:13:49.20,Default,,0,0,0,,&rlm;أمي.
Dialogue: 0,0:13:54.58,0:13:57.58,Default,,0,0,0,,&rlm;آسف لأنني تركتك وحدك يا "تايو".
Dialogue: 0,0:13:59.00,0:14:02.59,Default,,0,0,0,,{\an8}&rlm;"حفل الالتحاق بالمدرسة"
Dialogue: 0,0:14:14.56,0:14:15.56,Default,,0,0,0,,&rlm;أبي.
Dialogue: 0,0:14:16.60,0:14:19.60,Default,,0,0,0,,&rlm;اشتقت إليك يا أخي الكبير!
Dialogue: 0,0:14:24.69,0:14:27.15,Default,,0,0,0,,&rlm;"اضغط!"
Dialogue: 0,0:14:27.95,0:14:30.07,Default,,0,0,0,,&rlm;"أنت ربحت، أنت خسرت"
Dialogue: 0,0:14:37.12,0:14:38.25,Default,,0,0,0,,&rlm;"هايكارو".
Dialogue: 0,0:14:40.08,0:14:43.25,Default,,0,0,0,,&rlm;توقف عن هذا. لا تتحدث عن عائلتي
Dialogue: 0,0:14:43.34,0:14:46.55,Default,,0,0,0,,&rlm;باستخدام تلك الصور المزيفة\Nوالأصوات المزيفة!
Dialogue: 0,0:14:47.05,0:14:48.59,Default,,0,0,0,,&rlm;لا يمكنني رؤيتهم مجدداً.
Dialogue: 0,0:14:48.67,0:14:50.30,Default,,0,0,0,,&rlm;لا يمكنني التحدث إليهم مجدداً.
Dialogue: 0,0:14:50.38,0:14:51.93,Default,,0,0,0,,&rlm;لا يمكنني العودة أبداً.
Dialogue: 0,0:14:52.01,0:14:54.35,Default,,0,0,0,,&rlm;مهما ندمت، فقد فات الأوان.
Dialogue: 0,0:14:54.43,0:14:56.85,Default,,0,0,0,,&rlm;مهما اهتممت، فلن يجدي ذلك نفعاً!
Dialogue: 0,0:14:56.93,0:15:01.10,Default,,0,0,0,,&rlm;دعوت وصرخت وغضبت وبكيت…
Dialogue: 0,0:15:04.07,0:15:05.48,Default,,0,0,0,,&rlm;ثم تقبلت الواقع.
Dialogue: 0,0:15:06.15,0:15:09.70,Default,,0,0,0,,&rlm;إذاً عليك أن تتقبل مرة أخرى
Dialogue: 0,0:15:09.78,0:15:13.03,Default,,0,0,0,,&rlm;أن هذا هو المستقبل\Nالذي لطالما قُدر لك أن تدخله.
Dialogue: 0,0:15:13.12,0:15:19.12,Default,,0,0,0,,&rlm;إن تقبلته، فسيصبح الخيال واقعاً،\Nوستصبح الأكاذيب حقيقة.
Dialogue: 0,0:15:22.54,0:15:24.09,Default,,0,0,0,,&rlm;ثم انظرا…
Dialogue: 0,0:15:32.34,0:15:33.43,Default,,0,0,0,,&rlm;أنا في المنزل!
Dialogue: 0,0:15:34.30,0:15:35.60,Default,,0,0,0,,&rlm;أخي الكبير!
Dialogue: 0,0:15:37.06,0:15:38.72,Default,,0,0,0,,&rlm;أسرع يا أخي الكبير!
Dialogue: 0,0:15:38.81,0:15:41.81,Default,,0,0,0,,&rlm;دوّامة الأخ "ناناو" رائعة جداً!
Dialogue: 0,0:15:41.89,0:15:45.40,Default,,0,0,0,,&rlm;انتبه يا "هايكارو"!\Nقد تتأذى إن لم تنظر أمامك.
Dialogue: 0,0:15:45.48,0:15:47.61,Default,,0,0,0,,&rlm;"هايكارو" نشيط ومفعم بالحيوية!
Dialogue: 0,0:15:47.69,0:15:51.15,Default,,0,0,0,,&rlm;ولداي صبيّان، لذا لا أجد وقت راحة أبداً.
Dialogue: 0,0:15:51.24,0:15:53.45,Default,,0,0,0,,&rlm;لهذا أنا سعيدة جداً
Dialogue: 0,0:15:53.53,0:15:56.99,Default,,0,0,0,,&rlm;بكون فتاة مثل "موتسومي" زوجة لـ"تايو"!
Dialogue: 0,0:15:58.20,0:16:00.79,Default,,0,0,0,,&rlm;وأنا أيضاً سعيدة،\Nفقد دبّت الحياة في المكان!
Dialogue: 0,0:16:00.87,0:16:03.83,Default,,0,0,0,,&rlm;سيد "مومو"،\Nما رأيك في احتساء مشروب الليلة؟
Dialogue: 0,0:16:03.92,0:16:05.17,Default,,0,0,0,,&rlm;يبدو هذا جيداً!
Dialogue: 0,0:16:05.25,0:16:08.00,Default,,0,0,0,,&rlm;ما رأيك أن أفتح زجاجة أخرى\Nمن "يوزاكورا بليزارد"؟
Dialogue: 0,0:16:08.09,0:16:12.30,Default,,0,0,0,,&rlm;"تايو"! "هايكارو"! ارجعا إلى هنا الآن.
Dialogue: 0,0:16:21.48,0:16:22.48,Default,,0,0,0,,&rlm;لا.
Dialogue: 0,0:16:23.10,0:16:24.81,Default,,0,0,0,,&rlm;هذا ليس واقعاً.
Dialogue: 0,0:16:25.44,0:16:26.44,Default,,0,0,0,,&rlm;ومع ذلك…
Dialogue: 0,0:16:29.61,0:16:31.40,Default,,0,0,0,,&rlm;هيا بنا يا أخي الكبير.
Dialogue: 0,0:16:41.79,0:16:42.79,Default,,0,0,0,,&rlm;تباً!
Dialogue: 0,0:16:58.26,0:17:00.81,Default,,0,0,0,,&rlm;الأخ الكبير…
Dialogue: 0,0:17:07.81,0:17:12.86,Default,,0,0,0,,&rlm;ليس غريباً عليك\Nأن تدخل بعنف هكذا يا "كيويتشيرو".
Dialogue: 0,0:17:12.94,0:17:15.91,Default,,0,0,0,,&rlm;والآن اجلس.
Dialogue: 0,0:17:38.39,0:17:39.89,Default,,0,0,0,,&rlm;الأخ الكبير "كيويتشيرو"!
Dialogue: 0,0:17:44.10,0:17:45.64,Default,,0,0,0,,&rlm;"أراكني" - شبكة الإلهة،
Dialogue: 0,0:17:45.73,0:17:48.52,Default,,0,0,0,,&rlm;الجدار المنيع الذي يمنع عبور أي شيء،
Dialogue: 0,0:17:48.60,0:17:50.57,Default,,0,0,0,,&rlm;تقنية سرية من "العنكبوت الفولاذي".
Dialogue: 0,0:17:51.15,0:17:52.44,Default,,0,0,0,,&rlm;فهمت.
Dialogue: 0,0:17:52.53,0:17:55.32,Default,,0,0,0,,&rlm;لهذا لم تصل إليه رائحة أزهار الكرز
Dialogue: 0,0:17:55.40,0:17:58.70,Default,,0,0,0,,&rlm;ولم يؤثر فيه الازدهار خاصتي على الإطلاق.
Dialogue: 0,0:17:59.95,0:18:03.24,Default,,0,0,0,,&rlm;أرى أنك أتقنتها أخيراً يا "كيويتشيرو".
Dialogue: 0,0:18:03.74,0:18:07.00,Default,,0,0,0,,&rlm;أشعر بالحنين إلى الأيام\Nالتي قضيناها في ابتكارها معاً.
Dialogue: 0,0:18:07.08,0:18:10.84,Default,,0,0,0,,&rlm;مهارة صنعناها من أجل العائلة.
Dialogue: 0,0:18:10.92,0:18:13.55,Default,,0,0,0,,&rlm;لذا لم يكن من المفترض\Nأن نستخدمها بهذه الطريقة.
Dialogue: 0,0:18:17.01,0:18:18.80,Default,,0,0,0,,&rlm;سأحمي عائلتي
Dialogue: 0,0:18:18.88,0:18:21.97,Default,,0,0,0,,&rlm;من كل أنواع الشر…
Dialogue: 0,0:18:24.52,0:18:27.52,Default,,0,0,0,,&rlm;ومن كل ما سأفعله الآن.
Dialogue: 0,0:18:29.27,0:18:30.48,Default,,0,0,0,,&rlm;رائع.
Dialogue: 0,0:18:31.19,0:18:33.48,Default,,0,0,0,,&rlm;هذا رائع يا "كيويتشيرو"!
Dialogue: 0,0:18:37.07,0:18:40.03,Default,,0,0,0,,&rlm;صحيح أنني لا أستطيع تدمير\N"أراكني" - شبكة الإلهة،
Dialogue: 0,0:18:40.11,0:18:41.12,Default,,0,0,0,,&rlm;لكن…
Dialogue: 0,0:18:41.70,0:18:45.04,Default,,0,0,0,,&rlm;أنا من علّمك كيفية استخدام تلك الخيوط.
Dialogue: 0,0:18:45.66,0:18:48.41,Default,,0,0,0,,&rlm;أسلوبك في الخيوط هو روحك.
Dialogue: 0,0:18:48.50,0:18:52.88,Default,,0,0,0,,&rlm;أسلوبك في النسج يظهر حبك لعائلتك.
Dialogue: 0,0:18:53.46,0:18:57.30,Default,,0,0,0,,&rlm;قد لا أتمكن من كسرها، لكنني أستطيع فكها،
Dialogue: 0,0:18:57.38,0:18:59.34,Default,,0,0,0,,&rlm;كما أستطيع فك روحك.
Dialogue: 0,0:18:59.43,0:19:04.68,Default,,0,0,0,,&rlm;غضبك وكراهيتك تجاهي،\Nلم تعد بحاجة إلى ذكريات كهذه.
Dialogue: 0,0:19:04.76,0:19:08.27,Default,,0,0,0,,&rlm;لا مزيد من التفكير في أن عليك قتلي.
Dialogue: 0,0:19:08.85,0:19:13.19,Default,,0,0,0,,&rlm;لأنك ستحبني بدءاً من الآن.
Dialogue: 0,0:19:43.89,0:19:46.10,Default,,0,0,0,,&rlm;أراك تجتهد في الصباح الباكر!
Dialogue: 0,0:19:47.39,0:19:48.39,Default,,0,0,0,,&rlm;أبي.
Dialogue: 0,0:19:49.35,0:19:52.10,Default,,0,0,0,,&rlm;ما رأيك في مبارزتي قليلاً؟
Dialogue: 0,0:19:59.28,0:20:03.74,Default,,0,0,0,,&rlm;سرعة رد فعلك مقبولة،\Nلكن حركاتك متوقعة جداً.
Dialogue: 0,0:20:03.82,0:20:07.79,Default,,0,0,0,,&rlm;عليك صدّ هجمات متعددة بخيط واحد.
Dialogue: 0,0:20:07.87,0:20:10.66,Default,,0,0,0,,&rlm;اضغط على عدوك بالمناورات الدفاعية.
Dialogue: 0,0:20:14.96,0:20:19.17,Default,,0,0,0,,&rlm;إن فعلت ذلك، فستكسب وقتاً للهجوم على عدوك.
Dialogue: 0,0:20:25.05,0:20:28.51,Default,,0,0,0,,&rlm;أحسنت يا بني! إنك سريع التعلم!
Dialogue: 0,0:20:28.60,0:20:29.68,Default,,0,0,0,,&rlm;والآن…
Dialogue: 0,0:20:29.77,0:20:31.10,Default,,0,0,0,,&rlm;ماذا؟
Dialogue: 0,0:20:31.73,0:20:33.35,Default,,0,0,0,,&rlm;يا للروعة!
Dialogue: 0,0:20:33.44,0:20:35.81,Default,,0,0,0,,&rlm;هذان قفازا "العنكبوت الفولاذي".
Dialogue: 0,0:20:35.90,0:20:38.90,Default,,0,0,0,,&rlm;إنهما أنسب لك من البنادق والسكاكين، صحيح؟
Dialogue: 0,0:20:38.98,0:20:41.03,Default,,0,0,0,,&rlm;بالمناسبة، لدينا زوجان متطابقان!
Dialogue: 0,0:20:42.19,0:20:45.61,Default,,0,0,0,,&rlm;كنت تتدرب بيدين عاريتين حتى الآن،
Dialogue: 0,0:20:45.70,0:20:48.12,Default,,0,0,0,,&rlm;لذا شعرت بكل حركة دقيقة لتلك الخيوط.
Dialogue: 0,0:20:48.20,0:20:51.75,Default,,0,0,0,,&rlm;وبفضل ذلك، أصبحت خيوطك أشد حدة.
Dialogue: 0,0:20:51.83,0:20:55.92,Default,,0,0,0,,&rlm;فالخطوة التالية\Nفهم الطبيعة الحقيقية لتلك القوة.
Dialogue: 0,0:20:56.92,0:20:59.92,Default,,0,0,0,,&rlm;كيف تريد استخدام هذه القوة؟
Dialogue: 0,0:21:00.59,0:21:03.88,Default,,0,0,0,,&rlm;سأستخدم هذه القوة لحماية الجميع.
Dialogue: 0,0:21:04.59,0:21:06.22,Default,,0,0,0,,&rlm;حقاً؟
Dialogue: 0,0:21:06.30,0:21:09.39,Default,,0,0,0,,&rlm;تلك الخيوط تقطع أعداءك،\Nوتحيط بحلفائك لتحميهم.
Dialogue: 0,0:21:09.89,0:21:14.69,Default,,0,0,0,,&rlm;قد يكون القفازان سلاحين،\Nلكنهما أيضاً درع لحماية يديك.
Dialogue: 0,0:21:14.77,0:21:16.98,Default,,0,0,0,,&rlm;بذلت قصارى جهدي في نسجهما
Dialogue: 0,0:21:17.06,0:21:19.52,Default,,0,0,0,,&rlm;لكيلا تتأذى.
Dialogue: 0,0:21:19.61,0:21:21.65,Default,,0,0,0,,&rlm;فاعتن بهما جيداً.
Dialogue: 0,0:21:21.73,0:21:23.53,Default,,0,0,0,,&rlm;شكراً يا أبي.
Dialogue: 0,0:21:24.32,0:21:26.11,Default,,0,0,0,,&rlm;سأحافظ عليهما.
Dialogue: 0,0:21:34.91,0:21:38.38,Default,,0,0,0,,&rlm;ليس عليك أن تبذل كل هذا الجهد\Nلغسل دماغي يا أبي.
Dialogue: 0,0:21:38.88,0:21:40.00,Default,,0,0,0,,&rlm;ففي النهاية، أنا…
Dialogue: 0,0:21:40.67,0:21:42.25,Default,,0,0,0,,&rlm;أحبك يا أبي.
Dialogue: 0,0:21:42.76,0:21:44.13,Default,,0,0,0,,&rlm;في الماضي والآن.
Dialogue: 0,0:21:47.18,0:21:51.18,Default,,0,0,0,,&rlm;لهذا السبب كان يجب أن أوقفك،\Nلكنني لم أستطع فعل ذلك.
Dialogue: 0,0:21:51.68,0:21:52.68,Default,,0,0,0,,&rlm;لأن…
Dialogue: 0,0:21:52.77,0:21:57.69,Default,,0,0,0,,&rlm;كانت لديّ آمال كبيرة بأن عائلتي قد تعود.
Dialogue: 0,0:21:58.73,0:22:00.82,Default,,0,0,0,,&rlm;مع أنني كنت أعرف أن هذا لن يحدث أبداً.
Dialogue: 0,0:22:01.73,0:22:03.03,Default,,0,0,0,,&rlm;أنا لا أختلف…
Dialogue: 0,0:22:03.11,0:22:04.24,Default,,0,0,0,,&rlm;عنك يا أبي.
Dialogue: 0,0:22:07.40,0:22:10.87,Default,,0,0,0,,&rlm;فلننه هذا الآن لمصلحتنا.
Dialogue: 0,0:22:33.26,0:22:35.56,Default,,0,0,0,,&rlm;وداعاً يا أبي.
Dialogue: 0,0:24:16.91,0:24:18.91,Default,,0,0,0,,&rlm;ترجمة "مطيع الصابوني"

