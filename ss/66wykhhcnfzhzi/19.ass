Dialogue: 0,0:00:10.88,0:00:12.84,Default,,0,0,0,,{\i1}Taiyo!{\i0}
Dialogue: 0,0:00:12.93,0:00:14.51,Default,,0,0,0,,{\i1}Frate mai mare!{\i0}
Dialogue: 0,0:00:16.76,0:00:19.60,Default,,0,0,0,,Frățioare?
Dialogue: 0,0:00:20.68,0:00:22.31,Default,,0,0,0,,Te simți bine, frate mai mare?
Dialogue: 0,0:00:22.39,0:00:23.81,Default,,0,0,0,,Aveai un coșmar.
Dialogue: 0,0:00:23.89,0:00:24.90,Default,,0,0,0,,Ce?
Dialogue: 0,0:00:24.98,0:00:27.27,Default,,0,0,0,,Da, sunt bine.
Dialogue: 0,0:00:30.23,0:00:31.24,Default,,0,0,0,,Ce?
Dialogue: 0,0:00:34.28,0:00:35.41,Default,,0,0,0,,Ce s-a întâmplat?
Dialogue: 0,0:00:36.82,0:00:37.82,Default,,0,0,0,,Hikaru?
Dialogue: 0,0:00:37.91,0:00:38.91,Default,,0,0,0,,Ce este?
Dialogue: 0,0:00:39.49,0:00:41.33,Default,,0,0,0,,Unde sunt mama și tata?
Dialogue: 0,0:00:41.83,0:00:44.54,Default,,0,0,0,,Cei doi sunt treji de ceva timp.
Dialogue: 0,0:00:46.83,0:00:48.09,Default,,0,0,0,,L-am trezit!
Dialogue: 0,0:00:48.17,0:00:49.55,Default,,0,0,0,,Bună dimineața, Taiyo!
Dialogue: 0,0:00:49.63,0:00:51.88,Default,,0,0,0,,Micul dejun e pregătit deja.
Dialogue: 0,0:00:52.55,0:00:54.68,Default,,0,0,0,,Nu-ți stă în fire să dormi așa mult.
Dialogue: 0,0:00:58.30,0:00:59.55,Default,,0,0,0,,Haide, frate mai mare!
Dialogue: 0,0:00:59.64,0:01:02.56,Default,,0,0,0,,Să luăm micul dejun rapid,\Nca să mergem să ne jucăm iar!
Dialogue: 0,0:01:02.64,0:01:04.14,Default,,0,0,0,,Bine.
Dialogue: 0,0:01:19.91,0:01:24.83,Default,,0,0,0,,MISIUNE: FAMILIA YOZAKURA
Dialogue: 0,0:02:42.03,0:02:43.70,Default,,0,0,0,,Mulțumesc pentru micul dejun!
Dialogue: 0,0:02:46.24,0:02:48.29,Default,,0,0,0,,Stai puțin! N-ai terminat din farfurie.
Dialogue: 0,0:02:48.37,0:02:50.96,Default,,0,0,0,,Dacă nu mănânci bine, nu o să crești.
Dialogue: 0,0:02:51.04,0:02:54.54,Default,,0,0,0,,Exact! Uită-te la mine! Mai cer o porție.
Dialogue: 0,0:02:54.63,0:02:57.01,Default,,0,0,0,,De asta ai burta așa mare, nu?
Dialogue: 0,0:02:57.88,0:03:00.43,Default,,0,0,0,,- Ai observat și tu, Hikaru?\N- Ce?
Dialogue: 0,0:03:00.51,0:03:02.43,Default,,0,0,0,,Te îngrași la vârsta mijlocie?
Dialogue: 0,0:03:02.51,0:03:03.72,Default,,0,0,0,,Nu și tu, dragă!
Dialogue: 0,0:03:03.80,0:03:07.72,Default,,0,0,0,,Ei bine, recunosc că în ultima vreme…\NHai să schimbăm subiectul!
Dialogue: 0,0:03:08.52,0:03:13.40,Default,,0,0,0,,Haide, Hikaru!\NTe ajut eu, să termini din farfurie.
Dialogue: 0,0:03:15.23,0:03:18.36,Default,,0,0,0,,- Uau!\N- Mulțumesc, Taiyo!
Dialogue: 0,0:03:18.44,0:03:19.90,Default,,0,0,0,,Frate mai mare!
Dialogue: 0,0:03:19.99,0:03:21.49,Default,,0,0,0,,N-ai vărsat niciun pic de ceai?
Dialogue: 0,0:03:21.57,0:03:23.07,Default,,0,0,0,,Nu, sunt bine.
Dialogue: 0,0:03:23.16,0:03:26.16,Default,,0,0,0,,{\i1}Cum am… doar ce…{\i0}
Dialogue: 0,0:03:26.24,0:03:29.70,Default,,0,0,0,,Ce-ar fi să mergem undeva\Nîn weekendul ăsta?
Dialogue: 0,0:03:29.79,0:03:32.58,Default,,0,0,0,,Bună idee! Unde vreți să mergeți?
Dialogue: 0,0:03:32.67,0:03:34.88,Default,,0,0,0,,Eu vreau să merg cu cortul!
Dialogue: 0,0:03:34.96,0:03:36.67,Default,,0,0,0,,Cu cortul?
Dialogue: 0,0:03:36.75,0:03:39.21,Default,,0,0,0,,Dacă stau să mă gândesc,\Nn-am mai făcut asta demult.
Dialogue: 0,0:03:39.30,0:03:42.30,Default,,0,0,0,,Când eram mai tânăr,\Nvisam să merg singur cu cortul.
Dialogue: 0,0:03:42.38,0:03:46.43,Default,,0,0,0,,Am citit o grămadă de reviste\Nși mi-am cumpărat tot echipamentul…
Dialogue: 0,0:03:46.51,0:03:49.68,Default,,0,0,0,,dar n-am apucat să-l folosesc niciodată.
Dialogue: 0,0:03:49.77,0:03:51.89,Default,,0,0,0,,Tu ce ai vrea să faci Taiyo?
Dialogue: 0,0:03:51.98,0:03:53.02,Default,,0,0,0,,Orice…
Dialogue: 0,0:03:53.10,0:03:54.65,Default,,0,0,0,,e în regulă pentru mine.
Dialogue: 0,0:03:54.73,0:03:56.61,Default,,0,0,0,,Dar ce faci cu serviciul, mamă?
Dialogue: 0,0:03:56.69,0:03:59.07,Default,,0,0,0,,Mi-am luat ceva timp liber.
Dialogue: 0,0:03:59.15,0:04:01.70,Default,,0,0,0,,- Ești tare!\N- Bravo!
Dialogue: 0,0:04:01.78,0:04:03.03,Default,,0,0,0,,O să fie distractiv!
Dialogue: 0,0:04:08.08,0:04:10.91,Default,,0,0,0,,APASĂ!
Dialogue: 0,0:04:11.75,0:04:13.96,Default,,0,0,0,,JOCUL S-A TERMINAT
Dialogue: 0,0:04:14.04,0:04:16.50,Default,,0,0,0,,Haide, frate, ce-a fost asta?
Dialogue: 0,0:04:16.59,0:04:18.38,Default,,0,0,0,,Am pierdut din cauza ta!
Dialogue: 0,0:04:18.46,0:04:19.92,Default,,0,0,0,,Greșeala mea!
Dialogue: 0,0:04:20.51,0:04:24.76,Default,,0,0,0,,Nu ești în apele tale azi, frate mai mare.\NAi fost cu capul în nori tot timpul.
Dialogue: 0,0:04:24.84,0:04:27.47,Default,,0,0,0,,Îmi pare rău, hai să încercăm iar!
Dialogue: 0,0:04:27.55,0:04:29.97,Default,,0,0,0,,Bine, dar concentrează-te de data asta!
Dialogue: 0,0:04:30.06,0:04:31.48,Default,,0,0,0,,Recepționat!
Dialogue: 0,0:04:32.02,0:04:33.02,Default,,0,0,0,,{\an8}ÎNCĂRCARE
Dialogue: 0,0:04:33.10,0:04:35.40,Default,,0,0,0,,{\an8}Te lași prea descoperit.
Dialogue: 0,0:04:35.48,0:04:38.23,Default,,0,0,0,,Trebuie să fii atent\Nla tot ce se întâmplă în jur.
Dialogue: 0,0:04:38.94,0:04:41.82,Default,,0,0,0,,Bun, de data asta sigur terminam nivelul!
Dialogue: 0,0:04:43.20,0:04:44.78,Default,,0,0,0,,{\i1}Ce a fost asta?{\i0}
Dialogue: 0,0:04:45.95,0:04:47.37,Default,,0,0,0,,{\i1}Parcă…{\i0}
Dialogue: 0,0:04:47.45,0:04:50.37,Default,,0,0,0,,{\i1}Am uitat ceva important.{\i0}
Dialogue: 0,0:04:53.21,0:04:54.87,Default,,0,0,0,,{\i1}Ei bine, în fine.{\i0}
Dialogue: 0,0:05:13.98,0:05:16.35,Default,,0,0,0,,{\i1}Frate mai mare, Shinzo! Kengo!{\i0}
Dialogue: 0,0:05:20.44,0:05:21.69,Default,,0,0,0,,{\i1}La navă?{\i0}
Dialogue: 0,0:05:55.64,0:05:56.94,Default,,0,0,0,,Mutsumi!
Dialogue: 0,0:06:08.95,0:06:11.28,Default,,0,0,0,,Frate mai mare Kyoichiro!\NSoră mai mare Futaba!
Dialogue: 0,0:06:13.83,0:06:15.66,Default,,0,0,0,,Kengo! Nanao!
Dialogue: 0,0:06:20.58,0:06:21.79,Default,,0,0,0,,{\i1}Toți?{\i0}
Dialogue: 0,0:06:24.38,0:06:27.30,Default,,0,0,0,,{\i1}Asta e puterea tatei?{\i0}
Dialogue: 0,0:06:37.89,0:06:39.94,Default,,0,0,0,,{\i1}Scanarea navei e completă.{\i0}
Dialogue: 0,0:06:40.02,0:06:44.15,Default,,0,0,0,,{\i1}Detectez concentrații mari de someinină,{\i0}\N{\i1}care se răspândesc prin navă, ca un virus.{\i0}
Dialogue: 0,0:06:44.23,0:06:47.36,Default,,0,0,0,,{\i1}Dacă explodează toate odată,{\i0}\N{\i1}nu doar nava va fi distrusă.{\i0}
Dialogue: 0,0:06:47.44,0:06:50.11,Default,,0,0,0,,{\i1}Va fi devastată întreaga zonă.{\i0}
Dialogue: 0,0:06:50.20,0:06:52.32,Default,,0,0,0,,Ai reușit să contactezi familia Yozakura?
Dialogue: 0,0:06:52.41,0:06:56.04,Default,,0,0,0,,{\i1}Modulele au ars complet,{\i0}\N{\i1}deci nu mai putem comunica.{\i0}
Dialogue: 0,0:06:56.12,0:06:57.87,Default,,0,0,0,,Trebuie să-i salvăm!
Dialogue: 0,0:06:57.95,0:06:59.12,Default,,0,0,0,,Stai, Ryu!
Dialogue: 0,0:07:00.12,0:07:01.33,Default,,0,0,0,,Nu mă opri!
Dialogue: 0,0:07:02.21,0:07:06.30,Default,,0,0,0,,Nu putem merge orbește,\Nfără să știm ce se întâmplă.
Dialogue: 0,0:07:06.80,0:07:09.42,Default,,0,0,0,,Sunt de acord cu președintele.
Dialogue: 0,0:07:11.72,0:07:12.97,Default,,0,0,0,,Bine, atunci. Fie.
Dialogue: 0,0:07:13.97,0:07:17.10,Default,,0,0,0,,Giga, contactează\Ncamera de control a portului!
Dialogue: 0,0:07:17.18,0:07:19.43,Default,,0,0,0,,Cere-le să extindă zona de blocadă!
Dialogue: 0,0:07:19.52,0:07:20.85,Default,,0,0,0,,{\i1}Recepționat!{\i0}
Dialogue: 0,0:07:24.44,0:07:26.36,Default,,0,0,0,,Lăsăm restul în seama lor.
Dialogue: 0,0:07:27.36,0:07:30.03,Default,,0,0,0,,{\i1}Indiferent de situație,{\i0}\N{\i1}felul în care stau lucrurile acum…{\i0}
Dialogue: 0,0:07:31.40,0:07:33.16,Default,,0,0,0,,{\i1}Singurul care-i poate salva pe toți…{\i0}
Dialogue: 0,0:07:34.78,0:07:36.08,Default,,0,0,0,,{\i1}sunt eu!{\i0}
Dialogue: 0,0:07:50.05,0:07:54.76,Default,,0,0,0,,Mi-ai măcelărit oamenii trimiși\Nsă te întâmpine. Ce barbarie!
Dialogue: 0,0:07:54.84,0:07:57.22,Default,,0,0,0,,Începi să te porți ca Kyoichiro.
Dialogue: 0,0:07:57.31,0:07:59.93,Default,,0,0,0,,O să vină imediat.
Dialogue: 0,0:08:21.29,0:08:23.75,Default,,0,0,0,,Bun venit acasă, Taiyo!
Dialogue: 0,0:08:24.83,0:08:26.13,Default,,0,0,0,,E ora cinei!
Dialogue: 0,0:08:26.63,0:08:27.96,Default,,0,0,0,,Luați loc!
Dialogue: 0,0:08:40.01,0:08:41.89,Default,,0,0,0,,Ce le-ai făcut?
Dialogue: 0,0:08:52.36,0:08:55.41,Default,,0,0,0,,Înflorirea mea se numește „Visuri”.
Dialogue: 0,0:08:57.32,0:08:58.95,Default,,0,0,0,,{\i1}Și tu ai avut unul, nu-i așa?{\i0}
Dialogue: 0,0:08:59.03,0:09:03.37,Default,,0,0,0,,{\i1}Un vis ideal în care durerea și suferința{\i0}\N{\i1}nu există.{\i0}
Dialogue: 0,0:09:04.75,0:09:09.38,Default,,0,0,0,,Tot ce învăluie parfumul acestor\Nflori de cireș face parte din visul meu.
Dialogue: 0,0:09:09.88,0:09:12.05,Default,,0,0,0,,Nu există niciun suflet care să-i reziste.
Dialogue: 0,0:09:12.13,0:09:16.76,Default,,0,0,0,,Cu excepția ta,\Nfiindcă ai sângele lui Tsubomi.
Dialogue: 0,0:09:20.68,0:09:23.93,Default,,0,0,0,,Fă-i pe toți să redevină cum erau!
Dialogue: 0,0:09:24.02,0:09:26.27,Default,,0,0,0,,I-am transformat.
Dialogue: 0,0:09:26.77,0:09:29.40,Default,,0,0,0,,În cine ar trebui să fie familia mea.
Dialogue: 0,0:09:30.36,0:09:31.86,Default,,0,0,0,,Asta numești tu familie?
Dialogue: 0,0:09:32.57,0:09:34.11,Default,,0,0,0,,O familie este…
Dialogue: 0,0:09:37.70,0:09:39.32,Default,,0,0,0,,MORMÂNTUL FAMILIEI ASANO
Dialogue: 0,0:09:40.03,0:09:41.99,Default,,0,0,0,,O familie este…
Dialogue: 0,0:09:43.66,0:09:47.42,Default,,0,0,0,,Te înșeli. Asta înseamnă familia, Taiyo!
Dialogue: 0,0:09:49.54,0:09:51.46,Default,,0,0,0,,Ar trebui să știi.
Dialogue: 0,0:09:51.96,0:09:54.09,Default,,0,0,0,,Familiile sunt fragile și efemere.
Dialogue: 0,0:09:54.71,0:09:57.97,Default,,0,0,0,,De aceea am decis să creez una de la zero.
Dialogue: 0,0:09:58.55,0:10:01.60,Default,,0,0,0,,O familie puternică\Ncare nu poate fi distrusă niciodată.
Dialogue: 0,0:10:26.79,0:10:28.21,Default,,0,0,0,,Am ajuns prea târziu.
Dialogue: 0,0:10:28.29,0:10:31.92,Default,,0,0,0,,Nenorocitul de Kawashita!\NCum a îndrăznit să facă asta…
Dialogue: 0,0:10:32.00,0:10:34.71,Default,,0,0,0,,Băiatul ăsta îmi aparține!
Dialogue: 0,0:10:39.84,0:10:41.43,Default,,0,0,0,,Te aduc eu înapoi.
Dialogue: 0,0:10:46.93,0:10:48.23,Default,,0,0,0,,{\i1}Nu e un vis.{\i0}
Dialogue: 0,0:10:49.10,0:10:50.23,Default,,0,0,0,,{\i1}Îmi amintesc asta.{\i0}
Dialogue: 0,0:10:51.35,0:10:53.36,Default,,0,0,0,,{\i1}Credeam că am viziuni.{\i0}
Dialogue: 0,0:10:54.02,0:10:56.65,Default,,0,0,0,,Paramedicii se descurcă cu restul.
Dialogue: 0,0:10:57.15,0:10:59.86,Default,,0,0,0,,{\i1}Dar, în acea zi, sunt sigur că…{\i0}
Dialogue: 0,0:11:00.78,0:11:01.82,Default,,0,0,0,,{\i1}a fost cineva…{\i0}
Dialogue: 0,0:11:05.66,0:11:09.16,Default,,0,0,0,,Te-am vegheat în tot acest timp.
Dialogue: 0,0:11:10.46,0:11:12.63,Default,,0,0,0,,{\i1}Oricât m-am zbătut din interior,{\i0}
Dialogue: 0,0:11:12.71,0:11:15.67,Default,,0,0,0,,{\i1}n-am putut rupe{\i0}\N{\i1}ciclul karmic al familiei Yozakura.{\i0}
Dialogue: 0,0:11:16.63,0:11:19.84,Default,,0,0,0,,{\i1}Așa că aveam nevoie de sânge proaspăt.{\i0}
Dialogue: 0,0:11:21.26,0:11:22.64,Default,,0,0,0,,{\i1}A fost foarte simplu.{\i0}
Dialogue: 0,0:11:22.72,0:11:28.31,Default,,0,0,0,,{\i1}Un băiat simplu și sincer ca tine{\i0}\N{\i1}era perfect pentru Mutsumi.{\i0}
Dialogue: 0,0:11:37.82,0:11:41.57,Default,,0,0,0,,{\i1}Eu te-am ales pe tine.{\i0}
Dialogue: 0,0:11:49.41,0:11:51.04,Default,,0,0,0,,{\i1}Nu-mi pasă{\i0}
Dialogue: 0,0:11:51.62,0:11:54.83,Default,,0,0,0,,{\i1}pe cine trebuie să sacrific,{\i0}\N{\i1}dacă e pentru binele vostru.{\i0}
Dialogue: 0,0:11:56.71,0:12:01.30,Default,,0,0,0,,Eu te-am făcut puternic.
Dialogue: 0,0:12:08.35,0:12:12.56,Default,,0,0,0,,E adevărat, Înflorirea abundentă a 10.000\Nde flori poate rezista Înfloririi mele.
Dialogue: 0,0:12:13.10,0:12:17.44,Default,,0,0,0,,Dar acum, că ești zguduit de amintiri,\Nte-ai lăsat vulnerabil.
Dialogue: 0,0:12:18.07,0:12:20.90,Default,,0,0,0,,Acum ești în mijlocul unui vis
Dialogue: 0,0:12:21.44,0:12:23.45,Default,,0,0,0,,din care nu te vei mai trezi niciodată.
Dialogue: 0,0:12:24.07,0:12:27.08,Default,,0,0,0,,Familia ideală pe care mi-am imaginat-o
Dialogue: 0,0:12:27.16,0:12:29.99,Default,,0,0,0,,va fi, în sfârșit, completă aici și acum.
Dialogue: 0,0:12:36.96,0:12:40.71,Default,,0,0,0,,Bine ai venit Taiyo, în familia Yozakura!
Dialogue: 0,0:12:53.69,0:12:55.27,Default,,0,0,0,,La naiba cu iluzia asta!
Dialogue: 0,0:13:05.74,0:13:07.66,Default,,0,0,0,,Lasă-mă să-ți arat
Dialogue: 0,0:13:08.32,0:13:12.54,Default,,0,0,0,,fericirea adevărată\Ndin care nu lipsește nicio persoană.
Dialogue: 0,0:13:13.66,0:13:16.17,Default,,0,0,0,,Poți să te relaxezi.
Dialogue: 0,0:13:16.67,0:13:19.09,Default,,0,0,0,,Nu ești tu de vină pentru asta.
Dialogue: 0,0:13:19.17,0:13:20.63,Default,,0,0,0,,Nu ai făcut nimic greșit.
Dialogue: 0,0:13:21.13,0:13:26.05,Default,,0,0,0,,Predă-te visului fericit\Npe care l-ai căutat în tot acest timp…
Dialogue: 0,0:13:26.13,0:13:27.30,Default,,0,0,0,,Taiyo!
Dialogue: 0,0:13:27.97,0:13:31.06,Default,,0,0,0,,Te-ai făcut așa mare, Taiyo!
Dialogue: 0,0:13:48.03,0:13:49.20,Default,,0,0,0,,{\i1}Mamă!{\i0}
Dialogue: 0,0:13:54.58,0:13:57.58,Default,,0,0,0,,Îmi pare rău că te las singur, Taiyo.
Dialogue: 0,0:13:59.00,0:14:02.59,Default,,0,0,0,,{\an8}CEREMONIA DE ÎNMATRICULARE
Dialogue: 0,0:14:14.56,0:14:15.56,Default,,0,0,0,,{\i1}Tată!{\i0}
Dialogue: 0,0:14:16.60,0:14:19.60,Default,,0,0,0,,Mi-ai lipsit, frate mai mare!
Dialogue: 0,0:14:24.69,0:14:27.15,Default,,0,0,0,,APASĂ!
Dialogue: 0,0:14:27.95,0:14:30.07,Default,,0,0,0,,PIERZĂTOR - CÂȘTIGĂTOR
Dialogue: 0,0:14:37.12,0:14:38.25,Default,,0,0,0,,{\i1}Hikaru!{\i0}
Dialogue: 0,0:14:40.08,0:14:43.25,Default,,0,0,0,,Oprește-te! Nu vorbi despre familia mea
Dialogue: 0,0:14:43.34,0:14:46.55,Default,,0,0,0,,folosind imaginile și vocile astea false!
Dialogue: 0,0:14:47.05,0:14:48.59,Default,,0,0,0,,{\i1}Nu-i voi mai vedea niciodată!{\i0}
Dialogue: 0,0:14:48.67,0:14:50.30,Default,,0,0,0,,{\i1}Nu voi mai putea vorbi cu ei!{\i0}
Dialogue: 0,0:14:50.38,0:14:51.93,Default,,0,0,0,,{\i1}Nu pot da timpul înapoi!{\i0}
Dialogue: 0,0:14:52.01,0:14:54.35,Default,,0,0,0,,Indiferent cât regret, e prea târziu.
Dialogue: 0,0:14:54.43,0:14:56.85,Default,,0,0,0,,Oricât mi-ar păsa, nu schimbă nimic!
Dialogue: 0,0:14:56.93,0:15:01.10,Default,,0,0,0,,{\i1}M-am rugat, am țipat,{\i0}\N{\i1}m-am înfuriat, am plâns…{\i0}
Dialogue: 0,0:15:04.07,0:15:05.48,Default,,0,0,0,,și am acceptat.
Dialogue: 0,0:15:06.15,0:15:09.70,Default,,0,0,0,,Atunci acceptă
Dialogue: 0,0:15:09.78,0:15:13.03,Default,,0,0,0,,și viitorul care ți-a fost mereu sortit.
Dialogue: 0,0:15:13.12,0:15:19.12,Default,,0,0,0,,Astfel, ficțiunea va deveni realitate,\Niar minciunile vor deveni adevăr.
Dialogue: 0,0:15:22.54,0:15:24.09,Default,,0,0,0,,Și apoi, o să vezi…
Dialogue: 0,0:15:32.34,0:15:33.43,Default,,0,0,0,,Sunt acasă!
Dialogue: 0,0:15:34.30,0:15:35.60,Default,,0,0,0,,Frate mai mare!
Dialogue: 0,0:15:37.06,0:15:38.72,Default,,0,0,0,,Grăbește-te, frate mai mare!
Dialogue: 0,0:15:38.81,0:15:41.81,Default,,0,0,0,,Caruselul fratelui Nanao e minunat!
Dialogue: 0,0:15:41.89,0:15:45.40,Default,,0,0,0,,Ușurel, Hikaru!\NE periculos să nu te uiți pe unde mergi.
Dialogue: 0,0:15:45.48,0:15:47.61,Default,,0,0,0,,Hikaru e plin de energie!
Dialogue: 0,0:15:47.69,0:15:51.15,Default,,0,0,0,,Cu doi băieți, nu am o clipă de liniște.
Dialogue: 0,0:15:51.24,0:15:53.45,Default,,0,0,0,,De asta mă bucur atât de mult
Dialogue: 0,0:15:53.53,0:15:56.99,Default,,0,0,0,,că Taiyo se însoară cu o fată ca Mutsumi!
Dialogue: 0,0:15:58.20,0:16:00.79,Default,,0,0,0,,Toate lumea e fericită acum,\Niar eu mă bucur mult.
Dialogue: 0,0:16:00.87,0:16:03.83,Default,,0,0,0,,Dle Momo,\Nce zici de o băutură în seara asta?
Dialogue: 0,0:16:03.92,0:16:05.17,Default,,0,0,0,,Sună bine!
Dialogue: 0,0:16:05.25,0:16:08.00,Default,,0,0,0,,Ce-ar fi să mai deschid o sticlă\Nde Viscol Yozakura?
Dialogue: 0,0:16:08.09,0:16:12.30,Default,,0,0,0,,Hei, Taiyo! Hikaru! Veniți aici!
Dialogue: 0,0:16:21.48,0:16:22.48,Default,,0,0,0,,{\i1}Nu!{\i0}
Dialogue: 0,0:16:23.10,0:16:24.81,Default,,0,0,0,,{\i1}Asta nu e realitatea!{\i0}
Dialogue: 0,0:16:25.44,0:16:26.44,Default,,0,0,0,,{\i1}Și totuși…{\i0}
Dialogue: 0,0:16:29.61,0:16:31.40,Default,,0,0,0,,Să mergem, frate mai mare!
Dialogue: 0,0:16:41.79,0:16:42.79,Default,,0,0,0,,{\i1}Fir-ar să fie!{\i0}
Dialogue: 0,0:16:58.26,0:17:00.81,Default,,0,0,0,,Frate mai mare…
Dialogue: 0,0:17:07.81,0:17:12.86,Default,,0,0,0,,Numai tu puteai să-ți faci apariția\Natât de brutal, Kyoichiro.
Dialogue: 0,0:17:12.94,0:17:15.91,Default,,0,0,0,,Haide, ia loc!
Dialogue: 0,0:17:38.39,0:17:39.89,Default,,0,0,0,,Frate mai mare, Kyoichiro!
Dialogue: 0,0:17:44.10,0:17:45.64,Default,,0,0,0,,Arachne – Pânza Zeiței…
Dialogue: 0,0:17:45.73,0:17:48.52,Default,,0,0,0,,Un zid de nepătruns care blochează totul,
Dialogue: 0,0:17:48.60,0:17:50.57,Default,,0,0,0,,o tehnică secretă a Păianjenului de oțel.
Dialogue: 0,0:17:51.15,0:17:52.44,Default,,0,0,0,,Înțeleg.
Dialogue: 0,0:17:52.53,0:17:55.32,Default,,0,0,0,,De aceea, parfumul florilor de cireș\Nn-a ajuns la el,
Dialogue: 0,0:17:55.40,0:17:58.70,Default,,0,0,0,,iar Înflorirea mea nu l-a afectat deloc.
Dialogue: 0,0:17:59.95,0:18:03.24,Default,,0,0,0,,Văd că l-ai perfecționat,\Nîn sfârșit, Kyoichiro.
Dialogue: 0,0:18:03.74,0:18:07.00,Default,,0,0,0,,Mi-e dor de zilele în care încercam\Ns-o facem împreună.
Dialogue: 0,0:18:07.08,0:18:10.84,Default,,0,0,0,,E o abilitate pe care am creat-o\Nde dragul familiei.
Dialogue: 0,0:18:10.92,0:18:13.55,Default,,0,0,0,,Deci nu trebuia să fie folosită așa.
Dialogue: 0,0:18:17.01,0:18:18.80,Default,,0,0,0,,Îmi voi proteja familia…
Dialogue: 0,0:18:18.88,0:18:21.97,Default,,0,0,0,,de orice fel de rău și…
Dialogue: 0,0:18:24.52,0:18:27.52,Default,,0,0,0,,de tot ceea ce urmează să fac acum.
Dialogue: 0,0:18:29.27,0:18:30.48,Default,,0,0,0,,Minunat!
Dialogue: 0,0:18:31.19,0:18:33.48,Default,,0,0,0,,E minunat, Kyoichiro!
Dialogue: 0,0:18:37.07,0:18:40.03,Default,,0,0,0,,{\i1}E adevărat că nu pot distruge{\i0}\N{\i1}Arachne: Pânza Zeiței.{\i0}
Dialogue: 0,0:18:40.11,0:18:41.12,Default,,0,0,0,,{\i1}Dar…{\i0}
Dialogue: 0,0:18:41.70,0:18:45.04,Default,,0,0,0,,{\i1}Eu te-am învățat să folosești firele.{\i0}
Dialogue: 0,0:18:45.66,0:18:48.41,Default,,0,0,0,,{\i1}Tehnica ta e chiar în sufletul tău.{\i0}
Dialogue: 0,0:18:48.50,0:18:52.88,Default,,0,0,0,,{\i1}Metoda ta de țesere{\i0}\N{\i1}arată dragostea ta pentru familie.{\i0}
Dialogue: 0,0:18:53.46,0:18:57.30,Default,,0,0,0,,{\i1}Poate că nu pot s-o rup,{\i0}\N{\i1}dar pot s-o desfac,{\i0}
Dialogue: 0,0:18:57.38,0:18:59.34,Default,,0,0,0,,{\i1}așa cum o pot face și cu sufletul tău.{\i0}
Dialogue: 0,0:18:59.43,0:19:04.68,Default,,0,0,0,,{\i1}Nu mai ai nevoie de amintirile{\i0}\N{\i1}pline de furie și ură față de mine.{\i0}
Dialogue: 0,0:19:04.76,0:19:08.27,Default,,0,0,0,,{\i1}Nu te mai gândi că trebuie să mă omori.{\i0}
Dialogue: 0,0:19:08.85,0:19:13.19,Default,,0,0,0,,{\i1}Pentru că, începând de acum,{\i0}\N{\i1}o să mă iubești.{\i0}
Dialogue: 0,0:19:43.89,0:19:46.10,Default,,0,0,0,,Ai început munca devreme!
Dialogue: 0,0:19:47.39,0:19:48.39,Default,,0,0,0,,Tată!
Dialogue: 0,0:19:49.35,0:19:52.10,Default,,0,0,0,,Ce-ar fi să te lupți puțin cu mine?
Dialogue: 0,0:19:59.28,0:20:03.74,Default,,0,0,0,,Reflexele tale sunt bune,\Ndar ești prea direct.
Dialogue: 0,0:20:03.82,0:20:07.79,Default,,0,0,0,,Trebuie să încerci să deviezi\Nmai multe atacuri cu un singur fir.
Dialogue: 0,0:20:07.87,0:20:10.66,Default,,0,0,0,,Să copleșești inamicul\Ncu manevre defensive.
Dialogue: 0,0:20:14.96,0:20:19.17,Default,,0,0,0,,Așa vei câștiga timp ca să ataci inamicul.
Dialogue: 0,0:20:25.05,0:20:28.51,Default,,0,0,0,,Bravo! Înveți foarte repede!
Dialogue: 0,0:20:28.60,0:20:29.68,Default,,0,0,0,,Acum…
Dialogue: 0,0:20:29.77,0:20:31.10,Default,,0,0,0,,Ce?
Dialogue: 0,0:20:31.73,0:20:33.35,Default,,0,0,0,,Uau!
Dialogue: 0,0:20:33.44,0:20:35.81,Default,,0,0,0,,Acestea sun\Nmănușile Păianjenului de Oțel!
Dialogue: 0,0:20:35.90,0:20:38.90,Default,,0,0,0,,Ți se potrivesc mai bine\Ndecât armele sau cuțitele, nu-i așa?
Dialogue: 0,0:20:38.98,0:20:41.03,Default,,0,0,0,,Și avem perechi asortate!
Dialogue: 0,0:20:41.11,0:20:42.11,Default,,0,0,0,,Ce?
Dialogue: 0,0:20:42.19,0:20:45.61,Default,,0,0,0,,{\i1}Ai exersat cu mâinile goale până acum,{\i0}
Dialogue: 0,0:20:45.70,0:20:48.12,Default,,0,0,0,,{\i1}și ai simțit fiecare mișcare{\i0}\N{\i1}al acestor fire.{\i0}
Dialogue: 0,0:20:48.20,0:20:51.75,Default,,0,0,0,,{\i1}De aceea, firele tale{\i0}\N{\i1}au devenit și mai tăioase.{\i0}
Dialogue: 0,0:20:51.83,0:20:55.92,Default,,0,0,0,,{\i1}Dar următorul pas este să înțelegi{\i0}\N{\i1}adevărata natură a acelei puteri.{\i0}
Dialogue: 0,0:20:56.92,0:20:59.92,Default,,0,0,0,,Cum vrei să folosești această putere?
Dialogue: 0,0:21:00.59,0:21:03.88,Default,,0,0,0,,O să folosesc puterea asta\Nca să-i protejez pe toți!
Dialogue: 0,0:21:04.59,0:21:06.22,Default,,0,0,0,,Chiar așa?
Dialogue: 0,0:21:06.30,0:21:09.39,Default,,0,0,0,,Firele tale îi sfâșie pe dușmani\Nși îi protejează pe aliați.
Dialogue: 0,0:21:09.89,0:21:14.69,Default,,0,0,0,,Acele mănuși pot fi arme,\Ndar și armura care îți protejează mâinile.
Dialogue: 0,0:21:14.77,0:21:16.98,Default,,0,0,0,,Le-am țesut cu toată grija,
Dialogue: 0,0:21:17.06,0:21:19.52,Default,,0,0,0,,ca să nu pățești nimic.
Dialogue: 0,0:21:19.61,0:21:21.65,Default,,0,0,0,,Ai grijă de ele!
Dialogue: 0,0:21:21.73,0:21:23.53,Default,,0,0,0,,Mulțumesc, tată!
Dialogue: 0,0:21:24.32,0:21:26.11,Default,,0,0,0,,O să le prețuiesc!
Dialogue: 0,0:21:34.91,0:21:38.38,Default,,0,0,0,,Nu e nevoie să încerci atât, tată!
Dialogue: 0,0:21:38.88,0:21:40.00,Default,,0,0,0,,La urma urmei, eu…
Dialogue: 0,0:21:40.67,0:21:42.25,Default,,0,0,0,,Te iubesc, tată!
Dialogue: 0,0:21:42.76,0:21:44.13,Default,,0,0,0,,Și atunci, și acum.
Dialogue: 0,0:21:47.18,0:21:51.18,Default,,0,0,0,,De asta n-am putut să te opresc,\Ndeși ar fi trebuit.
Dialogue: 0,0:21:51.68,0:21:52.68,Default,,0,0,0,,Pentru că…
Dialogue: 0,0:21:52.77,0:21:57.69,Default,,0,0,0,,Speram din tot sufletul\Ncă familia mea se va întoarce.
Dialogue: 0,0:21:58.73,0:22:00.82,Default,,0,0,0,,{\i1}Chiar dacă știam că nu se va întâmpla.{\i0}
Dialogue: 0,0:22:01.73,0:22:03.03,Default,,0,0,0,,Nu sunt prea diferit…
Dialogue: 0,0:22:03.11,0:22:04.24,Default,,0,0,0,,de tine, tată.
Dialogue: 0,0:22:07.40,0:22:10.87,Default,,0,0,0,,Hai să terminăm cu asta acum…\Npentru binele nostru.
Dialogue: 0,0:22:33.26,0:22:35.56,Default,,0,0,0,,La revedere, tată!
Dialogue: 0,0:24:16.91,0:24:18.91,Default,,0,0,0,,Subtitrarea: Sadacliev Lucian

