Dialogue: 0,0:00:10.88,0:00:12.84,Default,,0,0,0,,{\i1}-Taiyo.{\i0}\N{\i1}-Taiyo.{\i0}
Dialogue: 0,0:00:12.93,0:00:14.51,Default,,0,0,0,,{\i1}Abi.{\i0}
Dialogue: 0,0:00:16.76,0:00:19.60,Default,,0,0,0,,Abi? Abi!
Dialogue: 0,0:00:20.68,0:00:22.31,Default,,0,0,0,,İyi misin abi?
Dialogue: 0,0:00:22.39,0:00:23.81,Default,,0,0,0,,Kötü bir rüya görüyordun.
Dialogue: 0,0:00:23.89,0:00:24.90,Default,,0,0,0,,Öyle mi?
Dialogue: 0,0:00:24.98,0:00:27.27,Default,,0,0,0,,Evet, ben iyiyim.
Dialogue: 0,0:00:30.23,0:00:31.24,Default,,0,0,0,,Ne?
Dialogue: 0,0:00:34.28,0:00:35.41,Default,,0,0,0,,Ne oldu?
Dialogue: 0,0:00:36.82,0:00:37.82,Default,,0,0,0,,Hikaru?
Dialogue: 0,0:00:37.91,0:00:38.91,Default,,0,0,0,,Ne?
Dialogue: 0,0:00:39.49,0:00:41.33,Default,,0,0,0,,Annemle babam nerede?
Dialogue: 0,0:00:41.83,0:00:44.54,Default,,0,0,0,,O ikisi saatlerdir uyanıklar.
Dialogue: 0,0:00:46.83,0:00:48.09,Default,,0,0,0,,Onu uyandırdım!
Dialogue: 0,0:00:48.17,0:00:49.55,Default,,0,0,0,,Günaydın Taiyo.
Dialogue: 0,0:00:49.63,0:00:51.88,Default,,0,0,0,,Kahvaltı hazır.
Dialogue: 0,0:00:52.55,0:00:54.68,Default,,0,0,0,,Normalde bu kadar fazla uyumazsın.
Dialogue: 0,0:00:58.30,0:00:59.55,Default,,0,0,0,,Hadi abi.
Dialogue: 0,0:00:59.64,0:01:02.56,Default,,0,0,0,,Kahvaltıyı aradan çıkaralım da\Ntekrar oynayalım!
Dialogue: 0,0:01:02.64,0:01:04.14,Default,,0,0,0,,Doğru.
Dialogue: 0,0:01:19.91,0:01:24.83,Default,,0,0,0,,MISSION: YOZAKURA FAMILY
Dialogue: 0,0:02:42.03,0:02:43.70,Default,,0,0,0,,Ellerine sağlık!
Dialogue: 0,0:02:46.24,0:02:48.29,Default,,0,0,0,,Dur biraz. Tabağında yemek bırakmışsın.
Dialogue: 0,0:02:48.37,0:02:50.96,Default,,0,0,0,,İyi beslenmezsen büyüyemezsin.
Dialogue: 0,0:02:51.04,0:02:54.54,Default,,0,0,0,,Doğru! Bana bak. İkinci tabağı yiyorum!
Dialogue: 0,0:02:54.63,0:02:57.01,Default,,0,0,0,,Bu yüzden mi göbeğin bu kadar büyüdü?
Dialogue: 0,0:02:57.88,0:03:00.43,Default,,0,0,0,,-Sen de mi fark ettin Hikaru?\N-Ne?
Dialogue: 0,0:03:00.51,0:03:02.43,Default,,0,0,0,,Orta yaşlarında kilo mu alıyorsun?
Dialogue: 0,0:03:02.51,0:03:03.72,Default,,0,0,0,,Sen de mi tatlım?
Dialogue: 0,0:03:03.80,0:03:07.72,Default,,0,0,0,,İtiraf ediyorum, son zamanlarda…\NKonuyu değiştirme!
Dialogue: 0,0:03:08.52,0:03:13.40,Default,,0,0,0,,Hadi Hikaru, sana yardım edeyim,\Ntabağındakileri bitir.
Dialogue: 0,0:03:15.23,0:03:18.36,Default,,0,0,0,,-Vay canına!\N-Teşekkürler Taiyo!
Dialogue: 0,0:03:18.44,0:03:19.90,Default,,0,0,0,,Vay canına abi!
Dialogue: 0,0:03:19.99,0:03:21.49,Default,,0,0,0,,Üzerine çay döküldü mü?
Dialogue: 0,0:03:21.57,0:03:23.07,Default,,0,0,0,,Hayır, iyiyim.
Dialogue: 0,0:03:23.16,0:03:26.16,Default,,0,0,0,,{\i1}Ben nasıl… Şimdi…{\i0}
Dialogue: 0,0:03:26.24,0:03:29.70,Default,,0,0,0,,Bu hafta sonu\Nhep birlikte bir yere gidelim mi?
Dialogue: 0,0:03:29.79,0:03:32.58,Default,,0,0,0,,Çok iyi fikir!\Nİkiniz nereye gitmek istersiniz?
Dialogue: 0,0:03:32.67,0:03:34.88,Default,,0,0,0,,Ben! Ben! Kampa gitmek istiyorum!
Dialogue: 0,0:03:34.96,0:03:36.67,Default,,0,0,0,,Kampa mı?
Dialogue: 0,0:03:36.75,0:03:39.21,Default,,0,0,0,,Düşündüm de son zamanlarda hiç gitmedik.
Dialogue: 0,0:03:39.30,0:03:42.30,Default,,0,0,0,,Küçükken hayalim\Nyalnız başıma kamp yapmaktı.
Dialogue: 0,0:03:42.38,0:03:46.43,Default,,0,0,0,,Bu yüzden bir sürü dergi okudum\Nve gereken tüm malzemeleri aldım
Dialogue: 0,0:03:46.51,0:03:49.68,Default,,0,0,0,,ama hiç kullanmadım.
Dialogue: 0,0:03:49.77,0:03:51.89,Default,,0,0,0,,Sen de yapmak ister misin Taiyo?
Dialogue: 0,0:03:51.98,0:03:53.02,Default,,0,0,0,,Şey…
Dialogue: 0,0:03:53.10,0:03:54.65,Default,,0,0,0,,Bana her şey uyar.
Dialogue: 0,0:03:54.73,0:03:56.61,Default,,0,0,0,,İş açısından uygun mu anne?
Dialogue: 0,0:03:56.69,0:03:59.07,Default,,0,0,0,,Elbette! Biraz izin aldım.
Dialogue: 0,0:03:59.15,0:04:01.70,Default,,0,0,0,,-Vay canına! Harikasın!\N-Aferin kızım!
Dialogue: 0,0:04:01.78,0:04:03.03,Default,,0,0,0,,Eğlenceli olacak!
Dialogue: 0,0:04:08.08,0:04:10.91,Default,,0,0,0,,BAS!
Dialogue: 0,0:04:11.75,0:04:13.96,Default,,0,0,0,,OYUN BİTTİ
Dialogue: 0,0:04:14.04,0:04:16.50,Default,,0,0,0,,Hadi ama abi, o da neydi?
Dialogue: 0,0:04:16.59,0:04:18.38,Default,,0,0,0,,Senin yüzünden kaybettik!
Dialogue: 0,0:04:18.46,0:04:19.92,Default,,0,0,0,,Benim hatam.
Dialogue: 0,0:04:20.51,0:04:24.76,Default,,0,0,0,,Bugün kendinde değilsin abi.\NBaşından beri dalgınsın.
Dialogue: 0,0:04:24.84,0:04:27.47,Default,,0,0,0,,Üzgünüm, tamam mı? Hadi tekrar oynayalım!
Dialogue: 0,0:04:27.55,0:04:29.97,Default,,0,0,0,,Tanrım. Bu sefer oyuna odaklan!
Dialogue: 0,0:04:30.06,0:04:31.48,Default,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:04:32.02,0:04:33.02,Default,,0,0,0,,{\an8}Şimdi Yükleniyor
Dialogue: 0,0:04:33.10,0:04:35.40,Default,,0,0,0,,{\an8}Sorun şu ki fazla açıkta kalıyorsun.
Dialogue: 0,0:04:35.48,0:04:38.23,Default,,0,0,0,,Bütün alanı hesaba katmalısın.
Dialogue: 0,0:04:38.94,0:04:41.82,Default,,0,0,0,,Tamam, bu sefer kesin temizliyoruz!
Dialogue: 0,0:04:43.20,0:04:44.78,Default,,0,0,0,,{\i1}O neydi?{\i0}
Dialogue: 0,0:04:45.95,0:04:47.37,Default,,0,0,0,,{\i1}Sanki{\i0}
Dialogue: 0,0:04:47.45,0:04:50.37,Default,,0,0,0,,{\i1}önemli bir şeyi unutmuşum gibi geldi.{\i0}
Dialogue: 0,0:04:53.21,0:04:54.87,Default,,0,0,0,,{\i1}Her neyse.{\i0}
Dialogue: 0,0:05:13.98,0:05:16.35,Default,,0,0,0,,{\i1}Abi Shinzo! Kengo!{\i0}
Dialogue: 0,0:05:20.44,0:05:21.69,Default,,0,0,0,,{\i1}Gemiye mi?{\i0}
Dialogue: 0,0:05:55.64,0:05:56.94,Default,,0,0,0,,Mutsumi!
Dialogue: 0,0:06:08.95,0:06:11.28,Default,,0,0,0,,Abi Kyoichiro! Abla Futaba!
Dialogue: 0,0:06:11.37,0:06:13.74,Default,,0,0,0,,Abi Shinzo! Abla Shion!
Dialogue: 0,0:06:13.83,0:06:15.66,Default,,0,0,0,,Kengo! Nanao!
Dialogue: 0,0:06:20.58,0:06:21.79,Default,,0,0,0,,{\i1}Hepsi mi?{\i0}
Dialogue: 0,0:06:24.38,0:06:27.30,Default,,0,0,0,,{\i1}Babamın gücü bu mu?{\i0}
Dialogue: 0,0:06:37.89,0:06:39.94,Default,,0,0,0,,{\i1}Geminin taraması tamamlandı.{\i0}
Dialogue: 0,0:06:40.02,0:06:44.15,Default,,0,0,0,,{\i1}Gemide hata gibi yayılan{\i0}\N{\i1}yüksek seviyede someinine tespit ediyorum.{\i0}
Dialogue: 0,0:06:44.23,0:06:47.36,Default,,0,0,0,,{\i1}Aynı anda bir patlama olursa{\i0}\N{\i1}sadece gemiyi yok etmez.{\i0}
Dialogue: 0,0:06:47.44,0:06:50.11,Default,,0,0,0,,{\i1}Etrafındaki suları da yok eder.{\i0}
Dialogue: 0,0:06:50.20,0:06:52.32,Default,,0,0,0,,Yozakuralarla iletişime geçebildiniz mi?
Dialogue: 0,0:06:52.41,0:06:56.04,Default,,0,0,0,,{\i1}Modüller yanıp kül olmuş,{\i0}\N{\i1}yani iletişim kurmak imkânsız.{\i0}
Dialogue: 0,0:06:56.12,0:06:57.87,Default,,0,0,0,,Onları kurtarmalıyız!
Dialogue: 0,0:06:57.95,0:06:59.12,Default,,0,0,0,,Bekle Ryu.
Dialogue: 0,0:07:00.12,0:07:01.33,Default,,0,0,0,,Beni durdurma.
Dialogue: 0,0:07:02.21,0:07:06.30,Default,,0,0,0,,Neler olduğunu bilmeden\Ngözümüz kapalı içeri giremeyiz.
Dialogue: 0,0:07:06.80,0:07:09.42,Default,,0,0,0,,Bu konuda Başkan'ı destekliyorum.
Dialogue: 0,0:07:11.72,0:07:12.97,Default,,0,0,0,,Tamam o zaman.
Dialogue: 0,0:07:13.97,0:07:17.10,Default,,0,0,0,,Giga, Liman Kontrol Odası'nı ara.
Dialogue: 0,0:07:17.18,0:07:19.43,Default,,0,0,0,,Ablukayı genişletmelerini söyle.
Dialogue: 0,0:07:19.52,0:07:20.85,Default,,0,0,0,,{\i1}Anlaşıldı!{\i0}
Dialogue: 0,0:07:24.44,0:07:26.36,Default,,0,0,0,,Gerisini onlara bırakalım.
Dialogue: 0,0:07:27.36,0:07:30.03,Default,,0,0,0,,{\i1}Ne olursa olsun, şu anki durumda…{\i0}
Dialogue: 0,0:07:31.40,0:07:33.16,Default,,0,0,0,,{\i1}diğerlerini kurtarabilecek tek kişi…{\i0}
Dialogue: 0,0:07:34.78,0:07:36.08,Default,,0,0,0,,{\i1}benim!{\i0}
Dialogue: 0,0:07:50.05,0:07:54.76,Default,,0,0,0,,Senin için gönderdiğim\Nkarşılama ekibini biçmen çok acımasızca.
Dialogue: 0,0:07:54.84,0:07:57.22,Default,,0,0,0,,Kyoichiro'ya benzemeye başlıyorsun.
Dialogue: 0,0:07:57.31,0:07:59.93,Default,,0,0,0,,Birazdan burada olur.
Dialogue: 0,0:08:21.29,0:08:23.75,Default,,0,0,0,,Evine hoş geldin Taiyo.
Dialogue: 0,0:08:24.83,0:08:26.13,Default,,0,0,0,,Akşam yemeği vakti.
Dialogue: 0,0:08:26.63,0:08:27.96,Default,,0,0,0,,Hadi otur.
Dialogue: 0,0:08:40.01,0:08:41.89,Default,,0,0,0,,Onlara ne yaptın?
Dialogue: 0,0:08:52.36,0:08:55.41,Default,,0,0,0,,Çiçek Açma yeteneğim, Rüyalar.
Dialogue: 0,0:08:57.32,0:08:58.95,Default,,0,0,0,,{\i1}Sen de gördün, değil mi?{\i0}
Dialogue: 0,0:08:59.03,0:09:03.37,Default,,0,0,0,,{\i1}Acının ve kederin olmadığı ideal bir rüya.{\i0}
Dialogue: 0,0:09:04.75,0:09:09.38,Default,,0,0,0,,Kiraz çiçeği kokulu her şey benim hayalim.
Dialogue: 0,0:09:09.88,0:09:12.05,Default,,0,0,0,,Buna karşı koyabilecek hiç kimse yok.
Dialogue: 0,0:09:12.13,0:09:16.76,Default,,0,0,0,,Tek istisna sensin\Nçünkü Tsubomi'nin kanını taşıyorsun.
Dialogue: 0,0:09:20.68,0:09:23.93,Default,,0,0,0,,Hepsini eski hâllerine döndür!
Dialogue: 0,0:09:24.02,0:09:26.27,Default,,0,0,0,,Onları eski hâllerine döndürdüm.
Dialogue: 0,0:09:26.77,0:09:29.40,Default,,0,0,0,,Yani ailem olması gereken kişilere.
Dialogue: 0,0:09:30.36,0:09:31.86,Default,,0,0,0,,Buna aile mi diyorsun?
Dialogue: 0,0:09:32.57,0:09:34.11,Default,,0,0,0,,Aile…
Dialogue: 0,0:09:37.70,0:09:39.32,Default,,0,0,0,,ASANO AİLE MEZARI
Dialogue: 0,0:09:40.03,0:09:41.99,Default,,0,0,0,,Bir aile…
Dialogue: 0,0:09:43.66,0:09:47.42,Default,,0,0,0,,Yanılıyorsun. Aile böyledir işte Taiyo.
Dialogue: 0,0:09:49.54,0:09:51.46,Default,,0,0,0,,En çok senin bilmen lazım.
Dialogue: 0,0:09:51.96,0:09:54.09,Default,,0,0,0,,Aileler kırılgan ve geçicidir.
Dialogue: 0,0:09:54.71,0:09:57.97,Default,,0,0,0,,Bu yüzden sıfırdan\Nbir aile yaratmaya karar verdim.
Dialogue: 0,0:09:58.55,0:10:01.60,Default,,0,0,0,,Asla yok edilemeyecek, güçlü bir aile.
Dialogue: 0,0:10:26.79,0:10:28.21,Default,,0,0,0,,Demek çok geç kaldım.
Dialogue: 0,0:10:28.29,0:10:31.92,Default,,0,0,0,,Lanet olsun Kawashita.\NBunu yapacak cesarete sahip olmak…
Dialogue: 0,0:10:32.00,0:10:34.71,Default,,0,0,0,,Bu çocuk benim.
Dialogue: 0,0:10:39.84,0:10:41.43,Default,,0,0,0,,Seni geri götürüyorum.
Dialogue: 0,0:10:46.93,0:10:48.23,Default,,0,0,0,,{\i1}Bu rüya değil.{\i0}
Dialogue: 0,0:10:49.10,0:10:50.23,Default,,0,0,0,,{\i1}Bunu hatırlıyorum.{\i0}
Dialogue: 0,0:10:51.35,0:10:53.36,Default,,0,0,0,,{\i1}Bir şeyler gördüğümü sanıyordum.{\i0}
Dialogue: 0,0:10:54.02,0:10:56.65,Default,,0,0,0,,Sağlık görevlileri gerisini halledebilir.
Dialogue: 0,0:10:57.15,0:10:59.86,Default,,0,0,0,,{\i1}Ama o gün, eminim ki{\i0}
Dialogue: 0,0:11:00.78,0:11:01.82,Default,,0,0,0,,{\i1}biri…{\i0}
Dialogue: 0,0:11:05.66,0:11:09.16,Default,,0,0,0,,Bunca zamandır seni izliyordum.
Dialogue: 0,0:11:10.46,0:11:12.63,Default,,0,0,0,,{\i1}Ne kadar mücadele etsem de{\i0}
Dialogue: 0,0:11:12.71,0:11:15.67,Default,,0,0,0,,{\i1}Yozakura kader döngüsünü kıramadım.{\i0}
Dialogue: 0,0:11:16.63,0:11:19.84,Default,,0,0,0,,{\i1}Bu yüzden taze kana ihtiyacım vardı.{\i0}
Dialogue: 0,0:11:21.26,0:11:22.64,Default,,0,0,0,,{\i1}Zor bir karar olmadı.{\i0}
Dialogue: 0,0:11:22.72,0:11:28.31,Default,,0,0,0,,{\i1}Mutsumi için senin gibi sıradan,{\i0}\N{\i1}gösterişsiz bir çocuktan iyisi olamaz.{\i0}
Dialogue: 0,0:11:37.82,0:11:41.57,Default,,0,0,0,,{\i1}Seni ben seçtim.{\i0}
Dialogue: 0,0:11:49.41,0:11:51.04,Default,,0,0,0,,{\i1}Sizin iyiliğiniz için{\i0}
Dialogue: 0,0:11:51.62,0:11:54.83,Default,,0,0,0,,{\i1}kimi feda etmem gerektiği umurumda değil.{\i0}
Dialogue: 0,0:11:56.71,0:12:01.30,Default,,0,0,0,,Seni güçlü yapan benim.
Dialogue: 0,0:12:08.35,0:12:12.56,Default,,0,0,0,,Doğru, 10.000 Çiçeğin Coşkun Çiçek Açışı,\NÇiçek Açma yeteneğime direnebilir.
Dialogue: 0,0:12:13.10,0:12:17.44,Default,,0,0,0,,Ama şimdi anıların seni sarstığı için\Nkendini savunmasız bıraktın.
Dialogue: 0,0:12:18.07,0:12:20.90,Default,,0,0,0,,Artık hiç uyanamayacağın
Dialogue: 0,0:12:21.44,0:12:23.45,Default,,0,0,0,,bir rüyanın ortasındasın.
Dialogue: 0,0:12:24.07,0:12:27.08,Default,,0,0,0,,Hayal ettiğim ideal aile
Dialogue: 0,0:12:27.16,0:12:29.99,Default,,0,0,0,,nihayet burada ve şimdi tamamlanacak.
Dialogue: 0,0:12:36.96,0:12:40.71,Default,,0,0,0,,Taiyo, Yozakura ailesine hoş geldin.
Dialogue: 0,0:12:53.69,0:12:55.27,Default,,0,0,0,,Bu yanılsamanın canı cehenneme!
Dialogue: 0,0:13:05.74,0:13:07.66,Default,,0,0,0,,Sana tek bir kişinin bile eksik olmadığı
Dialogue: 0,0:13:08.32,0:13:12.54,Default,,0,0,0,,gerçek mutluluğu göstermeme izin ver.
Dialogue: 0,0:13:13.66,0:13:16.17,Default,,0,0,0,,Artık rahatlayabilirsin.
Dialogue: 0,0:13:16.67,0:13:19.09,Default,,0,0,0,,Bunun suçlusu sen değilsin.
Dialogue: 0,0:13:19.17,0:13:20.63,Default,,0,0,0,,Yanlış bir şey yapmadın.
Dialogue: 0,0:13:21.13,0:13:26.05,Default,,0,0,0,,Bunca zamandır aradığın\Nmutlu rüyaya teslim ol
Dialogue: 0,0:13:26.13,0:13:27.30,Default,,0,0,0,,Taiyo.
Dialogue: 0,0:13:27.97,0:13:31.06,Default,,0,0,0,,Çok büyüdün Taiyo.
Dialogue: 0,0:13:48.03,0:13:49.20,Default,,0,0,0,,{\i1}Anne.{\i0}
Dialogue: 0,0:13:54.58,0:13:57.58,Default,,0,0,0,,Seni yalnız bıraktığım için üzgünüm Taiyo.
Dialogue: 0,0:13:59.00,0:14:02.59,Default,,0,0,0,,{\an8}OLGUNLUK TÖRENİ
Dialogue: 0,0:14:14.56,0:14:15.56,Default,,0,0,0,,{\i1}Baba.{\i0}
Dialogue: 0,0:14:16.60,0:14:19.60,Default,,0,0,0,,Seni özledim abi!
Dialogue: 0,0:14:24.69,0:14:27.15,Default,,0,0,0,,BAS!
Dialogue: 0,0:14:27.95,0:14:30.07,Default,,0,0,0,,KAYBETTİN - KAZANDIN
Dialogue: 0,0:14:37.12,0:14:38.25,Default,,0,0,0,,{\i1}Hikaru.{\i0}
Dialogue: 0,0:14:40.08,0:14:43.25,Default,,0,0,0,,Kes şunu.\NO sahte görüntüleri ve sesleri kullanarak
Dialogue: 0,0:14:43.34,0:14:46.55,Default,,0,0,0,,bana ailemden bahsetme!
Dialogue: 0,0:14:47.05,0:14:48.59,Default,,0,0,0,,{\i1}Onları bir daha göremem.{\i0}
Dialogue: 0,0:14:48.67,0:14:50.30,Default,,0,0,0,,{\i1}Onlarla bir daha konuşamam.{\i0}
Dialogue: 0,0:14:50.38,0:14:51.93,Default,,0,0,0,,{\i1}Asla geri dönemem.{\i0}
Dialogue: 0,0:14:52.01,0:14:54.35,Default,,0,0,0,,Ne kadar pişman olsam da artık çok geç.
Dialogue: 0,0:14:54.43,0:14:56.85,Default,,0,0,0,,Ne kadar önemsesem de\Nhiçbir işe yaramayacak!
Dialogue: 0,0:14:56.93,0:15:01.10,Default,,0,0,0,,{\i1}Dua ettim, çığlık attım,{\i0}\N{\i1}öfkelendim, ağladım…{\i0}
Dialogue: 0,0:15:04.07,0:15:05.48,Default,,0,0,0,,Ama kabul ettim.
Dialogue: 0,0:15:06.15,0:15:09.70,Default,,0,0,0,,O zaman kaderin olan geleceği
Dialogue: 0,0:15:09.78,0:15:13.03,Default,,0,0,0,,bir kez daha kabul etmelisin.
Dialogue: 0,0:15:13.12,0:15:19.12,Default,,0,0,0,,Böylece kurgu gerçeğe dönüşecek\Nve yalanlar gerçek olacak.
Dialogue: 0,0:15:22.54,0:15:24.09,Default,,0,0,0,,Sonra da bakın…
Dialogue: 0,0:15:32.34,0:15:33.43,Default,,0,0,0,,Ben geldim!
Dialogue: 0,0:15:34.30,0:15:35.60,Default,,0,0,0,,Abi! Abi!
Dialogue: 0,0:15:37.06,0:15:38.72,Default,,0,0,0,,Acele et abi!
Dialogue: 0,0:15:38.81,0:15:41.81,Default,,0,0,0,,Abi Nanao'nun atlı karıncası harika!
Dialogue: 0,0:15:41.89,0:15:45.40,Default,,0,0,0,,Hadi ama Hikaru!\NÖnüne bakmamak tehlikelidir.
Dialogue: 0,0:15:45.48,0:15:47.61,Default,,0,0,0,,Hikaru enerji dolu!
Dialogue: 0,0:15:47.69,0:15:51.15,Default,,0,0,0,,Çocuklarımın ikisi de erkek,\No yüzden hiç dinlenemiyorum.
Dialogue: 0,0:15:51.24,0:15:53.45,Default,,0,0,0,,İşte bu yüzden Taiyo'nun eşi olarak
Dialogue: 0,0:15:53.53,0:15:56.99,Default,,0,0,0,,Mutsumi gibi bir kızım olduğu için\Nçok mutluyum!
Dialogue: 0,0:15:58.20,0:16:00.79,Default,,0,0,0,,Burası artık çok neşeli,\No yüzden ben de mutluyum!
Dialogue: 0,0:16:00.87,0:16:03.83,Default,,0,0,0,,Bay Momo, bu akşam\Nbir şeyler içmeye ne dersiniz?
Dialogue: 0,0:16:03.92,0:16:05.17,Default,,0,0,0,,Bana uyar!
Dialogue: 0,0:16:05.25,0:16:08.00,Default,,0,0,0,,Neden bir şişe daha\NYozakura Fırtınası açmıyorum?
Dialogue: 0,0:16:08.09,0:16:12.30,Default,,0,0,0,,Taiyo, Hikaru, hemen buraya gelin!
Dialogue: 0,0:16:21.48,0:16:22.48,Default,,0,0,0,,{\i1}Hayır.{\i0}
Dialogue: 0,0:16:23.10,0:16:24.81,Default,,0,0,0,,{\i1}Bu gerçek değil.{\i0}
Dialogue: 0,0:16:25.44,0:16:26.44,Default,,0,0,0,,{\i1}Ama yine de…{\i0}
Dialogue: 0,0:16:29.61,0:16:31.40,Default,,0,0,0,,Gidelim abi.
Dialogue: 0,0:16:41.79,0:16:42.79,Default,,0,0,0,,{\i1}Kahretsin!{\i0}
Dialogue: 0,0:16:58.26,0:17:00.81,Default,,0,0,0,,Abi…
Dialogue: 0,0:17:07.81,0:17:12.86,Default,,0,0,0,,Böyle şiddetli bir giriş yapmak\Ntam sana göre Kyoichiro.
Dialogue: 0,0:17:12.94,0:17:15.91,Default,,0,0,0,,Otur o zaman.
Dialogue: 0,0:17:38.39,0:17:39.89,Default,,0,0,0,,Abi Kyoichiro!
Dialogue: 0,0:17:44.10,0:17:45.64,Default,,0,0,0,,Arakne - Tanrıça'nın Ağı
Dialogue: 0,0:17:45.73,0:17:48.52,Default,,0,0,0,,her şeyi dışarıda tutan,\Naşılamaz bir duvar,
Dialogue: 0,0:17:48.60,0:17:50.57,Default,,0,0,0,,gizli bir Çelik Örümcek tekniği.
Dialogue: 0,0:17:51.15,0:17:52.44,Default,,0,0,0,,Anladım.
Dialogue: 0,0:17:52.53,0:17:55.32,Default,,0,0,0,,Bu yüzden kiraz çiçeği kokusu\Nona ulaşamadı
Dialogue: 0,0:17:55.40,0:17:58.70,Default,,0,0,0,,ve Çiçek Açma yeteneğim\Nonu hiç etkilemedi.
Dialogue: 0,0:17:59.95,0:18:03.24,Default,,0,0,0,,Sonunda mükemmelleştirmişsin Kyoichiro.
Dialogue: 0,0:18:03.74,0:18:07.00,Default,,0,0,0,,Onu birlikte tasarladığımız günleri\Nözlemle anıyorum.
Dialogue: 0,0:18:07.08,0:18:10.84,Default,,0,0,0,,Aile için yarattığımız bir yetenek.
Dialogue: 0,0:18:10.92,0:18:13.55,Default,,0,0,0,,Bu yüzden bu şekilde kullanılmamalıydı.
Dialogue: 0,0:18:17.01,0:18:18.80,Default,,0,0,0,,Ailemi her türlü kötülükten
Dialogue: 0,0:18:18.88,0:18:21.97,Default,,0,0,0,,ve yapmak üzere olduğum şeylerden…
Dialogue: 0,0:18:24.52,0:18:27.52,Default,,0,0,0,,koruyacağım.
Dialogue: 0,0:18:29.27,0:18:30.48,Default,,0,0,0,,Harika.
Dialogue: 0,0:18:31.19,0:18:33.48,Default,,0,0,0,,Bu harika, Kyoichiro!
Dialogue: 0,0:18:37.07,0:18:40.03,Default,,0,0,0,,{\i1}Arakne - Tanrıça'nın Ağı'nı{\i0}\N{\i1}yok edemeyeceğim doğru.{\i0}
Dialogue: 0,0:18:40.11,0:18:41.12,Default,,0,0,0,,{\i1}Ama…{\i0}
Dialogue: 0,0:18:41.70,0:18:45.04,Default,,0,0,0,,{\i1}Sana o iplikleri kullanmayı ben öğrettim.{\i0}
Dialogue: 0,0:18:45.66,0:18:48.41,Default,,0,0,0,,{\i1}İplik tekniğin benliğini yansıtır.{\i0}
Dialogue: 0,0:18:48.50,0:18:52.88,Default,,0,0,0,,{\i1}Dokuma yöntemin{\i0}\N{\i1}ailene olan sevgini gösteriyor.{\i0}
Dialogue: 0,0:18:53.46,0:18:57.30,Default,,0,0,0,,{\i1}Koparamayabilirim ama ruhuna yaptığın gibi{\i0}
Dialogue: 0,0:18:57.38,0:18:59.34,Default,,0,0,0,,{\i1}onu da çözebilirim.{\i0}
Dialogue: 0,0:18:59.43,0:19:04.68,Default,,0,0,0,,{\i1}Artık bana karşı olan öfkeni{\i0}\N{\i1}ve nefretini hatırlamana gerek yok.{\i0}
Dialogue: 0,0:19:04.76,0:19:08.27,Default,,0,0,0,,{\i1}Artık beni öldürmen gerektiğini{\i0}\N{\i1}düşünmeyeceksin.{\i0}
Dialogue: 0,0:19:08.85,0:19:13.19,Default,,0,0,0,,{\i1}Çünkü şu andan itibaren beni seveceksin.{\i0}
Dialogue: 0,0:19:43.89,0:19:46.10,Default,,0,0,0,,Erkenden çalışmaya başlamışsın!
Dialogue: 0,0:19:47.39,0:19:48.39,Default,,0,0,0,,Baba.
Dialogue: 0,0:19:49.35,0:19:52.10,Default,,0,0,0,,Biraz benimle dövüşmeye ne dersin?
Dialogue: 0,0:19:59.28,0:20:03.74,Default,,0,0,0,,Refleks hızın kötü değil ama çok düz.
Dialogue: 0,0:20:03.82,0:20:07.79,Default,,0,0,0,,Tek bir iplikle\Nbirden fazla saldırıyı savuşturmalısın.
Dialogue: 0,0:20:07.87,0:20:10.66,Default,,0,0,0,,Savunma hamleleriyle\Ndüşmanı çaresiz bırak.
Dialogue: 0,0:20:14.96,0:20:19.17,Default,,0,0,0,,Bunu yaparsan düşmana saldırmak için\Nzaman yaratabilirsin.
Dialogue: 0,0:20:25.05,0:20:28.51,Default,,0,0,0,,İşte benim oğlum! Çok hızlı öğreniyorsun.
Dialogue: 0,0:20:28.60,0:20:29.68,Default,,0,0,0,,Şimdi de…
Dialogue: 0,0:20:29.77,0:20:31.10,Default,,0,0,0,,Ne?
Dialogue: 0,0:20:31.73,0:20:33.35,Default,,0,0,0,,Vay canına!
Dialogue: 0,0:20:33.44,0:20:35.81,Default,,0,0,0,,Bunlar Çelik Örümcek eldivenleri.
Dialogue: 0,0:20:35.90,0:20:38.90,Default,,0,0,0,,Sana silahtan veya bıçaktan\Ndaha çok yakışıyorlar, değil mi?
Dialogue: 0,0:20:38.98,0:20:41.03,Default,,0,0,0,,Bu arada, eldivenlerimiz aynı!
Dialogue: 0,0:20:41.11,0:20:42.11,Default,,0,0,0,,Ne?
Dialogue: 0,0:20:42.19,0:20:45.61,Default,,0,0,0,,{\i1}Şimdiye kadar{\i0}\N{\i1}çıplak ellerinle pratik yaptın,{\i0}
Dialogue: 0,0:20:45.70,0:20:48.12,Default,,0,0,0,,{\i1}o yüzden o ipliklerin{\i0}\N{\i1}her hareketini hissettin.{\i0}
Dialogue: 0,0:20:48.20,0:20:51.75,Default,,0,0,0,,{\i1}Böylece ipliklerin daha da keskinleşti.{\i0}
Dialogue: 0,0:20:51.83,0:20:55.92,Default,,0,0,0,,{\i1}Bir sonraki adım,{\i0}\N{\i1}o gücün gerçek doğasını anlamak.{\i0}
Dialogue: 0,0:20:56.92,0:20:59.92,Default,,0,0,0,,Bu gücü nasıl kullanmak istersin?
Dialogue: 0,0:21:00.59,0:21:03.88,Default,,0,0,0,,Bu gücü herkesi korumak için kullanacağım.
Dialogue: 0,0:21:04.59,0:21:06.22,Default,,0,0,0,,Öyle mi?
Dialogue: 0,0:21:06.30,0:21:09.39,Default,,0,0,0,,Bu iplikler düşmanlarını keser,\Nmüttefiklerini sarıp sarmalar.
Dialogue: 0,0:21:09.89,0:21:14.69,Default,,0,0,0,,O eldivenler silah olabilir\Nama aynı zamanda ellerini korur.
Dialogue: 0,0:21:14.77,0:21:16.98,Default,,0,0,0,,Sana zarar gelmemesi için
Dialogue: 0,0:21:17.06,0:21:19.52,Default,,0,0,0,,onları sevgiyle dokudum.
Dialogue: 0,0:21:19.61,0:21:21.65,Default,,0,0,0,,Onlara iyi bak.
Dialogue: 0,0:21:21.73,0:21:23.53,Default,,0,0,0,,Teşekkürler baba.
Dialogue: 0,0:21:24.32,0:21:26.11,Default,,0,0,0,,Onlara çok iyi bakacağım.
Dialogue: 0,0:21:34.91,0:21:38.38,Default,,0,0,0,,Beynimi yıkayacak kadar\Nileri gitmene gerek yok baba.
Dialogue: 0,0:21:38.88,0:21:40.00,Default,,0,0,0,,Ne de olsa ben…
Dialogue: 0,0:21:40.67,0:21:42.25,Default,,0,0,0,,Seni seviyorum baba.
Dialogue: 0,0:21:42.76,0:21:44.13,Default,,0,0,0,,O zamanlar ve şimdi.
Dialogue: 0,0:21:47.18,0:21:51.18,Default,,0,0,0,,Bu yüzden seni durdurmalıydım\Nama yapamadım.
Dialogue: 0,0:21:51.68,0:21:52.68,Default,,0,0,0,,Çünkü…
Dialogue: 0,0:21:52.77,0:21:57.69,Default,,0,0,0,,Ailemin geri dönebileceğine dair\Nbüyük umutlarım vardı.
Dialogue: 0,0:21:58.73,0:22:00.82,Default,,0,0,0,,{\i1}Bunun olmayacağını bilsem de.{\i0}
Dialogue: 0,0:22:01.73,0:22:03.03,Default,,0,0,0,,Senden farklı değilim…
Dialogue: 0,0:22:03.11,0:22:04.24,Default,,0,0,0,,baba.
Dialogue: 0,0:22:07.40,0:22:10.87,Default,,0,0,0,,Bu işi bitirelim. Kendi iyiliğimiz için.
Dialogue: 0,0:22:33.26,0:22:35.56,Default,,0,0,0,,Hoşça kal baba.
Dialogue: 0,0:24:16.91,0:24:18.91,Default,,0,0,0,,Alt yazı çevirmeni: Dilek Çil

