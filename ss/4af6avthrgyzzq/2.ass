Dialogue: 99,0:00:02.53,0:00:03.72,italics,,0,0,0,OPENING,PANDOROBO
Dialogue: 99,0:00:04.13,0:00:05.00,italics,,0,0,0,OPENING,♪ "Let's Go!"
Dialogue: 99,0:00:05.00,0:00:06.73,italics,BAKER,0,0,0,OPENING,♪ "Roti kroket, roti krim"
Dialogue: 99,0:00:06.73,0:00:09.08,italics,BAKER,0,0,0,OPENING,♪ "Roti melon, roti kura-kura,\Nroti kari, roti koppe"
Dialogue: 99,0:00:09.08,0:00:12.42,italics,BAKER,0,0,0,OPENING,♪ "Roti beruang kutub, kroisan,\Ndonat, roti Prancis"
Dialogue: 99,0:00:12.42,0:00:14.57,italics,BAKER,0,0,0,OPENING,♪ "Choco-cornet, roti monyet,\Nroti jagung"
Dialogue: 99,0:00:14.57,0:00:16.26,italics,BAKER,0,0,0,OPENING,♪ "Roti panda, roti piza,\Nroti kacang merah"
Dialogue: 99,0:00:16.26,0:00:18.28,italics,BAKER,0,0,0,OPENING,♪ "Roti sosis, roti kelinci,\Nroti koala"
Dialogue: 99,0:00:18.28,0:00:19.51,italics,BAKER,0,0,0,OPENING,♪ "Roti tawar"
Dialogue: 99,0:00:19.51,0:00:19.98,italics,BAKER,0,0,0,OPENING,♪ "…Eh!?"
Dialogue: 99,0:00:20.25,0:00:22.75,italics,PANDOROBO,0,0,0,OPENING,♪ "Di saat tukang roti melihat ke sana"
Dialogue: 99,0:00:22.75,0:00:25.07,italics,PANDOROBO,0,0,0,OPENING,♪ "Aku menyelinap (menyelinap)"
Dialogue: 99,0:00:25.07,0:00:26.98,italics,PANDOROBO,0,0,0,OPENING,♪ "Kalau dia melihat ke sini"
Dialogue: 99,0:00:26.98,0:00:28.40,italics,PANDOROBO,0,0,0,OPENING,♪ "Diam! (Diam)"
Dialogue: 99,0:00:28.94,0:00:30.87,italics,PANDOROBO,0,0,0,OPENING,♪ "Di saat tukang roti melihat ke sana"
Dialogue: 99,0:00:30.87,0:00:32.87,italics,PANDOROBO,0,0,0,OPENING,♪ "Aku menyelinap (menyelinap)"
Dialogue: 99,0:00:32.87,0:00:35.01,italics,PANDOROBO,0,0,0,OPENING,♪ "Kalau dia melihat ke sini"
Dialogue: 99,0:00:35.01,0:00:37.02,italics,PANDOROBO,0,0,0,OPENING,♪ "Diam! (Diam)"
Dialogue: 99,0:00:37.43,0:00:40.75,italics,PANDOROBO,0,0,0,OPENING,♪ "Sekarang! Lari ke pintu keluar, wus!"
Dialogue: 99,0:00:40.75,0:00:42.67,italics,PANDOROBO,0,0,0,OPENING,♪ "Baiklah! Aku berhasil!"
Dialogue: 99,0:00:42.67,0:00:44.67,italics,PANDOROBO,0,0,0,OPENING,♪ "Selamat makan!"
Dialogue: 99,0:00:45.54,0:00:46.75,italics,PANDOROBO,0,0,0,OPENING,♪ "Jijiknya!"
Dialogue: 99,0:00:44.67,0:00:46.75,signtext,PANDOROBO,0,0,0,OPENING,{\fnGloria Hallelujah\b1\1c&H5A04FF&\pos(472,49.333)\3c&H5A04FF&\bord1\fad(500,0)}Jijik
Dialogue: 99,0:00:47.43,0:00:50.35,italics,PANDOROBO,0,0,0,OPENING,♪ "Pencuri Roti (Pen-pen-pen-pen)"
Dialogue: 99,0:00:50.35,0:00:53.32,italics,PANDOROBO,0,0,0,OPENING,♪ "Pencuri Roti (Pen-pen-pen-pen)"
Dialogue: 99,0:00:53.32,0:00:56.43,italics,PANDOROBO,0,0,0,OPENING,♪ "Pencuri Roti (Pen-pen-pen-pen)"
Dialogue: 99,0:00:56.43,0:00:59.46,italics,PANDOROBO,0,0,0,OPENING,♪ "Pencuri Roti, Pencuri Roti"
