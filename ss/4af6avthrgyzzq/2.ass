Dialogue: 99,0:01:01.05,0:01:05.46,signtext,,0,0,0,,{\fad(950,0)\1a&HFF&\3c&HFFFFFF&\bord1.3\blur3\fnAller Display\pos(320,260)\fs40}Pencuri Roti: Menjadi Tukang Roti
Dialogue: 99,0:01:01.05,0:01:05.46,signtext,,0,0,0,,{\fad(950,0)\c&H2151CE&\fnAller Display\pos(320,260)\fs40}Pencuri Roti: Menjadi Tukang Roti
Dialogue: 0,0:01:01.96,0:01:05.46,main,PANDOROBO,0,0,0,TITLE,Pencuri Roti:\NMenjadi Tukang Roti
Dialogue: 0,0:01:07.36,0:01:09.69,main,BAKER,0,0,0,,Selamat pagi.
Dialogue: 0,0:01:10.32,0:01:11.22,main,BAKER,0,0,0,,Eh?
Dialogue: 0,0:01:11.22,0:01:14.30,main,BAKER,0,0,0,,Ke mana dia pergi?
Dialogue: 0,0:01:22.46,0:01:25.50,main,BAKER,0,0,0,,Kamu suka sekali\Npakai baju itu, ya?
Dialogue: 0,0:01:25.50,0:01:28.67,main,PANDOROBO,0,0,0,,Habisnya baju ini\Npaling nyaman dipakai.
Dialogue: 0,0:01:29.21,0:01:30.80,main,PANDOROBO,0,0,0,,Selamat pagi!
Dialogue: 0,0:01:30.80,0:01:34.47,main,PANDOROBO,0,0,0,,Aku bikin roti semalaman\Nsampai ketiduran.
Dialogue: 0,0:01:34.47,0:01:37.26,main,BAKER,0,0,0,,Jadi itu sebabnya\Nkamu membuat begitu banyak roti?
Dialogue: 0,0:01:39.10,0:01:41.77,main,PANDOROBO,0,0,0,,Enaknya diapakan semua roti ini?
Dialogue: 0,0:01:41.77,0:01:45.50,main,BAKER,0,0,0,,Bagaimana kalau\Nkamu menjualnya di tokoku?
Dialogue: 0,0:01:46.18,0:01:49.44,main,BAKER,0,0,0,,Pasti akan banyak orang yang\Nbisa menikmatinya.
Dialogue: 0,0:01:49.44,0:01:52.05,main,PANDOROBO,0,0,0,,Eh? Iyakah?
Dialogue: 0,0:01:59.24,0:02:01.58,main,PANDOROBO,0,0,0,,Enak sekali!
Dialogue: 1,0:02:01.58,0:02:09.58,signtext,せかいいちおいしい,0,0,0,,{\an8\c&H233A46&\fnGloria Hallelujah\fs30\3c&H233A46&\4c&H233A46&\bord0.3\move(330,133,330,-30,0,2836)\frx0\fry358}Terenak di Dunia
Dialogue: 1,0:02:01.58,0:02:09.58,signtext,もりのパンや,0,0,0,,{\an8\c&H233A46&\fnGloria Hallelujah\fs50\3c&H233A46&\4c&H233A46&\bord1\move(330,153,330,-10,0,2836)\frx0\fry358}Toko Roti Hutan
Dialogue: 0,0:02:05.56,0:02:07.48,main,BAKER,0,0,0,,Baiklah, mari kita buka!
Dialogue: 0,0:02:12.07,0:02:12.59,signtext,せかいいちおいしい,0,0,0,,{\an8\c&H233A46&\fnGloria Hallelujah\fs7\3c&H233A46&\4c&H233A46&\bord0.1\pos(396.64,55.07)}Terenak di Dunia
Dialogue: 0,0:02:12.07,0:02:12.59,signtext,もりのパンや,0,0,0,,{\an8\c&H233A46&\fnGloria Hallelujah\fs14\3c&H233A46&\4c&H233A46&\bord0.3\pos(396.64,60.07)}Toko Roti Hutan
Dialogue: 0,0:02:12.59,0:02:16.57,main,PANDOROBO,0,0,0,,Lah loh?\NNggak ada yang datang?
Dialogue: 0,0:02:17.78,0:02:19.45,main,PANDOROBO,0,0,0,,Kenapa, ya?
Dialogue: 0,0:02:20.37,0:02:22.37,main,PANDOROBO,0,0,0,,Apa posisinya kurang pas?
Dialogue: 0,0:02:24.75,0:02:26.33,main,PANDOROBO,0,0,0,,Bagaimana kalau gini?
Dialogue: 0,0:02:34.01,0:02:36.26,main,PANDOROBO,0,0,0,,Masih belum ada yang datang…
Dialogue: 0,0:02:37.05,0:02:39.26,main,PANDOROBO,0,0,0,,Oh ya! Jangan-jangan…
Dialogue: 0,0:02:40.47,0:02:43.43,main,PANDOROBO,0,0,0,,Aku kurang sepenuh hati\Nsaat membuatnya!
Dialogue: 0,0:02:45.87,0:02:48.98,main,PANDOROBO,0,0,0,,Rotiku yang kusayang, sayang, {\i1}tersayang{\i0},
Dialogue: 0,0:02:48.98,0:02:50.53,main,PANDOROBO,0,0,0,,jadilah sangat lezat!
Dialogue: 0,0:02:50.98,0:02:52.94,main,BAKER,0,0,0,,Biar kubantu.
Dialogue: 0,0:02:53.36,0:02:55.70,main,PANDOROBO,0,0,0,,Tidak usah,\Naku bisa sendiri kok.
Dialogue: 0,0:02:57.26,0:03:03.26,main,せかいいちおいしい,0,0,0,,{\an8\c&H233A46&\fnGloria Hallelujah\fs24\3c&H233A46&\4c&H233A46&\bord0.1\pos(552.64,100.4)}Terenak di Dunia
Dialogue: 0,0:02:57.26,0:03:03.26,main,もりのパンや,0,0,0,,{\an8\c&H233A46&\fnGloria Hallelujah\fs30\3c&H233A46&\4c&H233A46&\bord0.4\pos(552.64,120.4)}Toko Roti Hutan
Dialogue: 0,0:03:00.99,0:03:03.26,main,PANDOROBO,0,0,0,,Tetap saja\Nbelum ada yang datang.
Dialogue: 0,0:03:03.83,0:03:06.00,main,BAKER,0,0,0,,Kesabaran adalah kuncinya di sini.
Dialogue: 0,0:03:06.54,0:03:09.25,main,BAKER,0,0,0,,Bagaimana kalau kamu\Nberistirahat sebentar?
Dialogue: 0,0:03:17.30,0:03:19.26,main,PANDOROBO,0,0,0,,Rotiku kan enak sekali,
Dialogue: 0,0:03:20.05,0:03:23.14,main,PANDOROBO,0,0,0,,{\an3}tapi bagaimana caranya biar\Norang-orang mau mencicipinya?
Dialogue: 0,0:03:24.31,0:03:27.10,topitalic,STARLING,0,0,0,,♪ "Aku burung jalak…"
Dialogue: 0,0:03:27.10,0:03:29.86,topitalic,STARLING,0,0,0,,♪ "yang riang dan suka bernyanyi"
Dialogue: 0,0:03:29.86,0:03:32.48,topitalic,STARLING,0,0,0,,♪ "Perutku keroncongan"
Dialogue: 0,0:03:32.48,0:03:34.90,topitalic,STARLING,0,0,0,,♪ "Waktunya mengisi paruhku\Ndengan sesuatu"
Dialogue: 0,0:03:38.78,0:03:40.49,main,STARLING,0,0,0,,Ada roti!
Dialogue: 0,0:03:41.74,0:03:43.76,main,STARLING,0,0,0,,Selamat makan!
Dialogue: 0,0:03:50.75,0:03:52.25,main,PANDOROBO,0,0,0,,Dia nyangkut…
Dialogue: 0,0:03:58.38,0:04:00.43,main,STARLING,0,0,0,,Woi! Kenapa rotinya bergerak?!
Dialogue: 0,0:04:00.89,0:04:02.01,main,PANDOROBO,0,0,0,,Aku bukan roti!
Dialogue: 0,0:04:02.01,0:04:03.68,main,PANDOROBO,0,0,0,,Aku Pencuri Roti!
Dialogue: 0,0:04:04.27,0:04:05.93,main,STARLING,0,0,0,,Oh, pencuri…
Dialogue: 0,0:04:05.93,0:04:07.85,main,STARLING,0,0,0,,Hah? Pencuri?!
Dialogue: 0,0:04:08.56,0:04:11.31,main,PANDOROBO,0,0,0,,{\an3}Bukan, aku sudah\Nberhenti mencuri.
Dialogue: 0,0:04:11.31,0:04:14.28,main,PANDOROBO,0,0,0,,{\an3}Sekarang aku bikin roti\Ndi Toko Roti Hutan.
Dialogue: 0,0:04:14.86,0:04:16.44,main,STARLING,0,0,0,,Toko Roti Hutan?
Dialogue: 0,0:04:22.07,0:04:24.49,main,STARLING,0,0,0,,Sepi amat tokonya!
Dialogue: 0,0:04:25.41,0:04:28.62,italics,STARLING,0,0,0,,♪ "Kosong dan suram,\Ntak ada satu pun orang!"
Dialogue: 0,0:04:28.62,0:04:32.96,italics,STARLING,0,0,0,,♪ "Rotinya pasti tidak enak,\Npasti begitu!"
Dialogue: 0,0:04:34.67,0:04:36.09,main,PANDOROBO,0,0,0,,Kamu duluan ya!
Dialogue: 0,0:04:37.67,0:04:39.34,main,PANDOROBO,0,0,0,,Nih, coba dicicip dulu!
Dialogue: 0,0:04:49.44,0:04:51.98,main,STARLING,0,0,0,,Enak banget!
Dialogue: 0,0:04:51.98,0:04:55.40,main,STARLING,0,0,0,,Pan-pan, papa-pan,\Npan, pa-paaan!
Dialogue: 0,0:04:55.40,0:04:58.90,main,STARLING,0,0,0,,Saking enaknya\Nsampai bikin aku ingin bernyanyi!
Dialogue: 0,0:04:58.90,0:05:02.03,topitalic,STARLING,0,0,0,,♪ "Papa-pan, pan, papa-paaan"
Dialogue: 0,0:05:02.03,0:05:04.91,topitalic,STARLING,0,0,0,,♪ "Aku makan roti enak"
Dialogue: 0,0:05:04.91,0:05:07.58,topitalic,STARLING,0,0,0,,{\an9}♪ "Aku makan roti enak"
Dialogue: 0,0:05:07.58,0:05:10.87,topitalic,STARLING,0,0,0,,{\an9}♪ "buatan Pencuri Roti"
Dialogue: 0,0:05:10.87,0:05:13.79,topitalic,STARLING,0,0,0,,{\an9}♪ "Papa-pan, pan, papa-paaan"
Dialogue: 0,0:05:13.79,0:05:16.92,topitalic,STARLING,0,0,0,,♪ "Aku makan roti enak"
Dialogue: 0,0:05:16.92,0:05:19.63,topitalic,STARLING,0,0,0,,♪ "Aku makan roti enak"
Dialogue: 0,0:05:19.63,0:05:23.26,topitalic,STARLING,0,0,0,,♪ "dari Toko Roti Hutan"
Dialogue: 0,0:05:23.26,0:05:25.76,topitalic,STARLING,0,0,0,,♪ "Pan, pan, papa-pan, pan"
Dialogue: 0,0:05:25.76,0:05:29.48,topitalic,STARLING,0,0,0,,♪ "Papa-pan, pan, pan, paaan"
Dialogue: 0,0:05:07.58,0:05:10.04,main,GIRAFFE,0,0,0,,Roti buatan… Pencuri Roti?
Dialogue: 0,0:05:13.00,0:05:14.54,main,KOGUMA'S DAD,0,0,0,,Dia bernanyi lagi.
Dialogue: 0,0:05:14.54,0:05:16.92,main,KOGUMA'S MOM,0,0,0,,Pencuri Roti…\NApa itu yang waktu itu?
Dialogue: 0,0:05:16.92,0:05:18.69,main,KOGUMA,0,0,0,,Itu pasti\Nroti yang lari waktu itu!
Dialogue: 0,0:05:20.76,0:05:22.39,main,KOUSAGI'S MOM,0,0,0,,Pencuri Roti?
Dialogue: 0,0:05:22.39,0:05:25.14,main,KOUSAGI,0,0,0,,Dia bikin roti\Ndi Toko Roti Hutan?
Dialogue: 0,0:05:34.31,0:05:37.82,signtext,,0,0,0,,{\c&H141F20&\fnWinkle\an9\fs25\bord3\3c&HFFFFFF&}Jadwal Roti Hangat\N- Pukul 8.00\N- Pukul 11.00\N- Pukul 15.00
Dialogue: 0,0:05:35.27,0:05:37.82,main,PANDOROBO,0,0,0,,Rotiku yang baru matang…
Dialogue: 0,0:05:40.90,0:05:44.62,main,PANDOROBO,0,0,0,,Semuanya mulai dingin…
Dialogue: 0,0:05:50.12,0:05:51.46,main,PANDOROBO,0,0,0,,Aku sudah tidak tahan lagi!
Dialogue: 0,0:05:51.46,0:05:53.25,main,PANDOROBO,0,0,0,,Akan kubawakan rotinya…
Dialogue: 0,0:05:54.33,0:05:55.46,main,PANDOROBO,0,0,0,,Akan kubawakan rotinya…
Dialogue: 0,0:05:55.88,0:05:59.23,main,PANDOROBO,0,0,0,,langsung ke semua orang di kota!
Dialogue: 0,0:06:03.13,0:06:05.49,main,PANDOROBO,0,0,0,,Buseeeeeeeeeet!
Dialogue: 0,0:06:06.22,0:06:09.06,main,PANDOROBO,0,0,0,,{\fad(0,300)}Apa-apaan ini?!
Dialogue: 0,0:06:09.52,0:06:11.23,main,KOGUMA,0,0,0,,Wah!
Dialogue: 0,0:06:11.68,0:06:13.31,main,KOGUMA,0,0,0,,Rotinya ada banyak sekali!
Dialogue: 0,0:06:13.31,0:06:15.35,main,KOGUMA'S MOM,0,0,0,,Roti karinya menggiurkan sekali!
Dialogue: 0,0:06:15.35,0:06:17.23,main,KOGUMA'S DAD,0,0,0,,Ada roti krim juga.
Dialogue: 0,0:06:18.32,0:06:21.61,main,KABA (HIPPO),0,0,0,,Aku belum pernah makan roti\Nseenak ini!
Dialogue: 0,0:06:21.61,0:06:23.82,main,SHIRONEKO,0,0,0,,Kamu borong banyak sekali lagi.
Dialogue: 0,0:06:23.82,0:06:25.74,main,GIRAFFE,0,0,0,,Soalnya rasanya enak sekali.
Dialogue: 0,0:06:25.78,0:06:27.99,main,KOGUMA,0,0,0,,Harum sekali!
Dialogue: 0,0:06:38.46,0:06:41.59,main,PANDOROBO,0,0,0,,Melihat semua orang\Nmenyukai rotiku
Dialogue: 0,0:06:41.59,0:06:43.42,main,PANDOROBO,0,0,0,,membuatku senang sekali.
