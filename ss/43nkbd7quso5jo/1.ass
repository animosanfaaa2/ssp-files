Dialogue: 0,0:21:58.40,0:22:02.11,On Top,,0,0,0,,{\i1}itsudatte hidoi omoide de{\i0}
Dialogue: 0,0:22:03.78,0:22:08.24,On Top,,0,0,0,,{\i1}kantan na taikutsu wo hiroiatsumete wa{\i0}
Dialogue: 0,0:22:08.24,0:22:11.83,On Top,,0,0,0,,{\i1}dareka mitai ni nacchimaisou{\i0}
Dialogue: 0,0:22:13.37,0:22:16.50,On Top,,0,0,0,,{\i1}ore ni niau mirai wa doredarou{\i0}
Dialogue: 0,0:22:16.50,0:22:20.42,On Top,,0,0,0,,{\i1}koko kara jaa ikura me wo korashitemo{\i0}
Dialogue: 0,0:22:20.42,0:22:22.88,On Top,,0,0,0,,{\i1}nanimo mie wa shinai sa{\i0}
