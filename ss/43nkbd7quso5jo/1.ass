Dialogue: 0,0:21:34.13,0:21:37.84,On Top,,0,0,0,,{\i1}kenmei ni me wo korashite{\i0}
Dialogue: 0,0:21:39.55,0:21:43.34,On Top,,0,0,0,,{\i1}genzaichi wo tashikameteiru{\i0}
Dialogue: 0,0:21:44.76,0:21:49.35,On Top,,0,0,0,,{\i1}mousou to zetsubou ni nareta noumiso dewa{\i0}
