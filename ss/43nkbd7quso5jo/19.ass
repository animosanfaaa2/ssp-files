Dialogue: 0,0:01:41.60,0:01:43.27,Default,,0,0,0,,Nami... Nami!
Dialogue: 0,0:01:43.27,0:01:44.81,Default,,0,0,0,,Này! Dậy đi!
Dialogue: 0,0:01:53.91,0:01:55.45,Default,,0,0,0,,Ui da...
Dialogue: 0,0:01:55.45,0:01:57.58,Default,,0,0,0,,Mình đã uống hơi...
Dialogue: 0,0:01:57.91,0:01:58.54,Default,,0,0,0,,...thì phải?
Dialogue: 0,0:02:04.29,0:02:05.25,Default,,0,0,0,,Ủa?
Dialogue: 0,0:02:08.75,0:02:10.09,Default,,0,0,0,,Đây là đâu?
Dialogue: 0,0:02:17.18,0:02:18.72,Default,,0,0,0,,Chẳng thấy ai cả.
Dialogue: 0,0:02:23.98,0:02:25.65,Default,,0,0,0,,Thế là thế nào?
Dialogue: 0,0:02:32.11,0:02:34.11,Default,,0,0,0,,Mình nghe nhầm à?
Dialogue: 0,0:02:34.11,0:02:35.61,Default,,0,0,0,,Mà vốn dĩ, tại sao...
Dialogue: 0,0:02:35.61,0:02:37.24,Default,,0,0,0,,Ui da!
Dialogue: 0,0:02:37.24,0:02:39.74,Default,,0,0,0,,mình lại ở đây cơ chứ?
Dialogue: 0,0:02:39.74,0:02:43.46,Default,,0,0,0,,Mình nhớ là đã lên tàu\Ncủa Người khổng lồ ở Egghead,
Dialogue: 0,0:02:43.46,0:02:45.75,Default,,0,0,0,,mọi người đang mở tiệc...
Dialogue: 0,0:02:51.34,0:02:53.84,Default,,0,0,0,,Trời ạ, gì thế này?
Dialogue: 0,0:02:54.38,0:02:58.26,Default,,0,0,0,,Cơ mà phải mau tìm nhóm Luffy\Nvà mọi người.
Dialogue: 0,0:03:02.93,0:03:05.14,Default,,0,0,0,,Không!
Dialogue: 0,0:03:08.77,0:03:14.53,Default,,0,0,0,,Nami gặp rắc rối!\NChuyến phiêu lưu ở Vương quốc khối xếp hình.
Dialogue: 0,0:03:20.99,0:03:21.79,Default,,0,0,0,,Kinh khủng thật.
Dialogue: 0,0:03:22.24,0:03:23.25,Default,,0,0,0,,Có cháy!
Dialogue: 0,0:03:23.33,0:03:24.62,Default,,0,0,0,,Ở phía khu rừng sao?
Dialogue: 0,0:03:25.00,0:03:26.54,Default,,0,0,0,,Mùi khó chịu quá!
Dialogue: 0,0:03:26.62,0:03:29.04,Default,,0,0,0,,Dùng nước từ suối để dập lửa đi!
Dialogue: 0,0:03:29.33,0:03:33.71,Default,,0,0,0,,Cây thế giới Yggdrasil mà bắt lửa\Nthì đất nước này tiêu luôn đấy!
Dialogue: 0,0:03:35.51,0:03:36.88,Default,,0,0,0,,Cái gì thế kia?
Dialogue: 0,0:03:44.89,0:03:46.56,Default,,0,0,0,,Lũ Stingmore...
Dialogue: 0,0:03:47.23,0:03:49.27,Default,,0,0,0,,Chuyện quái gì đang xảy ra vậy?
Dialogue: 0,0:03:50.31,0:03:54.32,Default,,0,0,0,,Theo lời người dân trong rừng,\Ntrận rung chấn lúc này...
Dialogue: 0,0:03:54.32,0:03:56.49,Default,,0,0,0,,là âm thanh Thần Tai ngã xuống.
Dialogue: 0,0:03:56.57,0:03:58.36,Default,,0,0,0,,Không thể nào!
Dialogue: 0,0:03:58.36,0:04:00.62,Default,,0,0,0,,Là con thỏ khổng lồ hung dữ đó sao?!
Dialogue: 0,0:04:00.99,0:04:04.49,Default,,0,0,0,,Có lẽ nên báo cáo chuyện này với Thần Mặt Trời.
Dialogue: 0,0:04:05.66,0:04:07.54,Default,,0,0,0,,LÂU ĐÀI BIGSTEIN
Dialogue: 0,0:04:07.54,0:04:09.71,Default,,0,0,0,,Vẫn còn sống kìa!
Dialogue: 0,0:04:12.50,0:04:16.13,Default,,0,0,0,,Đừng hòng chạm một ngón tay vào Nami!
Dialogue: 0,0:04:28.81,0:04:31.44,Default,,0,0,0,,Con ong khổng lồ đó là sao?
Dialogue: 0,0:04:31.86,0:04:34.36,Default,,0,0,0,,Chào buổi sáng, Nami.
Dialogue: 0,0:04:34.36,0:04:36.07,Default,,0,0,0,,Đây là đâu vậy?
Dialogue: 0,0:04:36.15,0:04:37.69,Default,,0,0,0,,Tôi không biết.
Dialogue: 0,0:04:37.69,0:04:40.86,Default,,0,0,0,,Đáng lẽ đang ở trên\Ntàu của Người khổng lồ chứ.
Dialogue: 0,0:04:42.12,0:04:44.83,Default,,0,0,0,,Đây là đâu? Đang mơ sao?
Dialogue: 0,0:04:45.16,0:04:46.62,Default,,0,0,0,,Một lâu đài nào đó ư?
Dialogue: 0,0:04:47.70,0:04:51.25,Default,,0,0,0,,Mình bị làm sao chăng?\NCòn chẳng nhớ là đã thay đồ nữa.
Dialogue: 0,0:04:54.29,0:04:57.59,Default,,0,0,0,,Thôi, tôi đi ngủ tiếp đây.
Dialogue: 0,0:04:58.30,0:04:59.05,Default,,0,0,0,,Hả?
Dialogue: 0,0:05:01.13,0:05:03.64,Default,,0,0,0,,Này! Đừng bỏ tôi lại một mình!
Dialogue: 0,0:05:03.64,0:05:05.01,Default,,0,0,0,,Zeus!
Dialogue: 0,0:05:05.01,0:05:07.02,Default,,0,0,0,,Này, Zeus!
Dialogue: 0,0:05:08.89,0:05:12.73,Default,,0,0,0,,Ai đó, cứu với!
Dialogue: 0,0:05:13.44,0:05:15.02,Default,,0,0,0,,Luffy!
Dialogue: 0,0:05:15.02,0:05:16.32,Default,,0,0,0,,Zoro!
Dialogue: 0,0:05:16.32,0:05:18.32,Default,,0,0,0,,Sanji!
Dialogue: 0,0:05:18.90,0:05:20.82,Default,,0,0,0,,Lúc này thì Usopp cũng được.
Dialogue: 0,0:05:20.90,0:05:24.32,Default,,0,0,0,,Này! Nami!
Dialogue: 0,0:05:24.41,0:05:26.54,Default,,0,0,0,,Hả? Usopp?!
Dialogue: 0,0:05:30.04,0:05:32.46,Default,,0,0,0,,Ui da...
Dialogue: 0,0:05:32.46,0:05:36.63,Default,,0,0,0,,Trời ạ! Sàn nhà này bị sao vậy?
Dialogue: 0,0:05:36.63,0:05:38.34,Default,,0,0,0,,Mấp mô quá.
Dialogue: 0,0:05:56.61,0:05:59.15,Default,,0,0,0,,To quá!
Dialogue: 0,0:06:02.70,0:06:05.28,Default,,0,0,0,,Đợi đã, không phải ta muốn\Ndọa mi đâu.
Dialogue: 0,0:06:09.33,0:06:11.20,Default,,0,0,0,,Đừng giận mà.
Dialogue: 0,0:06:15.63,0:06:17.54,Default,,0,0,0,,Đã bảo là không cố ý mà!
Dialogue: 0,0:06:17.54,0:06:19.30,Default,,0,0,0,,Xin lỗi!
Dialogue: 0,0:06:23.34,0:06:25.68,Default,,0,0,0,,Chạy chậm dữ.\NDo chân nó ngắn sao?
Dialogue: 0,0:06:30.43,0:06:32.93,Default,,0,0,0,,Trời ạ! Usopp!
Dialogue: 0,0:06:32.93,0:06:34.81,Default,,0,0,0,,Cậu ở đâu!?
Dialogue: 0,0:06:34.89,0:06:36.52,Default,,0,0,0,,Ở đây!
Dialogue: 0,0:06:37.44,0:06:38.48,Default,,0,0,0,,Usopp!
Dialogue: 0,0:06:46.41,0:06:48.45,Default,,0,0,0,,Cứu với!
Dialogue: 0,0:06:48.53,0:06:50.45,Default,,0,0,0,,Cậu cần cứu à!?
Dialogue: 0,0:06:50.45,0:06:52.45,Default,,0,0,0,,Mà con quái vật nào thế kia!
Dialogue: 0,0:06:54.62,0:06:56.42,Default,,0,0,0,,Usopp lâm nguy!
Dialogue: 0,0:06:56.88,0:06:58.38,Default,,0,0,0,,Lâm nguy là tớ đây này!
Dialogue: 0,0:06:58.79,0:07:00.59,Default,,0,0,0,,Đây là nơi nào vậy?
Dialogue: 0,0:07:00.59,0:07:02.46,Default,,0,0,0,,Lâu đài quái vật sao?
Dialogue: 0,0:07:04.30,0:07:06.68,Default,,0,0,0,,Thôi nào! Xuất hiện đi, Zeus!
Dialogue: 0,0:07:06.68,0:07:08.80,Default,,0,0,0,,Dậy mau! Này!
Dialogue: 0,0:07:09.89,0:07:11.39,Default,,0,0,0,,Dậy ngay đi!
Dialogue: 0,0:07:14.48,0:07:17.67,Default,,0,0,0,,Nami, đến giờ ăn rồi à?
Dialogue: 0,0:07:19.19,0:07:21.44,Default,,0,0,0,,Tôi sẽ cho cậu thật nhiều mây mới làm!
Dialogue: 0,0:07:21.52,0:07:22.78,Default,,0,0,0,,Thật sao?
Dialogue: 0,0:07:26.28,0:07:27.45,Default,,0,0,0,,Dài ra đi, Zeus!
Dialogue: 0,0:07:27.53,0:07:29.03,Default,,0,0,0,,Cứ để tôi!
Dialogue: 0,0:07:37.29,0:07:39.04,Default,,0,0,0,,Zeus! Cố lên!
Dialogue: 0,0:07:52.01,0:07:53.77,Default,,0,0,0,,Ngã mất...
Dialogue: 0,0:07:56.06,0:07:59.23,Default,,0,0,0,,Sấm sét ngập mồm nè!
Dialogue: 0,0:08:13.79,0:08:15.12,Default,,0,0,0,,Hả?
Dialogue: 0,0:08:24.46,0:08:25.09,Default,,0,0,0,,Ui da da...
Dialogue: 0,0:08:50.57,0:08:52.49,Default,,0,0,0,,Tớ có linh cảm xấu.
Dialogue: 0,0:08:52.57,0:08:53.78,Default,,0,0,0,,Tớ cũng vậy.
Dialogue: 0,0:08:57.66,0:08:58.96,Default,,0,0,0,,Thế này...
Dialogue: 0,0:08:59.37,0:09:01.29,Default,,0,0,0,,có vẻ...
Dialogue: 0,0:09:13.85,0:09:15.35,Default,,0,0,0,,Cứu với!
Dialogue: 0,0:09:20.31,0:09:23.06,Default,,0,0,0,,Chết tiệt! Khó chạy quá!\NCái sàn nhà mấp mô này!
Dialogue: 0,0:09:23.15,0:09:25.82,Default,,0,0,0,,Này, Usopp!\NBiết chuyện gì đang xảy ra không?!
Dialogue: 0,0:09:26.27,0:09:29.44,Default,,0,0,0,,Chịu! Mở mắt ra thì đã ở đây rồi!
Dialogue: 0,0:09:30.53,0:09:35.24,Default,,0,0,0,,Trời ạ, thế là thế nào?\NĐây là đâu?
Dialogue: 0,0:09:40.16,0:09:41.54,Default,,0,0,0,,Hả!?
Dialogue: 0,0:09:41.54,0:09:42.92,Default,,0,0,0,,Râu?
Dialogue: 0,0:09:43.50,0:09:44.83,Default,,0,0,0,,Bộ đồ này...
Dialogue: 0,0:09:45.38,0:09:46.42,Default,,0,0,0,,Lẽ nào...
Dialogue: 0,0:09:51.30,0:09:52.22,Default,,0,0,0,,Nami!
Dialogue: 0,0:09:52.22,0:09:54.30,Default,,0,0,0,,Này! Dậy đi!
Dialogue: 0,0:09:58.35,0:10:00.77,Default,,0,0,0,,Ui da...
Dialogue: 0,0:10:00.77,0:10:01.56,Default,,0,0,0,,Gì vậy?
Dialogue: 0,0:10:09.44,0:10:10.53,Default,,0,0,0,,Đại khái vậy.
Dialogue: 0,0:10:10.61,0:10:13.24,Default,,0,0,0,,Thì ra tiếng hét đó là của cậu.
Dialogue: 0,0:10:13.53,0:10:15.16,Default,,0,0,0,,Sao lại thành ra thế này chứ?
Dialogue: 0,0:10:15.57,0:10:16.99,Default,,0,0,0,,Chịu.
Dialogue: 0,0:10:16.99,0:10:19.54,Default,,0,0,0,,Chúng ta đã lên tàu của Người khổng lồ,
Dialogue: 0,0:10:19.95,0:10:21.45,Default,,0,0,0,,rồi bị say rượu...
Dialogue: 0,0:10:23.58,0:10:25.54,Default,,0,0,0,,Nhắc mới nhớ,
Dialogue: 0,0:10:26.04,0:10:27.79,Default,,0,0,0,,thứ rượu này khá mạnh đấy.
Dialogue: 0,0:10:28.42,0:10:31.30,Default,,0,0,0,,Đúng thế! Đây là absinthe!
Dialogue: 0,0:10:31.30,0:10:33.93,Default,,0,0,0,,Còn được gọi là nàng tiên xanh.
Dialogue: 0,0:10:34.01,0:10:37.76,Default,,0,0,0,,Đúng rồi! Ông ấy nói\Nnó có thể gây ảo giác!
Dialogue: 0,0:10:39.64,0:10:40.68,Default,,0,0,0,,Ngõ cụt!?
Dialogue: 0,0:10:46.69,0:10:48.57,Default,,0,0,0,,Cao quá!
Dialogue: 0,0:10:56.28,0:10:58.20,Default,,0,0,0,,Làm sao đây, Usopp?!
Dialogue: 0,0:10:58.28,0:11:01.29,Default,,0,0,0,,Cậu nói đây là "ảo giác", đúng không, Nami?
Dialogue: 0,0:11:01.83,0:11:02.50,Default,,0,0,0,,Hả?
Dialogue: 0,0:11:02.58,0:11:05.29,Default,,0,0,0,,Vậy thì con mèo đó...
Dialogue: 0,0:11:05.29,0:11:07.79,Default,,0,0,0,,dù nhìn thấy, nhưng thật ra nó là...
Dialogue: 0,0:11:10.46,0:11:12.13,Default,,0,0,0,,một ảo giác!
Dialogue: 0,0:11:15.22,0:11:16.72,Default,,0,0,0,,Nhào vô!
Dialogue: 0,0:11:27.23,0:11:29.73,Default,,0,0,0,,Usopp!
Dialogue: 0,0:11:43.12,0:11:44.20,Default,,0,0,0,,Usopp...
Dialogue: 0,0:11:48.54,0:11:52.55,Default,,0,0,0,,Không!
Dialogue: 0,0:12:20.24,0:12:21.82,Default,,0,0,0,,Ui da...
Dialogue: 0,0:12:21.82,0:12:23.70,Default,,0,0,0,,Thoát rồi sao?
Dialogue: 0,0:12:28.37,0:12:31.50,Default,,0,0,0,,Usopp biến thành Brook rồi!
Dialogue: 0,0:12:39.22,0:12:40.39,Default,,0,0,0,,Usopp!
Dialogue: 0,0:12:43.81,0:12:45.85,Default,,0,0,0,,Này, tỉnh lại đi!
Dialogue: 0,0:12:45.85,0:12:49.31,Default,,0,0,0,,Đừng bỏ tớ lại một mình!
Dialogue: 0,0:12:51.35,0:12:52.52,Default,,0,0,0,,Usopp!
Dialogue: 0,0:13:24.97,0:13:26.76,Default,,0,0,0,,Sao lại là sư tử?
Dialogue: 0,0:13:26.76,0:13:28.31,Default,,0,0,0,,Usopp, cố lên!
Dialogue: 0,0:13:28.31,0:13:30.77,Default,,0,0,0,,Tỉnh dậy đi! Tụi mình bị giết mất!
Dialogue: 0,0:13:30.77,0:13:33.56,Default,,0,0,0,,Usopp! Usopp!
Dialogue: 0,0:13:50.12,0:13:52.04,Default,,0,0,0,,Này! Đừng lấy tớ ra đỡ chứ!
Dialogue: 0,0:13:53.00,0:13:54.25,Default,,0,0,0,,Không, đi đi! Không, đi đi!
Dialogue: 0,0:13:54.33,0:13:56.21,Default,,0,0,0,,Thế là hết...
Dialogue: 0,0:14:04.22,0:14:05.80,Default,,0,0,0,,Gear 3rd!
Dialogue: 0,0:14:14.56,0:14:17.15,Default,,0,0,0,,Nami!
Dialogue: 0,0:14:19.44,0:14:22.28,Default,,0,0,0,,Dám làm người ta yêu phải khóc...
Dialogue: 0,0:14:22.28,0:14:23.20,Default,,0,0,0,,Tử hình!
Dialogue: 0,0:14:30.12,0:14:31.83,Default,,0,0,0,,Ifrit Jambe!
Dialogue: 0,0:14:36.46,0:14:38.21,Default,,0,0,0,,Tam Kiếm Phái.
Dialogue: 0,0:14:39.80,0:14:44.59,Default,,0,0,0,,Voi Roi...
Dialogue: 0,0:14:45.76,0:14:47.39,Default,,0,0,0,,Épaule...
Dialogue: 0,0:14:48.30,0:14:50.64,Default,,0,0,0,,Hắc Thằng Đại Long...
Dialogue: 0,0:14:54.52,0:14:55.90,Default,,0,0,0,,Cuốn!
Dialogue: 0,0:15:00.69,0:15:02.57,Default,,0,0,0,,Cao su!
Dialogue: 0,0:15:08.03,0:15:09.49,Default,,0,0,0,,Strike!
Dialogue: 0,0:15:36.60,0:15:38.56,Default,,0,0,0,,Thoát rồi...
Dialogue: 0,0:15:42.82,0:15:45.07,Default,,0,0,0,,Gì thế này? Biến thành mèo rồi.
Dialogue: 0,0:15:45.44,0:15:47.41,Default,,0,0,0,,To thật.
Dialogue: 0,0:15:47.41,0:15:49.78,Default,,0,0,0,,Nhưng chắc là không ăn được.
Dialogue: 0,0:15:50.20,0:15:53.87,Default,,0,0,0,,Thỏ nướng lúc nãy\Nthì ngon ghê.
Dialogue: 0,0:15:54.83,0:15:56.96,Default,,0,0,0,,Nami!
Dialogue: 0,0:15:57.37,0:16:00.21,Default,,0,0,0,,Tôi đã lo lắm đấy!
Dialogue: 0,0:16:01.71,0:16:04.80,Default,,0,0,0,,Sanji, tôi sợ quá!
Dialogue: 0,0:16:04.80,0:16:07.05,Default,,0,0,0,,Usopp thì chết rồi.
Dialogue: 0,0:16:07.13,0:16:09.76,Default,,0,0,0,,Sợ lắm nhỉ.
Dialogue: 0,0:16:09.76,0:16:12.76,Default,,0,0,0,,Chắc chắn Usopp cũng rất vinh hạnh\Nvì được chết vì Nami.
Dialogue: 0,0:16:12.85,0:16:14.85,Default,,0,0,0,,Tớ còn sống...
Dialogue: 0,0:16:15.68,0:16:21.40,Default,,0,0,0,,Đáng ghét! Tôi không quên vụ bị cậu dùng\Nlàm bia đỡ đạn đâu!
Dialogue: 0,0:16:35.62,0:16:36.95,Default,,0,0,0,,G-Gì vậy?
Dialogue: 0,0:16:40.00,0:16:41.58,Default,,0,0,0,,Lần này là cái gì nữa?
Dialogue: 0,0:16:41.67,0:16:42.50,Default,,0,0,0,,Lại nữa à?
Dialogue: 0,0:16:42.59,0:16:43.13,Default,,0,0,0,,Cái gì?
Dialogue: 0,0:16:43.21,0:16:46.05,Default,,0,0,0,,Hình như có một con lớn hơn.
Dialogue: 0,0:16:46.05,0:16:48.34,Default,,0,0,0,,Nó mà ngon thì đi hạ cũng được.
Dialogue: 0,0:16:48.42,0:16:51.39,Default,,0,0,0,,Phải tìm biển và con tàu trước.
Dialogue: 0,0:16:51.39,0:16:53.43,Default,,0,0,0,,Còn chẳng biết mọi người có ổn không.
Dialogue: 0,0:16:53.93,0:16:55.93,Default,,0,0,0,,Nói về thức ăn,
Dialogue: 0,0:16:55.93,0:16:58.77,Default,,0,0,0,,tổ ong và bầy ong mật mà cậu thổi bay...
Dialogue: 0,0:17:00.44,0:17:04.44,Default,,0,0,0,,Đó có thể là khẩu phần ăn hoàn hảo\Nđầy dinh dưỡng đấy.
Dialogue: 0,0:17:04.52,0:17:07.99,Default,,0,0,0,,Thế à? Phí thật.
Dialogue: 0,0:17:08.07,0:17:08.82,Default,,0,0,0,,Chứ gì nữa.
Dialogue: 0,0:17:08.90,0:17:09.99,Default,,0,0,0,,Nói sớm thế.
Dialogue: 0,0:17:10.07,0:17:11.28,Default,,0,0,0,,Hả?!
Dialogue: 0,0:17:11.36,0:17:13.57,Default,,0,0,0,,Sao tự nhiên như ruồi thế?
Dialogue: 0,0:17:13.57,0:17:15.24,Default,,0,0,0,,Đây là đâu!?
Dialogue: 0,0:17:17.79,0:17:20.96,Default,,0,0,0,,Này, sao các cậu đến được đây vậy?
Dialogue: 0,0:17:21.04,0:17:26.46,Default,,0,0,0,,Tớ thức dậy ở phía sau thị trấn đó,\Nđi về phía có tiếng ồn ào,
Dialogue: 0,0:17:26.46,0:17:28.88,Default,,0,0,0,,và thấy cậu ấy vừa hạ một con thỏ khổng lồ.
Dialogue: 0,0:17:28.97,0:17:32.51,Default,,0,0,0,,Đáng lẽ cậu có thể hạ con Mèo Sư Tử\Nbé xíu đó chứ, Usopp.
Dialogue: 0,0:17:32.59,0:17:35.93,Default,,0,0,0,,Vừa nhận ra thì đã ở trong miệng nó rồi!\NHoảng lắm chứ bộ.
Dialogue: 0,0:17:41.19,0:17:41.94,Default,,0,0,0,,Hả?
Dialogue: 0,0:17:48.94,0:17:50.90,Default,,0,0,0,,Bóng Bay...
Dialogue: 0,0:17:52.41,0:17:54.16,Default,,0,0,0,,Cao Su!
Dialogue: 0,0:18:05.00,0:18:07.46,Default,,0,0,0,,Ui da...
Dialogue: 0,0:18:07.46,0:18:08.88,Default,,0,0,0,,Suýt nữa thì...
Dialogue: 0,0:18:08.96,0:18:13.88,Default,,0,0,0,,Những con quái vật to lớn kỳ lạ\Nvà tòa lâu đài trông giả tạo này...
Dialogue: 0,0:18:13.88,0:18:16.68,Default,,0,0,0,,nếu thế giới này không phải là ảo giác thì...
Dialogue: 0,0:18:16.76,0:18:19.18,Default,,0,0,0,,Là mơ đúng không?
Dialogue: 0,0:18:19.52,0:18:20.43,Default,,0,0,0,,Không.
Dialogue: 0,0:18:21.27,0:18:23.19,Default,,0,0,0,,Nếu đây là mơ...
Dialogue: 0,0:18:24.56,0:18:26.77,Default,,0,0,0,,thì không thể có đàn ông ở đây được.
Dialogue: 0,0:18:26.86,0:18:29.15,Default,,0,0,0,,Bình thường cậu mơ thấy gì thế?
Dialogue: 0,0:18:30.07,0:18:31.78,Default,,0,0,0,,Nào, Nami.
Dialogue: 0,0:18:33.90,0:18:35.49,Default,,0,0,0,,Nhảy thôi!
Dialogue: 0,0:18:36.82,0:18:37.70,Default,,0,0,0,,Hả?
Dialogue: 0,0:19:10.23,0:19:11.65,Default,,0,0,0,,Lạ thật.
Dialogue: 0,0:19:12.19,0:19:14.24,Default,,0,0,0,,Chẳng có gió gì cả.
Dialogue: 0,0:19:21.33,0:19:23.08,Default,,0,0,0,,Ra vậy, hiểu rồi.
Dialogue: 0,0:19:23.16,0:19:23.87,Default,,0,0,0,,Hiểu gì?
Dialogue: 0,0:19:25.37,0:19:27.58,Default,,0,0,0,,Đây là... cây sao?
Dialogue: 0,0:19:27.67,0:19:29.54,Default,,0,0,0,,Theo như tớ nghĩ...
Dialogue: 0,0:19:30.13,0:19:35.88,Default,,0,0,0,,Chúng ta đang được mặc trang phục\Ncủa chiến binh Elbaph.
Dialogue: 0,0:19:36.26,0:19:40.35,Default,,0,0,0,,Nhưng ở đất nước của Người khổng lồ\Nthì không thể có...
Dialogue: 0,0:19:40.35,0:19:42.56,Default,,0,0,0,,quần áo vừa kích cỡ chúng ta được.
Dialogue: 0,0:19:42.64,0:19:47.23,Default,,0,0,0,,Vậy đây là Elbaph\Nvà chúng ta đã trở nên khổng lồ sao?
Dialogue: 0,0:19:47.31,0:19:49.19,Default,,0,0,0,,Giờ tớ là người khổng lồ sao?
Dialogue: 0,0:19:49.27,0:19:51.07,Default,,0,0,0,,Không thể nào.
Dialogue: 0,0:19:51.15,0:19:54.65,Default,,0,0,0,,Dù ở đây có vài người trong đội\Nnhưng không phải tất cả.
Dialogue: 0,0:19:54.74,0:19:55.99,Default,,0,0,0,,Sao cậu biết?
Dialogue: 0,0:19:57.99,0:20:00.49,Default,,0,0,0,,"Mero-Radar" của tôi\Nkhông phát hiện ra Robin.
Dialogue: 0,0:20:00.57,0:20:01.41,Default,,0,0,0,,Chó à?
Dialogue: 0,0:20:01.78,0:20:03.08,Default,,0,0,0,,Đúng rồi!
Dialogue: 0,0:20:03.08,0:20:06.41,Default,,0,0,0,,Nếu đi về phía biển, có thể tìm thấy Sunny đấy.
Dialogue: 0,0:20:06.41,0:20:07.92,Default,,0,0,0,,Và mọi người sẽ ở đó.
Dialogue: 0,0:20:08.00,0:20:10.46,Default,,0,0,0,,Nhìn khu vực rộng lớn này đi.
Dialogue: 0,0:20:10.46,0:20:12.75,Default,,0,0,0,,Làm sao mà ra biển được.
Dialogue: 0,0:20:12.84,0:20:14.00,Default,,0,0,0,,Đúng là rộng thật.
Dialogue: 0,0:20:14.38,0:20:16.72,Default,,0,0,0,,Có vẻ trong thị trấn\Ncũng có người.
Dialogue: 0,0:20:16.72,0:20:21.14,Default,,0,0,0,,Trước mắt cứ đi hỏi xem\Nđây là đâu đã.
Dialogue: 0,0:20:21.22,0:20:22.97,Default,,0,0,0,,Vậy xuống thị trấn thôi.
Dialogue: 0,0:20:23.35,0:20:27.06,Default,,0,0,0,,Nếu đã hỏi thì hỏi\Nchị nào xinh xinh một tí nhé.
Dialogue: 0,0:20:27.14,0:20:28.73,Default,,0,0,0,,Nghiêm túc coi!
Dialogue: 0,0:20:28.73,0:20:30.44,Default,,0,0,0,,Thị trấn không phải hướng đó, Zoro!
Dialogue: 0,0:20:30.52,0:20:31.69,Default,,0,0,0,,Ồ, thế hả?
Dialogue: 0,0:20:33.98,0:20:36.28,Default,,0,0,0,,Sao các cậu vẫn vui vẻ như vậy?
Dialogue: 0,0:20:36.28,0:20:39.95,Default,,0,0,0,,Có biết đang ở một nơi\Nđáng sợ thế nào không?
Dialogue: 0,0:20:40.03,0:20:44.58,Default,,0,0,0,,Nami, vui lên đi. Có tôi ở đây mà!
Dialogue: 0,0:20:44.58,0:20:46.79,Default,,0,0,0,,Cho dù đây không phải là Elbaph,
Dialogue: 0,0:20:46.79,0:20:51.13,Default,,0,0,0,,trái tim tôi luôn tràn ngập tình yêu to lớn\Ndành cho Nami!
Dialogue: 0,0:20:52.46,0:20:57.38,Default,,0,0,0,,Đây mà là Elbaph\Nthì tôi nghĩ mình phải thấy thỏi vàng khổng lồ cơ.
Dialogue: 0,0:20:57.47,0:20:59.22,Default,,0,0,0,,Ý cậu là định "trộm" đúng không?
Dialogue: 0,0:20:59.68,0:21:02.68,Default,,0,0,0,,Được rồi! Xuống thị trấn hỏi chuyện thôi!
Dialogue: 0,0:21:03.30,0:21:05.01,Default,,0,0,0,,Đúng đấy, đi thôi!
Dialogue: 0,0:21:05.72,0:21:07.64,Default,,0,0,0,,Thám hiểm nào!
Dialogue: 0,0:21:07.73,0:21:10.10,Default,,0,0,0,,Ừ!
Dialogue: 0,0:21:12.56,0:21:20.95,Default,,0,0,0,,Elbaph-baf! Elbaph!
Dialogue: 0,0:21:20.95,0:21:24.53,Default,,0,0,0,,Mọi người to lớn vì là\NNgười Khổng Lồ!
Dialogue: 0,0:23:05.68,0:23:08.51,Default,,0,0,0,,Nhóm Luffy phiêu lưu vào vùng đất bí ẩn.
Dialogue: 0,0:23:08.51,0:23:12.93,Default,,0,0,0,,Vượt qua khung cảnh của những khối đồ chơi,\Nhọ khám phá ra đền thờ của Thần Mặt Trời.
Dialogue: 0,0:23:12.93,0:23:15.27,Default,,0,0,0,,Đây có thực sự là Elbaph không?
Dialogue: 0,0:23:15.90,0:23:21.15,Default,,0,0,0,,Khi họ định trốn thoát khỏi Vương quốc khối xếp hình, những bước chân đầy điềm gở đang đến gần.
Dialogue: 0,0:23:21.23,0:23:22.90,Default,,0,0,0,,Kỳ tới trong One Piece:
Dialogue: 0,0:23:22.90,0:23:26.24,Default,,0,0,0,,Nhiệm vụ ở vùng đất bí ẩn!\NBí mật của Thần Mặt Trời!
Dialogue: 0,0:23:26.24,0:23:30.66,Default,,0,0,0,,Tôi sẽ trở thành Vua Hải Tặc!

