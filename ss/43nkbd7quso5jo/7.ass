Dialogue: 0,0:01:41.60,0:01:43.27,Default,,0,0,0,,Nami... Nami!
Dialogue: 0,0:01:43.27,0:01:44.81,Default,,0,0,0,,Hei! Bangun!
Dialogue: 0,0:01:53.91,0:01:55.45,Default,,0,0,0,,Aduh, duh.
Dialogue: 0,0:01:55.45,0:01:57.58,Default,,0,0,0,,Aku minum terlalu...
Dialogue: 0,0:01:57.91,0:01:58.54,Default,,0,0,0,,banyak?
Dialogue: 0,0:02:04.29,0:02:05.25,Default,,0,0,0,,Eh?
Dialogue: 0,0:02:08.75,0:02:10.09,Default,,0,0,0,,Di mana ini?
Dialogue: 0,0:02:17.18,0:02:18.72,Default,,0,0,0,,Tak ada siapa-siapa.
Dialogue: 0,0:02:23.98,0:02:25.65,Default,,0,0,0,,Apa yang terjadi?
Dialogue: 0,0:02:32.11,0:02:34.11,Default,,0,0,0,,Cuma perasaanku, ya?
Dialogue: 0,0:02:34.11,0:02:35.61,Default,,0,0,0,,Lagi pula, aku...
Dialogue: 0,0:02:35.61,0:02:37.24,Default,,0,0,0,,Aduh!
Dialogue: 0,0:02:37.24,0:02:39.74,Default,,0,0,0,,Kenapa aku ada di sini, ya?
Dialogue: 0,0:02:39.74,0:02:43.46,Default,,0,0,0,,Kalau tidak salah,\Naku naik kapal Raksasa di Egghead,
Dialogue: 0,0:02:43.46,0:02:45.75,Default,,0,0,0,,dan kami sedang berpesta...
Dialogue: 0,0:02:51.34,0:02:53.84,Default,,0,0,0,,Duh, itu apa, sih?
Dialogue: 0,0:02:54.38,0:02:58.26,Default,,0,0,0,,Pokoknya, aku harus segera\Nmenyusul Luffy dan yang lain.
Dialogue: 0,0:03:02.93,0:03:05.14,Default,,0,0,0,,Tidak!
Dialogue: 0,0:03:06.47,0:03:08.71,Default,,0,0,0,,NAMI DALAM MASALAH!\NPETUALANGAN DI KERAJAAN BLOK
Dialogue: 0,0:03:08.77,0:03:14.53,Default,,0,0,0,,"Nami dalam Masalah!\NPetualangan di Kerajaan Blok."
Dialogue: 0,0:03:20.99,0:03:21.79,Default,,0,0,0,,Gawat.
Dialogue: 0,0:03:22.24,0:03:23.25,Default,,0,0,0,,Kebakaran!
Dialogue: 0,0:03:23.33,0:03:24.62,Default,,0,0,0,,Apa hutannya terbakar?
Dialogue: 0,0:03:25.00,0:03:26.54,Default,,0,0,0,,Baunya busuk sekali.
Dialogue: 0,0:03:26.62,0:03:29.04,Default,,0,0,0,,Padamkan dengan air dari mata air!
Dialogue: 0,0:03:29.33,0:03:33.71,Default,,0,0,0,,Kalau Yggdrasil terbakar,\Ntamatlah negara ini!
Dialogue: 0,0:03:35.51,0:03:36.88,Default,,0,0,0,,Apa itu?
Dialogue: 0,0:03:44.89,0:03:46.56,Default,,0,0,0,,Stingmore...
Dialogue: 0,0:03:47.23,0:03:49.27,Default,,0,0,0,,Apa yang sebenarnya terjadi?
Dialogue: 0,0:03:50.31,0:03:54.32,Default,,0,0,0,,Kata orang-orang di hutan,\Ngetaran yang kita rasakan tadi
Dialogue: 0,0:03:54.32,0:03:56.49,Default,,0,0,0,,itu suara jatuhnya Dewa Telinga Panjang.
Dialogue: 0,0:03:56.57,0:03:58.36,Default,,0,0,0,,Masa, sih?
Dialogue: 0,0:03:58.36,0:04:00.62,Default,,0,0,0,,Kelinci raksasa yang buas itu?
Dialogue: 0,0:04:00.99,0:04:04.49,Default,,0,0,0,,Kita harus lapor pada Dewa Matahari.
Dialogue: 0,0:04:05.62,0:04:07.48,Default,,0,0,0,,KASTEL BIGSTEIN
Dialogue: 0,0:04:07.54,0:04:09.71,Default,,0,0,0,,Dia masih hidup!
Dialogue: 0,0:04:12.50,0:04:16.13,Default,,0,0,0,,Jangan berani sentuh Nami!
Dialogue: 0,0:04:28.81,0:04:31.44,Default,,0,0,0,,Lebah raksasa apa itu?
Dialogue: 0,0:04:31.86,0:04:34.36,Default,,0,0,0,,Selamat pagi, Nami.
Dialogue: 0,0:04:34.36,0:04:36.07,Default,,0,0,0,,Kita ada di mana?
Dialogue: 0,0:04:36.15,0:04:37.69,Default,,0,0,0,,Entahlah.
Dialogue: 0,0:04:37.69,0:04:40.86,Default,,0,0,0,,Seharusnya kita ada di kapal Raksasa.
Dialogue: 0,0:04:42.12,0:04:44.83,Default,,0,0,0,,Di mana ini?\NApa ini mimpi?
Dialogue: 0,0:04:45.16,0:04:46.62,Default,,0,0,0,,Apa ini semacam kastel?
Dialogue: 0,0:04:47.70,0:04:49.09,Default,,0,0,0,,Apa aku gila?
Dialogue: 0,0:04:49.09,0:04:51.25,Default,,0,0,0,,Aku juga tak ingat ganti baju.
Dialogue: 0,0:04:54.29,0:04:57.59,Default,,0,0,0,,Aku mau tidur lagi saja.
Dialogue: 0,0:04:58.33,0:04:59.95,Default,,0,0,0,,Eh? Apa?
Dialogue: 0,0:05:01.13,0:05:03.64,Default,,0,0,0,,Hei, jangan tinggalkan aku sendiri!
Dialogue: 0,0:05:03.64,0:05:05.01,Default,,0,0,0,,Zeus!
Dialogue: 0,0:05:05.01,0:05:07.02,Default,,0,0,0,,Hei, Zeus!
Dialogue: 0,0:05:08.89,0:05:12.73,Default,,0,0,0,,Seseorang... Tolong aku!
Dialogue: 0,0:05:13.44,0:05:15.02,Default,,0,0,0,,Luffy!
Dialogue: 0,0:05:15.02,0:05:16.32,Default,,0,0,0,,Zoro!
Dialogue: 0,0:05:16.32,0:05:18.32,Default,,0,0,0,,Sanji!
Dialogue: 0,0:05:18.90,0:05:20.82,Default,,0,0,0,,Usopp pun tak apa-apa saat ini.
Dialogue: 0,0:05:20.90,0:05:24.32,Default,,0,0,0,,Hei, Nami!
Dialogue: 0,0:05:24.41,0:05:26.54,Default,,0,0,0,,Apa? Usopp?
Dialogue: 0,0:05:30.04,0:05:32.46,Default,,0,0,0,,Aduh!
Dialogue: 0,0:05:32.46,0:05:36.63,Default,,0,0,0,,Astaga! Lantai apa ini?
Dialogue: 0,0:05:36.63,0:05:38.34,Default,,0,0,0,,Bergelombang sekali.
Dialogue: 0,0:05:56.61,0:05:59.15,Default,,0,0,0,,Besar sekali!
Dialogue: 0,0:06:02.70,0:06:05.28,Default,,0,0,0,,Tunggu, aku tak bermaksud mengagetkanmu.
Dialogue: 0,0:06:09.33,0:06:11.20,Default,,0,0,0,,Jangan marah, ya?
Dialogue: 0,0:06:15.63,0:06:17.54,Default,,0,0,0,,Aku tak sengaja!
Dialogue: 0,0:06:17.54,0:06:19.30,Default,,0,0,0,,Maafkan aku!
Dialogue: 0,0:06:23.34,0:06:25.68,Default,,0,0,0,,Jalannya lambat.\NMungkin karena kakinya pendek?
Dialogue: 0,0:06:30.43,0:06:32.93,Default,,0,0,0,,Ayolah. Usopp!
Dialogue: 0,0:06:32.93,0:06:34.81,Default,,0,0,0,,Kau di mana?
Dialogue: 0,0:06:34.89,0:06:36.52,Default,,0,0,0,,Aku di sini!
Dialogue: 0,0:06:37.44,0:06:38.48,Default,,0,0,0,,Usopp!
Dialogue: 0,0:06:46.41,0:06:48.45,Default,,0,0,0,,Tolong aku!
Dialogue: 0,0:06:48.53,0:06:50.45,Default,,0,0,0,,Kau minta tolong padaku?
Dialogue: 0,0:06:50.45,0:06:52.45,Default,,0,0,0,,Maksudku, monster apa itu?
Dialogue: 0,0:06:54.62,0:06:56.42,Default,,0,0,0,,Usopp dalam masalah!
Dialogue: 0,0:06:56.88,0:06:58.38,Default,,0,0,0,,Aku juga dalam masalah!
Dialogue: 0,0:06:58.79,0:07:00.59,Default,,0,0,0,,Tempat apa ini?
Dialogue: 0,0:07:00.59,0:07:02.46,Default,,0,0,0,,Kastel monster?
Dialogue: 0,0:07:04.30,0:07:06.68,Default,,0,0,0,,Ayolah. Aku butuh kau, Zeus!
Dialogue: 0,0:07:06.68,0:07:08.80,Default,,0,0,0,,Bangun. Hei!
Dialogue: 0,0:07:09.89,0:07:11.39,Default,,0,0,0,,Cepatlah bangun!
Dialogue: 0,0:07:14.48,0:07:17.60,Default,,0,0,0,,Nami, sudah waktunya makan?
Dialogue: 0,0:07:19.19,0:07:21.44,Default,,0,0,0,,Akan kuberi banyak awan segar!
Dialogue: 0,0:07:21.52,0:07:22.78,Default,,0,0,0,,Benarkah?
Dialogue: 0,0:07:26.28,0:07:27.45,Default,,0,0,0,,Membesarlah, Zeus!
Dialogue: 0,0:07:27.53,0:07:29.03,Default,,0,0,0,,Serahkan padaku!
Dialogue: 0,0:07:37.29,0:07:39.04,Default,,0,0,0,,Zeus, kau pasti bisa!
Dialogue: 0,0:07:52.01,0:07:53.77,Default,,0,0,0,,Aku mau jatuh!
Dialogue: 0,0:07:56.06,0:07:59.23,Default,,0,0,0,,Rasakan petir ini!
Dialogue: 0,0:08:13.79,0:08:15.12,Default,,0,0,0,,Eh... Apa?
Dialogue: 0,0:08:24.46,0:08:25.09,Default,,0,0,0,,Aduh!
Dialogue: 0,0:08:31.64,0:08:33.76,Default,,0,0,0,,Apa?!
Dialogue: 0,0:08:50.57,0:08:52.49,Default,,0,0,0,,Perasaanku tidak enak.
Dialogue: 0,0:08:52.57,0:08:53.78,Default,,0,0,0,,Aku juga.
Dialogue: 0,0:08:57.66,0:08:58.96,Default,,0,0,0,,Ini...
Dialogue: 0,0:08:59.37,0:09:01.29,Default,,0,0,0,,Sudah pasti...
Dialogue: 0,0:09:13.85,0:09:15.35,Default,,0,0,0,,Tolong!
Dialogue: 0,0:09:20.31,0:09:23.06,Default,,0,0,0,,Sial. Susah lari!\NLantai bergelombang ini menyebalkan!
Dialogue: 0,0:09:23.15,0:09:25.82,Default,,0,0,0,,Hei, Usopp!\NTahu apa yang terjadi?
Dialogue: 0,0:09:26.27,0:09:29.44,Default,,0,0,0,,Sama sekali tidak.\NAku terbangun dan sudah ada di sini!
Dialogue: 0,0:09:30.53,0:09:35.24,Default,,0,0,0,,Wah, tempat apa ini?
Dialogue: 0,0:09:40.16,0:09:41.54,Default,,0,0,0,,Apa?
Dialogue: 0,0:09:41.54,0:09:42.92,Default,,0,0,0,,Janggut?
Dialogue: 0,0:09:43.50,0:09:44.83,Default,,0,0,0,,Pakaian ini...
Dialogue: 0,0:09:45.38,0:09:46.42,Default,,0,0,0,,Jangan bilang...
Dialogue: 0,0:09:51.30,0:09:52.22,Default,,0,0,0,,Nami!
Dialogue: 0,0:09:52.22,0:09:54.30,Default,,0,0,0,,Hei, bangun!
Dialogue: 0,0:09:58.35,0:10:00.77,Default,,0,0,0,,Aduh, duh, duh...
Dialogue: 0,0:10:00.77,0:10:01.56,Default,,0,0,0,,Apa itu tadi?
Dialogue: 0,0:10:09.44,0:10:10.53,Default,,0,0,0,,Begitulah ceritanya.
Dialogue: 0,0:10:10.61,0:10:13.24,Default,,0,0,0,,Jadi itu suaramu.
Dialogue: 0,0:10:13.53,0:10:15.16,Default,,0,0,0,,Bagaimana kita bisa sampai di sini?
Dialogue: 0,0:10:15.57,0:10:16.99,Default,,0,0,0,,Entahlah.
Dialogue: 0,0:10:16.99,0:10:19.54,Default,,0,0,0,,Kita naik ke kapal Raksasa,
Dialogue: 0,0:10:19.95,0:10:21.45,Default,,0,0,0,,lalu mabuk...
Dialogue: 0,0:10:23.58,0:10:25.54,Default,,0,0,0,,Omong-omong,
Dialogue: 0,0:10:26.04,0:10:27.79,Default,,0,0,0,,miras ini lumayan keras.
Dialogue: 0,0:10:28.42,0:10:31.30,Default,,0,0,0,,Ya, ini absinth.
Dialogue: 0,0:10:31.30,0:10:33.93,Default,,0,0,0,,Dikenal juga sebagai peri hijau.
Dialogue: 0,0:10:34.01,0:10:37.76,Default,,0,0,0,,Oh, ya.\NKatanya miras itu bisa bikin halusinasi!
Dialogue: 0,0:10:39.64,0:10:40.68,Default,,0,0,0,,Jalan buntu?
Dialogue: 0,0:10:46.69,0:10:48.57,Default,,0,0,0,,Tinggi sekali!
Dialogue: 0,0:10:56.28,0:10:58.20,Default,,0,0,0,,Kita harus bagaimana, Usopp?
Dialogue: 0,0:10:58.28,0:11:01.29,Default,,0,0,0,,Kau bilang "halusinasi", 'kan, Nami?
Dialogue: 0,0:11:01.83,0:11:02.50,Default,,0,0,0,,Apa?
Dialogue: 0,0:11:02.58,0:11:05.29,Default,,0,0,0,,Kalau begitu, kucing itu...
Dialogue: 0,0:11:05.29,0:11:07.79,Default,,0,0,0,,Kita melihatnya, tapi mungkin itu cuma...
Dialogue: 0,0:11:10.46,0:11:12.13,Default,,0,0,0,,halusinasi.
Dialogue: 0,0:11:15.22,0:11:16.72,Default,,0,0,0,,Majulah!
Dialogue: 0,0:11:27.23,0:11:29.73,Default,,0,0,0,,Usopp!
Dialogue: 0,0:11:43.12,0:11:44.20,Default,,0,0,0,,Usopp...
Dialogue: 0,0:11:48.54,0:11:52.55,Default,,0,0,0,,Tidak!
Dialogue: 0,0:12:20.24,0:12:21.82,Default,,0,0,0,,Aduh, duh, duh, duh...
Dialogue: 0,0:12:21.82,0:12:23.70,Default,,0,0,0,,Aku masih hidup?
Dialogue: 0,0:12:28.37,0:12:31.50,Default,,0,0,0,,Usopp berubah jadi Brook!
Dialogue: 0,0:12:39.22,0:12:40.39,Default,,0,0,0,,Usopp!
Dialogue: 0,0:12:43.81,0:12:45.85,Default,,0,0,0,,Hei, bangun.
Dialogue: 0,0:12:45.85,0:12:49.31,Default,,0,0,0,,Jangan tinggalkan aku sendiri!
Dialogue: 0,0:12:51.35,0:12:52.52,Default,,0,0,0,,Usopp!
Dialogue: 0,0:13:24.97,0:13:26.76,Default,,0,0,0,,Kenapa singa?
Dialogue: 0,0:13:26.76,0:13:28.31,Default,,0,0,0,,Usopp, bertahanlah!
Dialogue: 0,0:13:28.31,0:13:30.77,Default,,0,0,0,,Bangun. Kita bisa mati!
Dialogue: 0,0:13:30.77,0:13:33.56,Default,,0,0,0,,Usopp, Usopp!
Dialogue: 0,0:13:50.12,0:13:52.04,Default,,0,0,0,,Hei, jangan jadikan aku tameng!
Dialogue: 0,0:13:53.00,0:13:54.25,Default,,0,0,0,,Pergi. Menjauh dari kami!
Dialogue: 0,0:13:54.33,0:13:56.21,Default,,0,0,0,,Tamatlah kita...
Dialogue: 0,0:14:04.22,0:14:05.80,Default,,0,0,0,,Gear Third!
Dialogue: 0,0:14:14.56,0:14:17.15,Default,,0,0,0,,Nami!
Dialogue: 0,0:14:19.44,0:14:22.28,Default,,0,0,0,,Karena membuat orang\Nyang kucintai menangis...
Dialogue: 0,0:14:22.28,0:14:23.20,Default,,0,0,0,,Hukuman mati!
Dialogue: 0,0:14:30.12,0:14:31.83,Default,,0,0,0,,Ifrit Jambe!
Dialogue: 0,0:14:36.46,0:14:38.21,Default,,0,0,0,,Santoryu.
Dialogue: 0,0:14:39.80,0:14:42.05,Default,,0,0,0,,Gomu Gomu no...
Dialogue: 0,0:14:42.63,0:14:44.59,Default,,0,0,0,,Elephant...
Dialogue: 0,0:14:45.76,0:14:47.39,Default,,0,0,0,,Ă‰paule...
Dialogue: 0,0:14:48.30,0:14:50.64,Default,,0,0,0,,Kokujo...
Dialogue: 0,0:14:54.52,0:14:55.90,Default,,0,0,0,,O Tatsumaki!
Dialogue: 0,0:15:00.69,0:15:02.57,Default,,0,0,0,,Whip!
Dialogue: 0,0:15:08.03,0:15:09.49,Default,,0,0,0,,Strike!
Dialogue: 0,0:15:36.60,0:15:38.56,Default,,0,0,0,,Aku selamat.
Dialogue: 0,0:15:42.82,0:15:45.07,Default,,0,0,0,,Apa? Berubah jadi kucing.
Dialogue: 0,0:15:45.44,0:15:47.41,Default,,0,0,0,,Besar sekali!
Dialogue: 0,0:15:47.41,0:15:49.78,Default,,0,0,0,,Tapi aku tak mau makan yang ini.
Dialogue: 0,0:15:50.20,0:15:53.87,Default,,0,0,0,,Kelinci panggang tadi enak.
Dialogue: 0,0:15:54.83,0:15:56.96,Default,,0,0,0,,Nami!
Dialogue: 0,0:15:57.37,0:16:00.21,Default,,0,0,0,,Aku mengkhawatirkanmu!
Dialogue: 0,0:16:01.71,0:16:04.80,Default,,0,0,0,,Sanji, aku takut sekali!
Dialogue: 0,0:16:04.80,0:16:07.05,Default,,0,0,0,,Usopp mati.
Dialogue: 0,0:16:07.13,0:16:09.76,Default,,0,0,0,,Kau pasti sangat ketakutan.
Dialogue: 0,0:16:09.76,0:16:12.76,Default,,0,0,0,,Dia pasti bahagia mati untukmu.
Dialogue: 0,0:16:12.85,0:16:14.85,Default,,0,0,0,,Aku masih hidup.
Dialogue: 0,0:16:15.68,0:16:21.40,Default,,0,0,0,,Keparat, takkan kulupakan kau\Nyang menjadikanku tameng.
Dialogue: 0,0:16:35.62,0:16:36.95,Default,,0,0,0,,A-Apa itu?
Dialogue: 0,0:16:40.00,0:16:41.58,Default,,0,0,0,,Apa lagi sekarang?
Dialogue: 0,0:16:41.67,0:16:42.50,Default,,0,0,0,,Lagi?
Dialogue: 0,0:16:42.59,0:16:43.13,Default,,0,0,0,,Apa?
Dialogue: 0,0:16:43.21,0:16:46.05,Default,,0,0,0,,Sepertinya ada yang lebih besar.
Dialogue: 0,0:16:46.05,0:16:48.34,Default,,0,0,0,,Kalau enak, aku siap menghabisinya.
Dialogue: 0,0:16:48.42,0:16:51.39,Default,,0,0,0,,Kita harus cari laut dan kapal dulu.
Dialogue: 0,0:16:51.39,0:16:53.43,Default,,0,0,0,,Kita tak tahu apa kru kita baik-baik saja.
Dialogue: 0,0:16:53.93,0:16:55.93,Default,,0,0,0,,Bicara soal makanan,
Dialogue: 0,0:16:55.93,0:16:58.77,Default,,0,0,0,,sarang dan kawanan lebah madu\Nyang kau hempaskan tadi...
Dialogue: 0,0:17:00.44,0:17:04.44,Default,,0,0,0,,Itu bisa jadi ransum yang bagus\Ndan penuh nutrisi.
Dialogue: 0,0:17:04.52,0:17:07.99,Default,,0,0,0,,Oh, ya?\NSayang sekali.
Dialogue: 0,0:17:08.07,0:17:08.82,Default,,0,0,0,,Ya, 'kan?
Dialogue: 0,0:17:08.90,0:17:09.99,Default,,0,0,0,,Bilang dari tadi, dong.
Dialogue: 0,0:17:10.07,0:17:11.28,Default,,0,0,0,,Hah?
Dialogue: 0,0:17:11.36,0:17:13.57,Default,,0,0,0,,Kenapa kalian santai sekali di sini?
Dialogue: 0,0:17:13.57,0:17:15.24,Default,,0,0,0,,Tempat apa ini?
Dialogue: 0,0:17:17.79,0:17:20.96,Default,,0,0,0,,Hei, bagaimana kalian bisa sampai di sini?
Dialogue: 0,0:17:21.04,0:17:26.46,Default,,0,0,0,,Aku bangun di belakang kota itu,\Nberjalan ke arah keributan,
Dialogue: 0,0:17:26.46,0:17:28.88,Default,,0,0,0,,dan melihatnya menghabisi kelinci raksasa.
Dialogue: 0,0:17:28.97,0:17:32.51,Default,,0,0,0,,Kau harusnya bisa mengalahkan\NKucing-Singa payah itu, Usopp.
Dialogue: 0,0:17:32.59,0:17:35.10,Default,,0,0,0,,Tahu-tahu aku sudah ada\Ndi mulut monster kucing itu.
Dialogue: 0,0:17:35.10,0:17:35.93,Default,,0,0,0,,Aku panik.
Dialogue: 0,0:17:41.19,0:17:41.94,Default,,0,0,0,,Apa?
Dialogue: 0,0:17:48.94,0:17:50.90,Default,,0,0,0,,Gomu Gomu no...
Dialogue: 0,0:17:52.41,0:17:54.16,Default,,0,0,0,,Fusen!
Dialogue: 0,0:18:05.00,0:18:07.46,Default,,0,0,0,,Aduh, duh, duh...
Dialogue: 0,0:18:07.46,0:18:08.88,Default,,0,0,0,,Hampir saja.
Dialogue: 0,0:18:08.96,0:18:13.88,Default,,0,0,0,,Monster aneh yang besar\Ndan kastel yang terlihat palsu itu...
Dialogue: 0,0:18:13.88,0:18:16.68,Default,,0,0,0,,kalau dunia ini bukan halusinasi...
Dialogue: 0,0:18:16.76,0:18:19.18,Default,,0,0,0,,Apa ini mimpi?
Dialogue: 0,0:18:19.52,0:18:20.43,Default,,0,0,0,,Bukan.
Dialogue: 0,0:18:21.27,0:18:23.19,Default,,0,0,0,,Kalau ini mimpi,
Dialogue: 0,0:18:24.56,0:18:26.77,Default,,0,0,0,,tak mungkin ada laki-laki yang muncul.
Dialogue: 0,0:18:26.86,0:18:29.15,Default,,0,0,0,,Biasanya kau mimpi apa, sih?
Dialogue: 0,0:18:30.07,0:18:31.78,Default,,0,0,0,,Baiklah, Nami...
Dialogue: 0,0:18:33.90,0:18:35.49,Default,,0,0,0,,Ayo lompat!
Dialogue: 0,0:18:36.82,0:18:37.70,Default,,0,0,0,,Apa?
Dialogue: 0,0:19:10.23,0:19:11.65,Default,,0,0,0,,Aneh sekali.
Dialogue: 0,0:19:12.19,0:19:14.24,Default,,0,0,0,,Tak ada angin sama sekali.
Dialogue: 0,0:19:21.33,0:19:23.08,Default,,0,0,0,,Begitu, ya.
Dialogue: 0,0:19:23.16,0:19:23.87,Default,,0,0,0,,Apa?
Dialogue: 0,0:19:25.37,0:19:27.58,Default,,0,0,0,,Apa ini pohon?
Dialogue: 0,0:19:27.67,0:19:29.54,Default,,0,0,0,,Menurutku begini.
Dialogue: 0,0:19:30.13,0:19:32.05,Default,,0,0,0,,Sejauh yang kulihat,
Dialogue: 0,0:19:32.05,0:19:35.88,Default,,0,0,0,,kita dipakaikan baju pejuang Elbaph.
Dialogue: 0,0:19:36.26,0:19:40.35,Default,,0,0,0,,Tapi di negara Raksasa,\Ntak mungkin mereka punya
Dialogue: 0,0:19:40.35,0:19:42.56,Default,,0,0,0,,baju seukuran kita.
Dialogue: 0,0:19:42.64,0:19:47.23,Default,,0,0,0,,Tunggu, maksudmu kita ada di Elbaph\Ndan tubuh kita membesar?
Dialogue: 0,0:19:47.31,0:19:49.19,Default,,0,0,0,,Aku jadi Raksasa sekarang?
Dialogue: 0,0:19:49.27,0:19:51.07,Default,,0,0,0,,Mana mungkin.
Dialogue: 0,0:19:51.15,0:19:54.65,Default,,0,0,0,,Meski ada beberapa kru kita di sini,\Nsepertinya tidak semuanya ada.
Dialogue: 0,0:19:54.74,0:19:55.99,Default,,0,0,0,,Tahu dari mana?
Dialogue: 0,0:19:57.99,0:20:00.49,Default,,0,0,0,,Radar cintaku tak mendeteksi Robin.
Dialogue: 0,0:20:00.57,0:20:01.41,Default,,0,0,0,,Kau ini anjing, ya?
Dialogue: 0,0:20:01.78,0:20:03.08,Default,,0,0,0,,Oh, ya!
Dialogue: 0,0:20:03.08,0:20:06.41,Default,,0,0,0,,Kalau kita ke laut,\Nkita mungkin bisa menemukan Sunny.
Dialogue: 0,0:20:06.41,0:20:07.92,Default,,0,0,0,,Maka mereka semua akan...
Dialogue: 0,0:20:08.00,0:20:10.46,Default,,0,0,0,,Lihat betapa luasnya tempat ini.
Dialogue: 0,0:20:10.46,0:20:12.75,Default,,0,0,0,,Kita takkan bisa sampai ke laut.
Dialogue: 0,0:20:12.84,0:20:14.00,Default,,0,0,0,,Memang luas.
Dialogue: 0,0:20:14.38,0:20:16.72,Default,,0,0,0,,Sepertinya ada orang di kota itu.
Dialogue: 0,0:20:16.72,0:20:21.14,Default,,0,0,0,,Kalau tidak tanya orang,\Nkita tidak akan tahu tempat apa ini.
Dialogue: 0,0:20:21.22,0:20:22.97,Default,,0,0,0,,Kalau begitu, ayo ke kota!
Dialogue: 0,0:20:23.35,0:20:27.06,Default,,0,0,0,,Kalau mau bertanya, ayo cari wanita cantik.
Dialogue: 0,0:20:27.14,0:20:28.73,Default,,0,0,0,,Serius sedikit, dong!
Dialogue: 0,0:20:28.73,0:20:30.44,Default,,0,0,0,,Kotanya bukan ke arah situ, Zoro!
Dialogue: 0,0:20:30.52,0:20:31.69,Default,,0,0,0,,Oh, ya?
Dialogue: 0,0:20:33.98,0:20:36.28,Default,,0,0,0,,Kenapa kalian malah bersenang-senang?
Dialogue: 0,0:20:36.28,0:20:39.95,Default,,0,0,0,,Kalian sadar atau tidak\Nbetapa mencurigakannya tempat ini?
Dialogue: 0,0:20:40.03,0:20:44.58,Default,,0,0,0,,Nami, semangatlah. Aku bersamamu!
Dialogue: 0,0:20:44.58,0:20:46.79,Default,,0,0,0,,Sekalipun ini bukan Elbaph,
Dialogue: 0,0:20:46.79,0:20:51.13,Default,,0,0,0,,hatiku selalu penuh\Ndengan cinta yang besar untukmu!
Dialogue: 0,0:20:52.46,0:20:57.38,Default,,0,0,0,,Kalau ini Elbaph, setidaknya aku\Ningin melihat emas batangan raksasa.
Dialogue: 0,0:20:57.47,0:20:59.22,Default,,0,0,0,,Maksudmu "mencuri", 'kan?
Dialogue: 0,0:20:59.68,0:21:02.68,Default,,0,0,0,,Baiklah. Ayo ke kota dan bertanya!
Dialogue: 0,0:21:03.30,0:21:05.01,Default,,0,0,0,,Ya. Ayo!
Dialogue: 0,0:21:05.72,0:21:07.64,Default,,0,0,0,,Ayo bertualang!
Dialogue: 0,0:21:07.73,0:21:10.10,Default,,0,0,0,,Ya!
Dialogue: 0,0:21:12.56,0:21:20.95,Default,,0,0,0,,Elbaph-baph! Elbaph!
Dialogue: 0,0:21:20.95,0:21:24.53,Default,,0,0,0,,Semuanya besar karena mereka Raksasa!
Dialogue: 0,0:21:24.59,0:21:30.60,Default,,0,0,0,,BERSAMBUNG
Dialogue: 0,0:23:05.68,0:23:08.51,Default,,0,0,0,,Luffy dan yang lain bertualang\Ndi negeri misterius.
Dialogue: 0,0:23:08.51,0:23:12.93,Default,,0,0,0,,Di balik lanskap blok mainan,\Nmereka menemukan kuil Dewa Matahari.
Dialogue: 0,0:23:12.93,0:23:15.27,Default,,0,0,0,,Apa ini benar-benar Elbaph?
Dialogue: 0,0:23:15.90,0:23:19.18,Default,,0,0,0,,Saat mereka mencoba kabur\Ndari Kerajaan Blok,
Dialogue: 0,0:23:19.18,0:23:21.15,Default,,0,0,0,,langkah kaki misterius mendekat.
Dialogue: 0,0:23:21.23,0:23:22.90,Default,,0,0,0,,Selanjutnya, di ONE PIECE.
Dialogue: 0,0:23:22.90,0:23:26.24,Default,,0,0,0,,"Pencarian di Negeri Misterius!\NRahasia Dewa Matahari."
Dialogue: 0,0:23:26.24,0:23:30.66,Default,,0,0,0,,Aku akan menjadi Raja Bajak Laut!

