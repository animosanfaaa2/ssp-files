Dialogue: 0,0:01:48.11,0:01:50.32,Default,,0,0,0,,เฮ้ อย่าไปก่อนพวกสิ
Dialogue: 0,0:01:50.36,0:01:52.24,Default,,0,0,0,,เดี๋ยวก็หลงทางอีกหรอก
Dialogue: 0,0:01:52.36,0:01:54.74,Default,,0,0,0,,เห็นอยู่ทนโท่จะไปหลงได้ยังไง
Dialogue: 0,0:01:55.32,0:01:57.03,Default,,0,0,0,,โอเค โอเค
Dialogue: 0,0:01:57.16,0:01:59.83,Default,,0,0,0,,นี่ สรุปแล้วเจ้านั่นมันคืออะไรกันแน่
Dialogue: 0,0:01:59.87,0:02:02.04,Default,,0,0,0,,สิงโตกลายร่างเป็นแมวซะงั้น
Dialogue: 0,0:02:02.16,0:02:05.25,Default,,0,0,0,,ไม่นะ น่าจะเป็นแมวที่กลายเป็นสิงโตมากกว่า
Dialogue: 0,0:02:05.29,0:02:06.75,Default,,0,0,0,,เดิมทีก็เป็นแมวนั่นแหละ
Dialogue: 0,0:02:06.88,0:02:07.84,Default,,0,0,0,,สิงโตต่างหาก
Dialogue: 0,0:02:07.96,0:02:08.71,Default,,0,0,0,,แมวต่างหาก
Dialogue: 0,0:02:08.84,0:02:09.46,Default,,0,0,0,,สิงโต
Dialogue: 0,0:02:09.59,0:02:10.26,Default,,0,0,0,,แมว
Dialogue: 0,0:02:10.38,0:02:12.72,Default,,0,0,0,,เรื่องนั้นจะยังไงก็ช่างมันเถอะ
Dialogue: 0,0:02:12.84,0:02:14.84,Default,,0,0,0,,แต่ละอย่างใหญ่ๆ กันทั้งนั้น
Dialogue: 0,0:02:14.97,0:02:16.68,Default,,0,0,0,,จะเจอกระต่ายอีกไหมนะ
Dialogue: 0,0:02:18.97,0:02:20.31,Default,,0,0,0,,มีบางอย่างกำลังมาทางนี้
Dialogue: 0,0:02:20.43,0:02:21.64,Default,,0,0,0,,- เอ๊ะ\N- เอ๊ะ อะไรน่ะ
Dialogue: 0,0:02:21.77,0:02:23.73,Default,,0,0,0,,คุณนามิ อยู่ข้างหลังผมไว้
Dialogue: 0,0:02:28.11,0:02:28.73,Default,,0,0,0,,เอ๊ะ
Dialogue: 0,0:02:39.66,0:02:40.95,Default,,0,0,0,,นั่นมันตัวอะไรกันเนี่ย
Dialogue: 0,0:02:47.75,0:02:53.17,Default,,0,0,0,,การผจญภัยในดินแดนที่ลึกลับ\Nความลับของเทพแห่งดวงอาทิตย์
Dialogue: 0,0:03:11.11,0:03:12.73,Default,,0,0,0,,โอ้ๆ
Dialogue: 0,0:03:16.57,0:03:18.45,Default,,0,0,0,,- ว้าว\N- โห เท่ชะมัด
Dialogue: 0,0:03:21.74,0:03:22.99,Default,,0,0,0,,แมลงแบบนี้ไม่เอาด้วยนะ
Dialogue: 0,0:03:23.12,0:03:25.00,Default,,0,0,0,,แมลงใหญ่ขนาดนี้ฉันขอผ่าน
Dialogue: 0,0:03:25.46,0:03:26.79,Default,,0,0,0,,ตั๊กแตนนี่นา
Dialogue: 0,0:03:26.92,0:03:28.29,Default,,0,0,0,,ได้มายังไงเนี่ย
Dialogue: 0,0:03:28.88,0:03:31.50,Default,,0,0,0,,พวกแกเป็นใคร เพิ่งมาอยู่ที่นี่เหรอ
Dialogue: 0,0:03:31.63,0:03:33.00,Default,,0,0,0,,คุณลุงเป็นใครเหรอ
Dialogue: 0,0:03:33.13,0:03:33.96,Default,,0,0,0,,ที่นี่คือที่ไหน
Dialogue: 0,0:03:34.09,0:03:35.47,Default,,0,0,0,,เห็นเพื่อนของพวกเราบ้างไหม
Dialogue: 0,0:03:35.59,0:03:36.97,Default,,0,0,0,,ขอขึ้นไปขี่ตั๊กแตกนั่นด้วยได้ไหม
Dialogue: 0,0:03:37.09,0:03:37.80,Default,,0,0,0,,- รูปร่างประมาณนี้น่ะ\N- ราคาเท่าไหร่ล่ะ
Dialogue: 0,0:03:37.93,0:03:39.97,Default,,0,0,0,,ถามเยอะเกินไปแล้ว
Dialogue: 0,0:03:40.10,0:03:41.93,Default,,0,0,0,,ที่นี่มันคือที่ไหน
Dialogue: 0,0:03:43.89,0:03:47.64,Default,,0,0,0,,โทษทีนะ\Nฉันต้องรีบไปต่อเลยหยุดคุยนานไม่ได้
Dialogue: 0,0:03:48.27,0:03:53.11,Default,,0,0,0,,ดินแดนอันกว้างใหญ่ทั้งผืนนี้\Nเป็นของท่านเทพแห่งดวงอาทิตย์
Dialogue: 0,0:03:53.23,0:03:54.53,Default,,0,0,0,,เทพแห่งดวงอาทิตย์เหรอ
Dialogue: 0,0:03:54.65,0:03:55.82,Default,,0,0,0,,เทพงั้นเหรอ
Dialogue: 0,0:03:55.94,0:03:57.24,Default,,0,0,0,,ใช่แล้ว
Dialogue: 0,0:03:57.28,0:04:00.70,Default,,0,0,0,,ท่านเทพแห่งดวงอาทิตย์เป็นผู้สร้างดินแดนแห่งนี้
Dialogue: 0,0:04:00.74,0:04:04.66,Default,,0,0,0,,ท่านทรงเห็นทุกสิ่งทุกอย่างที่เกิดขึ้นที่นี่
Dialogue: 0,0:04:04.79,0:04:07.21,Default,,0,0,0,,โห เก่งมากเลยเหรอ หมอนั่นน่ะ
Dialogue: 0,0:04:07.33,0:04:09.50,Default,,0,0,0,,ก็ต้องเก่งสิ เป็นถึงเทพเลยนะ
Dialogue: 0,0:04:09.92,0:04:12.50,Default,,0,0,0,,นั่นคือพฤกษาโลก อิกดราซิล
Dialogue: 0,0:04:12.84,0:04:17.01,Default,,0,0,0,,ท่านเทพแห่งดวงอาทิตย์สร้าง\Nอาณาจักรนี้ขึ้นมาโดยมีอิกดราซิลเป็นศูนย์กลาง
Dialogue: 0,0:04:17.05,0:04:19.72,Default,,0,0,0,,แล้วส่งเทพมากมายมายังที่นี่
Dialogue: 0,0:04:20.18,0:04:22.60,Default,,0,0,0,,พูดง่ายๆ ที่นี่ก็คืออาณาจักรแห่งทวยเทพ
Dialogue: 0,0:04:23.31,0:04:27.27,Default,,0,0,0,,ประชาชนในอาณาจักรนี้\Nล้วนยำเกรงและเคารพเทพ
Dialogue: 0,0:04:27.39,0:04:28.89,Default,,0,0,0,,อย่างนี้นี่เอง
Dialogue: 0,0:04:28.94,0:04:32.65,Default,,0,0,0,,ถ้านั่นคือความเชื่อของประเทศนี้\Nพวกเราก็ต้องเคารพความเชื่อนั้น
Dialogue: 0,0:04:32.69,0:04:35.23,Default,,0,0,0,,เข้าเมืองตาหลิ่วต้องหลิ่วตาตาม
Dialogue: 0,0:04:35.36,0:04:42.99,Default,,0,0,0,,ข้าคือผู้รับใช้ท่านอิสแคต หนึ่งในทวยเทพ\Nที่เป็นเจ้าของปราสาทบิ๊กสไตน์แห่งนี้
Dialogue: 0,0:04:43.83,0:04:48.21,Default,,0,0,0,,ถ้าพวกเจ้าปรารถนา\Nก็อาจได้เข้าพบท่านในสักวันหนึ่ง
Dialogue: 0,0:04:48.33,0:04:51.00,Default,,0,0,0,,อ้าว มีคนอยู่ในปราสาทด้วยเหรอ
Dialogue: 0,0:04:51.12,0:04:52.54,Default,,0,0,0,,เปล่า เป็นแมวน่ะ
Dialogue: 0,0:04:52.67,0:04:54.00,Default,,0,0,0,,แมวเหรอ
Dialogue: 0,0:04:56.71,0:04:57.61,Default,,0,0,0,,- เอ๊ะ\N- เอ๊ะ
Dialogue: 0,0:04:57.80,0:05:00.05,Default,,0,0,0,,อ๊ะ โทษทีนะ แมวตัวนั้นน่ะ...
Dialogue: 0,0:05:02.26,0:05:04.35,Default,,0,0,0,,เอาละ ข้าขอตัวก่อน
Dialogue: 0,0:05:04.68,0:05:08.64,Default,,0,0,0,,ท่านเทพหนามที่เป็นเม่นคงกำลังท้องหิวอยู่แน่ๆ
Dialogue: 0,0:05:09.43,0:05:10.60,Default,,0,0,0,,เม่นเหรอ
Dialogue: 0,0:05:14.98,0:05:20.24,Default,,0,0,0,,บังเอิญเกิดคดีท่านเทพใบหู\Nที่เป็นกระต่ายยักษ์ถูกเผาตายใกล้ๆ เมือง
Dialogue: 0,0:05:20.28,0:05:22.36,Default,,0,0,0,,ข้าเลยมาช้านิดหน่อย
Dialogue: 0,0:05:22.49,0:05:24.74,Default,,0,0,0,,นั่นน่ะ คือว่าพวกฉัน...
Dialogue: 0,0:05:25.99,0:05:28.62,Default,,0,0,0,,นั่นถือเป็นโชคร้ายจริงๆ เลยนะ
Dialogue: 0,0:05:30.46,0:05:35.21,Default,,0,0,0,,ถ้าพวกเจ้าหิวอยู่ละก็\Nไปรับฟอดเดอร์ในเมืองมากินก็ได้นะ
Dialogue: 0,0:05:35.34,0:05:36.59,Default,,0,0,0,,ฟอดเดอร์เหรอ
Dialogue: 0,0:05:36.71,0:05:38.63,Default,,0,0,0,,มันคืออาหารน่ะ
Dialogue: 0,0:05:38.67,0:05:40.63,Default,,0,0,0,,ของกินเหรอ
Dialogue: 0,0:05:43.39,0:05:45.51,Default,,0,0,0,,แต่ขอเตือนเอาไว้อย่าง
Dialogue: 0,0:05:46.43,0:05:50.35,Default,,0,0,0,,ห้ามไปอีกฟากหนึ่งของปราสาทโดยเด็ดขาด
Dialogue: 0,0:05:50.48,0:05:51.73,Default,,0,0,0,,เอ๊ะ ทำไมล่ะ
Dialogue: 0,0:05:52.27,0:05:54.73,Default,,0,0,0,,ที่นั่นเป็นวิหารของท่านเทพแห่งดวงอาทิตย์
Dialogue: 0,0:05:55.06,0:05:57.77,Default,,0,0,0,,มีทหารที่โหดร้ายคอยคุ้มกันอยู่
Dialogue: 0,0:05:57.82,0:06:01.74,Default,,0,0,0,,ไม่มีใครที่เข้าใกล้วิหาร\Nแล้วรอดกลับมาได้เลยสักคน
Dialogue: 0,0:06:01.74,0:06:02.90,Default,,0,0,0,,เอ๊ะ
Dialogue: 0,0:06:03.53,0:06:05.03,Default,,0,0,0,,เดี๋ยวก่อน อย่าใช้คำพูดแบบนั้น
Dialogue: 0,0:06:11.33,0:06:13.92,Default,,0,0,0,,- รอเดี๋ยว\N- รอเดี๋ยว
Dialogue: 0,0:06:16.13,0:06:16.92,Default,,0,0,0,,หมอนั่น...
Dialogue: 0,0:06:17.04,0:06:19.13,Default,,0,0,0,,ขอตัวก่อนนะคุณลุง\Nขอบคุณสำหรับข้อมูลหลายๆ อย่างนะ
Dialogue: 0,0:06:19.92,0:06:21.59,Default,,0,0,0,,อ้อ แล้วก็...
Dialogue: 0,0:06:22.26,0:06:24.26,Default,,0,0,0,,ขอโทษในหลายๆ เรื่องด้วยนะจ๊ะ
Dialogue: 0,0:06:25.89,0:06:28.64,Default,,0,0,0,,นายนี่เหลือเกินจริงๆ นะลูฟี่
Dialogue: 0,0:06:29.56,0:06:31.43,Default,,0,0,0,,ทหารที่โหดร้ายงั้นเหรอ
Dialogue: 0,0:06:31.56,0:06:34.77,Default,,0,0,0,,ที่ลูฟี่เป็นแบบนั้นก็เพราะนายเป็นแบบนี้ไงล่ะ
Dialogue: 0,0:06:34.81,0:06:35.77,Default,,0,0,0,,หัดสำนึกผิดซะบ้าง
Dialogue: 0,0:06:36.31,0:06:38.23,Default,,0,0,0,,พวกนั้นเป็นใครกันนะ
Dialogue: 0,0:06:41.15,0:06:44.45,Default,,0,0,0,,เอ๊ะ ปราสาทพังไปแล้วเหรอเนี่ย
Dialogue: 0,0:06:49.49,0:06:51.37,Default,,0,0,0,,ได้กลิ่นการผจญภัยลอยมาเลย
Dialogue: 0,0:06:51.83,0:06:53.58,Default,,0,0,0,,ทหารที่โหดร้าย...
Dialogue: 0,0:06:53.62,0:06:55.33,Default,,0,0,0,,เทพงั้นเหรอ
Dialogue: 0,0:06:55.37,0:06:58.38,Default,,0,0,0,,รีบโผล่หัวมาเลยนะ
Dialogue: 0,0:06:58.50,0:06:59.59,Default,,0,0,0,,เขาอยู่นั่น
Dialogue: 0,0:06:59.71,0:07:03.09,Default,,0,0,0,,เดี๋ยวก่อน ลูฟี่\Nคิดถึงคุณนามิบ้างสิ
Dialogue: 0,0:07:03.21,0:07:07.22,Default,,0,0,0,,เปล่าประโยชน์น่า ซันจิคุง\Nลูฟี่ที่เข้าโหมดนั้นไปแล้ว ห้ามเขาไม่ได้หรอก
Dialogue: 0,0:07:07.34,0:07:09.05,Default,,0,0,0,,กว้างจังล่ะ
Dialogue: 0,0:07:09.18,0:07:11.72,Default,,0,0,0,,แถวนี้ไม่มีคนอยู่เลยเหรอเนี่ย
Dialogue: 0,0:07:12.35,0:07:15.94,Default,,0,0,0,,ถนนเส้นนี้ทอดยาวไปถึงไหนกันเนี่ย
Dialogue: 0,0:07:16.06,0:07:17.81,Default,,0,0,0,,ดูปราสาทนั่นสิ
Dialogue: 0,0:07:17.85,0:07:21.07,Default,,0,0,0,,รูปร่างเหมือนกับ\Nปราสาทเมื่อกี้เปี๊ยบเลยไม่ใช่เหรอ
Dialogue: 0,0:07:21.19,0:07:22.53,Default,,0,0,0,,เอ๊ะ
Dialogue: 0,0:07:27.03,0:07:28.78,Default,,0,0,0,,มีใครบางคนกำลังวิ่งมา
Dialogue: 0,0:07:29.37,0:07:31.62,Default,,0,0,0,,หมอนั่นสวมชุดของเอลบัฟด้วย
Dialogue: 0,0:07:32.41,0:07:35.08,Default,,0,0,0,,แต่ก็ช่างเถอะ หลีกให้แล้วไปต่อดีกว่า
Dialogue: 0,0:07:40.88,0:07:42.55,Default,,0,0,0,,อะไรของหมอนั่นเนี่ย
Dialogue: 0,0:07:42.59,0:07:45.01,Default,,0,0,0,,เฮ้ย อันตรายนะ
Dialogue: 0,0:07:45.05,0:07:47.26,Default,,0,0,0,,อย่ามาขวางฉันนะ
Dialogue: 0,0:07:50.76,0:07:51.97,Default,,0,0,0,,ฮะ
Dialogue: 0,0:07:52.10,0:07:54.77,Default,,0,0,0,,- ท้องฟ้าแตกเป็นเสี่ยงๆ\N- ท้องฟ้าแตกเป็นเสี่ยงๆ
Dialogue: 0,0:07:58.40,0:07:59.44,Default,,0,0,0,,เอ๊ะ
Dialogue: 0,0:07:59.56,0:08:02.07,Default,,0,0,0,,อะไรเนี่ย มันเกิดอะไรขึ้น
Dialogue: 0,0:08:05.36,0:08:08.78,Default,,0,0,0,,ดูสิ ท้องฟ้าทางทิศเดียวกับวิหารแตกร้าว
Dialogue: 0,0:08:08.91,0:08:11.62,Default,,0,0,0,,ไม่ใช่แค่นั้น ฝั่งตรงข้ามก็เป็นเหมือนกัน
Dialogue: 0,0:08:12.16,0:08:13.62,Default,,0,0,0,,มันเกิดอะไรขึ้นกันแน่
Dialogue: 0,0:08:13.74,0:08:16.20,Default,,0,0,0,,ทำไมวันนี้อาณาจักรปั่นป่วนขนาดนี้
Dialogue: 0,0:08:26.17,0:08:27.51,Default,,0,0,0,,ท้องฟ้า...
Dialogue: 0,0:08:27.97,0:08:29.51,Default,,0,0,0,,แตกร้าว
Dialogue: 0,0:08:31.05,0:08:34.43,Default,,0,0,0,,นี่คือคำสาปแช่งไม่ผิดแน่ ดินฟ้าอากาศวิปริตไปหมด
Dialogue: 0,0:08:34.47,0:08:38.02,Default,,0,0,0,,เพราะเราฆ่าเทพที่เป็นเม่นหรือแมวอะไรนั่นไปแน่ๆ
Dialogue: 0,0:08:38.06,0:08:40.31,Default,,0,0,0,,เผลอไปทำให้เทพพิโรธเข้าแล้ว
Dialogue: 0,0:08:40.44,0:08:41.35,Default,,0,0,0,,ดูให้ดีๆ ซะ
Dialogue: 0,0:08:57.37,0:08:58.91,Default,,0,0,0,,ฮะ
Dialogue: 0,0:09:03.50,0:09:04.92,Default,,0,0,0,,นี่มัน...
Dialogue: 0,0:09:05.04,0:09:06.88,Default,,0,0,0,,หมายความว่าไง
Dialogue: 0,0:09:12.93,0:09:15.60,Default,,0,0,0,,นี่มันห้องขนาดคนยักษ์ชัดๆ เลย
Dialogue: 0,0:09:15.72,0:09:18.85,Default,,0,0,0,,คงไม่ใช่ข้างในเรือของเอลบัฟหรอกใช่ไหม
Dialogue: 0,0:09:18.98,0:09:21.35,Default,,0,0,0,,ใช่ ในเรือไม่มีห้องแบบนี้หรอก
Dialogue: 0,0:09:21.39,0:09:24.73,Default,,0,0,0,,แล้วอีกอย่าง ตาข่ายเหล็กนี่คืออะไร
Dialogue: 0,0:09:24.86,0:09:27.32,Default,,0,0,0,,ถ้าทางนั้นมีคนยักษ์อยู่ก็แสดงว่า...
Dialogue: 0,0:09:28.82,0:09:33.95,Default,,0,0,0,,พวกเราเป็นเหมือนกับสัตว์เลี้ยง\Nที่ถูกขังเอาไว้ในกรงอันกว้างใหญ่
Dialogue: 0,0:09:34.37,0:09:35.78,Default,,0,0,0,,ไม่จริงน่า
Dialogue: 0,0:09:50.26,0:09:52.18,Default,,0,0,0,,เฮ้
Dialogue: 0,0:09:52.22,0:09:53.84,Default,,0,0,0,,นั่นเสียงอะไรน่ะ
Dialogue: 0,0:09:55.39,0:09:57.14,Default,,0,0,0,,เป็นพวกเดียวกันไหม
Dialogue: 0,0:09:58.18,0:10:00.68,Default,,0,0,0,,ช่วยฉันที
Dialogue: 0,0:10:40.14,0:10:42.10,Default,,0,0,0,,โอ๊ะ สูงโพด
Dialogue: 0,0:10:42.23,0:10:43.52,Default,,0,0,0,,ฮึบ
Dialogue: 0,0:10:43.98,0:10:46.44,Default,,0,0,0,,เฮ้ อยู่ไหนน่ะ
Dialogue: 0,0:10:46.56,0:10:48.27,Default,,0,0,0,,เฮ้
Dialogue: 0,0:10:50.02,0:10:52.07,Default,,0,0,0,,ทางนี้
Dialogue: 0,0:10:59.91,0:11:01.29,Default,,0,0,0,,ช็อปเปอร์
Dialogue: 0,0:11:01.41,0:11:05.29,Default,,0,0,0,,ทุกคน ค่อยยังชั่วหน่อย
Dialogue: 0,0:11:08.21,0:11:09.96,Default,,0,0,0,,ปลอกคอนั่นมันอะไรน่ะช็อปเปอร์
Dialogue: 0,0:11:10.71,0:11:15.55,Default,,0,0,0,,ไม่รู้สิ พอตื่นมาก็ถูกใส่ไว้แล้ว\Nแถมยังมาอยู่ที่ไหนก็ไม่รู้
Dialogue: 0,0:11:15.59,0:11:19.10,Default,,0,0,0,,เหล็กที่ทำปลอกคอก็แข็งซะจนถอดไม่ออกด้วย
Dialogue: 0,0:11:19.55,0:11:22.56,Default,,0,0,0,,นึกว่าจะตายแล้วซะอีก
Dialogue: 0,0:11:22.68,0:11:23.81,Default,,0,0,0,,อย่าขยับนะ
Dialogue: 0,0:11:25.06,0:11:26.29,Default,,0,0,0,,จะฟันปลอกคอให้
Dialogue: 0,0:11:26.35,0:11:27.27,Default,,0,0,0,,น่ากลัวเหวย
Dialogue: 0,0:11:28.27,0:11:30.06,Default,,0,0,0,,ถ้าระดับนี้ละก็
Dialogue: 0,0:11:31.52,0:11:32.57,Default,,0,0,0,,ของกล้วยๆ
Dialogue: 0,0:11:32.69,0:11:35.15,Default,,0,0,0,,โอ้ สมแล้วที่เป็นแมวขโมย
Dialogue: 0,0:11:39.91,0:11:41.87,Default,,0,0,0,,ขอบใจนะ นามี้
Dialogue: 0,0:11:41.99,0:11:44.16,Default,,0,0,0,,น่าสงสารจังเลย ช็อปเปอร์
Dialogue: 0,0:11:44.20,0:11:45.87,Default,,0,0,0,,ไม่เป็นไรแล้วจ้ะ
Dialogue: 0,0:11:45.91,0:11:47.46,Default,,0,0,0,,ติดหนี้ฉันครั้งนึงแล้วนะ
Dialogue: 0,0:11:47.48,0:11:48.21,Default,,0,0,0,,เอ๊ะ
Dialogue: 0,0:11:48.33,0:11:50.68,Default,,0,0,0,,เธอก็ร้องไห้แทบเป็นแทบตายไม่ใช่เรอะ
Dialogue: 0,0:11:50.69,0:11:51.63,Default,,0,0,0,,เรื่องนั้นก็ส่วนเรื่องนั้นสิ
Dialogue: 0,0:11:54.51,0:11:56.17,Default,,0,0,0,,ในห้องของคนยักษ์
Dialogue: 0,0:11:56.93,0:11:58.89,Default,,0,0,0,,มีเสื้อผ้าไซซ์มนุษย์ด้วย
Dialogue: 0,0:11:59.34,0:12:01.85,Default,,0,0,0,,ถูกมองว่าเป็นตุ๊กตาเปลี่ยนชุดรึไง
Dialogue: 0,0:12:01.97,0:12:05.60,Default,,0,0,0,,แต่การที่คนยักษ์ทำของพวกนี้ได้
Dialogue: 0,0:12:05.64,0:12:09.73,Default,,0,0,0,,ก็แปลว่าเป็นคนที่ช่ำชอง\Nและละเอียดอ่อนมากเลยสินะ เทพตะวันน่ะ
Dialogue: 0,0:12:19.41,0:12:21.12,Default,,0,0,0,,ทำอะไรอยู่น่ะ
Dialogue: 0,0:12:22.99,0:12:24.79,Default,,0,0,0,,ดูสิ ซันจิ
Dialogue: 0,0:12:24.83,0:12:26.70,Default,,0,0,0,,ตัวต่อเต็มไปหมดเลย
Dialogue: 0,0:12:28.46,0:12:29.75,Default,,0,0,0,,นั่นสินะ
Dialogue: 0,0:12:29.79,0:12:31.67,Default,,0,0,0,,ทั่วทั้งอาณาจักรถูกสร้างมาจากเจ้านั่น
Dialogue: 0,0:12:32.38,0:12:34.75,Default,,0,0,0,,ที่ตอนย่างกระต่ายมีกลิ่นแรง
Dialogue: 0,0:12:34.80,0:12:37.76,Default,,0,0,0,,ก็เพราะไหม้ไปพร้อมเรซินสังเคราะห์ละมั้ง
Dialogue: 0,0:12:37.80,0:12:40.55,Default,,0,0,0,,แล้วก็นายไปชนท้องฟ้าเข้าใช่ไหมล่ะ
Dialogue: 0,0:12:41.51,0:12:44.18,Default,,0,0,0,,ไอ้ที่ดูเหมือนเส้นทางมันทอดยาวไปเรื่อยๆ น่ะ
Dialogue: 0,0:12:44.93,0:12:46.60,Default,,0,0,0,,นั่นคือกระจกไงล่ะ
Dialogue: 0,0:12:46.72,0:12:47.89,Default,,0,0,0,,กระจก
Dialogue: 0,0:12:48.31,0:12:51.15,Default,,0,0,0,,ถ้างั้นเจ้าคนเมื่อกี้คือฉันเองงั้นเหรอ
Dialogue: 0,0:12:51.27,0:12:52.40,Default,,0,0,0,,อืม
Dialogue: 0,0:12:52.98,0:12:53.69,Default,,0,0,0,,ดูเอาสิ
Dialogue: 0,0:12:57.82,0:12:59.49,Default,,0,0,0,,อ๊ะ มองทะลุได้ด้วย
Dialogue: 0,0:12:59.61,0:13:02.41,Default,,0,0,0,,แต่ถ้ามองจากฝั่งนี้จะเป็นกระจกธรรมดา
Dialogue: 0,0:13:02.82,0:13:05.87,Default,,0,0,0,,มีกระจกที่เหมือนเวทมนตร์แบบนี้อยู่ด้วยเหรอ
Dialogue: 0,0:13:09.12,0:13:10.08,Default,,0,0,0,,คุณนามิ
Dialogue: 0,0:13:10.79,0:13:13.29,Default,,0,0,0,,คราวหน้าขอผม\Nทำความสะอาดห้องผู้หญิงหน่อยเถอะ
Dialogue: 0,0:13:13.54,0:13:15.04,Default,,0,0,0,,ไม่ต้องเอามาติดเลยย่ะ
Dialogue: 0,0:13:15.67,0:13:19.97,Default,,0,0,0,,สรุปคือ มนุษย์กับสัตว์ถูกจับมาปล่อยไว้เลี้ยงดูเล่น
Dialogue: 0,0:13:20.01,0:13:23.51,Default,,0,0,0,,ในอาณาจักรตัวต่อ\Nที่คนยักษ์รสนิยมแย่สร้างขึ้นมาสินะ
Dialogue: 0,0:13:23.64,0:13:25.14,Default,,0,0,0,,ถึงจะรสนิยมแย่
Dialogue: 0,0:13:25.56,0:13:28.18,Default,,0,0,0,,แต่งั้นก็แปลว่าเราอยู่ในเอลบัฟแล้วงั้นเหรอ
Dialogue: 0,0:13:28.22,0:13:31.06,Default,,0,0,0,,ในบ้านของคนยักษ์ที่อาณาจักรคนยักษ์เนี่ย
Dialogue: 0,0:13:34.27,0:13:35.86,Default,,0,0,0,,ใช่จริงๆ ด้วยสินะ
Dialogue: 0,0:13:37.36,0:13:39.28,Default,,0,0,0,,สำเร็จแล้ว
Dialogue: 0,0:13:41.45,0:13:43.40,Default,,0,0,0,,ยังไม่แน่ว่าจะใช่นะ
Dialogue: 0,0:13:43.61,0:13:47.58,Default,,0,0,0,,เรื่องที่แน่นอนมีแค่\Nเจ้าของบ้านหลังนี้คือคนยักษ์เท่านั้นเอง
Dialogue: 0,0:13:47.70,0:13:49.66,Default,,0,0,0,,ต้องลองออกไปข้างนอกสินะ
Dialogue: 0,0:13:49.70,0:13:51.29,Default,,0,0,0,,แล้วคนอื่นๆ ล่ะ
Dialogue: 0,0:13:51.33,0:13:53.42,Default,,0,0,0,,รีบหนีก่อนที่คนยักษ์จะกลับมาเถอะ
Dialogue: 0,0:13:53.54,0:13:57.05,Default,,0,0,0,,มีแต่ต้องกลับไปที่เมืองแล้วหาข้อมูลจริงๆ สินะ
Dialogue: 0,0:13:59.05,0:14:03.68,Default,,0,0,0,,ไม่ว่าจะเป็นคนพิลึกขนาดไหน\Nก็เลี่ยงความขังแย้งกับเผ่าคนยักษ์ไว้ก่อนดีกว่า
Dialogue: 0,0:14:04.01,0:14:05.68,Default,,0,0,0,,เฮ้ ลูฟี่ เข้าใจรึเปล่า
Dialogue: 0,0:14:06.10,0:14:07.93,Default,,0,0,0,,อย่าอาละวาดไปมากกว่านี้...
Dialogue: 0,0:14:10.52,0:14:12.73,Default,,0,0,0,,ขอซัดแค่เจ้านี่ให้กระเด็นได้มะ
Dialogue: 0,0:14:15.23,0:14:16.90,Default,,0,0,0,,ซัดได้เลยจ้า
Dialogue: 0,0:14:19.82,0:14:20.69,Default,,0,0,0,,ดูข้างล่างสิ
Dialogue: 0,0:14:20.74,0:14:22.15,Default,,0,0,0,,หนู
Dialogue: 0,0:14:22.20,0:14:23.11,Default,,0,0,0,,เอ๊ะ
Dialogue: 0,0:14:23.82,0:14:25.70,Default,,0,0,0,,เอ๊ะ เดี๋ยวๆ ๆ
Dialogue: 0,0:14:25.74,0:14:28.54,Default,,0,0,0,,ไม่นะ มันกำลังปีนขึ้นมา
Dialogue: 0,0:14:31.66,0:14:33.00,Default,,0,0,0,,ข้างบนมีอีกา
Dialogue: 0,0:14:34.88,0:14:36.57,Default,,0,0,0,,มาแล้ว
Dialogue: 0,0:14:37.04,0:14:40.09,Default,,0,0,0,,เจ้าพวกนี้คือทหารของวิหารเหรอ
Dialogue: 0,0:14:40.42,0:14:43.42,Default,,0,0,0,,ที่ว่าไม่มีใครรอดชีวิตกลับไปคือแบบนี้เองสินะ
Dialogue: 0,0:14:43.55,0:14:47.01,Default,,0,0,0,,ที่นี่มันเป็นวิหารตรงไหนไม่เห็นเข้าใจเลย
Dialogue: 0,0:14:47.14,0:14:49.26,Default,,0,0,0,,ไหนๆ ก็กินกระต่ายไปแล้ว
Dialogue: 0,0:14:49.76,0:14:52.30,Default,,0,0,0,,งั้นเชิญซัดสัตว์พวกนี้ไปเลยละกัน
Dialogue: 0,0:15:19.96,0:15:21.67,Default,,0,0,0,,ลงมือให้จบในทีเดียวเลยเหอะ
Dialogue: 0,0:15:21.71,0:15:23.92,Default,,0,0,0,,ไม่งั้นเดี๋ยวเทพตะวันจะกลับมาซะก่อน
Dialogue: 0,0:15:26.68,0:15:28.93,Default,,0,0,0,,ดีละ ถ้างั้นก็
Dialogue: 0,0:15:45.07,0:15:46.90,Default,,0,0,0,,เกียร์ ฟิฟธ์
Dialogue: 0,0:16:39.17,0:16:41.33,Default,,0,0,0,,เดี๋ยว รอก่อน เจ้าพวกหนูทั้งหลาย
Dialogue: 0,0:16:55.97,0:16:57.60,Default,,0,0,0,,ก็บอกว่าให้
Dialogue: 0,0:16:58.43,0:16:59.85,Default,,0,0,0,,รอก่อนไงเล่า
Dialogue: 0,0:17:12.70,0:17:14.78,Default,,0,0,0,,ช็อปเปอร์ ไปตรงโน้นไหวไหม
Dialogue: 0,0:17:16.74,0:17:19.33,Default,,0,0,0,,เข้าใจแล้ว มีอะไรเหรอ
Dialogue: 0,0:17:20.75,0:17:22.29,Default,,0,0,0,,ได้กลิ่นสมบัติน่ะ
Dialogue: 0,0:17:40.31,0:17:41.44,Default,,0,0,0,,เอ๋
Dialogue: 0,0:17:49.57,0:17:52.11,Default,,0,0,0,,ร้อน ฝีมือใครฟะ
Dialogue: 0,0:17:52.15,0:17:53.98,Default,,0,0,0,,ลูฟี่ ทำเกินไปแล้วนะ
Dialogue: 0,0:17:54.01,0:17:57.03,Default,,0,0,0,,ไม่ใช่ฉันซะหน่อย ไฟลามมาจากเตาผิงต่างหาก
Dialogue: 0,0:17:57.16,0:17:57.88,Default,,0,0,0,,หา
Dialogue: 0,0:18:08.30,0:18:10.51,Default,,0,0,0,,เอ๋
Dialogue: 0,0:18:12.88,0:18:14.22,Default,,0,0,0,,นั่นน่ะเหรอเทพตะวัน
Dialogue: 0,0:18:17.60,0:18:21.14,Default,,0,0,0,,วิหารของข้าน้อย
Dialogue: 0,0:18:22.31,0:18:23.56,Default,,0,0,0,,เฮ้ ลูฟี่
Dialogue: 0,0:18:23.60,0:18:25.98,Default,,0,0,0,,เทพตะวันกลับมาแล้ว
Dialogue: 0,0:18:26.02,0:18:27.32,Default,,0,0,0,,หนีเร็ว
Dialogue: 0,0:18:27.82,0:18:28.65,Default,,0,0,0,,โอ้
Dialogue: 0,0:18:29.48,0:18:30.74,Default,,0,0,0,,ไปเดี๋ยวนี้ละ
Dialogue: 0,0:18:36.95,0:18:38.99,Default,,0,0,0,,ทางนี้ก็เรียบร้อยแล้ว
Dialogue: 0,0:18:48.13,0:18:49.34,Default,,0,0,0,,มูกินน์
Dialogue: 0,0:18:54.38,0:18:56.76,Default,,0,0,0,,หมัดปืน
Dialogue: 0,0:18:57.60,0:18:59.35,Default,,0,0,0,,ขาว
Dialogue: 0,0:18:59.76,0:19:02.14,Default,,0,0,0,,ยางยืด
Dialogue: 0,0:19:08.98,0:19:10.52,Default,,0,0,0,,ฮิลมุนกานด์
Dialogue: 0,0:19:11.03,0:19:12.23,Default,,0,0,0,,ต้องรีบแล้ว
Dialogue: 0,0:19:13.32,0:19:14.53,Default,,0,0,0,,นี่มัน
Dialogue: 0,0:19:14.65,0:19:15.74,Default,,0,0,0,,ไปกันเถอะ นามิ
Dialogue: 0,0:19:15.86,0:19:16.66,Default,,0,0,0,,อื้ม
Dialogue: 0,0:19:21.62,0:19:22.50,Default,,0,0,0,,อุซป
Dialogue: 0,0:19:22.62,0:19:23.70,Default,,0,0,0,,โอ้
Dialogue: 0,0:19:24.04,0:19:25.29,Default,,0,0,0,,เร็วเข้าลูฟี่
Dialogue: 0,0:19:38.01,0:19:39.97,Default,,0,0,0,,ยอมไม่ได้แล้ว
Dialogue: 0,0:19:40.89,0:19:42.72,Default,,0,0,0,,ตัวโตเป็นบ้าเลยแฮะ เจ้าคนยักษ์นั่นน่ะ
Dialogue: 0,0:19:42.85,0:19:45.31,Default,,0,0,0,,อืม ดูยังไงก็น่าสงสัย
Dialogue: 0,0:19:46.64,0:19:47.73,Default,,0,0,0,,ดูสิ
Dialogue: 0,0:20:10.79,0:20:11.79,Default,,0,0,0,,อะไรน่ะ
Dialogue: 0,0:20:11.92,0:20:13.92,Default,,0,0,0,,มันบอกว่า 'จำไว้เลยนะ' น่ะ
Dialogue: 0,0:20:14.05,0:20:15.01,Default,,0,0,0,,รับทราบ
Dialogue: 0,0:20:15.42,0:20:16.67,Default,,0,0,0,,ที่สำคัญกว่านั้น ดูนี่สิ
Dialogue: 0,0:20:16.72,0:20:19.21,Default,,0,0,0,,ถึงจะไม่เจอของที่มีค่า แต่ว่า...
Dialogue: 0,0:20:20.18,0:20:22.56,Default,,0,0,0,,พิมพ์เขียวของอาณาจักรตัวต่อสินะ
Dialogue: 0,0:20:22.68,0:20:24.39,Default,,0,0,0,,สรุปคือ แผนที่
Dialogue: 0,0:20:24.52,0:20:25.85,Default,,0,0,0,,ตามนั้นแหละ
Dialogue: 0,0:20:26.35,0:20:27.95,Default,,0,0,0,,ทำได้ดีมากนามิ
Dialogue: 0,0:20:27.98,0:20:29.60,Default,,0,0,0,,สมแล้วที่เป็นคุณนามิ
Dialogue: 0,0:20:29.73,0:20:30.52,Default,,0,0,0,,มาแล้ว
Dialogue: 0,0:20:39.24,0:20:41.16,Default,,0,0,0,,บังอาจ
Dialogue: 0,0:20:41.66,0:20:45.12,Default,,0,0,0,,บังอาจมาทำอาณาจักรของข้าน้อย
Dialogue: 0,0:20:46.25,0:20:48.08,Default,,0,0,0,,พวกนายเตรียมตัวไว้
Dialogue: 0,0:20:48.66,0:20:53.88,Default,,0,0,0,,ถ้าวิ่งตรงผ่านแดนรกร้างแล้วข้ามปราสาทไป\Nก็จะเจอกระจกอีก
Dialogue: 0,0:20:53.92,0:20:56.34,Default,,0,0,0,,ถ้าทำลายกระจกนั่นไปพร้อมกับกำแพงชั้นนอกละก็
Dialogue: 0,0:20:56.38,0:20:57.84,Default,,0,0,0,,เราจะออกไปได้
Dialogue: 0,0:21:01.51,0:21:03.18,Default,,0,0,0,,ดีละ พวกนาย
Dialogue: 0,0:21:04.72,0:21:06.64,Default,,0,0,0,,หนีออกไปกันเถอะ
Dialogue: 0,0:21:09.98,0:21:12.27,Default,,0,0,0,,นี่มัน แผ่นดินสะเทือน
Dialogue: 0,0:21:13.44,0:21:15.65,Default,,0,0,0,,ท่านเทพตะวัน
Dialogue: 0,0:21:15.69,0:21:17.28,Default,,0,0,0,,พิโรธแล้ว
Dialogue: 0,0:21:21.24,0:21:24.24,Default,,0,0,0,,ไม่ยอมให้หนีหรอก
Dialogue: 0,0:21:24.61,0:21:30.60,Default,,0,0,0,,(โปรดติดตามตอนต่อไป)
Dialogue: 0,0:23:05.88,0:23:08.68,Default,,0,0,0,,การเล่นไล่จับอันสุดขั้ว\Nที่เกิดขึ้นในอาณาจักรตัวต่อ
Dialogue: 0,0:23:09.14,0:23:14.18,Default,,0,0,0,,ตัวจริงอันเป็นปริศนาของเทพตะวัน\Nที่พยายามจับตัวพวกลูฟี่คือ...
