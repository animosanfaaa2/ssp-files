Dialogue: 0,0:01:48.11,0:01:50.36,Default,,0,0,0,,Hei, jangan jalan duluan.
Dialogue: 0,0:01:50.36,0:01:52.36,Default,,0,0,0,,Nanti kau tersesat lagi.
Dialogue: 0,0:01:52.36,0:01:54.74,Default,,0,0,0,,Mana mungkin tersesat\Nkalau pandanganku jelas?
Dialogue: 0,0:01:55.32,0:01:57.16,Default,,0,0,0,,Ya, ya.
Dialogue: 0,0:01:57.16,0:01:59.87,Default,,0,0,0,,Eh, menurutmu makhluk tadi jenis apa, ya?
Dialogue: 0,0:01:59.87,0:02:02.16,Default,,0,0,0,,Singanya berubah jadi kucing, lo.
Dialogue: 0,0:02:02.16,0:02:05.29,Default,,0,0,0,,Tidak, kucing yang berubah jadi singa.
Dialogue: 0,0:02:05.29,0:02:06.88,Default,,0,0,0,,Aslinya memang kucing.
Dialogue: 0,0:02:06.88,0:02:07.96,Default,,0,0,0,,Itu singa.
Dialogue: 0,0:02:07.96,0:02:08.84,Default,,0,0,0,,Kucing.
Dialogue: 0,0:02:08.84,0:02:09.59,Default,,0,0,0,,Singa!
Dialogue: 0,0:02:09.59,0:02:10.38,Default,,0,0,0,,Kucing!
Dialogue: 0,0:02:10.38,0:02:12.84,Default,,0,0,0,,Mau yang mana pun, siapa yang peduli?
Dialogue: 0,0:02:12.84,0:02:14.97,Default,,0,0,0,,Semua makhluk itu besar sekali.
Dialogue: 0,0:02:14.97,0:02:16.78,Default,,0,0,0,,Apa masih ada kelinci lagi di sekitar sini?
Dialogue: 0,0:02:18.97,0:02:20.43,Default,,0,0,0,,Ada yang datang.
Dialogue: 0,0:02:20.43,0:02:21.77,Default,,0,0,0,,Eh? Apa itu?
Dialogue: 0,0:02:21.77,0:02:23.73,Default,,0,0,0,,Nami, berlindunglah di belakangku.
Dialogue: 0,0:02:28.11,0:02:28.83,Default,,0,0,0,,Eh?
Dialogue: 0,0:02:39.66,0:02:41.05,Default,,0,0,0,,Apa itu?
Dialogue: 0,0:02:45.16,0:02:47.69,Default,,0,0,0,,PENCARIAN DI NEGERI MISTERIUS!\NRAHASIA DEWA MATAHARI
Dialogue: 0,0:02:47.75,0:02:53.17,Default,,0,0,0,,"Pencarian di Negeri Misterius!\NRahasia Dewa Matahari".
Dialogue: 0,0:03:11.08,0:03:12.73,Default,,0,0,0,,Wah, wah.
Dialogue: 0,0:03:16.57,0:03:18.55,Default,,0,0,0,,Oh, keren sekali!
Dialogue: 0,0:03:21.74,0:03:23.12,Default,,0,0,0,,Ada serangga!
Dialogue: 0,0:03:23.12,0:03:25.10,Default,,0,0,0,,Aku benci serangga besar!
Dialogue: 0,0:03:25.46,0:03:26.92,Default,,0,0,0,,Itu belalang.
Dialogue: 0,0:03:26.92,0:03:28.39,Default,,0,0,0,,Bagaimana bisa begitu?
Dialogue: 0,0:03:28.88,0:03:31.60,Default,,0,0,0,,Apa kalian orang baru di sini?
Dialogue: 0,0:03:31.60,0:03:33.13,Default,,0,0,0,,Kau siapa, Pak Tua?
Dialogue: 0,0:03:33.13,0:03:34.09,Default,,0,0,0,,Kita ada di mana?
Dialogue: 0,0:03:34.09,0:03:35.59,Default,,0,0,0,,Kau melihat kru kami?
Dialogue: 0,0:03:35.59,0:03:37.09,Default,,0,0,0,,Boleh aku menungganginya?
Dialogue: 0,0:03:37.09,0:03:37.93,Default,,0,0,0,,- Kruku wajahnya begini.\N- Berapa tarifnya?
Dialogue: 0,0:03:37.93,0:03:40.07,Default,,0,0,0,,Pertanyaan kalian terlalu banyak.
Dialogue: 0,0:03:40.07,0:03:42.03,Default,,0,0,0,,Tempat apa ini?
Dialogue: 0,0:03:43.89,0:03:47.74,Default,,0,0,0,,Maaf, aku sedang buru-buru,\Njadi tak bisa mengobrol lama, tapi...
Dialogue: 0,0:03:48.27,0:03:53.23,Default,,0,0,0,,tanah luas ini milik Dewa Matahari.
Dialogue: 0,0:03:53.23,0:03:54.65,Default,,0,0,0,,Dewa Matahari?
Dialogue: 0,0:03:54.65,0:03:55.94,Default,,0,0,0,,Dewa?
Dialogue: 0,0:03:55.94,0:03:57.28,Default,,0,0,0,,Benar.
Dialogue: 0,0:03:57.28,0:04:00.74,Default,,0,0,0,,Dewa Matahari menciptakan tanah ini
Dialogue: 0,0:04:00.74,0:04:04.76,Default,,0,0,0,,dan melihat semua yang terjadi di sini.
Dialogue: 0,0:04:04.76,0:04:07.33,Default,,0,0,0,,Wah, apa dia kuat?
Dialogue: 0,0:04:07.33,0:04:09.60,Default,,0,0,0,,Tentu saja. Dia itu Dewa, lo.
Dialogue: 0,0:04:09.92,0:04:12.50,Default,,0,0,0,,Itu Yggdrasil, Pohon Dunia.
Dialogue: 0,0:04:12.84,0:04:17.05,Default,,0,0,0,,Dewa Matahari menciptakan tanah ini\Ndengan Yggdrasil sebagai pusatnya
Dialogue: 0,0:04:17.05,0:04:19.82,Default,,0,0,0,,dan mengutus banyak Dewa.
Dialogue: 0,0:04:20.18,0:04:22.70,Default,,0,0,0,,Bisa dibilang, ini Negeri Para Dewa.
Dialogue: 0,0:04:23.31,0:04:27.39,Default,,0,0,0,,Semua orang di sini\Nsangat menghormati para Dewa.
Dialogue: 0,0:04:27.39,0:04:28.94,Default,,0,0,0,,Begitu, ya.
Dialogue: 0,0:04:28.94,0:04:32.69,Default,,0,0,0,,Kalau itu kepercayaan di sini,\Nkita harus menghormatinya.
Dialogue: 0,0:04:32.69,0:04:35.33,Default,,0,0,0,,Kita harus ikuti adat setempat.
Dialogue: 0,0:04:35.33,0:04:40.78,Default,,0,0,0,,Aku melayani penguasa Kastel Bigstein\Ndan salah satu Dewa,
Dialogue: 0,0:04:40.78,0:04:43.09,Default,,0,0,0,,Tuan Iscat.
Dialogue: 0,0:04:43.83,0:04:48.33,Default,,0,0,0,,Jika kalian mau,\Nsuatu hari nanti bisa menemuinya.
Dialogue: 0,0:04:48.33,0:04:51.12,Default,,0,0,0,,Eh? Apa ada orang di kastel itu?
Dialogue: 0,0:04:51.12,0:04:52.64,Default,,0,0,0,,Bukan, itu kucing.
Dialogue: 0,0:04:52.64,0:04:54.10,Default,,0,0,0,,Kucing?
Dialogue: 0,0:04:57.77,0:05:00.05,Default,,0,0,0,,Oh, maaf. Kucing itu baru saja...
Dialogue: 0,0:05:02.26,0:05:04.35,Default,,0,0,0,,Kalau begitu, aku permisi dulu.
Dialogue: 0,0:05:04.68,0:05:08.74,Default,,0,0,0,,Dewa Jarum si Landak pasti sudah kelaparan.
Dialogue: 0,0:05:09.43,0:05:10.70,Default,,0,0,0,,Landak?
Dialogue: 0,0:05:14.98,0:05:20.28,Default,,0,0,0,,Dewa Telinga Panjang si kelinci raksasa\Ntewas dalam kebakaran di dekat kota
Dialogue: 0,0:05:20.28,0:05:22.46,Default,,0,0,0,,dan itu sedikit menghambatku.
Dialogue: 0,0:05:22.46,0:05:24.74,Default,,0,0,0,,Kami yang...
Dialogue: 0,0:05:25.99,0:05:28.72,Default,,0,0,0,,Sungguh tragedi yang mengerikan.
Dialogue: 0,0:05:30.46,0:05:35.34,Default,,0,0,0,,Kalau lapar, pergilah ke kota\Nuntuk mencari Fodder.
Dialogue: 0,0:05:35.34,0:05:36.71,Default,,0,0,0,,Fodder?
Dialogue: 0,0:05:36.71,0:05:38.63,Default,,0,0,0,,Maksudnya makanan.
Dialogue: 0,0:05:43.36,0:05:45.61,Default,,0,0,0,,Sebagai peringatan, aku harus beri tahu.
Dialogue: 0,0:05:46.43,0:05:50.48,Default,,0,0,0,,Jangan sekali pun\Nmemasuki sisi seberang kastel.
Dialogue: 0,0:05:50.48,0:05:51.83,Default,,0,0,0,,Apa? Kenapa?
Dialogue: 0,0:05:52.27,0:05:54.73,Default,,0,0,0,,Di sana ada Kuil Dewa Matahari
Dialogue: 0,0:05:55.06,0:05:57.79,Default,,0,0,0,,yang dijaga oleh Prajurit Buas.
Dialogue: 0,0:05:57.79,0:06:01.74,Default,,0,0,0,,Tak ada yang kembali hidup-hidup\Nsetelah mendekatinya.
Dialogue: 0,0:06:03.53,0:06:05.13,Default,,0,0,0,,Jangan bicara seperti itu!
Dialogue: 0,0:06:11.33,0:06:14.02,Default,,0,0,0,,Tunggu!
Dialogue: 0,0:06:16.13,0:06:17.04,Default,,0,0,0,,Dia malah...
Dialogue: 0,0:06:17.04,0:06:19.13,Default,,0,0,0,,Baiklah, Pak Tua.\NTerima kasih untuk semuanya.
Dialogue: 0,0:06:19.92,0:06:21.69,Default,,0,0,0,,Oh, ya, dan...
Dialogue: 0,0:06:22.26,0:06:24.36,Default,,0,0,0,,maaf untuk semuanya.
Dialogue: 0,0:06:25.86,0:06:28.64,Default,,0,0,0,,Astaga, si Luffy...
Dialogue: 0,0:06:29.56,0:06:31.56,Default,,0,0,0,,Prajurit Buas, ya?
Dialogue: 0,0:06:31.56,0:06:34.81,Default,,0,0,0,,Luffy jadi begitu karena kau juga begitu.
Dialogue: 0,0:06:34.81,0:06:35.87,Default,,0,0,0,,Kau harusnya malu.
Dialogue: 0,0:06:36.31,0:06:38.23,Default,,0,0,0,,Siapa mereka?
Dialogue: 0,0:06:41.15,0:06:44.55,Default,,0,0,0,,Eh? Kastelnya runtuh?
Dialogue: 0,0:06:49.49,0:06:51.47,Default,,0,0,0,,Aku mencium bau petualangan.
Dialogue: 0,0:06:51.83,0:06:53.62,Default,,0,0,0,,Prajurit Buas?
Dialogue: 0,0:06:53.62,0:06:55.37,Default,,0,0,0,,Dewa?
Dialogue: 0,0:06:55.37,0:06:58.50,Default,,0,0,0,,Cepat tunjukkan diri kalian!
Dialogue: 0,0:06:58.50,0:06:59.71,Default,,0,0,0,,Itu dia!
Dialogue: 0,0:06:59.71,0:07:03.21,Default,,0,0,0,,Tunggu, Luffy! Pikirkan Nami!
Dialogue: 0,0:07:03.21,0:07:07.34,Default,,0,0,0,,Percuma, Sanji.\NLuffy takkan bisa dihentikan sekarang.
Dialogue: 0,0:07:07.34,0:07:09.15,Default,,0,0,0,,Tempat ini luas sekali.
Dialogue: 0,0:07:09.15,0:07:11.72,Default,,0,0,0,,Tak ada rumah di sekitar sini.
Dialogue: 0,0:07:12.35,0:07:16.06,Default,,0,0,0,,Apa jalan ini ada ujungnya?
Dialogue: 0,0:07:16.06,0:07:17.85,Default,,0,0,0,,Lihat kastel itu.
Dialogue: 0,0:07:17.85,0:07:21.19,Default,,0,0,0,,Bentuknya sama persis\Ndengan yang baru saja kita lihat, 'kan?
Dialogue: 0,0:07:21.19,0:07:22.63,Default,,0,0,0,,Eh?
Dialogue: 0,0:07:27.03,0:07:28.78,Default,,0,0,0,,Ada yang berlari ke arah sini.
Dialogue: 0,0:07:29.37,0:07:31.62,Default,,0,0,0,,Dia juga pakai baju Elbaph.
Dialogue: 0,0:07:32.51,0:07:35.01,Default,,0,0,0,,Ya sudahlah.\NAyo hindari dia dan lanjut jalan.
Dialogue: 0,0:07:40.85,0:07:42.59,Default,,0,0,0,,Apa yang dia lakukan?
Dialogue: 0,0:07:42.59,0:07:45.02,Default,,0,0,0,,Hei, awas!
Dialogue: 0,0:07:45.02,0:07:47.26,Default,,0,0,0,,Minggir!
Dialogue: 0,0:07:50.76,0:07:52.07,Default,,0,0,0,,Hah?
Dialogue: 0,0:07:52.07,0:07:54.77,Default,,0,0,0,,Langitnya retak?
Dialogue: 0,0:07:58.37,0:07:59.56,Default,,0,0,0,,Eh?
Dialogue: 0,0:07:59.56,0:08:02.07,Default,,0,0,0,,Apa-apaan? Bagaimana bisa?
Dialogue: 0,0:08:05.36,0:08:08.91,Default,,0,0,0,,Lihat, langit di atas kuil retak.
Dialogue: 0,0:08:08.91,0:08:11.72,Default,,0,0,0,,Tunggu, sisi yang lain juga.
Dialogue: 0,0:08:12.16,0:08:13.74,Default,,0,0,0,,Apa yang terjadi?
Dialogue: 0,0:08:13.74,0:08:16.30,Default,,0,0,0,,Banyak sekali kejadian\Ndi kerajaan hari ini.
Dialogue: 0,0:08:26.17,0:08:27.51,Default,,0,0,0,,Langitnya
Dialogue: 0,0:08:27.97,0:08:29.51,Default,,0,0,0,,hancur?
Dialogue: 0,0:08:31.05,0:08:34.47,Default,,0,0,0,,Aku yakin ini kutukan, hukuman Dewa!
Dialogue: 0,0:08:34.47,0:08:38.05,Default,,0,0,0,,Landak dan kucing yang kita kalahkan\Nitu dewa, 'kan?
Dialogue: 0,0:08:38.05,0:08:40.44,Default,,0,0,0,,Kita pasti memancing amarah mereka.
Dialogue: 0,0:08:40.44,0:08:41.45,Default,,0,0,0,,Lihat baik-baik.
Dialogue: 0,0:08:57.37,0:08:58.91,Default,,0,0,0,,Hah?
Dialogue: 0,0:09:03.50,0:09:05.04,Default,,0,0,0,,Berarti...
Dialogue: 0,0:09:05.04,0:09:06.88,Default,,0,0,0,,Apa maksudnya?
Dialogue: 0,0:09:12.90,0:09:15.72,Default,,0,0,0,,Ini jelas ruangan untuk Raksasa.
Dialogue: 0,0:09:15.72,0:09:18.98,Default,,0,0,0,,Tak mungkin ini di dalam kapal Elbaph.
Dialogue: 0,0:09:18.98,0:09:21.39,Default,,0,0,0,,Ya, aku tak pernah melihat\Nruangan seperti ini.
Dialogue: 0,0:09:21.39,0:09:24.83,Default,,0,0,0,,Lagi pula, pagar logam apa ini?
Dialogue: 0,0:09:24.83,0:09:27.32,Default,,0,0,0,,Kalau ada Raksasa di sisi lain,
Dialogue: 0,0:09:28.79,0:09:33.95,Default,,0,0,0,,kita seperti hewan peliharaan\Nyang dikurung di kandang luas.
Dialogue: 0,0:09:34.37,0:09:35.88,Default,,0,0,0,,Tidak mungkin.
Dialogue: 0,0:09:50.23,0:09:52.22,Default,,0,0,0,,Hei!
Dialogue: 0,0:09:52.22,0:09:53.86,Default,,0,0,0,,Suara apa itu?
Dialogue: 0,0:09:55.36,0:09:57.14,Default,,0,0,0,,Ada orang di sana?
Dialogue: 0,0:09:58.18,0:10:00.68,Default,,0,0,0,,Tolong aku!
Dialogue: 0,0:10:40.14,0:10:42.20,Default,,0,0,0,,Wah, tinggi sekali.
Dialogue: 0,0:10:42.20,0:10:43.52,Default,,0,0,0,,Hup.
Dialogue: 0,0:10:43.98,0:10:46.56,Default,,0,0,0,,Hei, kau di mana?
Dialogue: 0,0:10:46.56,0:10:48.27,Default,,0,0,0,,Hei!
Dialogue: 0,0:10:50.02,0:10:52.07,Default,,0,0,0,,Di sini.
Dialogue: 0,0:10:59.91,0:11:01.41,Default,,0,0,0,,Chopper!
Dialogue: 0,0:11:01.41,0:11:05.29,Default,,0,0,0,,Teman-teman, senang bertemu kalian lagi!
Dialogue: 0,0:11:08.21,0:11:10.06,Default,,0,0,0,,Kalung apa itu?
Dialogue: 0,0:11:10.71,0:11:15.59,Default,,0,0,0,,Entahlah, tiba-tiba ada saat aku bangun,\Ndan aku sudah di sini.
Dialogue: 0,0:11:15.59,0:11:19.10,Default,,0,0,0,,Aku tak bisa melepasnya,\Nbesi kalungnya terlalu keras.
Dialogue: 0,0:11:19.55,0:11:22.68,Default,,0,0,0,,Kukira aku akan mati.
Dialogue: 0,0:11:22.68,0:11:23.81,Default,,0,0,0,,Jangan bergerak.
Dialogue: 0,0:11:25.06,0:11:26.27,Default,,0,0,0,,Akan kupotong untukmu.
Dialogue: 0,0:11:26.27,0:11:27.37,Default,,0,0,0,,Kau menakutiku!
Dialogue: 0,0:11:28.27,0:11:30.16,Default,,0,0,0,,Gembok seperti ini
Dialogue: 0,0:11:31.52,0:11:32.69,Default,,0,0,0,,sangatlah mudah.
Dialogue: 0,0:11:32.69,0:11:35.09,Default,,0,0,0,,Wah, Kucing Pencuri memang hebat.
Dialogue: 0,0:11:39.91,0:11:41.99,Default,,0,0,0,,Terima kasih, Nami.
Dialogue: 0,0:11:41.99,0:11:44.20,Default,,0,0,0,,Kasihan sekali Chopper.
Dialogue: 0,0:11:44.20,0:11:45.91,Default,,0,0,0,,Kau sudah aman sekarang.
Dialogue: 0,0:11:45.91,0:11:47.42,Default,,0,0,0,,Kau berutang padaku.
Dialogue: 0,0:11:47.42,0:11:48.33,Default,,0,0,0,,Apa?
Dialogue: 0,0:11:48.33,0:11:50.38,Default,,0,0,0,,Tadi kau juga menangis.
Dialogue: 0,0:11:50.38,0:11:51.60,Default,,0,0,0,,Itu beda lagi.
Dialogue: 0,0:11:54.51,0:11:56.27,Default,,0,0,0,,Di ruangan untuk Raksasa,
Dialogue: 0,0:11:56.93,0:11:58.98,Default,,0,0,0,,ada pakaian seukuran manusia.
Dialogue: 0,0:11:59.34,0:12:01.97,Default,,0,0,0,,Apa kita diperlakukan seperti boneka?
Dialogue: 0,0:12:01.97,0:12:05.64,Default,,0,0,0,,Namun, kalau Raksasa yang membuatnya...
Dialogue: 0,0:12:05.64,0:12:09.83,Default,,0,0,0,,Sepertinya Dewa Matahari itu teliti\Ndan sangat terampil.
Dialogue: 0,0:12:19.38,0:12:21.12,Default,,0,0,0,,Apa yang kau lakukan?
Dialogue: 0,0:12:22.59,0:12:24.68,Default,,0,0,0,,Lihat, Sanji.
Dialogue: 0,0:12:24.68,0:12:27.15,Default,,0,0,0,,Ada banyak blok mainan.
Dialogue: 0,0:12:28.24,0:12:29.80,Default,,0,0,0,,Begitu rupanya.
Dialogue: 0,0:12:29.99,0:12:32.25,Default,,0,0,0,,Seluruh tempat ini terbuat dari itu.
Dialogue: 0,0:12:32.43,0:12:34.82,Default,,0,0,0,,Pantas saat kau memanggang kelinci\Nbaunya busuk,
Dialogue: 0,0:12:34.83,0:12:37.32,Default,,0,0,0,,karena ada resin sintetis\Nyang ikut terbakar.
Dialogue: 0,0:12:37.96,0:12:40.92,Default,,0,0,0,,Kemudian langit yang kau tabrak,
Dialogue: 0,0:12:41.34,0:12:44.57,Default,,0,0,0,,jalannya terasa tak ada ujungnya.
Dialogue: 0,0:12:44.57,0:12:46.36,Default,,0,0,0,,Itu cuma cermin.
Dialogue: 0,0:12:46.36,0:12:47.99,Default,,0,0,0,,Cermin?
Dialogue: 0,0:12:47.99,0:12:51.07,Default,,0,0,0,,Jadi orang itu adalah aku?
Dialogue: 0,0:12:51.25,0:12:52.32,Default,,0,0,0,,Ya.
Dialogue: 0,0:12:52.72,0:12:53.98,Default,,0,0,0,,Lihatlah.
Dialogue: 0,0:12:57.89,0:12:59.58,Default,,0,0,0,,Oh, aku bisa melihat tembus pandang.
Dialogue: 0,0:12:59.58,0:13:02.40,Default,,0,0,0,,Dari sisi ini cuma terlihat seperti kaca.
Dialogue: 0,0:13:02.98,0:13:06.03,Default,,0,0,0,,Aku tak tahu ada cermin ajaib seperti ini.
Dialogue: 0,0:13:08.66,0:13:10.12,Default,,0,0,0,,Nami.
Dialogue: 0,0:13:10.64,0:13:13.37,Default,,0,0,0,,Boleh aku membersihkan kamar perempuan...
Dialogue: 0,0:13:13.37,0:13:15.87,Default,,0,0,0,,Jangan harap kau bisa!
Dialogue: 0,0:13:15.87,0:13:19.79,Default,,0,0,0,,Jadi, ada Raksasa gila\Nyang membangun Kerajaan Blok,
Dialogue: 0,0:13:19.80,0:13:23.76,Default,,0,0,0,,melempar manusia dan hewan ke dalamnya,\Nlalu menonton untuk bersenang-senang?
Dialogue: 0,0:13:23.76,0:13:25.66,Default,,0,0,0,,Ngeri banget.
Dialogue: 0,0:13:25.67,0:13:28.24,Default,,0,0,0,,Tapi itu berarti kita sudah di Elbaph?
Dialogue: 0,0:13:28.24,0:13:31.18,Default,,0,0,0,,Ini rumah Raksasa di Kerajaan Raksasa?
Dialogue: 0,0:13:34.46,0:13:36.40,Default,,0,0,0,,Sudah kuduga.
Dialogue: 0,0:13:37.46,0:13:39.44,Default,,0,0,0,,Kita berhasil.
Dialogue: 0,0:13:41.69,0:13:43.63,Default,,0,0,0,,Belum tentu.
Dialogue: 0,0:13:43.63,0:13:47.61,Default,,0,0,0,,Yang pasti, kita tahu ini ruangan Raksasa.
Dialogue: 0,0:13:47.61,0:13:49.28,Default,,0,0,0,,Kita harus keluar untuk memastikannya.
Dialogue: 0,0:13:49.63,0:13:51.27,Default,,0,0,0,,Di mana yang lain?
Dialogue: 0,0:13:51.45,0:13:53.32,Default,,0,0,0,,Ayo keluar dari sini\Nsebelum raksasanya kembali.
Dialogue: 0,0:13:53.52,0:13:57.56,Default,,0,0,0,,Sebaiknya kita kembali ke kota\Ndan mengumpulkan informasi.
Dialogue: 0,0:13:59.34,0:14:03.54,Default,,0,0,0,,Jaga-jaga, seaneh apa pun Raksasa ini,\Nmari hindari masalah dengan mereka.
Dialogue: 0,0:14:03.54,0:14:05.92,Default,,0,0,0,,Hei, Luffy! Mengerti?
Dialogue: 0,0:14:05.92,0:14:08.34,Default,,0,0,0,,Berhentilah membuat keributan...
Dialogue: 0,0:14:10.18,0:14:12.85,Default,,0,0,0,,Boleh kuhajar yang satu ini?
Dialogue: 0,0:14:15.20,0:14:17.44,Default,,0,0,0,,Ya, hajar saja!
Dialogue: 0,0:14:19.50,0:14:20.96,Default,,0,0,0,,Lihat ke bawah.
Dialogue: 0,0:14:20.96,0:14:22.32,Default,,0,0,0,,Tikus!
Dialogue: 0,0:14:22.32,0:14:23.40,Default,,0,0,0,,Apa?
Dialogue: 0,0:14:23.40,0:14:25.83,Default,,0,0,0,,Apa? Wah!
Dialogue: 0,0:14:25.83,0:14:28.65,Default,,0,0,0,,Tidak, mereka memanjat naik!
Dialogue: 0,0:14:31.29,0:14:33.81,Default,,0,0,0,,Ada gagak juga.
Dialogue: 0,0:14:34.65,0:14:36.95,Default,,0,0,0,,Ia datang!
Dialogue: 0,0:14:36.96,0:14:40.63,Default,,0,0,0,,Mereka prajurit kuil?
Dialogue: 0,0:14:40.63,0:14:43.38,Default,,0,0,0,,Jadi, karena mereka tak ada\Nyang kembali hidup-hidup.
Dialogue: 0,0:14:43.38,0:14:47.10,Default,,0,0,0,,Bagaimana bisa ini disebut kuil?
Dialogue: 0,0:14:47.11,0:14:49.80,Default,,0,0,0,,Kau sudah makan kelinci,
Dialogue: 0,0:14:49.81,0:14:52.48,Default,,0,0,0,,jadi habisi sisa hewan lainnya.
Dialogue: 0,0:15:19.96,0:15:21.71,Default,,0,0,0,,Habisi mereka dengan satu serangan!
Dialogue: 0,0:15:21.71,0:15:23.92,Default,,0,0,0,,Kalau Dewa Matahari kembali...
Dialogue: 0,0:15:26.68,0:15:28.93,Default,,0,0,0,,Baiklah, ayo!
Dialogue: 0,0:15:45.04,0:15:47.00,Default,,0,0,0,,Gear Fifth!
Dialogue: 0,0:16:39.17,0:16:41.43,Default,,0,0,0,,Tunggu sebentar, Tikus Sialan.
Dialogue: 0,0:16:55.97,0:16:57.70,Default,,0,0,0,,Kubilang
Dialogue: 0,0:16:58.43,0:16:59.66,Default,,0,0,0,,tunggu!
Dialogue: 0,0:17:12.70,0:17:14.78,Default,,0,0,0,,Chopper, bisa kita naik ke sana?
Dialogue: 0,0:17:16.74,0:17:19.43,Default,,0,0,0,,Oke, ada sesuatu di sana?
Dialogue: 0,0:17:20.75,0:17:22.39,Default,,0,0,0,,Aku mencium bau harta karun.
Dialogue: 0,0:17:40.03,0:17:41.44,Default,,0,0,0,,Apa?
Dialogue: 0,0:17:49.57,0:17:51.82,Default,,0,0,0,,Panas! Siapa yang melakukan ini?
Dialogue: 0,0:17:51.82,0:17:53.71,Default,,0,0,0,,Luffy, kau keterlaluan!
Dialogue: 0,0:17:53.71,0:17:57.16,Default,,0,0,0,,Bukan aku yang menyebarkan api\Ndari perapian!
Dialogue: 0,0:17:57.16,0:17:57.80,Default,,0,0,0,,Hm?
Dialogue: 0,0:18:08.30,0:18:10.61,Default,,0,0,0,,Apa?
Dialogue: 0,0:18:12.88,0:18:14.32,Default,,0,0,0,,Apa itu Dewa Matahari?
Dialogue: 0,0:18:17.60,0:18:21.24,Default,,0,0,0,,Kuilku...
Dialogue: 0,0:18:22.31,0:18:23.60,Default,,0,0,0,,Hei, Luffy!
Dialogue: 0,0:18:23.60,0:18:26.02,Default,,0,0,0,,Dewa Matahari sudah kembali.
Dialogue: 0,0:18:26.02,0:18:27.41,Default,,0,0,0,,Ayo pergi dari sini!
Dialogue: 0,0:18:27.82,0:18:28.65,Default,,0,0,0,,Oke.
Dialogue: 0,0:18:29.33,0:18:30.74,Default,,0,0,0,,Aku akan segera menyusul.
Dialogue: 0,0:18:36.92,0:18:38.99,Default,,0,0,0,,Akan kuselesaikan ini juga.
Dialogue: 0,0:18:48.13,0:18:49.44,Default,,0,0,0,,Muginn!
Dialogue: 0,0:18:54.48,0:18:56.86,Default,,0,0,0,,Gomu Gomu no...
Dialogue: 0,0:18:57.60,0:18:59.35,Default,,0,0,0,,Dawn...
Dialogue: 0,0:18:59.86,0:19:02.24,Default,,0,0,0,,Pistol!
Dialogue: 0,0:19:08.98,0:19:10.62,Default,,0,0,0,,Hilmungardr!
Dialogue: 0,0:19:11.03,0:19:12.23,Default,,0,0,0,,Kita harus bergegas.
Dialogue: 0,0:19:13.29,0:19:14.65,Default,,0,0,0,,Ini...
Dialogue: 0,0:19:14.65,0:19:15.86,Default,,0,0,0,,Ayo pergi, Nami!
Dialogue: 0,0:19:15.86,0:19:16.76,Default,,0,0,0,,Oke.
Dialogue: 0,0:19:21.62,0:19:22.62,Default,,0,0,0,,Usopp!
Dialogue: 0,0:19:22.62,0:19:23.70,Default,,0,0,0,,Ya.
Dialogue: 0,0:19:24.04,0:19:25.39,Default,,0,0,0,,Cepatlah, Luffy!
Dialogue: 0,0:19:38.01,0:19:40.07,Default,,0,0,0,,Tak bisa dimaafkan.
Dialogue: 0,0:19:40.89,0:19:42.85,Default,,0,0,0,,Raksasa itu besar sekali.
Dialogue: 0,0:19:42.85,0:19:45.41,Default,,0,0,0,,Ya, penampilannya sangat mencurigakan.
Dialogue: 0,0:19:46.64,0:19:47.83,Default,,0,0,0,,Lihat.
Dialogue: 0,0:20:10.79,0:20:11.89,Default,,0,0,0,,Apa katanya?
Dialogue: 0,0:20:11.89,0:20:14.05,Default,,0,0,0,,Katanya, "Takkan kulupakan ini!"
Dialogue: 0,0:20:14.05,0:20:15.11,Default,,0,0,0,,Oke.
Dialogue: 0,0:20:15.36,0:20:16.69,Default,,0,0,0,,Omong-omong, lihat ini.
Dialogue: 0,0:20:16.69,0:20:19.03,Default,,0,0,0,,Aku tak menemukan barang berharga, tapi...
Dialogue: 0,0:20:20.18,0:20:22.40,Default,,0,0,0,,Ini cetak biru Kerajaan Blok.
Dialogue: 0,0:20:22.40,0:20:24.49,Default,,0,0,0,,Berarti, ini peta?
Dialogue: 0,0:20:24.49,0:20:25.95,Default,,0,0,0,,Benar.
Dialogue: 0,0:20:26.35,0:20:27.66,Default,,0,0,0,,Kerja bagus, Nami.
Dialogue: 0,0:20:27.98,0:20:29.73,Default,,0,0,0,,Nami memang hebat.
Dialogue: 0,0:20:29.73,0:20:30.62,Default,,0,0,0,,Dia datang.
Dialogue: 0,0:20:39.24,0:20:41.26,Default,,0,0,0,,Beraninya kalian...
Dialogue: 0,0:20:41.66,0:20:45.22,Default,,0,0,0,,Beraninya kalian menghancurkan kerajaanku!
Dialogue: 0,0:20:46.25,0:20:48.18,Default,,0,0,0,,Teman-teman, bersiaplah!
Dialogue: 0,0:20:48.66,0:20:53.89,Default,,0,0,0,,Lewati tanah tandus, kastel, lari lurus.\NLalu, kita akan menabrak cermin lain!
Dialogue: 0,0:20:53.89,0:20:56.38,Default,,0,0,0,,Kalau kita hancurkan cermin dan dindingnya,
Dialogue: 0,0:20:56.38,0:20:57.84,Default,,0,0,0,,kita bisa keluar.
Dialogue: 0,0:21:01.51,0:21:03.28,Default,,0,0,0,,Oke, teman-teman.
Dialogue: 0,0:21:04.72,0:21:06.74,Default,,0,0,0,,Ayo keluar dari sini!
Dialogue: 0,0:21:09.95,0:21:12.27,Default,,0,0,0,,Tanahnya bergetar.
Dialogue: 0,0:21:13.41,0:21:15.69,Default,,0,0,0,,Dewa Matahari
Dialogue: 0,0:21:15.69,0:21:17.38,Default,,0,0,0,,sedang marah.
Dialogue: 0,0:21:21.24,0:21:24.24,Default,,0,0,0,,Takkan kubiarkan kalian lolos.
Dialogue: 0,0:21:24.61,0:21:30.60,Default,,0,0,0,,BERSAMBUNG
Dialogue: 0,0:23:05.88,0:23:08.78,Default,,0,0,0,,Permainan kejar-kejaran pemungkas\Nmeletus di Kerajaan Blok.
Dialogue: 0,0:23:08.95,0:23:11.67,Default,,0,0,0,,Dewa Matahari memburu Luffy dan yang lain.
Dialogue: 0,0:23:11.67,0:23:14.20,Default,,0,0,0,,Tapi siapa identitas aslinya yang misterius?
Dialogue: 0,0:23:14.20,0:23:16.52,Default,,0,0,0,,Saat pertarungan memanas,
Dialogue: 0,0:23:16.52,0:23:21.19,Default,,0,0,0,,satu serangan Luffy membuka jalan\Nmenuju petualangan baru.
Dialogue: 0,0:23:21.19,0:23:22.50,Default,,0,0,0,,Selanjutnya, di ONE PIECE.
Dialogue: 0,0:23:22.50,0:23:26.03,Default,,0,0,0,,"Hancurkan Taman Miniatur!\NKabur dari Kerajaan Blok."
Dialogue: 0,0:23:26.03,0:23:29.03,Default,,0,0,0,,Aku akan menjadi Raja Bajak Laut!

