Dialogue: 0,0:14:44.88,0:14:46.24,sign,sign,0,0,0,,{\fad(400,0)\b1\fax0.5\fs30\fscy80\bord1\c&H413C88&\3c&H010101&\pos(342,131)\frz332.7\clip(m 255 118 l 263 107 272 90 304 98 316 158 349 166 335 99 479 164 467 246)}Diario illustrato
Dialogue: 0,0:14:50.08,0:14:51.58,Main,Hikaru,0,0,0,,Senti, Koshiba.
Dialogue: 0,0:14:53.38,0:14:55.71,Main,Hikaru,0,0,0,,Tieniti pure quei soldi.
Dialogue: 0,0:14:55.96,0:14:59.32,Main,Hikaru,0,0,0,,In cambio, avrei\Nun favore da chiederti.
Dialogue: 0,0:15:00.62,0:15:01.72,Main,Hikaru,0,0,0,,Il mare…
Dialogue: 0,0:15:02.48,0:15:03.36,Main,Koshiba,0,0,0,,Il mare?
Dialogue: 0,0:15:03.61,0:15:05.97,Main,Hikaru,0,0,0,,Portami al mare.
Dialogue: 0,0:15:18.10,0:15:19.25,Main,Koshiba,0,0,0,,Andiamo.
Dialogue: 0,0:15:50.76,0:15:51.83,Main,Koshiba,0,0,0,,Ehi!
Dialogue: 0,0:15:51.83,0:15:53.59,Main,Koshiba,0,0,0,,Perché proprio al mare?
Dialogue: 0,0:15:54.18,0:15:55.72,Main,Hikaru,0,0,0,,Eh? Che hai detto?
Dialogue: 0,0:15:55.72,0:15:56.98,Main,Hikaru,0,0,0,,Non ti sento!
Dialogue: 0,0:15:58.66,0:16:02.21,Main,Koshiba,0,0,0,,Per-ché pro-prio al ma-re?
Dialogue: 0,0:16:02.48,0:16:05.00,Main,Hikaru,0,0,0,,Il vento è troppo piacevole!
Dialogue: 0,0:16:06.47,0:16:09.51,Main,Koshiba,0,0,0,,Ehi! Mi stai ascoltando?!
Dialogue: 0,0:16:11.34,0:16:12.81,Main,Hikaru,0,0,0,,Il diario illustrato.
Dialogue: 0,0:16:14.15,0:16:15.63,Main,Koshiba,0,0,0,,Non ti sento!
Dialogue: 0,0:16:15.92,0:16:17.54,Main,Hikaru,0,0,0,,Il diario illustrato!
Dialogue: 0,0:16:18.54,0:16:20.96,Main,Hikaru,0,0,0,,Quando eravamo piccole
Dialogue: 0,0:16:20.96,0:16:23.55,Main,Hikaru,0,0,0,,avevamo un diario condiviso.
Dialogue: 0,0:16:23.92,0:16:27.52,Main,Hikaru,0,0,0,,Abbiamo smesso di scriverlo\Nquando siamo andate al mare…
Dialogue: 0,0:16:29.56,0:16:33.93,Main,Hikaru,0,0,0,,e ho ricordato perché\Nè successo proprio lì!
Dialogue: 0,0:16:35.75,0:16:36.89,Main,Koshiba,0,0,0,,C'è mancato un pelo!
Dialogue: 0,0:16:37.14,0:16:37.93,Main,Hikaru,0,0,0,,Scusa!
Dialogue: 0,0:16:38.37,0:16:40.58,Main,Koshiba,0,0,0,,Così è per questo che vuoi andare al mare.
Dialogue: 0,0:16:40.58,0:16:44.94,Main,Hikaru,0,0,0,,Insomma, non posso più chiederle\Ndel diario illustrato, no?
Dialogue: 0,0:16:45.22,0:16:46.60,Main,Koshiba,0,0,0,,Beh, sì…
Dialogue: 0,0:16:49.68,0:16:53.54,Main,Hikaru,0,0,0,,Che poi, Koshiba, sono sorpresa\Nche tu abbia accettato di farlo.
Dialogue: 0,0:16:53.79,0:16:56.35,Main,Hikaru,0,0,0,,È notte fonda e stiamo andando al mare.
Dialogue: 0,0:16:56.35,0:16:58.33,Main,Hikaru,0,0,0,,Credo che di norma uno si rifiuterebbe.
Dialogue: 0,0:16:58.33,0:17:00.80,Main,Koshiba,0,0,0,,Sto solo ripagando il mio debito.
Dialogue: 0,0:17:01.32,0:17:02.57,Main,Koshiba,0,0,0,,Più che altro,
Dialogue: 0,0:17:02.57,0:17:06.30,Main,Koshiba,0,0,0,,ti rendi conto anche tu\Nche questo non è normale, eh?
Dialogue: 0,0:17:09.32,0:17:10.99,Main,Hikaru,0,0,0,,Che tipo strano.
Dialogue: 0,0:17:09.32,0:17:10.99,Main_Overlap,Koshiba,0,0,0,,Che tipa strana.
Dialogue: 0,0:17:18.52,0:17:20.52,Flashback,Koshiba,0,0,0,,È che ho trovato carino il POP.
Dialogue: 0,0:17:18.52,0:17:20.52,sign,sign,0,0,0,,{\an4\b0\fax0.1\bord1\fs30\fnImpact\frz351.9\3c&H4E4E4E&\c&H552FF2&\pos(119,50)}Detective \Nassassino
Dialogue: 0,0:17:18.52,0:17:20.52,sign,sign,0,0,0,,{\an4\b0\fax0.4\bord1\fs20\fnImpact\3c&H4E4E4E&\c&H361CE7&\frz355.3\pos(346,237)}Consigliato\N\h\h\h{\c&H21FF32&}dallo staff!
Dialogue: 0,0:17:18.52,0:17:20.52,sign,sign,0,0,0,,{\an4\b0\fscx110\fscy130\fax0.1\bord1\fs40\fnImpact\3c&H4E4E4E&\c&H361CE7&\frz355.3\pos(151,234)}Estrazione\N{\c&H21FF32&}personaggio
Dialogue: 0,0:17:22.03,0:17:25.32,Flashback,Koshiba,0,0,0,,Ho proprio un debole\Nper le cose carine.
Dialogue: 0,0:17:25.94,0:17:27.56,Flashback,Koshiba,0,0,0,,Che faccio?
Dialogue: 0,0:17:29.34,0:17:30.72,Main,Hikaru,0,0,0,,Senti…
Dialogue: 0,0:17:30.72,0:17:33.64,Main,Hikaru,0,0,0,,Non ascoltare quello\Ndi cui sto per parlare.
Dialogue: 0,0:17:35.82,0:17:38.66,Main,Koshiba,0,0,0,,Cosa? Non ti sento proprio.
Dialogue: 0,0:17:41.51,0:17:44.46,Main,Hikaru,0,0,0,,Mia sorella si chiamava Mitsuru.
Dialogue: 0,0:17:45.64,0:17:48.27,Main,Hikaru,0,0,0,,Era bravissima a disegnare.
Dialogue: 0,0:17:49.74,0:17:51.21,Flashback,Mitsuru,0,0,0,,Sono a casa.
Dialogue: 0,0:17:51.46,0:17:53.09,Flashback,Hikaru,0,0,0,,Mitsuru, Mitsuru!
Dialogue: 0,0:17:54.48,0:17:56.28,Flashback,Hikaru,0,0,0,,Guarda! Ho vinto!
Dialogue: 0,0:17:56.28,0:17:58.35,Flashback,Hikaru,0,0,0,,Sono seconda\Nal concorso di disegno!
Dialogue: 1,0:17:54.48,0:17:58.35,sign,sign,0,0,0,,{\fad(200,0)\fs13\fscy80\fscx90\3c&HC2F5FD&\c&H000000&\b1\pos(136,10)}Attestato di riconoscimento\N\NSecondo posto  Matsuki Hikaru\N{\b0}Ha ottenuto la suddetta valutazione\Nper la 20ª edizione del concorso di disegno\Norganizzato dall'Associazione Nazionale di Disegno.\N\NLe viene perciò conferito tale riconoscimento.\N\N15 luglio del 4° anno Reiwa\N\NPresidente\NTanahashi Eiji
Dialogue: 0,0:17:54.48,0:17:58.35,sign,sign,0,0,0,,{\fad(200,0)\an7\p1\3c&H69C7D6&\c&HC2F5FD&\1a&H72&\3a&H76&\pos(10,6)\fscx255\fscy120}m 0 0 l 100 0 100 100 0 100
Dialogue: 0,0:18:03.10,0:18:04.72,Flashback,Mitsuru,0,0,0,,Ce l'hai fatta!
Dialogue: 0,0:18:04.72,0:18:07.61,Flashback,Hikaru,0,0,0,,Ma tu sei arrivata prima,\Nquindi contro di te ho perso.
Dialogue: 0,0:18:07.61,0:18:10.57,Flashback,Mitsuru,0,0,0,,Te l'ho detto, nel disegno\Nnon si vince né si perde.
Dialogue: 0,0:18:10.57,0:18:14.47,Flashback,Hikaru,0,0,0,,Guarda che è solo sarcasmo\Nse lo dice chi è arrivata prima.
Dialogue: 0,0:18:14.47,0:18:15.63,Flashback,Mitsuru,0,0,0,,Davvero?
Dialogue: 0,0:18:15.63,0:18:17.51,Flashback,Hikaru,0,0,0,,Ovvio!
Dialogue: 0,0:18:19.66,0:18:22.00,Flashback,Mitsuru,0,0,0,,A me piacciono di più\Ni tuoi disegni, Hikaru.
Dialogue: 0,0:18:24.28,0:18:26.46,Flashback,Mitsuru,0,0,0,,Continua a disegnare tantissimo!
Dialogue: 0,0:18:37.80,0:18:38.88,sign,sign,0,0,0,,{\fad(0,420)\fax0.3\fs15\fsp1\fscx98\frz12.66\3c&HEBDFD5&\c&H0E0E0F&\pos(292,78)}Versi dell'alchechengi
Dialogue: 0,0:18:42.05,0:18:42.18,sign,sign,0,0,0,,{\b1\fscx90\fs18\fscy70\bord0\frz25.97\c&H000000&\pos(326,131)\clip(m 424 81 l 405 102 392 111 357 143 329 176 293 213 509 146)}Copertina - Illustrazioni\N{\fs30}Matsuki Mitsuru
Dialogue: 0,0:18:42.18,0:18:44.31,sign,sign,0,0,0,,{\b1\fscx90\fs18\fscy70\bord0\frz25.97\c&H000000&\pos(326,131)}Copertina - Illustrazioni\N{\fs30}Matsuki Mitsuru
Dialogue: 0,0:18:45.93,0:18:47.65,Flashback,Hikaru,0,0,0,,Ce la metterò tutta anch'io.
Dialogue: 0,0:18:50.61,0:18:53.40,Flashback,Hikaru,0,0,0,,Mitsuru, sta suonando il telefono.
Dialogue: 0,0:18:57.45,0:18:58.58,Flashback,Hikaru,0,0,0,,Mitsuru?
Dialogue: 0,0:19:08.05,0:19:09.75,Flashback,Dottore,0,0,0,,La prospettiva più lunga è di due anni.
Dialogue: 0,0:19:10.07,0:19:11.53,Flashback,Dottore,0,0,0,,La più corta…
Dialogue: 0,0:19:13.31,0:19:14.78,Main,Hikaru,0,0,0,,Da quell'estate
Dialogue: 0,0:19:15.05,0:19:18.30,Main,Hikaru,0,0,0,,Mitsuru ha fatto avanti e indietro\Nfra casa e l'ospedale.
Dialogue: 0,0:19:33.78,0:19:36.63,Main,Hikaru,0,0,0,,I risparmi sono diminuiti sempre di più.
Dialogue: 0,0:19:37.42,0:19:40.53,Main,Hikaru,0,0,0,,Così ho iniziato a lavorare part-time.
Dialogue: 0,0:19:46.37,0:19:49.10,Main,Hikaru,0,0,0,,Scuola, part-time, cure di mia sorella.
Dialogue: 0,0:19:49.10,0:19:51.38,Main,Hikaru,0,0,0,,Scuola, part-time, cure di mia sorella.
Dialogue: 0,0:19:52.12,0:19:54.20,Main,Hikaru,0,0,0,,E fra una cosa e l'altra…
Dialogue: 0,0:20:18.15,0:20:20.18,Main,Hikaru,0,0,0,,Poi quest'anno
Dialogue: 0,0:20:20.18,0:20:22.70,Main,Hikaru,0,0,0,,la malattia di mia sorella\Nsi è aggravata…
Dialogue: 0,0:20:36.84,0:20:38.10,Main,Hikaru,0,0,0,,Che c'è?
Dialogue: 0,0:20:39.92,0:20:41.63,Main,Mitsuru,0,0,0,,Credo che…
Dialogue: 0,0:20:42.00,0:20:43.02,Main,Mitsuru,0,0,0,,sarà…
Dialogue: 0,0:20:43.66,0:20:45.66,Main,Mitsuru,0,0,0,,l'ultima volta che riuscirò…
Dialogue: 0,0:20:45.66,0:20:46.76,Main,Mitsuru,0,0,0,,a tornare…
Dialogue: 0,0:20:46.76,0:20:47.81,Main,Mitsuru,0,0,0,,a casa…
Dialogue: 0,0:21:07.75,0:21:10.81,Main,Hikaru,0,0,0,,Koshiba, grazie per non aver ascoltato.
Dialogue: 0,0:21:11.42,0:21:12.25,Main,Koshiba,0,0,0,,Di che parli?
Dialogue: 0,0:21:19.08,0:21:21.22,Main,Hikaru,0,0,0,,Ti offro un caffè.
Dialogue: 0,0:21:26.78,0:21:28.32,Main,Koshiba,0,0,0,,Signorina Sara.
Dialogue: 0,0:21:28.32,0:21:31.19,Main,Koshiba,0,0,0,,Grazie per avermi coperto\Nper il turno di notte.
Dialogue: 0,0:21:34.12,0:21:36.52,Main,Sara,0,0,0,,Mi raccomando, Koshiba.
