Dialogue: 0,0:01:30.24,0:01:32.32,Default,,0,0,0,,คิดถึงจัง
Dialogue: 0,0:01:32.32,0:01:35.87,Default,,0,0,0,,เราแลกกันวาดไดอารี่เล่มนี้\Nจนถึงตอนไหนกันนะ
Dialogue: 0,0:01:36.33,0:01:40.08,Default,,0,0,0,,และเราก็เฝ้ารอพี่วาดตอบสุด ๆ เลย
Dialogue: 0,0:01:40.87,0:01:42.54,Default,,0,0,0,,วาดออกมาสวยเลย
Dialogue: 0,0:01:44.46,0:01:48.05,Default,,0,0,0,,เรามาวาดส่วนของวันนี้กัน\Nว่ามาถึงทะเลกันแล้วน่ะ
Dialogue: 0,0:01:48.63,0:01:50.55,Default,,0,0,0,,เนอะ ฮิคารุ
Dialogue: 0,0:01:50.55,0:01:53.01,Default,,0,0,0,,พี่ยิ้มอยู่ด้วย
Dialogue: 0,0:01:53.01,0:01:54.43,Default,,0,0,0,,งั้นนี่ก็คงเป็น…
Dialogue: 0,0:01:57.35,0:01:59.01,Default,,0,0,0,,งั้นนี่ก็คงเป็น…
Dialogue: 0,0:01:59.35,0:02:00.39,Default,,0,0,0,,ความฝันแหละ
Dialogue: 0,0:02:16.74,0:02:18.16,Default,,0,0,0,,ฮึบ
Dialogue: 0,0:02:22.66,0:02:25.96,Default,,0,0,0,,(เกียรติบัตร เหรียญเงิน)\N(มัตสึกิ ฮิคารุ)
Dialogue: 0,0:02:25.96,0:02:26.96,Default,,0,0,0,,(อินฮิวแมน)\N(inhuman (adj) inhjuman)
Dialogue: 0,0:02:26.96,0:02:27.96,Default,,0,0,0,,(หนึ่ง อมนุษย์ ราวกับสัตว์ประหลาด)\N(สอง ไร้ความเป็นมนุษย์)
Dialogue: 0,0:02:27.96,0:02:28.96,Default,,0,0,0,,(สาม โหดเหี้ยม อำมหิต)
Dialogue: 0,0:03:49.67,0:03:55.09,Default,,0,0,0,,(โรงแรมเพชฌฆาต)
Dialogue: 0,0:04:10.02,0:04:14.48,Default,,0,0,0,,(คำขอที่ยี่สิบ ไดอารี่ส์มอเตอร์ไซค์ หนึ่ง)
Dialogue: 0,0:04:20.91,0:04:22.78,Default,,0,0,0,,ขอบคุณมากค่ะ
Dialogue: 0,0:04:25.62,0:04:27.91,Default,,0,0,0,,บุหรี่ขึ้นราคาอีกแล้วเหรอ
Dialogue: 0,0:04:29.25,0:04:31.50,Default,,0,0,0,,ค่าครองชีพนี่มันยังไงกันเนี่ยถามจริง
Dialogue: 0,0:04:31.50,0:04:32.84,Default,,0,0,0,,ช่วยขึ้นลงแต่พอดีหน่อยเถอะ
Dialogue: 0,0:04:33.71,0:04:34.96,Default,,0,0,0,,ค่ะ…
Dialogue: 0,0:04:35.25,0:04:37.38,Default,,0,0,0,,ขอเบอร์ 27
Dialogue: 0,0:04:37.38,0:04:38.97,Default,,0,0,0,,ได้ค่ะ
Dialogue: 0,0:04:38.97,0:04:41.47,Default,,0,0,0,,(นักสืบแอสแซสซิน เสี่ยงโชคคาแร็กเตอร์)
Dialogue: 0,0:04:41.93,0:04:43.43,Default,,0,0,0,,เอาอันนี้ด้วยใบนึง
Dialogue: 0,0:04:44.39,0:04:45.68,Default,,0,0,0,,เท่านี้แหละ
Dialogue: 0,0:04:45.68,0:04:46.60,Default,,0,0,0,,นี่ค่ะ
Dialogue: 0,0:04:49.94,0:04:53.02,Default,,0,0,0,,ล้อกันเล่นปะเนี่ย\Nลืมกระเป๋าตังค์ซะได้
Dialogue: 0,0:04:55.82,0:04:59.03,Default,,0,0,0,,เรามีเงินทั้งตัวแค่นี้อะนะ…
Dialogue: 0,0:05:00.90,0:05:02.95,Default,,0,0,0,,ซื้ออันไหนดีเนี่ย
Dialogue: 0,0:05:04.91,0:05:08.91,Default,,0,0,0,,ขอโทษนะคะ\Nคุณชอบนักสืบแอสแซสซินสินะคะ
Dialogue: 0,0:05:09.91,0:05:12.25,Default,,0,0,0,,เปล่านะ ไม่ได้ชอบ
Dialogue: 0,0:05:12.25,0:05:12.79,Default,,0,0,0,,เอ๊ะ
Dialogue: 0,0:05:12.79,0:05:15.74,Default,,0,0,0,,ป้ายโปรโมตมันน่ารักดีนี่นา\N(นักสืบแอสแซสซิน เสี่ยงโชคคาแร็กเตอร์)
Dialogue: 0,0:05:17.42,0:05:20.76,Default,,0,0,0,,เรานี่แพ้ทางของน่ารักจริง ๆ
Dialogue: 0,0:05:20.76,0:05:23.05,Default,,0,0,0,,อืม… เอายังไงดีนะ
Dialogue: 0,0:05:26.56,0:05:28.89,Default,,0,0,0,,เดี๋ยวไม่เอาบุหรี่แล้วเอาอันนี้…
Dialogue: 0,0:05:28.89,0:05:30.02,Default,,0,0,0,,นี่ค่ะ
Dialogue: 0,0:05:31.73,0:05:34.73,Default,,0,0,0,,ฉันไม่ได้ให้ฟรี ๆ นะคะ\Nแต่ให้ยืมค่ะ
Dialogue: 0,0:05:37.69,0:05:41.61,Default,,0,0,0,,ป้ายโปรโมตนั่นฉันเป็นคนวาดเอง\Nก็เลยต้องรับผิดชอบละมั้ง
Dialogue: 0,0:05:43.74,0:05:45.24,Default,,0,0,0,,งั้นขอไม่เกรงใจแล้วนะ
Dialogue: 0,0:05:45.82,0:05:47.03,Default,,0,0,0,,(ยินดีด้วย รางวัลเอสเอส)\N(กรุณานำสิ่งนี้ไปแลกรางวัลได้ที่หน้าร้าน)
Dialogue: 0,0:05:47.03,0:05:48.70,Default,,0,0,0,,ว้าว รางวัลเอสเอส
Dialogue: 0,0:05:48.70,0:05:50.70,Default,,0,0,0,,(ตุ๊กตารางวัลเอสเอส)
Dialogue: 0,0:05:51.16,0:05:54.00,Default,,0,0,0,,น่ารักอะ น่ารักโฮกเลย
Dialogue: 0,0:05:54.00,0:05:56.29,Default,,0,0,0,,ขอบคุณนะ
Dialogue: 0,0:05:56.29,0:05:57.63,Default,,0,0,0,,เอ่อ…
Dialogue: 0,0:05:58.00,0:05:59.09,Default,,0,0,0,,(มัตสึกิ)
Dialogue: 0,0:05:59.09,0:06:00.80,Default,,0,0,0,,คุณมัตสึกิ…\N(มัตสึกิ)
Dialogue: 0,0:06:00.80,0:06:03.18,Default,,0,0,0,,ดีใจสุด ๆ เลยอะ
Dialogue: 0,0:06:03.18,0:06:04.51,Default,,0,0,0,,ถ้างั้น…
Dialogue: 0,0:06:07.72,0:06:11.06,Default,,0,0,0,,อย่างน้อยตอนนี้\Nก็ต้องตอบแทนอะไรสักหน่อย
Dialogue: 0,0:06:11.06,0:06:13.77,Default,,0,0,0,,เอ๊ะ ตอนนี้ไม่มีเงินไม่ใช่เหรอ
Dialogue: 0,0:06:13.77,0:06:15.94,Default,,0,0,0,,อืม แทนที่จะให้เงิน…
Dialogue: 0,0:06:25.36,0:06:28.33,Default,,0,0,0,,ขอโทษนะคะ\Nเด็กคนนี้เขาไม่รู้เรื่องน่ะค่ะ
Dialogue: 0,0:06:28.33,0:06:30.91,Default,,0,0,0,,จะแกะของที่ยังไม่ซื้อไม่ได้สิ
Dialogue: 0,0:06:32.37,0:06:33.21,Default,,0,0,0,,อืม
Dialogue: 0,0:06:33.62,0:06:34.75,Default,,0,0,0,,- หนูต้องขอโทษด้วยนะคะ
Dialogue: 0,0:06:34.75,0:06:36.17,Default,,0,0,0,,- ถ้างั้น\N- หนูต้องขอโทษด้วยนะคะ
Dialogue: 0,0:06:37.88,0:06:40.96,Default,,0,0,0,,อันนี้เราซื้อเอง\Nมีเงินทอนพอดีด้วย
Dialogue: 0,0:06:41.59,0:06:43.59,Default,,0,0,0,,- ไม่เป็นไรหรอก\N- คือว่า…
Dialogue: 0,0:06:45.38,0:06:49.10,Default,,0,0,0,,จากนี้ก็จับมือกันไว้ให้นานที่สุดล่ะ
Dialogue: 0,0:06:50.26,0:06:51.31,Default,,0,0,0,,อืม
Dialogue: 0,0:06:51.31,0:06:52.06,Default,,0,0,0,,อือ
Dialogue: 0,0:06:53.02,0:06:55.85,Default,,0,0,0,,นี่ ๆ จับมือหนูหน่อยสิ
Dialogue: 0,0:06:55.85,0:06:57.06,Default,,0,0,0,,โธ่
Dialogue: 0,0:06:58.40,0:07:00.32,Default,,0,0,0,,ทำเอานึกถึงเลย
Dialogue: 0,0:07:00.32,0:07:02.44,Default,,0,0,0,,ฉันเองก็เคยมีเรื่องแบบนั้นเหมือนกัน
Dialogue: 0,0:07:03.78,0:07:08.49,Default,,0,0,0,,พี่ฉันจับมือฉันไว้แน่นสุด ๆ\Nเพื่อที่จะได้ไม่พลัดหลงกัน
Dialogue: 0,0:07:15.58,0:07:19.54,Default,,0,0,0,,อ้อ… ขอบคุณนะ\Nพอดีฉันไม่ทันสังเกตสักนิดเลย
Dialogue: 0,0:07:20.00,0:07:24.38,Default,,0,0,0,,คุณมัตสึกิน่ะ\Nอย่าให้คนยืมเงินง่ายขนาดนั้นจะดีกว่านะ
Dialogue: 0,0:07:26.09,0:07:30.39,Default,,0,0,0,,ใช่ว่าทุกคนจะเป็นคนดี\Nเหมือนกับเราสักหน่อยจริงไหม
Dialogue: 0,0:07:36.89,0:07:38.44,Default,,0,0,0,,แปลกคนจัง
Dialogue: 0,0:07:53.74,0:07:55.25,Default,,0,0,0,,น่ารักเนอะ
Dialogue: 0,0:07:55.25,0:07:57.66,Default,,0,0,0,,อะไรเหรอครับ แล้วนี่คืออะไรน่ะ
Dialogue: 0,0:07:57.96,0:07:59.21,Default,,0,0,0,,อย่าจับเชียว
Dialogue: 0,0:07:59.21,0:08:00.38,Default,,0,0,0,,ครับ…
Dialogue: 0,0:08:05.13,0:08:07.01,Default,,0,0,0,,ยินดีต้อนรับค่ะ
Dialogue: 0,0:08:11.72,0:08:13.31,Default,,0,0,0,,เงินห้าร้อยเยนนี่น่ะ
Dialogue: 0,0:08:13.89,0:08:16.10,Default,,0,0,0,,ขอฉันยืมจนกว่าจะจบโปรได้ไหม
Dialogue: 0,0:08:16.35,0:08:18.48,Default,,0,0,0,,ก็ได้อยู่หรอก แต่ยืมไปทำไมล่ะ
Dialogue: 0,0:08:19.02,0:08:20.19,Default,,0,0,0,,ถือเคล็ดน่ะ
Dialogue: 0,0:08:21.73,0:08:22.61,Default,,0,0,0,,รางวัลเอ
Dialogue: 0,0:08:22.61,0:08:24.69,Default,,0,0,0,,(ตุ๊กตารางวัลเอ)
Dialogue: 0,0:08:24.69,0:08:26.44,Default,,0,0,0,,ยินดีด้วยนะคะ
Dialogue: 0,0:08:26.44,0:08:28.53,Default,,0,0,0,,ไชโย น่ารักมาก
Dialogue: 0,0:08:45.50,0:08:46.88,Default,,0,0,0,,วันนี้เลิกแล้วเหรอ
Dialogue: 0,0:08:46.88,0:08:47.84,Default,,0,0,0,,ใช่
Dialogue: 0,0:08:48.05,0:08:49.47,Default,,0,0,0,,เราไปส่งเอาไหม
Dialogue: 0,0:08:50.30,0:08:54.89,Default,,0,0,0,,ฉันจะนั่งมอเตอร์ไซค์\Nของคนที่ไม่รู้จักแม้แต่ชื่อได้ยังไงกันล่ะ
Dialogue: 0,0:08:55.35,0:08:56.93,Default,,0,0,0,,คิริฮาระ ชิบะ
Dialogue: 0,0:08:56.93,0:08:58.02,Default,,0,0,0,,เอ๊ะ
Dialogue: 0,0:08:58.02,0:09:00.89,Default,,0,0,0,,แต่คนรอบข้างจะเรียกเราว่าโคชิบะ
Dialogue: 0,0:09:00.89,0:09:03.36,Default,,0,0,0,,หืม โคชิบะสินะ
Dialogue: 0,0:09:03.36,0:09:05.48,Default,,0,0,0,,ส่วนเธอก็มัตสึกิ…
Dialogue: 0,0:09:10.95,0:09:12.11,Default,,0,0,0,,นี่
Dialogue: 0,0:09:13.45,0:09:15.12,Default,,0,0,0,,แปลกคนจริง ๆ
Dialogue: 0,0:09:25.42,0:09:26.67,Default,,0,0,0,,(ยินดีด้วย รางวัลดี)\N(กรุณานำสิ่งนี้ไปแลกรางวัลได้ที่หน้าร้าน)
Dialogue: 0,0:09:26.67,0:09:27.80,Default,,0,0,0,,รางวัลดีแหละ
Dialogue: 0,0:09:27.80,0:09:28.96,Default,,0,0,0,,(ตุ๊กตารางวัลดี)
Dialogue: 0,0:09:28.96,0:09:31.17,Default,,0,0,0,,ยินดีด้วยนะคะ\N(ตุ๊กตารางวัลดี)
Dialogue: 0,0:09:33.22,0:09:36.47,Default,,0,0,0,,คุณมัตสึกิ ตัวนี้มันน่ารักเหรอ
Dialogue: 0,0:09:37.76,0:09:39.81,Default,,0,0,0,,ถือว่าน่ารักแล้วกัน
Dialogue: 0,0:09:40.68,0:09:41.85,Default,,0,0,0,,ฮิคารุ
Dialogue: 0,0:09:44.40,0:09:45.86,Default,,0,0,0,,มัตสึกิ ฮิคารุ
Dialogue: 0,0:09:47.40,0:09:49.32,Default,,0,0,0,,ฮิคารุสินะ
Dialogue: 0,0:09:57.12,0:09:59.37,Default,,0,0,0,,มีของแบบนั้นอยู่ด้วยนี่เอง
Dialogue: 0,0:10:00.95,0:10:02.25,Default,,0,0,0,,ที่เขี่ยบุหรี่
Dialogue: 0,0:10:02.25,0:10:03.87,Default,,0,0,0,,คอมมอนเซนส์ไม่ใช่หรือไง
Dialogue: 0,0:10:07.38,0:10:08.42,Default,,0,0,0,,นี่
Dialogue: 0,0:10:10.30,0:10:12.76,Default,,0,0,0,,โคชิบะทำงานอะไรอย่างงั้นเหรอ
Dialogue: 0,0:10:14.34,0:10:15.89,Default,,0,0,0,,พนักงานโรงแรม
Dialogue: 0,0:10:15.89,0:10:18.47,Default,,0,0,0,,เรามีหน้าที่คอยดูแลลูกค้าน่ะ
Dialogue: 0,0:10:18.47,0:10:19.68,Default,,0,0,0,,ผิดคาดอะ
Dialogue: 0,0:10:20.56,0:10:21.68,Default,,0,0,0,,ทำไมล่ะ
Dialogue: 0,0:10:22.31,0:10:24.90,Default,,0,0,0,,ไม่นึกเลยว่าจะเป็นมนุษย์เงินเดือน
Dialogue: 0,0:10:24.90,0:10:26.27,Default,,0,0,0,,งั้นเหรอ
Dialogue: 0,0:10:26.27,0:10:28.27,Default,,0,0,0,,ไม่ว่ากลางวันหรือกลางคืนเธอก็มานี่
Dialogue: 0,0:10:29.86,0:10:33.82,Default,,0,0,0,,โรงแรมเรามีระบบเข้ากะ\Nทั้งกะเช้าและกะดึกแหละนะ
Dialogue: 0,0:10:33.82,0:10:35.78,Default,,0,0,0,,ไม่ต่างกับร้านสะดวกซื้อเลยแฮะ
Dialogue: 0,0:10:39.74,0:10:42.79,Default,,0,0,0,,ฮิคารุวาดรูปเก่งตั้งแต่เมื่อก่อนแล้วเหรอ
Dialogue: 0,0:10:43.81,0:10:45.96,Default,,0,0,0,,ก็ไม่รู้เหมือนกันนะ
Dialogue: 0,0:10:46.88,0:10:49.63,Default,,0,0,0,,แต่ก็มีพี่คอยชมอยู่แหละ
Dialogue: 0,0:10:50.25,0:10:51.92,Default,,0,0,0,,ก็เก่งไม่ใช่หรือไง
Dialogue: 0,0:10:52.55,0:10:55.18,Default,,0,0,0,,คุณมัตสึกิ ประจำแคชเชียร์หน่อย
Dialogue: 0,0:10:55.18,0:10:56.34,Default,,0,0,0,,ได้ค่ะ
Dialogue: 0,0:10:59.68,0:11:00.81,Default,,0,0,0,,เจอกันนะ
Dialogue: 0,0:11:10.65,0:11:14.40,Default,,0,0,0,,คือว่านะ…\Nก่อนหน้านี้มีแค่เจ้านี่ตัวเดียวใช่ไหม
Dialogue: 0,0:11:14.40,0:11:16.78,Default,,0,0,0,,แต่นี่กลับงอกเพิ่มขึ้นทุกวันเลย
Dialogue: 0,0:11:17.20,0:11:21.24,Default,,0,0,0,,โคชิบะยังชอบของน่ารักสุด ๆ\Nเหมือนเดิมเลยนะคะ
Dialogue: 0,0:11:22.91,0:11:25.04,Default,,0,0,0,,รุ่นพี่จำได้ด้วยสินะ
Dialogue: 0,0:11:25.04,0:11:26.92,Default,,0,0,0,,สมกับเป็นรุ่นพี่ซาระเลย
Dialogue: 0,0:11:27.79,0:11:29.17,Default,,0,0,0,,เฮ้ย อิคุโร
Dialogue: 0,0:11:29.17,0:11:30.21,Default,,0,0,0,,เอ๊ะ
Dialogue: 0,0:11:30.63,0:11:33.05,Default,,0,0,0,,บอกแล้วไงว่าอย่าแตะต้อง
Dialogue: 0,0:11:33.05,0:11:36.13,Default,,0,0,0,,คุณโคชิบะครับ\Nเจ้าพวกนี้ไปซื้อมาจากไหนเหรอครับ
Dialogue: 0,0:11:36.84,0:11:41.60,Default,,0,0,0,,เจ้าพวกนี้มาจากร้านสะดวกซื้อที่เราถูกใจ\Nแล้วมีป้ายโปรโมตน่ารักน่ะ
Dialogue: 0,0:11:46.64,0:11:48.44,Default,,0,0,0,,ฉันขอตัวแป๊บนึงนะคะ
Dialogue: 0,0:11:50.69,0:11:51.94,Default,,0,0,0,,ใช่ค่ะ
Dialogue: 0,0:11:52.48,0:11:53.53,Default,,0,0,0,,เอ๊ะ
Dialogue: 0,0:11:54.90,0:11:56.19,Default,,0,0,0,,เอ๋
Dialogue: 0,0:12:16.17,0:12:19.97,Default,,0,0,0,,(ไม่มีสัญญาณชีพจร)
Dialogue: 0,0:12:26.56,0:12:30.06,Default,,0,0,0,,(ไดอารี่รูปวาด)\N(มัตสึกิ มิตสึรุ และ มัตสึกิ ฮิคารุ)
Dialogue: 0,0:12:31.77,0:12:34.07,Default,,0,0,0,,โรงแรมเพชฌฆาต
Dialogue: 0,0:12:41.28,0:12:42.57,Default,,0,0,0,,ไปก่อนนะ
Dialogue: 0,0:12:53.42,0:12:54.63,Default,,0,0,0,,ยินดีต้อนรับค่ะ
Dialogue: 0,0:12:58.80,0:13:01.80,Default,,0,0,0,,(อร่อยนะจะบอกให้)\N(น้องซาลาเปา)
Dialogue: 0,0:13:05.76,0:13:06.85,Default,,0,0,0,,หนาวจัง
Dialogue: 0,0:13:19.53,0:13:21.70,Default,,0,0,0,,อ้าว โคชิบะ
Dialogue: 0,0:13:25.45,0:13:27.33,Default,,0,0,0,,มาอีกแล้วเหรอ
Dialogue: 0,0:13:27.33,0:13:29.70,Default,,0,0,0,,ตั๋วจับสลากหมดโปรไปแล้วแท้ ๆ
Dialogue: 0,0:13:29.70,0:13:34.71,Default,,0,0,0,,อืม เพราะมันหมดโปรไปแล้ว\Nเราเลยกะจะมาคืนเงินที่ยืมไปให้ฮิคารุไง
Dialogue: 0,0:13:35.00,0:13:36.29,Default,,0,0,0,,งั้นเหรอ
Dialogue: 0,0:13:36.67,0:13:38.05,Default,,0,0,0,,ฉันเองก็…
Dialogue: 0,0:13:39.55,0:13:41.34,Default,,0,0,0,,จบหมดทุกอย่างแล้วละ
Dialogue: 0,0:13:43.26,0:13:45.97,Default,,0,0,0,,เราเผาศพพี่สาวฉันแล้วละ
Dialogue: 0,0:13:46.35,0:13:49.56,Default,,0,0,0,,นี่ไง ฉันใส่ชุดไว้ทุกข์อยู่\Nคงจะตบมุกยากล่ะสิ
Dialogue: 0,0:13:50.48,0:13:52.48,Default,,0,0,0,,เพราะงั้นฉันเลยสปอยล์ตัวเองน่ะ
Dialogue: 0,0:13:56.94,0:13:58.86,Default,,0,0,0,,ฉันไม่เป็นไรหรอก
Dialogue: 0,0:13:58.86,0:14:02.20,Default,,0,0,0,,ฉันรู้อยู่แล้วว่าเธอคงเหลือเวลาไม่มาก
Dialogue: 0,0:14:02.20,0:14:04.16,Default,,0,0,0,,เตรียมใจเอาไว้ตลอดนั่นแหละ
Dialogue: 0,0:14:04.66,0:14:08.08,Default,,0,0,0,,แต่พอฉันกลับบ้านหลังจากเผาศพเธอแล้ว…
Dialogue: 0,0:14:09.58,0:14:11.79,Default,,0,0,0,,มันดูว่างเปล่าน่ะ
Dialogue: 0,0:14:13.08,0:14:16.00,Default,,0,0,0,,เพราะเราต้องเข้าออกโรงพยาบาลบ่อย ๆ
Dialogue: 0,0:14:16.38,0:14:20.51,Default,,0,0,0,,ก็เลยต้องจัดการทั้งเรื่องยา\Nและเรื่องเสื้อผ้าไว้เปลี่ยนตอนเข้าโรงพยาบาล
Dialogue: 0,0:14:20.51,0:14:24.09,Default,,0,0,0,,พอไม่จำเป็นต้องทำอะไรสักอย่างแล้ว
Dialogue: 0,0:14:24.09,0:14:26.72,Default,,0,0,0,,ฉันก็เลยไม่รู้ว่าจะต้องทำอะไรดี
Dialogue: 0,0:14:27.80,0:14:32.43,Default,,0,0,0,,ดังนั้นเลยกะมาทำพาร์ตไทม์\Nจะได้ขยับเนื้อขยับตัวหน่อย
Dialogue: 0,0:14:34.94,0:14:36.48,Default,,0,0,0,,(มีข้อความใหม่)
Dialogue: 0,0:14:43.24,0:14:46.24,Default,,0,0,0,,(ไดอารี่รูปวาด)
Dialogue: 0,0:14:50.08,0:14:51.58,Default,,0,0,0,,นี่ โคชิบะ
Dialogue: 0,0:14:53.41,0:14:55.71,Default,,0,0,0,,เงินเมื่อกี้นี้ไม่ต้องแล้วก็ได้
Dialogue: 0,0:14:56.00,0:14:59.34,Default,,0,0,0,,แต่ฉันขอรบกวนอะไรสักเรื่องแทนได้ไหม
Dialogue: 0,0:15:00.59,0:15:01.76,Default,,0,0,0,,ทะเลน่ะ…
Dialogue: 0,0:15:02.51,0:15:03.67,Default,,0,0,0,,ทะเลเหรอ
Dialogue: 0,0:15:03.67,0:15:05.97,Default,,0,0,0,,ช่วยพาฉันไปทะเลที
Dialogue: 0,0:15:18.10,0:15:19.23,Default,,0,0,0,,ไปกันสิ
Dialogue: 0,0:15:50.80,0:15:53.56,Default,,0,0,0,,นี่ ทำไมต้องไปทะเลล่ะ
Dialogue: 0,0:15:54.10,0:15:56.98,Default,,0,0,0,,เอ๋ ว่าไงนะ ไม่ได้ยินเลย
Dialogue: 0,0:15:58.69,0:16:02.48,Default,,0,0,0,,ทำ ไม ต้อง ไป ทะ เล ล่ะ
Dialogue: 0,0:16:02.69,0:16:05.15,Default,,0,0,0,,ลมเย็นสบายดีจัง
Dialogue: 0,0:16:06.44,0:16:09.45,Default,,0,0,0,,นี่ ฟังที่ฉันถามอยู่ไหมเนี่ย
Dialogue: 0,0:16:11.32,0:16:12.87,Default,,0,0,0,,ไดอารี่
Dialogue: 0,0:16:12.87,0:16:13.79,Default,,0,0,0,,เอ๋
Dialogue: 0,0:16:14.16,0:16:15.58,Default,,0,0,0,,ไม่ได้ยินเลย
Dialogue: 0,0:16:15.95,0:16:17.46,Default,,0,0,0,,ไดอารี่
Dialogue: 0,0:16:18.46,0:16:21.00,Default,,0,0,0,,เมื่อตอนสมัยเด็กฉันกับพี่เขา
Dialogue: 0,0:16:21.00,0:16:23.46,Default,,0,0,0,,ได้แลกไดอารี่รูปวาดด้วยกันน่ะ
Dialogue: 0,0:16:24.09,0:16:27.42,Default,,0,0,0,,สมุดเล่มนั้นมันจบในวันที่ไปทะเล
Dialogue: 0,0:16:29.51,0:16:33.89,Default,,0,0,0,,ฉันอยากนึกให้ออก\Nว่าทำไมมันถึงจบลงตรงนั้น
Dialogue: 0,0:16:35.72,0:16:37.14,Default,,0,0,0,,เกือบไปแล้ว
Dialogue: 0,0:16:37.14,0:16:38.35,Default,,0,0,0,,ขอโทษ
Dialogue: 0,0:16:38.35,0:16:40.56,Default,,0,0,0,,ทีนี้มันคือทะเลสินะ
Dialogue: 0,0:16:40.56,0:16:44.94,Default,,0,0,0,,ก็ฉันถามเรื่องไดอารี่รูปวาดกับเจ้าตัวไม่ได้แล้วนี่
Dialogue: 0,0:16:45.28,0:16:46.57,Default,,0,0,0,,ก็จริงแหละ
Dialogue: 0,0:16:49.74,0:16:53.49,Default,,0,0,0,,เดิมทีโคชิบะเนี่ย\Nตอบตกลงบ่อยมากเลยนะ
Dialogue: 0,0:16:53.78,0:16:56.41,Default,,0,0,0,,ช่วงกลางดึกแบบนี้ แถมยังเป็นทะเลอีก
Dialogue: 0,0:16:56.41,0:16:58.33,Default,,0,0,0,,ปกติฉันว่าน่าจะปฏิเสธกันนะ
Dialogue: 0,0:16:58.33,0:17:00.87,Default,,0,0,0,,เราแค่ตอบแทนคืนนั่นแหละ
Dialogue: 0,0:17:01.33,0:17:06.30,Default,,0,0,0,,ว่าแต่ ฮิคารุนั่นแหละ\Nรู้อยู่สินะว่าเรื่องนี้มันไม่ปกติน่ะ
Dialogue: 0,0:17:09.34,0:17:10.97,Default,,0,0,0,,- แปลกคนจัง\N- แปลกคนจัง
Dialogue: 0,0:17:18.52,0:17:20.52,Default,,0,0,0,,ป้ายโปรโมตมันน่ารักดีนี่นา\N(นักสืบแอสแซสซิน เสี่ยงโชคคาแร็กเตอร์)
Dialogue: 0,0:17:22.06,0:17:25.32,Default,,0,0,0,,เรานี่แพ้ทางของน่ารักจริง ๆ
Dialogue: 0,0:17:25.32,0:17:27.57,Default,,0,0,0,,อืม… เอายังไงดีนะ
Dialogue: 0,0:17:29.36,0:17:30.82,Default,,0,0,0,,นี่คือว่า
Dialogue: 0,0:17:30.82,0:17:33.70,Default,,0,0,0,,อย่าฟังเรื่องที่ฉันกำลังจะเล่าเชียวนะ
Dialogue: 0,0:17:35.78,0:17:38.66,Default,,0,0,0,,อะไรนะ\Nไม่ได้ยินสักนิดเลยอะ
Dialogue: 0,0:17:41.50,0:17:44.46,Default,,0,0,0,,พี่สาวของฉันชื่อว่ามิตสึรุน่ะ
Dialogue: 0,0:17:45.63,0:17:48.25,Default,,0,0,0,,เธอวาดรูปเก่งสุด ๆ เลยละ
Dialogue: 0,0:17:49.71,0:17:51.13,Default,,0,0,0,,กลับมาแล้ว
Dialogue: 0,0:17:51.42,0:17:53.34,Default,,0,0,0,,พี่คะ พี่
Dialogue: 0,0:17:54.47,0:17:56.30,Default,,0,0,0,,ดูสิ หนูได้มาแล้ว
Dialogue: 0,0:17:56.30,0:17:58.35,Default,,0,0,0,,เหรียญเงินในการประกวดวาดรูป
Dialogue: 0,0:18:03.14,0:18:04.81,Default,,0,0,0,,สำเร็จแล้วนะ
Dialogue: 0,0:18:04.81,0:18:07.52,Default,,0,0,0,,แต่ก็แพ้พี่ที่ได้เหรียญทองอะ
Dialogue: 0,0:18:07.52,0:18:10.65,Default,,0,0,0,,พี่บอกแล้วไง\Nว่าศิลปะไม่ใช่เรื่องแพ้ชนะ
Dialogue: 0,0:18:10.65,0:18:14.49,Default,,0,0,0,,คนที่ได้เหรียญทองพูดแบบนั้น\Nก็เหมือนการแซะกันนั่นแหละ
Dialogue: 0,0:18:14.49,0:18:15.62,Default,,0,0,0,,ใช่เหรอ
Dialogue: 0,0:18:15.62,0:18:17.66,Default,,0,0,0,,ใช่น่ะสิ
Dialogue: 0,0:18:19.70,0:18:22.00,Default,,0,0,0,,พี่ชอบรูปภาพของฮิคารุที่สุดเลยนะ
Dialogue: 0,0:18:24.29,0:18:26.46,Default,,0,0,0,,จากนี้ช่วยวาดอีกเยอะ ๆ ที
Dialogue: 0,0:18:37.82,0:18:39.39,Default,,0,0,0,,(ลำนำดอกโฮซูกิ)
Dialogue: 0,0:18:42.02,0:18:44.31,Default,,0,0,0,,(ภาพปกและภาพประกอบ)\N(มัตสึกิ มิตสึรุ)
Dialogue: 0,0:18:45.94,0:18:47.56,Default,,0,0,0,,หนูก็จะพยายามนะ
Dialogue: 0,0:18:50.65,0:18:53.40,Default,,0,0,0,,พี่คะ โทรศัพท์ดังอยู่แน่ะ
Dialogue: 0,0:18:57.37,0:18:58.58,Default,,0,0,0,,พี่คะ…
Dialogue: 0,0:19:08.04,0:19:09.75,Default,,0,0,0,,อย่างมากก็สองปี
Dialogue: 0,0:19:10.09,0:19:11.59,Default,,0,0,0,,แต่อย่างสั้นที่สุดก็…
Dialogue: 0,0:19:13.30,0:19:18.30,Default,,0,0,0,,นับตั้งแต่ฤดูร้อนนั้น\Nพี่ก็ไป ๆ กลับ ๆ ระหว่างบ้านกับโรงพยาบาล
Dialogue: 0,0:19:33.94,0:19:36.53,Default,,0,0,0,,เงินเก็บก็ค่อย ๆ ลดลง
Dialogue: 0,0:19:37.28,0:19:40.53,Default,,0,0,0,,จนฉันเริ่มทำงานพาร์ตไทม์น่ะ
Dialogue: 0,0:19:46.41,0:19:49.08,Default,,0,0,0,,ไปโรงเรียน ทำพาร์ตไทม์ ดูแลพี่
Dialogue: 0,0:19:49.08,0:19:51.38,Default,,0,0,0,,ไปโรงเรียน ทำพาร์ตไทม์ ดูแลพี่
Dialogue: 0,0:19:52.05,0:19:54.09,Default,,0,0,0,,และยามที่ว่างฉันก็จะ…
Dialogue: 0,0:20:18.36,0:20:22.70,Default,,0,0,0,,แล้วพอปีนี้มา\Nอาการของพี่ก็แย่ลง
Dialogue: 0,0:20:36.84,0:20:38.09,Default,,0,0,0,,อะไรเหรอ
Dialogue: 0,0:20:39.84,0:20:43.60,Default,,0,0,0,,นี่อาจจะเป็นครั้งสุดท้าย
Dialogue: 0,0:20:43.60,0:20:47.81,Default,,0,0,0,,ที่ได้กลับมาที่บ้านก็ได้
Dialogue: 0,0:21:07.79,0:21:10.75,Default,,0,0,0,,โคชิบะ ขอบคุณที่ทำเป็นไม่ได้ยินนะ
Dialogue: 0,0:21:10.75,0:21:12.25,Default,,0,0,0,,หืม พูดอะไรน่ะ
Dialogue: 0,0:21:19.05,0:21:21.22,Default,,0,0,0,,เดี๋ยวฉันเลี้ยงกาแฟเธอนะ
Dialogue: 0,0:21:26.76,0:21:31.19,Default,,0,0,0,,รุ่นพี่ซาระ\Nขอบคุณที่เข้ากะดึกแทนมาก ๆ เลย
Dialogue: 0,0:21:34.11,0:21:36.52,Default,,0,0,0,,ฝากด้วยล่ะ โคชิบะ
Dialogue: 0,0:21:57.05,0:22:00.05,Default,,0,0,0,,(ไดอารี่ส์มอเตอร์ไซค์)\N(โปรดติดตามตอนต่อไป)
Dialogue: 0,0:23:30.05,0:23:35.11,Default,,0,0,0,,(ตอนต่อไป)\N(คำขอที่ยี่สิบเอ็ด ไดอารี่ส์มอเตอร์ไซค์ สอง)

