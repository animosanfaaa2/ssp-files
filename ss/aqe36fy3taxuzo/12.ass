Dialogue: 0,0:01:30.37,0:01:31.67,Default,,0,0,0,,Hoài niệm thật đấy.
Dialogue: 0,0:01:32.51,0:01:35.69,Default,,0,0,0,,Chị em mình duy trì cuốn nhật ký\Ntrao đổi này đến khi nào ấy nhỉ?
Dialogue: 0,0:01:36.55,0:01:38.17,Default,,0,0,0,,Mình đã luôn mong ngóng…
Dialogue: 0,0:01:38.46,0:01:40.11,Default,,0,0,0,,hồi âm của chị.
Dialogue: 0,0:01:41.03,0:01:42.55,Default,,0,0,0,,Em vẽ khéo quá.
Dialogue: 0,0:01:44.59,0:01:47.83,Default,,0,0,0,,Giờ mình cùng vẽ phần của\Nhôm nay nhé, ghi là đã đến biển rồi.
Dialogue: 0,0:01:48.78,0:01:50.13,Default,,0,0,0,,Nhé, Hikaru!
Dialogue: 0,0:01:50.67,0:01:52.67,Default,,0,0,0,,Chị đang cười kìa.
Dialogue: 0,0:01:53.16,0:01:54.53,Default,,0,0,0,,Vậy ra…
Dialogue: 0,0:01:57.28,0:02:00.39,Default,,0,0,0,,Vậy ra đây chỉ là một giấc mơ.
Dialogue: 0,0:02:22.66,0:02:25.96,Default,,0,0,0,,HIỆP HỘI HỘI HỌA TOÀN QUỐC\NGIẤY KHEN: GIẢI BẠC: MATSUKI HIKARU
Dialogue: 0,0:02:25.96,0:02:28.96,Default,,0,0,0,,1. PHI NHÂN TÍNH, QUÁI DỊ\N2. VÔ CẢM, KHÔNG CÓ TÍNH NGƯỜI\N3. MÁU LẠNH, TÀN NHẪN
Dialogue: 0,0:03:49.63,0:03:55.05,Default,,0,0,0,,KHÁCH SẠN INHUMANS
Dialogue: 0,0:04:10.02,0:04:14.48,Default,,0,0,0,,YÊU CẦU 20: NHẬT KÝ XE MÁY 1
Dialogue: 0,0:04:20.94,0:04:22.78,Default,,0,0,0,,Xin cảm ơn quý khách.
Dialogue: 0,0:04:25.71,0:04:27.91,Default,,0,0,0,,Thuốc lá lại tăng giá.
Dialogue: 0,0:04:29.37,0:04:31.36,Default,,0,0,0,,Vật giá dạo này bị sao vậy trời.
Dialogue: 0,0:04:31.66,0:04:33.08,Default,,0,0,0,,Thiệt là không để ai sống mà.
Dialogue: 0,0:04:33.78,0:04:34.96,Default,,0,0,0,,Hả?
Dialogue: 0,0:04:35.46,0:04:37.08,Default,,0,0,0,,Cho tôi số 27.
Dialogue: 0,0:04:37.52,0:04:38.58,Default,,0,0,0,,Dạ vâng.
Dialogue: 0,0:04:38.97,0:04:41.47,Default,,0,0,0,,THÁM TỬ SÁT THỦ\NXỔ SỐ NHÂN VẬT
Dialogue: 0,0:04:41.87,0:04:43.42,Default,,0,0,0,,Cho tôi bốc thăm một lần.
Dialogue: 0,0:04:44.45,0:04:45.41,Default,,0,0,0,,Lấy cái này đi.
Dialogue: 0,0:04:45.82,0:04:46.58,Default,,0,0,0,,Xin mời.
Dialogue: 0,0:04:49.93,0:04:53.02,Default,,0,0,0,,Chết dở! Quên ví ở nhà rồi!
Dialogue: 0,0:04:55.58,0:04:58.86,Default,,0,0,0,,Toàn bộ tài sản\Nchỉ có ngần này thôi sao?
Dialogue: 0,0:05:00.91,0:05:03.30,Default,,0,0,0,,Chọn cái nào bây giờ?
Dialogue: 0,0:05:04.53,0:05:06.24,Default,,0,0,0,,Xin lỗi ạ.
Dialogue: 0,0:05:06.24,0:05:08.91,Default,,0,0,0,,Xem ra anh mê\NThám tử Sát thủ nhỉ.
Dialogue: 0,0:05:09.92,0:05:10.98,Default,,0,0,0,,Không hẳn.
Dialogue: 0,0:05:10.98,0:05:12.22,Default,,0,0,0,,Bình thường thôi.
Dialogue: 0,0:05:12.79,0:05:15.20,Default,,0,0,0,,Tại cái bảng quảng cáo\Nvẽ trông cưng quá.
Dialogue: 0,0:05:17.52,0:05:20.80,Default,,0,0,0,,Tôi vốn chẳng thể kìm lòng\Ntrước mấy thứ dễ thương.
Dialogue: 0,0:05:20.80,0:05:23.18,Default,,0,0,0,,Ui, tính sao giờ…
Dialogue: 0,0:05:26.48,0:05:28.83,Default,,0,0,0,,Thôi khỏi mua thuốc lá nữa,\Nlấy cái này vậy…
Dialogue: 0,0:05:28.83,0:05:29.73,Default,,0,0,0,,Của anh đây.
Dialogue: 0,0:05:31.84,0:05:33.31,Default,,0,0,0,,Không phải cho không đâu.
Dialogue: 0,0:05:33.54,0:05:34.73,Default,,0,0,0,,Coi như cho vay.
Dialogue: 0,0:05:37.83,0:05:40.26,Default,,0,0,0,,Cái bảng quảng cáo đó là tôi vẽ.
Dialogue: 0,0:05:40.26,0:05:41.61,Default,,0,0,0,,Xem như chịu trách nhiệm đi.
Dialogue: 0,0:05:43.61,0:05:45.24,Default,,0,0,0,,Vậy tôi không khách sáo.
Dialogue: 0,0:05:45.94,0:05:47.80,Default,,0,0,0,,XIN CHÚC MỪNG - GIẢI SS\NVUI LÒNG ĐỔI THƯỞNG TẠI QUẦY
Dialogue: 0,0:05:47.80,0:05:48.70,Default,,0,0,0,,Giải SS này!
Dialogue: 0,0:05:48.70,0:05:50.70,Default,,0,0,0,,GIẢI SS: THÚ BÔNG
Dialogue: 0,0:05:50.70,0:05:52.61,Default,,0,0,0,,Dễ thương quá!
Dialogue: 0,0:05:52.61,0:05:54.02,Default,,0,0,0,,Siêu dễ thương luôn!
Dialogue: 0,0:05:54.02,0:05:55.97,Default,,0,0,0,,Cảm ơn nha!
Dialogue: 0,0:05:56.42,0:05:57.04,Default,,0,0,0,,À…
Dialogue: 0,0:05:59.28,0:06:00.80,Default,,0,0,0,,Cô Matsuki?
Dialogue: 0,0:06:00.80,0:06:02.64,Default,,0,0,0,,Tôi vui lắm luôn!
Dialogue: 0,0:06:03.24,0:06:04.46,Default,,0,0,0,,Vậy thì…
Dialogue: 0,0:06:07.62,0:06:10.47,Default,,0,0,0,,tạm thời phải đáp lễ cô\Nngay mới được.
Dialogue: 0,0:06:10.92,0:06:11.73,Default,,0,0,0,,Hả?
Dialogue: 0,0:06:11.73,0:06:13.46,Default,,0,0,0,,Chẳng phải anh đang không có tiền sao?
Dialogue: 0,0:06:13.82,0:06:14.50,Default,,0,0,0,,Ừ.
Dialogue: 0,0:06:14.50,0:06:16.02,Default,,0,0,0,,Đổi lại thì…
Dialogue: 0,0:06:25.47,0:06:26.50,Default,,0,0,0,,Xin lỗi anh!
Dialogue: 0,0:06:26.50,0:06:28.16,Default,,0,0,0,,Con bé chưa hiểu chuyện.
Dialogue: 0,0:06:28.62,0:06:30.80,Default,,0,0,0,,Chưa mua thì không được bóc đâu.
Dialogue: 0,0:06:33.77,0:06:34.77,Default,,0,0,0,,Xin lỗi anh ạ…
Dialogue: 0,0:06:34.77,0:06:36.11,Default,,0,0,0,,Thế này nhé.
Dialogue: 0,0:06:38.00,0:06:39.97,Default,,0,0,0,,Gói này anh mua cho.
Dialogue: 0,0:06:39.97,0:06:41.37,Default,,0,0,0,,Vừa vặn còn tiền lẻ.
Dialogue: 0,0:06:41.69,0:06:43.27,Default,,0,0,0,,- Dạ…\N- Không sao đâu.
Dialogue: 0,0:06:45.51,0:06:49.10,Default,,0,0,0,,Từ giờ trở đi, cố gắng\Nnắm chặt tay em gái mình nhé.
Dialogue: 0,0:06:53.06,0:06:55.73,Default,,0,0,0,,Chị ơi, nắm chặt tay em đi!
Dialogue: 0,0:06:55.73,0:06:57.06,Default,,0,0,0,,Coi kìa…
Dialogue: 0,0:06:58.54,0:07:00.04,Default,,0,0,0,,Thấy hoài niệm quá.
Dialogue: 0,0:07:00.48,0:07:02.56,Default,,0,0,0,,Ngày xưa tôi cũng giống vậy.
Dialogue: 0,0:07:03.98,0:07:04.92,Default,,0,0,0,,Chị gái tôi…
Dialogue: 0,0:07:05.22,0:07:08.49,Default,,0,0,0,,luôn nắm chặt tay tôi để không bị lạc.
Dialogue: 0,0:07:15.57,0:07:17.19,Default,,0,0,0,,À, cảm ơn anh nha.
Dialogue: 0,0:07:17.49,0:07:19.52,Default,,0,0,0,,Nãy tôi loay hoay chẳng để ý.
Dialogue: 0,0:07:20.15,0:07:24.50,Default,,0,0,0,,Cô Matsuki, sau này đừng có dễ dãi\Ncho người khác mượn tiền thế.
Dialogue: 0,0:07:26.19,0:07:27.68,Default,,0,0,0,,Vì không phải ai…
Dialogue: 0,0:07:27.68,0:07:30.12,Default,,0,0,0,,cũng là người tốt như tôi đâu.
Dialogue: 0,0:07:36.96,0:07:38.77,Default,,0,0,0,,Kỳ quặc thật.
Dialogue: 0,0:07:53.57,0:07:55.32,Default,,0,0,0,,Đáng yêu ghê!
Dialogue: 0,0:07:55.32,0:07:57.50,Default,,0,0,0,,Ủa? Cái thứ gì thế này?
Dialogue: 0,0:07:58.04,0:07:59.25,Default,,0,0,0,,Cấm đụng vào!
Dialogue: 0,0:07:59.25,0:08:00.38,Default,,0,0,0,,Vâng!
Dialogue: 0,0:08:05.28,0:08:08.18,Default,,0,0,0,,Xin chào quý khách.
Dialogue: 0,0:08:11.82,0:08:15.89,Default,,0,0,0,,Đồng 500 yên này, cứ cho tôi vay\Nđến khi quay hết đợt này nhé.
Dialogue: 0,0:08:16.32,0:08:18.51,Default,,0,0,0,,Cũng được thôi, nhưng để làm gì?
Dialogue: 0,0:08:18.93,0:08:20.19,Default,,0,0,0,,Lấy may ấy mà.
Dialogue: 0,0:08:21.58,0:08:22.61,Default,,0,0,0,,Giải A?
Dialogue: 0,0:08:22.61,0:08:24.59,Default,,0,0,0,,GIẢI A: THÚ BÔNG
Dialogue: 0,0:08:24.59,0:08:26.45,Default,,0,0,0,,Chúc mừng anh nhé!
Dialogue: 0,0:08:26.45,0:08:28.53,Default,,0,0,0,,Tuyệt vời! Dễ thương ghê!
Dialogue: 0,0:08:45.39,0:08:46.62,Default,,0,0,0,,Cô tan làm rồi à?
Dialogue: 0,0:08:46.96,0:08:47.84,Default,,0,0,0,,Ừ.
Dialogue: 0,0:08:47.84,0:08:49.54,Default,,0,0,0,,Có cần tôi đưa về không?
Dialogue: 0,0:08:50.24,0:08:54.89,Default,,0,0,0,,Ai đời lại leo lên xe máy\Ncủa người còn chẳng biết tên.
Dialogue: 0,0:08:55.50,0:08:56.82,Default,,0,0,0,,Kirihara Shiba.
Dialogue: 0,0:08:58.15,0:09:00.74,Default,,0,0,0,,Mọi người hay gọi tôi là Koshiba.
Dialogue: 0,0:09:01.04,0:09:03.14,Default,,0,0,0,,Ra thế, Koshiba ha.
Dialogue: 0,0:09:03.39,0:09:05.44,Default,,0,0,0,,Còn cô là Matsuki à?
Dialogue: 0,0:09:11.02,0:09:12.11,Default,,0,0,0,,Này!
Dialogue: 0,0:09:13.32,0:09:15.07,Default,,0,0,0,,Tên kỳ quặc.
Dialogue: 0,0:09:25.41,0:09:26.78,Default,,0,0,0,,XIN CHÚC MỪNG! GIẢI D\NVUI LÒNG ĐỔI THƯỞNG TẠI QUẦY
Dialogue: 0,0:09:26.78,0:09:27.80,Default,,0,0,0,,Giải D sao?
Dialogue: 0,0:09:27.80,0:09:29.02,Default,,0,0,0,,GIẢI D: THÚ BÔNG
Dialogue: 0,0:09:29.02,0:09:30.90,Default,,0,0,0,,Chúc mừng anh nhé!
Dialogue: 0,0:09:33.07,0:09:34.41,Default,,0,0,0,,Matsuki này.
Dialogue: 0,0:09:34.66,0:09:36.13,Default,,0,0,0,,Cái này mà dễ thương à?
Dialogue: 0,0:09:37.60,0:09:39.92,Default,,0,0,0,,Cứ coi như là dễ thương đi.
Dialogue: 0,0:09:40.72,0:09:41.92,Default,,0,0,0,,Hikaru.
Dialogue: 0,0:09:44.41,0:09:45.86,Default,,0,0,0,,Matsuki Hikaru.
Dialogue: 0,0:09:47.38,0:09:49.63,Default,,0,0,0,,Tên là Hikaru ha.
Dialogue: 0,0:09:57.21,0:09:59.65,Default,,0,0,0,,Anh cũng mang theo thứ đó à?
Dialogue: 0,0:10:00.96,0:10:03.87,Default,,0,0,0,,- Gạt tàn ấy.\N- Chuyện hiển nhiên mà.
Dialogue: 0,0:10:07.42,0:10:08.38,Default,,0,0,0,,Này!
Dialogue: 0,0:10:09.14,0:10:10.19,Default,,0,0,0,,Sao?
Dialogue: 0,0:10:10.19,0:10:12.76,Default,,0,0,0,,Koshiba làm nghề gì vậy?
Dialogue: 0,0:10:14.37,0:10:18.10,Default,,0,0,0,,Làm ở khách sạn,\Nphụ trách chăm sóc khách hàng.
Dialogue: 0,0:10:18.42,0:10:19.68,Default,,0,0,0,,Bất ngờ thật.
Dialogue: 0,0:10:20.66,0:10:21.68,Default,,0,0,0,,Sao thế?
Dialogue: 0,0:10:22.38,0:10:24.70,Default,,0,0,0,,Cứ nghĩ anh không phải\Nngười làm công ăn lương.
Dialogue: 0,0:10:24.98,0:10:26.13,Default,,0,0,0,,Thế à.
Dialogue: 0,0:10:26.34,0:10:28.27,Default,,0,0,0,,Tại thấy anh cứ ghé qua\Nbất kể ngày đêm.
Dialogue: 0,0:10:29.94,0:10:33.70,Default,,0,0,0,,Tại tôi làm theo ca,\Ncó ca sáng, ca tối mà.
Dialogue: 0,0:10:33.70,0:10:35.78,Default,,0,0,0,,Tính ra cũng giống\Ncửa hàng tiện lợi nhỉ.
Dialogue: 0,0:10:39.56,0:10:42.79,Default,,0,0,0,,Từ xưa Hikaru đã vẽ đẹp thế à?
Dialogue: 0,0:10:43.15,0:10:45.89,Default,,0,0,0,,Hồi xưa thì tôi cũng không biết nữa.
Dialogue: 0,0:10:46.67,0:10:49.80,Default,,0,0,0,,Dù chị gái lúc nào cũng khen tôi.
Dialogue: 0,0:10:50.21,0:10:52.00,Default,,0,0,0,,Chắc là khéo từ bé rồi.
Dialogue: 0,0:10:52.45,0:10:55.22,Default,,0,0,0,,Matsuki ơi, ra đứng quầy em ơi!
Dialogue: 0,0:10:55.22,0:10:56.34,Default,,0,0,0,,Dạ vâng!
Dialogue: 0,0:10:59.72,0:11:00.82,Default,,0,0,0,,Tôi đi đây.
Dialogue: 0,0:11:10.80,0:11:14.35,Default,,0,0,0,,Này nhá, mới hôm nọ\Ncó chừng này thôi mà?
Dialogue: 0,0:11:14.35,0:11:16.61,Default,,0,0,0,,Sao mỗi ngày một nhiều lên thế?
Dialogue: 0,0:11:17.04,0:11:21.24,Default,,0,0,0,,Koshiba vẫn mê\Nmấy món dễ thương như xưa nhỉ.
Dialogue: 0,0:11:22.74,0:11:26.82,Default,,0,0,0,,Chị vẫn nhớ sao ạ!\NQuả là tiền bối Sara!
Dialogue: 0,0:11:27.65,0:11:29.17,Default,,0,0,0,,Này! Ikuro!
Dialogue: 0,0:11:30.72,0:11:32.88,Default,,0,0,0,,Tôi đã bảo là\Ncấm đụng vào rồi cơ mà!
Dialogue: 0,0:11:33.22,0:11:36.13,Default,,0,0,0,,Koshiba này,\Nmấy cái này mua ở đâu vậy?
Dialogue: 0,0:11:36.88,0:11:38.10,Default,,0,0,0,,Cái này ấy hả,
Dialogue: 0,0:11:38.10,0:11:41.62,Default,,0,0,0,,ở một cửa hàng tiện lợi ruột của tôi,\Nchỗ có bảng vẽ quảng cáo dễ thương.
Dialogue: 0,0:11:46.67,0:11:48.37,Default,,0,0,0,,Anh trông giúp em một lát ạ.
Dialogue: 0,0:11:50.88,0:11:52.02,Default,,0,0,0,,Dạ!
Dialogue: 0,0:12:17.31,0:12:19.97,Default,,0,0,0,,MẤT DẤU HIỆU SINH TỒN
Dialogue: 0,0:12:26.56,0:12:30.06,Default,,0,0,0,,NHẬT KÝ TRANH
Dialogue: 0,0:12:31.53,0:12:34.07,Default,,0,0,0,,KHÁCH SẠN INHUMANS.
Dialogue: 0,0:12:41.29,0:12:42.69,Default,,0,0,0,,Em đi đây.
Dialogue: 0,0:12:53.22,0:12:54.56,Default,,0,0,0,,Xin chào quý khách!
Dialogue: 0,0:12:58.80,0:13:01.80,Default,,0,0,0,,BÉ BÁNH BAO THỊT\NNGON LẮM NHA!
Dialogue: 0,0:13:19.52,0:13:21.70,Default,,0,0,0,,Ơ kìa? Koshiba?
Dialogue: 0,0:13:25.42,0:13:27.25,Default,,0,0,0,,Anh lại đến à?
Dialogue: 0,0:13:27.49,0:13:29.64,Default,,0,0,0,,Mấy cái vé bốc thăm\Nđã hết sạch từ đời nào rồi.
Dialogue: 0,0:13:29.64,0:13:34.71,Default,,0,0,0,,À ừ, hết rồi nên tôi ghé qua trả lại tiền.
Dialogue: 0,0:13:34.71,0:13:36.35,Default,,0,0,0,,Vậy à.
Dialogue: 0,0:13:36.64,0:13:38.42,Default,,0,0,0,,Tôi cũng…
Dialogue: 0,0:13:39.64,0:13:41.34,Default,,0,0,0,,vừa xong cả rồi.
Dialogue: 0,0:13:43.24,0:13:44.80,Default,,0,0,0,,Vừa đi hỏa táng về.
Dialogue: 0,0:13:44.80,0:13:45.97,Default,,0,0,0,,Cho chị tôi.
Dialogue: 0,0:13:46.44,0:13:49.47,Default,,0,0,0,,Tôi mặc đồ tang thế này\Nlàm anh khó hỏi đúng không?
Dialogue: 0,0:13:50.49,0:13:52.59,Default,,0,0,0,,Nên tôi tự khai luôn cho nhanh.
Dialogue: 0,0:13:56.91,0:13:58.42,Default,,0,0,0,,Tôi ổn mà.
Dialogue: 0,0:13:58.87,0:14:02.13,Default,,0,0,0,,Dù sao tôi cũng biết chị ấy\Nkhông còn sống được bao lâu.
Dialogue: 0,0:14:02.13,0:14:04.16,Default,,0,0,0,,Cũng đã chuẩn bị tinh thần\Ntừ lâu rồi.
Dialogue: 0,0:14:04.69,0:14:08.44,Default,,0,0,0,,Nhưng mà, hỏa táng xong,\Nlúc bước chân về đến nhà…
Dialogue: 0,0:14:09.45,0:14:11.79,Default,,0,0,0,,Mọi thứ cứ trống rỗng vậy.
Dialogue: 0,0:14:13.00,0:14:16.00,Default,,0,0,0,,Trước giờ chị ấy\Ncứ ra viện rồi lại vào viện.
Dialogue: 0,0:14:16.52,0:14:20.51,Default,,0,0,0,,Nào là giặt giũ quần áo,\Ntheo dõi giờ uống thuốc…
Dialogue: 0,0:14:20.51,0:14:23.89,Default,,0,0,0,,Giờ bỗng dưng chẳng còn việc gì\Nđể làm nữa,
Dialogue: 0,0:14:23.89,0:14:27.07,Default,,0,0,0,,tôi thực sự không biết\Nmình phải làm gì tiếp theo.
Dialogue: 0,0:14:27.91,0:14:32.16,Default,,0,0,0,,Nên tôi mới nghĩ đi làm thêm\Nđể vận động chân tay chút.
Dialogue: 0,0:14:34.94,0:14:36.48,Default,,0,0,0,,CÓ TIN NHẮN MỚI
Dialogue: 0,0:14:50.02,0:14:51.58,Default,,0,0,0,,Này, Koshiba.
Dialogue: 0,0:14:53.02,0:14:55.71,Default,,0,0,0,,Số tiền vay không cần trả đâu.
Dialogue: 0,0:14:56.26,0:14:59.20,Default,,0,0,0,,Đổi lại, tôi có một thỉnh cầu.
Dialogue: 0,0:15:00.58,0:15:01.73,Default,,0,0,0,,Đi biển đi.
Dialogue: 0,0:15:02.44,0:15:03.42,Default,,0,0,0,,Biển sao?
Dialogue: 0,0:15:03.66,0:15:05.97,Default,,0,0,0,,Hãy đưa tôi ra biển.
Dialogue: 0,0:15:18.04,0:15:19.18,Default,,0,0,0,,Đi thôi.
Dialogue: 0,0:15:50.79,0:15:51.84,Default,,0,0,0,,Này!
Dialogue: 0,0:15:51.84,0:15:53.89,Default,,0,0,0,,Sao tự dưng lại đòi ra biển?
Dialogue: 0,0:15:54.16,0:15:56.98,Default,,0,0,0,,Hả? Gì cơ? Không nghe thấy!
Dialogue: 0,0:15:58.62,0:16:01.93,Default,,0,0,0,,Tôi! Hỏi! Là! Tại! Sao!
Dialogue: 0,0:16:01.93,0:16:05.31,Default,,0,0,0,,Ôi! Gió mát đã quá đi!
Dialogue: 0,0:16:06.44,0:16:09.82,Default,,0,0,0,,Này, có nghe tôi nói không đấy?
Dialogue: 0,0:16:11.35,0:16:12.81,Default,,0,0,0,,Nhật ký tranh!
Dialogue: 0,0:16:12.81,0:16:13.79,Default,,0,0,0,,Hả?
Dialogue: 0,0:16:14.09,0:16:15.39,Default,,0,0,0,,Không nghe thấy gì hết!
Dialogue: 0,0:16:15.99,0:16:17.37,Default,,0,0,0,,Nhật ký tranh!
Dialogue: 0,0:16:18.29,0:16:20.89,Default,,0,0,0,,Hồi bé tôi với chị hay…
Dialogue: 0,0:16:20.89,0:16:23.62,Default,,0,0,0,,viết chung một cuốn nhật ký tranh.
Dialogue: 0,0:16:23.92,0:16:27.78,Default,,0,0,0,,Trang nhật ký ấy dừng lại\Nđúng vào ngày hai chị em đi biển.
Dialogue: 0,0:16:29.49,0:16:34.29,Default,,0,0,0,,Tôi muốn nhớ lại xem vì sao\Nlại dừng lại ở đúng ngày hôm đó!
Dialogue: 0,0:16:35.89,0:16:37.11,Default,,0,0,0,,Úi giời!
Dialogue: 0,0:16:37.11,0:16:37.93,Default,,0,0,0,,Xin lỗi!
Dialogue: 0,0:16:38.45,0:16:40.21,Default,,0,0,0,,Nên cô mới đòi ra biển à.
Dialogue: 0,0:16:40.69,0:16:44.65,Default,,0,0,0,,Thì giờ đâu thể hỏi\Ntrực tiếp chị ấy nữa đâu.
Dialogue: 0,0:16:45.35,0:16:46.49,Default,,0,0,0,,Cũng phải.
Dialogue: 0,0:16:49.83,0:16:51.42,Default,,0,0,0,,Mà nói thật, Koshiba này.
Dialogue: 0,0:16:51.78,0:16:53.36,Default,,0,0,0,,Anh dễ dãi thật đấy.
Dialogue: 0,0:16:53.92,0:16:56.02,Default,,0,0,0,,Nửa đêm thế này\Nmà còn chịu ra biển.
Dialogue: 0,0:16:56.56,0:16:58.33,Default,,0,0,0,,Bình thường người ta sẽ từ chối.
Dialogue: 0,0:16:58.64,0:17:00.52,Default,,0,0,0,,Tôi chỉ đang trả nợ thôi.
Dialogue: 0,0:17:01.24,0:17:02.40,Default,,0,0,0,,Cơ mà,
Dialogue: 0,0:17:02.74,0:17:06.24,Default,,0,0,0,,hoá ra chính cô cũng tự biết\Nviệc này chẳng bình thường à.
Dialogue: 0,0:17:09.42,0:17:10.87,Default,,0,0,0,,Đúng là kỳ quặc.
Dialogue: 0,0:17:18.52,0:17:20.52,Default,,0,0,0,,Tại bảng quảng cáo\Nvẽ trông cưng quá mà.
Dialogue: 0,0:17:22.02,0:17:25.24,Default,,0,0,0,,Tôi vốn chẳng kìm lòng được\Ntrước mấy thứ dễ thương.
Dialogue: 0,0:17:25.24,0:17:27.38,Default,,0,0,0,,Tính sao giờ?
Dialogue: 0,0:17:29.34,0:17:30.64,Default,,0,0,0,,Tôi bảo này.
Dialogue: 0,0:17:30.64,0:17:33.99,Default,,0,0,0,,Những điều tôi sắp nói\Nanh đừng nghe nhé.
Dialogue: 0,0:17:35.82,0:17:37.11,Default,,0,0,0,,Là sao?
Dialogue: 0,0:17:37.11,0:17:38.66,Default,,0,0,0,,Tôi chẳng nghe thấy gì hết.
Dialogue: 0,0:17:41.68,0:17:48.59,Default,,0,0,0,,Chị gái của tôi tên là Mitsuru,\Nchị ấy vẽ tranh đẹp cực kỳ.
Dialogue: 0,0:17:49.74,0:17:51.33,Default,,0,0,0,,Chị về rồi đây.
Dialogue: 0,0:17:51.33,0:17:53.34,Default,,0,0,0,,Chị ơi! Chị ơi!
Dialogue: 0,0:17:54.68,0:17:56.33,Default,,0,0,0,,Chị nhìn này! Em được giải rồi!
Dialogue: 0,0:17:56.33,0:17:58.35,Default,,0,0,0,,Giải Bạc cuộc thi vẽ tranh!
Dialogue: 0,0:18:03.15,0:18:04.95,Default,,0,0,0,,Giỏi quá ta!
Dialogue: 0,0:18:04.95,0:18:07.50,Default,,0,0,0,,Cơ mà vẫn thua Giải Vàng của chị.
Dialogue: 0,0:18:07.50,0:18:10.43,Default,,0,0,0,,Chị đã bảo hội họa\Nkhông phân thắng bại mà.
Dialogue: 0,0:18:10.73,0:18:14.31,Default,,0,0,0,,Người ẵm Giải Vàng mà nói câu đó\Nnghe cú như trêu em ấy.
Dialogue: 0,0:18:14.31,0:18:15.56,Default,,0,0,0,,Thế á?
Dialogue: 0,0:18:15.56,0:18:17.60,Default,,0,0,0,,Chứ còn sao nữa.
Dialogue: 0,0:18:19.64,0:18:22.00,Default,,0,0,0,,Chị là chị thích tranh của Hikaru\Nnhất trên đời đấy.
Dialogue: 0,0:18:24.27,0:18:26.46,Default,,0,0,0,,Sau này em tiếp tục vẽ\Nthật nhiều nữa nhé.
Dialogue: 0,0:18:37.80,0:18:39.18,Default,,0,0,0,,KHÚC CA HOA LỒNG ĐÈN
Dialogue: 0,0:18:41.81,0:18:44.31,Default,,0,0,0,,TRANH BÌA & MINH HỌA\NMATSUKI MITSURU
Dialogue: 0,0:18:45.85,0:18:47.81,Default,,0,0,0,,Mình cũng phải cố gắng lên mới được.
Dialogue: 0,0:18:50.37,0:18:53.40,Default,,0,0,0,,Chị ơi! Điện thoại kêu này!
Dialogue: 0,0:18:57.40,0:18:58.58,Default,,0,0,0,,Chị ơi…
Dialogue: 0,0:19:07.98,0:19:09.75,Default,,0,0,0,,Nhiều nhất là được 2 năm.
Dialogue: 0,0:19:10.20,0:19:11.98,Default,,0,0,0,,Còn biến chuyển thì…
Dialogue: 0,0:19:13.26,0:19:14.58,Default,,0,0,0,,Kể từ mùa hè năm ấy,
Dialogue: 0,0:19:14.98,0:19:18.30,Default,,0,0,0,,chị cứ phải đi đi về về\Ngiữa nhà và bệnh viện.
Dialogue: 0,0:19:33.78,0:19:36.36,Default,,0,0,0,,Tiền tiết kiệm cứ cạn dần.
Dialogue: 0,0:19:37.58,0:19:38.63,Default,,0,0,0,,Tôi…
Dialogue: 0,0:19:38.63,0:19:40.53,Default,,0,0,0,,bắt đầu đi làm thêm.
Dialogue: 0,0:19:46.37,0:19:48.95,Default,,0,0,0,,Đi học, đi làm, rồi chăm bệnh.
Dialogue: 0,0:19:48.95,0:19:51.38,Default,,0,0,0,,Đi học, đi làm, rồi lại chăm bệnh.
Dialogue: 0,0:19:52.14,0:19:54.27,Default,,0,0,0,,Xen giữa những lúc ấy là tôi lại…
Dialogue: 0,0:20:18.15,0:20:22.70,Default,,0,0,0,,Đến năm nay thì bệnh tình trở nặng.
Dialogue: 0,0:20:36.84,0:20:38.09,Default,,0,0,0,,Gì ạ?
Dialogue: 0,0:20:39.73,0:20:47.81,Default,,0,0,0,,Có lẽ đây là… lần cuối…\Nchị được về nhà… cũng nên.
Dialogue: 0,0:21:07.69,0:21:10.71,Default,,0,0,0,,Koshiba, cảm ơn anh\Nvì đã không nghe nhé.
Dialogue: 0,0:21:10.71,0:21:12.25,Default,,0,0,0,,Hử? Chuyện gì cơ?
Dialogue: 0,0:21:19.04,0:21:21.22,Default,,0,0,0,,Tôi khao anh lon cà phê nhé.
Dialogue: 0,0:21:26.82,0:21:28.31,Default,,0,0,0,,Tiền bối Sara.
Dialogue: 0,0:21:28.31,0:21:31.19,Default,,0,0,0,,Cảm ơn chị đã nhận\Ntrực ca đêm thay em.
Dialogue: 0,0:21:34.00,0:21:36.52,Default,,0,0,0,,Trông cậy cả vào em đấy, Koshiba.
Dialogue: 0,0:21:57.05,0:22:00.05,Default,,0,0,0,,NHẬT KÝ XE MÁY\NCÒN TIẾP
Dialogue: 0,0:23:30.05,0:23:35.06,Default,,0,0,0,,TẬP SAU: YÊU CẦU 21:\NNHẬT KÝ XE MÁY 2

