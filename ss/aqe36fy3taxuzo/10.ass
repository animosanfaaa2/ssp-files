Dialogue: 0,0:01:30.42,0:01:31.84,Default,,0,0,0,,Penuh kenangan.
Dialogue: 0,0:01:32.47,0:01:35.64,Default,,0,0,0,,Sudah berapa lama pertukaran\Nbuku harian ini berlangsung?
Dialogue: 0,0:01:36.51,0:01:40.23,Default,,0,0,0,,Aku selalu menantikan balasan kakakku.
Dialogue: 0,0:01:41.02,0:01:42.52,Default,,0,0,0,,(BUKU HARIAN BERGAMBAR)\NKau pandai menggambar.
Dialogue: 0,0:01:44.56,0:01:46.44,Default,,0,0,0,,Mari menggambar untuk catatan hari ini.
Dialogue: 0,0:01:46.52,0:01:48.07,Default,,0,0,0,,Kita gambar tentang pergi ke pantai.
Dialogue: 0,0:01:48.78,0:01:50.28,Default,,0,0,0,,Ya, Hikaru?
Dialogue: 0,0:01:50.69,0:01:53.03,Default,,0,0,0,,Kakakku tersenyum.
Dialogue: 0,0:01:53.11,0:01:54.53,Default,,0,0,0,,Jadi, ini…
Dialogue: 0,0:01:57.45,0:02:00.37,Default,,0,0,0,,Jadi, ini mimpi.
Dialogue: 0,0:02:23.64,0:02:25.85,Default,,0,0,0,,(SERTIFIKAT PENGHARGAAN SENI)\N(JUARA KEDUA, HIKARU MATSUKI)
Dialogue: 0,0:02:25.94,0:02:26.77,Default,,0,0,0,,(INHUMAN)
Dialogue: 0,0:02:26.86,0:02:28.11,Default,,0,0,0,,(1. TIDAK MANUSIAWI, BAGAI MONSTER)\N(2. TIDAK HANGAT ATAU EMPATI)
Dialogue: 0,0:02:28.19,0:02:29.02,Default,,0,0,0,,(3. DINGIN DAN KEJAM)
Dialogue: 0,0:03:50.19,0:03:54.53,Default,,0,0,0,,HOTEL INHUMANS
Dialogue: 0,0:04:10.25,0:04:14.42,Default,,0,0,0,,(FESTIVAL PENCUCI MULUT) (PERMINTAAN 20:\NJURNAL PERJALANAN SEPEDA MOTOR, BAGIAN 1)
Dialogue: 0,0:04:21.05,0:04:22.89,Default,,0,0,0,,Terima kasih, silakan datang lagi.
Dialogue: 0,0:04:24.85,0:04:27.56,Default,,0,0,0,,Harga rokok naik lagi?
Dialogue: 0,0:04:29.35,0:04:31.56,Default,,0,0,0,,Ada apa dengan harga-harga belakangan ini?
Dialogue: 0,0:04:31.65,0:04:32.94,Default,,0,0,0,,Yang benar saja.
Dialogue: 0,0:04:35.48,0:04:37.49,Default,,0,0,0,,Nomor 27, tolong.
Dialogue: 0,0:04:37.57,0:04:38.74,Default,,0,0,0,,Baik.
Dialogue: 0,0:04:38.95,0:04:41.45,Default,,0,0,0,,(DETEKTIF PEMBUNUH)\N(UNDIAN KARAKTER REKOMENDASI STAF)
Dialogue: 0,0:04:41.99,0:04:43.53,Default,,0,0,0,,Sekalian satu undian untuk ini.
Dialogue: 0,0:04:44.53,0:04:45.37,Default,,0,0,0,,Yang ini, bukan?
Dialogue: 0,0:04:45.45,0:04:46.29,Default,,0,0,0,,(UNDIAN KARAKTER)\NSilakan.
Dialogue: 0,0:04:46.37,0:04:47.20,Default,,0,0,0,,(UNDIAN KARAKTER)\NSilakan.
Dialogue: 0,0:04:49.92,0:04:53.21,Default,,0,0,0,,Tidak mungkin. Aku lupa dompetku!
Dialogue: 0,0:04:55.96,0:04:58.97,Default,,0,0,0,,Hanya ini uang yang kumiliki?
Dialogue: 0,0:05:01.05,0:05:02.97,Default,,0,0,0,,Mana yang harus kupilih?
Dialogue: 0,0:05:05.06,0:05:06.39,Default,,0,0,0,,Maafkan aku.
Dialogue: 0,0:05:06.47,0:05:09.18,Default,,0,0,0,,Kau pasti sangat suka Detektif Pembunuh.
Dialogue: 0,0:05:11.27,0:05:12.48,Default,,0,0,0,,Tidak juga.
Dialogue: 0,0:05:13.36,0:05:15.57,Default,,0,0,0,,(DETEKTIF PEMBUNUH) (UNDIAN KARAKTER)\NItu karena papan tandanya menggemaskan.
Dialogue: 0,0:05:17.61,0:05:20.82,Default,,0,0,0,,Aku punya kelemahan\Nterhadap hal menggemaskan.
Dialogue: 0,0:05:20.90,0:05:23.16,Default,,0,0,0,,Bagaimana ini?
Dialogue: 0,0:05:26.70,0:05:28.12,Default,,0,0,0,,Sebenarnya, lupakan rokoknya.
Dialogue: 0,0:05:28.20,0:05:29.04,Default,,0,0,0,,Aku akan mengambil ini…
Dialogue: 0,0:05:29.12,0:05:29.96,Default,,0,0,0,,Ini.
Dialogue: 0,0:05:31.83,0:05:34.63,Default,,0,0,0,,Aku bukan memberikannya kepadamu,\Naku meminjamkannya.
Dialogue: 0,0:05:37.80,0:05:40.17,Default,,0,0,0,,Karena aku yang menggambar tanda itu,
Dialogue: 0,0:05:40.26,0:05:41.88,Default,,0,0,0,,aku merasa bertanggung jawab.
Dialogue: 0,0:05:43.93,0:05:45.55,Default,,0,0,0,,Kalau begitu, kuterima tawaranmu.
Dialogue: 0,0:05:46.14,0:05:47.76,Default,,0,0,0,,(SELAMAT, HADIAH SS)\N(SILAKAN DITEBUS DI KONTER)
Dialogue: 0,0:05:47.85,0:05:48.72,Default,,0,0,0,,Hadiah SS!
Dialogue: 0,0:05:48.81,0:05:50.64,Default,,0,0,0,,(BONEKA HADIAH SS)
Dialogue: 0,0:05:51.23,0:05:52.60,Default,,0,0,0,,Menggemaskan sekali!
Dialogue: 0,0:05:52.69,0:05:54.06,Default,,0,0,0,,Sangat menggemaskan!
Dialogue: 0,0:05:54.15,0:05:55.94,Default,,0,0,0,,Terima kasih!
Dialogue: 0,0:05:56.48,0:05:57.52,Default,,0,0,0,,Nona…
Dialogue: 0,0:05:58.11,0:05:59.28,Default,,0,0,0,,(MATSUKI)
Dialogue: 0,0:05:59.36,0:06:00.69,Default,,0,0,0,,Nona Matsuki.
Dialogue: 0,0:06:01.11,0:06:02.82,Default,,0,0,0,,Aku senang sekali.
Dialogue: 0,0:06:03.24,0:06:04.45,Default,,0,0,0,,Begini…
Dialogue: 0,0:06:07.91,0:06:11.12,Default,,0,0,0,,Bagaimanapun, aku harus mencari cara\Nuntuk membalas budimu.
Dialogue: 0,0:06:11.20,0:06:13.67,Default,,0,0,0,,Tapi kau tidak punya uang sekarang?
Dialogue: 0,0:06:14.54,0:06:15.96,Default,,0,0,0,,Sebagai gantinya…
Dialogue: 0,0:06:25.43,0:06:28.10,Default,,0,0,0,,Maaf, dia tidak tahu apa-apa.
Dialogue: 0,0:06:28.64,0:06:31.02,Default,,0,0,0,,Kau tidak boleh membukanya\Nsebelum membelinya.
Dialogue: 0,0:06:33.77,0:06:36.02,Default,,0,0,0,,- Aku sungguh minta maaf.\N- Bagaimana kalau begini?
Dialogue: 0,0:06:38.11,0:06:41.07,Default,,0,0,0,,Aku yang belikan. Aku ada uang kecil.
Dialogue: 0,0:06:41.65,0:06:43.28,Default,,0,0,0,,- Begini…\N- Tidak apa-apa.
Dialogue: 0,0:06:45.53,0:06:49.12,Default,,0,0,0,,Mulai sekarang,\Npegang tangannya sebisa mungkin.
Dialogue: 0,0:06:53.08,0:06:55.83,Default,,0,0,0,,Pegang tanganku, ya?
Dialogue: 0,0:06:55.92,0:06:56.92,Default,,0,0,0,,Astaga.
Dialogue: 0,0:06:58.50,0:07:00.30,Default,,0,0,0,,Aku ingat sekarang.
Dialogue: 0,0:07:00.38,0:07:02.63,Default,,0,0,0,,Aku juga seperti itu.
Dialogue: 0,0:07:03.97,0:07:06.30,Default,,0,0,0,,Kakakku selalu memegang erat tanganku
Dialogue: 0,0:07:06.38,0:07:08.72,Default,,0,0,0,,agar aku tidak tersesat.
Dialogue: 0,0:07:15.73,0:07:17.44,Default,,0,0,0,,Terima kasih.
Dialogue: 0,0:07:17.52,0:07:19.56,Default,,0,0,0,,Aku sama sekali tidak menyadarinya.
Dialogue: 0,0:07:20.15,0:07:21.52,Default,,0,0,0,,Nona Matsuki.
Dialogue: 0,0:07:21.61,0:07:24.49,Default,,0,0,0,,Jangan meminjamkan uang\Nkepada orang lain semudah itu.
Dialogue: 0,0:07:26.24,0:07:30.41,Default,,0,0,0,,Tidak semua orang baik sepertiku.
Dialogue: 0,0:07:37.04,0:07:38.46,Default,,0,0,0,,Orang aneh.
Dialogue: 0,0:07:53.89,0:07:55.27,Default,,0,0,0,,Ini menggemaskan, bukan?
Dialogue: 0,0:07:55.35,0:07:56.18,Default,,0,0,0,,Apa?
Dialogue: 0,0:07:56.27,0:07:57.94,Default,,0,0,0,,Apa ini?
Dialogue: 0,0:07:58.02,0:07:59.31,Default,,0,0,0,,Jangan sentuh!
Dialogue: 0,0:07:59.40,0:08:00.40,Default,,0,0,0,,Baik!
Dialogue: 0,0:08:05.24,0:08:07.07,Default,,0,0,0,,Selamat datang.
Dialogue: 0,0:08:11.83,0:08:13.37,Default,,0,0,0,,Uang 500 yen ini…
Dialogue: 0,0:08:13.95,0:08:16.37,Default,,0,0,0,,Pinjamkan kepadaku\Nsampai aku memenangkan semuanya.
Dialogue: 0,0:08:16.45,0:08:18.50,Default,,0,0,0,,Tentu, tapi kenapa?
Dialogue: 0,0:08:19.21,0:08:20.21,Default,,0,0,0,,Untuk keberuntungan.
Dialogue: 0,0:08:21.79,0:08:22.63,Default,,0,0,0,,Hadiah.
Dialogue: 0,0:08:22.71,0:08:24.75,Default,,0,0,0,,(BONEKA HADIAH)
Dialogue: 0,0:08:24.84,0:08:26.42,Default,,0,0,0,,Selamat.
Dialogue: 0,0:08:26.51,0:08:28.68,Default,,0,0,0,,Hore! Menggemaskan sekali.
Dialogue: 0,0:08:45.61,0:08:46.94,Default,,0,0,0,,Kau sudah pulang?
Dialogue: 0,0:08:47.03,0:08:47.90,Default,,0,0,0,,Ya.
Dialogue: 0,0:08:48.19,0:08:49.53,Default,,0,0,0,,Aku akan mengantarmu pulang.
Dialogue: 0,0:08:50.45,0:08:54.78,Default,,0,0,0,,Aku tidak bisa naik sepeda motor\Ndengan orang yang namanya tidak kukenal.
Dialogue: 0,0:08:55.45,0:08:56.91,Default,,0,0,0,,Shiba Kirihara.
Dialogue: 0,0:08:58.16,0:09:01.00,Default,,0,0,0,,Orang yang dekat denganku\Nmemanggilku Koshiba.
Dialogue: 0,0:09:02.00,0:09:03.42,Default,,0,0,0,,Koshiba, ya?
Dialogue: 0,0:09:03.50,0:09:05.67,Default,,0,0,0,,Kau Matsuki?
Dialogue: 0,0:09:11.09,0:09:12.09,Default,,0,0,0,,Hei!
Dialogue: 0,0:09:13.51,0:09:15.10,Default,,0,0,0,,Orang aneh.
Dialogue: 0,0:09:25.82,0:09:26.69,Default,,0,0,0,,(SELAMAT! HADIAH D)\N(DITEBUS DI KONTER)
Dialogue: 0,0:09:26.78,0:09:27.69,Default,,0,0,0,,Hadiah D.
Dialogue: 0,0:09:27.78,0:09:28.99,Default,,0,0,0,,(BONEKA HADIAH D)
Dialogue: 0,0:09:29.07,0:09:30.86,Default,,0,0,0,,Selamat.
Dialogue: 0,0:09:33.36,0:09:36.37,Default,,0,0,0,,Nona Matsuki, apa ini menggemaskan?
Dialogue: 0,0:09:37.83,0:09:39.91,Default,,0,0,0,,Anggap saja begitu.
Dialogue: 0,0:09:40.79,0:09:41.96,Default,,0,0,0,,Hikaru.
Dialogue: 0,0:09:44.54,0:09:45.88,Default,,0,0,0,,Namaku Hikaru Matsuki.
Dialogue: 0,0:09:47.50,0:09:49.46,Default,,0,0,0,,Kalau begitu, Hikaru.
Dialogue: 0,0:09:57.22,0:09:59.35,Default,,0,0,0,,Kau juga punya ini?
Dialogue: 0,0:09:59.43,0:10:01.02,Default,,0,0,0,,(PARL MART 8)\N(FESTIVAL PENCUCI MULUT)
Dialogue: 0,0:10:01.10,0:10:02.39,Default,,0,0,0,,Asbak.
Dialogue: 0,0:10:02.48,0:10:03.98,Default,,0,0,0,,Bukankah itu masuk akal?
Dialogue: 0,0:10:10.49,0:10:12.70,Default,,0,0,0,,Apa pekerjaanmu?
Dialogue: 0,0:10:14.49,0:10:18.24,Default,,0,0,0,,Aku bekerja di hotel. Aku pramutamu.
Dialogue: 0,0:10:18.58,0:10:19.70,Default,,0,0,0,,Mengejutkan sekali.
Dialogue: 0,0:10:20.66,0:10:21.66,Default,,0,0,0,,Kenapa?
Dialogue: 0,0:10:22.50,0:10:24.96,Default,,0,0,0,,Aku tidak menduga kau pegawai biasa.
Dialogue: 0,0:10:25.04,0:10:26.33,Default,,0,0,0,,Begitukah?
Dialogue: 0,0:10:26.42,0:10:28.55,Default,,0,0,0,,Karena kau selalu datang ke sini.
Dialogue: 0,0:10:30.00,0:10:31.92,Default,,0,0,0,,Itu karena aku bekerja dalam sif.
Dialogue: 0,0:10:32.01,0:10:33.55,Default,,0,0,0,,Ada sif pagi dan malam.
Dialogue: 0,0:10:33.93,0:10:35.89,Default,,0,0,0,,Itu tidak jauh berbeda dari minimarket.
Dialogue: 0,0:10:39.81,0:10:42.77,Default,,0,0,0,,Apa kau selalu pandai menggambar?
Dialogue: 0,0:10:43.69,0:10:45.98,Default,,0,0,0,,Aku tak yakin begitu,
Dialogue: 0,0:10:47.02,0:10:49.61,Default,,0,0,0,,tapi kakakku selalu memujiku.
Dialogue: 0,0:10:50.40,0:10:51.99,Default,,0,0,0,,Kalau begitu, kau pasti sangat hebat.
Dialogue: 0,0:10:52.74,0:10:55.24,Default,,0,0,0,,Nona Matsuki, tolong kasirnya.
Dialogue: 0,0:10:55.32,0:10:56.32,Default,,0,0,0,,Aku datang!
Dialogue: 0,0:10:59.83,0:11:00.95,Default,,0,0,0,,Sampai nanti.
Dialogue: 0,0:11:08.38,0:11:10.38,Default,,0,0,0,,(DETEKTIF PEMBUNUH)
Dialogue: 0,0:11:10.75,0:11:12.09,Default,,0,0,0,,Hei.
Dialogue: 0,0:11:12.17,0:11:14.34,Default,,0,0,0,,Kau baru punya ini\Nbeberapa waktu lalu, kan?
Dialogue: 0,0:11:14.42,0:11:16.72,Default,,0,0,0,,Kenapa jumlahnya bertambah setiap hari?
Dialogue: 0,0:11:17.34,0:11:21.22,Default,,0,0,0,,Kau masih menyukai\Nbarang menggemaskan seperti dahulu.
Dialogue: 0,0:11:22.89,0:11:26.98,Default,,0,0,0,,Kau ingat? Seperti yang diharapkan\Ndari Sara-senpai!
Dialogue: 0,0:11:27.85,0:11:29.52,Default,,0,0,0,,Hei, Ikuro.
Dialogue: 0,0:11:30.73,0:11:33.11,Default,,0,0,0,,Bukankah sudah kubilang\Njangan menyentuhnya?
Dialogue: 0,0:11:33.19,0:11:36.20,Default,,0,0,0,,Nona Koshiba, di mana kau membeli ini?
Dialogue: 0,0:11:36.91,0:11:39.74,Default,,0,0,0,,Di minimarket yang kusukai.
Dialogue: 0,0:11:39.82,0:11:41.66,Default,,0,0,0,,Toko dengan papan tanda menggemaskan.
Dialogue: 0,0:11:46.83,0:11:48.46,Default,,0,0,0,,(BAKPAO DAGING ENAK)\NMaaf, aku harus menjawab telepon.
Dialogue: 0,0:11:50.92,0:11:51.92,Default,,0,0,0,,Ya.
Dialogue: 0,0:12:18.40,0:12:19.95,Default,,0,0,0,,(TIDAK ADA TANDA-TANDA VITAL)
Dialogue: 0,0:12:26.62,0:12:30.00,Default,,0,0,0,,(BUKU HARIAN BERGAMBAR)
Dialogue: 0,0:12:31.88,0:12:34.05,Default,,0,0,0,,HOTEL INHUMANS
Dialogue: 0,0:12:41.47,0:12:42.68,Default,,0,0,0,,Aku pergi dulu.
Dialogue: 0,0:12:46.31,0:12:49.23,Default,,0,0,0,,(PARL MART 8)\N(FESTIVAL PENCUCI MULUT)
Dialogue: 0,0:12:53.48,0:12:54.73,Default,,0,0,0,,Selamat datang!
Dialogue: 0,0:12:58.78,0:13:01.70,Default,,0,0,0,,(BAKPAO DAGING ENAK)
Dialogue: 0,0:13:05.83,0:13:07.12,Default,,0,0,0,,Dingin sekali.
Dialogue: 0,0:13:19.72,0:13:21.76,Default,,0,0,0,,Koshiba?
Dialogue: 0,0:13:25.60,0:13:27.35,Default,,0,0,0,,Kau kembali lagi.
Dialogue: 0,0:13:27.43,0:13:29.68,Default,,0,0,0,,Undiannya sudah berakhir.
Dialogue: 0,0:13:30.69,0:13:32.19,Default,,0,0,0,,Karena sudah berakhir,
Dialogue: 0,0:13:32.27,0:13:34.73,Default,,0,0,0,,aku ingin mengembalikan uang\Nyang kupinjam.
Dialogue: 0,0:13:35.11,0:13:36.27,Default,,0,0,0,,Begitu rupanya.
Dialogue: 0,0:13:36.77,0:13:41.32,Default,,0,0,0,,Bagiku juga sudah berakhir.
Dialogue: 0,0:13:43.32,0:13:46.12,Default,,0,0,0,,Aku baru saja mengkremasi kakakku.
Dialogue: 0,0:13:46.49,0:13:47.74,Default,,0,0,0,,Lihat? Aku mengenakan pakaian berkabung.
Dialogue: 0,0:13:47.83,0:13:49.29,Default,,0,0,0,,Topik ini agak sensitif, ya?
Dialogue: 0,0:13:50.58,0:13:52.54,Default,,0,0,0,,Jadi, biar aku sendiri\Nyang merusak suasana.
Dialogue: 0,0:13:57.05,0:13:58.46,Default,,0,0,0,,Tidak apa-apa.
Dialogue: 0,0:13:58.92,0:14:02.30,Default,,0,0,0,,Aku tahu hidupnya memang tidak akan lama.
Dialogue: 0,0:14:02.38,0:14:04.05,Default,,0,0,0,,Aku sudah mempersiapkan ini.
Dialogue: 0,0:14:04.80,0:14:08.14,Default,,0,0,0,,Tapi setelah kremasi, saat aku pulang…
Dialogue: 0,0:14:09.68,0:14:12.06,Default,,0,0,0,,aku merasa hampa.
Dialogue: 0,0:14:13.27,0:14:15.77,Default,,0,0,0,,Dia sering keluar masuk rumah sakit.
Dialogue: 0,0:14:16.48,0:14:18.52,Default,,0,0,0,,Aku mengemas pakaiannya untuk menginap,
Dialogue: 0,0:14:18.61,0:14:20.28,Default,,0,0,0,,menyiapkan obatnya, dan semua itu.
Dialogue: 0,0:14:20.82,0:14:24.11,Default,,0,0,0,,Setelah tidak perlu melakukannya,
Dialogue: 0,0:14:24.20,0:14:26.74,Default,,0,0,0,,aku tidak tahu harus bagaimana.
Dialogue: 0,0:14:27.95,0:14:32.54,Default,,0,0,0,,Itu sebabnya aku bekerja,\Nhanya demi tetap berkegiatan.
Dialogue: 0,0:14:35.08,0:14:36.42,Default,,0,0,0,,(ADA SATU PESAN BARU)
Dialogue: 0,0:14:43.93,0:14:46.22,Default,,0,0,0,,(BUKU HARIAN BERGAMBAR)
Dialogue: 0,0:14:50.22,0:14:51.64,Default,,0,0,0,,Koshiba.
Dialogue: 0,0:14:53.60,0:14:56.06,Default,,0,0,0,,Kau tidak perlu mengembalikan uangku.
Dialogue: 0,0:14:56.15,0:14:59.52,Default,,0,0,0,,Sebagai gantinya, aku punya permintaan.
Dialogue: 0,0:15:00.78,0:15:01.82,Default,,0,0,0,,Pantai.
Dialogue: 0,0:15:02.65,0:15:03.49,Default,,0,0,0,,Pantai?
Dialogue: 0,0:15:03.78,0:15:05.91,Default,,0,0,0,,Antarkan aku ke pantai.
Dialogue: 0,0:15:18.25,0:15:19.46,Default,,0,0,0,,Kalau begitu, ayo pergi.
Dialogue: 0,0:15:50.91,0:15:53.58,Default,,0,0,0,,Kenapa pantai?
Dialogue: 0,0:15:54.29,0:15:57.12,Default,,0,0,0,,Apa? Aku tidak bisa mendengarmu!
Dialogue: 0,0:15:58.79,0:16:02.30,Default,,0,0,0,,Kubilang, kenapa pantai?
Dialogue: 0,0:16:02.80,0:16:04.84,Default,,0,0,0,,Anginnya terasa sejuk!
Dialogue: 0,0:16:06.59,0:16:09.47,Default,,0,0,0,,Apa kau mendengarkanku?
Dialogue: 0,0:16:11.47,0:16:12.97,Default,,0,0,0,,Buku harian bergambar.
Dialogue: 0,0:16:14.31,0:16:15.47,Default,,0,0,0,,Aku tidak bisa mendengarmu!
Dialogue: 0,0:16:16.06,0:16:17.39,Default,,0,0,0,,Buku harian bergambar!
Dialogue: 0,0:16:18.64,0:16:21.11,Default,,0,0,0,,Saat masih kecil, aku dan kakakku
Dialogue: 0,0:16:21.19,0:16:23.57,Default,,0,0,0,,bertukar buku harian bergambar.
Dialogue: 0,0:16:24.32,0:16:27.74,Default,,0,0,0,,Tapi itu berakhir\Npada hari kami pergi ke pantai.
Dialogue: 0,0:16:29.66,0:16:34.08,Default,,0,0,0,,Aku ingin mengingat\Nkenapa itu berakhir di sana!
Dialogue: 0,0:16:35.91,0:16:36.91,Default,,0,0,0,,Nyaris saja!
Dialogue: 0,0:16:37.33,0:16:38.33,Default,,0,0,0,,Maaf!
Dialogue: 0,0:16:38.41,0:16:40.46,Default,,0,0,0,,Jadi, itu sebabnya\Nkau ingin pergi ke pantai?
Dialogue: 0,0:16:40.79,0:16:42.67,Default,,0,0,0,,Soalnya sudah tidak bisa\Nbertanya langsung kepadanya
Dialogue: 0,0:16:42.75,0:16:44.71,Default,,0,0,0,,tentang buku harian itu lagi, kan?
Dialogue: 0,0:16:45.42,0:16:46.51,Default,,0,0,0,,Kurasa begitu.
Dialogue: 0,0:16:49.80,0:16:53.55,Default,,0,0,0,,Omong-omong, aku terkejut kau mau
Dialogue: 0,0:16:53.97,0:16:56.52,Default,,0,0,0,,pergi ke pantai\Ndi tengah malam seperti ini.
Dialogue: 0,0:16:56.60,0:16:58.52,Default,,0,0,0,,Biasanya, orang akan menolak.
Dialogue: 0,0:16:58.60,0:17:00.81,Default,,0,0,0,,Aku hanya membalas budi.
Dialogue: 0,0:17:01.52,0:17:06.44,Default,,0,0,0,,Lagi pula, kau tahu ini tidak wajar.
Dialogue: 0,0:17:09.49,0:17:10.70,Default,,0,0,0,,Kau aneh.
Dialogue: 0,0:17:18.79,0:17:20.50,Default,,0,0,0,,(DETEKTIF PEMBUNUH) (UNDIAN KARAKTER)\NItu karena papan tandanya menggemaskan.
Dialogue: 0,0:17:22.17,0:17:25.34,Default,,0,0,0,,Aku punya kelemahan\Nterhadap hal menggemaskan.
Dialogue: 0,0:17:25.42,0:17:27.51,Default,,0,0,0,,Bagaimana ini?
Dialogue: 0,0:17:29.51,0:17:30.84,Default,,0,0,0,,Begini…
Dialogue: 0,0:17:30.93,0:17:32.64,Default,,0,0,0,,Tolong jangan dengarkan
Dialogue: 0,0:17:32.72,0:17:33.89,Default,,0,0,0,,apa yang akan kukatakan.
Dialogue: 0,0:17:35.93,0:17:38.98,Default,,0,0,0,,Apa? Aku tak bisa mendengarmu sama sekali.
Dialogue: 0,0:17:41.69,0:17:44.52,Default,,0,0,0,,Nama kakakku Mitsuru.
Dialogue: 0,0:17:45.77,0:17:48.23,Default,,0,0,0,,Dia sangat pandai menggambar.
Dialogue: 0,0:17:49.82,0:17:51.07,Default,,0,0,0,,Aku pulang!
Dialogue: 0,0:17:51.53,0:17:53.11,Default,,0,0,0,,Kakak!
Dialogue: 0,0:17:54.66,0:17:56.37,Default,,0,0,0,,Lihat! Aku mendapatkan
Dialogue: 0,0:17:56.45,0:17:58.58,Default,,0,0,0,,juara kedua dalam kompetisi menggambar!
Dialogue: 0,0:18:03.29,0:18:04.71,Default,,0,0,0,,Itu bagus!
Dialogue: 0,0:18:04.79,0:18:07.71,Default,,0,0,0,,Tapi aku tetap kalah\Nkarena kau juara pertama.
Dialogue: 0,0:18:07.80,0:18:10.63,Default,,0,0,0,,Bukankah sudah kubilang tidak ada\Nmenang atau kalah dalam menggambar?
Dialogue: 0,0:18:10.72,0:18:12.68,Default,,0,0,0,,Kalau yang bilang pemenangnya,
Dialogue: 0,0:18:12.76,0:18:14.55,Default,,0,0,0,,kedengarannya malah seperti sindiran.
Dialogue: 0,0:18:14.64,0:18:15.64,Default,,0,0,0,,Begitukah?
Dialogue: 0,0:18:15.72,0:18:17.39,Default,,0,0,0,,Benar.
Dialogue: 0,0:18:19.77,0:18:22.14,Default,,0,0,0,,Aku paling suka gambarmu.
Dialogue: 0,0:18:24.44,0:18:26.40,Default,,0,0,0,,Teruslah menggambar, ya?
Dialogue: 0,0:18:37.83,0:18:39.16,Default,,0,0,0,,(PUISI HOZUKI)
Dialogue: 0,0:18:42.25,0:18:44.25,Default,,0,0,0,,(SAMPUL, ILUSTRASI MITSURU MATSUKI)
Dialogue: 0,0:18:46.04,0:18:47.63,Default,,0,0,0,,Aku juga akan berusaha yang terbaik.
Dialogue: 0,0:18:50.80,0:18:53.38,Default,,0,0,0,,Kakak, ponselmu berbunyi.
Dialogue: 0,0:18:57.60,0:18:58.80,Default,,0,0,0,,Kakak…
Dialogue: 0,0:19:08.19,0:19:11.65,Default,,0,0,0,,Paling lama dua tahun atau kurang jika…
Dialogue: 0,0:19:13.44,0:19:15.11,Default,,0,0,0,,Sejak musim panas itu,
Dialogue: 0,0:19:15.20,0:19:18.37,Default,,0,0,0,,kakakku terus bolak-balik\Nantara rumah dan rumah sakit.
Dialogue: 0,0:19:34.13,0:19:36.72,Default,,0,0,0,,Tabungan kami perlahan berkurang.
Dialogue: 0,0:19:37.51,0:19:40.55,Default,,0,0,0,,Aku mulai bekerja paruh waktu.
Dialogue: 0,0:19:46.60,0:19:49.19,Default,,0,0,0,,Sekolah, bekerja, merawat.
Dialogue: 0,0:19:49.27,0:19:51.48,Default,,0,0,0,,Sekolah, bekerja, merawat.
Dialogue: 0,0:19:52.19,0:19:54.24,Default,,0,0,0,,Di tengah semua itu, aku…
Dialogue: 0,0:20:18.43,0:20:22.72,Default,,0,0,0,,Mulai tahun ini, kondisi kakakku memburuk.
Dialogue: 0,0:20:37.03,0:20:38.15,Default,,0,0,0,,Apa?
Dialogue: 0,0:20:39.99,0:20:42.70,Default,,0,0,0,,Ini mungkin kali terakhir aku pulang, ya?
Dialogue: 0,0:20:42.78,0:20:47.79,Default,,0,0,0,,Ini mungkin kali terakhir aku pulang, ya?
Dialogue: 0,0:21:07.85,0:21:10.85,Default,,0,0,0,,Koshiba, terima kasih\Nsudah berpura-pura tidak mendengar.
Dialogue: 0,0:21:11.60,0:21:12.48,Default,,0,0,0,,Apa maksudmu?
Dialogue: 0,0:21:19.20,0:21:21.36,Default,,0,0,0,,Aku akan mentraktirmu kopi.
Dialogue: 0,0:21:26.91,0:21:28.41,Default,,0,0,0,,Sara-senpai.
Dialogue: 0,0:21:28.50,0:21:31.12,Default,,0,0,0,,Terima kasih\Nsudah menggantikan sif malamku.
Dialogue: 0,0:21:34.25,0:21:36.46,Default,,0,0,0,,Aku mengandalkanmu, Koshiba.
Dialogue: 0,0:21:57.02,0:22:00.03,Default,,0,0,0,,(JURNAL PERJALANAN SEPEDA MOTOR,\NBERSAMBUNG)
Dialogue: 0,0:23:30.03,0:23:35.08,Default,,0,0,0,,(BERIKUTNYA, PERMINTAAN 21: JURNAL\NPERJALANAN SEPEDA MOTOR, BAGIAN 2)

