Dialogue: 0,0:00:06.40,0:00:13.53,Title,Text,0000,0000,0000,,{\fad(439,436)\bord0\clip(210,14.714,357.572,44)\t(773,4485,\clip(210,15,430,44))}مُذكّرات الصّيدلانيّة
Dialogue: 1,0:00:06.40,0:00:13.53,Title,Text,0000,0000,0000,,{\fad(0,436)\blur3\1a&HFF&\clip(210,15,211,44)\t(400,4902,\clip(210,15,430,44))}مُذكّرات الصّيدلانيّة
Dialogue: 0,0:01:30.99,0:01:33.99,Fiction_Disclaimer,Text,0000,0000,0000,,{\fad(277,260)\blur1}.هذه القصّة هي من نسج الخيال. كافّة أسماء الشّخصيّات والمنظّمات وما إلى هنالك وهميّة\N.لا صِلة لها أيضاً بأيّ وقائع حقيقيّة مُحدّدة
Dialogue: 0,0:01:33.27,0:01:38.66,italicstop,Maomao,0000,0000,0000,,أُرافق الطّبيبَ الدجّال إلى دياره بناء\Nعلى طلب مولايّ جينشي
Dialogue: 0,0:01:39.30,0:01:43.64,italics,Maomao,0000,0000,0000,,لكن لماذا يُرافقنا مُتخفِّياً؟\Nهل هناك خطبٌ ما في هذه القرية؟
Dialogue: 0,0:01:45.28,0:01:46.09,Default,Maomao,0000,0000,0000,,أجل
Dialogue: 0,0:01:56.42,0:02:00.68,Default,Maomao,0000,0000,0000,,.أعتقد بأنّك تستطيع التكلُّم الآن\Nهذه الغرفة مُنعزِلة عن الآخرين
Dialogue: 0,0:02:01.19,0:02:02.87,Default,Jinshi,0000,0000,0000,,هل كنتِ تستحمّين؟
Dialogue: 0,0:02:02.87,0:02:07.15,Default,Maomao,0000,0000,0000,,أغسل شعري فقط. أنا آسفة\Nلأنّني غير لائقة المظهر
Dialogue: 0,0:02:08.14,0:02:09.53,italics,Maomao,0000,0000,0000,,لماذا هو هنا؟
Dialogue: 0,0:02:10.70,0:02:13.46,Default,Jinshi,0000,0000,0000,,هل يمكنكِ إعادة تكرار هذا المكياج؟
Dialogue: 0,0:02:13.87,0:02:17.12,Default,Maomao,0000,0000,0000,,يمكنني، إذا امتلكتُ الأدوات المُناسبة
Dialogue: 0,0:02:17.12,0:02:18.18,Default,Jinshi,0000,0000,0000,,افعليها إذاً
Dialogue: 0,0:02:24.41,0:02:26.85,Default,Maomao,0000,0000,0000,,سأحضر ماء ساخناً جديداً
Dialogue: 0,0:02:26.85,0:02:29.42,Default,Jinshi,0000,0000,0000,,لا تُكلّفي نفسكِ. لا بأس في هذا
Dialogue: 0,0:02:31.28,0:02:34.43,italics,Maomao,0000,0000,0000,,…غسلتُ قدمَي بعد شعري، لكن
Dialogue: 0,0:02:34.74,0:02:35.78,Default,Jinshi,0000,0000,0000,,ما المُشكلة؟
Dialogue: 0,0:02:35.78,0:02:37.70,Default,Maomao,0000,0000,0000,,لا، لا شيء
Dialogue: 0,0:02:37.70,0:02:41.77,italics,Maomao,0000,0000,0000,,إن لم يكُن يُبالي، فسأبقي ذلك سرّاً
Dialogue: 0,0:02:51.91,0:02:54.82,italics,Maomao,0000,0000,0000,,تخفُّ النُّدَب مع مرور الوقت
Dialogue: 0,0:02:55.57,0:02:57.70,Default,Maomao,0000,0000,0000,,لكنّها لا تزول تماماً
Dialogue: 0,0:02:58.78,0:03:00.46,Default,Maomao,0000,0000,0000,,بالمُناسبة يا مولايّ جينشي
Dialogue: 0,0:03:00.46,0:03:01.70,Default,Jinshi,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:03:01.70,0:03:05.29,Default,Maomao,0000,0000,0000,,لماذا زرتَ منزل عائلة الطّبيب؟
Dialogue: 0,0:03:06.08,0:03:09.79,Default,Jinshi,0000,0000,0000,,هذه مُجرّد محطّة عبور، لكن ثمّة\Nأمر يُثير قلقي
Dialogue: 0,0:03:09.79,0:03:11.60,italics,Maomao,0000,0000,0000,,محطّة عبور؟
Dialogue: 0,0:03:11.60,0:03:14.05,Default,Maomao,0000,0000,0000,,ما هو الشّيء المُقلِق؟
Dialogue: 0,0:03:14.55,0:03:18.68,Default,Jinshi,0000,0000,0000,,ابن عمّكِ المحبوب قالَ ذلك أثناء\Nاللّعب بالمعداد الخاصّ به
Dialogue: 0,0:03:19.71,0:03:21.18,Default,Maomao,0000,0000,0000,,لاهان؟
Dialogue: 0,0:03:21.63,0:03:25.99,Default,Jinshi,0000,0000,0000,,ثمّة مُشكلة ما في كمّية الأرزّ من هذه\Nالمنطقة في السّنوات القليلة الماضية
Dialogue: 0,0:03:26.31,0:03:30.10,italics,Maomao,0000,0000,0000,,لاهان مُتعصِّب للأرقام كثيراً
Dialogue: 0,0:03:30.10,0:03:32.84,italics,Maomao,0000,0000,0000,,يبدو هذا شيئاً يستحقّ التحرّي عنه
Dialogue: 0,0:03:33.31,0:03:37.45,Default,Jinshi,0000,0000,0000,,…لكن سماع رواية كهذه
Dialogue: 0,0:03:38.05,0:03:40.90,Default,Maomao,0000,0000,0000,,،المالِك الحاليّ، الّذي يملك حقوقَ الأرض
Dialogue: 0,0:03:40.90,0:03:45.96,Default,Maomao,0000,0000,0000,,يحاول طرد صانعي الورق ليبدأ\Nفي صنع الورق بنفسه
Dialogue: 0,0:03:48.13,0:03:52.32,Default,Jinshi,0000,0000,0000,,صنع الورق هو مجال تجاريّ هامّ\Nيحتاج عنايةً أكبر من الآن فصاعداً
Dialogue: 0,0:03:53.08,0:03:55.80,Default,Jinshi,0000,0000,0000,,لا يمكننا تقبُّل استبدال حِرفيّين مُعلّمين\Nبواسطة هُواة
Dialogue: 0,0:03:56.27,0:03:58.50,italics,Maomao,0000,0000,0000,,!كم هذا مُزعج
Dialogue: 0,0:03:58.50,0:04:02.49,Default,Maomao,0000,0000,0000,,،هل تريدني أن أُشكّل نُدبةً جديدة الآن\Nأم أفعل ذلك في الصّباح؟
Dialogue: 0,0:04:02.89,0:04:04.10,Default,Jinshi,0000,0000,0000,,الآن من فضلكِ
Dialogue: 0,0:04:04.53,0:04:08.62,italics,Maomao,0000,0000,0000,,،إذا طردتُه من هذه الغرفة الآن\Nفستكون كارثة حقيقيّة
Dialogue: 0,0:04:10.76,0:04:13.27,Default,Maomao,0000,0000,0000,,ألن يفعلها السّيّد باسين لأجلك؟
Dialogue: 0,0:04:13.52,0:04:16.03,Default,Jinshi,0000,0000,0000,,لا يملك المهارات اللّازمة
Dialogue: 0,0:04:16.03,0:04:18.99,Default,Maomao,0000,0000,0000,,ألهذا السّبب أحضرتني معك؟
Dialogue: 0,0:04:19.25,0:04:20.61,Default,Jinshi,0000,0000,0000,,ليس هذا السّبب فقط
Dialogue: 0,0:04:29.17,0:04:33.50,Default,Maomao,0000,0000,0000,,لا تنم من فضلك. سأحضر السّيّد\Nباسين قبل أن تفعل
Dialogue: 0,0:04:33.50,0:04:36.93,Default,Jinshi,0000,0000,0000,,حتّى لو كان هنا، هل يمكنكما\Nفعل أيّ شيء لي؟
Dialogue: 0,0:04:36.93,0:04:40.74,italics,Maomao,0000,0000,0000,,،غالباً لا. بخلاف أبيه، السّيّد غاوشون
Dialogue: 0,0:04:40.74,0:04:42.90,italics,Maomao,0000,0000,0000,,لا يزال السّيّد باسين يفتقر للمهارة
Dialogue: 0,0:04:42.90,0:04:44.81,Default,Maomao,0000,0000,0000,,لماذا أحضرت السّيّد باسين؟
Dialogue: 0,0:04:46.03,0:04:53.18,Default,Jinshi,0000,0000,0000,,في الواقع، إنّه… يستطيع الاهتمام\Nببعض الأمور أيضاً
Dialogue: 0,0:04:53.18,0:04:54.92,Default,Maomao,0000,0000,0000,,كأنّك تتملّص من السّؤال
Dialogue: 0,0:04:56.40,0:05:00.51,italics,Maomao,0000,0000,0000,,حسناً، أعتقد بأنّ القدرة على التسكُّع مع مولايّ\Nجينشي دون أفكار طريفة
Dialogue: 0,0:05:00.51,0:05:02.61,italics,Maomao,0000,0000,0000,,هي موهبة نادرة بحدّ ذاتها
Dialogue: 0,0:05:04.62,0:05:06.74,italics,Maomao,0000,0000,0000,,حسناً، انتهيت
Dialogue: 0,0:05:19.66,0:05:22.21,Default,Jinshi,0000,0000,0000,,ماذا؟ انتهيتِ؟
Dialogue: 0,0:05:25.63,0:05:26.68,Default,Jinshi,0000,0000,0000,,!هذا فظيع
Dialogue: 0,0:05:31.15,0:05:33.35,Default,Jinshi,0000,0000,0000,,تـ-توقّفي رجاء
Dialogue: 0,0:05:33.35,0:05:37.69,italics,Maomao,0000,0000,0000,,هذا يجعلني أرغب في المُتابعة أكثر بالطّبع
Dialogue: 0,0:05:38.78,0:05:39.54,Default,Basen,0000,0000,0000,,سأدخل
Dialogue: 0,0:05:39.54,0:05:41.15,Default,Jinshi,0000,0000,0000,,—بربّكِ، يكفي
Dialogue: 0,0:05:56.79,0:06:00.04,italics,Maomao,0000,0000,0000,,كان ذلك أفضل تنسيق يجري بيننا
Dialogue: 0,0:06:02.97,0:06:06.85,Ep_Title,Text,0000,0000,0000,,{\fad(430,470)\fscx95}الحلقة 55: الرِّهان
Dialogue: 0,0:06:12.45,0:06:15.44,italics,Maomao,0000,0000,0000,,نِقاش؟
Dialogue: 0,0:06:16.17,0:06:18.55,italics,Maomao,0000,0000,0000,,هل ذلك هو مالِك الأرض في الوسط؟
Dialogue: 0,0:06:22.56,0:06:24.99,Default,Basen,0000,0000,0000,,هل كنتِ بحاجة للمجيء؟
Dialogue: 0,0:06:24.99,0:06:27.16,Default,Maomao,0000,0000,0000,,الطّبيب مَن طلب منّي ذلك
Dialogue: 0,0:06:27.16,0:06:29.71,Default,Maomao,0000,0000,0000,,لا تريد أن يشعر بالوحشة، أليس كذلك؟
Dialogue: 0,0:06:30.11,0:06:32.26,Default,Basen,0000,0000,0000,,…لا حاجة للتّعبير عن الأمر بهذه الطّريقة
Dialogue: 0,0:06:35.09,0:06:38.59,Default,Basen,0000,0000,0000,,على أيّ حال، لديهم كثير من المشروبات\Nرغم مساحة المكان الصّغيرة
Dialogue: 0,0:06:39.67,0:06:43.30,italics,Maomao,0000,0000,0000,,المشروب الرّئيسيّ المُقدَّم هنا هو\Nالمشروب العكِر في الرّفوف
Dialogue: 0,0:06:43.30,0:06:46.22,italics,Maomao,0000,0000,0000,,القِدر الكبير في الخلف يحتوي\Nعلى شراب صافٍ
Dialogue: 0,0:06:46.77,0:06:50.79,italics,Maomao,0000,0000,0000,,في المدينة، المشروبات الصّافية والمشروبات\Nالمُقطَّرة ذات شعبيّة أكبر
Dialogue: 0,0:06:50.79,0:06:54.71,italics,Maomao,0000,0000,0000,,لا بُدّ أنّ الشّراب العكِر مُخصّص\Nللسكّان المحلّيين هنا
Dialogue: 0,0:06:54.71,0:06:57.32,Default,Landlord,0000,0000,0000,,هل لديك المال؟
Dialogue: 0,0:06:57.32,0:06:59.86,italics,Maomao,0000,0000,0000,,من الواضح بأنّهم يفوقوننا عدداً
Dialogue: 0,0:06:59.86,0:07:01.98,italics,Maomao,0000,0000,0000,,إلى أين ينبغي أن أهرب إذا تحوّل\Nالأمر إلى عِراك؟
Dialogue: 0,0:07:01.98,0:07:04.09,Default,Husband,0000,0000,0000,,الموعد النّهائي لم يحن بعد
Dialogue: 0,0:07:04.09,0:07:07.30,Default,Landlord,0000,0000,0000,,إن كنت لا تستطيع الدّفع، فسيترتّب\Nعليكم مُغادرة هذا المكان
Dialogue: 0,0:07:07.30,0:07:09.95,Default,Husband,0000,0000,0000,,هل يمكنك منحنا مزيداً من الوقت؟
Dialogue: 0,0:07:09.95,0:07:12.05,italics,Maomao,0000,0000,0000,,هل هذا هو العقد؟
Dialogue: 0,0:07:12.45,0:07:16.14,Default,Landlord,0000,0000,0000,,أخبرتُك سلفاً، أستطيع الانتظار\Nحتّى العام المُقبل
Dialogue: 0,0:07:16.14,0:07:19.71,Default,Landlord,0000,0000,0000,,نريد فقط أن نتلقّى جزءاً من تعاليمكم\Nفي هذه الأثناء
Dialogue: 0,0:07:20.12,0:07:21.88,italics,Maomao,0000,0000,0000,,!يا له من مأزق
Dialogue: 0,0:07:21.88,0:07:26.44,italics,Maomao,0000,0000,0000,,حتّى مع ذلك الوقت الإضافيّ، إذا قُضي\N،في تعليمهم كيفيّة صنع الورق
Dialogue: 0,0:07:26.44,0:07:28.89,italics,Maomao,0000,0000,0000,,فسوف يسرقون كافّة تقنيّاتهم حتماً
Dialogue: 0,0:07:29.41,0:07:32.81,italics,Maomao,0000,0000,0000,,في نفس الوقت، سيسعون لانتزاع\N،منصِب المُزوِّد الإمبراطوريّ
Dialogue: 0,0:07:32.81,0:07:36.21,italics,Maomao,0000,0000,0000,,وطرد الحِرفيّين، واستبدالهم
Dialogue: 0,0:07:37.39,0:07:40.30,italics,Maomao,0000,0000,0000,,لكن… لِمَ يُكلّفون أنفسهم كُلّ هذا العناء؟
Dialogue: 0,0:07:40.30,0:07:43.61,italics,Maomao,0000,0000,0000,,،لِمَ لا يجعلونهم يعملون تحت جناحه فحسب\Nباستخدام القرض كنفوذ؟
Dialogue: 0,0:07:43.61,0:07:45.86,italics,Maomao,0000,0000,0000,,هل يكره الغُرباء إلى هذا الحدّ حقّاً؟
Dialogue: 0,0:07:58.40,0:08:02.67,italics,Maomao,0000,0000,0000,,،يُفترض أن يزيد عمرها عن عشر سنوات\Nلكن لا يزال الورق نظيفاً
Dialogue: 0,0:08:03.20,0:08:06.42,italics,Maomao,0000,0000,0000,,،لو كانت الورقة ذات جودة رديئة\Nلكانت مُمزّقة الآن
Dialogue: 0,0:08:06.88,0:08:09.26,italics,Maomao,0000,0000,0000,,،مذكور بأنّ السّداد سيكتمل بعد عشرين عام
Dialogue: 0,0:08:09.26,0:08:12.12,italics,Maomao,0000,0000,0000,,وتفاصيل مقدار القسط الشّهريّ
Dialogue: 0,0:08:12.82,0:08:16.95,italics,Maomao,0000,0000,0000,,يبدو عقداً سليماً تماماً. فكيف تكون\Nهناك مساحة لأي نِزاع؟
Dialogue: 0,0:08:17.47,0:08:20.16,Default,Younger Son,0000,0000,0000,,يقولون بأنّ العقد باطل
Dialogue: 0,0:08:20.16,0:08:21.62,Default,Maomao,0000,0000,0000,,حتّى مع الختم المونوغراميّ؟
Dialogue: 0,0:08:22.03,0:08:24.60,Default,Maomao,0000,0000,0000,,هذا صالحٌ مثل التّوقيع تماماً، صحيح؟
Dialogue: 0,0:08:25.10,0:08:26.82,Default,Younger Son,0000,0000,0000,,…أجل، لكن
Dialogue: 0,0:08:26.82,0:08:30.07,Default,Younger Son,0000,0000,0000,,يُقال بأنّ المالك السّابق لا يستطيع القراءة
Dialogue: 0,0:08:30.07,0:08:33.39,italics,Maomao,0000,0000,0000,,كمالِك، نظراً إلى عدد الوثائق الّتي\N،يترتّب عليه مُراجعتها
Dialogue: 0,0:08:33.39,0:08:36.50,italics,Maomao,0000,0000,0000,,…من الغريب ألّا يتعلّم القِراءة
Dialogue: 0,0:08:36.50,0:08:38.82,Default,Younger Son,0000,0000,0000,,تزوّجَ من العائلة
Dialogue: 0,0:08:38.82,0:08:41.43,italics,Maomao,0000,0000,0000,,الآن قد فهمت
Dialogue: 0,0:08:39.16,0:08:44.62,sign_12448_106_Wife,Text,0000,0000,0000,,{\pos(235,47)}الزّوجة
Dialogue: 0,0:08:42.29,0:08:44.62,sign_12448_106_Wife,Text,0000,0000,0000,,{\move(0,35,145,35,0,774)\frz4\fs10}الزّوج
Dialogue: 0,0:08:44.62,0:08:47.26,sign_12448_106_Wife,Text,0000,0000,0000,,{\an8\pos(218.667,17.333)}الزّوج
Dialogue: 0,0:08:41.43,0:08:45.00,italics,Maomao,0000,0000,0000,,ضمّوا أحد المُزارعين المُجدّين\Nفي العمل إلى العائلة
Dialogue: 0,0:08:45.00,0:08:47.26,italics,Maomao,0000,0000,0000,,لم تسنح له الفُرصة للدّراسة
Dialogue: 0,0:08:47.53,0:08:51.63,Default,Younger Son,0000,0000,0000,,،زوجته تولّت القِراءة، لكن بعد وفاتها
Dialogue: 0,0:08:51.63,0:08:55.47,Default,Younger Son,0000,0000,0000,,استأجروا كاتبَ عدلٍ لكتابة العقد
Dialogue: 0,0:08:56.96,0:09:01.77,Default,Maomao,0000,0000,0000,,ألم يكن هناك أي شهود على توقيع العقد؟\Nمثل كاتب العدل؟
Dialogue: 0,0:09:01.77,0:09:04.77,sign_12448_106_Wife,Text,0000,0000,0000,,{\fad(0,936)\frz6.556\pos(161,42.334)}شاهد
Dialogue: 0,0:09:01.77,0:09:03.76,sign_12448_106_Wife,Text,0000,0000,0000,,{\fad(0,927)\fs10\pos(315.666,132)}كاتب العدل
Dialogue: 0,0:09:01.77,0:09:08.81,sign_12448_106_Wife,Text,0000,0000,0000,,{\fs10\pos(476.667,139.667)\frx358\fry342}الزّوج
Dialogue: 0,0:09:02.04,0:09:05.46,Default,Younger Son,0000,0000,0000,,كاتب العدل والشّاهد كلاهما قد تُوفّيا
Dialogue: 0,0:09:05.46,0:09:08.82,Default,Younger Son,0000,0000,0000,,كانا كبيرين في السنّ بالفعل عندما\Nوُقِّع العقد قبل 15 عاماً
Dialogue: 0,0:09:09.12,0:09:11.21,italics,Maomao,0000,0000,0000,,إنّه مأزق حقيقيّ بالفعل
Dialogue: 0,0:09:12.06,0:09:15.67,Default,Landlord,0000,0000,0000,,إن لم تُغادروا الآن، فلا نملك خياراً إذاً
Dialogue: 0,0:09:15.67,0:09:17.58,Default,Landlord,0000,0000,0000,,سنُرسل عُمّالنا الصِّغار إليكم
Dialogue: 0,0:09:17.58,0:09:20.56,Default,Landlord,0000,0000,0000,,احرصوا على تعليمهم كيفيّة أداء\Nالعمل مع نهاية العام
Dialogue: 0,0:09:21.62,0:09:24.06,Default,Landlord,0000,0000,0000,,!أعتقد حُسِمَ الأمر إذاً
Dialogue: 0,0:09:24.06,0:09:26.83,Default,Landlord,0000,0000,0000,,!أحضروا المشروبات! جولة لأجل الفتيان أيضاً
Dialogue: 0,0:09:35.89,0:09:38.89,italics,Maomao,0000,0000,0000,,هذا هو الخمر الصّافي، وليس العكِر
Dialogue: 0,0:09:45.22,0:09:47.37,italics,Maomao,0000,0000,0000,,يتناول المالكُ المشروب المُقطَّر
Dialogue: 0,0:09:47.37,0:09:49.65,italics,Maomao,0000,0000,0000,,يبدو أنّه يتحمّل الكحول بشكل جيّد
Dialogue: 0,0:09:50.44,0:09:56.58,italics,Maomao,0000,0000,0000,,سخاء منه أن يشتري الشّرابَ النّقيّ\Nللمجموعة بأكملها
Dialogue: 0,0:09:56.86,0:09:59.60,italics,Maomao,0000,0000,0000,,لدى هذا المكان مشروبات أرخص أيضاً
Dialogue: 0,0:10:00.22,0:10:01.54,Default,Maomao,0000,0000,0000,,سيّدتي
Dialogue: 0,0:10:01.54,0:10:02.37,Default,Madam,0000,0000,0000,,ما الأمر؟
Dialogue: 0,0:10:02.37,0:10:05.33,Default,Maomao,0000,0000,0000,,واحد لي أيضاً، نفس الشّراب
Dialogue: 0,0:10:07.26,0:10:09.41,italics,Maomao,0000,0000,0000,,مولايّ جينشي لاحظَ أيضاً
Dialogue: 0,0:10:15.42,0:10:18.02,italics,Maomao,0000,0000,0000,,هذا شرابٌ لذيذ، بمذاق حلو
Dialogue: 0,0:10:18.02,0:10:21.54,italics,Maomao,0000,0000,0000,,،إنّه ليس مُصقولاً كشراب من المدينة\Nلكن لا بأس به
Dialogue: 0,0:10:21.54,0:10:25.14,italics,Maomao,0000,0000,0000,,لكن الكحول ثقيل، بالرّغم من مذاقه الخفيف
Dialogue: 0,0:10:25.81,0:10:29.77,Default,Maomao,0000,0000,0000,,المعذرة. هل يوجد مصنع بيرة\Nفي هذه الأرجاء؟
Dialogue: 0,0:10:29.77,0:10:33.52,Default,Madam,0000,0000,0000,,لا، ليس على حدّ علمي
Dialogue: 0,0:10:33.52,0:10:34.45,Default,Maomao,0000,0000,0000,,بالطّبع
Dialogue: 0,0:10:36.35,0:10:40.63,flashback italics,Jinshi,0000,0000,0000,,ثمّة مُشكلة ما في كمّية الأرزّ من هذه\Nالمنطقة في السّنوات القليلة الماضية
Dialogue: 0,0:10:48.75,0:10:51.26,Default,Landlord,0000,0000,0000,,ما الأمر أيّتها الآنسة الصّغيرة؟
Dialogue: 0,0:10:51.26,0:10:53.13,Default,Landlord,0000,0000,0000,,هل ستكونين ساقيتي في هذه اللّيلة؟
Dialogue: 0,0:10:54.03,0:10:56.76,Default,Guen,0000,0000,0000,,!أ-أيّتها الآنسة الصّغيرة، ماذا تفعلين؟
Dialogue: 0,0:11:02.12,0:11:04.96,Default,Maomao,0000,0000,0000,,هل ترغب في إقامة مُسابقة شرب؟
Dialogue: 0,0:11:09.33,0:11:12.78,Default,Landlord,0000,0000,0000,,!مُسابقة شرب؟ يا لكِ من جريئة
Dialogue: 0,0:11:18.10,0:11:20.77,Default,Maomao,0000,0000,0000,,كم بقي من القرض؟
Dialogue: 0,0:11:21.92,0:11:24.12,Default,Husband,0000,0000,0000,,ألف فضّية عن كلّ عام
Dialogue: 0,0:11:24.12,0:11:29.09,Default,Husband,0000,0000,0000,,سدّدنا نصفه هذا العام، لذا بقي 4500\Nلمدّة أربع سنوات
Dialogue: 0,0:11:29.09,0:11:30.00,Default,Maomao,0000,0000,0000,,هكذا إذاً
Dialogue: 0,0:11:33.38,0:11:35.97,Default,Maomao,0000,0000,0000,,لِمَ لا نجعل الأمر مُشوِّقاً برِهان؟
Dialogue: 0,0:11:35.97,0:11:39.22,Default,Landlord,0000,0000,0000,,هذا مُثير للاهتمام. على ماذا تُراهنين؟
Dialogue: 0,0:11:39.22,0:11:40.85,Default,Maomao,0000,0000,0000,,على هذا بالطّبع
Dialogue: 0,0:11:42.38,0:11:45.52,Default,Maomao,0000,0000,0000,,بِعني لقوّاد. ستجني 300 فضّية بسهولة
Dialogue: 0,0:11:49.74,0:11:53.50,Default,Farmer 1,0000,0000,0000,,أيّتها الصّغيرة! هل تعرفين حتّى\Nثمن الأشياء؟
Dialogue: 0,0:11:53.50,0:11:58.57,italics,Maomao,0000,0000,0000,,أعرف بالطّبع. كم فتاة رأيتُها تُباع برأيك؟
Dialogue: 0,0:11:58.57,0:12:01.56,Default,Farmer 1,0000,0000,0000,,حتّى أروع فتاة لا تُحقّق 100 فضّية
Dialogue: 0,0:12:01.56,0:12:03.78,Default,Farmer 1,0000,0000,0000,,!لكن 300…؟
Dialogue: 0,0:12:08.53,0:12:15.38,Default,Maomao,0000,0000,0000,,إذا بيعَتْ فجلة بتُرابِها كما هي فلن تُحقّق\Nخمسين فضّية. هذا واضح
Dialogue: 0,0:12:15.38,0:12:17.92,Default,Maomao,0000,0000,0000,,من الواضح أنّك لا تعرف شيئاً
Dialogue: 0,0:12:17.92,0:12:19.41,Default,Farmer 1,0000,0000,0000,,ماذا؟
Dialogue: 0,0:12:23.57,0:12:28.19,italics,Maomao,0000,0000,0000,,جيّد، فهِموا بأنّ الفجلة كانت تعبيراً\Nعن فتيات الرّيف
Dialogue: 0,0:12:28.72,0:12:30.70,Default,Farmer 1,0000,0000,0000,,!ماذا قلتِ؟
Dialogue: 0,0:12:30.70,0:12:35.38,Default,Maomao,0000,0000,0000,,،إن كنت لا تُجيد القراءة أو الكتابة\Nفلن تتمكّن من استخدام الورق أبداً
Dialogue: 0,0:12:35.38,0:12:38.55,Default,Maomao,0000,0000,0000,,أنا واثقة بأنّك لن تتعلّم صنع شيء\Nجيّد ولو علّموك
Dialogue: 0,0:12:39.71,0:12:41.36,Default,Farmer 1,0000,0000,0000,,!…أنتِ
Dialogue: 0,0:12:49.24,0:12:53.62,Default,Jinshi,0000,0000,0000,,ستكون هذه الفتاة لِقاء 300 فضّية\Nصفقة مُجزية
Dialogue: 0,0:12:53.89,0:12:57.41,italics,Maomao,0000,0000,0000,,،في العادة لا أنصح بالتّباهي بثروته هكذا
Dialogue: 0,0:12:57.41,0:12:58.84,italics,Maomao,0000,0000,0000,,لكن حاليّاً، أنا مُضطرّة للمُسايرة
Dialogue: 0,0:13:01.71,0:13:04.76,Default,Maomao,0000,0000,0000,,رأيت؟ من يعرف، يعرف
Dialogue: 0,0:13:05.93,0:13:09.74,Default,Farmer 1,0000,0000,0000,,!أنتم، لنُلقّنهم درساً
Dialogue: 0,0:13:10.66,0:13:12.60,Default,Landlord,0000,0000,0000,,!من سمح لك بتولّي القيادة؟
Dialogue: 0,0:13:13.58,0:13:17.98,Default,Landlord,0000,0000,0000,,حسناً إذاً. إن كان لديك المال، فلا أُمانع
Dialogue: 0,0:13:18.80,0:13:20.57,italics,Maomao,0000,0000,0000,,جيّد. لقد وافق
Dialogue: 0,0:13:24.08,0:13:27.29,Default,Maomao,0000,0000,0000,,حسناً، من يريد البدء أوّلاً؟
Dialogue: 0,0:13:32.38,0:13:34.50,Default,Farmer 1,0000,0000,0000,,!سأواجهكِ أوّلاً
Dialogue: 0,0:13:34.97,0:13:37.31,Default,Maomao,0000,0000,0000,,حسناً، لنبدأ
Dialogue: 0,0:13:50.44,0:13:51.85,Default,Younger Son,0000,0000,0000,,هذا غير مُمكن
Dialogue: 0,0:13:52.57,0:13:54.31,Default,Maomao,0000,0000,0000,,هل انتهى بهذه السّرعة؟
Dialogue: 0,0:13:55.51,0:13:57.90,Default,Husband,0000,0000,0000,,هذا الشّراب المُقطَّر، صحيح؟
Dialogue: 0,0:14:00.02,0:14:05.02,italics,Maomao,0000,0000,0000,,حاولوا إسقاطي بسرعة بإحضار شراب\Nذي مُحتوى كحوليّ أعلى
Dialogue: 0,0:14:05.02,0:14:07.08,italics,Maomao,0000,0000,0000,,هذه غلطتهم. أنا معتادة على ذلك
Dialogue: 0,0:14:07.99,0:14:11.39,Default,Jinshi,0000,0000,0000,,ثلاثمئة. ليست صفقة سيّئة
Dialogue: 0,0:14:11.39,0:14:15.32,italics,Maomao,0000,0000,0000,,لا أريد أن أُشتَرى بواسطة هذا\Nالرّجل من جديد. لن أخسر
Dialogue: 0,0:14:16.71,0:14:18.13,italics,Maomao,0000,0000,0000,,صاروا أربعة
Dialogue: 0,0:14:18.60,0:14:21.43,italics,Maomao,0000,0000,0000,,بثلاثمئة لكلّ شخص، ومُضاعَفة\N،الرِّهان في كلّ مرّة
Dialogue: 0,0:14:21.43,0:14:25.13,italics,Maomao,0000,0000,0000,,…‏600، 1200، 2400
Dialogue: 0,0:14:25.55,0:14:30.20,italics,Maomao,0000,0000,0000,,بما أنّ مقدار القرض هو 4500، فأحتاج\Nلهزيمة رجل إضافيّ واحد فقط
Dialogue: 0,0:14:30.69,0:14:34.87,italics,Maomao,0000,0000,0000,,،وقّعنا سنَداً بسيطاً معهم ببصمة يد\Nمن باب الحيطة فقط
Dialogue: 0,0:14:37.30,0:14:39.02,Default,Landlord,0000,0000,0000,,هل ستُرغمينني؟
Dialogue: 0,0:14:39.48,0:14:45.02,italics,Maomao,0000,0000,0000,,،هل يمكنني فعلها؟ بعد أربع جولات\Nبدأ ذلك يتراكم
Dialogue: 0,0:14:45.48,0:14:47.99,Default,Landlord,0000,0000,0000,,إيّاكِ والظنّ بأنّني كالآخرين
Dialogue: 0,0:14:49.89,0:14:52.70,Default,Landlord,0000,0000,0000,,وأنت، لا تُحاول سحب مالك
Dialogue: 0,0:14:57.15,0:14:59.39,Default,Farmer 2,0000,0000,0000,,!مهلاً، ماذا تفعلين؟
Dialogue: 0,0:14:59.39,0:15:01.17,Default,Maomao,0000,0000,0000,,أغيِّر المذاقَ قليلاً
Dialogue: 0,0:15:05.63,0:15:08.14,Default,Landlord,0000,0000,0000,,لحظة. أعطيني بعضاً من هذا أيضاً
Dialogue: 0,0:15:12.82,0:15:13.60,Default,Farmer 2,0000,0000,0000,,تفضّل
Dialogue: 0,0:15:15.55,0:15:19.56,Default,Landlord,0000,0000,0000,,هذا ليس دواء لتخفيف أثر الثّمالة، صحيح؟
Dialogue: 0,0:15:42.07,0:15:43.61,Default,Farmers,0000,0000,0000,,!سـ-سيّدي
Dialogue: 0,0:15:44.35,0:15:46.69,Default,Farmer 2,0000,0000,0000,,!أنتِ! ماذا أضفتِ إلى مشروبه؟
Dialogue: 0,0:15:46.69,0:15:52.43,Default,Maomao,0000,0000,0000,,ماذا؟ شربتُ نفس الشّراب. رأيتُم ذلك
Dialogue: 0,0:15:52.43,0:15:54.33,Default,Farmer 2,0000,0000,0000,,…أجل، لكن
Dialogue: 0,0:15:54.33,0:15:56.88,Default,Maomao,0000,0000,0000,,أظنّني ربحتُ الرِّهان
Dialogue: 0,0:16:01.39,0:16:03.24,Default,Maomao,0000,0000,0000,,أين دورة المياه؟
Dialogue: 0,0:16:03.83,0:16:05.56,Default,Madam,0000,0000,0000,,من هذا الاتّجاه ثمّ إلى اليمين
Dialogue: 0,0:16:05.56,0:16:06.93,Default,Maomao,0000,0000,0000,,شكراً لكِ
Dialogue: 0,0:16:19.78,0:16:22.31,Default,Husband,0000,0000,0000,,حسناً، ماذا فعلتِ؟
Dialogue: 0,0:16:22.31,0:16:27.59,Default,Maomao,0000,0000,0000,,لا شيء، أضفتُ فقط مزيداً\Nمن الكحول لتغيير المذاق
Dialogue: 0,0:16:28.58,0:16:33.05,italics,Maomao,0000,0000,0000,,أحمل معي كحولاً مُطهِّرة، من باب الحيطة فقط
Dialogue: 0,0:16:33.05,0:16:35.57,italics,Maomao,0000,0000,0000,,،إنّه أكثر سماكة من أيّ شراب عاديّ
Dialogue: 0,0:16:35.57,0:16:38.13,italics,Maomao,0000,0000,0000,,لذا فهو يطيح بأيّ شخص عاديّ بسهولة
Dialogue: 0,0:16:38.13,0:16:39.99,Default,Husband,0000,0000,0000,,هلّا طرحتُ عليك سؤالاً؟
Dialogue: 0,0:16:39.99,0:16:41.14,Default,Maomao,0000,0000,0000,,تفضّل
Dialogue: 0,0:16:41.14,0:16:45.77,Default,Husband,0000,0000,0000,,شربتِ من نفس الشّراب، صحيح؟
Dialogue: 0,0:16:46.05,0:16:48.02,Default,Maomao,0000,0000,0000,,هذا ليس كافياً للتأثير بي
Dialogue: 0,0:16:48.02,0:16:50.11,Default,Maomao,0000,0000,0000,,أردتُ فقط أن ينتهي الأمر بسرعة
Dialogue: 0,0:16:53.42,0:16:55.98,Default,Maomao,0000,0000,0000,,يسرّني أنّني وصلتُ إلى دورة المياه
Dialogue: 0,0:16:57.03,0:17:02.47,Default,Husband,0000,0000,0000,,مهما كنتِ واثقة، الرّهان على نفسكِ سيّئ
Dialogue: 0,0:17:02.47,0:17:04.54,Default,Husband,0000,0000,0000,,…وأن تفعلي ذلك لأجلنا
Dialogue: 0,0:17:06.23,0:17:08.99,Default,Maomao,0000,0000,0000,,يبدو أنّك أسأت الفهم
Dialogue: 0,0:17:09.72,0:17:11.63,Default,Maomao,0000,0000,0000,,هذه لي أنا
Dialogue: 0,0:17:12.71,0:17:16.79,Default,Guen,0000,0000,0000,,،ما-ماذا؟ أيّتها الآنسة الصّغيرة\N…لا تكوني قاسية رجاء
Dialogue: 0,0:17:16.79,0:17:19.01,Default,Landlord,0000,0000,0000,,!أنتِ، لحظة
Dialogue: 0,0:17:19.01,0:17:21.14,Default,Maomao,0000,0000,0000,,ينبغي أن تبقى مُستلقياً لفترة أطول
Dialogue: 0,0:17:21.14,0:17:22.94,Default,Landlord,0000,0000,0000,,!هذا الرِّهان باطل ولاغٍ
Dialogue: 0,0:17:23.33,0:17:27.14,Default,Maomao,0000,0000,0000,,وقّعتَ سنَداً هنا بخطّ يدك مع بصمة
Dialogue: 0,0:17:27.14,0:17:29.19,Default,Maomao,0000,0000,0000,,هل ستزعم بأنّك لا تُجيد القراءة؟
Dialogue: 0,0:17:29.19,0:17:31.29,Default,Landlord,0000,0000,0000,,!من يأبه لذلك؟
Dialogue: 0,0:17:31.29,0:17:35.00,Default,Landlord,0000,0000,0000,,!كان ذلك من باب التّسلية فقط\N!انتهى الأمر الآن
Dialogue: 0,0:17:35.00,0:17:37.36,Default,Maomao,0000,0000,0000,,إذاً أعتقد بأنّني لا أملك خياراً
Dialogue: 0,0:17:37.36,0:17:42.66,Default,Maomao,0000,0000,0000,,سأبلغ السّلطات بأنّك تتهرّب من الضّرائب
Dialogue: 0,0:17:50.17,0:17:52.38,Default,Older Son,0000,0000,0000,,أتهرّب… من الضّرائب؟
Dialogue: 0,0:17:52.38,0:17:54.02,Default,Husband,0000,0000,0000,,عمّاذا تتحدّثين؟
Dialogue: 0,0:17:54.02,0:17:57.26,Default,Maomao,0000,0000,0000,,تحتاج إذناً من الحكومة لصنع الكحول
Dialogue: 0,0:17:57.56,0:17:59.07,Default,Maomao,0000,0000,0000,,،رُبّما ليس للاستمتاع الشّخصيّ
Dialogue: 0,0:17:59.07,0:18:03.22,Default,Maomao,0000,0000,0000,,لكن إن كنت تبيع لمتجر، فيترتّب على ذلك ضريبة
Dialogue: 0,0:18:03.72,0:18:09.36,italics,Maomao,0000,0000,0000,,كنتُ أتساءل لماذا سمحَ هذا المحلّ\Nبإجراء هذا "النّقاش" هنا
Dialogue: 0,0:18:10.07,0:18:14.78,italics,Maomao,0000,0000,0000,,امتلاك الكثير من المشروبات اللّذيذة\Nوالرّخيصة نافع جدّاً للمحلّ
Dialogue: 0,0:18:14.78,0:18:16.78,italics,Maomao,0000,0000,0000,,،إذا طلبَ المُزوِّد
Dialogue: 0,0:18:16.78,0:18:19.78,italics,Maomao,0000,0000,0000,,،فأنا متأكّدة بأنّهم سيسمحون لهم باستخدام الموقع\Nولو كان ذلك مُزعجاً قليلاً{?}
Dialogue: 0,0:18:20.45,0:18:24.78,italics,Maomao,0000,0000,0000,,…إن كانوا يستخدمون مُزارعين لصنع كحول عكِرة
Dialogue: 0,0:18:24.78,0:18:27.32,italics,Maomao,0000,0000,0000,,فأتفهّم سبب تقديمهم للمشروب النّقيّ لهم
Dialogue: 0,0:18:27.32,0:18:30.92,italics,Maomao,0000,0000,0000,,من يطلب خمراً يصنعه بنفسه ويشربه كُلّ يوم؟
Dialogue: 0,0:18:31.35,0:18:36.00,Default,Maomao,0000,0000,0000,,رُبّما تقتصدون في كلفة مُكوِّن الخمر كذلك؟
Dialogue: 0,0:18:36.00,0:18:39.68,Default,Maomao,0000,0000,0000,,تحتاجون كثيراً من الأرزّ والشّعير لصنع الكحول
Dialogue: 0,0:18:39.68,0:18:42.44,Default,Maomao,0000,0000,0000,,سمعتُ بأنّك أخبرت صانعي الورق بأنّهم
Dialogue: 0,0:18:42.74,0:18:47.18,Default,Maomao,0000,0000,0000,,لوَّثوا الماء وسبّبوا نقصاناً في حصاد الأرزّ
Dialogue: 0,0:18:47.18,0:18:49.47,Default,Maomao,0000,0000,0000,,هذه كذبة، أليس كذلك؟
Dialogue: 0,0:18:49.47,0:18:52.94,Default,Maomao,0000,0000,0000,,في الواقع، ألا تُنتِجون أرزّاً أكثر\Nحتّى من السّابق؟
Dialogue: 0,0:18:53.38,0:18:57.46,italics,Maomao,0000,0000,0000,,المُكوِّنات في الورق هي نخالة أرزّ\Nوقُشارات خشب
Dialogue: 0,0:18:57.46,0:19:01.41,italics,Maomao,0000,0000,0000,,الماء الّذي يحمل تلك الأشياء ينبغي في الواقع\Nأن يعمل كسمادٍ جيّد
Dialogue: 0,0:19:02.31,0:19:05.31,italics,Maomao,0000,0000,0000,,من المُؤكَّد أنّ المالك السّابق يعلم ذلك
Dialogue: 0,0:19:05.31,0:19:10.92,italics,Maomao,0000,0000,0000,,لكن لا بُدّ أنّ المالك الحاليّ بدأ بصنع\Nالكحول لإخفاء حقيقة ازدياد الحصاد
Dialogue: 0,0:19:11.59,0:19:14.34,Default,Maomao,0000,0000,0000,,تهرُّب ضريبيّ مُزدوج؟ هذه جريمة خيطرة
Dialogue: 0,0:19:16.10,0:19:19.30,italics,Maomao,0000,0000,0000,,بحسب ردّة فعله، أنا مُتيقّنة تماماً
Dialogue: 0,0:19:19.30,0:19:21.71,Default,Farmer 3,0000,0000,0000,,!هـ-هل لديكِ دليل؟
Dialogue: 0,0:19:21.71,0:19:24.38,Default,Maomao,0000,0000,0000,,،لا مُشكلة. إن كنتَ بريئاً
Dialogue: 0,0:19:24.38,0:19:27.52,Default,Maomao,0000,0000,0000,,فلا ينبغي أن تخشى المُفتّشين الحكوميّين
Dialogue: 0,0:19:29.15,0:19:31.91,Default,Landlord,0000,0000,0000,,تتصرّفين بصلابة أيّتها الفتاة الصّغيرة
Dialogue: 0,0:19:31.91,0:19:35.19,Default,Landlord,0000,0000,0000,,ما الّذي يجعلكِ تعتقدين بأنّكِ ستخرجين\Nمن هذا سليمة؟
Dialogue: 0,0:19:35.19,0:19:38.53,Default,Maomao,0000,0000,0000,,يمكنني توجيه نفس الكلام إليك
Dialogue: 0,0:19:38.53,0:19:40.65,Default,Maomao,0000,0000,0000,,أَدرِك وضعَك قبل أن تتكلّم
Dialogue: 0,0:19:47.84,0:19:50.39,Default,Maomao,0000,0000,0000,,تفضّل، اطلب المُساعدة
Dialogue: 0,0:19:50.39,0:19:53.71,Default,Maomao,0000,0000,0000,,سأستدعي السّلطات كذلك
Dialogue: 0,0:19:54.19,0:19:58.59,italics,Maomao,0000,0000,0000,,في الحقيقة، النّاس هنا مُرعِبون أكثر\Nمن أيّ سلطة محلّية
Dialogue: 0,0:20:00.33,0:20:04.46,Default,Guen,0000,0000,0000,,أيّتها الآنسة الصّغيرة، أنتِ مختلفة\N…تماماً عن المعتاد
Dialogue: 0,0:20:05.67,0:20:09.39,Default,Maomao,0000,0000,0000,,إن أردت تهديد شخص، فكُن جاهزاً\Nلتلقّي تهديدٍ بالمُقابل على الأقلّ
Dialogue: 0,0:20:13.14,0:20:16.95,Default,Maomao,0000,0000,0000,,لِمَ بذلت كُلّ هذا الجهد لكي تكون\Nبهذه القسوة؟
Dialogue: 0,0:20:21.62,0:20:23.66,Default,Daughter,0000,0000,0000,,!أرجوكم! أتوسّل رحمتكم
Dialogue: 0,0:20:25.71,0:20:27.58,Default,Younger Son,0000,0000,0000,,لا، لم نكن نحن
Dialogue: 0,0:20:27.58,0:20:32.10,Default,Daughter,0000,0000,0000,,أنا آسفة! أعلم بأنّ أبي كان يتصرّف\Nبشكل غير عقلانيّ ثانية
Dialogue: 0,0:20:32.10,0:20:34.88,Default,Daughter,0000,0000,0000,,!أرجوكم، سامحوا أبي الأحمق
Dialogue: 0,0:20:36.19,0:20:39.75,Default,Older Son,0000,0000,0000,,لن نفعل ذلك لأبيكِ
Dialogue: 0,0:20:41.27,0:20:44.28,Default,Landlord,0000,0000,0000,,!أنت! ابتعد عن ابنتي
Dialogue: 0,0:20:44.28,0:20:45.14,Default,Daughter,0000,0000,0000,,!أبي
Dialogue: 0,0:20:45.14,0:20:45.88,Default,Older Son,0000,0000,0000,,!أبي
Dialogue: 0,0:20:45.88,0:20:48.62,Default,Landlord,0000,0000,0000,,!لستُ أبيك
Dialogue: 0,0:20:48.62,0:20:51.10,italics,Maomao,0000,0000,0000,,ما هذه الأجواء؟
Dialogue: 0,0:20:51.10,0:20:52.52,Default,Maomao,0000,0000,0000,,…إذاً، هل هذا
Dialogue: 0,0:20:53.01,0:20:55.44,Default,Younger Son,0000,0000,0000,,كما تعتقدين غالباً
Dialogue: 0,0:20:56.04,0:20:59.16,italics,Maomao,0000,0000,0000,,أجل، فهمتُ الآن سبب ميول\N،الابن الأكبر إلى جانب المُزارعين
Dialogue: 0,0:20:59.16,0:21:03.43,italics,Maomao,0000,0000,0000,,وسبب كره المالِك للغُرباء ورغبته في طردهم
Dialogue: 0,0:21:05.65,0:21:06.86,Default,Maomao,0000,0000,0000,,!يا للسّخافة
Dialogue: 0,0:21:07.24,0:21:09.52,Default,Younge Son,0000,0000,0000,,أخي مُحبٌّ مُخلص
Dialogue: 0,0:21:10.75,0:21:14.75,Default,Jinshi,0000,0000,0000,,هذا ليس سبباً لتدمير قرية كاملة
Dialogue: 0,0:21:14.75,0:21:19.92,italics,Maomao,0000,0000,0000,,على ذكر الأمر، الابن الأكبر قريب\Nالطّبيب الدجّال
Dialogue: 0,0:21:21.88,0:21:25.49,italics,Maomao,0000,0000,0000,,…أعتقد سأتجاهل هذا الأمر، لأجل الدجّال
Dialogue: 0,0:21:25.91,0:21:27.80,italics,Maomao,0000,0000,0000,,!أو لا! مُستحيل
Dialogue: 0,0:21:27.80,0:21:30.30,Default,Maomao,0000,0000,0000,,المعذرة. المزيد من الخمر رجاء
Dialogue: 0,0:21:30.64,0:21:32.27,Default,Madam,0000,0000,0000,,!ستشربين المزيد؟
Dialogue: 0,0:21:32.27,0:21:34.18,Default,Maomao,0000,0000,0000,,أستطيع تحمّل المزيد
Dialogue: 0,0:21:45.21,0:21:49.70,italics,Maomao,0000,0000,0000,,في النّهاية، قرّرتْ قرية صانعي الورق تسديد\Nالقرض على مدى خمس سنوات
Dialogue: 0,0:21:50.61,0:21:52.84,italics,Maomao,0000,0000,0000,,،بالنّسبة للرِّهان مع المالك
Dialogue: 0,0:21:52.84,0:21:57.87,italics,Maomao,0000,0000,0000,,قرّرتُ أن أدعهم يُرسلون الأرزّ إلى بيت\Nالزنجار خلال العشر سنوات المُقبلة
Dialogue: 0,0:21:59.39,0:22:04.61,italics,Maomao,0000,0000,0000,,…وبالنّسبة للابن الأكبر وابنة المُزارِع
Dialogue: 0,0:22:06.05,0:22:07.64,Default,Maomao,0000,0000,0000,,لا أُبالي
Dialogue: 0,0:23:45.07,0:24:00.00,Next_Time,Text,0000,0000,0000,,{\fscx105\fsp\blur1}الحلقة القادمة
Dialogue: 0,0:23:53.51,0:23:57.44,italicstop,Narrator,0000,0000,0000,,"الحلقة القادمة: "القِنَّب والدّين الشّعبيّ
Dialogue: 0,0:23:53.58,0:24:00.00,Next_Ep_Title,Text,0000,0000,0000,,{\fad(479,1)\fscx90}الحلقة 56: القِنَّب والدّين الشّعبيّ

