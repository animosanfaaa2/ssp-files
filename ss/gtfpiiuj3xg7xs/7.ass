Dialogue: 0,0:02:12.46,0:02:16.21,Default,,0,0,0,,Sayang sekali harus pergi, tapi sudah\Nwaktunya keluar dari Kerajaan Blok.
Dialogue: 0,0:02:16.21,0:02:19.74,Default,,0,0,0,,Kuharap di luar sana benar-benar Elbaph.
Dialogue: 0,0:02:22.22,0:02:25.18,Default,,0,0,0,,Gomu Gomu no...
Dialogue: 0,0:02:25.72,0:02:28.16,Default,,0,0,0,,Kong Gun!
Dialogue: 0,0:02:34.65,0:02:36.49,Default,,0,0,0,,PERTEMUAN DI PADANG SALJU.\NLOKI, SANG PANGERAN TERKUTUK
Dialogue: 0,0:02:36.53,0:02:42.57,Default,,0,0,0,,"Pertemuan di Padang Salju.\NLoki, sang Pangeran Terkutuk."
Dialogue: 0,0:02:48.21,0:02:49.96,Default,,0,0,0,,Di mana kapalnya?
Dialogue: 0,0:02:49.96,0:02:52.33,Default,,0,0,0,,Sunny!
Dialogue: 0,0:02:54.17,0:02:55.67,Default,,0,0,0,,Topi Jerami!
Dialogue: 0,0:02:55.95,0:02:57.51,Default,,0,0,0,,Topi Jerami!
Dialogue: 0,0:02:57.51,0:02:59.67,Default,,0,0,0,,Hei, Topi Jerami!
Dialogue: 0,0:02:59.67,0:03:01.07,Default,,0,0,0,,Keluarlah!
Dialogue: 0,0:03:01.89,0:03:03.76,Default,,0,0,0,,Topi Jerami!
Dialogue: 0,0:03:03.90,0:03:05.70,Default,,0,0,0,,Topi Jerami!
Dialogue: 0,0:03:06.08,0:03:07.06,Default,,0,0,0,,Kalian menemukan mereka?
Dialogue: 0,0:03:07.06,0:03:09.52,Default,,0,0,0,,Tidak, sama sekali tidak ada tanda-tanda...
Dialogue: 0,0:03:09.52,0:03:11.10,Default,,0,0,0,,Kehadiran mereka.
Dialogue: 0,0:03:11.10,0:03:14.44,Default,,0,0,0,,Padahal kami sudah mencari\Ndi seluruh perairan sekitar sini.
Dialogue: 0,0:03:14.44,0:03:16.15,Default,,0,0,0,,Jangan-jangan
Dialogue: 0,0:03:16.15,0:03:18.36,Default,,0,0,0,,mereka tenggelam ke dasar laut?
Dialogue: 0,0:03:18.36,0:03:19.92,Default,,0,0,0,,Apa?
Dialogue: 0,0:03:21.57,0:03:24.87,Default,,0,0,0,,Kalau begitu, mari cari di dasar laut!
Dialogue: 0,0:03:25.45,0:03:28.87,Default,,0,0,0,,Bajak Laut Raksasa, menyelamlah!
Dialogue: 0,0:03:28.87,0:03:30.00,Default,,0,0,0,,Baik!
Dialogue: 0,0:03:30.00,0:03:31.19,Default,,0,0,0,,Ya!
Dialogue: 0,0:03:31.54,0:03:34.38,Default,,0,0,0,,Kami datang, Topi Jerami dan kawan-kawan!
Dialogue: 0,0:03:34.38,0:03:35.90,Default,,0,0,0,,Satu, dua!
Dialogue: 0,0:03:38.76,0:03:39.82,Default,,0,0,0,,Hm?
Dialogue: 0,0:03:40.22,0:03:41.80,Default,,0,0,0,,Baiklah.
Dialogue: 0,0:03:41.80,0:03:43.74,Default,,0,0,0,,Prajurit Elbaph!
Dialogue: 0,0:03:49.06,0:03:50.71,Default,,0,0,0,,Kalian menemukan sesuatu?
Dialogue: 0,0:03:51.52,0:03:54.29,Default,,0,0,0,,Pencarian dibatalkan!
Dialogue: 0,0:03:55.23,0:03:56.20,Default,,0,0,0,,Apa?
Dialogue: 0,0:03:56.31,0:03:57.60,Default,,0,0,0,,Apa?!
Dialogue: 0,0:03:57.78,0:04:00.40,Default,,0,0,0,,Apa?!
Dialogue: 0,0:04:11.00,0:04:12.50,Default,,0,0,0,,Kenapa?
Dialogue: 0,0:04:12.50,0:04:15.25,Default,,0,0,0,,Topi Jerami dan yang lain masih...
Dialogue: 0,0:04:15.25,0:04:19.63,Default,,0,0,0,,Ya, sudah mencari ke mana-mana,\Ntapi mereka tak ditemukan.
Dialogue: 0,0:04:19.63,0:04:22.47,Default,,0,0,0,,Tapi aku yakin mereka baik-baik saja.
Dialogue: 0,0:04:22.47,0:04:26.82,Default,,0,0,0,,Lagi pula, Sunny bukan kapal rapuh\Nyang akan tenggelam semudah itu.
Dialogue: 0,0:04:28.10,0:04:29.22,Default,,0,0,0,,Jadi...
Dialogue: 0,0:04:29.22,0:04:30.60,Default,,0,0,0,,Maksudmu...
Dialogue: 0,0:04:30.60,0:04:31.29,Default,,0,0,0,,Ya.
Dialogue: 0,0:04:32.81,0:04:34.12,Default,,0,0,0,,Mereka masih hidup.
Dialogue: 0,0:04:34.48,0:04:37.15,Default,,0,0,0,,Mereka pasti masih hidup!
Dialogue: 0,0:04:37.69,0:04:38.98,Default,,0,0,0,,Betul.
Dialogue: 0,0:04:38.98,0:04:42.61,Default,,0,0,0,,Lagi pula, ini bukan pertama kalinya\Nkami terpisah seperti ini.
Dialogue: 0,0:04:45.78,0:04:47.47,Default,,0,0,0,,Franky benar.
Dialogue: 0,0:04:47.87,0:04:49.53,Default,,0,0,0,,Begitu rupanya.
Dialogue: 0,0:04:49.53,0:04:51.75,Default,,0,0,0,,Sekarang semuanya mulai masuk akal.
Dialogue: 0,0:04:51.75,0:04:53.31,Default,,0,0,0,,Bagaimana menurut kalian, Bos?
Dialogue: 0,0:04:55.00,0:04:57.13,Default,,0,0,0,,Sepertinya kita tak perlu khawatir.
Dialogue: 0,0:04:57.13,0:05:00.27,Default,,0,0,0,,Aku sudah menggunakan jaringan hiuku,
Dialogue: 0,0:05:00.67,0:05:04.88,Default,,0,0,0,,tapi tak ada tanda-tanda keberadaan\NLuffy dan yang lain di dalam laut.
Dialogue: 0,0:05:04.88,0:05:09.49,Default,,0,0,0,,Jadi, kemungkinan mereka terdampar\Ndi suatu pulau.
Dialogue: 0,0:05:10.10,0:05:14.66,Default,,0,0,0,,Kalian semua sudah melakukan\Nlebih dari cukup,
Dialogue: 0,0:05:15.27,0:05:17.60,Default,,0,0,0,,dan persediaan makanan kita sudah habis.
Dialogue: 0,0:05:17.60,0:05:20.63,Default,,0,0,0,,Percuma kalau kalian mati kelaparan\Nsaat berusaha mencari mereka.
Dialogue: 0,0:05:22.38,0:05:26.15,Default,,0,0,0,,Terima kasih sudah mencari mereka\Nseolah itu kawan kalian sendiri.
Dialogue: 0,0:05:26.15,0:05:27.99,Default,,0,0,0,,Aku benar-benar tersentuh.
Dialogue: 0,0:05:28.62,0:05:30.78,Default,,0,0,0,,Kita semua menuju tempat yang sama.
Dialogue: 0,0:05:32.54,0:05:34.00,Default,,0,0,0,,Begitu, ya.
Dialogue: 0,0:05:34.00,0:05:36.94,Default,,0,0,0,,Kalau kru mereka sendiri bilang begitu,\Nberarti mereka baik-baik saja.
Dialogue: 0,0:05:39.54,0:05:41.86,Default,,0,0,0,,Mari kita tunggu mereka di Elbaph.
Dialogue: 0,0:05:42.63,0:05:45.32,Default,,0,0,0,,Baiklah kalau begitu, kawan-kawan!
Dialogue: 0,0:05:45.65,0:05:48.16,Default,,0,0,0,,Menuju Elbaph!
Dialogue: 0,0:05:53.64,0:05:55.39,Default,,0,0,0,,Mari bersulang untuk kepulangan kita!
Dialogue: 0,0:05:55.39,0:05:58.81,Default,,0,0,0,,Bos, miras dan makanan kita sudah habis!
Dialogue: 0,0:06:18.25,0:06:21.54,Default,,0,0,0,,Kita sudah di luar, 'kan?
Dialogue: 0,0:06:22.59,0:06:24.84,Default,,0,0,0,,Dingin sekali.
Dialogue: 0,0:06:28.51,0:06:29.91,Default,,0,0,0,,Salju...
Dialogue: 0,0:06:35.37,0:06:36.45,Default,,0,0,0,,Nami!
Dialogue: 0,0:06:45.78,0:06:46.94,Default,,0,0,0,,Kau tak apa-apa?
Dialogue: 0,0:06:47.82,0:06:49.22,Default,,0,0,0,,Hei, mau ke mana?
Dialogue: 0,0:06:51.20,0:06:54.31,Default,,0,0,0,,Kembali ke sini, soalnya dingin!
Dialogue: 0,0:06:55.24,0:06:56.52,Default,,0,0,0,,Dia takkan kembali, Nami.
Dialogue: 0,0:06:56.87,0:07:01.27,Default,,0,0,0,,Lagi pula, bukan dia\Nyang memilih ikut dengan kita.
Dialogue: 0,0:07:02.75,0:07:06.09,Default,,0,0,0,,Nami, kau boleh pakai jubahku.
Dialogue: 0,0:07:06.09,0:07:07.74,Default,,0,0,0,,Terima kasih, Sanji.
Dialogue: 0,0:07:08.13,0:07:10.59,Default,,0,0,0,,Orang bodoh memang tidak bisa masuk angin.
Dialogue: 0,0:07:10.59,0:07:12.95,Default,,0,0,0,,Aku dengar itu,\Ndasar pendekar pedang kelas teri!
Dialogue: 0,0:07:13.89,0:07:15.47,Default,,0,0,0,,Lihat, Usopp!
Dialogue: 0,0:07:15.47,0:07:16.89,Default,,0,0,0,,Apa?
Dialogue: 0,0:07:19.16,0:07:21.44,Default,,0,0,0,,Besar sekali.
Dialogue: 0,0:07:22.60,0:07:24.84,Default,,0,0,0,,Pohon apa ini?
Dialogue: 0,0:07:26.32,0:07:28.76,Default,,0,0,0,,Jangan-jangan ini juga pohon buatan?
Dialogue: 0,0:07:31.76,0:07:32.59,Default,,0,0,0,,Nami.
Dialogue: 0,0:07:34.45,0:07:36.53,Default,,0,0,0,,Aku penasaran.
Dialogue: 0,0:07:36.53,0:07:38.91,Default,,0,0,0,,Sudah berapa ribu tahun usianya?
Dialogue: 0,0:07:38.91,0:07:42.71,Default,,0,0,0,,Semua pohonnya seperti itu!
Dialogue: 0,0:07:45.04,0:07:48.42,Default,,0,0,0,,Wah, besar sekali. Apa itu gunung?
Dialogue: 0,0:07:48.42,0:07:50.18,Default,,0,0,0,,Ukurannya sebesar pulau.
Dialogue: 0,0:07:50.18,0:07:52.97,Default,,0,0,0,,Tidak, bahkan lebih besar.
Dialogue: 0,0:07:52.97,0:07:54.26,Default,,0,0,0,,Tunggu sebentar.
Dialogue: 0,0:07:54.26,0:07:57.26,Default,,0,0,0,,Semuanya begitu luas, ini membuatku pusing.
Dialogue: 0,0:07:58.18,0:07:59.87,Default,,0,0,0,,Luar biasa.
Dialogue: 0,0:08:00.31,0:08:02.19,Default,,0,0,0,,Hei, lihat ini!
Dialogue: 0,0:08:07.40,0:08:09.30,Default,,0,0,0,,Sulit dipercaya.
Dialogue: 0,0:08:10.86,0:08:14.34,Default,,0,0,0,,Jembatan gantung ini panjang sekali!
Dialogue: 0,0:08:15.57,0:08:18.32,Default,,0,0,0,,Apa jembatan ini menembus awan?
Dialogue: 0,0:08:18.32,0:08:20.29,Default,,0,0,0,,Aku tak bisa melihat ujungnya.
Dialogue: 0,0:08:20.29,0:08:23.25,Default,,0,0,0,,Tapi di belakang kita adalah\NKastel Dewa Matahari.
Dialogue: 0,0:08:23.25,0:08:25.25,Default,,0,0,0,,Tak ada jalan lain selain maju.
Dialogue: 0,0:08:25.25,0:08:25.94,Default,,0,0,0,,Apa?
Dialogue: 0,0:08:26.33,0:08:28.21,Default,,0,0,0,,Kau takut, Usopp?
Dialogue: 0,0:08:28.21,0:08:30.59,Default,,0,0,0,,Ma-Mana mungkin! Ini gampang.
Dialogue: 0,0:08:30.59,0:08:34.03,Default,,0,0,0,,Baiklah, kalau begitu ikutlah aku.
Dialogue: 0,0:08:36.05,0:08:37.80,Default,,0,0,0,,Tu-Tunggu sebentar.
Dialogue: 0,0:08:37.80,0:08:39.58,Default,,0,0,0,,Biar aku duluan...
Dialogue: 0,0:08:46.48,0:08:47.25,Default,,0,0,0,,Ada apa?
Dialogue: 0,0:08:57.95,0:08:59.28,Default,,0,0,0,,Ra-Raksasa!
Dialogue: 0,0:08:59.28,0:09:01.12,Default,,0,0,0,,Mereka menyeberangi jembatan.
Dialogue: 0,0:09:01.12,0:09:02.33,Default,,0,0,0,,Ayo sembunyi!
Dialogue: 0,0:09:03.08,0:09:03.87,Default,,0,0,0,,Luffy!
Dialogue: 0,0:09:03.87,0:09:04.96,Default,,0,0,0,,Ya...
Dialogue: 0,0:09:07.67,0:09:09.38,Default,,0,0,0,,Ya ampun.
Dialogue: 0,0:09:09.38,0:09:12.57,Default,,0,0,0,,Kenapa juga Hajrudin membawa\Norang aneh sepertinya ke dalam kru?
Dialogue: 0,0:09:14.55,0:09:18.22,Default,,0,0,0,,Yah, itu karena dia adalah\Nnavigator yang andal.
Dialogue: 0,0:09:18.22,0:09:19.91,Default,,0,0,0,,Aku benci dia.
Dialogue: 0,0:09:20.31,0:09:22.91,Default,,0,0,0,,Dialah aib Elbaph, bukan Loki.
Dialogue: 0,0:09:23.48,0:09:25.92,Default,,0,0,0,,GERD, DOKTER KAPAL,\NBAJAK LAUT PRAJURIT RAKSASA BARU
Dialogue: 0,0:09:27.40,0:09:30.67,Default,,0,0,0,,Jangan bicara begitu,\Nitu hanya akan membuat Rodo senang.
Dialogue: 0,0:09:31.40,0:09:33.69,Default,,0,0,0,,GOLDBERG, KOKI,\NBAJAK LAUT PRAJURIT RAKSASA BARU
Dialogue: 0,0:09:33.69,0:09:36.53,Default,,0,0,0,,Hei, Piper, kau melihatnya, 'kan?
Dialogue: 0,0:09:36.53,0:09:39.74,Default,,0,0,0,,Kau melihat burung gagaknya\Nmembawa kapal kecil.
Dialogue: 0,0:09:43.45,0:09:46.31,Default,,0,0,0,,Penyusup sudah seharusnya ditangkap,
Dialogue: 0,0:09:46.31,0:09:49.29,Default,,0,0,0,,tapi Rodo malah sering\Nmengundang mereka masuk sendiri.
Dialogue: 0,0:09:50.84,0:09:53.55,Default,,0,0,0,,Hobinya itu benar-benar bikin pusing.
Dialogue: 0,0:09:53.55,0:09:56.59,Default,,0,0,0,,Akan kutangkap basah dia\Ndan kulaporkan pada Kepala Suku Jarul.
Dialogue: 0,0:10:01.18,0:10:03.01,Default,,0,0,0,,Biarkan saja mereka lewat.
Dialogue: 0,0:10:03.01,0:10:05.31,Default,,0,0,0,,A-Apa kalian dengar itu?
Dialogue: 0,0:10:05.31,0:10:08.69,Default,,0,0,0,,Mereka bilang Elbaph.\NJadi, ini pasti...
Dialogue: 0,0:10:08.69,0:10:10.23,Default,,0,0,0,,Hei, diam!
Dialogue: 0,0:10:10.94,0:10:12.15,Default,,0,0,0,,Luffy!
Dialogue: 0,0:10:12.15,0:10:13.19,Default,,0,0,0,,Apa?
Dialogue: 0,0:10:13.19,0:10:14.78,Default,,0,0,0,,Tetap sembunyi!
Dialogue: 0,0:10:14.78,0:10:16.65,Default,,0,0,0,,Tapi sepertinya mereka orang baik.
Dialogue: 0,0:10:17.65,0:10:19.74,Default,,0,0,0,,Hei, kalian lihat ke...
Dialogue: 0,0:10:19.74,0:10:23.49,Default,,0,0,0,,Dasar bodoh!\NMereka bilang penyusup akan ditangkap, 'kan?
Dialogue: 0,0:10:23.49,0:10:25.18,Default,,0,0,0,,Hei, Luffy.
Dialogue: 0,0:10:25.58,0:10:27.87,Default,,0,0,0,,Dengarkan Nami.
Dialogue: 0,0:10:36.55,0:10:39.28,Default,,0,0,0,,Sudah kuduga pasti ada\Nwanita raksasa yang cantik.
Dialogue: 0,0:10:44.26,0:10:45.54,Default,,0,0,0,,Mungkin cuma perasaanku.
Dialogue: 0,0:10:45.97,0:10:47.00,Default,,0,0,0,,Sepertinya begitu.
Dialogue: 0,0:10:57.99,0:11:00.30,Default,,0,0,0,,Sedang apa kalian?
Dialogue: 0,0:11:03.03,0:11:05.37,Default,,0,0,0,,Rodo, kau di sana?
Dialogue: 0,0:11:08.12,0:11:09.71,Default,,0,0,0,,Baiklah.
Dialogue: 0,0:11:09.71,0:11:12.33,Default,,0,0,0,,Kawan-kawan, ikuti aku!
Dialogue: 0,0:11:12.33,0:11:13.69,Default,,0,0,0,,Ya!
Dialogue: 0,0:11:17.21,0:11:18.74,Default,,0,0,0,,Ayo.
Dialogue: 0,0:11:20.09,0:11:22.28,Default,,0,0,0,,Jembatannya bergoyang.
Dialogue: 0,0:11:23.93,0:11:27.39,Default,,0,0,0,,Jembatan gantung ukuran raksasa ini\Npenuh dengan celah.
Dialogue: 0,0:11:27.39,0:11:29.06,Default,,0,0,0,,Nami, jangan khawatir.
Dialogue: 0,0:11:29.06,0:11:31.39,Default,,0,0,0,,Aku dulu sering berjalan di atas tali,
Dialogue: 0,0:11:32.19,0:11:33.98,Default,,0,0,0,,jadi aku sangat pandai hal semacam ini.
Dialogue: 0,0:11:35.19,0:11:38.36,Default,,0,0,0,,Aku melihat kepingan salju\Nyang ukurannya sangat besar.
Dialogue: 0,0:11:38.36,0:11:40.03,Default,,0,0,0,,Perjalanan kita masih panjang.
Dialogue: 0,0:11:40.03,0:11:43.05,Default,,0,0,0,,Kita harus bergegas. Kalau mereka muncul,\Ntakkan ada tempat untuk lari.
Dialogue: 0,0:11:48.29,0:11:49.72,Default,,0,0,0,,Ini adalah ujian.
Dialogue: 0,0:11:49.72,0:11:51.96,Default,,0,0,0,,Ujian untuk para pemberani!
Dialogue: 0,0:11:58.76,0:12:01.93,Default,,0,0,0,,Hutan di bawah sana\Npenuh dengan serigala raksasa.
Dialogue: 0,0:12:01.93,0:12:03.76,Default,,0,0,0,,Hup!
Dialogue: 0,0:12:07.93,0:12:09.08,Default,,0,0,0,,Ada apa, Luffy?
Dialogue: 0,0:12:09.85,0:12:10.79,Default,,0,0,0,,Kau merasakannya?
Dialogue: 0,0:12:16.44,0:12:17.71,Default,,0,0,0,,Perasaan merinding ini...
Dialogue: 0,0:12:18.07,0:12:19.11,Default,,0,0,0,,Ya.
Dialogue: 0,0:12:19.11,0:12:21.03,Default,,0,0,0,,Aku tidak ikut.
Dialogue: 0,0:12:21.03,0:12:21.72,Default,,0,0,0,,Kalau begitu...
Dialogue: 0,0:12:21.72,0:12:24.36,Default,,0,0,0,,Takkan kubiarkan si kepala lumut\Nbuta arah ini pergi sendirian.
Dialogue: 0,0:12:24.36,0:12:26.82,Default,,0,0,0,,Dia tidak boleh masuk ke hutan mana pun.
Dialogue: 0,0:12:26.82,0:12:30.12,Default,,0,0,0,,Itu pasti suara auman\Nsaat kita ada di Kerajaan Blok tadi.
Dialogue: 0,0:12:30.12,0:12:31.02,Default,,0,0,0,,Mungkin.
Dialogue: 0,0:12:32.16,0:12:34.21,Default,,0,0,0,,Kalian duluan saja.
Dialogue: 0,0:12:34.21,0:12:34.94,Default,,0,0,0,,Apa?
Dialogue: 0,0:12:37.46,0:12:38.63,Default,,0,0,0,,Hah?
Dialogue: 0,0:12:38.63,0:12:40.00,Default,,0,0,0,,Hei, tunggu, Luffy!
Dialogue: 0,0:12:40.00,0:12:41.67,Default,,0,0,0,,Mau ke mana kau, Luffy?!
Dialogue: 0,0:12:41.67,0:12:44.34,Default,,0,0,0,,Di bawah sana\Ndipenuhi kawanan serigala, lo!
Dialogue: 0,0:12:50.31,0:12:52.48,Default,,0,0,0,,Jadilah pemberani, Usopp.
Dialogue: 0,0:12:52.60,0:12:55.58,Default,,0,0,0,,Jadilah pemberani, Usopp!
Dialogue: 0,0:13:10.58,0:13:12.83,Default,,0,0,0,,Apa?
Dialogue: 0,0:13:12.83,0:13:14.54,Default,,0,0,0,,Kita...
Dialogue: 0,0:13:14.54,0:13:16.73,Default,,0,0,0,,Menyerang Egghead?
Dialogue: 0,0:13:17.38,0:13:19.69,Default,,0,0,0,,Ya, ada di koran hari ini.
Dialogue: 0,0:13:20.67,0:13:22.90,Default,,0,0,0,,Kenapa mereka berbohong seperti itu?
Dialogue: 0,0:13:23.63,0:13:24.28,Default,,0,0,0,,Lihat.
Dialogue: 0,0:13:26.05,0:13:28.14,Default,,0,0,0,,Terlalu kecil. Aku tak bisa membacanya.
Dialogue: 0,0:13:28.89,0:13:29.95,Default,,0,0,0,,Biar kubacakan.
Dialogue: 0,0:13:33.27,0:13:35.89,Default,,0,0,0,,"Setelah tertidur selama 100 tahun,
Dialogue: 0,0:13:35.89,0:13:38.29,Default,,0,0,0,,Bajak Laut Raksasa telah kembali.
Dialogue: 0,0:13:42.57,0:13:47.43,Default,,0,0,0,,Bersama Luffy si Topi Jerami, salah satu\NKaisar Lautan, membumihanguskan Egghead.
Dialogue: 0,0:13:51.66,0:13:53.89,Default,,0,0,0,,Kapten Bajak Laut Raksasa,
Dialogue: 0,0:13:54.54,0:13:56.10,Default,,0,0,0,,Broggy si Raksasa Merah
Dialogue: 0,0:13:56.58,0:13:58.27,Default,,0,0,0,,dan Dorry si Raksasa Biru,
Dialogue: 0,0:13:58.67,0:14:01.96,Default,,0,0,0,,masing-masing memiliki harga buronan\Nsebesar 1,8 miliar Berry."
Dialogue: 0,0:14:03.13,0:14:06.11,Default,,0,0,0,,1,8 miliar?
Dialogue: 0,0:14:06.55,0:14:08.45,Default,,0,0,0,,Kalian dapat harga buronan baru, ya.
Dialogue: 0,0:14:10.26,0:14:12.97,Default,,0,0,0,,Aku tak ingat pernah "kembali" ke mana pun.
Dialogue: 0,0:14:12.97,0:14:17.19,Default,,0,0,0,,Harga buronan Bos dulunya\Nmasing-masing 100 juta.
Dialogue: 0,0:14:17.19,0:14:18.90,Default,,0,0,0,,Melonjak drastis!
Dialogue: 0,0:14:18.90,0:14:21.92,Default,,0,0,0,,Nilai buronan saat ini benar-benar\Nberbeda dari 100 tahun yang lalu.
Dialogue: 0,0:14:22.40,0:14:25.94,Default,,0,0,0,,Itu adalah nilai yang pantas untuk\Nkapten Prajurit Elbaph masa kini.
Dialogue: 0,0:14:26.57,0:14:27.93,Default,,0,0,0,,Nilai...
Dialogue: 0,0:14:28.28,0:14:30.32,Default,,0,0,0,,Nilainya berbeda, ya?
Dialogue: 0,0:14:30.32,0:14:33.16,Default,,0,0,0,,Ya, sepertinya begitu.
Dialogue: 0,0:14:33.16,0:14:37.37,Default,,0,0,0,,Di sini tertulis kapten kita\Nmembunuh Vegapunk.
Dialogue: 0,0:14:37.37,0:14:38.77,Default,,0,0,0,,Apa?
Dialogue: 0,0:14:39.75,0:14:42.36,Default,,0,0,0,,Seperti biasa,\Nmereka memutarbalikkan fakta.
Dialogue: 0,0:14:44.21,0:14:45.63,Default,,0,0,0,,Dia membunuhku.
Dialogue: 0,0:14:45.63,0:14:49.05,Default,,0,0,0,,Diamlah! Dia mencoba melindungimu\Nsampai akhir, 'kan?
Dialogue: 0,0:14:51.93,0:14:53.81,Default,,0,0,0,,Tapi aku penasaran.
Dialogue: 0,0:14:54.18,0:14:56.43,Default,,0,0,0,,Kapan foto ini diambil?
Dialogue: 0,0:14:56.43,0:14:58.50,Default,,0,0,0,,Mungkin suatu saat ketika kita di Egghead.
Dialogue: 0,0:14:59.23,0:15:02.02,Default,,0,0,0,,Antek-antek JED ada di mana-mana,
Dialogue: 0,0:15:02.02,0:15:05.96,Default,,0,0,0,,dan foto siapa pun bisa bernilai tinggi.
Dialogue: 0,0:15:06.86,0:15:07.92,Default,,0,0,0,,Hei.
Dialogue: 0,0:15:09.36,0:15:12.87,Default,,0,0,0,,Saat Luffy berubah ke Wujud Kebebasan-nya,
Dialogue: 0,0:15:12.87,0:15:14.81,Default,,0,0,0,,apa tanda ini selalu muncul di lengannya?
Dialogue: 0,0:15:15.45,0:15:18.54,Default,,0,0,0,,Ya, aku jelas melihat sesuatu\Nseperti tanda di sana.
Dialogue: 0,0:15:18.54,0:15:20.11,Default,,0,0,0,,Memangnya dia punya tanda itu?
Dialogue: 0,0:15:20.11,0:15:23.67,Default,,0,0,0,,Dia banyak bergerak,\Naku tak pernah memperhatikannya.
Dialogue: 0,0:15:23.67,0:15:25.23,Default,,0,0,0,,Kelihatannya tidak alami bagiku.
Dialogue: 0,0:15:26.00,0:15:29.59,Default,,0,0,0,,Lengannya buram,\Ntapi tandanya terlihat jelas.
Dialogue: 0,0:15:29.59,0:15:31.66,Default,,0,0,0,,Aneh sekali kau malah fokus pada hal itu.
Dialogue: 0,0:15:32.22,0:15:34.12,Default,,0,0,0,,Rasanya seperti tak asing bagiku.
Dialogue: 0,0:15:35.97,0:15:40.46,Default,,0,0,0,,Lagi pula, tak disangka si Topi Jerami\Nkini setara dengan Akagami.
Dialogue: 0,0:15:40.85,0:15:45.86,Default,,0,0,0,,Kudengar pemuda bernama Hajrudin\Ndari Elbaph menjadi bawahan kalian.
Dialogue: 0,0:15:45.86,0:15:48.90,Default,,0,0,0,,Hajrudin? Secara teknis\Ndia adalah putra mahkota.
Dialogue: 0,0:15:48.90,0:15:50.70,Default,,0,0,0,,Maksudmu anak Raja Elbaph?
Dialogue: 0,0:15:50.70,0:15:51.86,Default,,0,0,0,,Benarkah itu?
Dialogue: 0,0:15:51.86,0:15:55.66,Default,,0,0,0,,Waktu kecil, dia itu bocah nakal\Nyang suka kekerasan.
Dialogue: 0,0:16:02.12,0:16:06.04,Default,,0,0,0,,Mereka ingin ikut menjemput kalian.
Dialogue: 0,0:16:12.59,0:16:15.55,Default,,0,0,0,,Tapi ada sedikit masalah di Elbaph.
Dialogue: 0,0:16:15.55,0:16:18.24,Default,,0,0,0,,Makanya hanya kami para veteran\Nyang datang.
Dialogue: 0,0:16:18.68,0:16:19.97,Default,,0,0,0,,Masalah?
Dialogue: 0,0:16:19.97,0:16:22.16,Default,,0,0,0,,Itu berita baru untukku.
Dialogue: 0,0:16:24.73,0:16:25.94,Default,,0,0,0,,Ya.
Dialogue: 0,0:16:25.94,0:16:29.90,Default,,0,0,0,,Ini terjadi saat para bos sedang pergi.
Dialogue: 0,0:16:34.86,0:16:39.77,Default,,0,0,0,,Raja memiliki anak lagi, kali ini anak sah.
Dialogue: 0,0:16:59.12,0:17:01.39,Default,,0,0,0,,Dingin!
Dialogue: 0,0:17:07.81,0:17:10.30,Default,,0,0,0,,Besar sekali.
Dialogue: 0,0:17:16.03,0:17:20.18,Default,,0,0,0,,Blok mainan memang seru,\Ntapi inilah petualangan sebenarnya.
Dialogue: 0,0:17:20.18,0:17:25.29,Default,,0,0,0,,Siapa pun yang meraung itu,\Nsuaranya keras sekali.
Dialogue: 0,0:17:25.29,0:17:28.42,Default,,0,0,0,,Dia mau berbagi sepotong\Ndaging besar denganku, tidak, ya?
Dialogue: 0,0:17:34.22,0:17:35.49,Default,,0,0,0,,Hei!
Dialogue: 0,0:17:36.63,0:17:39.32,Default,,0,0,0,,Di mana kau?
Dialogue: 0,0:17:43.72,0:17:45.75,Default,,0,0,0,,Mau apa kalian?
Dialogue: 0,0:18:13.96,0:18:15.30,Default,,0,0,0,,Yang barusan...
Dialogue: 0,0:18:15.76,0:18:16.80,Default,,0,0,0,,dari arah sana, ya?
Dialogue: 0,0:18:20.26,0:18:22.28,Default,,0,0,0,,Anak baru itu...
Dialogue: 0,0:18:22.72,0:18:26.62,Default,,0,0,0,,Anak baru itu dikenal sebagai\NPangeran Terkutuk.
Dialogue: 0,0:18:27.10,0:18:28.10,Default,,0,0,0,,Terkutuk?
Dialogue: 0,0:18:28.10,0:18:30.61,Default,,0,0,0,,Dia melakukan segala macam perbuatan jahat,
Dialogue: 0,0:18:30.61,0:18:34.32,Default,,0,0,0,,jadi dia sudah dirantai\Nselama beberapa tahun.
Dialogue: 0,0:18:34.32,0:18:35.92,Default,,0,0,0,,Tapi dia hampir saja kabur,
Dialogue: 0,0:18:36.44,0:18:39.53,Default,,0,0,0,,sampai seluruh pasukan prajurit\Nmengepung dan menangkapnya.
Dialogue: 0,0:18:41.66,0:18:44.24,Default,,0,0,0,,Seluruh pasukan Raksasa Elbaph?
Dialogue: 0,0:18:44.24,0:18:46.20,Default,,0,0,0,,Apa itu mungkin terjadi?
Dialogue: 0,0:18:46.20,0:18:50.40,Default,,0,0,0,,Ya, dia sudah gila.
Dialogue: 0,0:19:00.18,0:19:05.39,Default,,0,0,0,,Didorong oleh hasrat\Nakan Buah Iblis legendaris Elbaph,
Dialogue: 0,0:19:05.77,0:19:09.35,Default,,0,0,0,,dia membunuh ayahnya sendiri, Harald,
Dialogue: 0,0:19:09.35,0:19:11.46,Default,,0,0,0,,dan memakan buah itu.
Dialogue: 0,0:19:15.15,0:19:17.88,Default,,0,0,0,,Apa mungkin namanya...
Dialogue: 0,0:19:22.32,0:19:23.74,Default,,0,0,0,,Benar.
Dialogue: 0,0:19:23.74,0:19:26.49,Default,,0,0,0,,Kalau dia lepas lagi...
Dialogue: 0,0:19:27.83,0:19:30.16,Default,,0,0,0,,dunia akan hancur lebur.
Dialogue: 0,0:19:31.00,0:19:32.54,Default,,0,0,0,,Dia adalah...
Dialogue: 0,0:19:34.88,0:19:36.92,Default,,0,0,0,,aib Elbaph.
Dialogue: 0,0:19:40.88,0:19:42.93,Default,,0,0,0,,Sang Pangeran Terkutuk...
Dialogue: 0,0:19:45.01,0:19:46.18,Default,,0,0,0,,Loki.
Dialogue: 0,0:20:01.30,0:20:03.18,Default,,0,0,0,,Sebutkan namamu.
Dialogue: 0,0:20:06.41,0:20:07.70,Default,,0,0,0,,Aku Luffy.
Dialogue: 0,0:20:08.49,0:20:10.75,Default,,0,0,0,,Aku adalah orang yang akan\Nmenjadi Raja Bajak Laut.
Dialogue: 0,0:20:15.46,0:20:16.84,Default,,0,0,0,,Raja?
Dialogue: 0,0:20:16.84,0:20:17.71,Default,,0,0,0,,Benar.
Dialogue: 0,0:20:18.13,0:20:20.09,Default,,0,0,0,,Aku ada di mana dan siapa kau?
Dialogue: 0,0:20:20.09,0:20:23.09,Default,,0,0,0,,Apa? Kau datang ke sini tanpa tahu apa-apa?
Dialogue: 0,0:20:23.09,0:20:23.78,Default,,0,0,0,,Ya.
Dialogue: 0,0:20:26.68,0:20:30.93,Default,,0,0,0,,Masuk akal. Kalau kau tahu ada di mana,\Nkau takkan datang padaku.
Dialogue: 0,0:20:32.41,0:20:34.37,Default,,0,0,0,,Kalau begitu, akan kuberi tahu.
Dialogue: 0,0:20:40.11,0:20:43.32,Default,,0,0,0,,Ini adalah kerajaan prajurit Elbaph...
Dialogue: 0,0:20:44.45,0:20:46.07,Default,,0,0,0,,War-Land!
Dialogue: 0,0:20:54.75,0:20:57.92,Default,,0,0,0,,Negara yang dulunya hidup\Nhanya untuk berperang tanpa henti.
Dialogue: 0,0:21:00.00,0:21:03.15,Default,,0,0,0,,Negara terkuat di dunia.
Dialogue: 0,0:21:14.56,0:21:16.06,Default,,0,0,0,,Serta...
Dialogue: 0,0:21:16.06,0:21:18.75,Default,,0,0,0,,akulah yang akan membawa akhir dunia.
Dialogue: 0,0:21:21.61,0:21:23.82,Default,,0,0,0,,Aku adalah Dewa Matahari...
Dialogue: 0,0:21:24.90,0:21:26.07,Default,,0,0,0,,Loki.
Dialogue: 0,0:21:26.16,0:21:30.60,Default,,0,0,0,,BERSAMBUNG
Dialogue: 0,0:23:05.38,0:23:07.62,Default,,0,0,0,,Luffy bertemu Loki,
Dialogue: 0,0:23:07.62,0:23:10.20,Default,,0,0,0,,sang Pangeran Terkutuk\Nyang mengguncang Elbaph.
Dialogue: 0,0:23:10.63,0:23:13.78,Default,,0,0,0,,Loki mengaku memiliki informasi\Ntentang Akagami
Dialogue: 0,0:23:13.79,0:23:16.64,Default,,0,0,0,,dan menawarkan kesepakatan.
Dialogue: 0,0:23:16.64,0:23:20.64,Default,,0,0,0,,Apa sebenarnya yang akan dibawa\Noleh niat tersembunyi Loki?
Dialogue: 0,0:23:20.64,0:23:22.52,Default,,0,0,0,,Selanjutnya, di ONE PIECE.
Dialogue: 0,0:23:22.52,0:23:25.94,Default,,0,0,0,,"Kesepakatan Berbahaya!\NLoki dari Dunia Bawah dan Luffy."
Dialogue: 0,0:23:25.94,0:23:28.11,Default,,0,0,0,,Aku akan menjadi Raja Bajak Laut!
Dialogue: 0,0:23:28.24,0:23:30.72,Default,,0,0,0,,KESEPAKATAN BERBAHAYA!\NLOKI DARI DUNIA BAWAH DAN LUFFY

