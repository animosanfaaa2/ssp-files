Dialogue: 0,0:02:12.47,0:02:16.14,Default,,0,0,0,,Dù hơi lưu luyến, nhưng đến lúc\Nrời khỏi vương quốc khối xếp hình rồi!
Dialogue: 0,0:02:16.22,0:02:19.81,Default,,0,0,0,,Làm ơn! Bên ngoài là Elbaph đi!
Dialogue: 0,0:02:22.23,0:02:28.11,Default,,0,0,0,,Súng Khỉ Đột Cao Su!
Dialogue: 0,0:02:36.53,0:02:42.58,Default,,0,0,0,,Cuộc chạm trán trên cánh đồng tuyết!\NLoki, Vị Hoàng Tử Bị Nguyền Rủa
Dialogue: 0,0:02:48.21,0:02:52.34,Default,,0,0,0,,Tàu Sunny đâu rồi!?
Dialogue: 0,0:02:54.17,0:02:55.59,Default,,0,0,0,,Mũ Rơm!
Dialogue: 0,0:02:55.68,0:02:57.43,Default,,0,0,0,,Mũ Rơm!
Dialogue: 0,0:02:57.51,0:02:59.60,Default,,0,0,0,,Này, Mũ Rơm!
Dialogue: 0,0:02:59.68,0:03:01.01,Default,,0,0,0,,Ra đây đi!
Dialogue: 0,0:03:01.89,0:03:03.68,Default,,0,0,0,,Mũ Rơm!
Dialogue: 0,0:03:03.77,0:03:05.69,Default,,0,0,0,,Mũ Rơm!
Dialogue: 0,0:03:05.98,0:03:06.98,Default,,0,0,0,,Tìm thấy không?
Dialogue: 0,0:03:07.06,0:03:09.44,Default,,0,0,0,,Không, hoàn toàn không thấy...
Dialogue: 0,0:03:09.52,0:03:11.02,Default,,0,0,0,,tăm hơi đâu.
Dialogue: 0,0:03:11.11,0:03:14.15,Default,,0,0,0,,Đã tìm khắp vùng biển quanh đây rồi.
Dialogue: 0,0:03:14.44,0:03:16.15,Default,,0,0,0,,Lẽ nào...
Dialogue: 0,0:03:16.15,0:03:18.28,Default,,0,0,0,,đã bị chìm xuống biển?
Dialogue: 0,0:03:18.37,0:03:19.87,Default,,0,0,0,,Hả!?
Dialogue: 0,0:03:21.58,0:03:24.87,Default,,0,0,0,,Đến nước này thì xuống đáy biển tìm!
Dialogue: 0,0:03:25.46,0:03:28.79,Default,,0,0,0,,Băng Hải tặc Khổng lồ! Lặn xuống nước!
Dialogue: 0,0:03:28.88,0:03:29.92,Default,,0,0,0,,Rõ
Dialogue: 0,0:03:31.55,0:03:34.38,Default,,0,0,0,,Bọn ta tới đây, băng Mũ Rơm!
Dialogue: 0,0:03:34.38,0:03:35.84,Default,,0,0,0,,Một, hai...!
Dialogue: 0,0:03:38.76,0:03:39.76,Default,,0,0,0,,Hở?
Dialogue: 0,0:03:40.22,0:03:41.81,Default,,0,0,0,,Được rồi!
Dialogue: 0,0:03:41.81,0:03:43.68,Default,,0,0,0,,Những chiến binh Elbaph!
Dialogue: 0,0:03:49.06,0:03:50.65,Default,,0,0,0,,Cậu biết gì sao?
Dialogue: 0,0:03:51.52,0:03:54.23,Default,,0,0,0,,Hủy bỏ cuộc tìm kiếm.
Dialogue: 0,0:03:55.24,0:03:56.24,Default,,0,0,0,,Hả!?
Dialogue: 0,0:04:11.00,0:04:12.42,Default,,0,0,0,,Tại sao?!
Dialogue: 0,0:04:12.50,0:04:15.17,Default,,0,0,0,,Vẫn chưa tìm thấy nhóm Mũ Rơm mà!
Dialogue: 0,0:04:15.26,0:04:19.63,Default,,0,0,0,,Ừ. Đã tìm mãi mà chẳng thấy đâu.
Dialogue: 0,0:04:19.63,0:04:22.47,Default,,0,0,0,,Nhưng chắc chắn họ vẫn ổn thôi.
Dialogue: 0,0:04:22.47,0:04:26.77,Default,,0,0,0,,Tàu Sunny không mỏng manh đến nỗi\Ndễ chìm thế đâu.
Dialogue: 0,0:04:28.10,0:04:29.14,Default,,0,0,0,,Vậy...
Dialogue: 0,0:04:29.23,0:04:30.52,Default,,0,0,0,,tức là...
Dialogue: 0,0:04:30.60,0:04:31.23,Default,,0,0,0,,Phải.
Dialogue: 0,0:04:32.81,0:04:34.07,Default,,0,0,0,,Vẫn còn sống!
Dialogue: 0,0:04:34.48,0:04:37.15,Default,,0,0,0,,Họ vẫn còn sống!
Dialogue: 0,0:04:37.69,0:04:38.99,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:04:38.99,0:04:42.62,Default,,0,0,0,,Đây cũng đâu phải lần đầu\Nchúng ta bị chia cắt như thế này.
Dialogue: 0,0:04:45.79,0:04:47.41,Default,,0,0,0,,Franky nói đúng!
Dialogue: 0,0:04:47.87,0:04:49.54,Default,,0,0,0,,Ra vậy.
Dialogue: 0,0:04:49.54,0:04:51.46,Default,,0,0,0,,Bọn tôi cũng hiểu rồi.
Dialogue: 0,0:04:51.75,0:04:53.25,Default,,0,0,0,,Nhỉ, các đại ca?
Dialogue: 0,0:04:55.00,0:04:57.05,Default,,0,0,0,,Chúng ta lo lắng thừa rồi à.
Dialogue: 0,0:04:57.13,0:05:00.22,Default,,0,0,0,,Ta đã kết nối với mạng lưới cá mập.
Dialogue: 0,0:05:00.68,0:05:04.89,Default,,0,0,0,,Không có dấu vết nào của\Nnhóm Luffy ở dưới nước.
Dialogue: 0,0:05:04.89,0:05:09.43,Default,,0,0,0,,Vì vậy, có khả năng\Nhọ đã dạt vào một hòn đảo nào đó.
Dialogue: 0,0:05:10.10,0:05:14.61,Default,,0,0,0,,Mọi người đã làm quá đủ rồi.
Dialogue: 0,0:05:15.27,0:05:17.61,Default,,0,0,0,,Và nguồn lương thực trên tàu\Nđã cạn kiệt.
Dialogue: 0,0:05:17.61,0:05:20.57,Default,,0,0,0,,Nếu bị chết đói trong lúc tìm họ\Nthì đúng là trớ trêu.
Dialogue: 0,0:05:22.53,0:05:26.16,Default,,0,0,0,,Cảm ơn vì đã cố tìm kiếm họ\Nnhư người thân!
Dialogue: 0,0:05:26.16,0:05:27.99,Default,,0,0,0,,Tôi cảm động lắm đó.
Dialogue: 0,0:05:28.62,0:05:30.79,Default,,0,0,0,,Chúng ta đều hướng về một nơi mà.
Dialogue: 0,0:05:32.54,0:05:33.92,Default,,0,0,0,,Hiểu rồi.
Dialogue: 0,0:05:34.00,0:05:36.88,Default,,0,0,0,,Đồng đội đã nói vậy\Nthì chắc là ổn thôi.
Dialogue: 0,0:05:39.55,0:05:41.80,Default,,0,0,0,,Hãy đợi họ ở Elbaph.
Dialogue: 0,0:05:42.63,0:05:45.26,Default,,0,0,0,,Được, chốt thế thôi, các anh em!
Dialogue: 0,0:05:45.76,0:05:48.10,Default,,0,0,0,,Hướng tới Elbaph!
Dialogue: 0,0:05:53.65,0:05:55.31,Default,,0,0,0,,Nâng ly chúc mừng chuyến hồi hương!
Dialogue: 0,0:05:55.40,0:05:58.82,Default,,0,0,0,,Sếp ơi, không còn rượu hay thức ăn nữa đâu!
Dialogue: 0,0:06:18.25,0:06:21.55,Default,,0,0,0,,Ra được bên ngoài rồi đúng không?
Dialogue: 0,0:06:22.59,0:06:24.84,Default,,0,0,0,,Lạnh quá!
Dialogue: 0,0:06:28.51,0:06:29.85,Default,,0,0,0,,Tuyết...
Dialogue: 0,0:06:35.44,0:06:36.40,Default,,0,0,0,,Nami!
Dialogue: 0,0:06:45.78,0:06:46.95,Default,,0,0,0,,Không sao chứ?
Dialogue: 0,0:06:47.82,0:06:49.16,Default,,0,0,0,,Ơ, đi đâu thế?
Dialogue: 0,0:06:51.20,0:06:54.25,Default,,0,0,0,,Đang lạnh đấy! Quay lại đi!
Dialogue: 0,0:06:55.25,0:06:56.46,Default,,0,0,0,,Vô ích thôi, Nami.
Dialogue: 0,0:06:56.88,0:07:01.21,Default,,0,0,0,,Vốn dĩ, nó đâu có tự nguyện\Nđi theo chúng ta.
Dialogue: 0,0:07:02.76,0:07:06.01,Default,,0,0,0,,Nami, dùng áo choàng của tôi đi.
Dialogue: 0,0:07:06.09,0:07:07.68,Default,,0,0,0,,Cảm ơn, Sanji.
Dialogue: 0,0:07:08.14,0:07:10.51,Default,,0,0,0,,Mấy thằng ngốc không biết cảm lạnh đâu.
Dialogue: 0,0:07:10.60,0:07:12.89,Default,,0,0,0,,Nghe thấy đấy nhé, kiếm sĩ thối.
Dialogue: 0,0:07:13.89,0:07:15.39,Default,,0,0,0,,Nhìn kìa, Usopp!
Dialogue: 0,0:07:15.48,0:07:16.90,Default,,0,0,0,,Cái gì cơ?
Dialogue: 0,0:07:19.15,0:07:21.44,Default,,0,0,0,,To quá!
Dialogue: 0,0:07:22.61,0:07:24.78,Default,,0,0,0,,Cây gì thế này?
Dialogue: 0,0:07:26.32,0:07:28.70,Default,,0,0,0,,Lại một đồ nhân tạo khác sao?
Dialogue: 0,0:07:31.53,0:07:32.54,Default,,0,0,0,,Nami!
Dialogue: 0,0:07:34.45,0:07:36.54,Default,,0,0,0,,Cái cây này...
Dialogue: 0,0:07:36.54,0:07:38.83,Default,,0,0,0,,bao ngàn tuổi rồi nhỉ?
Dialogue: 0,0:07:38.92,0:07:42.71,Default,,0,0,0,,Cơ mà cây nào cũng to thế!
Dialogue: 0,0:07:45.05,0:07:48.34,Default,,0,0,0,,Đúng là to thật. Đó là núi sao?
Dialogue: 0,0:07:48.43,0:07:52.97,Default,,0,0,0,,To bằng hòn đảo luôn...\Nkhông, còn to hơn thế.
Dialogue: 0,0:07:52.97,0:07:54.27,Default,,0,0,0,,Khoan...
Dialogue: 0,0:07:54.27,0:07:57.27,Default,,0,0,0,,Cái gì cũng to quá. Tớ hoa mắt rồi.
Dialogue: 0,0:07:58.19,0:07:59.81,Default,,0,0,0,,Ghê thật.
Dialogue: 0,0:08:00.31,0:08:02.19,Default,,0,0,0,,Này, nhìn này!
Dialogue: 0,0:08:07.40,0:08:09.24,Default,,0,0,0,,Ghê thật.
Dialogue: 0,0:08:10.87,0:08:14.29,Default,,0,0,0,,Cây cầu treo dài thế!
Dialogue: 0,0:08:15.58,0:08:20.21,Default,,0,0,0,,Đi thẳng lên mây luôn. Chẳng thấy nổi điểm cuối.
Dialogue: 0,0:08:20.29,0:08:23.25,Default,,0,0,0,,Phía sau là lâu đài của Thần Mặt Trời.
Dialogue: 0,0:08:23.25,0:08:25.17,Default,,0,0,0,,Chỉ còn cách tiến lên thôi.
Dialogue: 0,0:08:25.26,0:08:25.88,Default,,0,0,0,,Hả!?
Dialogue: 0,0:08:26.34,0:08:28.13,Default,,0,0,0,,Sợ à, Usopp?
Dialogue: 0,0:08:28.22,0:08:30.51,Default,,0,0,0,,L-Làm gì có! Chuyện nhỏ mà!
Dialogue: 0,0:08:30.59,0:08:33.97,Default,,0,0,0,,Tốt! Vậy thì theo tớ!
Dialogue: 0,0:08:36.06,0:08:37.81,Default,,0,0,0,,K-K-Khoan đã!
Dialogue: 0,0:08:37.81,0:08:39.52,Default,,0,0,0,,Tớ sẽ đi trước...
Dialogue: 0,0:08:46.48,0:08:47.19,Default,,0,0,0,,Gì thế?
Dialogue: 0,0:08:57.95,0:08:59.21,Default,,0,0,0,,N-Người khổng lồ!
Dialogue: 0,0:08:59.29,0:09:01.04,Default,,0,0,0,,Hắn đang băng qua cầu!
Dialogue: 0,0:09:01.12,0:09:02.33,Default,,0,0,0,,Trốn mau!
Dialogue: 0,0:09:03.08,0:09:03.79,Default,,0,0,0,,Luffy!
Dialogue: 0,0:09:03.88,0:09:04.96,Default,,0,0,0,,Ừ...
Dialogue: 0,0:09:07.67,0:09:09.38,Default,,0,0,0,,Thiệt tình...
Dialogue: 0,0:09:09.38,0:09:12.51,Default,,0,0,0,,Tại sao Hajrudin lại kết nạp\Nmột kẻ lập dị như hắn vào băng chứ?
Dialogue: 0,0:09:14.55,0:09:18.14,Default,,0,0,0,,Vì hắn là một hoa tiêu tài ba mà.
Dialogue: 0,0:09:18.22,0:09:19.85,Default,,0,0,0,,Tôi ghét hắn.
Dialogue: 0,0:09:20.31,0:09:22.85,Default,,0,0,0,,Nỗi Nhục của Elbaph, không phải Loki\Nthì là hắn.
Dialogue: 0,0:09:23.48,0:09:25.86,Default,,0,0,0,,GERD, BÁC SĨ CỦA TÀU,\NBĂNG TÂN BINH HẢI TẶC KHỔNG LỒ
Dialogue: 0,0:09:27.40,0:09:30.61,Default,,0,0,0,,Nói thế chỉ làm Rodo vui sướng thôi!
Dialogue: 0,0:09:31.40,0:09:33.62,Default,,0,0,0,,GOLDBERG, ĐẦU BẾP,\NBĂNG TÂN BINH HẢI TẶC KHỔNG LỒ
Dialogue: 0,0:09:33.70,0:09:36.53,Default,,0,0,0,,Này, Piper, mi cũng thấy đúng không?
Dialogue: 0,0:09:36.53,0:09:39.75,Default,,0,0,0,,Con quạ của hắn đã mang theo\Nmột con tàu nhỏ.
Dialogue: 0,0:09:43.46,0:09:46.38,Default,,0,0,0,,Những kẻ xâm nhập\Ndĩ nhiên phải bị bắt giữ,
Dialogue: 0,0:09:46.38,0:09:49.30,Default,,0,0,0,,nhưng Rodo thường tự mời chúng vào.
Dialogue: 0,0:09:50.84,0:09:53.55,Default,,0,0,0,,Sở thích của hắn\Nđúng là khiến người ta đau đầu.
Dialogue: 0,0:09:53.55,0:09:56.60,Default,,0,0,0,,Tôi sẽ bắt quả tang hắn\Nvà báo cáo với Thủ lĩnh Jarul.
Dialogue: 0,0:10:01.18,0:10:02.94,Default,,0,0,0,,Cứ để chúng đi qua đi.
Dialogue: 0,0:10:03.02,0:10:05.31,Default,,0,0,0,,Mọi người, nghe thấy không?
Dialogue: 0,0:10:05.31,0:10:08.61,Default,,0,0,0,,Chúng đã nhắc đến Elbath! Đây chắc hẳn là...
Dialogue: 0,0:10:08.69,0:10:10.24,Default,,0,0,0,,Này, yên lặng đi!
Dialogue: 0,0:10:10.94,0:10:12.07,Default,,0,0,0,,Luffy!
Dialogue: 0,0:10:12.15,0:10:13.11,Default,,0,0,0,,Sao vậy?
Dialogue: 0,0:10:13.20,0:10:14.70,Default,,0,0,0,,Trốn đi!
Dialogue: 0,0:10:14.78,0:10:16.66,Default,,0,0,0,,Nhưng họ có vẻ là người tốt.
Dialogue: 0,0:10:17.66,0:10:19.66,Default,,0,0,0,,Này, hai người, bên này!
Dialogue: 0,0:10:19.74,0:10:23.41,Default,,0,0,0,,Đồ ngốc! Chúng vừa nói\Nkẻ xâm nhập sẽ bị bắt giữ cơ mà!
Dialogue: 0,0:10:23.50,0:10:25.13,Default,,0,0,0,,Này, Luffy!
Dialogue: 0,0:10:25.58,0:10:27.88,Default,,0,0,0,,Nghe Nami đi...
Dialogue: 0,0:10:36.55,0:10:39.22,Default,,0,0,0,,Biết ngay là sẽ có\Nnữ khổng lồ xinh đẹp mà!
Dialogue: 0,0:10:44.27,0:10:45.48,Default,,0,0,0,,Tôi nghe nhầm à?
Dialogue: 0,0:10:45.98,0:10:46.94,Default,,0,0,0,,Chắc vậy.
Dialogue: 0,0:10:57.99,0:11:00.24,Default,,0,0,0,,Làm cái gì vậy hả?
Dialogue: 0,0:11:03.04,0:11:05.37,Default,,0,0,0,,Rodo, có nhà không?
Dialogue: 0,0:11:08.13,0:11:09.71,Default,,0,0,0,,Được rồi!
Dialogue: 0,0:11:09.71,0:11:12.26,Default,,0,0,0,,Các cậu, hãy theo tớ!
Dialogue: 0,0:11:17.22,0:11:18.68,Default,,0,0,0,,Đi nào!
Dialogue: 0,0:11:20.10,0:11:22.22,Default,,0,0,0,,Lắc dữ quá!
Dialogue: 0,0:11:23.93,0:11:27.31,Default,,0,0,0,,Cầu treo của khổng lồ\Nnhiều khoảng hở quá.
Dialogue: 0,0:11:27.40,0:11:29.06,Default,,0,0,0,,Nami, yên tâm đi.
Dialogue: 0,0:11:29.06,0:11:31.40,Default,,0,0,0,,Tớ đã đi trên dây\Nvô số lần rồi.
Dialogue: 0,0:11:32.19,0:11:33.99,Default,,0,0,0,,Cái này là nghề của tớ.
Dialogue: 0,0:11:35.19,0:11:38.28,Default,,0,0,0,,Tuyết cũng mạnh đến bất thường nhỉ.
Dialogue: 0,0:11:38.36,0:11:40.03,Default,,0,0,0,,Đường phía trước dài đấy.
Dialogue: 0,0:11:40.03,0:11:42.99,Default,,0,0,0,,Không nhanh lên, khổng lồ xuất hiện\Nlà khỏi chạy.
Dialogue: 0,0:11:48.29,0:11:51.96,Default,,0,0,0,,Đây là thử thách\Ndành cho những chiến binh dũng cảm...
Dialogue: 0,0:11:58.76,0:12:01.85,Default,,0,0,0,,Khu rừng bên dưới\Ncũng toàn là sói khổng lồ.
Dialogue: 0,0:12:01.93,0:12:03.77,Default,,0,0,0,,Hây!
Dialogue: 0,0:12:07.94,0:12:09.02,Default,,0,0,0,,Sao thế, Luffy?
Dialogue: 0,0:12:09.85,0:12:10.73,Default,,0,0,0,,Tớ cảm nhận được...
Dialogue: 0,0:12:16.44,0:12:17.65,Default,,0,0,0,,một cảm giác râm ran.
Dialogue: 0,0:12:18.07,0:12:19.03,Default,,0,0,0,,Ừ.
Dialogue: 0,0:12:19.11,0:12:20.95,Default,,0,0,0,,Tớ không đi đâu.
Dialogue: 0,0:12:21.03,0:12:21.78,Default,,0,0,0,,Vậy...
Dialogue: 0,0:12:21.87,0:12:24.37,Default,,0,0,0,,Cũng không thể để\Ntên đầu rêu mù đường này đi được.
Dialogue: 0,0:12:24.37,0:12:26.75,Default,,0,0,0,,Đừng có vào bất cứ khu rừng nào.
Dialogue: 0,0:12:26.83,0:12:30.12,Default,,0,0,0,,Đó là kẻ đã gầm thét\Nkhi chúng ta còn ở Vương quốc Khối Xếp Hình!
Dialogue: 0,0:12:30.12,0:12:30.96,Default,,0,0,0,,Chắc vậy.
Dialogue: 0,0:12:32.17,0:12:34.13,Default,,0,0,0,,Các cậu cứ đi trước đi.
Dialogue: 0,0:12:34.21,0:12:34.88,Default,,0,0,0,,Hả?
Dialogue: 0,0:12:37.47,0:12:38.55,Default,,0,0,0,,Hả?!
Dialogue: 0,0:12:38.63,0:12:39.93,Default,,0,0,0,,Này, đợi đã, Luffy!
Dialogue: 0,0:12:40.01,0:12:41.68,Default,,0,0,0,,Đi đâu vậy, Luffy?!
Dialogue: 0,0:12:41.68,0:12:44.35,Default,,0,0,0,,Bên dưới toàn là sói đó!
Dialogue: 0,0:12:50.31,0:12:52.48,Default,,0,0,0,,Dũng cảm lên, Usopp...
Dialogue: 0,0:12:52.48,0:12:55.53,Default,,0,0,0,,Dũng cảm lên, Usopp!
Dialogue: 0,0:13:10.58,0:13:12.83,Default,,0,0,0,,Cái gì cơ!?
Dialogue: 0,0:13:12.83,0:13:14.46,Default,,0,0,0,,Chúng ta...
Dialogue: 0,0:13:14.54,0:13:16.67,Default,,0,0,0,,đã tấn công Egghead?!
Dialogue: 0,0:13:17.38,0:13:19.63,Default,,0,0,0,,Phải. Báo sáng nay viết vậy.
Dialogue: 0,0:13:20.68,0:13:22.84,Default,,0,0,0,,Tại sao lại bịa đặt như vậy!?
Dialogue: 0,0:13:23.64,0:13:24.22,Default,,0,0,0,,Nhìn này.
Dialogue: 0,0:13:26.06,0:13:28.14,Default,,0,0,0,,Chữ nhỏ quá, không đọc được.
Dialogue: 0,0:13:28.89,0:13:29.89,Default,,0,0,0,,Để tôi đọc cho.
Dialogue: 0,0:13:33.27,0:13:35.61,Default,,0,0,0,,"Sau giấc ngủ dài 100 năm,
Dialogue: 0,0:13:35.90,0:13:38.23,Default,,0,0,0,,Băng Hải tặc Khổng lồ đã trở lại!
Dialogue: 0,0:13:42.57,0:13:47.37,Default,,0,0,0,,Cùng Mũ Rơm Luffy, một Tứ Hoàng,\Nhọ đã nhấn chìm Egghead trong biển lửa.
Dialogue: 0,0:13:51.66,0:13:53.83,Default,,0,0,0,,Thuyền trưởng của Băng Hải tặc Khổng lồ,
Dialogue: 0,0:13:54.54,0:13:56.04,Default,,0,0,0,,Quỷ Đỏ Brogy
Dialogue: 0,0:13:56.59,0:13:58.21,Default,,0,0,0,,và Quỷ Xanh Dorry,
Dialogue: 0,0:13:58.67,0:14:01.97,Default,,0,0,0,,được treo thưởng 1,8 tỷ berry mỗi người."
Dialogue: 0,0:14:03.13,0:14:06.05,Default,,0,0,0,,1,8 tỷ?!
Dialogue: 0,0:14:06.55,0:14:08.39,Default,,0,0,0,,Còn có cả tiền thưởng cơ à!
Dialogue: 0,0:14:10.27,0:14:12.89,Default,,0,0,0,,Có định "trở lại" hay gì đâu...
Dialogue: 0,0:14:12.98,0:14:17.19,Default,,0,0,0,,Ngày xưa, tiền thưởng của hai sếp\Nchỉ khoảng 100 triệu.
Dialogue: 0,0:14:17.19,0:14:18.82,Default,,0,0,0,,Tăng vọt rồi!
Dialogue: 0,0:14:18.90,0:14:21.86,Default,,0,0,0,,So với 100 năm trước\Nthì giá trị cũng khác xa mà.
Dialogue: 0,0:14:22.40,0:14:25.95,Default,,0,0,0,,Đối với thuyền trưởng của chiến binh Elbaph\Nthì cũng hợp lý.
Dialogue: 0,0:14:26.57,0:14:27.87,Default,,0,0,0,,Giá trị...
Dialogue: 0,0:14:28.28,0:14:30.24,Default,,0,0,0,,Giá trị giờ khác rồi à...
Dialogue: 0,0:14:30.33,0:14:33.08,Default,,0,0,0,,Ừ, chắc vậy.
Dialogue: 0,0:14:33.16,0:14:37.29,Default,,0,0,0,,Và báo còn nói thuyền trưởng của bọn tôi\Nđã giết Vegapunk.
Dialogue: 0,0:14:37.38,0:14:38.71,Default,,0,0,0,,Hả!?
Dialogue: 0,0:14:39.75,0:14:42.30,Default,,0,0,0,,Vẫn bóp méo câu chuyện như mọi khi.
Dialogue: 0,0:14:44.22,0:14:45.55,Default,,0,0,0,,Tôi cũng bị giết à?
Dialogue: 0,0:14:45.64,0:14:49.06,Default,,0,0,0,,Im đi! Đã bảo vệ\Nđến phút cuối còn gì.
Dialogue: 0,0:14:51.93,0:14:53.81,Default,,0,0,0,,Nhưng đó là...
Dialogue: 0,0:14:54.19,0:14:56.35,Default,,0,0,0,,bức ảnh chụp lúc nào vậy nhỉ?
Dialogue: 0,0:14:56.44,0:14:58.44,Default,,0,0,0,,Chắc là lúc nào đó ở trên Egghead.
Dialogue: 0,0:14:59.23,0:15:02.03,Default,,0,0,0,,Đám Thời Báo Thế Giới\Ncó ở khắp mọi nơi.
Dialogue: 0,0:15:02.03,0:15:05.91,Default,,0,0,0,,và ảnh của chúng ta\Ncũng khá được giá.
Dialogue: 0,0:15:06.86,0:15:07.87,Default,,0,0,0,,Này.
Dialogue: 0,0:15:09.37,0:15:12.87,Default,,0,0,0,,Khi Luffy chuyển sang trạng thái tự do,
Dialogue: 0,0:15:12.87,0:15:14.98,Default,,0,0,0,,thì trên tay luôn xuất hiện\Ndấu ấn này sao?
Dialogue: 0,0:15:15.46,0:15:18.46,Default,,0,0,0,,Đúng là trông như một dấu ấn gì đó.
Dialogue: 0,0:15:18.54,0:15:23.59,Default,,0,0,0,,Vậy hả? Tại cậu ấy cũng hay bay nhảy\Nnên tôi không nhìn rõ.
Dialogue: 0,0:15:23.67,0:15:25.17,Default,,0,0,0,,Trông không tự nhiên lắm nhỉ.
Dialogue: 0,0:15:26.01,0:15:29.51,Default,,0,0,0,,Cánh tay bị mờ\Nnhưng dấu ấn thì rõ.
Dialogue: 0,0:15:29.60,0:15:31.60,Default,,0,0,0,,Cô để ý điểm kỳ lạ nhỉ.
Dialogue: 0,0:15:32.22,0:15:34.06,Default,,0,0,0,,Tại trông nó có vẻ quen quen.
Dialogue: 0,0:15:35.98,0:15:40.40,Default,,0,0,0,,Nhưng không ngờ rằng Mũ Rơm\Ngiờ đã ngang hàng với Tóc Đỏ!
Dialogue: 0,0:15:40.86,0:15:45.78,Default,,0,0,0,,Nghe nói một thanh niên trẻ tên Hajrudin\Nđến từ Elbaph đã trở thành thuộc hạ của cậu ta!
Dialogue: 0,0:15:45.86,0:15:48.82,Default,,0,0,0,,Hajrudin! Trên danh nghĩa\Nlà con trai của nhà vua đấy.
Dialogue: 0,0:15:48.91,0:15:50.62,Default,,0,0,0,,Của vua Elbaph á?
Dialogue: 0,0:15:50.70,0:15:51.78,Default,,0,0,0,,Thật sao?
Dialogue: 0,0:15:51.87,0:15:55.66,Default,,0,0,0,,Hồi nhỏ là một đứa trẻ quậy phá lắm.
Dialogue: 0,0:16:02.13,0:16:06.05,Default,,0,0,0,,Hắn cũng rất muốn đi cùng để đón các cậu...
Dialogue: 0,0:16:12.60,0:16:15.48,Default,,0,0,0,,nhưng có một chút rắc rối ở Elbaph.
Dialogue: 0,0:16:15.56,0:16:18.19,Default,,0,0,0,,Thế nên chỉ có cựu binh bọn tôi đến.
Dialogue: 0,0:16:18.69,0:16:19.90,Default,,0,0,0,,Rắc rối?
Dialogue: 0,0:16:19.98,0:16:22.11,Default,,0,0,0,,Ta chưa nghe đấy.
Dialogue: 0,0:16:24.73,0:16:25.94,Default,,0,0,0,,À...
Dialogue: 0,0:16:25.94,0:16:29.91,Default,,0,0,0,,Chuyện này xảy ra lúc các sếp vắng mặt.
Dialogue: 0,0:16:34.87,0:16:39.71,Default,,0,0,0,,Elbaph đã có một người con vua khác,\Nlần này là chính thức.
Dialogue: 0,0:16:59.10,0:17:01.40,Default,,0,0,0,,Lạnh quá!
Dialogue: 0,0:17:07.82,0:17:10.24,Default,,0,0,0,,To thật đấy.
Dialogue: 0,0:17:16.04,0:17:20.08,Default,,0,0,0,,Khối xếp hình cũng vui đấy,\Nnhưng phiêu lưu thì phải thế này chứ!
Dialogue: 0,0:17:20.41,0:17:25.29,Default,,0,0,0,,Cái người đó\Nđã phát ra tiếng gầm to khủng khiếp!
Dialogue: 0,0:17:25.29,0:17:28.42,Default,,0,0,0,,Xin một miếng thịt lớn được không nhỉ?
Dialogue: 0,0:17:34.22,0:17:35.43,Default,,0,0,0,,Này!
Dialogue: 0,0:17:36.64,0:17:39.27,Default,,0,0,0,,Ở đâu vậy!?
Dialogue: 0,0:17:43.73,0:17:45.69,Default,,0,0,0,,Các ngươi muốn gì?
Dialogue: 0,0:18:13.97,0:18:15.30,Default,,0,0,0,,Vừa rồi là...
Dialogue: 0,0:18:15.76,0:18:16.80,Default,,0,0,0,,hướng đó!
Dialogue: 0,0:18:20.27,0:18:22.23,Default,,0,0,0,,Đứa con mới đó...
Dialogue: 0,0:18:22.73,0:18:26.56,Default,,0,0,0,,Hoàng tử mới đó được gọi là\NHoàng tử bị nguyền rủa.
Dialogue: 0,0:18:27.11,0:18:28.02,Default,,0,0,0,,Bị nguyền rủa?
Dialogue: 0,0:18:28.11,0:18:30.61,Default,,0,0,0,,Hắn đã phạm mọi loại tội ác,
Dialogue: 0,0:18:30.61,0:18:34.32,Default,,0,0,0,,nên đã bị xích lại trong nhiều năm,
Dialogue: 0,0:18:34.32,0:18:35.87,Default,,0,0,0,,nhưng hắn gần như đã trốn thoát...
Dialogue: 0,0:18:36.45,0:18:39.54,Default,,0,0,0,,cho đến khi toàn bộ chiến binh\Nxông vào bắt giữ hắn.
Dialogue: 0,0:18:41.66,0:18:44.25,Default,,0,0,0,,Toàn bộ chiến binh Khổng Lồ Elbaph?!
Dialogue: 0,0:18:44.25,0:18:46.13,Default,,0,0,0,,Một con quái vật như thế ư?
Dialogue: 0,0:18:46.21,0:18:50.34,Default,,0,0,0,,Ừ, hắn ta hoàn toàn mất trí rồi.
Dialogue: 0,0:19:00.18,0:19:05.39,Default,,0,0,0,,Bị thúc đẩy bởi ham muốn Trái Ác Quỷ Huyền Thoại\Nđược truyền lại trong hoàng tộc Elbaph...
Dialogue: 0,0:19:05.77,0:19:09.07,Default,,0,0,0,,hắn đã sát hại chính phụ vương của mình,
Dialogue: 0,0:19:09.36,0:19:11.40,Default,,0,0,0,,và ăn trái cây đó.
Dialogue: 0,0:19:15.15,0:19:17.82,Default,,0,0,0,,Tên của hắn là...
Dialogue: 0,0:19:22.33,0:19:23.75,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:19:23.75,0:19:26.50,Default,,0,0,0,,Nếu hắn trốn thoát lần nữa...
Dialogue: 0,0:19:27.83,0:19:30.17,Default,,0,0,0,,thế giới sẽ sụp đổ.
Dialogue: 0,0:19:31.00,0:19:32.55,Default,,0,0,0,,Hắn là...
Dialogue: 0,0:19:34.88,0:19:36.93,Default,,0,0,0,,...nỗi nhục của Elbaph!
Dialogue: 0,0:19:40.89,0:19:42.93,Default,,0,0,0,,Hoàng Tử Bị Nguyền Rủa...
Dialogue: 0,0:19:45.02,0:19:46.19,Default,,0,0,0,,Loki!
Dialogue: 0,0:20:01.37,0:20:03.12,Default,,0,0,0,,Xưng danh đi!
Dialogue: 0,0:20:06.41,0:20:07.71,Default,,0,0,0,,Tôi là Luffy.
Dialogue: 0,0:20:08.50,0:20:10.75,Default,,0,0,0,,Là người sẽ trở thành Vua Hải Tặc!
Dialogue: 0,0:20:15.46,0:20:16.76,Default,,0,0,0,,Vua?
Dialogue: 0,0:20:16.84,0:20:17.72,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:20:18.13,0:20:20.01,Default,,0,0,0,,Tôi đang ở đâu? Và anh là ai?
Dialogue: 0,0:20:20.09,0:20:23.01,Default,,0,0,0,,Hả? Ngươi đến mà không biết sao?
Dialogue: 0,0:20:23.10,0:20:23.72,Default,,0,0,0,,Ừ.
Dialogue: 0,0:20:26.68,0:20:30.94,Default,,0,0,0,,Đúng là nếu biết\Nthì ngươi đã không đến.
Dialogue: 0,0:20:32.19,0:20:34.32,Default,,0,0,0,,Vậy ta sẽ cho ngươi biết!
Dialogue: 0,0:20:40.11,0:20:43.33,Default,,0,0,0,,Đây là vương quốc của chiến binh Elbaph...
Dialogue: 0,0:20:44.45,0:20:46.08,Default,,0,0,0,,War-Land!
Dialogue: 0,0:20:54.75,0:20:57.92,Default,,0,0,0,,Đất nước từng cống hiến hết mình\Ncho những cuộc xung đột triền miên.
Dialogue: 0,0:21:00.01,0:21:02.89,Default,,0,0,0,,Quốc gia mạnh nhất thế giới!
Dialogue: 0,0:21:14.57,0:21:16.07,Default,,0,0,0,,Và...
Dialogue: 0,0:21:16.07,0:21:18.69,Default,,0,0,0,,ta là người\Nsẽ mang đến sự kết thúc cho thế giới.
Dialogue: 0,0:21:21.61,0:21:23.82,Default,,0,0,0,,Thần Mặt Trời...
Dialogue: 0,0:21:24.91,0:21:26.08,Default,,0,0,0,,Loki!
Dialogue: 0,0:23:05.38,0:23:10.14,Default,,0,0,0,,Luffy chạm trán Loki, Vị Hoàng Tử Bị Nguyền Rủa,\Nthủ phạm của một tội ác làm chấn động Elbaph.
Dialogue: 0,0:23:10.64,0:23:16.65,Default,,0,0,0,,Loki tuyên bố có thông tin\Nvề Tóc Đỏ Shanks và đưa ra đề nghị với Luffy.
Dialogue: 0,0:23:16.65,0:23:20.57,Default,,0,0,0,,Ý định thực sự của Loki\Nsẽ mang đến điều gì?
Dialogue: 0,0:23:20.65,0:23:22.53,Default,,0,0,0,,Kỳ tới trên One Piece:
Dialogue: 0,0:23:22.53,0:23:25.95,Default,,0,0,0,,Một Thỏa Thuận Nguy Hiểm!\NLoki của Thế Giới Ngầm và Luffy.
Dialogue: 0,0:23:25.95,0:23:30.66,Default,,0,0,0,,Tôi sẽ trở thành Vua Hải Tặc!

