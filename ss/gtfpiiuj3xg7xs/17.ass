Dialogue: 0,0:02:12.47,0:02:16.14,Default,,0,0,0,,ถึงจะน่าเสียดายนิดหน่อย\Nแต่ขอตัวก่อนนะ อาณาจักรตัวต่อ
Dialogue: 0,0:02:16.22,0:02:19.81,Default,,0,0,0,,ขอให้ข้างนอกนั่นเป็นเอลบัฟทีเถอะ
Dialogue: 0,0:02:22.23,0:02:25.19,Default,,0,0,0,,หมัดยางยืด...
Dialogue: 0,0:02:25.73,0:02:28.11,Default,,0,0,0,,คองกัน
Dialogue: 0,0:02:36.53,0:02:42.58,Default,,0,0,0,,การเผชิญหน้าบนทุ่งหิมะ\Nโลกิ เจ้าชายผู้ถูกสาป
Dialogue: 0,0:02:48.21,0:02:49.96,Default,,0,0,0,,อยู่ไหนน่ะ
Dialogue: 0,0:02:49.96,0:02:52.34,Default,,0,0,0,,เรือซันนี่
Dialogue: 0,0:02:54.17,0:02:55.59,Default,,0,0,0,,หมวกฟาง
Dialogue: 0,0:02:55.68,0:02:57.43,Default,,0,0,0,,หมวกฟาง
Dialogue: 0,0:02:57.51,0:02:59.60,Default,,0,0,0,,เฮ้ หมวกฟาง
Dialogue: 0,0:02:59.68,0:03:01.01,Default,,0,0,0,,ออกมานะ
Dialogue: 0,0:03:01.89,0:03:03.68,Default,,0,0,0,,หมวกฟาง
Dialogue: 0,0:03:03.77,0:03:05.69,Default,,0,0,0,,หมวกฟาง
Dialogue: 0,0:03:05.98,0:03:06.98,Default,,0,0,0,,เจอไหม
Dialogue: 0,0:03:07.06,0:03:09.44,Default,,0,0,0,,ไม่เจอทั้งเงาและตัวเลย
Dialogue: 0,0:03:09.52,0:03:11.02,Default,,0,0,0,,ไม่เจอเลย
Dialogue: 0,0:03:11.11,0:03:14.15,Default,,0,0,0,,ทั้งๆ ที่ค้นหาพื้นที่ทะเลใกล้เคียงทั้งหมดแล้วแท้ๆ
Dialogue: 0,0:03:14.44,0:03:16.15,Default,,0,0,0,,อย่าบอกนะว่า...
Dialogue: 0,0:03:16.15,0:03:18.28,Default,,0,0,0,,จะจมลงทะเลไปแล้วน่ะ
Dialogue: 0,0:03:18.37,0:03:19.87,Default,,0,0,0,,- เอ๊ะ\N- เอ๊ะ
Dialogue: 0,0:03:21.58,0:03:24.87,Default,,0,0,0,,ถ้าเป็นแบบนั้นคงต้องค้นหาใต้ทะเลแล้วละ
Dialogue: 0,0:03:25.46,0:03:28.79,Default,,0,0,0,,กลุ่มโจรสลัดทหารยักษ์ กระโจนลงทะเลไปเลย
Dialogue: 0,0:03:28.88,0:03:29.92,Default,,0,0,0,,- ได้เลย\N- ได้เลย
Dialogue: 0,0:03:30.00,0:03:31.13,Default,,0,0,0,,- เย้\N- เย้
Dialogue: 0,0:03:31.55,0:03:34.38,Default,,0,0,0,,จะไปเดี๋ยวนี้แหละ เหล่าหมวกฟาง
Dialogue: 0,0:03:34.38,0:03:35.84,Default,,0,0,0,,เตรียมตัว...
Dialogue: 0,0:03:38.76,0:03:39.76,Default,,0,0,0,,หืม
Dialogue: 0,0:03:40.22,0:03:41.81,Default,,0,0,0,,ว่าไง
Dialogue: 0,0:03:41.81,0:03:43.68,Default,,0,0,0,,เหล่านักรบเอลบัฟ
Dialogue: 0,0:03:49.06,0:03:50.65,Default,,0,0,0,,รู้อะไรมางั้นเหรอ
Dialogue: 0,0:03:51.52,0:03:54.23,Default,,0,0,0,,จะยกเลิกการค้นหาจากบัดนี้
Dialogue: 0,0:03:55.24,0:03:56.24,Default,,0,0,0,,เอ๊ะ
Dialogue: 0,0:03:56.32,0:03:57.53,Default,,0,0,0,,- เอ๊ะ\N- เอ๊ะ
Dialogue: 0,0:03:57.61,0:04:00.41,Default,,0,0,0,,- เอ๊ะ\N- เอ๊ะ
Dialogue: 0,0:04:11.00,0:04:12.42,Default,,0,0,0,,ทำไมกันล่ะ
Dialogue: 0,0:04:12.50,0:04:15.17,Default,,0,0,0,,ยังหาพวกหมวกฟางไม่เจอเลยนะ
Dialogue: 0,0:04:15.26,0:04:19.63,Default,,0,0,0,,ใช่แล้ว ไม่ว่าจะตามหาไปแค่ไหนก็ยังหาไม่เจอ
Dialogue: 0,0:04:19.63,0:04:22.47,Default,,0,0,0,,แต่ว่าต้องไม่เป็นอะไรแน่
Dialogue: 0,0:04:22.47,0:04:26.77,Default,,0,0,0,,เพราะเรือซันนี่ไม่ใช่เรือที่บอบบาง\Nจนล่มได้ง่ายๆ ขนาดนั้น
Dialogue: 0,0:04:28.10,0:04:29.14,Default,,0,0,0,,แบบนี้...
Dialogue: 0,0:04:29.23,0:04:30.52,Default,,0,0,0,,หมายความว่า...
Dialogue: 0,0:04:30.60,0:04:31.23,Default,,0,0,0,,ใช่แล้ว
Dialogue: 0,0:04:32.81,0:04:34.07,Default,,0,0,0,,ยังไม่ตาย
Dialogue: 0,0:04:34.48,0:04:37.15,Default,,0,0,0,,เจ้าพวกนั้นยังไม่ตาย
Dialogue: 0,0:04:37.69,0:04:38.99,Default,,0,0,0,,นั่นสินะ
Dialogue: 0,0:04:38.99,0:04:42.62,Default,,0,0,0,,ก่อนหน้านี้ก็เคยพลัดพรากกันแบบนี้
Dialogue: 0,0:04:45.79,0:04:47.41,Default,,0,0,0,,เหมือนที่แฟรงกี้พูดนั่นแหละ
Dialogue: 0,0:04:47.87,0:04:49.54,Default,,0,0,0,,เข้าใจแล้ว
Dialogue: 0,0:04:49.54,0:04:51.46,Default,,0,0,0,,ฉันเองก็เหมือนจะเข้าใจแล้ว
Dialogue: 0,0:04:51.75,0:04:53.25,Default,,0,0,0,,ใช่ไหม หัวหน้า
Dialogue: 0,0:04:55.00,0:04:57.05,Default,,0,0,0,,กังวลเกินเหตุสินะ
Dialogue: 0,0:04:57.13,0:05:00.22,Default,,0,0,0,,ข้าลองใช้เครือข่ายฉลามช่วยหาดูแล้ว
Dialogue: 0,0:05:00.68,0:05:04.89,Default,,0,0,0,,แต่ดูเหมือนว่าจะไม่เจอพวกลูฟี่ใต้ทะเลเลย
Dialogue: 0,0:05:04.89,0:05:09.43,Default,,0,0,0,,ถ้าเป็นแบบนี้\Nอาจจะลอยไปติดฝั่งที่เกาะแล้วก็ได้
Dialogue: 0,0:05:10.10,0:05:14.61,Default,,0,0,0,,ทุกท่านช่วยกันทำทุกวิถีทางจนสุดกำลังแล้วด้วย
Dialogue: 0,0:05:15.27,0:05:17.61,Default,,0,0,0,,เสบียงบนเรือลำนี้ก็หมดแล้ว
Dialogue: 0,0:05:17.61,0:05:20.57,Default,,0,0,0,,ถ้าทุกคนต้องอดตาย\Nอาจกลายเป็นเรื่องร้ายกว่านี้ก็ได้
Dialogue: 0,0:05:22.53,0:05:26.16,Default,,0,0,0,,ขอขอบคุณมากๆ ที่ช่วยตามหาเพื่อนของเรา
Dialogue: 0,0:05:26.16,0:05:27.99,Default,,0,0,0,,ซาบซึ้งใจจริงๆ
Dialogue: 0,0:05:28.62,0:05:30.79,Default,,0,0,0,,เป้าหมายเรากำหนดไว้ชัดเจนแล้วด้วย
Dialogue: 0,0:05:32.54,0:05:33.92,Default,,0,0,0,,งั้นเหรอ
Dialogue: 0,0:05:34.00,0:05:36.88,Default,,0,0,0,,ถ้าพวกพ้องบอกแบบนี้ก็คงปลอดภัยสินะ
Dialogue: 0,0:05:39.55,0:05:41.80,Default,,0,0,0,,หลังจากนี้เราก็ไปรอที่เอลบัฟเถอะ
Dialogue: 0,0:05:42.63,0:05:45.26,Default,,0,0,0,,เอาตามนี้แหละนะ ทุกคน
Dialogue: 0,0:05:45.76,0:05:48.10,Default,,0,0,0,,หันหางเสือเรือไปยังเอลบัฟเลย
Dialogue: 0,0:05:53.65,0:05:55.31,Default,,0,0,0,,ฉลองการกลับบ้านกันหน่อย
Dialogue: 0,0:05:55.40,0:05:58.82,Default,,0,0,0,,หัวหน้า บอกแล้วไงว่า\Nไม่เหลือทั้งเหล้าและเสบียงแล้วน่ะ
Dialogue: 0,0:06:18.25,0:06:21.55,Default,,0,0,0,,เราออกมาข้างนอกได้แล้วใช่ไหม
Dialogue: 0,0:06:22.59,0:06:24.84,Default,,0,0,0,,หนาวสุดๆ
Dialogue: 0,0:06:28.51,0:06:29.85,Default,,0,0,0,,หิมะ...
Dialogue: 0,0:06:35.44,0:06:36.40,Default,,0,0,0,,คุณนามิ
Dialogue: 0,0:06:45.78,0:06:46.95,Default,,0,0,0,,ไม่เป็นไรใช่ไหม
Dialogue: 0,0:06:47.82,0:06:49.16,Default,,0,0,0,,อ้าว จะไปไหนน่ะ
Dialogue: 0,0:06:51.20,0:06:54.25,Default,,0,0,0,,มันหนาวนะ ช่วยกลับมาหาฉันเถอะ
Dialogue: 0,0:06:55.25,0:06:56.46,Default,,0,0,0,,ไม่ได้หรอก นามิ
Dialogue: 0,0:06:56.88,0:07:01.21,Default,,0,0,0,,หมอนั่นไม่ได้ตั้งใจ\Nจะมากับพวกเราตั้งแต่แรกอยู่แล้ว
Dialogue: 0,0:07:02.76,0:07:06.01,Default,,0,0,0,,คุณนามิ ถ้าไม่รังเกียจก็เอาเสื้อคลุมผมไปใส่ได้นะ
Dialogue: 0,0:07:06.09,0:07:07.68,Default,,0,0,0,,ขอบคุณนะ ซันจิคุง
Dialogue: 0,0:07:08.14,0:07:10.51,Default,,0,0,0,,พวกโง่ไม่มีทางเป็นหวัดได้นี่นา
Dialogue: 0,0:07:10.60,0:07:12.89,Default,,0,0,0,,ได้ยินนะโว้ย ไอ้นักดาบเฮงซวย
Dialogue: 0,0:07:13.89,0:07:15.39,Default,,0,0,0,,ดูสิ อุซป
Dialogue: 0,0:07:15.48,0:07:16.90,Default,,0,0,0,,อะไรอีกล่ะ
Dialogue: 0,0:07:19.15,0:07:21.44,Default,,0,0,0,,เบ้อเร่อเลย
Dialogue: 0,0:07:22.61,0:07:24.78,Default,,0,0,0,,นี่มันต้นไม้อะไรเนี่ย
Dialogue: 0,0:07:26.32,0:07:28.70,Default,,0,0,0,,ไม่ได้สร้างจากตัวต่ออีกใช่ไหม
Dialogue: 0,0:07:31.53,0:07:32.54,Default,,0,0,0,,นามิ
Dialogue: 0,0:07:34.45,0:07:36.54,Default,,0,0,0,,ต้นไม้นี่...
Dialogue: 0,0:07:36.54,0:07:38.83,Default,,0,0,0,,อายุกี่พันปีกันเนี่ย
Dialogue: 0,0:07:38.92,0:07:42.71,Default,,0,0,0,,แล้วมีแต่ต้นไม้ทั้งนั้นเลย
Dialogue: 0,0:07:45.05,0:07:48.34,Default,,0,0,0,,โห ใหญ่มาก\Nนั่นใช่ภูเขาหรือเปล่า
Dialogue: 0,0:07:48.43,0:07:50.42,Default,,0,0,0,,ใหญ่ขนาดเท่าเกาะ
Dialogue: 0,0:07:50.42,0:07:52.97,Default,,0,0,0,,ไม่สิ ใหญ่กว่านั้นอีกโขเลย
Dialogue: 0,0:07:52.97,0:07:54.27,Default,,0,0,0,,เดี๋ยวก่อนนะ
Dialogue: 0,0:07:54.27,0:07:57.27,Default,,0,0,0,,มันกว้างสุดลูกหูลูกตาจนตาลายหมดแล้ว
Dialogue: 0,0:07:58.19,0:07:59.81,Default,,0,0,0,,สุดยอด
Dialogue: 0,0:08:00.31,0:08:02.19,Default,,0,0,0,,เฮ้ มาดูนี่เร็ว
Dialogue: 0,0:08:07.40,0:08:09.24,Default,,0,0,0,,สุดยอดมาก
Dialogue: 0,0:08:10.87,0:08:14.29,Default,,0,0,0,,สะพานแขวนที่โคตรยาว
Dialogue: 0,0:08:15.58,0:08:20.21,Default,,0,0,0,,ยาวไปถึงเมฆเลยไหมน่ะ\Nมองไม่เห็นอีกฝั่งหนึ่งเลย
Dialogue: 0,0:08:20.29,0:08:23.25,Default,,0,0,0,,ข้างหลังเป็นปราสาทของเทพตะวัน
Dialogue: 0,0:08:23.25,0:08:25.17,Default,,0,0,0,,คงต้องไปต่ออย่างเดียวสินะ
Dialogue: 0,0:08:25.26,0:08:25.88,Default,,0,0,0,,เอ๊ะ
Dialogue: 0,0:08:26.34,0:08:28.13,Default,,0,0,0,,นายกลัวเหรอ อุซป
Dialogue: 0,0:08:28.22,0:08:30.51,Default,,0,0,0,,พะ...พูดอะไรบ้าๆ แค่นี้สบายมาก
Dialogue: 0,0:08:30.59,0:08:33.97,Default,,0,0,0,,ดีละ ถ้างั้นตามฉันมาเลย
Dialogue: 0,0:08:36.06,0:08:37.81,Default,,0,0,0,,ดะๆ ดะ...เดี๋ยว
Dialogue: 0,0:08:37.81,0:08:39.52,Default,,0,0,0,,ให้ฉันเดินนำหน้า...
Dialogue: 0,0:08:46.48,0:08:47.19,Default,,0,0,0,,อะไรน่ะ
Dialogue: 0,0:08:57.95,0:08:59.21,Default,,0,0,0,,คะ...คนยักษ์นี่นา
Dialogue: 0,0:08:59.29,0:09:01.04,Default,,0,0,0,,กำลังข้ามสะพานแขวนมาทางนี้
Dialogue: 0,0:09:01.12,0:09:02.33,Default,,0,0,0,,แอบกันก่อนเถอะ
Dialogue: 0,0:09:03.08,0:09:03.79,Default,,0,0,0,,ลูฟี่
Dialogue: 0,0:09:03.88,0:09:04.96,Default,,0,0,0,,โอเค
Dialogue: 0,0:09:07.67,0:09:09.38,Default,,0,0,0,,ให้ตายสิ
Dialogue: 0,0:09:09.38,0:09:12.51,Default,,0,0,0,,ทำไมฮัจรูดิน\Nถึงเอามนุษย์แปลกๆ แบบนั้นเข้ากลุ่มด้วยล่ะ
Dialogue: 0,0:09:14.55,0:09:18.14,Default,,0,0,0,,นั่นเพราะมีฝีมือในฐานะต้นหนเรือแน่ๆ
Dialogue: 0,0:09:18.22,0:09:19.85,Default,,0,0,0,,ฉันเกลียดหมอนั่น
Dialogue: 0,0:09:20.31,0:09:22.85,Default,,0,0,0,,หมอนั่นคือความอับอายของเอลบัฟ\Nมากกว่าโลกิซะอีก
Dialogue: 0,0:09:23.48,0:09:25.85,Default,,0,0,0,,(กลุ่มโจรสลัดนักรบยักษ์รุ่นใหม่ (แพทย์ประจำเรือ)\Nเกิร์ด)
Dialogue: 0,0:09:27.40,0:09:30.61,Default,,0,0,0,,พูดแบบนั้น เดี๋ยวโร้ดก็ดีใจเอาหรอก
Dialogue: 0,0:09:31.40,0:09:33.61,Default,,0,0,0,,(กลุ่มโจรสลัดนักรบยักษ์รุ่นใหม่ (กุ๊ก)\Nโกลด์เบิร์ก)
Dialogue: 0,0:09:33.70,0:09:36.53,Default,,0,0,0,,นี่ ไพเพอร์ นายเห็นแล้วใช่ไหม
Dialogue: 0,0:09:36.53,0:09:39.75,Default,,0,0,0,,ที่อีกาของหมอนั่นหิ้วเรือเล็กมาน่ะ
Dialogue: 0,0:09:43.46,0:09:46.38,Default,,0,0,0,,ผู้บุกรุกต้องถูกจับกุมตัวแน่อยู่แล้ว
Dialogue: 0,0:09:46.38,0:09:49.30,Default,,0,0,0,,แต่โร้ดชอบจับคนมาเป็นผู้บุกรุกซะงั้น
Dialogue: 0,0:09:50.84,0:09:53.55,Default,,0,0,0,,น่าเหนื่อยใจกับงานอดิเรกของหมอนั่นเหมือนกันนะ
Dialogue: 0,0:09:53.55,0:09:56.60,Default,,0,0,0,,ถ้าเจอเรือนั่น เดี๋ยวจะไปฟ้องท่านยาร์ลแน่
Dialogue: 0,0:10:01.18,0:10:02.94,Default,,0,0,0,,อยู่แบบนี้ให้พวกเขาผ่านไปก่อน
Dialogue: 0,0:10:03.02,0:10:05.31,Default,,0,0,0,,ดะ...ได้ยินหรือเปล่า พวกนาย
Dialogue: 0,0:10:05.31,0:10:08.61,Default,,0,0,0,,มีชื่อของเอลบัฟโผล่มาแล้ว ที่นี่ต้องใช่แน่ๆ
Dialogue: 0,0:10:08.69,0:10:10.24,Default,,0,0,0,,ช่วยเงียบหน่อยได้ไหมยะ
Dialogue: 0,0:10:10.94,0:10:12.07,Default,,0,0,0,,ลูฟี่
Dialogue: 0,0:10:12.15,0:10:13.11,Default,,0,0,0,,อะไรของเธอ
Dialogue: 0,0:10:13.20,0:10:14.70,Default,,0,0,0,,ก็บอกให้ซ่อนตัวไงล่ะ
Dialogue: 0,0:10:14.78,0:10:16.66,Default,,0,0,0,,แต่พวกนั้นดูเหมือนจะเป็นคนดีนี่
Dialogue: 0,0:10:17.66,0:10:19.66,Default,,0,0,0,,เฮ้ พวกนาย ที่นี่...
Dialogue: 0,0:10:19.74,0:10:23.41,Default,,0,0,0,,เจ้าบ้า\Nพวกเขาบอกว่าผู้บุกรุกจะถูกจับกุมตัวนะ
Dialogue: 0,0:10:23.50,0:10:25.13,Default,,0,0,0,,นี่ ลูฟี่
Dialogue: 0,0:10:25.58,0:10:27.88,Default,,0,0,0,,อย่าทำให้คุณนามิเดือดร้อนสิ
Dialogue: 0,0:10:36.55,0:10:39.22,Default,,0,0,0,,มีสาวสวยเผ่าคนยักษ์อยู่จริงๆ ด้วย
Dialogue: 0,0:10:44.27,0:10:45.48,Default,,0,0,0,,หูแว่วไปเองเหรอ
Dialogue: 0,0:10:45.98,0:10:46.94,Default,,0,0,0,,คงงั้นแหละ
Dialogue: 0,0:10:57.99,0:11:00.24,Default,,0,0,0,,ทำอะไรของพวกนายกันฮะ
Dialogue: 0,0:11:03.04,0:11:05.37,Default,,0,0,0,,โร้ด อยู่ไหม
Dialogue: 0,0:11:08.13,0:11:09.71,Default,,0,0,0,,ดีละ
Dialogue: 0,0:11:09.71,0:11:12.26,Default,,0,0,0,,พวกนาย ตามฉันมาเลย
Dialogue: 0,0:11:12.34,0:11:13.63,Default,,0,0,0,,เย้
Dialogue: 0,0:11:17.22,0:11:18.68,Default,,0,0,0,,ไปกันเลย
Dialogue: 0,0:11:20.10,0:11:22.22,Default,,0,0,0,,ส่ายแรงจัง
Dialogue: 0,0:11:23.93,0:11:27.31,Default,,0,0,0,,สะพานแขวนไซซ์คนยักษ์มีแต่รูเต็มไปหมด
Dialogue: 0,0:11:27.40,0:11:29.06,Default,,0,0,0,,นามิ วางใจเถอะ
Dialogue: 0,0:11:29.06,0:11:31.40,Default,,0,0,0,,แต่ก่อนฉันเคยไต่เชือกมาแล้ว
Dialogue: 0,0:11:32.19,0:11:33.99,Default,,0,0,0,,ของแบบนี้ฉันถนัดมาก
Dialogue: 0,0:11:35.19,0:11:38.28,Default,,0,0,0,,บางทีก็มีหิมะขนาดใหญ่ผิดปกติตกลงมาด้วย
Dialogue: 0,0:11:38.36,0:11:40.03,Default,,0,0,0,,ปลายทางยังอีกไกล
Dialogue: 0,0:11:40.03,0:11:42.99,Default,,0,0,0,,ถ้าไม่รีบละก็\Nคนยักษ์เดินผ่านมาคงไม่มีทางหนีแน่
Dialogue: 0,0:11:48.29,0:11:51.96,Default,,0,0,0,,นี่คือบททดสอบ\Nบททดสอบของนักรบผู้กล้าหาญ
Dialogue: 0,0:11:58.76,0:12:01.85,Default,,0,0,0,,ป่าข้างล่างนั่นมีแต่หมาป่ายักษ์เพียบเลย
Dialogue: 0,0:12:01.93,0:12:03.77,Default,,0,0,0,,ฮึบ
Dialogue: 0,0:12:07.94,0:12:09.02,Default,,0,0,0,,มีอะไรเหรอ ลูฟี่
Dialogue: 0,0:12:09.85,0:12:10.73,Default,,0,0,0,,นายก็น่าจะรู้สึกนะ
Dialogue: 0,0:12:16.44,0:12:17.65,Default,,0,0,0,,รุนแรงขนาดนี้
Dialogue: 0,0:12:18.07,0:12:19.03,Default,,0,0,0,,อืม
Dialogue: 0,0:12:19.11,0:12:20.95,Default,,0,0,0,,ฉันไม่ไปหรอกนะ
Dialogue: 0,0:12:21.03,0:12:21.78,Default,,0,0,0,,ถ้างั้น...
Dialogue: 0,0:12:21.87,0:12:24.37,Default,,0,0,0,,แล้วก็ไม่ให้ไอ้หัวมอสจอมหลงทางนี่ไปด้วย
Dialogue: 0,0:12:24.37,0:12:26.75,Default,,0,0,0,,ป่าทุกป่า ฉันไม่ยอมให้มันเข้าไปเด็ดขาด
Dialogue: 0,0:12:26.83,0:12:30.12,Default,,0,0,0,,เจ้าของเสียงคำราม\Nที่เคยได้ยินตอนอยู่อาณาจักรตัวต่อแน่
Dialogue: 0,0:12:30.12,0:12:30.96,Default,,0,0,0,,น่าจะใช่นะ
Dialogue: 0,0:12:32.17,0:12:34.13,Default,,0,0,0,,พวกนาย ล่วงหน้าไปก่อนเลยนะ
Dialogue: 0,0:12:34.21,0:12:34.88,Default,,0,0,0,,เอ๊ะ
Dialogue: 0,0:12:37.47,0:12:38.55,Default,,0,0,0,,หา
Dialogue: 0,0:12:38.63,0:12:39.93,Default,,0,0,0,,เอ๊ะ เดี๋ยวก่อน ลูฟี่
Dialogue: 0,0:12:40.01,0:12:41.68,Default,,0,0,0,,จะไปไหนน่ะ ลูฟี่
Dialogue: 0,0:12:41.68,0:12:44.35,Default,,0,0,0,,ข้างล่างมีแต่หมาป่าทั้งนั้นเลยนะ
Dialogue: 0,0:12:50.31,0:12:55.53,Default,,0,0,0,,จงกล้าหาญสิ อุซป
Dialogue: 0,0:13:10.58,0:13:12.83,Default,,0,0,0,,ว่าไงนะ
Dialogue: 0,0:13:12.83,0:13:14.46,Default,,0,0,0,,ข่าวบอกว่าพวกเรา...
Dialogue: 0,0:13:14.54,0:13:16.67,Default,,0,0,0,,ไปโจมตีเอ็กเฮดเหรอ
Dialogue: 0,0:13:17.38,0:13:19.63,Default,,0,0,0,,ใช่ ลงในหนังสือพิมพ์เมื่อเช้านี้เอง
Dialogue: 0,0:13:20.68,0:13:22.84,Default,,0,0,0,,ทำไมถึงต้องโกหกแบบนั้นด้วยล่ะ
Dialogue: 0,0:13:23.64,0:13:24.22,Default,,0,0,0,,ดูสิ
Dialogue: 0,0:13:26.06,0:13:28.14,Default,,0,0,0,,ตัวเล็กเกินจนอ่านไม่ออกเลย
Dialogue: 0,0:13:28.89,0:13:29.89,Default,,0,0,0,,งั้นจะอ่านให้ฟังนะ
Dialogue: 0,0:13:33.27,0:13:35.61,Default,,0,0,0,,กลุ่มโจรสลัดนักรบยักษ์ออกอาละวาด...
Dialogue: 0,0:13:35.90,0:13:38.23,Default,,0,0,0,,หลังจากตื่นขึ้นจากการหลับใหลนานนับ 100 ปี
Dialogue: 0,0:13:42.57,0:13:47.37,Default,,0,0,0,,ร่วมมือกับหนึ่งในลูฟี่หมวกฟางแห่งสี่จักรพรรดิ\Nเปลี่ยนเอ็กเฮดให้กลายเป็นทะเลเพลิง
Dialogue: 0,0:13:51.66,0:13:53.83,Default,,0,0,0,,ตอนนี้กัปตันกลุ่มโจรสลัดนักรบยักษ์
Dialogue: 0,0:13:54.54,0:13:56.04,Default,,0,0,0,,ยักษ์แดงโบรกี้
Dialogue: 0,0:13:56.59,0:13:58.21,Default,,0,0,0,,และยักษ์น้ำเงินดอร์รี่
Dialogue: 0,0:13:58.67,0:14:01.97,Default,,0,0,0,,ทั้งคู่มีค่าหัว 1,800 ล้านเบรี่
Dialogue: 0,0:14:03.13,0:14:06.05,Default,,0,0,0,,1,800 ล้านเบรี่เลยเหรอ
Dialogue: 0,0:14:06.55,0:14:08.39,Default,,0,0,0,,โดนตั้งค่าหัวด้วยเหรอเนี่ย
Dialogue: 0,0:14:10.27,0:14:12.89,Default,,0,0,0,,จริงๆ ก็ไม่อยากกลับมาอาละวาดสักเท่าไหร่หรอก
Dialogue: 0,0:14:12.98,0:14:17.19,Default,,0,0,0,,ในอดีต พวกหัวหน้ามีค่าหัว 100 ล้านเองนะ
Dialogue: 0,0:14:17.19,0:14:18.82,Default,,0,0,0,,ค่าหัวพุ่งสูงขึ้นมากเลยนะ
Dialogue: 0,0:14:18.90,0:14:21.86,Default,,0,0,0,,ค่าครองชีพเมื่อร้อยปีก่อน\Nกับตอนนี้ต่างกันมากเลยล่ะ
Dialogue: 0,0:14:22.40,0:14:25.95,Default,,0,0,0,,เป็นถึงระดับหัวหน้านักรบเอลบัฟในตอนนี้\Nก็ถือว่าค่าหัวเหมาะสมดีนะ
Dialogue: 0,0:14:26.57,0:14:27.87,Default,,0,0,0,,ค่าครองชีพเหรอ
Dialogue: 0,0:14:28.28,0:14:30.24,Default,,0,0,0,,ค่าครองชีพต่างกันงั้นเหรอ
Dialogue: 0,0:14:30.33,0:14:33.08,Default,,0,0,0,,อะ...อืม นั่นสินะ
Dialogue: 0,0:14:33.16,0:14:37.29,Default,,0,0,0,,แถมยังบอกอีกว่ากัปตันของฉันเป็นคนฆ่าเวก้าพังค์
Dialogue: 0,0:14:37.38,0:14:38.71,Default,,0,0,0,,- เอ๊ะ\N- เอ๊ะ
Dialogue: 0,0:14:39.75,0:14:42.30,Default,,0,0,0,,ยังชอบบิดเบือนข้อมูลข่าวเหมือนเดิม
Dialogue: 0,0:14:44.22,0:14:45.55,Default,,0,0,0,,เป็นคนฆ่าฉันงั้นเหรอ
Dialogue: 0,0:14:45.64,0:14:49.06,Default,,0,0,0,,เงียบไปเลย\Nอุตส่าห์ปกป้องมาจนถึงป่านนี้ไม่ใช่เหรอ
Dialogue: 0,0:14:51.93,0:14:53.81,Default,,0,0,0,,แต่ว่านี่...
Dialogue: 0,0:14:54.19,0:14:56.35,Default,,0,0,0,,เป็นรูปตั้งแต่ตอนไหนครับเนี่ย
Dialogue: 0,0:14:56.44,0:14:58.44,Default,,0,0,0,,คงเป็นสักแห่งตอนอยู่บนเอ็กเฮด
Dialogue: 0,0:14:59.23,0:15:02.03,Default,,0,0,0,,พวกนั้นมีสายทุกที่อยู่แล้ว
Dialogue: 0,0:15:02.03,0:15:05.91,Default,,0,0,0,,เพราะไม่ว่าใครถ่ายรูปก็เอารูปไปขายแพงๆ ต่อได้
Dialogue: 0,0:15:06.86,0:15:07.87,Default,,0,0,0,,นี่
Dialogue: 0,0:15:09.37,0:15:12.87,Default,,0,0,0,,เมื่อลูฟี่แปลงร่างเป็นร่างอิสระ
Dialogue: 0,0:15:12.87,0:15:14.75,Default,,0,0,0,,จะมีสัญลักษณ์แบบนี้บนแขนด้วยเหรอ
Dialogue: 0,0:15:15.46,0:15:18.46,Default,,0,0,0,,จริงสิ ดูคล้ายเครื่องหมายอะไรสักอย่างมากกว่า
Dialogue: 0,0:15:18.54,0:15:23.59,Default,,0,0,0,,จะใช่หรือเปล่า\Nเพราะปกติกระโดดไปมาจนมองไม่ชัดน่ะ
Dialogue: 0,0:15:23.67,0:15:25.17,Default,,0,0,0,,ดูแปลกชอบกลนะ
Dialogue: 0,0:15:26.01,0:15:29.51,Default,,0,0,0,,ทั้งที่แขนในรูปดูเบลอๆ แต่สัญลักษณ์นี่กลับชัดเจน
Dialogue: 0,0:15:29.60,0:15:31.60,Default,,0,0,0,,เธอนี่ใส่ใจอะไรแปลกๆ นะ
Dialogue: 0,0:15:32.22,0:15:34.06,Default,,0,0,0,,รู้สึกเหมือนเคยเห็นมาก่อน
Dialogue: 0,0:15:35.98,0:15:40.40,Default,,0,0,0,,แต่ไม่คิดเลยว่าตอนนี้หมวกฟาง\Nจะขึ้นมาอยู่ระดับเดียวกันกับผมแดง
Dialogue: 0,0:15:40.86,0:15:45.78,Default,,0,0,0,,ได้ยินมาว่าเด็กหนุ่มที่ชื่อฮัจรูดินของเกาะเรา\Nกลายเป็นลูกน้องของพวกเจ้าด้วยสินะ
Dialogue: 0,0:15:45.86,0:15:48.82,Default,,0,0,0,,ฮัจรูดิน หมอนั่นถือเป็นบุตรแห่งราชา
Dialogue: 0,0:15:48.91,0:15:50.62,Default,,0,0,0,,บุตรแห่งราชาของเอลบัฟเหรอครับ
Dialogue: 0,0:15:50.70,0:15:51.78,Default,,0,0,0,,เป็นแบบนั้นเหรอ
Dialogue: 0,0:15:51.87,0:15:55.66,Default,,0,0,0,,ตอนเด็กๆ ทั้งดื้อและอาละวาดเก่งมากเลยนะ
Dialogue: 0,0:16:02.13,0:16:06.05,Default,,0,0,0,,ที่จริงเจ้าพวกนั้นก็อยากมารับพวกนายด้วย
Dialogue: 0,0:16:12.60,0:16:15.48,Default,,0,0,0,,แต่มีปัญหาที่เอลบัฟนิดหน่อย
Dialogue: 0,0:16:15.56,0:16:18.19,Default,,0,0,0,,เพราะงั้นก็เลยมีแค่แก่ๆ อย่างพวกข้า
Dialogue: 0,0:16:18.69,0:16:19.90,Default,,0,0,0,,ปัญหาเหรอ
Dialogue: 0,0:16:19.98,0:16:22.11,Default,,0,0,0,,ไม่เห็นจะรู้เรื่องเลย
Dialogue: 0,0:16:24.73,0:16:25.94,Default,,0,0,0,,เอ่อ...
Dialogue: 0,0:16:25.94,0:16:29.91,Default,,0,0,0,,เรื่องนี้เกิดขึ้นตอนที่พวกหัวหน้าไม่อยู่น่ะ
Dialogue: 0,0:16:34.87,0:16:39.71,Default,,0,0,0,,ที่เอลบัฟมีบุตรแห่งราชาอย่างเป็นทางการ\Nกำเนิดขึ้นมาอีกคนหนึ่ง
Dialogue: 0,0:16:59.10,0:17:01.40,Default,,0,0,0,,เย็นชะมัด
Dialogue: 0,0:17:07.82,0:17:10.24,Default,,0,0,0,,ใหญ่โตจังแฮะ
Dialogue: 0,0:17:16.04,0:17:20.08,Default,,0,0,0,,ตัวต่อก็สนุกดีเหมือนกัน\Nแต่การผจญภัยมันต้องเป็นแบบนี้สิ
Dialogue: 0,0:17:20.41,0:17:25.29,Default,,0,0,0,,เจ้าของเสียงคำรามนั่น\Nเป็นคนทำเสียงได้ดังขนาดนี้เลยเหรอ
Dialogue: 0,0:17:25.29,0:17:28.42,Default,,0,0,0,,ขอเนื้อก้อนใหญ่ๆ บ้างได้ไหม
Dialogue: 0,0:17:34.22,0:17:35.43,Default,,0,0,0,,เฮ้
Dialogue: 0,0:17:36.64,0:17:39.27,Default,,0,0,0,,อยู่ที่ไหน
Dialogue: 0,0:17:43.73,0:17:45.69,Default,,0,0,0,,พวกนาย...ต้องการอะไร
Dialogue: 0,0:18:13.97,0:18:15.30,Default,,0,0,0,,เสียงเมื่อกี้...
Dialogue: 0,0:18:15.76,0:18:16.80,Default,,0,0,0,,ทางนี้สินะ
Dialogue: 0,0:18:20.27,0:18:22.23,Default,,0,0,0,,เจ้าชายคนนั้น
Dialogue: 0,0:18:22.73,0:18:26.56,Default,,0,0,0,,เจ้าชายคนนั้นถูกเรียกว่าเจ้าชายต้องคำสาป
Dialogue: 0,0:18:27.11,0:18:28.02,Default,,0,0,0,,คำสาปเหรอ
Dialogue: 0,0:18:28.11,0:18:30.61,Default,,0,0,0,,เจ้านั่นที่ก่อความชั่วร้ายสายพัดอย่าง
Dialogue: 0,0:18:30.61,0:18:34.32,Default,,0,0,0,,ถูกลงโทษด้วยกัณฑ์ตรึงร่างเมื่อหลายปีก่อน
Dialogue: 0,0:18:34.32,0:18:35.87,Default,,0,0,0,,เหมือนจะหลุดออกมาได้อีก
Dialogue: 0,0:18:36.45,0:18:39.54,Default,,0,0,0,,เหล่านักรบทุกคนเลยต้องเข้ามาช่วยกันหยุด
Dialogue: 0,0:18:41.66,0:18:44.25,Default,,0,0,0,,ต้องใช้กำลังนักรบยักษ์ของเอลบัฟทุกคนเลย
Dialogue: 0,0:18:44.25,0:18:46.13,Default,,0,0,0,,เรื่องแบบนั้นมันเป็นไปได้ด้วยเหรอ
Dialogue: 0,0:18:46.21,0:18:50.34,Default,,0,0,0,,ใช่ เจ้านั่นเสียสติไปแล้ว
Dialogue: 0,0:19:00.18,0:19:05.39,Default,,0,0,0,,เจ้านั่นอยากได้ผลปีศาจในตำนาน\Nที่สืบทอดกันมาในราชวงศ์เอลบัฟ
Dialogue: 0,0:19:05.77,0:19:09.07,Default,,0,0,0,,เลยสังหารราชาฮาราลด์ที่เป็นพ่อ
Dialogue: 0,0:19:09.36,0:19:11.40,Default,,0,0,0,,และกินผลนั่นเข้าไปแล้ว
Dialogue: 0,0:19:15.15,0:19:17.82,Default,,0,0,0,,หรือว่าชื่อของเจ้านั่นจะเป็น...
Dialogue: 0,0:19:22.33,0:19:23.75,Default,,0,0,0,,ใช่แล้ว
Dialogue: 0,0:19:23.75,0:19:26.50,Default,,0,0,0,,ถ้าเจ้านั่นหลุดออกมาอีกละก็
Dialogue: 0,0:19:27.83,0:19:30.17,Default,,0,0,0,,โลกได้พังพิเศษแน่
Dialogue: 0,0:19:31.00,0:19:32.55,Default,,0,0,0,,หมอนั่นคือ...
Dialogue: 0,0:19:34.88,0:19:36.93,Default,,0,0,0,,ความอับอายของเอลบัฟ
Dialogue: 0,0:19:40.89,0:19:42.93,Default,,0,0,0,,เจ้าชายต้องสาป
Dialogue: 0,0:19:45.02,0:19:46.19,Default,,0,0,0,,โลกิ
Dialogue: 0,0:20:01.37,0:20:03.12,Default,,0,0,0,,บอกชื่อเจ้าซะ
Dialogue: 0,0:20:06.41,0:20:07.71,Default,,0,0,0,,ฉันชื่อลูฟี่
Dialogue: 0,0:20:08.50,0:20:10.75,Default,,0,0,0,,ชายที่จะกลายเป็นราชาโจรสลัด
Dialogue: 0,0:20:15.46,0:20:16.76,Default,,0,0,0,,ราชาเหรอ
Dialogue: 0,0:20:16.84,0:20:17.72,Default,,0,0,0,,ใช่แล้ว
Dialogue: 0,0:20:18.13,0:20:20.01,Default,,0,0,0,,ว่าแต่ที่นี่คือที่ไหนและนายเป็นใคร
Dialogue: 0,0:20:20.09,0:20:23.01,Default,,0,0,0,,ฮะ มาโดยไม่รู้จักงั้นเรอะ
Dialogue: 0,0:20:23.10,0:20:23.72,Default,,0,0,0,,ใช่
Dialogue: 0,0:20:26.68,0:20:30.94,Default,,0,0,0,,ถ้ารู้ว่าที่นี่ที่ไหนก็คงไม่มาหาข้าหรอกนะ
Dialogue: 0,0:20:32.19,0:20:34.32,Default,,0,0,0,,ถ้างั้นจะบอกให้ก็ได้
Dialogue: 0,0:20:40.11,0:20:43.33,Default,,0,0,0,,ที่นี่คืออาณาจักรของนักรบแห่งเอลบัฟ
Dialogue: 0,0:20:44.45,0:20:46.08,Default,,0,0,0,,วอร์แลนด์
Dialogue: 0,0:20:54.75,0:20:57.92,Default,,0,0,0,,อาณาจักรที่ผ่านการศึกมามากมาย
Dialogue: 0,0:21:00.01,0:21:02.89,Default,,0,0,0,,จนเป็นอาณาจักรที่แข็งแกร่งที่สุด
Dialogue: 0,0:21:14.57,0:21:16.07,Default,,0,0,0,,และ...
Dialogue: 0,0:21:16.07,0:21:18.69,Default,,0,0,0,,ข้าคือผู้ที่จะนำโลกไปสู่จุดจบ
Dialogue: 0,0:21:21.61,0:21:23.82,Default,,0,0,0,,เทพพระอาทิตย์
Dialogue: 0,0:21:24.91,0:21:26.08,Default,,0,0,0,,โลกิ
Dialogue: 0,0:21:26.08,0:21:30.58,Default,,0,0,0,,(โปรดติดตามตอนต่อไป)
Dialogue: 0,0:23:05.38,0:23:10.14,Default,,0,0,0,,ลูฟี่ได้เผชิญหน้ากับโลกิ เจ้าชายต้องสาป\Nผู้ก่ออาชญากรรมร้ายแรงเขย่าขวัญเอลบัฟ
Dialogue: 0,0:23:10.64,0:23:16.65,Default,,0,0,0,,โลกิที่อ้างว่ามีข้อมูลเกี่ยวกับแชงคูส\Nได้ยื่นข้อเสนอบางอย่างให้กับลูฟี่
Dialogue: 0,0:23:16.65,0:23:20.57,Default,,0,0,0,,สุดท้ายแล้ว ความคิดของโลกิจะนำไปสู่สิ่งใด
Dialogue: 0,0:23:20.65,0:23:22.53,Default,,0,0,0,,ตอนต่อไปของ “วันพีซ”
Dialogue: 0,0:23:22.53,0:23:25.95,Default,,0,0,0,,ข้อตกลงสุดอันตราย\Nโลกิแห่งยมโลกและลูฟี่
Dialogue: 0,0:23:25.95,0:23:30.66,Default,,0,0,0,,ฉันจะเป็นราชาโจรสลัดให้ได้เลย

