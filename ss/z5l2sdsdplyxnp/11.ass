Dialogue: 0,0:00:08.12,0:00:09.64,Default,,0,0,0,,Saya terbalikkan sistemnya.
Dialogue: 0,0:00:10.52,0:00:13.81,Default,,0,0,0,,Saya terbalikkan segala magis yang\Nartifak itu boleh buat.
Dialogue: 0,0:00:16.15,0:00:17.56,Default,,0,0,0,,Awak dah pun kalah.
Dialogue: 0,0:00:48.39,0:00:49.85,Default,,0,0,0,,Dia ini betul-betul menyusahkan.
Dialogue: 0,0:01:08.73,0:01:10.81,Default,,0,0,0,,♪ I just want you to come back to me ♪
Dialogue: 0,0:01:10.81,0:01:15.70,Default,,0,0,0,,♪ Di dalam kegelapan yang\Nmenghalang pandangan ♪
Dialogue: 0,0:01:15.97,0:01:18.24,Default,,0,0,0,,♪ Yes, I know you’re just as lonely ♪
Dialogue: 0,0:01:18.25,0:01:22.24,Default,,0,0,0,,♪ Perasaan yang tak boleh\Ndiubah menjadi air mata ♪
Dialogue: 0,0:01:22.24,0:01:23.65,Default,,0,0,0,,♪ Wow oh oh ♪
Dialogue: 0,0:01:23.87,0:01:31.18,Default,,0,0,0,,♪ Cukup untuk hidup\Nringkas seperti diri ini ♪
Dialogue: 0,0:01:31.18,0:01:39.39,Default,,0,0,0,,♪ Bagi kita yang tak\Ncukup kuat atau bijaksana ♪
Dialogue: 0,0:01:39.57,0:01:43.80,Default,,0,0,0,,♪ Hati aku penuh dengan luka ♪
Dialogue: 0,0:01:44.09,0:01:51.43,Default,,0,0,0,,♪ Wahai kesedihan,\Njanganlah hilang sendirian ♪
Dialogue: 0,0:01:51.43,0:01:54.35,Default,,0,0,0,,♪ Bersama-sama aku tapi kenapa? ♪
Dialogue: 0,0:01:54.35,0:01:58.40,Default,,0,0,0,,♪ "Jumpa lagi" yang tak kembali ♪
Dialogue: 0,0:01:58.65,0:02:05.95,Default,,0,0,0,,♪ Aku rasa aku dah\Nkembali jadi diri sendiri ♪
Dialogue: 0,0:02:05.95,0:02:08.74,Default,,0,0,0,,♪ Sehingga fajar yeah ♪
Dialogue: 0,0:02:08.74,0:02:16.17,Default,,0,0,0,,♪ Menjadi angin yang meniup melintasi ♪
Dialogue: 0,0:02:16.17,0:02:19.72,Default,,0,0,0,,♪ Menuju pagi yang dijanjikan ♪
Dialogue: 0,0:02:22.77,0:02:26.35,Default,,0,0,0,,(Episod 19: Kebangkitan)
Dialogue: 0,0:02:39.83,0:02:41.52,Default,,0,0,0,,Absolute Zero!
Dialogue: 0,0:03:15.57,0:03:16.78,Default,,0,0,0,,Awak tak apa-apa?
Dialogue: 0,0:03:18.20,0:03:20.29,Default,,0,0,0,,Betul apa yang dikata Desir itu.
Dialogue: 0,0:03:20.29,0:03:21.29,Default,,0,0,0,,Eh?
Dialogue: 0,0:03:22.33,0:03:25.29,Default,,0,0,0,,Nampaknya benda itu takkan cedera\Ndengan magis biasa.
Dialogue: 0,0:03:26.62,0:03:28.38,Default,,0,0,0,,Saya perlu guna magis yang lebih kuat.
Dialogue: 0,0:03:28.76,0:03:30.72,Default,,0,0,0,,Priscilla, awak ke belakang sikit.
Dialogue: 0,0:03:30.84,0:03:31.84,Default,,0,0,0,,Baik.
Dialogue: 0,0:03:51.95,0:03:53.99,Default,,0,0,0,,Rods From God!
Dialogue: 0,0:04:20.10,0:04:23.02,Default,,0,0,0,,Seperti dijangka dari ahli sihir\Nterkuat dalam dunia.
Dialogue: 0,0:04:23.28,0:04:24.28,Default,,0,0,0,,Ya.
Dialogue: 0,0:04:26.77,0:04:28.49,Default,,0,0,0,,Bagaimana Desir…
Dialogue: 0,0:04:28.49,0:04:30.61,Default,,0,0,0,,boleh tahu banyak pasal syaitan ini?
Dialogue: 0,0:04:35.57,0:04:36.57,Default,,0,0,0,,Desir!
Dialogue: 0,0:04:36.57,0:04:38.41,Default,,0,0,0,,Ketua Menara dah berjaya kalahkannya!
Dialogue: 0,0:04:39.71,0:04:41.20,Default,,0,0,0,,Dadenewf juga dah dikalahkan.
Dialogue: 0,0:04:42.97,0:04:45.08,Default,,0,0,0,,Revolusi awak itu berakhir di sini!
Dialogue: 0,0:04:46.24,0:04:47.46,Default,,0,0,0,,Revolusi…
Dialogue: 0,0:04:47.88,0:04:48.88,Default,,0,0,0,,Itu bermakna…
Dialogue: 0,0:04:49.54,0:04:50.62,Default,,0,0,0,,Pada 12 tahun lalu,
Dialogue: 0,0:04:50.84,0:04:52.92,Default,,0,0,0,,berlaku perang saudara\Ndalam Empayar Hebrion.
Dialogue: 0,0:04:53.59,0:04:56.30,Default,,0,0,0,,Bagi membebaskan penduduk\Ndari undang-undang bangsawan ini,
Dialogue: 0,0:04:56.55,0:04:58.43,Default,,0,0,0,,ada seorang pelajar ini bangkit.
Dialogue: 0,0:04:59.60,0:05:02.27,Default,,0,0,0,,Peperangan telah dimenangi\Noleh pihak bangsawan.
Dialogue: 0,0:05:02.72,0:05:04.32,Default,,0,0,0,,Dan hal diskriminasi…
Dialogue: 0,0:05:04.32,0:05:06.31,Default,,0,0,0,,berdasarkan kelahiran semakin mendalam.
Dialogue: 0,0:05:07.61,0:05:09.90,Default,,0,0,0,,Kemarahan Batour dan rakannya\Npun ke arah bangsawan.
Dialogue: 0,0:05:10.89,0:05:11.94,Default,,0,0,0,,Bermakna kamu semua ini…
Dialogue: 0,0:05:12.25,0:05:14.11,Default,,0,0,0,,adalah ahli revolusi yang terselamat.
Dialogue: 0,0:05:16.99,0:05:20.20,Default,,0,0,0,,Dunia ini penuh dengan kebodohan.
Dialogue: 0,0:05:21.03,0:05:22.75,Default,,0,0,0,,Dunia ini cuma mengelilingi\Norang bangsawan
Dialogue: 0,0:05:22.75,0:05:25.12,Default,,0,0,0,,dan bangsawan ini yang pegang kuasa.
Dialogue: 0,0:05:25.12,0:05:27.67,Default,,0,0,0,,Manakala yang lain dipaksa\Nmenerima ideologi korupsi.
Dialogue: 0,0:05:29.50,0:05:31.42,Default,,0,0,0,,Itu bukan berlaku di Hebrion saja.
Dialogue: 0,0:05:32.21,0:05:34.71,Default,,0,0,0,,Sebab bangsawan bebal dari\Nseluruh negara…
Dialogue: 0,0:05:34.92,0:05:38.51,Default,,0,0,0,,mengenakan piawaian mereka sendiri\Ndan tidak rasional pada lain.
Dialogue: 0,0:05:38.51,0:05:40.06,Default,,0,0,0,,Orang biasa kena tunggu.
Dialogue: 0,0:05:40.30,0:05:41.45,Default,,0,0,0,,Mana boleh begitu!
Dialogue: 0,0:05:41.45,0:05:42.76,Default,,0,0,0,,Izinkan kami naik juga!
Dialogue: 0,0:05:43.97,0:05:47.22,Default,,0,0,0,,Dunia ini secara asasnya dah salah!
Dialogue: 0,0:05:48.48,0:05:50.81,Default,,0,0,0,,Dan kau tak boleh menyangkal hal itu!
Dialogue: 0,0:05:50.95,0:05:51.98,Default,,0,0,0,,Ya.
Dialogue: 0,0:05:51.98,0:05:53.15,Default,,0,0,0,,Desir-San?!
Dialogue: 0,0:05:54.06,0:05:56.74,Default,,0,0,0,,Sedangkan diskriminasi\Ndalam sekolah belum hilang.
Dialogue: 0,0:05:57.44,0:05:59.24,Default,,0,0,0,,Masa depan orang berbakat ini
Dialogue: 0,0:05:59.50,0:06:02.12,Default,,0,0,0,,dah tertutup disebabkan\Nawak lahir dari keluarga biasa.
Dialogue: 0,0:06:03.20,0:06:04.95,Default,,0,0,0,,Namun, awak lihat ini!
Dialogue: 0,0:06:05.58,0:06:07.37,Default,,0,0,0,,Kamu dah sakiti orang ini.
Dialogue: 0,0:06:07.54,0:06:10.74,Default,,0,0,0,,Orang-orang yang sepatutnya kamu lindungi!
Dialogue: 0,0:06:10.74,0:06:12.44,Default,,0,0,0,,Jangan nak ubah topik!
Dialogue: 0,0:06:12.44,0:06:15.09,Default,,0,0,0,,Orang yang menerima\Nsituasi ini tetap salah!
Dialogue: 0,0:06:15.51,0:06:20.39,Default,,0,0,0,,Aku akan hancurkan segala dalam dunia\Nini dan cipta kesaksamaan sebenar!
Dialogue: 0,0:06:21.02,0:06:22.25,Default,,0,0,0,,Lelaki ini…
Dialogue: 0,0:06:24.76,0:06:26.18,Default,,0,0,0,,Kami perlu tahan diri awak.
Dialogue: 0,0:06:29.10,0:06:32.11,Default,,0,0,0,,Kau ingat dah berjaya kalahkan Dadenewf?
Dialogue: 0,0:06:33.67,0:06:35.62,Default,,0,0,0,,Itu satu berita yang bagus.
Dialogue: 0,0:06:35.62,0:06:36.66,Default,,0,0,0,,Apa?!
Dialogue: 0,0:06:37.40,0:06:39.91,Default,,0,0,0,,Ianya merupakan satu bencana.
Dialogue: 0,0:06:39.91,0:06:42.83,Default,,0,0,0,,Tak mungkin manusia biasa boleh kalahkan.
Dialogue: 0,0:06:46.27,0:06:47.52,Default,,0,0,0,,Jangan kata..!
Dialogue: 0,0:07:01.76,0:07:03.01,Default,,0,0,0,,Itu…
Dialogue: 0,0:07:24.78,0:07:26.09,Default,,0,0,0,,Mengalah saja!
Dialogue: 0,0:07:26.99,0:07:29.06,Default,,0,0,0,,Sebab kamu semua dah pun kalah.
Dialogue: 0,0:07:29.06,0:07:30.25,Default,,0,0,0,,Jangan nak lari!
Dialogue: 0,0:07:34.71,0:07:35.98,Default,,0,0,0,,Dia berjaya lari.
Dialogue: 0,0:07:35.98,0:07:37.67,Default,,0,0,0,,Maafkan saya, Desir-San…
Dialogue: 0,0:07:39.83,0:07:40.97,Default,,0,0,0,,Desir-San?
Dialogue: 0,0:07:41.59,0:07:44.05,Default,,0,0,0,,Desir, saya datang ke tempat kamu.
Dialogue: 0,0:07:44.68,0:07:47.22,Default,,0,0,0,,Saya tak rasa boleh buat ini sendiri.
Dialogue: 0,0:07:49.31,0:07:51.50,Default,,0,0,0,,Desir, awak dengar tak ini?
Dialogue: 0,0:07:51.50,0:07:52.89,Default,,0,0,0,,Hei, Desir!
Dialogue: 0,0:07:53.66,0:07:55.23,Default,,0,0,0,,Ya! Maaf.
Dialogue: 0,0:07:55.23,0:07:56.90,Default,,0,0,0,,Awak tak apa-apakah ini?
Dialogue: 0,0:07:57.40,0:07:58.40,Default,,0,0,0,,Saya tak apa-apa.
Dialogue: 0,0:07:58.73,0:08:00.09,Default,,0,0,0,,Biar kami ke sana.
Dialogue: 0,0:08:00.09,0:08:01.53,Default,,0,0,0,,Awak tunggu saja di situ.
Dialogue: 0,0:08:02.40,0:08:03.49,Default,,0,0,0,,Roger.
Dialogue: 0,0:08:09.51,0:08:11.00,Default,,0,0,0,,Masa depan ini dah berubah?
Dialogue: 0,0:08:12.66,0:08:15.46,Default,,0,0,0,,Sebab pertarungan kami menentang Dadenewf
Dialogue: 0,0:08:15.64,0:08:17.29,Default,,0,0,0,,dalam Dunia Bayangan masih jauh lagi.
Dialogue: 0,0:08:17.96,0:08:20.26,Default,,0,0,0,,Syaitan Huru-Hara yang\Ndikatakan dalam legenda.
Dialogue: 0,0:08:20.43,0:08:23.30,Default,,0,0,0,,Kuasa yang dimilikinya\Nsememangnya satu bencana.
Dialogue: 0,0:08:24.22,0:08:26.76,Default,,0,0,0,,Kami semua bergabung tenaga dalam\Nmengalahkan syaitan itu.
Dialogue: 0,0:08:27.78,0:08:28.78,Default,,0,0,0,,Tapi…
Dialogue: 0,0:08:29.19,0:08:30.60,Default,,0,0,0,,bayaran untuk semua itu…
Dialogue: 0,0:08:31.77,0:08:33.35,Default,,0,0,0,,Ianya terlalu besar untuk saya…
Dialogue: 0,0:08:39.27,0:08:40.57,Default,,0,0,0,,Itu satu Mana yang besar.
Dialogue: 0,0:08:40.93,0:08:43.03,Default,,0,0,0,,Dia jadi lebih kuat dari sebelumnya.
Dialogue: 0,0:08:43.45,0:08:45.24,Default,,0,0,0,,Apa yang boleh kita buat ini?
Dialogue: 0,0:08:46.07,0:08:47.78,Default,,0,0,0,,Romantica… Aaron…
Dialogue: 0,0:08:48.35,0:08:49.72,Default,,0,0,0,,Dan juga Dadenewf…
Dialogue: 0,0:08:50.34,0:08:51.34,Default,,0,0,0,,Kenapa?!
Dialogue: 0,0:08:51.62,0:08:54.66,Default,,0,0,0,,Kenapa ia boleh muncul di sini dan\Nbukan di Dunia Bayangan?
Dialogue: 0,0:08:56.20,0:08:58.29,Default,,0,0,0,,Adakah sebab saya kembali ke masa lalu?
Dialogue: 0,0:09:01.71,0:09:04.72,Default,,0,0,0,,Adakah saya tak boleh terlepas dari\Npunca dan kesan ini?
Dialogue: 0,0:09:06.26,0:09:07.47,Default,,0,0,0,,Desir?
Dialogue: 0,0:09:12.80,0:09:14.06,Default,,0,0,0,,Jangan nak mengarut!
Dialogue: 0,0:09:18.19,0:09:20.70,Default,,0,0,0,,Kita tiada pilihan selain serah\NDadenewf kepada Ketua Menara.
Dialogue: 0,0:09:20.70,0:09:22.48,Default,,0,0,0,,Kita pasti akan jadi beban padanya.
Dialogue: 0,0:09:23.18,0:09:24.85,Default,,0,0,0,,Mari bantu pindahkan penduduk di sini.
Dialogue: 0,0:09:25.02,0:09:27.11,Default,,0,0,0,,Dan selamatkan nyawa\Norang sebanyak boleh.
Dialogue: 0,0:09:27.11,0:09:27.68,Default,,0,0,0,,Baik!
Dialogue: 0,0:09:27.68,0:09:28.71,Default,,0,0,0,,Baiklah!
Dialogue: 0,0:09:28.71,0:09:29.71,Default,,0,0,0,,Ya!
Dialogue: 0,0:09:45.76,0:09:46.80,Default,,0,0,0,,Kita dah selamat…
Dialogue: 0,0:09:46.80,0:09:49.22,Default,,0,0,0,,Tapi bandar ini dah dijilat api.
Dialogue: 0,0:09:50.68,0:09:52.18,Default,,0,0,0,,Ibu, lihat itu.
Dialogue: 0,0:09:52.18,0:09:53.21,Default,,0,0,0,,Apa dia?
Dialogue: 0,0:09:53.80,0:09:55.35,Default,,0,0,0,,Ada bunga api besar!
Dialogue: 0,0:10:05.07,0:10:06.53,Default,,0,0,0,,Ice Crown!
Dialogue: 0,0:10:16.66,0:10:18.17,Default,,0,0,0,,Semua akan baik-baik saja.
Dialogue: 0,0:10:30.55,0:10:32.78,Default,,0,0,0,,Jangan risau, belah bawah serah\Npada mereka dua.
Dialogue: 0,0:10:33.22,0:10:34.89,Default,,0,0,0,,Tolong fokus, Romantica.
Dialogue: 0,0:10:34.89,0:10:36.19,Default,,0,0,0,,Saya tahu juga.
Dialogue: 0,0:10:36.76,0:10:38.94,Default,,0,0,0,,Arah pukul 2, dalam jarak 850.
Dialogue: 0,0:10:38.94,0:10:40.03,Default,,0,0,0,,Roger!
Dialogue: 0,0:10:43.90,0:10:45.73,Default,,0,0,0,,Seterusnya, arah pukul 11.
Dialogue: 0,0:10:45.73,0:10:46.73,Default,,0,0,0,,Jarak 1200.
Dialogue: 0,0:10:59.46,0:11:00.67,Default,,0,0,0,,Ia tak dapat nak capai?
Dialogue: 0,0:11:01.33,0:11:02.34,Default,,0,0,0,,Kalau begitu…
Dialogue: 0,0:11:03.59,0:11:04.85,Default,,0,0,0,,Vortex!
Dialogue: 0,0:11:13.34,0:11:14.62,Default,,0,0,0,,Lagi sekali.
Dialogue: 0,0:11:15.36,0:11:17.31,Default,,0,0,0,,Obsidian Saber!
Dialogue: 0,0:11:25.84,0:11:26.84,Default,,0,0,0,,Maafkan saya.
Dialogue: 0,0:11:27.22,0:11:28.22,Default,,0,0,0,,Heal.
Dialogue: 0,0:11:35.99,0:11:37.05,Default,,0,0,0,,Terima kasih,
Dialogue: 0,0:11:37.05,0:11:38.08,Default,,0,0,0,,tapi awak undur dulu.
Dialogue: 0,0:11:39.87,0:11:41.08,Default,,0,0,0,,Jangan kata…
Dialogue: 0,0:11:41.89,0:11:43.12,Default,,0,0,0,,Ini belum berakhir.
Dialogue: 0,0:12:02.73,0:12:04.06,Default,,0,0,0,,Tak mungkin…
Dialogue: 0,0:12:04.90,0:12:06.11,Default,,0,0,0,,Nampaknya gelaran syaitan ini…
Dialogue: 0,0:12:06.53,0:12:08.12,Default,,0,0,0,,langsung tak bermain-main.
Dialogue: 0,0:12:14.16,0:12:16.82,Default,,0,0,0,,Romantica, kapal itu dah bergerak\Nke tempat selamat.
Dialogue: 0,0:12:17.16,0:12:18.24,Default,,0,0,0,,Ianya tak apa-apa sekarang.
Dialogue: 0,0:12:18.86,0:12:20.24,Default,,0,0,0,,Syukurlah…
Dialogue: 0,0:12:23.81,0:12:25.00,Default,,0,0,0,,Itu memang hebat.
Dialogue: 0,0:12:25.00,0:12:27.44,Default,,0,0,0,,Sebab itu saya kata\Nawak ini menjengkelkan.
Dialogue: 0,0:12:28.17,0:12:30.38,Default,,0,0,0,,Cukuplah itu untuk sekarang.
Dialogue: 0,0:12:34.72,0:12:36.39,Default,,0,0,0,,Kita pun patut beredar sekarang.
Dialogue: 0,0:12:46.21,0:12:47.21,Default,,0,0,0,,Romantica.
Dialogue: 0,0:12:48.04,0:12:49.23,Default,,0,0,0,,Saya faham.
Dialogue: 0,0:12:55.91,0:12:58.00,Default,,0,0,0,,Desir-San, kami dah tiba di stesen.
Dialogue: 0,0:12:58.00,0:12:59.25,Default,,0,0,0,,Bagaimana dengan kamu?
Dialogue: 0,0:13:00.70,0:13:01.80,Default,,0,0,0,,Sedikit saja lagi.
Dialogue: 0,0:13:01.80,0:13:02.83,Default,,0,0,0,,Kamu naik dulu—
Dialogue: 0,0:13:02.83,0:13:03.88,Default,,0,0,0,,Kami tunggu awak!
Dialogue: 0,0:13:06.03,0:13:07.03,Default,,0,0,0,,Baiklah.
Dialogue: 0,0:13:10.24,0:13:11.96,Default,,0,0,0,,Awak tak apa-apa, Romantica?
Dialogue: 0,0:13:13.04,0:13:15.30,Default,,0,0,0,,Saya tak apa-apa…
Dialogue: 0,0:13:16.14,0:13:17.76,Default,,0,0,0,,Awak tak nampak macam itu.
Dialogue: 0,0:13:19.72,0:13:22.64,Default,,0,0,0,,Saya cuma guna terlalu banyak Mana.
Dialogue: 0,0:13:29.39,0:13:31.02,Default,,0,0,0,,Baik, mari pergi!
Dialogue: 0,0:13:31.47,0:13:32.47,Default,,0,0,0,,Ya.
Dialogue: 0,0:13:33.77,0:13:34.78,Default,,0,0,0,,Apa itu?
Dialogue: 0,0:13:35.15,0:13:36.53,Default,,0,0,0,,Itu pasti ahli Outers.
Dialogue: 0,0:13:36.53,0:13:37.53,Default,,0,0,0,,Di mana?
Dialogue: 0,0:13:38.13,0:13:39.67,Default,,0,0,0,,Kita tak boleh biarkan dia.
Dialogue: 0,0:13:40.16,0:13:41.74,Default,,0,0,0,,Romantica, awak ke stesen dulu.
Dialogue: 0,0:13:41.74,0:13:43.75,Default,,0,0,0,,Tak nak! Biar saya ikut sama…
Dialogue: 0,0:13:43.75,0:13:45.37,Default,,0,0,0,,Awak dah kehabisan Mana, kan?
Dialogue: 0,0:13:45.37,0:13:46.66,Default,,0,0,0,,Jangan paksa diri awak.
Dialogue: 0,0:13:47.12,0:13:49.79,Default,,0,0,0,,Itu memang betul, tapi…
Dialogue: 0,0:13:52.18,0:13:54.34,Default,,0,0,0,,Awak jangan bertindak melulu! Faham?
Dialogue: 0,0:13:54.86,0:13:56.17,Default,,0,0,0,,Saya tahu juga.
Dialogue: 0,0:13:56.99,0:14:01.35,Default,,0,0,0,,Senyuman awak itu menjengkelkan saya.
Dialogue: 0,0:14:09.35,0:14:10.45,Default,,0,0,0,,Maafkan saya,
Dialogue: 0,0:14:10.45,0:14:11.45,Default,,0,0,0,,Romantica.
Dialogue: 0,0:14:19.49,0:14:22.66,Default,,0,0,0,,Saya takkan biarkan ia berakhir\Nseperti sebelum ini!
Dialogue: 0,0:14:29.50,0:14:30.60,Default,,0,0,0,,Aaron…
Dialogue: 0,0:14:31.74,0:14:32.74,Default,,0,0,0,,Saya rasa…
Dialogue: 0,0:14:33.39,0:14:35.46,Default,,0,0,0,,saya tak pernah kenalkan\Ndiri saya pada awak lagi.
Dialogue: 0,0:14:36.21,0:14:37.30,Default,,0,0,0,,Maafkan saya!
Dialogue: 0,0:14:37.53,0:14:40.14,Default,,0,0,0,,Wahai Komander Kesateria Kerajaan\NDivide, Aaron-dono.
Dialogue: 0,0:14:42.28,0:14:45.81,Default,,0,0,0,,Bukankah awak ini ahli sihir yang bantu\Nraja keluar dari istana tadi?
Dialogue: 0,0:14:46.02,0:14:47.02,Default,,0,0,0,,Betul.
Dialogue: 0,0:14:47.02,0:14:49.85,Default,,0,0,0,,Saya Desir Herrman dari Akademi Hebrion.
Dialogue: 0,0:14:50.60,0:14:52.40,Default,,0,0,0,,Saya nak terima kasih sekali lagi.
Dialogue: 0,0:14:54.12,0:14:55.20,Default,,0,0,0,,Terima kasih.
Dialogue: 0,0:14:55.43,0:14:56.43,Default,,0,0,0,,Ya.
Dialogue: 0,0:14:58.05,0:14:59.99,Default,,0,0,0,,Saya yang patut terima kasih pada awak.
Dialogue: 0,0:15:02.03,0:15:03.58,Default,,0,0,0,,Sebab dapat bercakap macam ini…
Dialogue: 0,0:15:04.06,0:15:05.87,Default,,0,0,0,,dengan awak untuk sekali lagi.
Dialogue: 0,0:15:10.83,0:15:13.08,Default,,0,0,0,,Kapal Kerajaan Divide\Nsepatutnya dah berlabuh pergi.
Dialogue: 0,0:15:13.50,0:15:15.51,Default,,0,0,0,,Kenapa Komander masih ada di sini?
Dialogue: 0,0:15:15.96,0:15:19.42,Default,,0,0,0,,Walau ini masalah negara lain,\Nsaya tak boleh nak biarkan.
Dialogue: 0,0:15:19.67,0:15:22.18,Default,,0,0,0,,Kami cuba mencari jika ada\Nsesiapa yang tertinggal.
Dialogue: 0,0:15:22.55,0:15:25.26,Default,,0,0,0,,Kami dimarahi oleh Tuanku\Nkerana hal itu sahaja.
Dialogue: 0,0:15:26.31,0:15:27.56,Default,,0,0,0,,Tiada apa yang berubah.
Dialogue: 0,0:15:29.45,0:15:30.94,Default,,0,0,0,,Tolong beredar dari sini cepat.
Dialogue: 0,0:15:31.26,0:15:32.26,Default,,0,0,0,,Apa?
Dialogue: 0,0:15:32.65,0:15:36.01,Default,,0,0,0,,Sebab tak lama lagi, kuasa syaitan\Nitu akan sampai di sini.
Dialogue: 0,0:15:36.69,0:15:39.36,Default,,0,0,0,,Dan benda itu belum tunjukkan\Nkuasa penuhnya lagi.
Dialogue: 0,0:15:40.64,0:15:41.64,Default,,0,0,0,,Awak ini…
Dialogue: 0,0:15:42.13,0:15:44.20,Default,,0,0,0,,Saya tak nak ada sesiapa yang mati.
Dialogue: 0,0:15:48.17,0:15:49.26,Default,,0,0,0,,Baiklah.
Dialogue: 0,0:15:49.64,0:15:50.87,Default,,0,0,0,,Terima kasih.
Dialogue: 0,0:15:51.35,0:15:52.35,Default,,0,0,0,,Jumpa lagi!
Dialogue: 0,0:16:33.52,0:16:34.52,Default,,0,0,0,,Zod!
Dialogue: 0,0:16:34.75,0:16:36.04,Default,,0,0,0,,Saya tak apa-apa.
Dialogue: 0,0:16:36.04,0:16:37.04,Default,,0,0,0,,Saya akan tamatkan ini.
Dialogue: 0,0:16:40.00,0:16:41.63,Default,,0,0,0,,Absolute Zero!
Dialogue: 0,0:16:47.26,0:16:48.64,Default,,0,0,0,,Magma Howl!
Dialogue: 0,0:17:23.52,0:17:24.92,Default,,0,0,0,,Akhirnya dia tumbang juga.
Dialogue: 0,0:17:25.17,0:17:26.97,Default,,0,0,0,,Kerja yang bagus, Zod.
Dialogue: 0,0:17:27.25,0:17:28.44,Default,,0,0,0,,Belum lagi.
Dialogue: 0,0:17:31.47,0:17:32.81,Default,,0,0,0,,Apa maksud awak itu?
Dialogue: 0,0:17:33.23,0:17:36.27,Default,,0,0,0,,Dadenewf belum tunjuk\Nbentuk sebenarnya lagi.
Dialogue: 0,0:17:42.82,0:17:46.40,Default,,0,0,0,,Benda itu boleh musnahkan sebuah\Nbandar dalam satu malam saja.
Dialogue: 0,0:17:47.59,0:17:48.87,Default,,0,0,0,,Sebab identiti sebenarnya…
Dialogue: 0,0:18:25.23,0:18:28.00,Default,,0,0,0,,Dia adalah Syaitan Huru-Hara, Dadenewf!
Dialogue: 0,0:18:28.34,0:18:29.91,Default,,0,0,0,,Itu adalah bentuk sebenarnya!
Dialogue: 0,0:18:34.70,0:18:36.45,Default,,0,0,0,,Apa yang patut kita buat ini?
Dialogue: 0,0:18:37.37,0:18:38.41,Default,,0,0,0,,Desir.
Dialogue: 0,0:18:38.41,0:18:39.87,Default,,0,0,0,,Tolong jaga Priscilla ini.
Dialogue: 0,0:18:40.42,0:18:43.79,Default,,0,0,0,,Seorang paderi sangat\Ndiperlukan di dalam dunia ini.
Dialogue: 0,0:18:43.96,0:18:45.80,Default,,0,0,0,,Jangan! Zod!
Dialogue: 0,0:18:46.44,0:18:48.56,Default,,0,0,0,,Jika nak seimbangkan aturan dunia ini,
Dialogue: 0,0:18:48.56,0:18:51.02,Default,,0,0,0,,kami tak boleh kehilangan Zod Exarion.
Dialogue: 0,0:18:53.11,0:18:54.14,Default,,0,0,0,,Ketua Menara,
Dialogue: 0,0:18:54.93,0:18:56.93,Default,,0,0,0,,tolong beri baki Mana\Nawak kepada saya.
Dialogue: 0,0:18:59.31,0:19:00.44,Default,,0,0,0,,Awak rasa…
Dialogue: 0,0:19:00.73,0:19:02.02,Default,,0,0,0,,boleh kalahkan benda itu?
Dialogue: 0,0:19:02.64,0:19:03.64,Default,,0,0,0,,Ya!
Dialogue: 0,0:19:10.49,0:19:12.49,Default,,0,0,0,,Guna magis tahap rendah?
Dialogue: 0,0:19:13.37,0:19:14.91,Default,,0,0,0,,Awak boleh buat apa dengan itu?
Dialogue: 0,0:19:15.12,0:19:16.12,Default,,0,0,0,,Kejap.
Dialogue: 0,0:19:16.95,0:19:20.33,Default,,0,0,0,,Magis boleh sesuaikan diri\Ndan berubah sedikit demi sedikit.
Dialogue: 0,0:19:21.00,0:19:22.89,Default,,0,0,0,,Tapi ada satu benda yang tak berubah.
Dialogue: 0,0:19:23.39,0:19:24.63,Default,,0,0,0,,Itu adalah…
Dialogue: 0,0:19:24.63,0:19:28.88,Default,,0,0,0,,Mana yang perlu wujud di dalam situasi itu\Nsekali gus membuatnya lengkap.
Dialogue: 0,0:19:31.09,0:19:33.97,Default,,0,0,0,,Adakah kita boleh kalahkan\Nsyaitan itu dengan…
Dialogue: 0,0:19:33.97,0:19:36.10,Default,,0,0,0,,mengulangi satu magis yang mudah?
Dialogue: 0,0:19:36.77,0:19:37.77,Default,,0,0,0,,Tak.
Dialogue: 0,0:19:38.27,0:19:40.98,Default,,0,0,0,,Kuasa manusia takkan dapat\Nkalahkan syaitan itu.
Dialogue: 0,0:19:50.24,0:19:51.24,Default,,0,0,0,,Betul itu.
Dialogue: 0,0:19:52.20,0:19:54.57,Default,,0,0,0,,Satu kuasa yang lebih\Nkuat dari syaitan itu!
Dialogue: 0,0:20:10.01,0:20:11.63,Default,,0,0,0,,Kewujudannya…
Dialogue: 0,0:20:11.94,0:20:13.93,Default,,0,0,0,,telah dilupakan oleh\Nmemori manusia sejagat.
Dialogue: 0,0:20:14.39,0:20:17.60,Default,,0,0,0,,Ianya formula magis dari bangsa yang\Ndikenali pengasas magis.
Dialogue: 0,0:20:18.39,0:20:19.72,Default,,0,0,0,,Awak cuba nak buat apa?!
Dialogue: 0,0:20:28.32,0:20:29.96,Default,,0,0,0,,Dari awal-awal lagi, formula magis…
Dialogue: 0,0:20:30.15,0:20:34.70,Default,,0,0,0,,tiada apa selain dari teknik untuk manusia\Nproses Mana dan tukar kepada magis.
Dialogue: 0,0:20:36.70,0:20:40.08,Default,,0,0,0,,Mana ini memang dah wujud di dalam\Nsalasilah keturunan seseorang.
Dialogue: 0,0:20:40.45,0:20:42.66,Default,,0,0,0,,Dan tak perlukan apa-apa formula.
Dialogue: 0,0:20:44.26,0:20:46.04,Default,,0,0,0,,Sebab kata-kata ini saja…
Dialogue: 0,0:20:46.29,0:20:47.71,Default,,0,0,0,,dah boleh bawa kepada kehancuran.
Dialogue: 0,0:20:49.04,0:20:50.04,Default,,0,0,0,,Betul tak?
Dialogue: 0,0:20:51.55,0:20:53.09,Default,,0,0,0,,Boromir Napolitan.
Dialogue: 0,0:21:13.69,0:21:14.99,Default,,0,0,0,,Ini menarik.
Dialogue: 0,0:21:16.45,0:21:18.04,Default,,0,0,0,,Tunjukkan pada saya,
Dialogue: 0,0:21:18.04,0:21:19.41,Default,,0,0,0,,Desir Herrman!
Dialogue: 0,0:23:36.38,0:23:37.38,Default,,0,0,0,,Seterusnya,
Dialogue: 0,0:22:23.43,0:22:34.65,Default,,0,0,0,,♪ Angin lembut meniup di hati aku ♪
Dialogue: 0,0:22:35.89,0:22:42.51,Default,,0,0,0,,♪ Perasaan yang membesar\Njauh di dalam hati ini ♪
Dialogue: 0,0:22:42.51,0:22:47.41,Default,,0,0,0,,♪ Terlalu panjang untuk dieja ♪
Dialogue: 0,0:22:48.33,0:22:54.58,Default,,0,0,0,,♪ Untuk seseorang yang\Nsukar untuk aku fahami ♪
Dialogue: 0,0:22:54.58,0:23:00.57,Default,,0,0,0,,♪ Aku teringin nak\Nlebih kenal diri kau lagi ♪
Dialogue: 0,0:23:00.80,0:23:07.05,Default,,0,0,0,,♪ Tak kesah betapa rapuh masa depan itu ♪
Dialogue: 0,0:23:07.06,0:23:12.91,Default,,0,0,0,,♪ Aku bermimpi mimpi\Nyang takkan berakhir ♪
Dialogue: 0,0:23:12.91,0:23:19.44,Default,,0,0,0,,♪ Cuma hari di mana aku\Nfikir banyak pasal kau ♪
Dialogue: 0,0:23:19.44,0:23:27.16,Default,,0,0,0,,♪ Aku nak hari itu kekal selamanya ♪
Dialogue: 0,0:23:36.38,0:23:37.38,Default,,0,0,0,,Seterusnya,
Dialogue: 0,0:23:37.76,0:23:39.51,Default,,0,0,0,,"Kata-kata Kehancuran"

