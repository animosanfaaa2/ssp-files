Dialogue: 0,0:00:07.91,0:00:09.60,Default,,0,0,0,,Ta đã nghịch toán tất cả.
Dialogue: 0,0:00:10.42,0:00:13.74,Default,,0,0,0,,Toàn bộ ma pháp\Nmà artifact đó có thể sử dụng.
Dialogue: 0,0:00:15.75,0:00:17.45,Default,,0,0,0,,Ngươi thua rồi.
Dialogue: 0,0:00:48.66,0:00:50.03,Default,,0,0,0,,Quả là thứ khó nhằn.
Dialogue: 0,0:01:08.49,0:01:10.83,Default,,0,0,0,,♪I just want you to come back to me♪
Dialogue: 0,0:01:10.84,0:01:15.64,Default,,0,0,0,,♪Trong bóng tối, tầm mắt bị che kín♪
Dialogue: 0,0:01:15.67,0:01:18.28,Default,,0,0,0,,♪Yes, I know you’re just as lonely♪
Dialogue: 0,0:01:18.28,0:01:22.30,Default,,0,0,0,,♪Cảm xúc đó chẳng thể hóa thành nước mắt♪
Dialogue: 0,0:01:22.34,0:01:23.70,Default,,0,0,0,,♪Wow oh oh♪
Dialogue: 0,0:01:23.70,0:01:27.50,Default,,0,0,0,,♪Để có thể sống một cách chân thành♪
Dialogue: 0,0:01:27.50,0:01:36.94,Default,,0,0,0,,♪Chúng ta lại không đủ mạnh mẽ, thông minh♪
Dialogue: 0,0:01:36.94,0:01:43.85,Default,,0,0,0,,♪Trái tim đầy thương tổn♪
Dialogue: 0,0:01:44.08,0:01:51.42,Default,,0,0,0,,♪Nỗi đau ơi, đừng cứ một mình biến mất♪
Dialogue: 0,0:01:51.42,0:01:54.42,Default,,0,0,0,,♪Hãy đồng hành, tại sao?♪
Dialogue: 0,0:01:54.42,0:01:58.42,Default,,0,0,0,,♪"Hẹn gặp lại" chẳng thể trở về♪
Dialogue: 0,0:01:58.42,0:02:03.99,Default,,0,0,0,,♪Chỉ thiếu chút nữa là có thể lấy lại bản ngã♪
Dialogue: 0,0:02:03.99,0:02:08.95,Default,,0,0,0,,♪Kiên trì tới bình minh Yeah♪
Dialogue: 0,0:02:08.95,0:02:16.06,Default,,0,0,0,,♪Hóa thành cơn gió thổi qua♪
Dialogue: 0,0:02:16.06,0:02:19.71,Default,,0,0,0,,♪Hướng về buổi sớm ước hẹn♪
Dialogue: 0,0:02:22.54,0:02:26.50,Default,,0,0,0,,(Tập 19: Awakening)
Dialogue: 0,0:02:39.52,0:02:41.40,Default,,0,0,0,,Absolute Zero!
Dialogue: 0,0:03:15.53,0:03:16.65,Default,,0,0,0,,Anh không sao chứ?
Dialogue: 0,0:03:18.09,0:03:20.17,Default,,0,0,0,,Đúng như Desir nói.
Dialogue: 0,0:03:20.24,0:03:20.79,Default,,0,0,0,,Ể?
Dialogue: 0,0:03:22.10,0:03:25.19,Default,,0,0,0,,Đa số các ma pháp bình thường\Nkhông thể làm nó tổn thương!
Dialogue: 0,0:03:26.68,0:03:28.43,Default,,0,0,0,,Tôi sẽ sử dụng ma pháp lớn một chút.
Dialogue: 0,0:03:28.65,0:03:30.70,Default,,0,0,0,,Priscilla, hãy lùi lại đi.
Dialogue: 0,0:03:30.80,0:03:31.37,Default,,0,0,0,,Ừm.
Dialogue: 0,0:03:51.56,0:03:53.52,Default,,0,0,0,,Rods From God!
Dialogue: 0,0:04:20.23,0:04:23.13,Default,,0,0,0,,Không hổ là pháp sư mạnh nhất thế giới.
Dialogue: 0,0:04:23.24,0:04:23.96,Default,,0,0,0,,Ừm.
Dialogue: 0,0:04:26.71,0:04:30.89,Default,,0,0,0,,Tại sao Desir lại biết về con ác ma này?
Dialogue: 0,0:04:35.65,0:04:36.52,Default,,0,0,0,,Desir!
Dialogue: 0,0:04:36.65,0:04:38.37,Default,,0,0,0,,Ngài tháp chủ đã hạ được nó rồi!
Dialogue: 0,0:04:39.65,0:04:41.08,Default,,0,0,0,,Dadeinuf đã bị đánh bại.
Dialogue: 0,0:04:42.88,0:04:45.12,Default,,0,0,0,,Cuộc cách mạng của ngươi\Nsẽ kết thúc ở đây!
Dialogue: 0,0:04:46.24,0:04:47.36,Default,,0,0,0,,Cách mạng…
Dialogue: 0,0:04:47.55,0:04:49.00,Default,,0,0,0,,Vậy tức là…
Dialogue: 0,0:04:49.54,0:04:52.77,Default,,0,0,0,,12 năm trước, Đế quốc Hebrion\Nđã xảy ra nội chiến.
Dialogue: 0,0:04:53.66,0:04:58.38,Default,,0,0,0,,Một học sinh đã đứng lên nhằm giải phóng\Nngười dân khỏi sự cai trị của quý tộc.
Dialogue: 0,0:04:59.52,0:05:02.52,Default,,0,0,0,,Nhưng kết cục là quý tộc đã chiến thắng.
Dialogue: 0,0:05:02.78,0:05:06.37,Default,,0,0,0,,Sự phân biệt về xuất thân\Nngày một sâu hơn.
Dialogue: 0,0:05:07.42,0:05:10.00,Default,,0,0,0,,Đám người Batur cũng\Ncăm giận tầng lớp quý tộc.
Dialogue: 0,0:05:10.92,0:05:14.02,Default,,0,0,0,,Các người là tàn dư\Ncủa cuộc cách mạng đó đúng không?
Dialogue: 0,0:05:16.99,0:05:20.08,Default,,0,0,0,,Thế giới này ngập tràn sự phi lý.
Dialogue: 0,0:05:21.00,0:05:25.09,Default,,0,0,0,,"Quý tộc là trung tâm,\Nchỉ quý tộc được nắm giữ sức mạnh."
Dialogue: 0,0:05:25.10,0:05:27.59,Default,,0,0,0,,Chúng đã áp đặt cái tư tưởng đó.
Dialogue: 0,0:05:29.56,0:05:31.34,Default,,0,0,0,,Không chỉ riêng Hebrion.
Dialogue: 0,0:05:32.06,0:05:34.74,Default,,0,0,0,,Lũ quý tộc ngu xuẩn khắp thế gian…
Dialogue: 0,0:05:34.74,0:05:38.38,Default,,0,0,0,,đều lấy bản thân làm tiêu chuẩn\Nvà áp đặt sự bất công.
Dialogue: 0,0:05:43.98,0:05:47.21,Default,,0,0,0,,Thế giới này sai lệch tận gốc rễ.
Dialogue: 0,0:05:48.52,0:05:50.96,Default,,0,0,0,,Ngay cả ngươi cũng không thể\Nphủ nhận chuyện đó!
Dialogue: 0,0:05:51.12,0:05:51.84,Default,,0,0,0,,Phải.
Dialogue: 0,0:05:51.84,0:05:53.10,Default,,0,0,0,,Desir-san!?
Dialogue: 0,0:05:54.10,0:05:56.62,Default,,0,0,0,,Hiện tại, ở học viện vẫn còn\Nsự phân biệt đối xử.
Dialogue: 0,0:05:57.44,0:06:02.28,Default,,0,0,0,,Chỉ vì khác biệt về xuất thân\Nmà tương lai của nhiều tài năng bị đóng lại.
Dialogue: 0,0:06:03.28,0:06:04.96,Default,,0,0,0,,Nhưng ngươi hãy nhìn đi!
Dialogue: 0,0:06:05.53,0:06:07.46,Default,,0,0,0,,Những người bị các ngươi làm tổn thương…
Dialogue: 0,0:06:07.46,0:06:10.68,Default,,0,0,0,,chính là những người\Nđáng ra các ngươi phải bảo vệ đó!
Dialogue: 0,0:06:10.73,0:06:15.09,Default,,0,0,0,,Những kẻ không mong thay đổi\Nchỉ biết chấp nhận cũng là đồng phạm!
Dialogue: 0,0:06:15.50,0:06:20.34,Default,,0,0,0,,Bọn ta sẽ hủy diệt toàn bộ thế giới\Nvà mang tới sự bình đẳng thực sự!
Dialogue: 0,0:06:20.97,0:06:22.30,Default,,0,0,0,,Người này…
Dialogue: 0,0:06:24.51,0:06:26.17,Default,,0,0,0,,Ta sẽ bắt giữ ngươi.
Dialogue: 0,0:06:29.09,0:06:32.13,Default,,0,0,0,,Ngươi nói Dadeinuf đã bị đánh bại sao?
Dialogue: 0,0:06:33.48,0:06:35.37,Default,,0,0,0,,Quả là chuyện đáng mừng.
Dialogue: 0,0:06:35.49,0:06:36.40,Default,,0,0,0,,Cái gì!?
Dialogue: 0,0:06:37.50,0:06:42.78,Default,,0,0,0,,Cái thứ giống như tai ương đó\Nđâu thể bị đánh bại bởi con người.
Dialogue: 0,0:06:46.15,0:06:47.29,Default,,0,0,0,,Không lẽ!?
Dialogue: 0,0:07:01.76,0:07:02.89,Default,,0,0,0,,Đây là…
Dialogue: 0,0:07:24.78,0:07:25.92,Default,,0,0,0,,Hãy từ bỏ đi!
Dialogue: 0,0:07:26.82,0:07:28.80,Default,,0,0,0,,Các ngươi thua rồi.
Dialogue: 0,0:07:29.01,0:07:30.05,Default,,0,0,0,,Đừng hòng chạy!
Dialogue: 0,0:07:34.60,0:07:35.70,Default,,0,0,0,,Hắn thoát rồi sao.
Dialogue: 0,0:07:36.03,0:07:37.77,Default,,0,0,0,,Xin lỗi, Desir-san…
Dialogue: 0,0:07:39.76,0:07:41.04,Default,,0,0,0,,Desir-san?
Dialogue: 0,0:07:41.69,0:07:44.02,Default,,0,0,0,,Desir, tập hợp ở bên đó thôi.
Dialogue: 0,0:07:44.42,0:07:47.29,Default,,0,0,0,,Một mình mình chẳng làm được gì cả…
Dialogue: 0,0:07:49.25,0:07:50.26,Default,,0,0,0,,Desir?
Dialogue: 0,0:07:50.32,0:07:51.52,Default,,0,0,0,,Cậu có nghe không đó?
Dialogue: 0,0:07:51.56,0:07:52.96,Default,,0,0,0,,Này, Desir!
Dialogue: 0,0:07:53.67,0:07:55.26,Default,,0,0,0,,À, ừm, đúng rồi.
Dialogue: 0,0:07:55.26,0:07:56.73,Default,,0,0,0,,Này, cậu không sao chứ?
Dialogue: 0,0:07:57.25,0:07:58.28,Default,,0,0,0,,Tôi không sao.
Dialogue: 0,0:07:58.74,0:08:00.09,Default,,0,0,0,,Chúng ta sẽ qua bên đó.
Dialogue: 0,0:08:00.14,0:08:01.51,Default,,0,0,0,,Cậu đừng rời vị trí nhé.
Dialogue: 0,0:08:02.52,0:08:03.57,Default,,0,0,0,,Hiểu rồi.
Dialogue: 0,0:08:09.47,0:08:11.01,Default,,0,0,0,,Tương lai đang thay đổi sao?
Dialogue: 0,0:08:12.52,0:08:15.46,Default,,0,0,0,,Cuộc chiến với Dadeinuf trong\NThế Giới Bóng Ảnh của chúng tôi…
Dialogue: 0,0:08:15.46,0:08:17.37,Default,,0,0,0,,đáng nhẽ phải còn lâu mới xảy ra…
Dialogue: 0,0:08:17.96,0:08:20.31,Default,,0,0,0,,Ác ma tai ương\Nđược kể trong truyền thuyết…
Dialogue: 0,0:08:20.49,0:08:23.32,Default,,0,0,0,,Sức mạnh đó có thể gọi là thảm họa.
Dialogue: 0,0:08:24.28,0:08:26.74,Default,,0,0,0,,Chúng tôi đã hợp sức\Nvà đánh bại được ác ma.
Dialogue: 0,0:08:27.97,0:08:30.48,Default,,0,0,0,,Nhưng cái giá phải trả…
Dialogue: 0,0:08:31.71,0:08:33.45,Default,,0,0,0,,Cũng lớn vô cùng…
Dialogue: 0,0:08:39.22,0:08:40.50,Default,,0,0,0,,Lượng mana thật khủng khiếp.
Dialogue: 0,0:08:40.85,0:08:43.02,Default,,0,0,0,,Nó mạnh hơn nhiều so với ban nãy.
Dialogue: 0,0:08:43.50,0:08:45.18,Default,,0,0,0,,Phải làm gì với thứ đó đây?
Dialogue: 0,0:08:45.97,0:08:47.99,Default,,0,0,0,,Romantica, Aron…
Dialogue: 0,0:08:48.30,0:08:49.94,Default,,0,0,0,,Còn Dadeinuf…
Dialogue: 0,0:08:50.37,0:08:51.19,Default,,0,0,0,,Tại sao…
Dialogue: 0,0:08:51.48,0:08:54.89,Default,,0,0,0,,Tại sao nó lại xuất hiện ở thế giới thực\Nchứ không phải Thế Giới Bóng Ảnh?
Dialogue: 0,0:08:56.05,0:08:58.14,Default,,0,0,0,,Nguyên nhân là do tôi\Nđi ngược thời gian sao?
Dialogue: 0,0:09:01.75,0:09:04.68,Default,,0,0,0,,Đây gọi là không thể\Nthoát khỏi nhân quả sao?
Dialogue: 0,0:09:06.17,0:09:07.14,Default,,0,0,0,,Desir?
Dialogue: 0,0:09:12.59,0:09:14.16,Default,,0,0,0,,Đừng có trêu đùa như thế.
Dialogue: 0,0:09:14.40,0:09:15.18,Default,,0,0,0,,Hở?
Dialogue: 0,0:09:18.21,0:09:20.80,Default,,0,0,0,,Chỉ còn cách để ngài tháp chủ\Nđối phó Dadeinuf.
Dialogue: 0,0:09:20.82,0:09:22.63,Default,,0,0,0,,Chúng ta sẽ chỉ cản trở ngài ấy.
Dialogue: 0,0:09:23.17,0:09:24.82,Default,,0,0,0,,Hiện giờ cứ hỗ trợ việc sơ tán.
Dialogue: 0,0:09:24.96,0:09:27.13,Default,,0,0,0,,Hãy cố gắng cứu càng nhiều người càng tốt.
Dialogue: 0,0:09:27.13,0:09:27.69,Default,,0,0,0,,Vâng!
Dialogue: 0,0:09:27.73,0:09:28.61,Default,,0,0,0,,Mình hiểu rồi.
Dialogue: 0,0:09:28.65,0:09:29.26,Default,,0,0,0,,Ừm.
Dialogue: 0,0:09:45.65,0:09:46.81,Default,,0,0,0,,May quá…
Dialogue: 0,0:09:46.83,0:09:49.13,Default,,0,0,0,,Nhưng thành phố đã chìm trong biển lửa.
Dialogue: 0,0:09:49.76,0:09:50.37,Default,,0,0,0,,A!
Dialogue: 0,0:09:50.56,0:09:52.20,Default,,0,0,0,,Mẹ ơi, nhìn bên đó kìa.
Dialogue: 0,0:09:52.26,0:09:53.06,Default,,0,0,0,,Sao thế?
Dialogue: 0,0:09:53.78,0:09:55.30,Default,,0,0,0,,Một quả pháo hoa rất lớn!
Dialogue: 0,0:10:04.98,0:10:06.50,Default,,0,0,0,,Ice Crown!
Dialogue: 0,0:10:16.61,0:10:18.07,Default,,0,0,0,,Giờ đã không sao nữa rồi.
Dialogue: 0,0:10:30.41,0:10:32.83,Default,,0,0,0,,Dưới đất giao cho hai người họ là ổn rồi.
Dialogue: 0,0:10:33.12,0:10:34.90,Default,,0,0,0,,Tập trung nào, Romantica.
Dialogue: 0,0:10:34.93,0:10:36.01,Default,,0,0,0,,Mình hiểu mà.
Dialogue: 0,0:10:36.70,0:10:38.91,Default,,0,0,0,,Hướng 2 giờ, cự ly 850.
Dialogue: 0,0:10:39.00,0:10:39.75,Default,,0,0,0,,Đã rõ.
Dialogue: 0,0:10:43.96,0:10:46.54,Default,,0,0,0,,Tiếp theo, hướng 11 giờ, cự ly 1200.
Dialogue: 0,0:10:59.35,0:11:00.65,Default,,0,0,0,,Không chạm tới sao?
Dialogue: 0,0:11:01.35,0:11:02.06,Default,,0,0,0,,Đã vậy thì…
Dialogue: 0,0:11:03.69,0:11:04.87,Default,,0,0,0,,Vortex!
Dialogue: 0,0:11:13.34,0:11:14.38,Default,,0,0,0,,Thêm chiêu nữa!
Dialogue: 0,0:11:15.30,0:11:16.99,Default,,0,0,0,,Obsidian Saber!
Dialogue: 0,0:11:25.87,0:11:26.64,Default,,0,0,0,,Phiền cô.
Dialogue: 0,0:11:27.37,0:11:28.09,Default,,0,0,0,,Heal.
Dialogue: 0,0:11:36.02,0:11:36.81,Default,,0,0,0,,Cảm ơn.
Dialogue: 0,0:11:37.10,0:11:38.25,Default,,0,0,0,,Hãy lùi lại đi.
Dialogue: 0,0:11:39.16,0:11:41.00,Default,,0,0,0,,Ế? Không lẽ?
Dialogue: 0,0:11:41.83,0:11:43.16,Default,,0,0,0,,Vẫn chưa kết thúc đâu.
Dialogue: 0,0:12:02.84,0:12:04.05,Default,,0,0,0,,Không phải chứ…
Dialogue: 0,0:12:04.84,0:12:07.76,Default,,0,0,0,,Có vẻ tên của con ác ma đó…\Nkhông phải hư cấu.
Dialogue: 0,0:12:14.24,0:12:16.94,Default,,0,0,0,,Romantica, các con thuyền\Nđều đã ra đến phạm vi an toàn.
Dialogue: 0,0:12:17.04,0:12:18.15,Default,,0,0,0,,Không sao nữa rồi.
Dialogue: 0,0:12:18.77,0:12:20.22,Default,,0,0,0,,Tốt quá.
Dialogue: 0,0:12:23.74,0:12:25.00,Default,,0,0,0,,Cậu làm tốt lắm.
Dialogue: 0,0:12:25.09,0:12:27.29,Default,,0,0,0,,Chính cái kiểu này làm người ta bực đấy.
Dialogue: 0,0:12:28.30,0:12:30.06,Default,,0,0,0,,Mà thôi, lúc này thì cứ kệ đi.
Dialogue: 0,0:12:34.76,0:12:36.27,Default,,0,0,0,,Chúng ta cũng nên di tản thôi.
Dialogue: 0,0:12:46.21,0:12:47.00,Default,,0,0,0,,Romantica.
Dialogue: 0,0:12:48.09,0:12:49.08,Default,,0,0,0,,Mình hiểu mà.
Dialogue: 0,0:12:55.95,0:12:57.88,Default,,0,0,0,,Desir-san, bọn tớ đến ga rồi.
Dialogue: 0,0:12:58.08,0:12:59.17,Default,,0,0,0,,Bên đó thế nào?
Dialogue: 0,0:13:00.77,0:13:01.96,Default,,0,0,0,,Còn một chút nữa thôi.
Dialogue: 0,0:13:01.96,0:13:02.89,Default,,0,0,0,,Cứ lên tàu trước đi.
Dialogue: 0,0:13:02.89,0:13:03.80,Default,,0,0,0,,- Tôi sẽ đợi!\N- Tớ sẽ đợi!
Dialogue: 0,0:13:06.03,0:13:06.88,Default,,0,0,0,,Hiểu rồi.
Dialogue: 0,0:13:10.19,0:13:11.76,Default,,0,0,0,,Romantica, không sao chứ?
Dialogue: 0,0:13:13.07,0:13:15.05,Default,,0,0,0,,Không sao.
Dialogue: 0,0:13:16.15,0:13:17.71,Default,,0,0,0,,Trông không giống lắm đâu.
Dialogue: 0,0:13:19.34,0:13:22.52,Default,,0,0,0,,Chỉ là dùng hơi nhiều mana thôi.
Dialogue: 0,0:13:29.38,0:13:30.95,Default,,0,0,0,,Được rồi, đi thôi!
Dialogue: 0,0:13:31.44,0:13:31.88,Default,,0,0,0,,Ừ.
Dialogue: 0,0:13:33.78,0:13:34.70,Default,,0,0,0,,Cái gì?
Dialogue: 0,0:13:35.13,0:13:36.51,Default,,0,0,0,,Tàn dư của Outer.
Dialogue: 0,0:13:36.64,0:13:37.44,Default,,0,0,0,,Ở đâu?
Dialogue: 0,0:13:38.08,0:13:39.64,Default,,0,0,0,,Không thể để mặc kẻ đó được.
Dialogue: 0,0:13:40.21,0:13:41.73,Default,,0,0,0,,Romantica tới ga đi.
Dialogue: 0,0:13:41.83,0:13:43.83,Default,,0,0,0,,Không muốn! Mình cũng có thể giúp mà…
Dialogue: 0,0:13:43.83,0:13:45.13,Default,,0,0,0,,Cậu hết mana rồi đúng không?
Dialogue: 0,0:13:45.39,0:13:46.68,Default,,0,0,0,,Không cố được nữa đâu.
Dialogue: 0,0:13:47.20,0:13:49.69,Default,,0,0,0,,Đúng là như vậy nhưng mà…
Dialogue: 0,0:13:52.23,0:13:54.48,Default,,0,0,0,,Đừng có liều mạng nhé, hiểu chưa?
Dialogue: 0,0:13:54.84,0:13:56.08,Default,,0,0,0,,Biết rồi mà.
Dialogue: 0,0:13:57.16,0:13:58.33,Default,,0,0,0,,Quả nhiên…
Dialogue: 0,0:13:59.21,0:14:01.28,Default,,0,0,0,,Cái nụ cười này thấy mà ghét.
Dialogue: 0,0:14:09.29,0:14:11.37,Default,,0,0,0,,Xin lỗi, Romantica.
Dialogue: 0,0:14:19.47,0:14:22.61,Default,,0,0,0,,Tôi tuyệt đối không để cái kết đó tái diễn!
Dialogue: 0,0:14:29.48,0:14:30.40,Default,,0,0,0,,Aron…
Dialogue: 0,0:14:31.87,0:14:32.60,Default,,0,0,0,,Cậu là ai?
Dialogue: 0,0:14:33.35,0:14:35.29,Default,,0,0,0,,Tôi không nhớ từng xưng tên với cậu.
Dialogue: 0,0:14:36.21,0:14:37.18,Default,,0,0,0,,Xin thứ lỗi!
Dialogue: 0,0:14:37.48,0:14:40.07,Default,,0,0,0,,Hiệp sĩ đoàn trưởng\NVương quốc Divide, ngài Aron.
Dialogue: 0,0:14:41.38,0:14:45.71,Default,,0,0,0,,A, cậu là pháp sư đã giúp\Nđức vua sơ tán lúc ở cung điện.
Dialogue: 0,0:14:46.08,0:14:49.85,Default,,0,0,0,,Vâng, tôi là Desir Herrman\Nthuộc Học viện Hebrion.
Dialogue: 0,0:14:50.61,0:14:52.36,Default,,0,0,0,,Một lần nữa cho phép ta được cảm ơn.
Dialogue: 0,0:14:54.19,0:14:55.11,Default,,0,0,0,,Xin cảm tạ.
Dialogue: 0,0:14:55.59,0:14:55.98,Default,,0,0,0,,Vâng.
Dialogue: 0,0:14:58.04,0:14:59.93,Default,,0,0,0,,Tôi mới là người muốn cảm ơn.
Dialogue: 0,0:15:02.04,0:15:05.78,Default,,0,0,0,,Vì một lần nữa\Ncó thể nói chuyện với anh…
Dialogue: 0,0:15:10.91,0:15:13.38,Default,,0,0,0,,Thuyền của Vương quốc Divide\Nđã ra khơi rồi…
Dialogue: 0,0:15:13.38,0:15:15.38,Default,,0,0,0,,Tại sao ngài đoàn trưởng lại ở đây?
Dialogue: 0,0:15:15.93,0:15:17.79,Default,,0,0,0,,Dù là chuyện của nước khác…
Dialogue: 0,0:15:17.80,0:15:19.35,Default,,0,0,0,,nhưng đâu thể bỏ mặc được.
Dialogue: 0,0:15:19.67,0:15:22.22,Default,,0,0,0,,Chúng tôi đang tìm xem\Ncó ai chưa kịp thoát thân không…
Dialogue: 0,0:15:22.65,0:15:25.21,Default,,0,0,0,,Mặc dù tôi cũng bị\Nbệ hạ quở trách vì việc này.
Dialogue: 0,0:15:26.32,0:15:27.48,Default,,0,0,0,,Chẳng thay đổi gì nhỉ.
Dialogue: 0,0:15:29.53,0:15:30.87,Default,,0,0,0,,Hãy mau chóng rời khỏi đây.
Dialogue: 0,0:15:31.18,0:15:31.96,Default,,0,0,0,,Cái gì?
Dialogue: 0,0:15:32.78,0:15:36.00,Default,,0,0,0,,Chẳng mấy chốc\Nsức mạnh của ác ma đó sẽ lan đến đây.
Dialogue: 0,0:15:36.73,0:15:39.26,Default,,0,0,0,,Nó vẫn chưa phô diễn toàn bộ sức mạnh.
Dialogue: 0,0:15:40.56,0:15:41.45,Default,,0,0,0,,Cậu…
Dialogue: 0,0:15:42.09,0:15:44.12,Default,,0,0,0,,Tôi không muốn bất cứ ai phải chết.
Dialogue: 0,0:15:48.28,0:15:49.16,Default,,0,0,0,,Ta hiểu rồi.
Dialogue: 0,0:15:49.71,0:15:50.75,Default,,0,0,0,,Cảm ơn ngài.
Dialogue: 0,0:15:51.37,0:15:52.17,Default,,0,0,0,,Tôi xin phép…
Dialogue: 0,0:16:33.59,0:16:34.13,Default,,0,0,0,,Zod!
Dialogue: 0,0:16:34.89,0:16:36.76,Default,,0,0,0,,Không sao, tôi sẽ kết thúc nó.
Dialogue: 0,0:16:40.00,0:16:41.53,Default,,0,0,0,,Absolute Zero!
Dialogue: 0,0:16:47.30,0:16:48.46,Default,,0,0,0,,Magma Howl!
Dialogue: 0,0:17:23.50,0:17:24.77,Default,,0,0,0,,Cuối cùng cũng đã hạ được à.
Dialogue: 0,0:17:25.14,0:17:26.89,Default,,0,0,0,,Anh vất vả rồi, Zod.
Dialogue: 0,0:17:27.38,0:17:28.42,Default,,0,0,0,,Vẫn chưa đâu.
Dialogue: 0,0:17:31.56,0:17:32.61,Default,,0,0,0,,Ý cậu là sao?
Dialogue: 0,0:17:33.23,0:17:36.05,Default,,0,0,0,,Dadeinuf vẫn chưa\Nphô diễn hình dạng thật sự.
Dialogue: 0,0:17:42.90,0:17:46.40,Default,,0,0,0,,Ác ma đó đủ sức hủy diệt\Nmột thành phố chỉ trong một đêm.
Dialogue: 0,0:17:47.38,0:17:49.05,Default,,0,0,0,,Chân tướng của nó chính là…
Dialogue: 0,0:18:25.31,0:18:29.96,Default,,0,0,0,,Đó chính là hình dạng thật\Ncủa Ác ma tai ương Dadeinuf!
Dialogue: 0,0:18:34.74,0:18:36.49,Default,,0,0,0,,Vậy rốt cuộc phải làm thế nào?
Dialogue: 0,0:18:37.37,0:18:39.78,Default,,0,0,0,,Desir, nhờ cậu chăm sóc Priscilla.
Dialogue: 0,0:18:40.41,0:18:43.74,Default,,0,0,0,,Để giữ trật tự của thế giới này,\Ncần có Thánh Nữ.
Dialogue: 0,0:18:43.96,0:18:45.74,Default,,0,0,0,,Zod! Không được!
Dialogue: 0,0:18:46.51,0:18:50.97,Default,,0,0,0,,Nếu vì trật tự thế giới\Nthì cũng không thể mất đi Zod Exarion.
Dialogue: 0,0:18:53.14,0:18:54.34,Default,,0,0,0,,Ngài tháp chủ.
Dialogue: 0,0:18:54.84,0:18:56.92,Default,,0,0,0,,Hãy giao lượng mana còn lại cho tôi.
Dialogue: 0,0:18:59.35,0:19:02.06,Default,,0,0,0,,Cậu nói bản thân có thể hạ thứ đó sao?
Dialogue: 0,0:19:02.59,0:19:03.64,Default,,0,0,0,,Vâng!
Dialogue: 0,0:19:10.34,0:19:12.33,Default,,0,0,0,,Thuật thức ma pháp hạ cấp?
Dialogue: 0,0:19:13.34,0:19:14.84,Default,,0,0,0,,Cậu định làm gì với thứ đó?
Dialogue: 0,0:19:15.10,0:19:16.09,Default,,0,0,0,,Đợi đã!
Dialogue: 0,0:19:16.95,0:19:20.20,Default,,0,0,0,,Ma pháp đã dần biến đổi\Nđể phù hợp với thời đại.
Dialogue: 0,0:19:20.98,0:19:28.81,Default,,0,0,0,,Nhưng vẫn có một chuyện bất biến là\Nbắt buộc gia công mana trong không khí.
Dialogue: 0,0:19:30.92,0:19:33.75,Default,,0,0,0,,Chỉ bằng việc xếp chồng\Ncác thuật thức cơ bản như này…
Dialogue: 0,0:19:33.86,0:19:35.96,Default,,0,0,0,,cậu cho rằng sẽ hạ được ác ma đó sao?
Dialogue: 0,0:19:36.83,0:19:37.59,Default,,0,0,0,,Không.
Dialogue: 0,0:19:38.22,0:19:40.84,Default,,0,0,0,,Với sức người không thể hạ gục ác ma đó.
Dialogue: 0,0:19:50.32,0:19:51.10,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:19:52.28,0:19:54.77,Default,,0,0,0,,Cần thứ sức mạnh vượt trên ác ma đó!
Dialogue: 0,0:20:09.74,0:20:14.35,Default,,0,0,0,,Thứ đã bị lãng quên\Ntrong ký ức của nhân loại…
Dialogue: 0,0:20:14.43,0:20:17.79,Default,,0,0,0,,Công thức ma pháp của chủng tộc\Nđược xem là khởi nguyên của ma pháp…
Dialogue: 0,0:20:18.42,0:20:19.70,Default,,0,0,0,,Cậu định làm gì?
Dialogue: 0,0:20:28.14,0:20:34.53,Default,,0,0,0,,Vốn dĩ thuật thức chỉ là kỹ thuật để con người\Ngia công mana và biến thành ma pháp.
Dialogue: 0,0:20:36.62,0:20:42.73,Default,,0,0,0,,Với cái thứ có mana chính là huyết mạch\Nthì chẳng cần đến thuật thức…
Dialogue: 0,0:20:44.27,0:20:47.56,Default,,0,0,0,,Chỉ cần cất tiếng là đủ mang đến diệt vong.
Dialogue: 0,0:20:48.94,0:20:50.19,Default,,0,0,0,,Đúng không nào?
Dialogue: 0,0:20:51.66,0:20:53.51,Default,,0,0,0,,Boromir Napolitan!
Dialogue: 0,0:21:13.72,0:21:14.79,Default,,0,0,0,,Thú vị lắm.
Dialogue: 0,0:21:16.41,0:21:19.36,Default,,0,0,0,,Hãy cho ta thấy đi, Desir Herrman!
Dialogue: 0,0:22:10.73,0:22:15.42,Default,,0,0,0,,♪Mỗi lần khẽ chạm♪
Dialogue: 0,0:22:16.80,0:22:22.24,Default,,0,0,0,,♪Vào lòng bàn tay người♪
Dialogue: 0,0:22:23.17,0:22:28.70,Default,,0,0,0,,♪Là một làn gió dịu dàng♪
Dialogue: 0,0:22:28.70,0:22:34.17,Default,,0,0,0,,♪Lướt qua trái tim♪
Dialogue: 0,0:22:35.55,0:22:39.14,Default,,0,0,0,,♪Những tâm tư đã lớn dần♪
Dialogue: 0,0:22:39.14,0:22:42.29,Default,,0,0,0,,♪Nơi sâu thẳm lồng ngực này♪
Dialogue: 0,0:22:42.29,0:22:47.42,Default,,0,0,0,,♪Muốn viết thành lời cũng chẳng đủ câu chữ♪
Dialogue: 0,0:22:48.00,0:22:54.18,Default,,0,0,0,,♪Một người bí ẩn khó dò như người♪
Dialogue: 0,0:22:54.18,0:23:00.24,Default,,0,0,0,,♪Tôi càng muốn biết về người nhiều hơn♪
Dialogue: 0,0:23:00.59,0:23:06.83,Default,,0,0,0,,♪Dẫu tương lai có mong manh nhường nào♪
Dialogue: 0,0:23:06.83,0:23:12.70,Default,,0,0,0,,♪Vẫn mơ một giấc mơ không có hồi kết♪
Dialogue: 0,0:23:12.70,0:23:19.08,Default,,0,0,0,,♪Chỉ mong tháng ngày yêu người mãnh liệt♪
Dialogue: 0,0:23:19.08,0:23:26.69,Default,,0,0,0,,♪Sẽ mãi mãi tiếp diễn không ngừng♪
Dialogue: 0,0:23:36.42,0:23:38.89,Default,,0,0,0,,Tập sau: Ngôn từ hủy diệt.

