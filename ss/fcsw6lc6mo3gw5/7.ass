Dialogue: 0,0:08:06.37,0:08:07.93,Default,Ansage,0,0,0,,Sawamura.
Dialogue: 0,0:08:10.72,0:08:14.26,Default,Ansage,0,0,0,,Batter 9, Pitcher, Sawamura.
Dialogue: 0,0:08:21.15,0:08:22.57,Default,Sawamura,0,0,0,,Los!
Dialogue: 0,0:08:28.44,0:08:29.52,Default,Sawamura,0,0,0,,Grüße!
Dialogue: 0,0:08:29.52,0:08:32.83,Default,Kommentator,0,0,0,,Seidō wechselt zu ihrem Ass!
Dialogue: 0,0:08:32.83,0:08:36.84,Default,Kommentator,0,0,0,,Für Satoru Furuya schicken sie\Nihr Ass Sawamura auf den Mound.
Dialogue: 0,0:08:37.64,0:08:40.04,Default,Kitsuzawa,0,0,0,,Echt jetzt? Jetzt schon?
Dialogue: 0,0:08:40.04,0:08:43.25,Default,Mei,0,0,0,,Das ist so unfair!\NHaust du etwa ab, Furuya?!
Dialogue: 0,0:08:43.25,0:08:48.47,Internal,Tadano,0,0,0,,Warf er von Anfang so hart,\Nweil sie den Wechsel geplant hatten?
Dialogue: 0,0:08:50.81,0:08:55.64,Default,Kommentator,0,0,0,,Im Halbfinale gegen Ichidai\Nließ er nur drei Hits zu.
Dialogue: 0,0:08:55.64,0:08:59.72,Default,Kommentator,0,0,0,,Er pitchte wundervoll, produzierte\Nnur einen Walk mit nur einem Run.
Dialogue: 0,0:08:59.72,0:09:03.12,Default,Kommentator,0,0,0,,Sie schicken im wichtigen Moment\Nihr Ass auf den Mound!
Dialogue: 0,0:09:03.61,0:09:05.90,Default,Seto,0,0,0,,Die rasten alle richtig aus.
Dialogue: 0,0:09:05.90,0:09:09.61,Default,Seto,0,0,0,,Die wissen alle, wie er\Ngegen Ichidai gepitcht hat!
Dialogue: 0,0:09:09.96,0:09:13.16,Default,Zuschauer A,0,0,0,,Furuya war so gut drauf\Nund er kommt raus.
Dialogue: 0,0:09:13.16,0:09:15.70,Default,Zuschauer B,0,0,0,,Er hatte aber auch einige Walks.
Dialogue: 0,0:09:15.96,0:09:18.43,Default,Zuschauer C,0,0,0,,Wollen sie einfach\Nden einen Run halten?
Dialogue: 0,0:09:18.43,0:09:20.91,Default,Zuschauer D,0,0,0,,Seidō hat ja auch noch Kawakami.
Dialogue: 0,0:09:20.91,0:09:24.13,Default,Zuschauer E,0,0,0,,Seidō haben die Initiative.
Dialogue: 0,0:09:24.13,0:09:28.03,Default,Carlos,0,0,0,,Furuya war heftig,\Naber der ist es auf eine andere Art.
Dialogue: 0,0:09:28.03,0:09:32.73,Default,Shirakawa,0,0,0,,Er ist jetzt ganz anders als letztes Jahr,\Nwo alles bei ihm um Momentum ging.
Dialogue: 0,0:09:32.73,0:09:36.10,Default,Yabe,0,0,0,,In den Trainingsspielen soll er\Nauch unangreifbar gewesen sein.
Dialogue: 0,0:09:36.10,0:09:40.09,Default,Carlos,0,0,0,,Dachte eigentlich, Furuya wäre außer Form\Nund deshalb nicht mehr das Ass.
Dialogue: 0,0:09:40.09,0:09:42.56,Default,Carlos,0,0,0,,Aber hab ja gesehen,\Nwie er gegen Amahisa antrat.
Dialogue: 0,0:09:42.56,0:09:45.06,Default,Shirakawa,0,0,0,,Er ist sicher gut drauf.
Dialogue: 0,0:09:45.61,0:09:49.48,Internal,Mei,0,0,0,,Bist du jetzt richtig gut,\Noder nicht?
Dialogue: 0,0:09:50.61,0:09:52.41,Internal,Mei,0,0,0,,Was bist du?
Dialogue: 0,0:09:53.44,0:09:54.65,Internal,Mei,0,0,0,,Was?
Dialogue: 0,0:09:57.22,0:10:01.50,Internal,Mei,0,0,0,,Kannst du hier im Spiel mithalten,\Nwenn du zwischendurch reinkommst?
Dialogue: 0,0:10:02.37,0:10:06.43,Default,Miyuki,0,0,0,,Hast du gehört, wie alle ausgerastet sind,\Nals du rauskamst?
Dialogue: 0,0:10:06.43,0:10:08.27,Default,Sawamura,0,0,0,,Ich bin auch total überrascht.
Dialogue: 0,0:10:08.27,0:10:09.46,Default,Miyuki,0,0,0,,Du bist echt beliebt.
Dialogue: 0,0:10:09.46,0:10:12.89,Default,Sawamura,0,0,0,,Nein, nein, nein, nein, nein!\NMeinst du?
Dialogue: 0,0:10:12.89,0:10:15.67,Default,Miyuki,0,0,0,,Es beginnt mit Batter 8.\NDu weißt Bescheid, oder?
Dialogue: 0,0:10:15.67,0:10:17.43,Default,Sawamura,0,0,0,,Ja. Kein Problem.
Dialogue: 0,0:10:17.43,0:10:19.36,Default,Miyuki,0,0,0,,Mach es, Ass!
Dialogue: 0,0:10:19.36,0:10:20.14,Default,Sawamura,0,0,0,,Ja!
Dialogue: 0,0:10:20.47,0:10:23.60,Internal,Miyuki,0,0,0,,Schauen wir mal,\Nwie er so pitcht.
Dialogue: 0,0:10:24.81,0:10:26.02,Internal,Sawamura,0,0,0,,Ass!
Dialogue: 0,0:10:26.56,0:10:28.76,Default,Sawamura,0,0,0,,Noch drei Innings!
Dialogue: 0,0:10:30.82,0:10:33.20,Default,Sawamura,0,0,0,,Jetzt geht es um die Wurst!
Dialogue: 0,0:10:33.65,0:10:36.53,Default,Sawamura,0,0,0,,Wir von Seidō halten stets durch!
Dialogue: 0,0:10:36.53,0:10:37.91,Default,Sawamura,0,0,0,,Wir latschen durch Dreck!
Dialogue: 0,0:10:38.33,0:10:41.29,Default,Sawamura,0,0,0,,Wir haben immer\Nbis zum Schluss gekämpft!
Dialogue: 0,0:10:42.97,0:10:45.21,Default,Sawamura,0,0,0,,Die Bälle werden\Nnur so geflogen kommen!
Dialogue: 0,0:10:45.65,0:10:49.17,Default,Sawamura,0,0,0,,Ich zähle auf euch, Verteidiger!
Dialogue: 0,0:10:49.17,0:10:51.63,Default,Zono,0,0,0,,Sauber! Das war gut!
Dialogue: 0,0:10:51.63,0:10:53.59,Default,Zono,0,0,0,,Gesprochen wie ein wahres Ass!
Dialogue: 0,0:10:55.55,0:10:57.81,Default,Kominato,0,0,0,,Mach es, Eijun!
Dialogue: 0,0:10:57.81,0:10:59.84,Default,Kuramochi,0,0,0,,Mach es, Sawamura!
Dialogue: 0,0:11:05.98,0:11:09.48,TypePlaceholder,,0,0,0,,{\fnTahoma\c&HDFDFDF&\an2\bord1.5\3c&H2E2817&\fs13\move(197,95,212,105)\t(,\fscx87\fscy87)}Seidō
