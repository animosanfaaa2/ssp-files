Dialogue: 0,0:02:47.75,0:02:52.59,On Top,,0,0,0,,THE GOD OF DESTRUCTION\NHEADS TO THE PLANET OF THE KAI
Dialogue: 0,0:22:16.04,0:22:17.50,Default,,0,0,0,,{\i1}The face of a winner{\i}
Dialogue: 0,0:22:17.67,0:22:19.34,Default,,0,0,0,,{\i1}Still hanging on, at the limit{\i}
Dialogue: 0,0:22:19.51,0:22:21.38,Default,,0,0,0,,{\i1}The paper dancing in the air\Nflashes brilliantly{\i}
Dialogue: 0,0:22:21.55,0:22:24.05,Default,,0,0,0,,{\i1}I piled up many failures along the way{\i}
Dialogue: 0,0:22:24.22,0:22:25.14,Default,,0,0,0,,{\i1}That's right{\i}
Dialogue: 0,0:22:25.30,0:22:27.05,Default,,0,0,0,,{\i1}Standing tall, on my toes{\i}
Dialogue: 0,0:22:27.22,0:22:31.10,Default,,0,0,0,,{\i1}The view matters more than a sprain{\i}
Dialogue: 0,0:22:31.27,0:22:34.81,Default,,0,0,0,,{\i1}Did you think sorrow could defeat me?{\i}
Dialogue: 0,0:22:34.98,0:22:39.15,Default,,0,0,0,,{\i1}I eat that up, three meals a day{\i}
Dialogue: 0,0:22:39.32,0:22:41.24,Default,,0,0,0,,{\i1}A strong wind surges again{\i}
Dialogue: 0,0:22:41.40,0:22:43.07,Default,,0,0,0,,{\i1}Many troubles come my way{\i}
Dialogue: 0,0:22:43.24,0:22:46.03,Default,,0,0,0,,{\i1}Time to focus{\i}
Dialogue: 0,0:22:46.32,0:22:48.16,Default,,0,0,0,,{\i1}I swear\NI have high hopes{\i}
Dialogue: 0,0:22:48.33,0:22:51.08,Default,,0,0,0,,{\i1}I'll be complete in the near future{\i}
Dialogue: 0,0:22:51.25,0:22:53.08,Default,,0,0,0,,{\i1}A presence growing day by day by day{\i}
Dialogue: 0,0:22:53.25,0:22:54.62,Default,,0,0,0,,{\i1}That's the proof{\i}
Dialogue: 0,0:22:54.79,0:22:58.84,Default,,0,0,0,,{\i1}My life will make sparks fly{\i}
Dialogue: 0,0:22:59.00,0:23:01.46,Default,,0,0,0,,{\i1}There's nothing I can't do{\i}
