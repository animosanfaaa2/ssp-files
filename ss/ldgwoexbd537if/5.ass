Dialogue: 0,0:00:29.14,0:00:30.24,Default,RUCHE,0,0,0,,ماذا؟
Dialogue: 0,0:00:30.93,0:00:32.88,Default,RUCHE,0,0,0,,.الباب مفتوح -
Dialogue: 0,0:00:32.05,0:00:35.26,Default,HILDE,0,0,0,,.لا تفهم أيها العجوز -
Dialogue: 0,0:00:35.26,0:00:37.66,Default,HILDE,0,0,0,,.لا أطلب منك منحي أيّ شيء
Dialogue: 0,0:00:37.66,0:00:40.23,Default,HILDE,0,0,0,,.أطلب منك أن تبيعني ذلك السيف
Dialogue: 0,0:00:40.23,0:00:42.84,Default,VERUGA,0,0,0,,.ليس لديّ أسلحة للبيع
Dialogue: 0,0:00:42.84,0:00:45.23,Default,VERUGA,0,0,0,,.كما أن أحدهم طلب منّي صنعه
Dialogue: 0,0:00:42.34,0:00:43.88,top,ELYMAS,0,0,0,,.يبدو هذا سيئًا
Dialogue: 0,0:00:43.88,0:00:44.71,top,RUCHE,0,0,0,,.أجل
Dialogue: 0,0:00:46.21,0:00:47.53,Default,ELYMAS,0,0,0,,هل أنت بخير أيها العمّ؟
Dialogue: 0,0:00:47.53,0:00:50.22,Default,VERUGA,0,0,0,,.يكفي هذا يا سيّافة السحر
Dialogue: 0,0:00:50.22,0:00:53.07,Default,HILDE,0,0,0,,هل أنت هو الزبون؟
Dialogue: 0,0:00:56.51,0:00:58.76,Default,HILDE,0,0,0,,.كنتُ أتساءل من يكون الزبون
Dialogue: 0,0:00:58.76,0:01:04.12,Default,HILDE,0,0,0,,أيها العجوز، صنعتَ سيف ميثريل\Nلهذا الرجل الذي يبدو ضعيف الهيئة؟
Dialogue: 0,0:01:01.54,0:01:04.12,top,ELYMAS/ID,0,0,0,,.أستطيع سماعها لكنّي لا أراها
Dialogue: 0,0:01:04.12,0:01:07.55,Default,HILDE,0,0,0,,هل كنت بحاجة للمال إلى هذا الحد يا فيروغا؟
Dialogue: 0,0:01:07.55,0:01:08.55,Default,ELYMAS/ID,0,0,0,,هل تستخدم مهارة ما؟
Dialogue: 0,0:01:08.55,0:01:10.77,Default,RUCHE,0,0,0,,!بالأسفل يا إليما-سان
Dialogue: 0,0:01:11.18,0:01:12.57,Default,RUCHE,0,0,0,,!بالأسفل
Dialogue: 0,0:01:18.03,0:01:22.48,Default,HILDE,0,0,0,,أيها الوغد. هل تسخر منّي؟
Dialogue: 0,0:01:22.48,0:01:25.82,Default,ELYMAS,0,0,0,,ما بال هذه الطفلة؟
Dialogue: 0,0:02:58.16,0:03:02.62,sign_generic,EPTITLE; sign,0,0,0,,{\b1\an7\bord1\shad1.25\fade(820,482)\alphaalphaH&0&\3c&H000000&\c&HFEFCFD&\4c&H000000&\fs18\pos(333.002,289.564)}الحلقة 20: سيّافة السحر هيلدي
Dialogue: 0,0:02:58.66,0:03:03.12,top,HILDE,0,0,0,,أيها الوغد. هل تسخر منّي؟
Dialogue: 0,0:03:03.12,0:03:05.37,Default,HILDE,0,0,0,,.إن كان لديك ما تقوله فأخبرني
Dialogue: 0,0:03:05.84,0:03:09.30,Default,ELYMAS,0,0,0,,.طفلة؟ لا، لديها فئة
Dialogue: 0,0:03:09.30,0:03:11.55,Default,ELYMAS,0,0,0,,،إن كانت قد خضعت للطقس\Nفهل عمرها 15 عامًا؟
Dialogue: 0,0:03:11.55,0:03:13.10,Default,HILDE,0,0,0,,.عمري 17 عامًا
Dialogue: 0,0:03:14.10,0:03:15.75,Default,ELYMAS/ID,0,0,0,,.هي أكبر منّي؟ مستحيل
Dialogue: 0,0:03:15.75,0:03:18.22,Default,HILDE,0,0,0,,.لا يبدو أنك منبهر بي
Dialogue: 0,0:03:18.53,0:03:24.23,Default,HILDE,0,0,0,,هل سمعت من قبل بسيّاف السحر\Nالملقّب بـ"نصل اللهب المسودّ"؟
Dialogue: 0,0:03:27.17,0:03:30.73,Default,ELYMAS/ID,0,0,0,,سمعتُ هذا اللقب بينما كنتُ\N.أجمع المعلومات في لاكورينا
Dialogue: 0,0:03:31.26,0:03:32.72,Default,ELYMAS/ID,0,0,0,,.نصل اللهب المسودّ
Dialogue: 0,0:03:33.17,0:03:38.70,Default,ELYMAS/ID,0,0,0,,هو أحد المغامرين القلّة\N.من الرتبة "ايه" في لاكورينا
Dialogue: 0,0:03:42.39,0:03:48.87,Default,HILDE,0,0,0,,…في الواقع، أنا تلميذة المغامر الشهير
Dialogue: 0,0:03:51.12,0:03:54.00,Default,HILDE,0,0,0,,!نصل اللهب المسودّ
Dialogue: 0,0:03:58.63,0:04:02.22,Default,ELYMAS,0,0,0,,.فهمت. هذا مبهر حقًا
Dialogue: 0,0:04:03.18,0:04:06.38,Default,HILDE,0,0,0,,سنحسم الأمر بسرعة الآن بعد ظهور\N.صاحب السيف
Dialogue: 0,0:04:06.38,0:04:09.76,Default,HILDE,0,0,0,,أنا متأكدة أن الحديث معك\N.سيكون أسهل من الحديث مع العجوز العنيد
Dialogue: 0,0:04:10.78,0:04:13.47,Default,HILDE,0,0,0,,.أحاول قول أمر واحد فقط
Dialogue: 0,0:04:13.83,0:04:16.07,Default,HILDE,0,0,0,,.بعني سيف الميثريل
Dialogue: 0,0:04:16.38,0:04:20.86,Default,ELYMAS,0,0,0,,لا. لقد استأجرته ليصنعه لي\N.لأنّي بحاجته
Dialogue: 0,0:04:20.86,0:04:23.49,Default,HILDE,0,0,0,,.اهدأ أيها الفارس المدرّع
Dialogue: 0,0:04:23.49,0:04:29.24,Default,HILDE,0,0,0,,لا جدوى من استخدام فئة معيبة\N.مثل فئتك لذلك السيف
Dialogue: 0,0:04:29.24,0:04:32.10,Default,HILDE,0,0,0,,ما الذي تعتقد أن بوسعك\Nفعله بسيف فاخر؟
Dialogue: 0,0:04:32.10,0:04:34.50,Default,HILDE,0,0,0,,.أنت لا تفهم كيف يسير هذا العالم
Dialogue: 0,0:04:34.78,0:04:37.65,Default,HILDE,0,0,0,,.لا أطلب منك بيعه بثمن بخس
Dialogue: 0,0:04:37.65,0:04:40.51,Default,HILDE,0,0,0,,.أعتقد أن 30 مليون قطعة ذهبية مبلغ كافٍ
Dialogue: 0,0:04:40.84,0:04:44.10,Default,HILDE,0,0,0,,.يفوق هذا المبلغ ما تستطيع تخيّله على الأرجح
Dialogue: 0,0:04:44.10,0:04:45.51,Default,ELYMAS,0,0,0,,.أخبرتك أنّي أرفض بيعه
Dialogue: 0,0:04:45.89,0:04:48.52,Default,ELYMAS,0,0,0,,.مبلغ 30 مليون غير كافٍ
Dialogue: 0,0:04:49.57,0:04:55.78,Default,VERUGA,0,0,0,,أيها الفتى. قد تبدو تلك الطفلة شقية\N.لكنها قوتها حقيقية
Dialogue: 0,0:04:55.78,0:04:57.03,Default,HILDE,0,0,0,,ماذا قلت أيها العجوز؟
Dialogue: 0,0:04:57.34,0:05:02.01,Default,VERUGA,0,0,0,,هي من الرتبة "بي" وتحمل\N.الرقم القياسي في قتل أسياد الأحلام منفردة
Dialogue: 0,0:05:03.11,0:05:04.53,Default,HILDE,0,0,0,,.هذا صحيح
Dialogue: 0,0:05:05.11,0:05:09.48,Default,VERUGA,0,0,0,,لكن شخصيتها سيئة لذا من الأفضل\N.ألا تستفزها
Dialogue: 0,0:05:09.48,0:05:10.50,Default,HILDE,0,0,0,,!ويحك
Dialogue: 0,0:05:10.79,0:05:16.38,Default,ELYMAS,0,0,0,,اعتقدتُ أنك رفضت العمل لديها\N.لأنك تكره أمثالها
Dialogue: 0,0:05:16.69,0:05:18.95,Default,ELYMAS,0,0,0,,.لا تروقني أيضًا
Dialogue: 0,0:05:18.95,0:05:20.47,Default,ELYMAS,0,0,0,,.لا نيّة لي في التفاوض
Dialogue: 0,0:05:20.47,0:05:21.38,Default,HILDE,0,0,0,,!ويحك
Dialogue: 0,0:05:21.38,0:05:26.48,Default,VERUGA,0,0,0,,.أنا مستعد للعواقب، لكنكما لا تزالان يافعين
Dialogue: 0,0:05:26.48,0:05:29.82,Default,VERUGA,0,0,0,,لا تكسبا عداوة أعداء مزعجين\N.في النقابة دون سبب وجيه
Dialogue: 0,0:05:29.82,0:05:32.14,Default,VERUGA,0,0,0,,.دعاني أتولى هذا
Dialogue: 0,0:05:32.14,0:05:33.90,Default,ELYMAS/ID,0,0,0,,.أعتقد أنه رقيق القلب
Dialogue: 0,0:05:34.20,0:05:36.02,Default,ELYMAS,0,0,0,,.لا تقلق علينا
Dialogue: 0,0:05:36.02,0:05:37.88,Default,ELYMAS,0,0,0,,.نحن مغامرين
Dialogue: 0,0:05:37.88,0:05:41.28,Default,ELYMAS,0,0,0,,سنذهب إلى مدينة أخرى فحسب\N.إن دعى الأمر لذلك
Dialogue: 0,0:05:42.52,0:05:45.49,Default,ELYMAS,0,0,0,,.ولا أعتقد أنّي أضعف منها
Dialogue: 0,0:06:02.52,0:06:05.22,Default,HILDE,0,0,0,,.لديك ردود فعل جيدة
Dialogue: 0,0:06:05.22,0:06:07.90,Default,HILDE,0,0,0,,.لكن خصائصك سيئة
Dialogue: 0,0:06:07.90,0:06:10.34,Default,HILDE,0,0,0,,.مثل حدود الفارس المدرّع
Dialogue: 0,0:06:10.34,0:06:15.41,Default,HILDE,0,0,0,,أنت محظوظ. لو استمدّ بي الغضب\N.أكثر من هذا لقتلتك
Dialogue: 0,0:06:15.41,0:06:18.48,Default,HILDE,0,0,0,,حمل سلاح يتجاوز قدراتك\N.لن ينقذك من الموت
Dialogue: 0,0:06:19.29,0:06:21.99,Default,HILDE,0,0,0,,.هيّا بعني السيف
Dialogue: 0,0:06:21.99,0:06:24.80,Default,RUCHE,0,0,0,,هل أنت بخير يا إليما-سان؟
Dialogue: 0,0:06:24.80,0:06:28.62,Default,RUCHE,0,0,0,,فيما تفكرين؟
Dialogue: 0,0:06:28.62,0:06:32.25,Default,HILDE,0,0,0,,.أظهرتُ له مدى ضعفه فحسب
Dialogue: 0,0:06:32.61,0:06:36.38,Default,ELYMAS,0,0,0,,مهاجمتي على حين غرّة\N.ليس دليلًا على أنك أقوى منّي
Dialogue: 0,0:06:36.38,0:06:37.08,Default,HILDE,0,0,0,,ماذا؟
Dialogue: 0,0:06:37.40,0:06:40.56,Default,HILDE,0,0,0,,ماذا إذًا؟ أتريد خوض نزال؟
Dialogue: 0,0:06:40.56,0:06:45.13,Default,HILDE,0,0,0,,إن كنتَ ستراهن بسيف الميثريل\N.فسأقبل تحديك
Dialogue: 0,0:06:45.13,0:06:47.09,Default,ELYMAS,0,0,0,,بماذا ستراهنين؟
Dialogue: 0,0:06:47.77,0:06:50.60,Default,HILDE,0,0,0,,،ليس كأنّي سأخسر
Dialogue: 0,0:06:50.88,0:06:54.98,Default,HILDE,0,0,0,,لكن سأتخلى عن السيف\N.وسأدفع لك قيمته السوقية
Dialogue: 0,0:06:55.28,0:06:59.11,Default,HILDE,0,0,0,,ما رأيك؟\N.لم يعد هناك ما يدعوك للهرب
Dialogue: 0,0:06:59.11,0:07:01.50,Default,VERUGA,0,0,0,,.لا تقبل عرضها أيها الفتى
Dialogue: 0,0:07:01.50,0:07:04.86,Default,VERUGA,0,0,0,,.سيّافو السحر ماهرون في القتال المنفرد
Dialogue: 0,0:07:04.86,0:07:09.07,Default,VERUGA,0,0,0,,.لن تكون مواجهتها منصفة
Dialogue: 0,0:07:10.63,0:07:14.87,Default,ELYMAS,0,0,0,,تقبلين هذه الشروط؟\N.سأقبل بسرور إذًا
Dialogue: 0,0:07:17.29,0:07:19.91,Default,RUCHE,0,0,0,,.هذه فكرة سيئة
Dialogue: 0,0:07:19.91,0:07:22.30,Default,RUCHE,0,0,0,,."إنها سيّافة من الرتبة "بي
Dialogue: 0,0:07:22.30,0:07:26.30,Default,RUCHE,0,0,0,,.أعرف أنا أيضًا أنها نزالات غير متوازنة
Dialogue: 0,0:07:26.61,0:07:31.19,Default,ELYMAS,0,0,0,,،خططتُ للتعامل مع الأمر بذكاء أكبر\N.لكن الغضب قد استمدّ بي
Dialogue: 0,0:07:31.19,0:07:32.31,Default,RUCHE,0,0,0,,إليما-سان؟
Dialogue: 0,0:07:32.31,0:07:35.90,Default,ELYMAS,0,0,0,,.لن أدع 30 مليونًا سهلة تفلت
Dialogue: 0,0:07:35.90,0:07:38.56,Default,ELYMAS,0,0,0,,.أعتقد أنّي سألقنك درسًا يا هيلدي
Dialogue: 0,0:07:38.56,0:07:41.09,Default,HILDE,0,0,0,,.من حسن حظّي أنك غبيّ
Dialogue: 0,0:07:41.09,0:07:45.84,Default,HILDE,0,0,0,,سأستدعي أحد موظفي النقابة لمراقبة\N.نزالنا كي لا تتملّص منه
Dialogue: 0,0:07:45.84,0:07:47.57,Default,HILDE,0,0,0,,.من الأفضل ألا تندم على هذا
Dialogue: 0,0:08:02.57,0:08:05.49,Default,ELYMAS/ID,0,0,0,,.يفترض أن تعود هيلدي قريبًا
Dialogue: 0,0:08:08.55,0:08:10.02,Default,ELYMAS,0,0,0,,!لايف شيلد
Dialogue: 0,0:08:08.97,0:08:10.47,sign_generic,SIGN,0,0,0,,{\fade(685,1)\c&H68E7FE&\bord1\blur0.5\3c&H6B5176&\b1\an8\pos(470.8,189.2)}يكلّف تفعيله 20 بالمائة من نقاط الحياة\Nيُحيط المستخدم بدرع تساوي قوته تكلفة نقاط الحياة
Dialogue: 0,0:08:13.99,0:08:17.98,Default,VERUGA,0,0,0,,ماذا تفعل أيها الفتى؟
Dialogue: 0,0:08:17.98,0:08:22.48,Default,VERUGA,0,0,0,,ما المغزى من تفعيل مهارته وإلغائها؟
Dialogue: 0,0:08:22.78,0:08:24.26,Default,VERUGA,0,0,0,,.لا أفهم
Dialogue: 0,0:08:24.73,0:08:26.31,Default,ELYMAS,0,0,0,,.أدير نقاط حياتي
Dialogue: 0,0:08:26.31,0:08:27.99,Default,VERUGA,0,0,0,,.لا أفهم هذا أيضًا
Dialogue: 0,0:08:28.42,0:08:30.99,Default,RUCHE,0,0,0,,هل تستطيع التغلّب عليها يا إليما-سان؟
Dialogue: 0,0:08:31.24,0:08:35.16,Default,RUCHE,0,0,0,,"هل تعتمد على "نظرة غضب التنين القاتلة\Nللانتصار في هذا النزال؟
Dialogue: 0,0:08:36.25,0:08:40.46,Default,RUCHE,0,0,0,,.لا أعتقد أن مهارة "لا دفاع يُدّخر" ستفيدك
Dialogue: 0,0:08:40.46,0:08:41.50,Default,ELYMAS,0,0,0,,.أنت محقة
Dialogue: 0,0:08:43.07,0:08:45.04,Default,ELYMAS,0,0,0,,!"لا دفاع يُدّخر"
Dialogue: 0,0:08:57.52,0:09:03.08,Default,ELYMAS,0,0,0,,مضاعفة الهجوم ستّ مرات\N.لا تستحقّ الضرر الإضافي الذي سأتلقّاه
Dialogue: 0,0:09:03.74,0:09:08.00,Default,ELYMAS,0,0,0,,تخفيض دفاعي إلى الصفر\Nفي مواجهة خصم يُهاجم من بعيد
Dialogue: 0,0:09:08.00,0:09:10.15,Default,ELYMAS,0,0,0,,.سيعرضني للقتل
Dialogue: 0,0:09:07.15,0:09:11.03,sign_generic,SIGN,0,0,0,,{\b1\blur1\fade(855,1)\c&HFCF5D7&\3c&HF1DF69&\pos(315.2,210)}الدفاع 0
Dialogue: 0,0:09:11.52,0:09:15.03,Default,ELYMAS,0,0,0,,مواجهة سيّاف السحر أصعب\N.من مواجهة سيد السيف
Dialogue: 0,0:09:15.57,0:09:18.04,Default,ELYMAS,0,0,0,,،بالإضافة إلى اندفاعات القوة ومهارات السيف
Dialogue: 0,0:09:18.39,0:09:21.43,Default,ELYMAS,0,0,0,,.فهو يملك هجمات سحرية عملية بعيدة المدى
Dialogue: 0,0:09:24.54,0:09:28.06,Default,VERUGA,0,0,0,,.لم يفت الأوان على الفرار
Dialogue: 0,0:09:28.06,0:09:29.70,Default,ELYMAS,0,0,0,,.هناك طريقة للفوز بالطبع
Dialogue: 0,0:09:30.50,0:09:33.40,Default,ELYMAS,0,0,0,,،لا أستسيغ هذا القدر من الخبث
Dialogue: 0,0:09:33.40,0:09:36.05,Default,ELYMAS,0,0,0,,.لكن لسيّاف السحر طريقة متحيّزة في التفكير
Dialogue: 0,0:09:36.05,0:09:39.31,Default,RUCHE,0,0,0,,.يا لها من ابتسامة شريرة
Dialogue: 0,0:09:43.02,0:09:45.61,Default,HILDE,0,0,0,,!أحضرتُ شخصًا ما أيها الفارس المدرّع
Dialogue: 0,0:09:46.43,0:09:49.15,Default,HILDE,0,0,0,,!يُحسن ألا تكون قد لمست سيفي
Dialogue: 0,0:09:50.49,0:09:53.91,Default,MATILDA,0,0,0,,."جُلبتُ إلى هنا بسبب "فارس مدرّع وقح
Dialogue: 0,0:09:53.91,0:09:58.50,Default,MATILDA,0,0,0,,هذان أنتما كما توقعت\N.يا إليما-سان وروتشي-سان
Dialogue: 0,0:10:08.25,0:10:10.93,Default,HILDE,0,0,0,,.لنبدأ أيها الفارس المدرّع
Dialogue: 0,0:10:13.43,0:10:15.92,Default,ELYMAS/ID,0,0,0,,.سيّافة سحر ضد فارس مدرّع
Dialogue: 0,0:10:16.69,0:10:19.14,Default,ELYMAS/ID,0,0,0,,.هي أسوء خصم أواجهه في نزال
Dialogue: 0,0:10:19.14,0:10:22.06,Default,ELYMAS/ID,0,0,0,,.ستضرب نقاط حياتي من بعيد بتعاويذها
Dialogue: 0,0:10:22.06,0:10:24.63,Default,ELYMAS/ID,0,0,0,,.وإن اقتربت، ستهزمني بمهارات السيف
Dialogue: 0,0:10:26.42,0:10:30.36,Default,ELYMAS/ID,0,0,0,,.لكن سيّاف السحر يملك طريقة متحيّزة في التفكير
Dialogue: 0,0:10:30.92,0:10:34.66,Default,ELYMAS/ID,0,0,0,,.ولا شك أنّ الأمر أسوء في حالة هيلدي
Dialogue: 0,0:10:47.71,0:10:51.67,Default,ELYMAS,0,0,0,,.أريد التأكد من أمر ما قبل أن أبدأ أيتها الشاهدة
Dialogue: 0,0:10:51.67,0:10:53.65,Default,MATILDA,0,0,0,,ما هو يا إليما-سان؟
Dialogue: 0,0:10:53.65,0:10:57.05,Default,ELYMAS,0,0,0,,،بما أننا نقاتل بالمهارات\N.فقد يحدث الأسوء
Dialogue: 0,0:10:57.74,0:11:00.51,Default,ELYMAS,0,0,0,,ماذا لو أصبنا أو قتلنا الخصم؟
Dialogue: 0,0:11:01.39,0:11:06.20,Default,MATILDA,0,0,0,,.كنت تُدرك المخاطر عندما قبلتَ النزال
Dialogue: 0,0:11:06.20,0:11:09.77,Default,MATILDA,0,0,0,,.هذه هي قناعتنا عندما نلعب دور الشهود
Dialogue: 0,0:11:09.77,0:11:12.54,Default,MATILDA,0,0,0,,هل نُلغي النزال إن كنتَ قلقًا؟
Dialogue: 0,0:11:12.54,0:11:15.41,Default,ELYMAS,0,0,0,,.لا، من الجيد أنكِ أكدت لي الأمر
Dialogue: 0,0:11:15.41,0:11:17.66,Default,ELYMAS,0,0,0,,.لنبدأ يا هيلدي
Dialogue: 0,0:11:18.87,0:11:21.20,Default,HILDE,0,0,0,,هل تحاول استفزازي؟
Dialogue: 0,0:11:21.20,0:11:23.50,Default,HILDE,0,0,0,,.أوافق على ذلك أيضًا
Dialogue: 0,0:11:28.21,0:11:30.13,Default,ELYMAS/ID,0,0,0,,.تفصل بيننا مسافة كبيرة
Dialogue: 0,0:11:30.13,0:11:32.88,Default,ELYMAS/ID,0,0,0,,.هذا منطقيّ بما أنها من فئة تُلقي التعاويذ
Dialogue: 0,0:11:35.87,0:11:38.39,Default,MATILDA,0,0,0,,!ابدآ
Dialogue: 0,0:11:43.13,0:11:44.65,Default,ELYMAS,0,0,0,,!لايف شيلد
Dialogue: 0,0:12:23.55,0:12:26.14,Default,HILDE,0,0,0,,.ما هذا؟ هذه مهارة غريبة
Dialogue: 0,0:12:42.28,0:12:47.30,Default,RUCHE,0,0,0,,قلتَ أن هذه المهارة خطيرة جدًا\N!ولا يجب استخدامها في نزال
Dialogue: 0,0:12:48.12,0:12:50.17,sign_generic,SIGN,0,0,0,,{\pos(448,347.6)\b1\bord1.5\fade(650,1)\blur0.5\c&H857F9D&\3c&HDDEAFD&}لا دفاع يُدّخر: تُستخدم عندما تكون نقاط الحياة أقل من 50 بالمائة\Nتخفض الدفاع إلى صفر وتعزز الهجوم بالدفاع المفقود\Nتستهلك نقاط المانا وهي مفعّلة
Dialogue: 0,0:12:51.15,0:12:53.08,Default,HILDE/ID,0,0,0,,.مهارة غامضة أخرى
Dialogue: 0,0:12:53.41,0:12:56.56,Default,HILDE/ID,0,0,0,,.بالإضافة إلى ردّ فعل تلك الفتاة
Dialogue: 0,0:12:57.88,0:12:59.05,Default,HILDE/ID,0,0,0,,…لوقت الراهن
Dialogue: 0,0:13:15.23,0:13:17.32,Default,HILDE/ID,0,0,0,,.سأراقبه من بعيد
Dialogue: 0,0:13:57.22,0:14:00.21,Default,ELYMAS,0,0,0,,.حسنًا، ليس سيئًا
Dialogue: 0,0:14:04.67,0:14:06.30,Default,HILDE,0,0,0,,!مهلًا، مهلًا، مهلًا
Dialogue: 0,0:14:06.30,0:14:08.84,Default,HILDE,0,0,0,,!انتظر! أوقف النزال
Dialogue: 0,0:14:09.29,0:14:10.62,Default,HILDE,0,0,0,,!توقف
Dialogue: 0,0:14:10.94,0:14:11.87,Default,HILDE,0,0,0,,!توقف
Dialogue: 0,0:14:11.87,0:14:13.95,Default,HILDE,0,0,0,,!أسقطتُ سلاحي
Dialogue: 0,0:14:13.95,0:14:15.33,Default,HILDE,0,0,0,,ألا تستطيع سماعي؟
Dialogue: 0,0:14:15.33,0:14:16.88,Default,HILDE,0,0,0,,!توقف، توقف
Dialogue: 0,0:14:17.46,0:14:19.39,Default,HILDE,0,0,0,,!أنا جادة، توقف
Dialogue: 0,0:14:20.16,0:14:23.38,Default,HILDE,0,0,0,,!أستسلم! أستسلم
Dialogue: 0,0:14:23.38,0:14:26.39,Default,HILDE,0,0,0,,أعترف بالهزيمة! لقد هُزمت، حسنًا؟
Dialogue: 0,0:14:27.23,0:14:31.96,Default,ELYMAS/ID,0,0,0,,.يميل سيّافو السحر إلى توخي الحذر
Dialogue: 0,0:14:32.82,0:14:38.43,Default,ELYMAS/ID,0,0,0,,يمتلكون قوة هجومية عالية\N،على حساب قوة تحمّلهم
Dialogue: 0,0:14:38.88,0:14:42.90,Default,ELYMAS/ID,0,0,0,,لذلك قد يفقد سيّافو السحر حياتهم بسهولة\N.إن استمرّ القتال طويلًا
Dialogue: 0,0:14:42.90,0:14:47.41,Default,ELYMAS/ID,0,0,0,,كنتُ متأكدًا من أنها ستستلم\N.إن واصلت تهديدها
Dialogue: 0,0:14:48.71,0:14:50.63,Default,ELYMAS,0,0,0,,.أعلني عن المنتصر
Dialogue: 0,0:14:50.63,0:14:51.91,Default,MATILDA,0,0,0,,.حسنًا
Dialogue: 0,0:14:52.22,0:14:55.10,Default,MATILDA,0,0,0,,!المنتصر هو إليما-سان
Dialogue: 0,0:14:58.18,0:15:00.48,Default,HILDE,0,0,0,,!كفاك هراءً
Dialogue: 0,0:15:00.48,0:15:02.67,Default,HILDE,0,0,0,,!طلبتُ منك التوقف فحسب
Dialogue: 0,0:15:03.01,0:15:07.26,Default,HILDE,0,0,0,,!قلت أستسلم لأنك أبيت التوقف
Dialogue: 0,0:15:07.26,0:15:09.22,Default,ELYMAS,0,0,0,,.قلتها على أيّ حال
Dialogue: 0,0:15:09.54,0:15:16.24,Default,MATILDA,0,0,0,,هيلدي-سان، لا تعترف النقابة بالتراجع
Dialogue: 0,0:15:16.24,0:15:21.23,Default,MATILDA,0,0,0,,بعد اعتبارك مهارات الخصم\N.سببًا يدعو لإيقاف النزال
Dialogue: 0,0:15:21.60,0:15:23.86,Default,MATILDA,0,0,0,,،بما أنّي استُدعيت لأكون شاهدة
Dialogue: 0,0:15:23.86,0:15:28.76,Default,MATILDA,0,0,0,,ستُتخذ الإجراءات الملائمة في حقك\N.إن لم تتبعي القوانين
Dialogue: 0,0:15:28.76,0:15:31.66,Default,HILDE,0,0,0,,.أعلم هذا
Dialogue: 0,0:15:31.66,0:15:36.33,Default,HILDE,0,0,0,,.لستُ بخيلة\N.لن أخلف بالاتفاق
Dialogue: 0,0:15:36.66,0:15:40.50,Default,HILDE,0,0,0,,.أنصت يا إليما\N.طلبتُ منك التوقف
Dialogue: 0,0:15:40.82,0:15:45.51,Default,HILDE,0,0,0,,بالنظر إلى ذلك، ما رأيك في 20 مليون؟
Dialogue: 0,0:15:47.77,0:15:50.26,Default,HILDE,0,0,0,,.مبلغ 30 مليون مبالغ فيه
Dialogue: 0,0:15:50.72,0:15:51.76,Default,ELYMAS,0,0,0,,.لا
Dialogue: 0,0:15:51.76,0:15:55.39,Default,RUCHE,0,0,0,,.إنه ثمن بخس\N.لكنّي أتفهّم ذلك
Dialogue: 0,0:15:55.66,0:16:00.40,Default,HILDE,0,0,0,,.أردتُ سلاحًا مناسبًا لمستواي فحسب
Dialogue: 0,0:16:00.76,0:16:03.05,Default,HILDE,0,0,0,,نموّ مغامرة من مستوى عالٍ
Dialogue: 0,0:16:03.05,0:16:07.15,Default,HILDE,0,0,0,,.يحفظ أمان المدينة ويخفظ ضرر الوحوش
Dialogue: 0,0:16:07.15,0:16:10.28,Default,HILDE,0,0,0,,.أعترف أن أساليبي خاطئة
Dialogue: 0,0:16:10.28,0:16:12.99,Default,HILDE,0,0,0,,.لن أفعل شيئًا كهذا مجددًا
Dialogue: 0,0:16:13.34,0:16:14.64,Default,ELYMAS,0,0,0,,.طالما أنكِ فهمت
Dialogue: 0,0:16:15.83,0:16:19.50,Default,HILDE,0,0,0,,هل ستقبل 20 مليونًا إذًا؟
Dialogue: 0,0:16:19.96,0:16:21.00,Default,ELYMAS,0,0,0,,.لا
Dialogue: 0,0:16:25.97,0:16:28.19,Default,VERUGA,0,0,0,,.أنصت أيها الفتى
Dialogue: 0,0:16:30.22,0:16:33.44,Default,VERUGA,0,0,0,,،كنتُ مترددًا في قول هذا الآن
Dialogue: 0,0:16:33.44,0:16:38.00,Default,VERUGA,0,0,0,,لكن القيمة السوقية لهذا السيف\N.ليست 30 مليونًا
Dialogue: 0,0:16:39.27,0:16:40.79,Default,ELYMAS,0,0,0,,حقًا؟
Dialogue: 0,0:16:40.79,0:16:43.36,Default,HILDE,0,0,0,,هل هو مزيّف؟
Dialogue: 0,0:16:44.70,0:16:48.86,Default,HILDE,0,0,0,,.راهنتُ بالقيمة السوقية لذلك السيف
Dialogue: 0,0:16:50.10,0:16:52.37,Default,HILDE,0,0,0,,.جعلتني أجزع دون سبب
Dialogue: 0,0:16:52.37,0:16:56.37,Default,VERUGA,0,0,0,,.يمكنك تفقده بنفسك
Dialogue: 0,0:16:57.03,0:16:58.37,Default,SYSTEM VOICE,0,0,0,,.سيف ميثريل
Dialogue: 0,0:16:58.37,0:17:00.87,Default,SYSTEM VOICE,0,0,0,,.الهجوم: +46
Dialogue: 0,0:17:00.87,0:17:04.09,Default,SYSTEM VOICE,0,0,0,,.القيمة السوقية: 51.5 مليون قطعة ذهبية
Dialogue: 0,0:17:04.09,0:17:07.01,Default,SYSTEM VOICE,0,0,0,,.سيف سحري يتوهّج بالمانا
Dialogue: 0,0:17:07.01,0:17:09.38,Default,SYSTEM VOICE,0,0,0,,.مُعزّز برون الدمار
Dialogue: 0,0:17:10.23,0:17:14.64,Default,HILDE,0,0,0,,‫51 مليون قطعة ذهبية؟
Dialogue: 0,0:17:14.64,0:17:18.15,Default,ELYMAS,0,0,0,,.فهمت. نسيت إضافة قيمة الرون
Dialogue: 0,0:17:18.15,0:17:20.19,Default,ELYMAS,0,0,0,,.كان ذلك إهمالًا منّي
Dialogue: 0,0:17:20.19,0:17:21.02,Default,ELYMAS,0,0,0,,.هيلدي
Dialogue: 0,0:17:21.02,0:17:24.69,Default,ELYMAS,0,0,0,,.القيمة السوقية هي 51.5 مليون
Dialogue: 0,0:17:25.06,0:17:28.03,Default,HILDE,0,0,0,,!كفاك مزاحًا! لا أملك هذا المبلغ
Dialogue: 0,0:17:28.47,0:17:31.40,Default,HILDE,0,0,0,,!لا تتوقع منّي تقبّل ذلك
Dialogue: 0,0:17:31.67,0:17:35.91,Default,HILDE,0,0,0,,!رجاءً! خفض السعر إلى 40 مليونًا
Dialogue: 0,0:17:35.91,0:17:39.91,Default,ELYMAS,0,0,0,,ألا يمكنك الاختيار بين الصراخ في وجهي\Nوالانحناء لي؟
Dialogue: 0,0:17:36.35,0:17:39.91,top,HILDE,0,0,0,,!الرحمة، الرحمة
Dialogue: 0,0:17:40.30,0:17:43.26,top,HILDE,0,0,0,,!الرحمة، الرحمة
Dialogue: 0,0:17:40.48,0:17:43.93,Default,RUCHE,0,0,0,,.بدأتُ أشعر بالأسف تجاهها
Dialogue: 0,0:17:43.93,0:17:45.17,Default,ELYMAS,0,0,0,,.أنا أيضًا
Dialogue: 0,0:17:46.07,0:17:50.92,top,HILDE,0,0,0,,!الرحمة
Dialogue: 0,0:17:45.49,0:17:50.92,Default,ELYMAS,0,0,0,,لأكون صادقًا، السبب الرئيسي الذي جعلني\N.أنازلها هو تلقينها درسًا
Dialogue: 0,0:17:52.29,0:17:56.04,Default,ELYMAS,0,0,0,,سأمنحك تخفيضًا بقيمة مليون ونصف\N.وسأقبل 50 مليونًا
Dialogue: 0,0:18:12.99,0:18:17.58,Default,MATILDA,0,0,0,,."نُقدّم قروضًا للمغامرين من الرتبة "بي
Dialogue: 0,0:19:05.33,0:19:06.89,Default,MATILDA,0,0,0,,إليما-سان، صحيح؟
Dialogue: 0,0:19:06.89,0:19:13.09,Default,MATILDA,0,0,0,,لقد تلقيتَ مبلغًا قدره 50 مليون قطعة ذهبية\N.من هيلدي-سان مقابل نزلكما الأخير
Dialogue: 0,0:19:13.45,0:19:15.36,Default,ELYMAS,0,0,0,,حصلت على المال حقًا؟
Dialogue: 0,0:19:15.36,0:19:17.39,Default,ELYMAS,0,0,0,,.مرّ يومان فقط
Dialogue: 0,0:19:17.69,0:19:21.26,Default,MATILDA,0,0,0,,.نحن معتادين على حلّ الخلافات بين المغامرين
Dialogue: 0,0:19:21.66,0:19:24.12,Default,MATILDA,0,0,0,,…إن رأت النقابة أن ذلك يستحقّ العناء
Dialogue: 0,0:19:25.53,0:19:29.15,Default,HILDE,0,0,0,,ما رأيك بـ40 مليون… لا، بل 45 مليونًا؟
Dialogue: 0,0:19:31.15,0:19:35.40,Default,HILDE,0,0,0,,!حسنًا، 50 مليونًا! سأدفع 50 مليونًا
Dialogue: 0,0:19:40.33,0:19:42.95,Default,HILDE,0,0,0,,!عثرتُ عليكما أيها الوغدين
Dialogue: 0,0:19:42.95,0:19:47.21,Default,HILDE,0,0,0,,!أعيدا لي 50 مليونًا التي سلبتماني
Dialogue: 0,0:19:51.22,0:19:53.64,Default,ELYMAS,0,0,0,,.فهمت. بعتِ سلاحك
Dialogue: 0,0:19:53.64,0:19:54.88,Default,ELYMAS,0,0,0,,!اهربي يا روتشي
Dialogue: 0,0:19:54.88,0:19:55.67,Default,RUCHE,0,0,0,,!حسنًا
Dialogue: 0,0:19:57.64,0:19:58.68,Default,HILDE,0,0,0,,.لن تفلتا
Dialogue: 0,0:20:05.23,0:20:06.23,Default,CARLOS,0,0,0,,.هيلدي
Dialogue: 0,0:20:16.89,0:20:19.20,Default,CARLOS,0,0,0,,أهذا هو الفارس المدرّع؟
Dialogue: 0,0:20:31.38,0:20:34.32,Default,ELYMAS/ID,0,0,0,,.هذه الهالة، هذا الزخم
Dialogue: 0,0:20:39.01,0:20:44.01,Default,ELYMAS/ID,0,0,0,,.لا شكّ أنه "نصل اللهب المسودّ" الحقيقيّ
Dialogue: 0,0:20:49.88,0:20:52.02,Default,HILDE,0,0,0,,!هذان هما أيها المعلم
Dialogue: 0,0:20:52.39,0:20:56.92,Default,HILDE,0,0,0,,!استخدما أساليب ماكرة لسرقة مالي
Dialogue: 0,0:21:03.79,0:21:04.92,Default,ELYMAS/ID,0,0,0,,.كما توقعت
Dialogue: 0,0:21:06.55,0:21:08.13,Default,CARLOS,0,0,0,,.أنا من فئة سيّاف السحر
Dialogue: 0,0:21:09.09,0:21:11.32,Default,CARLOS,0,0,0,,."أنا مغامر من الرتبة "ايه\N.اسمي كارلوس
Dialogue: 0,0:21:12.60,0:21:16.71,Default,CARLOS,0,0,0,,.أردتُ لقاءك بعد أن أخبرتني هيلدي عنك
Dialogue: 0,0:21:21.80,0:21:23.72,Default,CARLOS,0,0,0,,.أيها الفارس المدرّع إليما
Dialogue: 0,0:23:11.45,0:23:15.80,Default,ELYMAS/NA,0,0,0,,.ظهر سيّاف السحر كارلوس أمامنا
Dialogue: 0,0:23:15.80,0:23:19.76,Default,ELYMAS/NA,0,0,0,,هو معلم هيلدي وأحد مغامري\N.الرتبة "ايه" في لاكورينا
Dialogue: 0,0:23:20.38,0:23:22.80,Default,ELYMAS/NA,0,0,0,,."كما يُعرف أيضًا بـ"نصل اللهب المسودّ
Dialogue: 0,0:23:23.75,0:23:27.82,Default,ELYMAS/NA,0,0,0,,،ظننتُ أن كارلوس أتى بسبب هيلدي
Dialogue: 0,0:23:27.82,0:23:32.52,Default,ELYMAS/NA,0,0,0,,:لكنه عرض علينا أمرًا أكثر أهمية بكثير\N.مهمة لا يمكننا رفضها
Dialogue: 0,0:23:33.19,0:23:35.44,Default,ELYMAS/NA,0,0,0,,."في الحلقة القادمة: "نصل اللهب المسودّ
Dialogue: 0,0:23:35.98,0:23:38.86,Default,ELYMAS/NA,0,0,0,,.أكبر معاركنا على وشك أن تبدأ

