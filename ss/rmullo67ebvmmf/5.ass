Dialogue: 0,0:00:00.61,0:00:02.25,flashback,NOELLE,0,0,0,,‫لم نستسلم!
Dialogue: 0,0:00:02.86,0:00:06.49,flashback,NOELLE,0,0,0,,‫ولهذا سننتصر في هذه المعركة يا ميغيكولا!
Dialogue: 0,0:00:07.80,0:00:14.44,flashback,MEGICULA,0,0,0,,‫يبدو أنني أسأت تقدير… قوتكم الحقيقية.
Dialogue: 0,0:00:20.58,0:00:24.58,flashback,ACIER,0,0,0,,‫لقد أصبحتما… قويين جدًا.
Dialogue: 0,0:01:59.57,0:02:04.94,Ep Title,EPISODE TITLE,0,0,0,,‫{\pos(321,100)\c&HF7F8FF&}قلب شيطان
Dialogue: 0,0:02:26.04,0:02:28.29,main,ASTA,0,0,0,,‫نويل! لقد نجحت!
Dialogue: 0,0:02:28.68,0:02:30.17,main,NOELLE,0,0,0,,‫أستا! لوروبيتشكا!
Dialogue: 0,0:02:31.20,0:02:34.26,main,NOELLE,0,0,0,,‫لقد هزمنا ميغيكولا، لذا\N‫‫يفترض أن لعنة لوروبيتشكا قد…
Dialogue: 0,0:02:39.62,0:02:42.74,main,ASTA,0,0,0,,‫الملكة لوروبيتشكا! هل استعدت وعيك الآن؟!
Dialogue: 0,0:02:46.32,0:02:49.19,main,LOROPECHIKA,0,0,0,,‫أنا آسفة! آسفة جدًا! أعتذر لأنني عارية!
Dialogue: 0,0:02:49.19,0:02:52.07,main,ASTA,0,0,0,,‫لا تخافي! لم أرَ شيئًا!
Dialogue: 0,0:02:52.07,0:02:54.60,main,NOELLE,0,0,0,,‫ماذا تفعل يا غبيّستا؟!
Dialogue: 0,0:02:54.60,0:02:56.82,main,ASTA,0,0,0,,‫مهلًا، لم أفعل شيئًا!
Dialogue: 0,0:02:57.65,0:02:58.78,main,NOELLE,0,0,0,,‫لوروبيتشكا!
Dialogue: 0,0:03:00.28,0:03:02.16,main,NOELLE,0,0,0,,‫أنا سعيدة جدًا لأنك حية!
Dialogue: 0,0:03:02.16,0:03:04.66,main,SMALL UNDINE,0,0,0,,‫لوروبيتشكا!
Dialogue: 0,0:03:04.66,0:03:07.75,main,LOROPECHIKA,0,0,0,,‫نويل… أونديني…
Dialogue: 0,0:03:08.18,0:03:10.42,main,ASTA,0,0,0,,‫ماذا دهاك يا نويل؟!
Dialogue: 0,0:03:10.69,0:03:13.44,main,NOELLE,0,0,0,,‫اخرس يا غبيّستا! هذا لأنك…
Dialogue: 0,0:03:16.20,0:03:17.37,italics,NOELLE (INT),0,0,0,,‫ماذا أفعل؟
Dialogue: 0,0:03:17.37,0:03:19.74,italics,NOELLE (INT),0,0,0,,‫أنا سعيدة حقًا برؤيته\N‫‫بعد كل هذا الغياب، لكن…
Dialogue: 0,0:03:19.74,0:03:20.81,main,ASTA,0,0,0,,‫ما الأمر يا نويل؟
Dialogue: 0,0:03:20.81,0:03:24.60,italics,NOELLE (INT),0,0,0,,‫أشعر بإحراج شديد لدرجة أنني\N‫‫لا أستطيع حتى النظر في عينيه!
Dialogue: 0,0:03:23.12,0:03:24.60,top,ASTA,0,0,0,,‫نويل؟
Dialogue: 0,0:03:24.60,0:03:28.02,main,NOELLE,0,0,0,,‫لا شيء يا غبيّستا!
Dialogue: 0,0:03:31.90,0:03:34.18,italics,NOZEL (INT),0,0,0,,‫لقد زالت اللعنة…
Dialogue: 0,0:03:34.18,0:03:37.76,italics,NOZEL (INT),0,0,0,,‫لكنني لا أعرف كيف يفترض بي\N‫‫أن أتعامل مع نويل.
Dialogue: 0,0:03:37.76,0:03:39.53,main,NOELLE,0,0,0,,‫نوزيل؟
Dialogue: 0,0:03:39.53,0:03:45.29,main,RILL,0,0,0,,‫آسف يا شارلوت. ستزول تعويذتي قريبًا.
Dialogue: 0,0:03:45.94,0:03:49.18,italics,RILL (INT),0,0,0,,‫فشلت مجددًا في إنجاز أعظم تحفة فنية لي.
Dialogue: 0,0:03:49.68,0:03:52.18,italics,RILL (INT),0,0,0,,‫أظن أن تحفتي الفنية الأعظم هي…
Dialogue: 0,0:03:52.18,0:03:54.17,main,CHARLOTTE,0,0,0,,‫لماذا تعتذر يا ريل؟
Dialogue: 0,0:03:54.85,0:03:57.29,main,CHARLOTTE,0,0,0,,‫بفضلك استطعت القتال.
Dialogue: 0,0:03:58.33,0:03:59.55,main,CHARLOTTE,0,0,0,,‫لذا أشكرك.
Dialogue: 0,0:04:01.14,0:04:02.22,main,CHARLOTTE,0,0,0,,‫وأيضًا…
Dialogue: 0,0:04:02.64,0:04:06.88,main,CHARLOTTE,0,0,0,,‫لا يمكننا أن نموت بعد. ألست محقة؟
Dialogue: 0,0:04:08.98,0:04:10.81,main,LUCK,0,0,0,,‫مرحبًا!
Dialogue: 0,0:04:11.17,0:04:12.14,main,NOELLE,0,0,0,,‫لاك!
Dialogue: 0,0:04:12.14,0:04:13.97,main,LUCK,0,0,0,,‫كان ذلك مذهلًا يا نويل.
Dialogue: 0,0:04:13.97,0:04:16.74,main,LUCK,0,0,0,,‫لقد هزمت شيطانًا من أعلى رتبة.
Dialogue: 0,0:04:22.28,0:04:24.90,main,LUCK,0,0,0,,‫لا يمكنني إضاعة أي وقت.
Dialogue: 0,0:04:25.65,0:04:26.79,main,LOROPECHIKA,0,0,0,,‫غاجا!
Dialogue: 0,0:04:26.79,0:04:28.41,main,GAJA,0,0,0,,‫ملكة لوروبيتشكا.
Dialogue: 0,0:04:29.00,0:04:30.54,main,GAJA,0,0,0,,‫حمدًّا لله أنّك بخـ—
Dialogue: 0,0:04:37.34,0:04:38.28,main,NOELLE,0,0,0,,‫غاجا!
Dialogue: 0,0:04:40.25,0:04:42.78,main,NOELLE,0,0,0,,‫قائدة شارلوت! قائد ريل!
Dialogue: 0,0:04:46.45,0:04:49.65,italics,LOROPECHIKA (INT),0,0,0,,‫سحر شفاء الماء: أكوينيل لور.
Dialogue: 0,0:04:53.76,0:04:58.09,italics,LOROPECHIKA (INT),0,0,0,,‫سحري… لا يستطيع شفاء هذه الجروح!
Dialogue: 0,0:04:58.81,0:05:04.42,main,LOROPECHIKA,0,0,0,,‫لا… لقد أنقذوني للتو…\N‫‫ومع ذلك أنا… أنا…
Dialogue: 0,0:05:05.13,0:05:08.23,italics,ASTA (INT),0,0,0,,‫سيف مدمّر الشياطين\N‫‫لا يستطيع فعل شيء حيال الإصابات!
Dialogue: 0,0:05:08.23,0:05:10.83,main,ASTA,0,0,0,,‫تبًا! ألا يوجد ما يمكنني فعله؟
Dialogue: 0,0:05:11.97,0:05:13.21,italics,NOELLE (INT),0,0,0,,‫لا…
Dialogue: 0,0:05:14.04,0:05:16.72,main,NOELLE,0,0,0,,‫لقد فعلوا الصواب وبذلوا كل ما بوسعهم…
Dialogue: 0,0:05:17.10,0:05:19.55,main,NOELLE,0,0,0,,‫لا يمكن أن يموتوا هكذا!
Dialogue: 0,0:05:19.55,0:05:22.18,main,NACHT,0,0,0,,‫لا يوجد ما يمكن فعله من أجلهم.
Dialogue: 0,0:05:22.80,0:05:24.45,main,ASTA,0,0,0,,‫نائب القائد ناهاتو!
Dialogue: 0,0:05:24.89,0:05:29.61,main,NACHT,0,0,0,,‫لقد هزمنا شيطانًا من أعلى رتبة.\N‫‫علينا أن نفرح بذلك.
Dialogue: 0,0:05:30.02,0:05:33.70,main,NACHT,0,0,0,,‫ليس بالضرورة أن يُكافأ كل من هو على حق.
Dialogue: 0,0:05:33.70,0:05:35.19,main,NACHT,0,0,0,,‫ذلك هو الواقع.
Dialogue: 0,0:05:36.37,0:05:38.21,italics,NACHT (INT),0,0,0,,‫مع أنني أتمنى ذلك.
Dialogue: 0,0:05:39.00,0:05:41.03,main,LUCK,0,0,0,,‫هل أحضرتها؟
Dialogue: 0,0:05:41.03,0:05:41.74,main,NACHT,0,0,0,,‫نعم.
Dialogue: 0,0:05:42.89,0:05:44.20,main,NACHT,0,0,0,,‫لكن الأوان قد فات بالفعل…
Dialogue: 0,0:05:49.68,0:05:50.70,main,NOELLE,0,0,0,,‫لا!
Dialogue: 0,0:05:54.18,0:05:55.40,main,NOELLE,0,0,0,,‫ميموسا تستطيع فعل ذلك!
Dialogue: 0,0:05:57.72,0:06:00.09,main,MIMOSA,0,0,0,,‫لن أسمح بموت أي أحد!
Dialogue: 0,0:06:03.20,0:06:05.37,italics,MIMOSA (INT),0,0,0,,‫سحر النباتات المطلق…
Dialogue: 0,0:06:06.49,0:06:08.57,italics,MIMOSA (INT),0,0,0,,‫جنة أميرة الأزهار.
Dialogue: 0,0:06:13.45,0:06:15.40,italics,NACHT (INT),0,0,0,,‫تعويذة الشفاء هذه…
Dialogue: 0,0:06:15.88,0:06:18.36,main,NOELLE,0,0,0,,‫سنلغي الواقع نفسه فحسب!
Dialogue: 0,0:06:19.10,0:06:22.81,main,NOELLE,0,0,0,,‫لأنّ ذلك ما يفعله السحر، أليس كذلك؟
Dialogue: 0,0:06:23.89,0:06:25.24,main,LOROPECHIKA,0,0,0,,‫غاجا!
Dialogue: 0,0:06:25.72,0:06:28.67,main,ASTA,0,0,0,,‫ريل! قائدة شارلوت!
Dialogue: 0,0:06:28.67,0:06:30.74,main,ASTA,0,0,0,,‫حمدًا لله!
Dialogue: 0,0:06:31.05,0:06:33.94,main,ASTA,0,0,0,,‫ميموسا، أنت مذهلة للغاية!
Dialogue: 0,0:06:35.42,0:06:37.49,main,LOROPECHIKA,0,0,0,,‫كل هذا من أجل شخص مثلي…
Dialogue: 0,0:06:37.49,0:06:39.91,main,LOROPECHIKA,0,0,0,,‫أنا آسفة جدًا! أنا آسفة جدًا!
Dialogue: 0,0:06:39.91,0:06:43.67,main,GAJA,0,0,0,,‫لا. أديت واجبي فحسب بصفتي حارس أرواح.
Dialogue: 0,0:06:43.96,0:06:48.13,main,NOELLE,0,0,0,,‫حقًا. ألا يوجد لديكما شيء أهم تقولانه؟
Dialogue: 0,0:06:52.94,0:06:54.30,main,GAJA,0,0,0,,‫أنا أحبك.
Dialogue: 0,0:06:58.48,0:07:00.23,main,GAJA,0,0,0,,‫ولا أعني بصفتك ملكتي.
Dialogue: 0,0:07:00.23,0:07:03.65,main,GAJA,0,0,0,,‫أنت المرأة التي أحبها.
Dialogue: 0,0:07:08.56,0:07:10.46,main,NOELLE,0,0,0,,‫لا، انتظر! أحقًا؟!
Dialogue: 0,0:07:10.46,0:07:11.89,main,GAJA,0,0,0,,‫هل قلت شيئًا خاطئًا؟
Dialogue: 0,0:07:11.89,0:07:14.75,main,SMALL UNDINE,0,0,0,,‫لوروبيتشكا لي وحدي!
Dialogue: 0,0:07:15.20,0:07:17.26,main,SMALL UNDINE,0,0,0,,‫لكن إن كنت أنت يا غاجا…
Dialogue: 0,0:07:20.06,0:07:24.26,main,NOZEL,0,0,0,,‫أكره الاعتراف بذلك،\N‫‫لكن يبدو أنّ نويل ازدادت قوة بسببه.
Dialogue: 0,0:07:25.05,0:07:28.73,main,NOZEL,0,0,0,,‫لا بد لنا من إنقاذ يامي مهما كلف الأمر.
Dialogue: 0,0:07:31.81,0:07:37.85,italics,NACHT (INT),0,0,0,,‫يبدو أنهم أصبحوا أقوى بكثير مما تخيلت.
Dialogue: 0,0:07:38.93,0:07:41.42,italics,NACHT (INT),0,0,0,,‫لم يبق الآن سوى عضو واحد من ثالوث الظلام.
Dialogue: 0,0:07:42.34,0:07:43.52,italics,NACHT (INT),0,0,0,,‫والأخير هو…
Dialogue: 0,0:07:41.86,0:07:44.62,sign_TimesNewRoman,SIGN,0,0,0,,‫{\an8\fad(0,790)}قبل هزيمة ميغيكولا مباشرة
Dialogue: 0,0:07:49.72,0:07:52.26,main,ZENON,0,0,0,,‫نحن نهدر الوقت الآن فحسب.
Dialogue: 0,0:07:52.70,0:07:54.75,main,ZENON,0,0,0,,‫لننهِ هذا.
Dialogue: 0,0:07:57.50,0:08:00.19,main,LANGRIS,0,0,0,,‫تبًا… ماذا سنفعل الآن؟
Dialogue: 0,0:08:00.19,0:08:01.13,main,YUNO,0,0,0,,‫لانغيرس.
Dialogue: 0,0:08:02.41,0:08:03.57,main,YUNO,0,0,0,,‫أمهلني ثلاث دقائق!
Dialogue: 0,0:08:04.01,0:08:06.13,main,YUNO,0,0,0,,‫سأنهي هذا بهجومي التالي.
Dialogue: 0,0:08:07.81,0:08:12.54,italics,YUNO (INT),0,0,0,,‫لدي تعويذة تستطيع هزيمته…\N‫‫لكنني أحتاج وقتًا لجمع المانا.
Dialogue: 0,0:08:13.92,0:08:17.27,italics,YUNO (INT),0,0,0,,‫لا أستطيع إطلاقها ونحن ندافع.
Dialogue: 0,0:08:18.21,0:08:20.19,italics,YUNO (INT),0,0,0,,‫لهزيمته…
Dialogue: 0,0:08:20.77,0:08:24.44,italics,LANGRIS (INT),0,0,0,,‫سأضطر إلى تشتيت انتباهه وحماية يونو.
Dialogue: 0,0:08:24.94,0:08:25.92,italics,LANGRIS (INT),0,0,0,,‫لكن…
Dialogue: 0,0:08:26.29,0:08:29.90,italics,LANGRIS (INT),0,0,0,,‫لا أستطيع تفادي هجماته إلا بمساعدة يونو،
Dialogue: 0,0:08:29.90,0:08:33.06,italics,LANGRIS (INT),0,0,0,,‫لذا يستحيل أن أكسب له ثلاث دقائق…
Dialogue: 0,0:08:34.01,0:08:36.70,italics,YUNO/LANGRIS (INT),0,0,0,,‫لكن ليس أمامنا سوى فعل ذلك!
Dialogue: 0,0:08:38.73,0:08:42.53,main,YUNO,0,0,0,,‫أنت أقوى ساحر مكاني في مملكة كلوفر،
Dialogue: 0,0:08:42.53,0:08:45.21,main,YUNO,0,0,0,,‫لذا بدأت ترى سبيلًا لتخطي هذا، أليس كذلك؟
Dialogue: 0,0:08:45.68,0:08:49.34,main,YUNO,0,0,0,,‫لن تسمح له بالاستمرار في سحقنا، صحيح؟
Dialogue: 0,0:08:52.22,0:08:56.30,main,ZENON,0,0,0,,‫أعرف بالفعل حدود قدراتكما.
Dialogue: 0,0:08:57.22,0:09:00.99,italics,LANGRIS (INT),0,0,0,,‫بمجرد دخول فضاء زينون المطلق:\N‫‫سيادة المانا المكانية،
Dialogue: 0,0:09:00.99,0:09:04.11,italics,LANGRIS (INT),0,0,0,,‫لن يتمكن معظم الناس من استخدام أي سحر.
Dialogue: 0,0:09:04.45,0:09:09.36,italics,LANGRIS (INT),0,0,0,,‫لن يتمكن من استخدام السحر\N‫‫إلا من لديه المقدار نفسه من المانا.
Dialogue: 0,0:09:09.80,0:09:13.90,italics,LANGRIS (INT),0,0,0,,‫من تحبه المانا مثل يونو،\N‫‫وتمكن من تحرير نفسه.
Dialogue: 0,0:09:16.60,0:09:17.73,italics,LANGRIS (INT),0,0,0,,‫وكذلك…
Dialogue: 0,0:09:19.16,0:09:22.46,italics,LANGRIS (INT),0,0,0,,‫السحرة المكانيون الذين\N‫‫أتقنوا منطقة المانا!
Dialogue: 0,0:09:27.84,0:09:33.26,italics,ZENON (INT),0,0,0,,‫رغم صغرها، أنشأ منطقة خاصة به\N‫‫داخل فضائي المطلق.
Dialogue: 0,0:09:33.48,0:09:35.94,main,YUNO,0,0,0,,‫أرأيت؟ كنت أعلم أنك تستطيع فعلها.
Dialogue: 0,0:09:35.94,0:09:37.36,main,YUNO,0,0,0,,‫أحسنت صنعًا.
Dialogue: 0,0:09:37.81,0:09:42.19,main,LANGRIS,0,0,0,,‫يا إلهي… يا لك من زميل أصغر مزعج!
Dialogue: 0,0:09:43.24,0:09:46.60,italics,LANGRIS (INT),0,0,0,,‫منذ انضمامه، كان وقحًا ومغرورًا،
Dialogue: 0,0:09:46.60,0:09:49.54,italics,LANGRIS (INT),0,0,0,,‫لكنه امتلك المهارات التي تدعم ذلك.
Dialogue: 0,0:09:50.18,0:09:53.60,italics,LANGRIS (INT),0,0,0,,‫بالنظر إلى ذلك الآن، أظنني كرهته\N‫‫لأننا متشابهان جدًّا.
Dialogue: 0,0:09:54.64,0:09:58.17,italics,LANGRIS (INT),0,0,0,,‫لكنني لم أشعر يومًا أنني سأخسر.
Dialogue: 0,0:09:58.61,0:10:01.90,italics,LANGRIS (INT),0,0,0,,‫لم أتخيل أنك ستتمكن من التفوق عليّ.
Dialogue: 0,0:10:04.18,0:10:08.14,main,ZENON,0,0,0,,‫لكن ليس لديكما في النهاية\N‫‫أي وسيلة لمهاجمتي.
Dialogue: 0,0:10:08.14,0:10:11.38,main,ZENON,0,0,0,,‫لا تملكان الآن أي تعويذة تستطيع هزيمتي.
Dialogue: 0,0:10:13.13,0:10:16.14,italics,LANGRIS (INT),0,0,0,,‫مانا هذا الرجل تفوق مستوانا تمامًا!
Dialogue: 0,0:10:16.14,0:10:18.14,italics,LANGRIS (INT),0,0,0,,‫لن أستطيع الصمود طويلًا.
Dialogue: 0,0:10:20.22,0:10:22.27,italics,LANGRIS (INT),0,0,0,,‫من الأفضل أن تسرع!
Dialogue: 0,0:10:22.65,0:10:24.34,italics,YUNO (INT),0,0,0,,‫أنا أعمل على ذلك!
Dialogue: 0,0:10:25.82,0:10:29.37,italics,LANGRIS (INT),0,0,0,,‫هذا صحيح. كان سحري المكاني لا يُقهر.
Dialogue: 0,0:10:30.65,0:10:32.82,italics,LANGRIS (INT),0,0,0,,‫كان يكفي أن أبذل قصارى جهدي.
Dialogue: 0,0:10:33.60,0:10:37.16,italics,LANGRIS (INT),0,0,0,,‫ما دمت موجودًا، كانت فرقتي الأقوى.
Dialogue: 0,0:10:37.89,0:10:40.70,italics,LANGRIS (INT),0,0,0,,‫لكن قوتك كانت من نوع مختلف.
Dialogue: 0,0:10:42.05,0:10:44.65,italics,LANGRIS (INT),0,0,0,,‫كأنك كنت تدفعنا إلى الأمام بتلك الرياح…
Dialogue: 0,0:10:45.17,0:10:50.42,italics,LANGRIS (INT),0,0,0,,‫وكأننا جميعًا نطير معًا.\N‫‫لم تكن قوتك أنانية.
Dialogue: 0,0:10:52.88,0:10:55.60,italics,LANGRIS (INT),0,0,0,,‫كانت كراهيتك للخسارة تلهم الجميع
Dialogue: 0,0:10:56.22,0:10:57.49,italics,LANGRIS (INT),0,0,0,,‫وجعلتنا أقوى.
Dialogue: 0,0:11:00.49,0:11:04.10,main,LANGRIS,0,0,0,,‫هذا مزعج، لكنني أعترف بذلك.
Dialogue: 0,0:11:05.05,0:11:09.78,main,LANGRIS,0,0,0,,‫أنت حقًا نائب قائد فرقة الفجر الذهبي!
Dialogue: 0,0:11:10.70,0:11:13.82,main,ZENON,0,0,0,,‫أمام القوة الساحقة،
Dialogue: 0,0:11:13.82,0:11:17.52,main,ZENON,0,0,0,,‫لا تعني المشاعر والمثابرة\N‫‫شيئًا على الإطلاق.
Dialogue: 0,0:11:20.93,0:11:26.96,main,ZENON,0,0,0,,‫الحقيقة الوحيدة هي أنني أقوى منكما.
Dialogue: 0,0:11:27.96,0:11:32.48,main,LANGRIS,0,0,0,,‫نعم، لكن لا يمكننا قول "حقًا؟"\N‫‫ثم التراجع ببساطة!
Dialogue: 0,0:11:38.94,0:11:40.39,main,LANGRIS,0,0,0,,‫نحن…
Dialogue: 0,0:11:40.89,0:11:45.49,main,LANGRIS,0,0,0,,‫الفجر الذهبي، أقوى فرق فرسان سحر!
Dialogue: 0,0:11:46.17,0:11:47.19,main,YUNO,0,0,0,,‫هذا صحيح.
Dialogue: 0,0:11:49.25,0:11:51.98,main,YUNO,0,0,0,,‫أنت تكره الخسارة بقدري تمامًا!
Dialogue: 0,0:11:53.01,0:11:56.90,main,YUNO,0,0,0,,‫سحر تشكيل روح الرياح: روح أوروس.
Dialogue: 0,0:12:12.38,0:12:14.09,italics,ZENON (INT),0,0,0,,‫سريع جدًا…
Dialogue: 0,0:12:14.84,0:12:18.76,italics,ZENON (INT),0,0,0,,‫لا أصدق أن اختراق هذا الجسد\N‫‫بالكامل أمر ممكن…
Dialogue: 0,0:12:21.04,0:12:23.89,main,YUNO,0,0,0,,‫مثابرتنا تفوز هذه المرة!
Dialogue: 0,0:12:29.50,0:12:30.66,italics,ZENON (INT),0,0,0,,‫ألين…
Dialogue: 0,0:12:39.64,0:12:41.07,flashback,YOUNG VANICA (FB),0,0,0,,‫ما بك؟
Dialogue: 0,0:12:42.32,0:12:44.44,flashback,YOUNG VANICA (FB),0,0,0,,‫هل أُصبت مجددًا؟
Dialogue: 0,0:12:44.44,0:12:46.11,flashback,YOUNG VANICA (FB),0,0,0,,‫يا لك من فاشل!
Dialogue: 0,0:12:46.11,0:12:47.34,flashback,YOUNG DANTE (FB),0,0,0,,‫يا إلهي…
Dialogue: 0,0:12:47.68,0:12:50.28,flashback,YOUNG DANTE (FB),0,0,0,,‫أنت مثير للشفقة بالنسبة\N‫‫لشخص يعتبر أخي الصغير.
Dialogue: 0,0:12:56.68,0:12:59.04,flashback,LUCIUS (FB),0,0,0,,‫لا تقلق يا زينون.
Dialogue: 0,0:13:01.56,0:13:02.58,flashback,YOUNG ZENON (FB),0,0,0,,‫أخي الأكبر…
Dialogue: 0,0:13:03.20,0:13:05.82,flashback,LUCIUS (FB),0,0,0,,‫أنت أكثر من يشبهني.
Dialogue: 0,0:13:08.93,0:13:13.77,flashback,LUCIUS (FB),0,0,0,,‫قابليتك لاستضافة شيطان\N‫‫تفوق قابلية دانتي وفانيكا.
Dialogue: 0,0:13:20.44,0:13:21.68,flashback,JOHN (FB),0,0,0,,‫خذ هذه!
Dialogue: 0,0:13:23.28,0:13:25.64,flashback,BOY 1 (FB),0,0,0,,‫أنت قوي جدًا يا جون!
Dialogue: 0,0:13:25.64,0:13:29.40,flashback,JOHN (FB),0,0,0,,‫يا لك من صبي مخيف! العظام تنبثق من جسدك.
Dialogue: 0,0:13:30.04,0:13:37.10,flashback,JOHN (FB),0,0,0,,‫أبي عضو في قوات دفاع السحرة،\N‫‫لذا سأقضي عليك!
Dialogue: 0,0:13:38.92,0:13:40.12,flashback,JOHN (FB),0,0,0,,‫هذا ساخن!
Dialogue: 0,0:13:40.12,0:13:41.64,flashback,YOUNG ALLEN (FB),0,0,0,,‫عمّ تتحدث؟
Dialogue: 0,0:13:42.43,0:13:45.53,flashback,YOUNG ALLEN (FB),0,0,0,,‫إنه مجرد نوع مختلف من السحر!
Dialogue: 0,0:13:45.53,0:13:47.48,flashback,JOHN (FB),0,0,0,,‫إنه ألين!
Dialogue: 0,0:13:47.48,0:13:49.48,flashback,JOHN (FB),0,0,0,,‫اهربا!
Dialogue: 0,0:13:49.48,0:13:53.23,flashback,YOUNG ALLEN (FB),0,0,0,,‫وأنت ابن أحد أفراد\N‫‫قوات دفاع السحرة؟ يا للخزي.
Dialogue: 0,0:13:55.34,0:13:56.48,flashback,YOUNG ALLEN (FB),0,0,0,,‫أنا ألين!
Dialogue: 0,0:13:56.73,0:13:59.25,flashback,YOUNG ALLEN (FB),0,0,0,,‫يبدو سحرك قويًا جدًا!
Dialogue: 0,0:14:02.97,0:14:05.37,flashback,YOUNG ALLEN (FB),0,0,0,,‫الجميع خائفون ومتوترون.
Dialogue: 0,0:14:06.29,0:14:09.52,flashback,YOUNG ALLEN (FB),0,0,0,,‫مملكة سبيد مغطاة بالثلوج دائمًا.
Dialogue: 0,0:14:09.52,0:14:11.72,flashback,YOUNG ALLEN (FB),0,0,0,,‫والتمرد فيها لا ينتهي،
Dialogue: 0,0:14:11.72,0:14:14.50,flashback,YOUNG ALLEN (FB),0,0,0,,‫ومملكة داياموند تواصل غزوها.
Dialogue: 0,0:14:15.45,0:14:20.17,flashback,YOUNG ALLEN (FB),0,0,0,,‫أريد أن أصبح أقوى لأحمي\N‫‫السكان الذين يرتجفون خوفًا.
Dialogue: 0,0:14:21.58,0:14:25.93,flashback,YOUNG ALLEN (FB),0,0,0,,‫أريد إيقاد نار الأمل بهذه الأرض المتجمدة.
Dialogue: 0,0:14:29.04,0:14:29.92,flashback,YOUNG ALLEN (FB),0,0,0,,‫لذا…
Dialogue: 0,0:14:30.86,0:14:34.35,flashback,YOUNG ALLEN (FB),0,0,0,,‫سأصبح القائد الأعلى لقوات دفاع السحرة.
Dialogue: 0,0:14:35.74,0:14:36.65,flashback,YOUNG ZENON (FB),0,0,0,,‫وأنا أيضًا.
Dialogue: 0,0:14:38.98,0:14:40.82,flashback,YOUNG ZENON (FB),0,0,0,,‫سأصبح القائد الأعلى أنا أيضًا.
Dialogue: 0,0:14:41.48,0:14:44.36,flashback,YOUNG ALLEN (FB),0,0,0,,‫إذًا يبدو أننا أصبحنا متنافسين!
Dialogue: 0,0:14:44.72,0:14:48.00,flashback,YOUNG ALLEN (FB),0,0,0,,‫لنرَ أيّنا سيصبح القائد الأعلى!
Dialogue: 0,0:15:01.12,0:15:03.63,flashback,TEEN ZENON (FB),0,0,0,,‫أنا آسف جدًا يا أخي الأكبر.
Dialogue: 0,0:15:05.13,0:15:09.05,flashback,TEEN ZENON (FB),0,0,0,,‫لا أرغب في أن أصبح مستضيفًا لشيطان.
Dialogue: 0,0:15:13.26,0:15:17.22,flashback,MAGE DEFENSE FORCE MEMBER 1 (FB),0,0,0,,‫تهانينا على قبولكم في القسم الرابع\N‫‫من قوات دفاع السحرة.
Dialogue: 0,0:15:18.02,0:15:20.77,flashback,MAGE DEFENSE FORCE MEMBER 2 (FB),0,0,0,,‫كلا العضوين الجديدين\N‫‫هذا العام مستعدان للقتال!
Dialogue: 0,0:15:20.77,0:15:23.61,flashback,MAGE DEFENSE FORCE MEMBER 2 (FB),0,0,0,,‫وزينون، مستخدم سحر العظام، عبقري!
Dialogue: 0,0:15:24.81,0:15:27.70,flashback,MAGE DEFENSE FORCE MEMBER 1 (FB),0,0,0,,‫ظهر ديماس شمال غرب بلدة لوتون!
Dialogue: 0,0:15:27.70,0:15:29.74,flashback,MAGE DEFENSE FORCE MEMBER 1 (FB),0,0,0,,‫على القسم الرابع الذهاب للتحقيق فورًا!
Dialogue: 0,0:15:30.65,0:15:32.74,flashback,ALLEN (FB),0,0,0,,‫لن أخسر هذه المرة يا زينون.
Dialogue: 0,0:15:35.00,0:15:37.64,flashback,TEEN ZENON (FB),0,0,0,,‫لا مكان للفوز أو الخسارة\N‫‫في المهمات يا ألين.
Dialogue: 0,0:15:37.64,0:15:40.33,flashback,ALLEN (FB),0,0,0,,‫يا إلهي، أنت جاد دائمًا.
Dialogue: 0,0:15:52.42,0:15:55.52,flashback,MAGE DEFENSE FORCE MEMBER 2 (FB),0,0,0,,‫لا أصدق أن شيطانًا كان مختومًا هنا!
Dialogue: 0,0:15:55.52,0:15:59.26,flashback,MAGE DEFENSE FORCE MEMBER 3 (FB),0,0,0,,‫إنه قوي جدًا! بهذه الوتيرة، سنُباد جميعًا!
Dialogue: 0,0:16:01.02,0:16:02.69,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,‫لهزيمة ذلك الشيء…
Dialogue: 0,0:16:03.42,0:16:07.04,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,‫سأحتاج إلى إطلاق تعويذة\N‫‫تستهلك كل ما أملكه من المانا.
Dialogue: 0,0:16:07.77,0:16:10.82,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,‫لكنه لا يمنحني فرصة لإصابته.
Dialogue: 0,0:16:11.68,0:16:15.20,flashback,ALLEN (FB),0,0,0,,‫سأصبح… القائد الأعلى لقوات دفاع السحرة!
Dialogue: 0,0:16:18.32,0:16:21.25,flashback,ALLEN (FB),0,0,0,,‫لا يمكنني أن أخسر هنا!
Dialogue: 0,0:16:21.25,0:16:22.83,flashback,TEEN ZENON (FB),0,0,0,,‫ألين!
Dialogue: 0,0:16:22.83,0:16:25.13,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,‫كل ما ستفعله هو كسب بعض الوقت!
Dialogue: 0,0:16:28.36,0:16:30.14,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,‫هذه فرصتي الوحيدة!
Dialogue: 0,0:16:30.70,0:16:33.10,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,‫إن أطلقت الآن،\N‫‫فسأتمكن من القضاء على الشيطان…
Dialogue: 0,0:16:33.45,0:16:35.01,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,‫ومعه ألين.
Dialogue: 0,0:16:36.28,0:16:40.40,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,‫إن لم أقضِ عليه الآن،\N‫‫فإننا جميعًا، وأنا معهم…
Dialogue: 0,0:16:41.34,0:16:42.37,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,‫سنموت.
Dialogue: 0,0:16:43.96,0:16:46.60,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,‫وسيسقط المزيد من الضحايا في أرجاء المملكة.
Dialogue: 0,0:16:46.60,0:16:50.16,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,‫وعلى أقل تقدير، سيموت سكان البلدة القريبة.
Dialogue: 0,0:17:01.04,0:17:04.00,flashback,ALLEN (FB),0,0,0,,‫ليس بعد!
Dialogue: 0,0:17:10.89,0:17:12.95,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,‫من دون قوة،
Dialogue: 0,0:17:12.95,0:17:15.49,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,‫لا تعني المشاعر والمثابرة\N‫‫أي شيء على الإطلاق.
Dialogue: 0,0:17:18.34,0:17:20.82,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,‫لا بد من التخلص من الضعفاء.
Dialogue: 0,0:17:24.18,0:17:27.94,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,‫القوة الساحقة هي كل شيء!
Dialogue: 0,0:17:29.57,0:17:33.01,flashback italics,TEEN ZENON (INT)(FB),0,0,0,,‫إذا كان شيطان عادي يمتلك كل هذه القوة…
Dialogue: 0,0:17:34.12,0:17:35.25,flashback,TEEN ZENON (FB),0,0,0,,‫أخي الأكبر.
Dialogue: 0,0:17:37.21,0:17:40.66,flashback,TEEN ZENON (FB),0,0,0,,‫أرجوك اجعلني مستضيف شيطان.
Dialogue: 0,0:17:44.49,0:17:47.52,main,ZENON,0,0,0,,‫بيلزيبوب، لنعقد صفقة.
Dialogue: 0,0:17:47.92,0:17:50.57,main,ZENON,0,0,0,,‫امنحني قلب شيطان.
Dialogue: 0,0:17:52.74,0:17:54.70,main,BEELZEBUB,0,0,0,,‫قلبًا؟
Dialogue: 0,0:17:59.76,0:18:03.83,main,BEELZEBUB,0,0,0,,‫وماذا ستعطيني في المقابل؟
Dialogue: 0,0:18:03.83,0:18:05.86,main,ZENON,0,0,0,,‫كياني كله.
Dialogue: 0,0:18:07.46,0:18:12.44,main,ZENON,0,0,0,,‫إذا تمكنت مملكة سبيد من البقاء،\N‫‫وفقًا لما ينص عليه عقدنا،
Dialogue: 0,0:18:12.44,0:18:15.45,main,ZENON,0,0,0,,‫فسأعطيك روحي أيضًا.
Dialogue: 0,0:18:18.46,0:18:19.65,main,BEELZEBUB,0,0,0,,‫حسنًا إذًا.
Dialogue: 0,0:18:20.68,0:18:22.38,main,BEELZEBUB,0,0,0,,‫سأمنحك إياه.
Dialogue: 0,0:18:34.04,0:18:35.54,main,YUNO,0,0,0,,‫ماذا؟
Dialogue: 0,0:18:43.85,0:18:48.11,italics,YUNO,0,0,0,,‫هذا الإحساس… إنه يشبهه!
Dialogue: 0,0:18:48.52,0:18:51.76,main,ZENON,0,0,0,,‫الآن وقد حصلت على قلب شيطان،
Dialogue: 0,0:18:52.14,0:18:55.42,main,ZENON,0,0,0,,‫أصبحت قوتي أكثر فتكًا من ذي قبل.
Dialogue: 0,0:18:56.14,0:19:00.08,italics,LANGRIS (INT),0,0,0,,‫يستخدم قوة شيطان، ولديه قلب شيطان.
Dialogue: 0,0:19:00.54,0:19:02.25,italics,LANGRIS (INT),0,0,0,,‫ألا يُعدّ أي إنسان على هذه الحال…
Dialogue: 0,0:19:03.32,0:19:04.76,italics,LANGRIS (INT),0,0,0,,‫شيطانًا بالفعل؟
Dialogue: 0,0:19:22.21,0:19:24.60,main,ZENON,0,0,0,,‫ذلك السهم الذي أطلقته قبل قليل…
Dialogue: 0,0:19:25.98,0:19:30.25,main,ZENON,0,0,0,,‫غيّرت مساره قليلًا كيلا تصيب رفيقك
Dialogue: 0,0:19:30.25,0:19:32.86,main,ZENON,0,0,0,,‫فأخطأت إصابة قلبي.
Dialogue: 0,0:19:35.15,0:19:39.49,main,ZENON,0,0,0,,‫لو ضحيت برفيقك واخترقت قلبي بسهمك،
Dialogue: 0,0:19:40.24,0:19:42.70,main,ZENON,0,0,0,,‫لكنت قد انتصرت.
Dialogue: 0,0:20:11.78,0:20:13.70,main,ZENON,0,0,0,,‫أيها المزعج الصغير العنيد…
Dialogue: 0,0:20:14.09,0:20:16.19,main,ZENON,0,0,0,,‫أما زلت تقف في طريقي؟
Dialogue: 0,0:20:17.26,0:20:19.14,main,ZENON,0,0,0,,‫سأخلصك من عذابك.
Dialogue: 0,0:20:28.48,0:20:30.50,main,FINRAL,0,0,0,,‫مرحبًا يا لانغيرس!
Dialogue: 0,0:20:30.50,0:20:31.58,main,LANGRIS,0,0,0,,‫أخي؟
Dialogue: 0,0:20:31.93,0:20:33.64,main,ZENON,0,0,0,,‫إنه…
Dialogue: 0,0:20:34.34,0:20:37.31,main,LANGRIS,0,0,0,,‫لا أعرف سبب وجودك هنا،
Dialogue: 0,0:20:37.31,0:20:39.63,main,LANGRIS,0,0,0,,‫لكن هل تحاول إنقاذي مجددًا؟
Dialogue: 0,0:20:40.14,0:20:43.90,italics,FINRAL (INT),0,0,0,,‫رأيت لانغيرس وذلك الرجل،\N‫‫فأسرعت إلى هنا دون تفكير.
Dialogue: 0,0:20:44.47,0:20:45.52,main,FINRAL,0,0,0,,‫لا!
Dialogue: 0,0:20:46.09,0:20:51.05,main,FINRAL,0,0,0,,‫لقد اختطف قائدنا باستخدام السحر المكاني.
Dialogue: 0,0:20:51.50,0:20:54.77,main,FINRAL,0,0,0,,‫لا يمكنني أن أدعه يفلت بفعلته تلك.
Dialogue: 0,0:20:55.72,0:20:56.69,italics,FINRAL (INT),0,0,0,,‫آسف…
Dialogue: 0,0:20:57.03,0:20:59.87,italics,FINRAL (INT),0,0,0,,‫سأنحرف عن طريقي قليلًا يا يامي!
Dialogue: 0,0:21:00.89,0:21:04.17,italics,FINRAL (INT),0,0,0,,‫سأستخدم رفرفة أجنحة الشيطان\N‫‫مباشرة على لانغيرس!
Dialogue: 0,0:21:05.24,0:21:06.87,italics,FINRAL (INT),0,0,0,,‫الانتقال الآني!
Dialogue: 0,0:21:08.23,0:21:10.01,italics,FINRAL (INT),0,0,0,,‫منطقة المانا الخاصة بلانغيرس تتيح لنا
Dialogue: 0,0:21:10.01,0:21:13.21,italics,FINRAL (INT),0,0,0,,‫تفعيل التعويذات حتى في فضاء زينون المطلق.
Dialogue: 0,0:21:13.95,0:21:18.21,italics,LANGRIS (INT),0,0,0,,‫انتقال فينرال الآني فائق المرونة والدقة.
Dialogue: 0,0:21:18.89,0:21:22.42,main,FINRAL,0,0,0,,‫يمكننا القتال إن كنا معًا الآن!
Dialogue: 0,0:21:22.42,0:21:23.85,main,FINRAL,0,0,0,,‫أليس كذلك يا لانغيرس؟
Dialogue: 0,0:21:25.35,0:21:26.68,main,LANGRIS,0,0,0,,‫يا إلهي…
Dialogue: 0,0:21:26.68,0:21:29.02,main,LANGRIS,0,0,0,,‫يا لك من أخ أكبر وقح!
Dialogue: 0,0:21:34.31,0:21:37.28,italics,FINRAL (INT),0,0,0,,‫لن يصمد لانغيرس في معركة طويلة!
Dialogue: 0,0:21:37.28,0:21:38.32,italics,FINRAL (INT),0,0,0,,‫سنحسم الأمر بسرعة!
Dialogue: 0,0:21:39.44,0:21:42.27,italics,ZENON (INT),0,0,0,,‫الآن أعرف مدى سرعة انتقاله الآني
Dialogue: 0,0:21:42.27,0:21:46.13,italics,ZENON (INT),0,0,0,,‫وتوقيت انتقاله، وكذلك ما يسعيان إليه.
Dialogue: 0,0:21:46.13,0:21:48.95,italics,ZENON (INT),0,0,0,,‫حين يقتربان لحسم المعركة، سأقضي عليهما.
Dialogue: 0,0:21:49.56,0:21:51.93,italics,ZENON (INT),0,0,0,,‫بمجرد أن تدخلا منطقة المانا الخاصة بي…
Dialogue: 0,0:21:50.43,0:21:52.96,top,FINRAL (INT),0,0,0,,‫سنقترب منه بما يكفي\N‫‫لدخول منطقة المانا الخاصة به!
Dialogue: 0,0:21:57.21,0:21:58.63,italics,ZENON (INT),0,0,0,,‫…ستكون النهاية.
Dialogue: 0,0:22:01.10,0:22:02.20,italics,ZENON (INT),0,0,0,,‫ماذا؟
Dialogue: 0,0:22:03.90,0:22:06.80,italics,FINRAL (INT),0,0,0,,‫استخدمت أسلوب المانا لتعزيز سرعتنا!
Dialogue: 0,0:22:07.31,0:22:09.82,italics,FINRAL (INT),0,0,0,,‫سحر لانغيرس يمزق الفضاء نفسه!
Dialogue: 0,0:22:09.82,0:22:13.06,italics,FINRAL (INT),0,0,0,,‫مهما بلغت قوتك، فإن دفاعاتك…
Dialogue: 0,0:22:13.61,0:22:15.34,italics,FINRAL/LANGRIS (INT),0,0,0,,‫…لن تنفعك في شيء!

