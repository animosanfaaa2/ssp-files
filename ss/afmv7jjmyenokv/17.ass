Dialogue: 0,0:01:44.31,0:01:46.10,Default,,0,0,0,,ให้อภัยไม่ได้
Dialogue: 0,0:01:46.48,0:01:48.35,Default,,0,0,0,,บังอาจทำลายห้อง...
Dialogue: 0,0:01:49.86,0:01:51.61,Default,,0,0,0,,วิหารของข้าน้อย
Dialogue: 0,0:01:55.74,0:01:58.11,Default,,0,0,0,,ทำร้ายสัตว์เลี้ยง...
Dialogue: 0,0:02:00.28,0:02:02.74,Default,,0,0,0,,ทาสรับใช้ของข้าน้อย
Dialogue: 0,0:02:06.37,0:02:08.29,Default,,0,0,0,,พวกเจ้าต้องชดใช้
Dialogue: 0,0:02:08.33,0:02:10.75,Default,,0,0,0,,เจ้าพวกตุ๊กตาที่มีชีวิต
Dialogue: 0,0:02:10.79,0:02:14.17,Default,,0,0,0,,เหล่าพวกลีฟดอลล์
Dialogue: 0,0:02:18.26,0:02:23.35,Default,,0,0,0,,ทำลายสวนกล่อง\Nหนีออกไป จากอาณาจักรตัวต่อ
Dialogue: 0,0:02:24.77,0:02:27.60,Default,,0,0,0,,กล้าดียังไงมาทำลายอาณาจักรของข้าน้อย
Dialogue: 0,0:02:29.27,0:02:30.90,Default,,0,0,0,,ให้อภัยไม่ได้
Dialogue: 0,0:02:32.90,0:02:35.03,Default,,0,0,0,,ท่านอิสแคตคิดจะทำอะไรกันแน่
Dialogue: 0,0:02:35.15,0:02:37.78,Default,,0,0,0,,ท่านเทพตะวัน โปรดใจเย็นก่อนเถอะครับ
Dialogue: 0,0:02:46.62,0:02:47.87,Default,,0,0,0,,ดูสิ
Dialogue: 0,0:02:47.91,0:02:49.92,Default,,0,0,0,,ท้องฟ้ากับเปลวเพลิงนั่น
Dialogue: 0,0:02:50.04,0:02:52.67,Default,,0,0,0,,ถ้าปล่อยไว้แบบนี้อาณาจักรต้องล่มสลาย
Dialogue: 0,0:02:52.79,0:02:55.13,Default,,0,0,0,,โลกนี้คงจบเห่แน่
Dialogue: 0,0:02:55.59,0:02:57.42,Default,,0,0,0,,ไม่ปล่อยให้หนีไปได้หรอก
Dialogue: 0,0:02:57.46,0:02:59.80,Default,,0,0,0,,หยุดนะ
Dialogue: 0,0:02:59.93,0:03:02.51,Default,,0,0,0,,หมอนั่นน่ากลัวเกินไปแล้ว
Dialogue: 0,0:03:02.64,0:03:05.85,Default,,0,0,0,,เทพอะไรกัน นั่นมันปีศาจชัดๆ
Dialogue: 0,0:03:05.97,0:03:07.81,Default,,0,0,0,,ไอ้เวรเอ๊ย
Dialogue: 0,0:03:12.85,0:03:14.52,Default,,0,0,0,,แบบนี้...ต้องไปทางไหน
Dialogue: 0,0:03:14.65,0:03:16.44,Default,,0,0,0,,เอ่อ...ทางขวา
Dialogue: 0,0:03:18.36,0:03:20.28,Default,,0,0,0,,อิสแคต
Dialogue: 0,0:03:22.41,0:03:23.70,Default,,0,0,0,,อยู่นั่นเองเรอะ
Dialogue: 0,0:03:28.50,0:03:30.12,Default,,0,0,0,,อย่าหนีนะ
Dialogue: 0,0:03:31.04,0:03:33.13,Default,,0,0,0,,เฮ้ ดูสิลูฟี่ นั่นเมืองนี่นา
Dialogue: 0,0:03:33.25,0:03:34.17,Default,,0,0,0,,ใช่
Dialogue: 0,0:03:34.29,0:03:36.13,Default,,0,0,0,,เนินชันๆ แบบนั้นจะข้ามได้ใช่ไหม
Dialogue: 0,0:03:36.25,0:03:39.26,Default,,0,0,0,,ทั้งหมดนี้ทำขึ้นจากตัวต่องั้นเหรอ
Dialogue: 0,0:03:39.76,0:03:41.26,Default,,0,0,0,,สุดยอด
Dialogue: 0,0:03:41.38,0:03:43.97,Default,,0,0,0,,นี่ไม่ใช่เวลามาชื่นชมนะ
Dialogue: 0,0:03:47.31,0:03:49.35,Default,,0,0,0,,แย่แล้ว โดนตามมาทันแล้ว
Dialogue: 0,0:03:49.47,0:03:50.89,Default,,0,0,0,,ยังไงดี วิ่งอ้อมไปไหม
Dialogue: 0,0:03:51.02,0:03:51.81,Default,,0,0,0,,หรือจะฟันมันทิ้ง
Dialogue: 0,0:03:51.94,0:03:53.35,Default,,0,0,0,,ไม่ละ เตะให้กระจุยดีกว่า
Dialogue: 0,0:03:53.48,0:03:54.31,Default,,0,0,0,,ไม่ต้อง
Dialogue: 0,0:03:56.15,0:03:57.57,Default,,0,0,0,,จะชนแล้ว
Dialogue: 0,0:03:57.61,0:03:59.69,Default,,0,0,0,,แบบนี้เราชนแน่
Dialogue: 0,0:04:00.69,0:04:03.91,Default,,0,0,0,,กระโจนไปเลย เจ้าแมว
Dialogue: 0,0:04:06.37,0:04:07.49,Default,,0,0,0,,ท่านอิสแคต
Dialogue: 0,0:04:19.13,0:04:21.17,Default,,0,0,0,,เจ้านั่นอุตส่าห์สร้างมันขึ้นมา
Dialogue: 0,0:04:21.21,0:04:23.76,Default,,0,0,0,,หนีแบบไม่ทำให้มันพังดีกว่า
Dialogue: 0,0:04:29.89,0:04:31.73,Default,,0,0,0,,เสียหลักซะงั้น
Dialogue: 0,0:04:39.73,0:04:41.07,Default,,0,0,0,,เฮ้ย เจ้าแมว
Dialogue: 0,0:04:43.28,0:04:44.95,Default,,0,0,0,,ไม่เป็นไรใช่ไหม คุณนามิ
Dialogue: 0,0:04:45.07,0:04:47.03,Default,,0,0,0,,ขอบคุณนะ ซันจิคุง
Dialogue: 0,0:04:47.16,0:04:48.99,Default,,0,0,0,,ปล่อยสักทีสิเฮ้ย
Dialogue: 0,0:04:49.49,0:04:50.87,Default,,0,0,0,,นายก็ด้วย
Dialogue: 0,0:04:52.37,0:04:54.92,Default,,0,0,0,,เฮ้อ เล่นพลาดท่าซะแรงเลย
Dialogue: 0,0:04:55.37,0:04:57.38,Default,,0,0,0,,ก็บอกแล้วว่าให้ฟันมันทิ้ง
Dialogue: 0,0:04:57.92,0:05:00.21,Default,,0,0,0,,อะไรที่พลาดไปแล้วก็ช่วยไม่ได้
Dialogue: 0,0:05:00.25,0:05:01.59,Default,,0,0,0,,ต่อไปก็หัดระวังด้วยล่ะ
Dialogue: 0,0:05:06.34,0:05:09.85,Default,,0,0,0,,การกระโดดที่บ่าบิ่นหาสิ่งใดเปรียบได้
Dialogue: 0,0:05:11.26,0:05:14.81,Default,,0,0,0,,ความผิดบาปฐานทำลายโลกที่ข้าน้อยสร้างขึ้น
Dialogue: 0,0:05:14.85,0:05:16.60,Default,,0,0,0,,ให้อภัยไม่ได้
Dialogue: 0,0:05:18.52,0:05:19.40,Default,,0,0,0,,มันมาแล้ว
Dialogue: 0,0:05:21.23,0:05:22.11,Default,,0,0,0,,ดีละ
Dialogue: 0,0:05:25.86,0:05:28.07,Default,,0,0,0,,วิ่งไปเลย เจ้าแมว
Dialogue: 0,0:05:35.50,0:05:37.08,Default,,0,0,0,,อิสแคต
Dialogue: 0,0:05:37.54,0:05:40.75,Default,,0,0,0,,เจ้า...ทำไมไปช่วยพวกมัน
Dialogue: 0,0:05:41.92,0:05:44.01,Default,,0,0,0,,หยุดนะ
Dialogue: 0,0:05:48.84,0:05:51.68,Default,,0,0,0,,ได้ขี่แมวแล้ว\Nไม่นานก็ไปถึงสุดขอบโลกได้เลยนะ
Dialogue: 0,0:05:51.81,0:05:52.43,Default,,0,0,0,,เอ๊ะ
Dialogue: 0,0:05:52.89,0:05:54.39,Default,,0,0,0,,ยังต้องไปอีกไกลเลยนะ
Dialogue: 0,0:05:54.52,0:05:58.44,Default,,0,0,0,,ให้ตายสิลูฟี่\Nถึงบอกว่าให้ดูพิมพ์เขียวของอาณาจักรนี้ไง
Dialogue: 0,0:05:58.48,0:06:01.44,Default,,0,0,0,,อ๊าก ทำอะไรของเธอน่ะ
Dialogue: 0,0:06:01.98,0:06:03.65,Default,,0,0,0,,ไม่เป็นไรหรอก จำได้หมดแล้ว
Dialogue: 0,0:06:05.74,0:06:06.90,Default,,0,0,0,,จริงเหรอเนี่ย
Dialogue: 0,0:06:10.49,0:06:11.87,Default,,0,0,0,,ดูสิ ลูฟี่
Dialogue: 0,0:06:11.91,0:06:14.45,Default,,0,0,0,,ประตูกระจกเมื่อกี้นี้สะท้อนอยู่ตรงนั้น
Dialogue: 0,0:06:14.58,0:06:15.95,Default,,0,0,0,,อ๊ะ จริงด้วยสิ
Dialogue: 0,0:06:16.08,0:06:19.17,Default,,0,0,0,,ถ้าดูให้ดีๆ เมฆนั่นก็คือปุยนุ่นที่ห้อยเอาไว้
Dialogue: 0,0:06:25.42,0:06:27.30,Default,,0,0,0,,อ๊ะ จริงด้วย
Dialogue: 0,0:06:28.63,0:06:32.47,Default,,0,0,0,,ต่อให้ดูกว้างแค่ไหน\Nแต่สำหรับคนยักษ์ก็เป็นเพียงแค่ห้องห้องหนึ่ง
Dialogue: 0,0:06:32.60,0:06:36.93,Default,,0,0,0,,พอเป็นกระจกทุกด้าน\Nทิวทัศน์ก็เลยดูเหมือนทอดยาวไม่มีที่สิ้นสุด
Dialogue: 0,0:06:37.06,0:06:38.85,Default,,0,0,0,,เพราะแบบนี้ถึงบอกว่าแป๊บเดียวไงล่ะ
Dialogue: 0,0:06:38.89,0:06:40.60,Default,,0,0,0,,ที่เหลือก็แค่มุ่งไปข้างหน้าอย่างเดียว
Dialogue: 0,0:06:41.23,0:06:43.40,Default,,0,0,0,,เราผ่านมาครึ่งอาณาจักรแล้ว
Dialogue: 0,0:06:44.86,0:06:46.57,Default,,0,0,0,,อีกไม่นานก็ถึง
Dialogue: 0,0:06:47.19,0:06:48.74,Default,,0,0,0,,อย่างนี้นี่เอง
Dialogue: 0,0:06:50.86,0:06:55.45,Default,,0,0,0,,คิดจะดูพิมพ์เขียวของอาณาจักร\Nเพื่อมองโลกนี้ให้ทะลุปรุโปร่งงั้นหรือขอรับ
Dialogue: 0,0:06:55.91,0:06:58.66,Default,,0,0,0,,หมอนั่น ใช้คำพูดเหมือนซามูไรไหมน่ะ
Dialogue: 0,0:06:59.12,0:07:03.38,Default,,0,0,0,,แต่เดิมทีแล้วที่นี่คือดินแดนสำหรับเผ่าคนยักษ์
Dialogue: 0,0:07:03.50,0:07:04.34,Default,,0,0,0,,ตาข่ายเหรอ
Dialogue: 0,0:07:06.50,0:07:08.88,Default,,0,0,0,,ถ้าโดนจับตัวได้ไม่รู้ว่าจะโดนอะไรบ้าง
Dialogue: 0,0:07:09.38,0:07:11.47,Default,,0,0,0,,เร็วเข้า รีบไปที่ผนังเร็ว
Dialogue: 0,0:07:15.06,0:07:21.52,Default,,0,0,0,,สถานที่ที่ออกแบบมาอย่างแน่นหนา\Nไม่ให้แม้แต่เผ่าคนยักษ์หนีออกไปได้
Dialogue: 0,0:07:31.03,0:07:32.95,Default,,0,0,0,,หน็อยแน่ พวกเจ้า
Dialogue: 0,0:07:33.07,0:07:34.70,Default,,0,0,0,,- นั่นเป็นฝีมือตัวเองต่างหากล่ะ\N- นั่นเป็นฝีมือตัวเองต่างหากล่ะ
Dialogue: 0,0:07:37.12,0:07:40.12,Default,,0,0,0,,ต่อให้พวกเจ้าหนีไปจนถึงผนังได้
Dialogue: 0,0:07:40.79,0:07:44.83,Default,,0,0,0,,ก็อย่าคิดว่าจะทำลายได้เลย
Dialogue: 0,0:07:51.80,0:07:54.97,Default,,0,0,0,,แล้วอีกอย่าง ตรงนั้นก็มีแต่ทางตัน
Dialogue: 0,0:07:55.10,0:07:56.18,Default,,0,0,0,,แย่ละสิ
Dialogue: 0,0:07:56.30,0:07:57.26,Default,,0,0,0,,ทำไงดี
Dialogue: 0,0:07:57.39,0:07:58.97,Default,,0,0,0,,อีกแค่นิดเดียวแท้ๆ
Dialogue: 0,0:07:59.10,0:08:01.06,Default,,0,0,0,,เฮ้ย หลบเร็วสิ เจ้าแมว
Dialogue: 0,0:08:06.11,0:08:07.61,Default,,0,0,0,,ทำไมท่านอิสแคตถึงเป็นแบบนี้
Dialogue: 0,0:08:07.73,0:08:09.61,Default,,0,0,0,,เจ้าพวกที่นั่งอยู่บนนั้นเป็นใคร
Dialogue: 0,0:08:09.73,0:08:13.45,Default,,0,0,0,,เอาละ ไปกันเลยดีกว่าเจ้าพวกลีฟดอลล์
Dialogue: 0,0:08:13.49,0:08:16.83,Default,,0,0,0,,กลับมาสู่กำมือของข้าน้อยซะ
Dialogue: 0,0:08:25.08,0:08:26.42,Default,,0,0,0,,รีบๆ...
Dialogue: 0,0:08:29.38,0:08:30.55,Default,,0,0,0,,เดินหน้าต่อซะ
Dialogue: 0,0:08:44.19,0:08:46.52,Default,,0,0,0,,ไปเลย
Dialogue: 0,0:08:48.86,0:08:51.74,Default,,0,0,0,,กลับมานะ อิสแคต
Dialogue: 0,0:08:52.36,0:08:55.70,Default,,0,0,0,,เจ้าพวกนั้นทำลายตาข่ายเหล็กได้งั้นเรอะ
Dialogue: 0,0:09:00.83,0:09:03.91,Default,,0,0,0,,แค่พวกตุ๊กตาไร้กำลัง\Nต่อให้ตะเกียกตะกายแค่ไหน
Dialogue: 0,0:09:03.91,0:09:06.25,Default,,0,0,0,,ก็ไม่ทำให้เนื้อเรื่องของข้าน้อยเปลี่ยนไปหรอก
Dialogue: 0,0:09:06.29,0:09:09.67,Default,,0,0,0,,เจ้าเองก็น่าจะเข้าใจดีนี่ อิสแคต
Dialogue: 0,0:09:09.71,0:09:12.30,Default,,0,0,0,,โทษกบฏมันหนักหนามากนะ
Dialogue: 0,0:09:14.59,0:09:15.72,Default,,0,0,0,,อืม
Dialogue: 0,0:09:15.76,0:09:17.68,Default,,0,0,0,,เขาบอกว่ามัวแต่พูดมากอยู่ได้
Dialogue: 0,0:09:17.80,0:09:21.10,Default,,0,0,0,,ฮะ กล้าดียังไงมาติเตียนเจ้านายอย่างข้าน้อย
Dialogue: 0,0:09:21.14,0:09:25.73,Default,,0,0,0,,แต่ก็เปล่าประโยชน์\Nเพราะข้างหน้านั่นมีเทพใบหูสุดโหดรออยู่
Dialogue: 0,0:09:26.98,0:09:29.36,Default,,0,0,0,,รอเดี๋ยวก่อนครับ ท่านอิสแคต
Dialogue: 0,0:09:30.86,0:09:32.32,Default,,0,0,0,,ท่านเทพตะวันครับ
Dialogue: 0,0:09:32.94,0:09:35.53,Default,,0,0,0,,จริงๆ แล้วท่านเทพใบหูน่ะ
Dialogue: 0,0:09:35.65,0:09:38.53,Default,,0,0,0,,วันนี้ท่านถูกเผาตายไปโดยไม่ทราบสาเหตุ
Dialogue: 0,0:09:39.16,0:09:42.45,Default,,0,0,0,,ช่างเป็นเรื่องที่น่าเศร้าและเป็นลางร้ายอย่างยิ่ง
Dialogue: 0,0:09:42.49,0:09:45.08,Default,,0,0,0,,แถมยังเกิดเหตุอาเพศที่ท้องฟ้าแตกร้าว
Dialogue: 0,0:09:45.21,0:09:47.58,Default,,0,0,0,,ยังมีปราสาทบิ๊กสไตน์ที่พังทลาย
Dialogue: 0,0:09:47.71,0:09:49.29,Default,,0,0,0,,และการเสียสติของท่านอิสแคต
Dialogue: 0,0:09:49.42,0:09:51.67,Default,,0,0,0,,ถือเป็นวันต้องสาปวันหนึ่งเลยครับ
Dialogue: 0,0:09:53.00,0:09:54.63,Default,,0,0,0,,ถูกเล่นงานเหรอ
Dialogue: 0,0:09:55.09,0:09:56.80,Default,,0,0,0,,เป็นไปไม่ได้
Dialogue: 0,0:09:56.84,0:10:00.30,Default,,0,0,0,,นั่นคือกลัตโตบันนี่\Nกระต่ายกินเนื้อที่โหดร้ายที่สุด
Dialogue: 0,0:10:03.14,0:10:07.73,Default,,0,0,0,,ตอนที่เราไปพบ ท่านก็อยู่ในสภาพนี้แล้ว
Dialogue: 0,0:10:14.61,0:10:17.20,Default,,0,0,0,,โปรดควบคุมอารมณ์ของท่านก่อน
Dialogue: 0,0:10:20.28,0:10:22.49,Default,,0,0,0,,ดะ...ได้โปรดใจเย็นก่อนครับ
Dialogue: 0,0:10:27.58,0:10:29.79,Default,,0,0,0,,ท่านเทพตะวัน
Dialogue: 0,0:10:31.42,0:10:32.63,Default,,0,0,0,,ความรัก
Dialogue: 0,0:10:33.88,0:10:35.09,Default,,0,0,0,,ความประเสริฐ
Dialogue: 0,0:10:35.11,0:10:37.09,Default,,0,0,0,,นี่แหละคือโลก
Dialogue: 0,0:10:38.59,0:10:42.39,Default,,0,0,0,,เรื่องราวที่ไม่เคยถูกเขียนเอาไว้\Nในสวนกล่องที่ปิดล้อม
Dialogue: 0,0:10:42.43,0:10:46.31,Default,,0,0,0,,ข้าน้อยประเมินพวกนั้นต่ำเกินไป\Nมันทำให้ข้าน้อยตื่นเต้นซะจริง
Dialogue: 0,0:10:47.64,0:10:50.06,Default,,0,0,0,,โลกที่ข้าน้อยสร้างขึ้นใบนี้
Dialogue: 0,0:10:50.10,0:10:52.44,Default,,0,0,0,,ล้วนมีทั้งความชั่วและวีรบุรุษถือกำเนิดขึ้น
Dialogue: 0,0:10:52.90,0:10:55.15,Default,,0,0,0,,เพื่อสร้างประวัติศาสตร์ต่อไป
Dialogue: 0,0:10:55.61,0:10:59.99,Default,,0,0,0,,เสน่ห์อันล้ำเลิศของลีฟดอลล์ในโลกใบเล็กของข้าน้อย
Dialogue: 0,0:11:04.49,0:11:06.58,Default,,0,0,0,,หมอนั่นหัวเราะอะไรน่ะ
Dialogue: 0,0:11:34.48,0:11:37.78,Default,,0,0,0,,หรือนี่จะเป็นโอกาสดีของเราที่หาไม่ได้อีกแล้ว
Dialogue: 0,0:11:38.44,0:11:40.53,Default,,0,0,0,,ช่องทางหลบหนีกำลังเปิดอยู่
Dialogue: 0,0:11:41.99,0:11:43.70,Default,,0,0,0,,รีบหนีไปกันตอนนี้เลย
Dialogue: 0,0:11:44.12,0:11:45.70,Default,,0,0,0,,ไปบอกทุกคนดีกว่า
Dialogue: 0,0:11:46.87,0:11:51.00,Default,,0,0,0,,กระเสือกกระสนอยู่บนกำมือของข้าน้อยนี่แหละ
Dialogue: 0,0:11:51.04,0:11:54.96,Default,,0,0,0,,ต่อให้ฮัจรูดินจะยอมรับพวกเจ้า\Nแต่ข้าน้อยไม่ยอมรับแน่
Dialogue: 0,0:12:02.05,0:12:02.80,Default,,0,0,0,,ฮัจรูดินเหรอ
Dialogue: 0,0:12:04.89,0:12:06.76,Default,,0,0,0,,เจ้านั่น...
Dialogue: 0,0:12:07.26,0:12:08.72,Default,,0,0,0,,เป็นใครกันแน่
Dialogue: 0,0:12:11.94,0:12:13.10,Default,,0,0,0,,แล้วทีนี้...
Dialogue: 0,0:12:13.14,0:12:15.02,Default,,0,0,0,,คิดจะทำยังไงกันล่ะ
Dialogue: 0,0:12:17.86,0:12:19.98,Default,,0,0,0,,พ้นผ่านต้นไม้ยักษ์นั่นก็ถึงผนังแล้ว
Dialogue: 0,0:12:20.69,0:12:23.11,Default,,0,0,0,,แต่...จะออกไปข้างนอกได้ยังไง
Dialogue: 0,0:12:23.15,0:12:25.03,Default,,0,0,0,,ถ้าโดนจับได้อีกจะยุ่งยากเข้าไปใหญ่นะ
Dialogue: 0,0:12:25.16,0:12:26.53,Default,,0,0,0,,ไม่ยอมให้เป็นแบบนั้นแน่
Dialogue: 0,0:12:28.12,0:12:29.74,Default,,0,0,0,,ระยะจากตรงนี้ต้องไปถึงแน่
Dialogue: 0,0:12:32.08,0:12:34.17,Default,,0,0,0,,ท่าไม้ตาย กระสุนดาวเขียว
Dialogue: 0,0:12:35.75,0:12:37.84,Default,,0,0,0,,หญ้าระเบิดหัวกะโหลก
Dialogue: 0,0:13:13.91,0:13:16.12,Default,,0,0,0,,ทำพังอีกแล้วเหรอเนี่ย
Dialogue: 0,0:13:17.33,0:13:19.71,Default,,0,0,0,,เฮ้ย โทษทีนะ
Dialogue: 0,0:13:19.84,0:13:21.25,Default,,0,0,0,,เรื่องนั้นช่างมันเถอะน่า
Dialogue: 0,0:13:21.38,0:13:23.88,Default,,0,0,0,,ไม่ได้ นายทำพังเยอะเกินไปแล้ว
Dialogue: 0,0:13:24.01,0:13:26.38,Default,,0,0,0,,เข้าใจแล้ว ฉันขอโทษก็ได้
Dialogue: 0,0:13:26.51,0:13:27.97,Default,,0,0,0,,แบบนี้ก็พออภัยให้ได้
Dialogue: 0,0:13:28.09,0:13:31.39,Default,,0,0,0,,แต่ดูนั่นก่อนเถอะ ลูฟี่\Nกระจกแตกไปแล้ว
Dialogue: 0,0:13:31.43,0:13:33.56,Default,,0,0,0,,แต่ผนังดูจะแข็งมากเลยนะ
Dialogue: 0,0:13:33.68,0:13:35.60,Default,,0,0,0,,ใช่แล้ว
Dialogue: 0,0:13:35.64,0:13:37.77,Default,,0,0,0,,พวกเจ้าทำลายไม่ได้หรอก
Dialogue: 0,0:13:38.15,0:13:40.52,Default,,0,0,0,,และไม่สามารถหนีออกไปได้
Dialogue: 0,0:13:42.44,0:13:44.69,Default,,0,0,0,,เยี่ยม...เยี่ยมมาก
Dialogue: 0,0:13:45.40,0:13:47.74,Default,,0,0,0,,ตุ๊กตาไร้กำลังที่ขัดขืนต่อโชคชะตา
Dialogue: 0,0:13:47.78,0:13:49.95,Default,,0,0,0,,ความน่าชื่นชมกับช่วงสำคัญ
Dialogue: 0,0:13:54.33,0:13:57.29,Default,,0,0,0,,ความสูญเปล่าและความสิ้นหวังก็คือโลกเช่นกัน
Dialogue: 0,0:13:57.33,0:13:59.58,Default,,0,0,0,,ความล้มเหลวและความท้อแท้
Dialogue: 0,0:13:59.63,0:14:01.79,Default,,0,0,0,,นั่นก็คือประวัติศาสตร์
Dialogue: 0,0:14:02.38,0:14:06.22,Default,,0,0,0,,พล่ามเรื่องอะไรมาตั้งนานแล้วน่ะ
Dialogue: 0,0:14:07.72,0:14:09.43,Default,,0,0,0,,เฮ้ เจ้าแมว ไปต่อไหวไหม
Dialogue: 0,0:14:19.31,0:14:20.31,Default,,0,0,0,,ไปเลย เจ้าแมว
Dialogue: 0,0:14:20.44,0:14:21.27,Default,,0,0,0,,อย่าโอ้เอ้สิ
Dialogue: 0,0:14:21.40,0:14:22.94,Default,,0,0,0,,หมอนั่นเริ่มเคลื่อนไหวแล้ว
Dialogue: 0,0:14:23.07,0:14:24.28,Default,,0,0,0,,วิ่งไปเร็ว เจ้าแมว
Dialogue: 0,0:14:24.73,0:14:26.44,Default,,0,0,0,,เร็วกว่านี้ไม่ได้เหรอไง
Dialogue: 0,0:14:26.57,0:14:27.78,Default,,0,0,0,,เดี๋ยวก็โดนไล่ทันหรอก
Dialogue: 0,0:14:27.90,0:14:29.24,Default,,0,0,0,,- ให้ฟันมันไหม\N- ฉันเตะให้คว่ำเอง
Dialogue: 0,0:14:29.36,0:14:30.41,Default,,0,0,0,,เจ้าแมว
Dialogue: 0,0:14:31.66,0:14:33.16,Default,,0,0,0,,เขาบอกว่า "หุบปากไปเลย" น่ะ
Dialogue: 0,0:14:33.62,0:14:36.29,Default,,0,0,0,,ช่างอ่อนแอ น่าเวทนา\Nแต่ก็กล้าหาญไม่น้อย
Dialogue: 0,0:14:36.33,0:14:38.08,Default,,0,0,0,,ข้าน้อยซึ้งน้ำตาแตกเลย
Dialogue: 0,0:14:38.12,0:14:40.33,Default,,0,0,0,,ดีใจจริงๆ ที่ได้รับตัวพวกเจ้ามา
Dialogue: 0,0:14:40.38,0:14:41.63,Default,,0,0,0,,ลูฟี่ทาโซะ
Dialogue: 0,0:14:42.59,0:14:43.63,Default,,0,0,0,,โซโลทาโซะ
Dialogue: 0,0:14:43.67,0:14:45.21,Default,,0,0,0,,ซันทาโซะ
Dialogue: 0,0:14:45.25,0:14:46.59,Default,,0,0,0,,อุโซทาโซะ
Dialogue: 0,0:14:46.71,0:14:47.34,Default,,0,0,0,,ฉันเหรอ
Dialogue: 0,0:14:47.47,0:14:48.80,Default,,0,0,0,,ช็อตทาโซะ
Dialogue: 0,0:14:49.68,0:14:50.55,Default,,0,0,0,,นามิทาโซะ
Dialogue: 0,0:14:50.68,0:14:51.76,Default,,0,0,0,,เดี๋ยวก่อนนะ
Dialogue: 0,0:14:52.22,0:14:54.60,Default,,0,0,0,,เขารู้ได้ยังไงว่าเราคือใครน่ะ
Dialogue: 0,0:14:54.72,0:14:56.06,Default,,0,0,0,,แล้วทาโซะนี่คืออะไร
Dialogue: 0,0:15:06.19,0:15:07.82,Default,,0,0,0,,จู่ๆ หมอนั่นเป็นอะไรไปน่ะ
Dialogue: 0,0:15:07.94,0:15:11.78,Default,,0,0,0,,อย่าเพิ่งสนใจเลย จะเอายังไงต่อ\Nปล่อยไว้แบบนี้โดนไล่ตามทันแน่
Dialogue: 0,0:15:11.91,0:15:13.83,Default,,0,0,0,,นี่ อุซป
Dialogue: 0,0:15:13.87,0:15:16.66,Default,,0,0,0,,ภัยพิบัตินี่มันโทษใครไม่ได้อยู่แล้วใช่ไหม
Dialogue: 0,0:15:16.79,0:15:20.75,Default,,0,0,0,,เอ๊ะ เรื่องนั้นก็ใช่\Nทั้งแผ่นดินไหว น้ำท่วมและฟ้าผ่า
Dialogue: 0,0:15:20.79,0:15:22.75,Default,,0,0,0,,ไม่มีใครเป็นคนลงมือทั้งนั้น
Dialogue: 0,0:15:23.25,0:15:27.42,Default,,0,0,0,,พวกเรา เพิ่งเจอเหตุร้ายมากับตัวเลยนี่เนอะ
Dialogue: 0,0:15:32.59,0:15:34.55,Default,,0,0,0,,เอาจริง เจ้าหมอนั่น
Dialogue: 0,0:15:34.60,0:15:35.56,Default,,0,0,0,,ฉันหมั่นไส้มาก
Dialogue: 0,0:15:36.10,0:15:38.47,Default,,0,0,0,,เอาน่า แต่เผ่าคนยักษ์น่ะ...
Dialogue: 0,0:15:38.60,0:15:40.02,Default,,0,0,0,,ผมเข้าใจเลย คุณนามิ
Dialogue: 0,0:15:40.06,0:15:44.11,Default,,0,0,0,,ความโกรธนั่น\Nผมเองก็รู้สึกต่อหมอนั่นมาสักพักแล้ว
Dialogue: 0,0:15:44.56,0:15:46.36,Default,,0,0,0,,เพราะผมคิดมาตลอดว่า...
Dialogue: 0,0:15:46.40,0:15:47.61,Default,,0,0,0,,ไอ้สวะนั่น
Dialogue: 0,0:15:48.15,0:15:51.49,Default,,0,0,0,,บังอาจทำให้คุณนามิต้องเปลี่ยนชุด
Dialogue: 0,0:15:54.32,0:15:55.37,Default,,0,0,0,,ลุยเลยดีกว่า
Dialogue: 0,0:15:55.70,0:15:58.62,Default,,0,0,0,,เดี๋ยวนะ ซันจิ\Nหัดฟังคนอื่นเตือนซะบ้างสิ
Dialogue: 0,0:15:58.74,0:16:00.79,Default,,0,0,0,,ฉันไม่รับฟังคำพูดของใครทั้งนั้น
Dialogue: 0,0:16:00.91,0:16:02.96,Default,,0,0,0,,แบบนั้นไม่ได้นะ ซันจิคุง
Dialogue: 0,0:16:03.08,0:16:04.29,Default,,0,0,0,,ทำไมล่ะ คุณนามิ
Dialogue: 0,0:16:04.42,0:16:06.00,Default,,0,0,0,,ก็อีกไม่นาน...
Dialogue: 0,0:16:06.38,0:16:08.50,Default,,0,0,0,,สวรรค์ต้องลงทัณฑ์มันแน่
Dialogue: 0,0:16:34.16,0:16:36.57,Default,,0,0,0,,มูกินน์ เป็นอะไรไปเหรอขอรับ
Dialogue: 0,0:16:37.03,0:16:39.49,Default,,0,0,0,,ไปขนอะไรมาอีกแล้วเหรอขอรับเนี่ย
Dialogue: 0,0:16:50.25,0:16:52.80,Default,,0,0,0,,โอ๊ย นี่มันกลุ่มหมวกฟางนี่นา
Dialogue: 0,0:16:52.84,0:16:56.51,Default,,0,0,0,,กลุ่มโจรสลัดนักรบยักษ์เพิ่งจะออกไปรับตัวมานี่
Dialogue: 0,0:16:56.55,0:16:58.97,Default,,0,0,0,,ไปเก็บมาจากที่ไหนเหรอขอรับ
Dialogue: 0,0:17:00.26,0:17:03.85,Default,,0,0,0,,ยังไม่รู้ตัวอีกใช่ไหมเนี่ย\Nหลับลึกกันน่าดูเลย
Dialogue: 0,0:17:03.89,0:17:08.36,Default,,0,0,0,,อย่าบอกนะว่าแล่นเรือผ่าน\Nเขตหมอกนิทราที่อยู่ระหว่างเส้นทางไปเอ็กเฮดน่ะ
Dialogue: 0,0:17:12.44,0:17:15.07,Default,,0,0,0,,แต่ว่านี่เป็นเรื่องโชคดีที่คาดไม่ถึงเลย
Dialogue: 0,0:17:15.74,0:17:18.28,Default,,0,0,0,,กลุ่มหมวกฟาง
Dialogue: 0,0:17:19.16,0:17:24.83,Default,,0,0,0,,พูดตรงๆ ว่าข้าน้อยได้ยินมาว่า\Nฮัจรูดินดันไปเป็นลูกน้องให้เจ้าพวกนี้
Dialogue: 0,0:17:24.87,0:17:26.67,Default,,0,0,0,,ทำให้ข้าน้อยมีน้ำโห
Dialogue: 0,0:17:29.00,0:17:30.55,Default,,0,0,0,,เฮ้ เดี๋ยวก่อน ฮัจรูดิน
Dialogue: 0,0:17:30.59,0:17:32.92,Default,,0,0,0,,ข้ารู้เรื่องแล้วนะ\Nเจ้ายังสติดีอยู่ไหม
Dialogue: 0,0:17:33.97,0:17:38.34,Default,,0,0,0,,กลุ่มโจรสลัดนักรบยักษ์ใหม่อย่างข้าน้อย\Nต้องเป็นลูกน้องของเจ้าพวกนี้ด้วยเรอะ
Dialogue: 0,0:17:38.39,0:17:43.22,Default,,0,0,0,,นักรบเอลบัฟที่แข็งแกร่งที่สุดในโลก\Nต้องเป็นลูกน้องของมนุษย์ตัวจิ๋วเรอะ
Dialogue: 0,0:17:43.27,0:17:46.48,Default,,0,0,0,,ไม่มีศักดิ์ศรีเลยเหรอไง
Dialogue: 0,0:17:47.77,0:17:50.65,Default,,0,0,0,,ดูสิ ร่างกายที่กระจิริดและดูอ่อนแอแบบนี้
Dialogue: 0,0:17:50.69,0:17:53.73,Default,,0,0,0,,นอนหลับสนิทไร้การป้องกันใดๆ\Nช่างน่าสมเพชเสียจริง
Dialogue: 0,0:17:59.74,0:18:03.37,Default,,0,0,0,,แต่คนนี้...ดะ...โดนใจใช่เลย
Dialogue: 0,0:18:04.29,0:18:05.83,Default,,0,0,0,,นามิทาโซะ
Dialogue: 0,0:18:08.17,0:18:08.79,Default,,0,0,0,,โอ๊ะ
Dialogue: 0,0:18:21.05,0:18:23.76,Default,,0,0,0,,ทำให้หลับนานอีกหน่อยดีกว่า
Dialogue: 0,0:18:23.81,0:18:26.18,Default,,0,0,0,,เมื่อลืมตาตื่นขึ้นมา...
Dialogue: 0,0:18:28.64,0:18:31.23,Default,,0,0,0,,ก็ปล่อยให้หายสาบสูญไปทั้งอย่างนี้เลยดีกว่า
Dialogue: 0,0:18:32.73,0:18:36.36,Default,,0,0,0,,จงอาละวาดอยู่ที่นี่\Nใช้ชีวิตอยู่กับข้าน้อยตลอดไปซะเถอะ
Dialogue: 0,0:18:36.40,0:18:39.32,Default,,0,0,0,,ข้าน้อยจะไม่ยอมอยู่ใต้พวกเจ้า\Nแต่อยู่เหนือพวกเจ้าได้
Dialogue: 0,0:18:45.91,0:18:49.33,Default,,0,0,0,,อะไรกัน เมฆแบบนี้\Nจำไม่ได้ว่าเคยสร้างตอนไหน
Dialogue: 0,0:18:49.46,0:18:51.67,Default,,0,0,0,,เตรียมตัวพร้อมไหม ซุส
Dialogue: 0,0:18:54.80,0:18:57.13,Default,,0,0,0,,ชาร์จพลังเต็มที่แล้วละ นามิ
Dialogue: 0,0:18:57.97,0:18:59.43,Default,,0,0,0,,ถ้างั้นก็ฝากด้วยนะ
Dialogue: 0,0:19:01.30,0:19:02.47,Default,,0,0,0,,อสนีบาต
Dialogue: 0,0:19:04.64,0:19:07.39,Default,,0,0,0,,ไปกันเลย
Dialogue: 0,0:19:26.70,0:19:29.62,Default,,0,0,0,,ท่านเทพตะวัน
Dialogue: 0,0:19:47.35,0:19:49.93,Default,,0,0,0,,จะบ้าเหรอไง\Nทำเกินไปแล้วนะ
Dialogue: 0,0:19:49.98,0:19:51.98,Default,,0,0,0,,จะรับผิดชอบยังไงฮะ
Dialogue: 0,0:19:54.86,0:19:57.57,Default,,0,0,0,,เป็นสวรรค์ลงทัณฑ์นี่นา ช่วยไม่ได้
Dialogue: 0,0:20:00.82,0:20:03.45,Default,,0,0,0,,เธอตั้งใจฟาดสายฟ้าลงมาเต็มที่เลยไม่ใช่เหรอ
Dialogue: 0,0:20:05.41,0:20:09.50,Default,,0,0,0,,ดีละ เดินหน้าต่อไปแบบนั้นแหละ เจ้าแมว
Dialogue: 0,0:20:17.92,0:20:20.13,Default,,0,0,0,,กระโจนไปเลย เจ้าแมว
Dialogue: 0,0:20:29.81,0:20:32.02,Default,,0,0,0,,เกียร์โฟร์ทเบาๆ
Dialogue: 0,0:20:37.77,0:20:41.36,Default,,0,0,0,,ถึงจะน่าเสียดายนิดหน่อย แต่ขอตัวก่อนนะ\Nอาณาจักรตัวต่อ
Dialogue: 0,0:20:41.94,0:20:43.61,Default,,0,0,0,,ไปข้างนอกได้สักทีนะ
Dialogue: 0,0:20:44.45,0:20:46.45,Default,,0,0,0,,สมน้ำหน้า เจ้าคนยักษ์ลามก
Dialogue: 0,0:20:46.91,0:20:49.99,Default,,0,0,0,,ขอให้ข้างนอกนั่นเป็นเอลบัฟทีเถอะ
Dialogue: 0,0:20:52.58,0:20:55.62,Default,,0,0,0,,หมัดยางยืด...
Dialogue: 0,0:20:56.08,0:20:58.63,Default,,0,0,0,,คองกัน
Dialogue: 0,0:21:16.10,0:21:18.06,Default,,0,0,0,,ออกไปข้างนอกแล้ว
Dialogue: 0,0:21:24.57,0:21:30.53,Default,,0,0,0,,(โปรดติดตามตอนต่อไป)
Dialogue: 0,0:23:05.34,0:23:08.51,Default,,0,0,0,,สิ่งที่อยู่ตรงหน้ากลุ่มหมวกฟาง\Nหลังจากกระโจนออกจากอาณาจักรตัวต่อแล้ว
Dialogue: 0,0:23:08.55,0:23:11.89,Default,,0,0,0,,คือทิวทัศน์ที่เต็มไปด้วยหิมะอันกว้างใหญ่\Nและสะพานแขวนขนาดมหึมา
Dialogue: 0,0:23:11.93,0:23:14.10,Default,,0,0,0,,โชคชะตาที่รออยู่คือสวรรค์หรือนรก
Dialogue: 0,0:23:14.68,0:23:20.64,Default,,0,0,0,,เบื้องหน้าที่ลูฟี่กำลังก้าวย่างเข้าไปเพียงคนเดียว\Nได้ปรากฏร่างของเจ้าของเสียงคำรามที่น่าสะท้าน
Dialogue: 0,0:23:20.77,0:23:22.27,Default,,0,0,0,,ตอนต่อไปของ “วันพีซ”
Dialogue: 0,0:23:22.31,0:23:25.52,Default,,0,0,0,,การเผชิญหน้าบนทุ่งหิมะ\Nโลกิ เจ้าชายผู้ถูกสาป
Dialogue: 0,0:23:25.57,0:23:30.57,Default,,0,0,0,,ฉันจะเป็นราชาโจรสลัดให้ได้เลย

