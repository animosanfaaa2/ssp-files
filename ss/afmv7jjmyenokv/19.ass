Dialogue: 0,0:01:44.31,0:01:46.11,Default,,0,0,0,,Không thể tha thứ!
Dialogue: 0,0:01:46.48,0:01:48.36,Default,,0,0,0,,Căn phòng của ta...
Dialogue: 0,0:01:49.86,0:01:51.61,Default,,0,0,0,,Đền thờ của ta...
Dialogue: 0,0:01:55.74,0:01:58.12,Default,,0,0,0,,Thú cưng của ta...
Dialogue: 0,0:02:00.29,0:02:02.75,Default,,0,0,0,,Bề tôi của ta...
Dialogue: 0,0:02:06.38,0:02:08.30,Default,,0,0,0,,Ta sẽ bắt các ngươi phải trả giá...
Dialogue: 0,0:02:08.34,0:02:14.18,Default,,0,0,0,,Những con búp bê sống của ta!
Dialogue: 0,0:02:18.26,0:02:23.35,Default,,0,0,0,,Phá hủy Khu vườn nhỏ!\NThoát khỏi Vương quốc khối xếp hình!
Dialogue: 0,0:02:24.77,0:02:27.61,Default,,0,0,0,,Các ngươi dám phá hoại vương quốc của ta!
Dialogue: 0,0:02:29.27,0:02:30.90,Default,,0,0,0,,Không thể tha thứ.
Dialogue: 0,0:02:32.90,0:02:35.03,Default,,0,0,0,,Ngài Iscat đang làm gì vậy?!
Dialogue: 0,0:02:35.16,0:02:37.78,Default,,0,0,0,,Thần Mặt Trời! Xin ngài nguôi giận!
Dialogue: 0,0:02:46.63,0:02:47.88,Default,,0,0,0,,Nhìn kìa!
Dialogue: 0,0:02:47.92,0:02:49.92,Default,,0,0,0,,Bầu trời đằng kia! Ngọn lửa đó!
Dialogue: 0,0:02:50.05,0:02:52.67,Default,,0,0,0,,Nếu không làm gì,\Nvương quốc sẽ tiêu tùng mất!
Dialogue: 0,0:02:52.80,0:02:55.13,Default,,0,0,0,,Thế giới sẽ diệt vong!
Dialogue: 0,0:02:55.59,0:02:57.43,Default,,0,0,0,,Đừng hòng thoát!
Dialogue: 0,0:02:57.47,0:02:59.81,Default,,0,0,0,,Đứng lại!
Dialogue: 0,0:02:59.93,0:03:02.52,Default,,0,0,0,,Hắn định giết chúng ta thật kìa!
Dialogue: 0,0:03:02.64,0:03:05.85,Default,,0,0,0,,Thần linh gì chứ? Trông giống ác quỷ hơn.
Dialogue: 0,0:03:05.98,0:03:07.81,Default,,0,0,0,,Tên khốn đó.
Dialogue: 0,0:03:12.86,0:03:14.53,Default,,0,0,0,,Đ-Đi hướng nào đây?
Dialogue: 0,0:03:14.65,0:03:16.45,Default,,0,0,0,,Ừm... Bên phải!
Dialogue: 0,0:03:18.37,0:03:20.28,Default,,0,0,0,,Iscat.
Dialogue: 0,0:03:22.41,0:03:23.70,Default,,0,0,0,,Mày đây rồi!
Dialogue: 0,0:03:28.50,0:03:30.13,Default,,0,0,0,,Đừng có chạy!
Dialogue: 0,0:03:31.04,0:03:33.13,Default,,0,0,0,,Này, nhìn kìa, Luffy! Một thị trấn!
Dialogue: 0,0:03:33.26,0:03:34.17,Default,,0,0,0,,Ừ!
Dialogue: 0,0:03:34.30,0:03:36.13,Default,,0,0,0,,Qua được ngọn đồi dốc đó không?
Dialogue: 0,0:03:36.26,0:03:39.26,Default,,0,0,0,,Toàn bộ đều là khối xếp hình à?
Dialogue: 0,0:03:39.76,0:03:41.26,Default,,0,0,0,,Đỉnh dữ!
Dialogue: 0,0:03:41.39,0:03:43.97,Default,,0,0,0,,Giờ không phải lúc trầm trồ đâu!
Dialogue: 0,0:03:47.31,0:03:49.35,Default,,0,0,0,,Nguy rồi! Hắn sắp đuổi kịp!
Dialogue: 0,0:03:49.48,0:03:50.90,Default,,0,0,0,,Làm sao đây?! Đi đường vòng sao?
Dialogue: 0,0:03:51.02,0:03:51.82,Default,,0,0,0,,Chém nó nhé?
Dialogue: 0,0:03:51.94,0:03:53.36,Default,,0,0,0,,Không, để tôi đá nó.
Dialogue: 0,0:03:53.48,0:03:54.32,Default,,0,0,0,,Không...
Dialogue: 0,0:03:56.15,0:03:57.57,Default,,0,0,0,,Đâm mất thôi!
Dialogue: 0,0:03:57.61,0:03:59.70,Default,,0,0,0,,Đâm mất!
Dialogue: 0,0:04:00.70,0:04:03.91,Default,,0,0,0,,Nhảy đi, Mèo!
Dialogue: 0,0:04:06.37,0:04:07.50,Default,,0,0,0,,Ngài Iscat?!
Dialogue: 0,0:04:19.13,0:04:21.18,Default,,0,0,0,,Hắn đã mất công làm thứ này.
Dialogue: 0,0:04:21.22,0:04:23.76,Default,,0,0,0,,Phải cố giữ nó nguyên vẹn\Nmà trốn thoát chứ.
Dialogue: 0,0:04:29.90,0:04:31.73,Default,,0,0,0,,Rơi rồi!
Dialogue: 0,0:04:39.74,0:04:41.07,Default,,0,0,0,,Này, Mèo!
Dialogue: 0,0:04:43.28,0:04:44.95,Default,,0,0,0,,Không sao chứ, Nami?
Dialogue: 0,0:04:45.08,0:04:47.04,Default,,0,0,0,,Cảm ơn, Sanji.
Dialogue: 0,0:04:47.16,0:04:49.00,Default,,0,0,0,,Buông ra coi.
Dialogue: 0,0:04:49.50,0:04:50.87,Default,,0,0,0,,Cả cậu nữa.
Dialogue: 0,0:04:52.38,0:04:54.92,Default,,0,0,0,,Trời ạ... tanh bành hết rồi.
Dialogue: 0,0:04:55.38,0:04:57.38,Default,,0,0,0,,Đã bảo để tôi chém nó rồi mà.
Dialogue: 0,0:04:57.92,0:05:00.22,Default,,0,0,0,,Thôi, chuyện đã rồi.
Dialogue: 0,0:05:00.26,0:05:01.59,Default,,0,0,0,,Lần sau phải cẩn thận đấy!
Dialogue: 0,0:05:06.35,0:05:09.85,Default,,0,0,0,,Một cú nhảy liều lĩnh không kiềm chế.
Dialogue: 0,0:05:11.27,0:05:14.82,Default,,0,0,0,,Tội ác\Nphá hủy thế giới do ta tạo ra.
Dialogue: 0,0:05:14.86,0:05:16.61,Default,,0,0,0,,Không thể tha thứ!
Dialogue: 0,0:05:18.53,0:05:19.40,Default,,0,0,0,,Hắn đến kìa!
Dialogue: 0,0:05:21.24,0:05:22.11,Default,,0,0,0,,Được rồi!
Dialogue: 0,0:05:25.87,0:05:28.08,Default,,0,0,0,,Chạy đi, Mèo!
Dialogue: 0,0:05:35.50,0:05:37.09,Default,,0,0,0,,Iscat!
Dialogue: 0,0:05:37.55,0:05:40.76,Default,,0,0,0,,Sao ngươi lại giúp bọn chúng?
Dialogue: 0,0:05:41.93,0:05:44.01,Default,,0,0,0,,Dừng lại ngay!
Dialogue: 0,0:05:48.85,0:05:51.69,Default,,0,0,0,,Mèo sẽ đưa chúng ta\Nđến rìa sớm thôi.
Dialogue: 0,0:05:51.81,0:05:52.44,Default,,0,0,0,,Hả?
Dialogue: 0,0:05:52.89,0:05:54.40,Default,,0,0,0,,Trông nó có vẻ vô tận mà.
Dialogue: 0,0:05:54.52,0:05:58.44,Default,,0,0,0,,Trời ạ, Luffy. Nhìn bản thiết kế đi...
Dialogue: 0,0:05:58.48,0:06:01.44,Default,,0,0,0,,Làm cái quái gì vậy?!
Dialogue: 0,0:06:01.99,0:06:03.66,Default,,0,0,0,,Không sao. Tớ nhớ hết rồi!
Dialogue: 0,0:06:05.74,0:06:06.91,Default,,0,0,0,,Thật hả?
Dialogue: 0,0:06:10.50,0:06:11.87,Default,,0,0,0,,Nhìn kìa, Luffy.
Dialogue: 0,0:06:11.91,0:06:14.46,Default,,0,0,0,,Cánh cửa gương mà chúng ta vừa thấy\Nđang phản chiếu ở đằng kia.
Dialogue: 0,0:06:14.58,0:06:15.96,Default,,0,0,0,,Ồ, cậu nói đúng.
Dialogue: 0,0:06:16.08,0:06:19.17,Default,,0,0,0,,Nếu nhìn kỹ, những đám mây kia\Nchỉ là bông treo thôi.
Dialogue: 0,0:06:25.43,0:06:27.30,Default,,0,0,0,,Ồ, đúng thật.
Dialogue: 0,0:06:28.64,0:06:32.48,Default,,0,0,0,,Trông có vẻ rộng lớn,\Nnhưng nó chỉ là căn phòng của Người khổng lồ.
Dialogue: 0,0:06:32.60,0:06:36.94,Default,,0,0,0,,Với gương ở mọi hướng,\Nthảo nào phong cảnh lại kéo dài vô tận.
Dialogue: 0,0:06:37.06,0:06:38.86,Default,,0,0,0,,Nên chúng ta sẽ đến ngay thôi.
Dialogue: 0,0:06:38.90,0:06:40.61,Default,,0,0,0,,Cứ đi thẳng là được.
Dialogue: 0,0:06:41.23,0:06:43.40,Default,,0,0,0,,Đã đi qua nửa vương quốc rồi.
Dialogue: 0,0:06:44.86,0:06:46.57,Default,,0,0,0,,Sẽ đến nơi ngay thôi.
Dialogue: 0,0:06:47.20,0:06:48.74,Default,,0,0,0,,Ra vậy.
Dialogue: 0,0:06:50.87,0:06:55.46,Default,,0,0,0,,Các ngươi nghĩ chỉ cần nhìn bản thiết kế\Nlà biết mọi thứ về thế giới này sao?
Dialogue: 0,0:06:55.92,0:06:58.67,Default,,0,0,0,,Tự dưng nói chuyện kiểu Samurai hả?
Dialogue: 0,0:06:59.13,0:07:03.38,Default,,0,0,0,,Nhưng đây vốn dĩ\Nlà phòng giam dành cho Người khổng lồ.
Dialogue: 0,0:07:03.51,0:07:04.34,Default,,0,0,0,,Lưới?
Dialogue: 0,0:07:06.51,0:07:08.89,Default,,0,0,0,,Bị bắt là không biết\Nsẽ bị hắn làm gì đâu!
Dialogue: 0,0:07:09.39,0:07:11.47,Default,,0,0,0,,Nhanh tới bức tường đi!
Dialogue: 0,0:07:15.06,0:07:17.62,Default,,0,0,0,,Một nơi mà ngay cả Người Khổng Lồ\Ncũng không thể thoát.
Dialogue: 0,0:07:18.24,0:07:21.52,Default,,0,0,0,,Các ngươi nghĩ có thể thoát được sao?
Dialogue: 0,0:07:31.03,0:07:32.95,Default,,0,0,0,,Khốn kiếp!
Dialogue: 0,0:07:33.08,0:07:34.70,Default,,0,0,0,,Vừa rồi là tại ngươi mà!
Dialogue: 0,0:07:37.12,0:07:40.13,Default,,0,0,0,,Dù các ngươi có đến được bức tường...
Dialogue: 0,0:07:40.79,0:07:44.84,Default,,0,0,0,,cũng không phá vỡ được nó đâu!
Dialogue: 0,0:07:51.81,0:07:54.97,Default,,0,0,0,,Và chỗ đó\Nchỉ là ngõ cụt mà thôi.
Dialogue: 0,0:07:55.10,0:07:56.18,Default,,0,0,0,,Ôi không!
Dialogue: 0,0:07:56.31,0:07:57.27,Default,,0,0,0,,Làm sao đây?
Dialogue: 0,0:07:57.39,0:07:58.98,Default,,0,0,0,,Chỉ còn còn xíu thôi mà!
Dialogue: 0,0:07:59.10,0:08:01.06,Default,,0,0,0,,Này, sao không né, Mèo?!
Dialogue: 0,0:08:06.11,0:08:07.61,Default,,0,0,0,,Sao ngài Iscat lại bị bắt?
Dialogue: 0,0:08:07.74,0:08:09.61,Default,,0,0,0,,Ai ở trên lưng ngài ấy vậy?
Dialogue: 0,0:08:09.74,0:08:13.45,Default,,0,0,0,,Nào, qua đây, lũ búp bê sống.
Dialogue: 0,0:08:13.49,0:08:16.83,Default,,0,0,0,,Quay về với ta nào.
Dialogue: 0,0:08:25.09,0:08:26.42,Default,,0,0,0,,Cứ...
Dialogue: 0,0:08:29.38,0:08:30.55,Default,,0,0,0,,tiếp tục tiến lên!
Dialogue: 0,0:08:44.19,0:08:46.53,Default,,0,0,0,,Tiến lên!
Dialogue: 0,0:08:48.86,0:08:51.74,Default,,0,0,0,,Quay lại đây, Iscat!
Dialogue: 0,0:08:52.37,0:08:55.70,Default,,0,0,0,,Chúng xé toạc cả dây kim loại sao?
Dialogue: 0,0:09:00.83,0:09:06.25,Default,,0,0,0,,Dù lũ búp bê ác ngươi có vùng vẫy thế nào,\Nkịch bản của ta vẫn không thay đổi!
Dialogue: 0,0:09:06.30,0:09:09.67,Default,,0,0,0,,Mày biết điều đó mà, Iscat?!
Dialogue: 0,0:09:09.72,0:09:12.30,Default,,0,0,0,,Cái giá của sự phản bội rất đắt đấy!
Dialogue: 0,0:09:15.76,0:09:17.68,Default,,0,0,0,,Nó bảo: "lải nhải điếc tai quá!"
Dialogue: 0,0:09:17.81,0:09:21.10,Default,,0,0,0,,Cái gì? Mày dám nói với chủ nhân\Nnhư vậy sao?
Dialogue: 0,0:09:21.14,0:09:25.73,Default,,0,0,0,,Nhưng vô ích. Thần Tai hung bạo\Nđang ở ngay phía trước.
Dialogue: 0,0:09:26.98,0:09:29.36,Default,,0,0,0,,Xin hãy dừng lại, ngài Iscat!
Dialogue: 0,0:09:30.86,0:09:32.32,Default,,0,0,0,,Thần Mặt Trời
Dialogue: 0,0:09:32.95,0:09:35.53,Default,,0,0,0,,Về ngài Thần Tai...
Dialogue: 0,0:09:35.66,0:09:38.54,Default,,0,0,0,,Ngài ấy đã bỏ mạng trong một vụ hỏa hoạn\Nkhông rõ nguyên nhân.
Dialogue: 0,0:09:39.16,0:09:42.46,Default,,0,0,0,,Ngay khi chúng tôi biết được tin dữ...
Dialogue: 0,0:09:42.50,0:09:45.09,Default,,0,0,0,,thì bầu trời đã nứt ra\Nmột cách bí ẩn!
Dialogue: 0,0:09:45.21,0:09:47.59,Default,,0,0,0,,Lâu đài Bigstein cũng bị hư hại nặng nề.
Dialogue: 0,0:09:47.71,0:09:49.30,Default,,0,0,0,,Và ngài Iscat đã phát điên rồi!
Dialogue: 0,0:09:49.42,0:09:51.67,Default,,0,0,0,,Đúng là một ngày bị nguyền rủa!
Dialogue: 0,0:09:53.01,0:09:54.64,Default,,0,0,0,,Nó đã bị đánh bại sao?
Dialogue: 0,0:09:55.10,0:09:56.81,Default,,0,0,0,,Không thể nào!
Dialogue: 0,0:09:56.85,0:10:00.31,Default,,0,0,0,,Glut-Bunny, con thỏ ăn thịt hung bạo đó,\Nđã bị đánh bại ư?
Dialogue: 0,0:10:03.14,0:10:07.73,Default,,0,0,0,,Khi chúng tôi nhận ra\Nthì ngài ấy đã ở trong tình trạng này!
Dialogue: 0,0:10:14.61,0:10:17.20,Default,,0,0,0,,Xin ngài nguôi giận!
Dialogue: 0,0:10:20.29,0:10:22.50,Default,,0,0,0,,X-Xin hãy nguôi giận!
Dialogue: 0,0:10:27.59,0:10:29.80,Default,,0,0,0,,Thần Mặt Trời?
Dialogue: 0,0:10:31.42,0:10:32.63,Default,,0,0,0,,Tuyệt vời!
Dialogue: 0,0:10:33.88,0:10:37.14,Default,,0,0,0,,Thật quý giá!\NĐây cũng là cách một thế giới vận hành!
Dialogue: 0,0:10:38.60,0:10:42.39,Default,,0,0,0,,Một vở kịch không có kịch bản\Ntrong một khu vườn thu nhỏ khép kín.
Dialogue: 0,0:10:42.43,0:10:46.31,Default,,0,0,0,,Ta đã đánh giá thấp chúng!\NChúng đang mang đến một sự phấn khích tột độ.
Dialogue: 0,0:10:47.65,0:10:50.07,Default,,0,0,0,,Trong thế giới do ta tạo ra,
Dialogue: 0,0:10:50.11,0:10:52.44,Default,,0,0,0,,cái ác và những anh hùng đã được sinh ra,
Dialogue: 0,0:10:52.90,0:10:55.15,Default,,0,0,0,,và lịch sử đã được bắt đầu!
Dialogue: 0,0:10:55.61,0:10:59.99,Default,,0,0,0,,Búp bê sống thêm phần quyến rũ tinh tế\Ncho thế giới thu nhỏ của riêng ta!
Dialogue: 0,0:11:04.50,0:11:06.58,Default,,0,0,0,,Hắn cười cái gì vậy?
Dialogue: 0,0:11:34.49,0:11:37.78,Default,,0,0,0,,Có khi đây là cơ hội duy nhất\Ncủa chúng ta đấy.
Dialogue: 0,0:11:38.45,0:11:40.53,Default,,0,0,0,,Lối ra đã mở!
Dialogue: 0,0:11:41.99,0:11:43.70,Default,,0,0,0,,Phải tranh thủ chạy thôi.
Dialogue: 0,0:11:44.12,0:11:45.71,Default,,0,0,0,,Báo cho mọi người đi!
Dialogue: 0,0:11:46.87,0:11:51.00,Default,,0,0,0,,Cứ vùng vẫy đi! Trong lòng bàn tay của ta!
Dialogue: 0,0:11:51.04,0:11:54.96,Default,,0,0,0,,Cho dù Hajrudin thừa nhận các ngươi,\Nta thì không!
Dialogue: 0,0:12:02.06,0:12:02.81,Default,,0,0,0,,Hajrudin?
Dialogue: 0,0:12:04.89,0:12:06.77,Default,,0,0,0,,Tên khốn này...
Dialogue: 0,0:12:07.27,0:12:08.73,Default,,0,0,0,,là ai nhỉ?
Dialogue: 0,0:12:11.94,0:12:13.11,Default,,0,0,0,,Nào...
Dialogue: 0,0:12:13.15,0:12:15.03,Default,,0,0,0,,các ngươi sẽ làm gì?
Dialogue: 0,0:12:17.86,0:12:19.99,Default,,0,0,0,,Bức tường ở phía sau cái cây lớn kia!
Dialogue: 0,0:12:20.70,0:12:23.12,Default,,0,0,0,,Nhưng làm sao để thoát ra ngoài?
Dialogue: 0,0:12:23.16,0:12:25.04,Default,,0,0,0,,Lại bị bắt thì nguy to đấy.
Dialogue: 0,0:12:25.16,0:12:26.54,Default,,0,0,0,,Không phải lo.
Dialogue: 0,0:12:28.12,0:12:29.75,Default,,0,0,0,,Từ đây là trong tầm ngắm rồi.
Dialogue: 0,0:12:32.09,0:12:34.17,Default,,0,0,0,,Tuyệt kỹ Ngôi Sao Xanh!
Dialogue: 0,0:12:35.76,0:12:37.84,Default,,0,0,0,,Đầu lâu Bộc thảo!
Dialogue: 0,0:13:13.92,0:13:16.13,Default,,0,0,0,,Lại phá hỏng một đống nữa rồi.
Dialogue: 0,0:13:17.34,0:13:19.72,Default,,0,0,0,,Này, xin lỗi nhé!
Dialogue: 0,0:13:19.84,0:13:21.26,Default,,0,0,0,,Có sao đâu!
Dialogue: 0,0:13:21.38,0:13:23.89,Default,,0,0,0,,Có sao chứ! Cậu phá hủy nhiều quá rồi đấy!
Dialogue: 0,0:13:24.01,0:13:26.39,Default,,0,0,0,,Được rồi! Xin lỗi được chưa!
Dialogue: 0,0:13:26.51,0:13:27.97,Default,,0,0,0,,Cậu hiểu là tốt.
Dialogue: 0,0:13:28.10,0:13:31.39,Default,,0,0,0,,Nhưng mà nhìn kìa, Luffy.\NDù đã làm vỡ gương...
Dialogue: 0,0:13:31.44,0:13:33.56,Default,,0,0,0,,nhưng bức tường có vẻ rất chắc chắn.
Dialogue: 0,0:13:33.69,0:13:35.61,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,0:13:35.65,0:13:37.78,Default,,0,0,0,,Không thể phá vỡ nó đâu.
Dialogue: 0,0:13:38.15,0:13:40.53,Default,,0,0,0,,Việc chạy trốn vốn là không thể.
Dialogue: 0,0:13:42.45,0:13:44.70,Default,,0,0,0,,Tuyệt vời! Quá tuyệt vời!
Dialogue: 0,0:13:45.41,0:13:47.74,Default,,0,0,0,,Những con búp bê bất lực cố gắng chống lại số phận!
Dialogue: 0,0:13:47.79,0:13:49.95,Default,,0,0,0,,Thật sự là một chương tuyệt vời!
Dialogue: 0,0:13:54.33,0:13:57.30,Default,,0,0,0,,Sự trống rỗng và tuyệt vọng\Ncũng tạo nên thế giới này.
Dialogue: 0,0:13:57.34,0:13:59.59,Default,,0,0,0,,Những bước lùi và sự nản lòng...
Dialogue: 0,0:13:59.63,0:14:01.80,Default,,0,0,0,,cũng là một phần của lịch sử!
Dialogue: 0,0:14:02.38,0:14:06.22,Default,,0,0,0,,Nãy giờ lảm nhảm cái gì thế?
Dialogue: 0,0:14:07.72,0:14:09.43,Default,,0,0,0,,Này, Mèo, đi tiếp được không?
Dialogue: 0,0:14:19.32,0:14:20.32,Default,,0,0,0,,Đi đi, Mèo!
Dialogue: 0,0:14:20.44,0:14:21.28,Default,,0,0,0,,Di chuyển đi!
Dialogue: 0,0:14:21.40,0:14:22.95,Default,,0,0,0,,Hắn đến kìa!
Dialogue: 0,0:14:23.07,0:14:24.28,Default,,0,0,0,,Chạy đi, Mèo!
Dialogue: 0,0:14:24.74,0:14:26.45,Default,,0,0,0,,Không chạy nhanh hơn được à?
Dialogue: 0,0:14:26.57,0:14:27.78,Default,,0,0,0,,Hắn sắp đuổi kịp kìa!
Dialogue: 0,0:14:27.91,0:14:29.24,Default,,0,0,0,,- Để tôi chém hắn.\N- Để tôi đá hắn.
Dialogue: 0,0:14:29.37,0:14:30.41,Default,,0,0,0,,Mèo!
Dialogue: 0,0:14:31.66,0:14:33.16,Default,,0,0,0,,Nó bảo: "Im đi!"
Dialogue: 0,0:14:33.62,0:14:36.29,Default,,0,0,0,,Yếu đuối và thảm hại! Nhưng lại quá táo bạo!
Dialogue: 0,0:14:36.33,0:14:38.09,Default,,0,0,0,,Đánh trúng vào cảm xúc của ta!
Dialogue: 0,0:14:38.13,0:14:40.34,Default,,0,0,0,,Thật vui vì có các ngươi ở đây!
Dialogue: 0,0:14:40.38,0:14:41.63,Default,,0,0,0,,Luffy Siêu Hiếm!
Dialogue: 0,0:14:42.59,0:14:43.63,Default,,0,0,0,,Zoro Siêu Hiếm!
Dialogue: 0,0:14:43.67,0:14:45.22,Default,,0,0,0,,Sanji Siêu Hiếm!
Dialogue: 0,0:14:45.26,0:14:46.59,Default,,0,0,0,,Usopp Siêu Hiếm!
Dialogue: 0,0:14:46.72,0:14:47.35,Default,,0,0,0,,Tôi ư?
Dialogue: 0,0:14:47.47,0:14:48.81,Default,,0,0,0,,Chopper Siêu Hiếm!
Dialogue: 0,0:14:49.68,0:14:50.56,Default,,0,0,0,,Nami Siêu Hiếm!
Dialogue: 0,0:14:50.68,0:14:51.77,Default,,0,0,0,,Khoan...
Dialogue: 0,0:14:52.23,0:14:54.60,Default,,0,0,0,,Sao hắn lại biết chúng ta?
Dialogue: 0,0:14:54.73,0:14:56.06,Default,,0,0,0,,"Siêu Hiếm" là sao?
Dialogue: 0,0:15:06.20,0:15:07.82,Default,,0,0,0,,Làm cái gì vậy trời?
Dialogue: 0,0:15:07.95,0:15:11.79,Default,,0,0,0,,Phải làm gì đi chứ! Cứ thế này\Nthì bị hắn bắt kịp mất.
Dialogue: 0,0:15:11.91,0:15:13.83,Default,,0,0,0,,Này, Usopp.
Dialogue: 0,0:15:13.87,0:15:16.67,Default,,0,0,0,,Thiên tai thì không phải\Nlỗi của ai nhỉ?
Dialogue: 0,0:15:16.79,0:15:20.75,Default,,0,0,0,,À thì... giống như động đất, lũ lụt\Nvà sấm sét...
Dialogue: 0,0:15:20.80,0:15:22.76,Default,,0,0,0,,không thể nói là lỗi của ai được.
Dialogue: 0,0:15:23.26,0:15:27.43,Default,,0,0,0,,Chúng ta đã phải trải qua\Nnhững chuyện thật đáng sợ nhỉ.
Dialogue: 0,0:15:32.60,0:15:34.56,Default,,0,0,0,,Thật sự, gã đó...
Dialogue: 0,0:15:34.60,0:15:35.56,Default,,0,0,0,,...làm tớ phát bực!
Dialogue: 0,0:15:36.10,0:15:38.48,Default,,0,0,0,,Biết thế,\Nnhưng với một Người Khổng Lồ thì...
Dialogue: 0,0:15:38.60,0:15:40.02,Default,,0,0,0,,Tôi hiểu mà, Nami.
Dialogue: 0,0:15:40.06,0:15:44.11,Default,,0,0,0,,Tên đó cũng làm tôi phát bực...
Dialogue: 0,0:15:44.57,0:15:46.36,Default,,0,0,0,,Bởi vì tên khốn đó...
Dialogue: 0,0:15:46.40,0:15:51.49,Default,,0,0,0,,đã được thay quần áo cho Nami!
Dialogue: 0,0:15:54.33,0:15:55.37,Default,,0,0,0,,Xử hắn thôi.
Dialogue: 0,0:15:55.71,0:15:58.62,Default,,0,0,0,,Không không, Sanji! Nghe người ta nói đã!
Dialogue: 0,0:15:58.75,0:16:00.79,Default,,0,0,0,,Tôi không nghe lời đàn ông nhé!
Dialogue: 0,0:16:00.92,0:16:02.96,Default,,0,0,0,,Không được, Sanji.
Dialogue: 0,0:16:03.09,0:16:04.30,Default,,0,0,0,,Tại sao, Nami?
Dialogue: 0,0:16:04.42,0:16:06.01,Default,,0,0,0,,Bởi vì tôi tin...
Dialogue: 0,0:16:06.38,0:16:08.51,Default,,0,0,0,,ông trời sắp trừng phạt hắn rồi.
Dialogue: 0,0:16:34.16,0:16:36.58,Default,,0,0,0,,Muginn, gì vậy?
Dialogue: 0,0:16:37.04,0:16:39.50,Default,,0,0,0,,Lại mang gì đến cho ta à?
Dialogue: 0,0:16:50.26,0:16:52.80,Default,,0,0,0,,Này! Đây là băng Mũ Rơm!
Dialogue: 0,0:16:52.85,0:16:56.52,Default,,0,0,0,,Băng Hải tặc Khổng lồ\Nđang đi đón họ mà!
Dialogue: 0,0:16:56.56,0:16:58.98,Default,,0,0,0,,Ngươi tìm thấy họ ở đâu vậy?
Dialogue: 0,0:17:00.27,0:17:03.86,Default,,0,0,0,,Có vẻ họ đang ngủ rất say.
Dialogue: 0,0:17:03.90,0:17:08.36,Default,,0,0,0,,Vì đi qua Làn sương Mê ngủ\Ntrên đường từ Egghead đến đây sao?
Dialogue: 0,0:17:12.45,0:17:15.08,Default,,0,0,0,,Nhưng đúng là may mắn tốt cùng!
Dialogue: 0,0:17:15.74,0:17:18.29,Default,,0,0,0,,Băng Mũ Rơm...
Dialogue: 0,0:17:19.16,0:17:24.84,Default,,0,0,0,,Nói thật, khi nghe tin Hajrudin\Ntùy tiện trở thành thuộc hạ của hắn,
Dialogue: 0,0:17:24.88,0:17:26.67,Default,,0,0,0,,ta đã rất bực!
Dialogue: 0,0:17:29.01,0:17:30.55,Default,,0,0,0,,Này, đợi đã, Hajrudin!
Dialogue: 0,0:17:30.59,0:17:32.93,Default,,0,0,0,,Ta nghe tin rồi!\NNgươi mất trí rồi sao?!
Dialogue: 0,0:17:33.97,0:17:38.35,Default,,0,0,0,,Là thành viên của Băng Tân Hải tặc Chiến binh Khổng lồ,\Nta cũng sẽ trở thành thuộc hạ của hắn!
Dialogue: 0,0:17:38.39,0:17:43.23,Default,,0,0,0,,Chiến binh Elbaph là mạnh nhất thế giới!\NVậy mà phải phục vụ một con người nhỏ bé?!
Dialogue: 0,0:17:43.27,0:17:46.48,Default,,0,0,0,,Mất hết tự tôn rồi sao!?
Dialogue: 0,0:17:47.78,0:17:50.65,Default,,0,0,0,,Nhìn kìa. Trông thật nhỏ bé\Nvà yếu đuối.
Dialogue: 0,0:17:50.70,0:17:53.74,Default,,0,0,0,,Đang ngủ say và hoàn toàn không có khả năng\Nphòng vệ. Thật thảm hại!
Dialogue: 0,0:17:59.75,0:18:03.37,Default,,0,0,0,,Đây sẽ là...\Nbúp bê yêu thích mới của ta!
Dialogue: 0,0:18:04.29,0:18:05.84,Default,,0,0,0,,Nami Siêu Hiếm!
Dialogue: 0,0:18:21.06,0:18:23.77,Default,,0,0,0,,Ta sẽ để các ngươi ngủ thêm một lúc nữa.
Dialogue: 0,0:18:23.81,0:18:26.19,Default,,0,0,0,,Đến khi thức dậy...
Dialogue: 0,0:18:28.65,0:18:31.24,Default,,0,0,0,,Các ngươi cứ mất tích như thế này\Ncũng không sao nhỉ?
Dialogue: 0,0:18:32.74,0:18:36.37,Default,,0,0,0,,Hãy cùng quậy phá và sống với nhau\Nở ngay đây mãi mãi nhé.
Dialogue: 0,0:18:36.41,0:18:39.33,Default,,0,0,0,,Ta sẽ không làm thuộc hạ\Nmà sẽ là cấp trên...
Dialogue: 0,0:18:45.92,0:18:49.34,Default,,0,0,0,,Gì vậy? Ta đâu có tạo ra\Nnhững đám mây này?
Dialogue: 0,0:18:49.46,0:18:51.67,Default,,0,0,0,,Sẵn sàng chưa, Zeus?!
Dialogue: 0,0:18:54.80,0:18:57.14,Default,,0,0,0,,Sạc đầy năng lượng rồi, Nami!
Dialogue: 0,0:18:57.97,0:18:59.43,Default,,0,0,0,,Được rồi, giao cho cậu đấy!
Dialogue: 0,0:19:01.31,0:19:02.48,Default,,0,0,0,,Lôi Giáng!
Dialogue: 0,0:19:04.64,0:19:07.40,Default,,0,0,0,,Tới đây!
Dialogue: 0,0:19:26.71,0:19:29.63,Default,,0,0,0,,Thần Mặt Trời!
Dialogue: 0,0:19:47.35,0:19:49.94,Default,,0,0,0,,Cậu điên à?! Làm quá rồi đấy!
Dialogue: 0,0:19:49.98,0:19:51.98,Default,,0,0,0,,Giờ tính sao đây!
Dialogue: 0,0:19:54.86,0:19:57.57,Default,,0,0,0,,Là trời phạt mà, biết sao được.
Dialogue: 0,0:20:00.83,0:20:03.45,Default,,0,0,0,,Rõ ràng là cậu! Đừng có giả ngơ
Dialogue: 0,0:20:05.41,0:20:09.50,Default,,0,0,0,,Nào! Tiếp tục đi, Mèo!
Dialogue: 0,0:20:17.93,0:20:20.14,Default,,0,0,0,,Nhảy đi, Mèo!
Dialogue: 0,0:20:29.81,0:20:32.02,Default,,0,0,0,,Mini Gear 4th!
Dialogue: 0,0:20:37.78,0:20:41.37,Default,,0,0,0,,Dù hơi lưu luyến, nhưng đến lúc\Nrời khỏi vương quốc khối xếp hình rồi!
Dialogue: 0,0:20:41.95,0:20:43.62,Default,,0,0,0,,Cuối cùng cũng ra ngoài.
Dialogue: 0,0:20:44.45,0:20:46.45,Default,,0,0,0,,Đáng đời tên Người khổng lồ biến thái!
Dialogue: 0,0:20:46.91,0:20:50.00,Default,,0,0,0,,Làm ơn! Bên ngoài là Elbaph đi!
Dialogue: 0,0:20:52.59,0:20:58.63,Default,,0,0,0,,Súng Khỉ Đột Cao Su!
Dialogue: 0,0:21:16.11,0:21:18.07,Default,,0,0,0,,Ra ngoài rồi!
Dialogue: 0,0:23:05.34,0:23:08.51,Default,,0,0,0,,Phá vỡ Vương quốc Khối Xếp Hình,\Nnhóm Mũ Rơm đối mặt với...
Dialogue: 0,0:23:08.55,0:23:11.89,Default,,0,0,0,,một khung cảnh tuyết trải dài mênh mông\Nvà một cây cầu treo khổng lồ.
Dialogue: 0,0:23:11.93,0:23:14.10,Default,,0,0,0,,Chờ đợi họ là thiên đường hay địa ngục?
Dialogue: 0,0:23:14.69,0:23:20.65,Default,,0,0,0,,Khi Luffy một mình dấn bước về phía trước,\Nnguồn gốc của tiếng gầm rú đầy điềm gở được hé lộ.
Dialogue: 0,0:23:20.77,0:23:22.28,Default,,0,0,0,,Kỳ tới trên One Piece:
Dialogue: 0,0:23:22.32,0:23:25.53,Default,,0,0,0,,Cuộc chạm trán trên cánh đồng tuyết!\NLoki, Vị Hoàng Tử Bị Nguyền Rủa
Dialogue: 0,0:23:25.57,0:23:30.58,Default,,0,0,0,,Tôi sẽ trở thành Vua Hải Tặc!

