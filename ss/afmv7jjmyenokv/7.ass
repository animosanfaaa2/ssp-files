Dialogue: 0,0:01:44.31,0:01:46.11,Default,,0,0,0,,Tak bisa dimaafkan.
Dialogue: 0,0:01:46.48,0:01:49.41,Default,,0,0,0,,Ruanganku, ralat...
Dialogue: 0,0:01:49.86,0:01:51.71,Default,,0,0,0,,Kuilku.
Dialogue: 0,0:01:55.74,0:01:58.12,Default,,0,0,0,,Hewan peliharaanku...
Dialogue: 0,0:02:00.29,0:02:02.75,Default,,0,0,0,,Maksudku, para pelayanku.
Dialogue: 0,0:02:06.38,0:02:08.31,Default,,0,0,0,,Akan kubuat kalian membayarnya.
Dialogue: 0,0:02:08.31,0:02:10.77,Default,,0,0,0,,Boneka-boneka hidupku.
Dialogue: 0,0:02:10.77,0:02:14.18,Default,,0,0,0,,Livedoll!
Dialogue: 0,0:02:15.88,0:02:18.17,Default,,0,0,0,,HANCURKAN TAMAN MINIATUR\NKABUR DARI KERAJAAN BLOK
Dialogue: 0,0:02:18.26,0:02:23.35,Default,,0,0,0,,"Hancurkan Taman Miniatur.\NKabur dari Kerajaan Blok."
Dialogue: 0,0:02:24.77,0:02:27.71,Default,,0,0,0,,Beraninya kalian menghancurkan kerajaanku!
Dialogue: 0,0:02:29.27,0:02:30.67,Default,,0,0,0,,Tak bisa dimaafkan.
Dialogue: 0,0:02:32.90,0:02:35.16,Default,,0,0,0,,Apa yang Tuan Iscat lakukan?
Dialogue: 0,0:02:35.16,0:02:37.88,Default,,0,0,0,,Dewa Matahari, tolong tenanglah.
Dialogue: 0,0:02:46.63,0:02:47.92,Default,,0,0,0,,Lihat.
Dialogue: 0,0:02:47.92,0:02:50.05,Default,,0,0,0,,Langit di sebelah sana, api itu...
Dialogue: 0,0:02:50.05,0:02:52.77,Default,,0,0,0,,Jika dibiarkan, kerajaan ini akan hancur.
Dialogue: 0,0:02:52.77,0:02:55.23,Default,,0,0,0,,Dunia akan berakhir.
Dialogue: 0,0:02:55.59,0:02:57.44,Default,,0,0,0,,Takkan kubiarkan kalian lolos.
Dialogue: 0,0:02:57.44,0:02:59.93,Default,,0,0,0,,Tunggu!
Dialogue: 0,0:02:59.93,0:03:02.64,Default,,0,0,0,,Dia menakutkan sekali.
Dialogue: 0,0:03:02.64,0:03:05.95,Default,,0,0,0,,Dewa? Dia lebih cocok disebut iblis.
Dialogue: 0,0:03:05.95,0:03:07.91,Default,,0,0,0,,Dasar keparat.
Dialogue: 0,0:03:12.86,0:03:14.65,Default,,0,0,0,,Lewat mana?
Dialogue: 0,0:03:14.65,0:03:16.45,Default,,0,0,0,,Eh? Kanan.
Dialogue: 0,0:03:18.37,0:03:20.28,Default,,0,0,0,,Iscat.
Dialogue: 0,0:03:22.41,0:03:23.70,Default,,0,0,0,,Di situ, ya?
Dialogue: 0,0:03:28.50,0:03:30.23,Default,,0,0,0,,Jangan lari.
Dialogue: 0,0:03:31.04,0:03:33.23,Default,,0,0,0,,Hei, lihat, Luffy. Ada kota.
Dialogue: 0,0:03:33.23,0:03:34.30,Default,,0,0,0,,Ya.
Dialogue: 0,0:03:34.30,0:03:36.23,Default,,0,0,0,,Apa kita bisa melewati tanjakan curam itu?
Dialogue: 0,0:03:36.23,0:03:39.36,Default,,0,0,0,,Dia membuat semua ini dari blok mainan?
Dialogue: 0,0:03:39.76,0:03:41.61,Default,,0,0,0,,Hebat.
Dialogue: 0,0:03:41.61,0:03:44.07,Default,,0,0,0,,Ini bukan waktunya kagum!
Dialogue: 0,0:03:47.31,0:03:49.48,Default,,0,0,0,,Gawat, dia akan menyusul kita.
Dialogue: 0,0:03:49.48,0:03:51.02,Default,,0,0,0,,Bagaimana ini? Kita memutar?
Dialogue: 0,0:03:51.02,0:03:51.94,Default,,0,0,0,,Biar kupotong saja.
Dialogue: 0,0:03:51.94,0:03:53.48,Default,,0,0,0,,Tidak, akan kutendang sampai hancur.
Dialogue: 0,0:03:53.48,0:03:54.42,Default,,0,0,0,,Tidak.
Dialogue: 0,0:03:55.42,0:03:57.61,Default,,0,0,0,,Kita akan menabrak itu, lo.
Dialogue: 0,0:03:57.61,0:03:59.80,Default,,0,0,0,,Kita akan menabrak itu!
Dialogue: 0,0:04:00.80,0:04:04.01,Default,,0,0,0,,Lompat, Kucing!
Dialogue: 0,0:04:06.37,0:04:07.60,Default,,0,0,0,,Tuan Iscat?
Dialogue: 0,0:04:19.13,0:04:21.19,Default,,0,0,0,,Dia sudah susah payah menciptakan ini.
Dialogue: 0,0:04:21.19,0:04:23.76,Default,,0,0,0,,Cobalah untuk tak menghancurkannya\Nsaat kabur.
Dialogue: 0,0:04:29.87,0:04:31.83,Default,,0,0,0,,Dia terhenti!
Dialogue: 0,0:04:39.71,0:04:41.17,Default,,0,0,0,,Hei, Kucing!
Dialogue: 0,0:04:43.28,0:04:45.08,Default,,0,0,0,,Kau tak apa-apa, Nami?
Dialogue: 0,0:04:45.08,0:04:47.16,Default,,0,0,0,,Terima kasih, Sanji.
Dialogue: 0,0:04:47.16,0:04:49.00,Default,,0,0,0,,Lepaskan aku, hei.
Dialogue: 0,0:04:49.47,0:04:50.87,Default,,0,0,0,,Kau juga.
Dialogue: 0,0:04:52.38,0:04:55.02,Default,,0,0,0,,Astaga, jadi kacau balau.
Dialogue: 0,0:04:55.38,0:04:57.48,Default,,0,0,0,,Makanya kubilang, biar kupotong saja.
Dialogue: 0,0:04:57.92,0:05:00.26,Default,,0,0,0,,Sudah telanjur, apa boleh buat.
Dialogue: 0,0:05:00.26,0:05:01.69,Default,,0,0,0,,Lain kali hati-hati!
Dialogue: 0,0:05:06.35,0:05:09.85,Default,,0,0,0,,Lompatan sembrono yang luar biasa.
Dialogue: 0,0:05:11.24,0:05:14.83,Default,,0,0,0,,Kejahatan menghancurkan dunia ciptaanku.
Dialogue: 0,0:05:14.83,0:05:16.46,Default,,0,0,0,,Tak bisa dimaafkan.
Dialogue: 0,0:05:18.50,0:05:19.50,Default,,0,0,0,,Dia datang.
Dialogue: 0,0:05:21.24,0:05:22.11,Default,,0,0,0,,Baiklah.
Dialogue: 0,0:05:25.84,0:05:28.08,Default,,0,0,0,,Lari, Kucing!
Dialogue: 0,0:05:35.50,0:05:37.19,Default,,0,0,0,,Iscat.
Dialogue: 0,0:05:37.55,0:05:40.76,Default,,0,0,0,,Kenapa kau membantu mereka?
Dialogue: 0,0:05:41.90,0:05:44.11,Default,,0,0,0,,Berhenti!
Dialogue: 0,0:05:48.85,0:05:51.81,Default,,0,0,0,,Kucing ini akan membawa kita\Nke ujung sana dalam sekejap.
Dialogue: 0,0:05:51.81,0:05:52.54,Default,,0,0,0,,Apa?
Dialogue: 0,0:05:52.89,0:05:54.52,Default,,0,0,0,,Tapi kelihatannya tak ada ujungnya.
Dialogue: 0,0:05:54.52,0:05:58.48,Default,,0,0,0,,Astaga, Luffy, lihat saja cetak birunya.
Dialogue: 0,0:05:58.48,0:06:01.54,Default,,0,0,0,,Tidak! Apa yang kau lakukan?
Dialogue: 0,0:06:01.99,0:06:03.75,Default,,0,0,0,,Tidak apa-apa, aku ingat semuanya.
Dialogue: 0,0:06:05.74,0:06:06.76,Default,,0,0,0,,Benarkah?
Dialogue: 0,0:06:10.50,0:06:11.91,Default,,0,0,0,,Lihat, Luffy.
Dialogue: 0,0:06:11.91,0:06:14.58,Default,,0,0,0,,Pintu cermin yang baru kita lihat\Nterpantul di sebelah sana.
Dialogue: 0,0:06:14.58,0:06:16.08,Default,,0,0,0,,Oh, kau benar.
Dialogue: 0,0:06:16.08,0:06:19.27,Default,,0,0,0,,Ternyata, awan itu\Ncuma kapas yang digantung.
Dialogue: 0,0:06:25.40,0:06:27.11,Default,,0,0,0,,Oh, benar.
Dialogue: 0,0:06:28.61,0:06:32.60,Default,,0,0,0,,Meski terlihat luas,\Nbagi Raksasa, ini hanya ruangan.
Dialogue: 0,0:06:32.60,0:06:37.06,Default,,0,0,0,,Dengan cermin di segala arah,\Npantas seperti tak ada ujungnya.
Dialogue: 0,0:06:37.06,0:06:38.87,Default,,0,0,0,,Jadi, kita bisa sampai sana dalam sekejap.
Dialogue: 0,0:06:38.87,0:06:40.71,Default,,0,0,0,,Sekarang kita tinggal jalan lurus.
Dialogue: 0,0:06:41.23,0:06:43.40,Default,,0,0,0,,Kita sudah melewati separuh kerajaan ini.
Dialogue: 0,0:06:44.86,0:06:46.57,Default,,0,0,0,,Kita akan segera sampai.
Dialogue: 0,0:06:47.17,0:06:48.63,Default,,0,0,0,,Begitu rupanya.
Dialogue: 0,0:06:50.84,0:06:55.56,Default,,0,0,0,,Kalian pikir tahu segalanya soal dunia ini\Nhanya dengan cetak biru-gozaru?
Dialogue: 0,0:06:55.92,0:06:58.77,Default,,0,0,0,,Apa? Dia bicara seperti samurai?
Dialogue: 0,0:06:59.13,0:07:03.48,Default,,0,0,0,,Tapi awalnya ini adalah\Nsel tahanan Raksasa.
Dialogue: 0,0:07:03.48,0:07:04.44,Default,,0,0,0,,Jaring?
Dialogue: 0,0:07:06.51,0:07:08.99,Default,,0,0,0,,Kalau kita tertangkap,\Nentah bagaimana nasib kita.
Dialogue: 0,0:07:09.39,0:07:11.57,Default,,0,0,0,,Cepat menuju dinding itu!
Dialogue: 0,0:07:15.06,0:07:21.62,Default,,0,0,0,,Fasilitas ini dibangun untuk memastikan\NRaksasa pun tak bisa kabur!
Dialogue: 0,0:07:31.03,0:07:33.08,Default,,0,0,0,,Sialan kau!
Dialogue: 0,0:07:33.08,0:07:34.80,Default,,0,0,0,,Itu salahmu sendiri.
Dialogue: 0,0:07:37.12,0:07:40.13,Default,,0,0,0,,Sekalipun kalian sampai ke dinding itu,
Dialogue: 0,0:07:40.79,0:07:44.94,Default,,0,0,0,,kalian takkan bisa menghancurkannya!
Dialogue: 0,0:07:51.81,0:07:55.10,Default,,0,0,0,,Lagi pula, kalau kalian lewat sana,\Nitu cuma jalan buntu-gozaru.
Dialogue: 0,0:07:55.10,0:07:56.28,Default,,0,0,0,,Gawat.
Dialogue: 0,0:07:56.28,0:07:57.39,Default,,0,0,0,,Bagaimana ini?
Dialogue: 0,0:07:57.39,0:07:59.10,Default,,0,0,0,,Kita sudah sangat dekat.
Dialogue: 0,0:07:59.10,0:08:01.16,Default,,0,0,0,,Hei, kenapa kau tak menghindar, Kucing?
Dialogue: 0,0:08:06.11,0:08:07.74,Default,,0,0,0,,Kenapa ini terjadi pada Tuan Iscat?
Dialogue: 0,0:08:07.74,0:08:09.71,Default,,0,0,0,,Siapa orang-orang di atasnya itu?
Dialogue: 0,0:08:09.71,0:08:13.49,Default,,0,0,0,,Ikut aku sekarang, Livedoll sialan.
Dialogue: 0,0:08:13.49,0:08:16.93,Default,,0,0,0,,Kembalilah padaku.
Dialogue: 0,0:08:25.09,0:08:26.52,Default,,0,0,0,,Cepatlah...
Dialogue: 0,0:08:29.38,0:08:30.55,Default,,0,0,0,,Maju!
Dialogue: 0,0:08:44.19,0:08:46.63,Default,,0,0,0,,Ayo!
Dialogue: 0,0:08:48.86,0:08:51.84,Default,,0,0,0,,Kembali ke sini, Iscat!
Dialogue: 0,0:08:52.37,0:08:55.70,Default,,0,0,0,,Mereka mengoyak kawat logamnya?
Dialogue: 0,0:09:00.83,0:09:06.27,Default,,0,0,0,,Sekeras apa pun boneka lemah ini meronta,\Nnaskahku takkan pernah berubah.
Dialogue: 0,0:09:06.27,0:09:09.72,Default,,0,0,0,,Kau tahu itu, 'kan, Iscat?
Dialogue: 0,0:09:09.72,0:09:12.30,Default,,0,0,0,,Harga sebuah pengkhianatan itu mahal.
Dialogue: 0,0:09:14.57,0:09:15.76,Default,,0,0,0,,Ya.
Dialogue: 0,0:09:15.76,0:09:17.78,Default,,0,0,0,,Katanya, "Hentikan omong kosongmu."
Dialogue: 0,0:09:17.78,0:09:21.14,Default,,0,0,0,,Apa? Beraninya kau bicara\Nseperti itu pada majikanmu?
Dialogue: 0,0:09:21.14,0:09:22.40,Default,,0,0,0,,Tapi usahamu sia-sia
Dialogue: 0,0:09:22.40,0:09:25.73,Default,,0,0,0,,karena Dewa Telinga Panjang\Nyang buas ada di depan sana.
Dialogue: 0,0:09:26.98,0:09:29.36,Default,,0,0,0,,Kumohon hentikan, Tuan Iscat.
Dialogue: 0,0:09:30.86,0:09:32.32,Default,,0,0,0,,Dewa Matahari.
Dialogue: 0,0:09:32.92,0:09:35.63,Default,,0,0,0,,Kami punya berita\Ntentang Dewa Telinga Panjang.
Dialogue: 0,0:09:35.63,0:09:38.64,Default,,0,0,0,,Dia mati dalam kebakaran\Nmisterius hari ini.
Dialogue: 0,0:09:39.16,0:09:42.47,Default,,0,0,0,,Di saat kami merasa ini sangat tragis\Ndan merupakan firasat buruk,
Dialogue: 0,0:09:42.47,0:09:45.21,Default,,0,0,0,,langit retak secara misterius.
Dialogue: 0,0:09:45.21,0:09:47.71,Default,,0,0,0,,Kastel Bigstein juga rusak parah.
Dialogue: 0,0:09:47.71,0:09:49.42,Default,,0,0,0,,Tuan Iscat menjadi gila.
Dialogue: 0,0:09:49.42,0:09:51.67,Default,,0,0,0,,Hari ini benar-benar hari terkutuk.
Dialogue: 0,0:09:52.98,0:09:54.64,Default,,0,0,0,,Apa mereka yang mengalahkannya?
Dialogue: 0,0:09:55.07,0:09:56.85,Default,,0,0,0,,Tidak mungkin.
Dialogue: 0,0:09:56.85,0:10:00.41,Default,,0,0,0,,Kelinci karnivor buas itu,\NGlut-Bunny, berhasil dikalahkan?
Dialogue: 0,0:10:03.14,0:10:07.83,Default,,0,0,0,,Saat kami sadar, hanya ini yang tersisa.
Dialogue: 0,0:10:14.61,0:10:17.30,Default,,0,0,0,,Tolong tahan amarahmu.
Dialogue: 0,0:10:20.26,0:10:22.50,Default,,0,0,0,,Tolong tenanglah.
Dialogue: 0,0:10:27.59,0:10:29.90,Default,,0,0,0,,Dewa Matahari?
Dialogue: 0,0:10:31.27,0:10:32.73,Default,,0,0,0,,Indah sekali.
Dialogue: 0,0:10:33.73,0:10:37.14,Default,,0,0,0,,Sangat berharga.\NIni juga cara dunia bekerja.
Dialogue: 0,0:10:38.45,0:10:42.43,Default,,0,0,0,,Drama tanpa naskah di taman miniatur\Nyang tertutup.
Dialogue: 0,0:10:42.43,0:10:46.31,Default,,0,0,0,,Aku meremehkan mereka.\NMereka memberiku ketegangan-gozaru.
Dialogue: 0,0:10:47.62,0:10:50.08,Default,,0,0,0,,Di dunia yang kuciptakan ini,
Dialogue: 0,0:10:50.08,0:10:52.54,Default,,0,0,0,,kejahatan dan pahlawan lahir,
Dialogue: 0,0:10:52.90,0:10:55.25,Default,,0,0,0,,serta sejarah mulai terungkap.
Dialogue: 0,0:10:55.61,0:11:00.09,Default,,0,0,0,,Livedoll menambah pesona tersendiri\Nke dunia miniaturku.
Dialogue: 0,0:11:04.47,0:11:06.68,Default,,0,0,0,,Kenapa dia tertawa?
Dialogue: 0,0:11:34.49,0:11:37.78,Default,,0,0,0,,Apa ini satu-satunya kesempatan kita?
Dialogue: 0,0:11:38.42,0:11:40.53,Default,,0,0,0,,Jalan keluarnya terbuka.
Dialogue: 0,0:11:41.99,0:11:43.70,Default,,0,0,0,,Kita harus bergerak sekarang.
Dialogue: 0,0:11:44.12,0:11:45.71,Default,,0,0,0,,Beri tahu yang lain.
Dialogue: 0,0:11:46.87,0:11:51.10,Default,,0,0,0,,Merontalah di telapak tanganku!
Dialogue: 0,0:11:51.10,0:11:54.96,Default,,0,0,0,,Sekalipun Hajrudin menghormati kalian,\Naku tidak!
Dialogue: 0,0:12:02.06,0:12:02.91,Default,,0,0,0,,Hajrudin?
Dialogue: 0,0:12:04.89,0:12:06.87,Default,,0,0,0,,Keparat ini...
Dialogue: 0,0:12:07.27,0:12:08.73,Default,,0,0,0,,Siapa dia?
Dialogue: 0,0:12:11.94,0:12:13.12,Default,,0,0,0,,Jadi,
Dialogue: 0,0:12:13.12,0:12:15.03,Default,,0,0,0,,apa langkah kalian selanjutnya?
Dialogue: 0,0:12:17.86,0:12:19.99,Default,,0,0,0,,Dindingnya ada di balik pohon besar itu.
Dialogue: 0,0:12:20.67,0:12:23.16,Default,,0,0,0,,Tapi bagaimana caranya kita keluar?
Dialogue: 0,0:12:23.16,0:12:25.16,Default,,0,0,0,,Kalau tertangkap lagi,\Nkita akan dalam masalah.
Dialogue: 0,0:12:25.16,0:12:26.64,Default,,0,0,0,,Takkan kubiarkan.
Dialogue: 0,0:12:28.12,0:12:29.85,Default,,0,0,0,,Sudah masuk jangkauan.
Dialogue: 0,0:12:32.06,0:12:34.27,Default,,0,0,0,,Serangan Spesial Bintang Hijau!
Dialogue: 0,0:12:35.73,0:12:37.90,Default,,0,0,0,,Dokuro Bakuhatsu So!
Dialogue: 0,0:13:13.92,0:13:16.13,Default,,0,0,0,,Kita menghancurkan lebih banyak lagi.
Dialogue: 0,0:13:17.34,0:13:19.84,Default,,0,0,0,,Hei, maaf, ya!
Dialogue: 0,0:13:19.84,0:13:21.38,Default,,0,0,0,,Siapa yang peduli?
Dialogue: 0,0:13:21.38,0:13:24.03,Default,,0,0,0,,Aku peduli!\NKau menghancurkan terlalu banyak.
Dialogue: 0,0:13:24.03,0:13:26.51,Default,,0,0,0,,Oke, oke, salahku.
Dialogue: 0,0:13:26.51,0:13:28.16,Default,,0,0,0,,Syukurlah kalau kau mengerti.
Dialogue: 0,0:13:28.16,0:13:31.41,Default,,0,0,0,,Omong-omong, lihat, Luffy.\NAku berhasil menghancurkan cerminnya,
Dialogue: 0,0:13:31.43,0:13:33.58,Default,,0,0,0,,tapi dindingnya pasti sangat kukuh.
Dialogue: 0,0:13:33.88,0:13:34.84,Default,,0,0,0,,Benar.
Dialogue: 0,0:13:35.62,0:13:37.71,Default,,0,0,0,,Kalian tak bisa menghancurkannya.
Dialogue: 0,0:13:38.15,0:13:40.63,Default,,0,0,0,,Mustahil bisa kabur dari sini.
Dialogue: 0,0:13:42.62,0:13:44.72,Default,,0,0,0,,Hebat, ini hebat-gozaru!
Dialogue: 0,0:13:45.01,0:13:47.69,Default,,0,0,0,,Boneka tak berdaya mencoba\Nmenentang takdir mereka.
Dialogue: 0,0:13:47.69,0:13:49.75,Default,,0,0,0,,Mereka favoritku.\NIni episode terbaik!
Dialogue: 0,0:13:54.23,0:13:57.31,Default,,0,0,0,,Kekosongan dan keputusasaan\Njuga membentuk dunia ini.
Dialogue: 0,0:13:57.31,0:13:59.61,Default,,0,0,0,,Kemunduran dan kekecewaan
Dialogue: 0,0:13:59.61,0:14:01.70,Default,,0,0,0,,juga merupakan bagian dari sejarah.
Dialogue: 0,0:14:02.36,0:14:06.32,Default,,0,0,0,,Apa yang kau ocehkan sejak tadi?
Dialogue: 0,0:14:07.62,0:14:09.53,Default,,0,0,0,,Hei, Kucing, kau masih bisa lanjut?
Dialogue: 0,0:14:19.08,0:14:20.34,Default,,0,0,0,,Ayo, Kucing!
Dialogue: 0,0:14:20.34,0:14:21.30,Default,,0,0,0,,Cepat jalan!
Dialogue: 0,0:14:21.30,0:14:22.97,Default,,0,0,0,,Dia datang.
Dialogue: 0,0:14:22.97,0:14:24.38,Default,,0,0,0,,Lari, Kucing!
Dialogue: 0,0:14:24.38,0:14:26.55,Default,,0,0,0,,Tidak bisakah kau lebih cepat?
Dialogue: 0,0:14:26.55,0:14:27.81,Default,,0,0,0,,Dia akan menyusul.
Dialogue: 0,0:14:27.81,0:14:29.27,Default,,0,0,0,,- Apa kupotong saja?\N- Kutendang sampai jauh.
Dialogue: 0,0:14:29.27,0:14:30.31,Default,,0,0,0,,Kucing!
Dialogue: 0,0:14:31.56,0:14:33.26,Default,,0,0,0,,Katanya, "Berisik."
Dialogue: 0,0:14:33.26,0:14:36.31,Default,,0,0,0,,Lemah dan menyedihkan, tapi sangat berani.
Dialogue: 0,0:14:36.31,0:14:38.03,Default,,0,0,0,,Itu sangat menyentuh perasaanku.
Dialogue: 0,0:14:38.03,0:14:40.35,Default,,0,0,0,,Aku senang kalian semua ada di sini.
Dialogue: 0,0:14:40.35,0:14:41.48,Default,,0,0,0,,Luffy-taso.
Dialogue: 0,0:14:42.56,0:14:43.65,Default,,0,0,0,,Zoro-taso.
Dialogue: 0,0:14:43.65,0:14:45.23,Default,,0,0,0,,San-taso.
Dialogue: 0,0:14:45.23,0:14:46.62,Default,,0,0,0,,Usopp-taso.
Dialogue: 0,0:14:46.62,0:14:47.44,Default,,0,0,0,,Aku?
Dialogue: 0,0:14:47.44,0:14:48.90,Default,,0,0,0,,Chop-taso.
Dialogue: 0,0:14:49.58,0:14:50.58,Default,,0,0,0,,Nami-taso.
Dialogue: 0,0:14:50.58,0:14:51.87,Default,,0,0,0,,Tunggu sebentar.
Dialogue: 0,0:14:51.87,0:14:54.63,Default,,0,0,0,,Kenapa dia tahu siapa kita?
Dialogue: 0,0:14:54.63,0:14:55.96,Default,,0,0,0,,Apa maksudnya dengan "taso"?
Dialogue: 0,0:15:06.10,0:15:07.92,Default,,0,0,0,,Apa yang dia lakukan?
Dialogue: 0,0:15:07.92,0:15:11.81,Default,,0,0,0,,Daripada itu, kita harus apa sekarang?\NKalau dibiarkan, dia akan menyusul kita.
Dialogue: 0,0:15:11.81,0:15:13.77,Default,,0,0,0,,Hei, Usopp.
Dialogue: 0,0:15:13.77,0:15:16.69,Default,,0,0,0,,Bencana alam bukan salah siapa pun, 'kan?
Dialogue: 0,0:15:16.69,0:15:20.70,Default,,0,0,0,,Apa? Yah, benar.\NSeperti gempa bumi, banjir, dan petir.
Dialogue: 0,0:15:20.70,0:15:22.86,Default,,0,0,0,,Kau tak bisa menyalahkan siapa pun\Natas hal itu.
Dialogue: 0,0:15:22.86,0:15:27.53,Default,,0,0,0,,Kita benar-benar mengalami\Nkejadian yang menakutkan, bukan?
Dialogue: 0,0:15:32.57,0:15:34.50,Default,,0,0,0,,Sejujurnya, orang itu
Dialogue: 0,0:15:34.50,0:15:35.66,Default,,0,0,0,,membuatku kesal.
Dialogue: 0,0:15:36.00,0:15:38.50,Default,,0,0,0,,Aku tahu, tapi dia itu Raksasa\Ndan kita tak bisa...
Dialogue: 0,0:15:38.50,0:15:40.04,Default,,0,0,0,,Aku mengerti, Nami.
Dialogue: 0,0:15:40.04,0:15:44.01,Default,,0,0,0,,Rasa frustrasimu.\NOrang itu juga sudah membuatku muak.
Dialogue: 0,0:15:44.47,0:15:46.30,Default,,0,0,0,,Karena sedari tadi aku memikirkan,
Dialogue: 0,0:15:46.30,0:15:47.71,Default,,0,0,0,,keparat itu
Dialogue: 0,0:15:48.06,0:15:51.39,Default,,0,0,0,,pasti sudah mengganti bajumu.
Dialogue: 0,0:15:54.23,0:15:55.27,Default,,0,0,0,,Ayo kita hajar dia.
Dialogue: 0,0:15:55.61,0:15:58.65,Default,,0,0,0,,Tidak, tidak, tunggu, Sanji.\NDengarkan aku.
Dialogue: 0,0:15:58.65,0:16:00.82,Default,,0,0,0,,Aku takkan mendengarkan pria mana pun.
Dialogue: 0,0:16:00.82,0:16:02.99,Default,,0,0,0,,Itu tidak baik, Sanji.
Dialogue: 0,0:16:02.99,0:16:04.40,Default,,0,0,0,,Nami, kenapa?
Dialogue: 0,0:16:04.40,0:16:05.91,Default,,0,0,0,,Tapi aku yakin,
Dialogue: 0,0:16:06.28,0:16:08.41,Default,,0,0,0,,hukuman dewa akan segera datang padanya.
Dialogue: 0,0:16:33.76,0:16:36.68,Default,,0,0,0,,Muginn, ada apa-gozaru?
Dialogue: 0,0:16:36.68,0:16:39.60,Default,,0,0,0,,Apa yang kau bawa untukku kali ini-gozaru?
Dialogue: 0,0:16:50.16,0:16:52.82,Default,,0,0,0,,Hei, mereka Kelompok Topi Jerami!
Dialogue: 0,0:16:52.82,0:16:56.53,Default,,0,0,0,,Bajak Laut Raksasa seharusnya\Nsedang menjemput mereka sekarang.
Dialogue: 0,0:16:56.53,0:16:58.88,Default,,0,0,0,,Di mana kau menemukan mereka-gozaru?
Dialogue: 0,0:17:00.24,0:17:03.80,Default,,0,0,0,,Ada yang tahu?\NMereka tidur nyenyak sekali.
Dialogue: 0,0:17:03.80,0:17:08.26,Default,,0,0,0,,Mungkin mereka melewati Kabut Tidur\Ndalam perjalanan dari Egghead?
Dialogue: 0,0:17:12.34,0:17:15.18,Default,,0,0,0,,Yah, ini keberuntungan yang tak terduga.
Dialogue: 0,0:17:15.64,0:17:18.19,Default,,0,0,0,,Kelompok Topi Jerami...
Dialogue: 0,0:17:19.14,0:17:24.85,Default,,0,0,0,,Sejujurnya, saat dengar Hajrudin\Nmenjadi bawahannya tanpa basa-basi,
Dialogue: 0,0:17:24.85,0:17:26.57,Default,,0,0,0,,aku kesal.
Dialogue: 0,0:17:28.91,0:17:30.57,Default,,0,0,0,,Hei, tunggu, Hajrudin.
Dialogue: 0,0:17:30.57,0:17:33.03,Default,,0,0,0,,Aku dengar beritanya.\NKau sudah gila?
Dialogue: 0,0:17:33.87,0:17:38.29,Default,,0,0,0,,Karena aku anggota Bajak Laut\NPrajurit Raksasa Baru, aku jadi bawahannya.
Dialogue: 0,0:17:38.29,0:17:43.25,Default,,0,0,0,,Prajurit Elbaph itu terkuat di dunia.\NKenapa melayani manusia kerdil?
Dialogue: 0,0:17:43.25,0:17:46.38,Default,,0,0,0,,Apa mereka tak punya harga diri?
Dialogue: 0,0:17:47.68,0:17:50.60,Default,,0,0,0,,Lihat dia.\NSangat kecil dan terlihat lemah.
Dialogue: 0,0:17:50.60,0:17:53.64,Default,,0,0,0,,Dia tertidur pulas dan sama sekali\Ntak berdaya. Menyedihkan sekali.
Dialogue: 0,0:17:59.51,0:18:03.47,Default,,0,0,0,,Yang ini... Ini favorit baruku.
Dialogue: 0,0:18:04.19,0:18:05.93,Default,,0,0,0,,Nami-taso!
Dialogue: 0,0:18:08.07,0:18:08.90,Default,,0,0,0,,Ups.
Dialogue: 0,0:18:21.03,0:18:23.71,Default,,0,0,0,,Akan kubiarkan kalian tidur\Nsedikit lebih lama.
Dialogue: 0,0:18:23.71,0:18:26.09,Default,,0,0,0,,Saat bangun nanti...
Dialogue: 0,0:18:28.79,0:18:31.34,Default,,0,0,0,,Lebih baik kalian semua\Nmenghilang seperti sekarang!
Dialogue: 0,0:18:32.64,0:18:36.38,Default,,0,0,0,,Ayo bersenang-senang dan hidup bersama\Ndi sini selamanya.
Dialogue: 0,0:18:36.38,0:18:39.23,Default,,0,0,0,,Aku takkan jadi bawahanmu,\Ntapi aku bisa jadi atasanmu.
Dialogue: 0,0:18:45.89,0:18:49.44,Default,,0,0,0,,Apa-apaan ini?\NAku tak ingat pernah membuat awan ini.
Dialogue: 0,0:18:49.44,0:18:51.77,Default,,0,0,0,,Kau siap, Zeus?
Dialogue: 0,0:18:54.70,0:18:57.24,Default,,0,0,0,,Tenagaku sudah terisi penuh, Nami.
Dialogue: 0,0:18:57.87,0:18:59.33,Default,,0,0,0,,Baiklah, kuserahkan padamu.
Dialogue: 0,0:19:01.21,0:19:02.49,Default,,0,0,0,,Lightning Blast!
Dialogue: 0,0:19:04.54,0:19:07.58,Default,,0,0,0,,Ayo!
Dialogue: 0,0:19:26.61,0:19:29.53,Default,,0,0,0,,Dewa Matahari!
Dialogue: 0,0:19:47.25,0:19:49.88,Default,,0,0,0,,Kau bodoh, ya?!\NKau keterlaluan!
Dialogue: 0,0:19:49.88,0:19:51.88,Default,,0,0,0,,Apa yang akan kau lakukan?
Dialogue: 0,0:19:54.76,0:19:57.47,Default,,0,0,0,,Apa boleh buat, ini hukuman dewa.
Dialogue: 0,0:20:00.73,0:20:03.35,Default,,0,0,0,,Jelas sekali itu perbuatanmu!
Dialogue: 0,0:20:05.39,0:20:09.40,Default,,0,0,0,,Baiklah, terus maju, Kucing!
Dialogue: 0,0:20:17.69,0:20:20.04,Default,,0,0,0,,Lompat, Kucing!
Dialogue: 0,0:20:29.58,0:20:31.92,Default,,0,0,0,,Mini Gear Fourth.
Dialogue: 0,0:20:37.68,0:20:41.47,Default,,0,0,0,,Sayang sekali harus pergi, tapi sudah\Nwaktunya keluar dari Kerajaan Blok.
Dialogue: 0,0:20:41.85,0:20:43.52,Default,,0,0,0,,Akhirnya.
Dialogue: 0,0:20:44.35,0:20:46.55,Default,,0,0,0,,Rasakan itu, Raksasa mesum!
Dialogue: 0,0:20:46.55,0:20:49.76,Default,,0,0,0,,Kuharap di luar sana benar-benar Elbaph.
Dialogue: 0,0:20:52.49,0:20:55.53,Default,,0,0,0,,Gomu Gomu no...
Dialogue: 0,0:20:55.99,0:20:58.27,Default,,0,0,0,,Kong Gun!
Dialogue: 0,0:21:16.01,0:21:17.97,Default,,0,0,0,,Kita ke luar!
Dialogue: 0,0:21:24.57,0:21:30.56,Default,,0,0,0,,BERSAMBUNG
Dialogue: 0,0:23:05.32,0:23:08.53,Default,,0,0,0,,Setelah keluar dari Kerajaan Blok,\NKelompok Topi Jerami disambut dengan
Dialogue: 0,0:23:08.53,0:23:11.91,Default,,0,0,0,,pemandangan padang salju yang luas\Ndan jembatan gantung yang sangat besar.
Dialogue: 0,0:23:11.91,0:23:14.20,Default,,0,0,0,,Apakah surga atau neraka\Nyang menanti mereka?
Dialogue: 0,0:23:14.59,0:23:17.62,Default,,0,0,0,,Saat Luffy menjelajah sendirian,
Dialogue: 0,0:23:17.62,0:23:20.67,Default,,0,0,0,,sumber dari raungan\Nmengerikan pun terungkap.
Dialogue: 0,0:23:20.67,0:23:22.29,Default,,0,0,0,,Selanjutnya, di ONE PIECE.
Dialogue: 0,0:23:22.29,0:23:25.55,Default,,0,0,0,,"Pertemuan di Padang Salju.\NLoki, Sang Pangeran Terkutuk."
Dialogue: 0,0:23:25.55,0:23:28.32,Default,,0,0,0,,Aku akan menjadi Raja Bajak Laut!

