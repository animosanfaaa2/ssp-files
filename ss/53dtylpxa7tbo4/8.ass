Dialogue: 0,0:01:48.55,0:01:53.97,Title,SIGN,0,0,0,,{\pos(299,258)}La buona novella
Dialogue: 0,0:00:14.98,0:00:18.25,flashback,NOZEL BAMBINO,0,0,0,,Mamma!
Dialogue: 0,0:01:57.47,0:01:59.97,main,MEGICULA,0,0,0,,Ora che il tuo livello sacro\Nsi è dissolto del tutto,
Dialogue: 0,0:02:00.27,0:02:02.98,main,MEGICULA,0,0,0,,non hai alcun modo di sconfiggermi.
Dialogue: 0,0:02:02.98,0:02:06.71,main,MEGICULA,0,0,0,,Se anche dovessi riuscire \Na usarlo di nuovo per sferrare un attacco,
Dialogue: 0,0:02:06.71,0:02:09.48,main,MEGICULA,0,0,0,,non riusciresti nemmeno a sfiorarmi.
Dialogue: 0,0:02:09.74,0:02:14.49,main,MEGICULA,0,0,0,,Il mio incantesimo, Il Mondo Avvizzisce, \Navvolge tutta questa zona.
Dialogue: 0,0:02:15.13,0:02:17.60,main,MEGICULA,0,0,0,,Nessuno giungerà a salvarti e,
Dialogue: 0,0:02:17.60,0:02:20.24,main,MEGICULA,0,0,0,,se anche qualcuno arrivasse, \Nnon potrebbe fare nulla.
Dialogue: 0,0:02:20.69,0:02:23.00,main,MEGICULA,0,0,0,,Motivo più che sufficiente \Nper arrenderti, no?
Dialogue: 0,0:02:23.38,0:02:26.07,main,MEGICULA,0,0,0,,Tuttavia, è stato divertente, umana.
Dialogue: 0,0:02:32.22,0:02:33.76,italics,NOELLE,0,0,0,,Gaja?!
Dialogue: 0,0:02:36.37,0:02:37.49,main,UNDINE,0,0,0,,Gaja!
Dialogue: 0,0:02:40.68,0:02:42.66,main,GAJA,0,0,0,,Non sentirete alcun dolore,
Dialogue: 0,0:02:42.66,0:02:45.69,main,GAJA,0,0,0,,ma vi prego comunque \Ndi perdonarmi, regina Loropechika.
Dialogue: 0,0:02:46.15,0:02:48.98,italics,GAJA,0,0,0,,Magia di Fulmine. Pulsaranta.
Dialogue: 0,0:02:54.57,0:02:57.16,italics,GAJA,0,0,0,,Questo la paralizzerà per qualche secondo.
Dialogue: 0,0:03:01.40,0:03:02.91,italics,GAJA,0,0,0,,Quel giorno…
Dialogue: 0,0:03:03.64,0:03:06.40,italics,GAJA,0,0,0,,giurai di distruggere i nostri nemici\Ne proteggere il Paese
Dialogue: 0,0:03:06.40,0:03:08.31,italics,GAJA,0,0,0,,perché tu non dovessi farlo.
Dialogue: 0,0:03:08.92,0:03:11.12,italics,GAJA,0,0,0,,Eppure, sei mesi fa,
Dialogue: 0,0:03:11.55,0:03:16.84,italics,GAJA,0,0,0,,sei stata maledetta perché non ho fermato\Nl'attacco di Megicula e Vanica.
Dialogue: 0,0:03:17.49,0:03:19.28,flashback,GAJA,0,0,0,,Sono profondamente costernato!
Dialogue: 0,0:03:19.28,0:03:21.78,flashback,GAJA,0,0,0,,Come Guardiano degli Spiriti ho fallito!
Dialogue: 0,0:03:21.78,0:03:25.10,flashback,LOROPECHIKA,0,0,0,,No, no, no! Io sono ancora viva!
Dialogue: 0,0:03:25.39,0:03:28.10,flashback,LOROPECHIKA,0,0,0,,Senza di te, Gaja, \Nsarei sicuramente morta.
Dialogue: 0,0:03:28.31,0:03:31.75,flashback,LOROPECHIKA,0,0,0,,Inoltre, nessuno dei nostri sudditi \Nè rimasto ferito
Dialogue: 0,0:03:31.75,0:03:33.61,flashback,LOROPECHIKA,0,0,0,,e questo mi rasserena.
Dialogue: 0,0:03:33.93,0:03:35.61,flashback,LOROPECHIKA,0,0,0,,Tutto questo è merito tuo, Gaja!
Dialogue: 0,0:03:37.95,0:03:41.30,italics,GAJA,0,0,0,,Ho cercato di proteggere \Ni nostri sudditi e l'intero Regno
Dialogue: 0,0:03:41.30,0:03:43.74,italics,GAJA,0,0,0,,Ho cercato di difendere ogni cosa\Ne, per questo,
Dialogue: 0,0:03:43.74,0:03:45.62,italics,GAJA,0,0,0,,ora sei in questa situazione.
Dialogue: 0,0:03:46.79,0:03:49.66,italics,GAJA,0,0,0,,Costretta a fare\Nproprio ciò che non volevi.
Dialogue: 0,0:03:50.46,0:03:54.55,italics,GAJA,0,0,0,,Ho davvero fallito in tutto, \Ncome Guardiano degli Spiriti.
Dialogue: 0,0:03:55.12,0:03:58.80,italics,GAJA,0,0,0,,Prima del Regno, io volevo proteggere te!
Dialogue: 0,0:03:59.68,0:04:01.97,italics,GAJA,0,0,0,,Non permetterò che ti uccidano!
Dialogue: 0,0:04:01.97,0:04:03.89,italics,GAJA,0,0,0,,E non permetterò che tu uccida!
Dialogue: 0,0:04:04.39,0:04:08.39,italics,GAJA,0,0,0,,Non sarà alcuna ferita \Nche tu mi hai inferto a spezzarmi!
Dialogue: 0,0:04:08.90,0:04:13.82,italics,GAJA,0,0,0,,Trasformerò la mia vita stessa in mana\Ne sconfiggerò questo demone!
Dialogue: 0,0:04:13.82,0:04:15.07,italics,GAJA,0,0,0,,Qui e ora!
Dialogue: 0,0:04:15.72,0:04:18.07,italics,GAJA,0,0,0,,Stavolta riuscirò a salvarti,\Nne sono certo!
Dialogue: 0,0:04:19.02,0:04:20.91,italics,GAJA,0,0,0,,Magia assoluta di fulmine!
Dialogue: 0,0:04:20.91,0:04:22.99,italics,GAJA,0,0,0,,Apocalypra…
Dialogue: 0,0:04:23.75,0:04:25.59,italics,GAJA,0,0,0,,Astrauza!
Dialogue: 0,0:04:29.54,0:04:32.72,italics,MEGICULA,0,0,0,,Il Mondo Avvizzisce \Nnon sta riuscendo a cancellare tut—
Dialogue: 0,0:04:47.22,0:04:49.14,italics,NOELLE,0,0,0,,Solo un altro attacco!
Dialogue: 0,0:04:49.14,0:04:50.66,italics,NOELLE,0,0,0,,Non importa se è debole!
Dialogue: 0,0:04:50.66,0:04:55.59,italics,NOELLE,0,0,0,,Basta che il livello sacro mi dia\Nabbastanza potere da trafiggerne il cuore!
Dialogue: 0,0:04:58.16,0:05:00.90,main,MEGICULA,0,0,0,,Un incantesimo alimentato\Ndalla vita stessa di chi lo usa.
Dialogue: 0,0:05:04.27,0:05:06.64,main,MEGICULA,0,0,0,,Una potenza \Nche non mi aspettavo minimamente.
Dialogue: 0,0:05:07.67,0:05:09.41,main,MEGICULA,0,0,0,,Assolutamente splendido…
Dialogue: 0,0:05:10.04,0:05:11.26,main,MEGICULA,0,0,0,,umano.
Dialogue: 0,0:05:11.78,0:05:14.61,main,MEGICULA,0,0,0,,Purtroppo il mio corpo
Dialogue: 0,0:05:14.61,0:05:18.55,main,MEGICULA,0,0,0,,è protetto da una maledizione\Nrigenerante a velocità extra rapida.
Dialogue: 0,0:05:18.55,0:05:19.71,main,UNDINE,0,0,0,,Gaja!
Dialogue: 0,0:05:23.30,0:05:24.57,main,NOELLE,0,0,0,,Undine!
Dialogue: 0,0:05:25.27,0:05:27.77,main,MEGICULA,0,0,0,,Esattamente come il nostro ultimo scontro.
Dialogue: 0,0:05:28.73,0:05:32.31,main,MEGICULA,0,0,0,,E ora non puoi nemmeno usare \Ni poteri del livello arcano.
Dialogue: 0,0:05:32.62,0:05:35.31,main,MEGICULA,0,0,0,,Stavolta è davvero la fine.
Dialogue: 0,0:05:42.45,0:05:43.61,main,NOELLE,0,0,0,,Non ancora!
Dialogue: 0,0:05:50.71,0:05:51.90,main,MEGICULA,0,0,0,,"Non ancora"?
Dialogue: 0,0:05:52.61,0:05:55.75,main,MEGICULA,0,0,0,,È evidente che\Nnon hai alcun modo di vincere.
Dialogue: 0,0:05:55.75,0:05:57.93,main,MEGICULA,0,0,0,,Perché continui a tentare?
Dialogue: 0,0:05:57.93,0:05:59.31,main,MEGICULA,0,0,0,,È forse così che gli umani
Dialogue: 0,0:05:59.31,0:06:03.45,main,MEGICULA,0,0,0,,riescono, di tanto in tanto, a superare\Nogni aspettativa e creare incantesimi?
Dialogue: 0,0:06:03.99,0:06:06.87,main,MEGICULA,0,0,0,,È un peccato che nessun\Nessere umano vivente sappia creare
Dialogue: 0,0:06:06.87,0:06:11.26,main,MEGICULA,0,0,0,,un incantesimo in grado di sconfiggermi\Ndentro Il Mondo Avvizzisce.
Dialogue: 0,0:06:11.26,0:06:15.45,main,MEGICULA,0,0,0,,I demoni obbediscono sempre \Na chi è di rango superiore.
Dialogue: 0,0:06:15.45,0:06:17.07,main,MEGICULA,0,0,0,,Fare il contrario è insensato.
Dialogue: 0,0:06:17.07,0:06:18.92,main,MEGICULA,0,0,0,,Voi umani, invece,
Dialogue: 0,0:06:18.92,0:06:23.78,main,MEGICULA,0,0,0,,vi aggrappate a ideali ridicoli\Ne rischiate la vita per cose futili.
Dialogue: 0,0:06:24.41,0:06:28.41,main,MEGICULA,0,0,0,,Acier Silva impugnava \Nl'amore per i suoi figli come un'arma.
Dialogue: 0,0:06:28.41,0:06:29.86,main,MEGICULA,0,0,0,,Quell'uomo lì per terra,
Dialogue: 0,0:06:29.86,0:06:33.41,main,MEGICULA,0,0,0,,ha combattuto usando la sua lealtà\Nalla Regina a cui si era votato.
Dialogue: 0,0:06:33.82,0:06:38.17,main,MEGICULA,0,0,0,,E tu combatti usando una speranza\Nche nemmeno esiste davvero.
Dialogue: 0,0:06:38.46,0:06:40.16,main,MEGICULA,0,0,0,,Tutto così insulso.
Dialogue: 0,0:06:40.16,0:06:42.23,main,MEGICULA,0,0,0,,Perché non vi arrendete e basta,
Dialogue: 0,0:06:42.23,0:06:44.34,main,MEGICULA,0,0,0,,se l'alternativa\Nè aggrapparsi a cose ridicole?
Dialogue: 0,0:06:47.68,0:06:49.76,italics,NOELLE,0,0,0,,Quindi non ho speranze di vincere?
Dialogue: 0,0:06:50.10,0:06:52.84,italics,NOELLE,0,0,0,,Grazie tante, questo lo sapevo già.
Dialogue: 0,0:06:55.43,0:06:57.00,main,NOELLE,0,0,0,,Già, hai ragione.
Dialogue: 0,0:06:57.00,0:06:59.29,main,NOELLE,0,0,0,,Questa cosa, però, mi appartiene
Dialogue: 0,0:06:59.29,0:07:01.94,main,NOELLE,0,0,0,,e non m'importa se tu non riesci a capire!
Dialogue: 0,0:07:03.19,0:07:06.91,italics,NOELLE,0,0,0,,Che razza di demone è questo?\NAssurdo, completamente assurdo!
Dialogue: 0,0:07:09.14,0:07:11.20,main,NOELLE,0,0,0,,Ti dirò una cosa su noi umani.
Dialogue: 0,0:07:11.20,0:07:13.56,main,NOELLE,0,0,0,,Anche se abbiamo poche chance,
Dialogue: 0,0:07:13.56,0:07:16.18,main,NOELLE,0,0,0,,certe volte \Nnon possiamo proprio arrenderci.
Dialogue: 0,0:07:16.63,0:07:20.71,italics,NOELLE,0,0,0,,Vorrei semplicemente crollare\Nin ginocchio e scoppiare a piangere.
Dialogue: 0,0:07:21.25,0:07:24.19,main,NOELLE,0,0,0,,Non perché possiamo vincere\Nse non ci arrendiamo,
Dialogue: 0,0:07:24.19,0:07:27.83,main,NOELLE,0,0,0,,ma perché se ci arrendiamo,\Nè come accettare la sconfitta!
Dialogue: 0,0:07:27.83,0:07:30.16,italics,NOELLE,0,0,0,,Però, nonostante tutto…
Dialogue: 0,0:07:30.51,0:07:33.93,main,NOELLE,0,0,0,,Non arrenderci mai, \Nquesta è la nostra vera forza!
Dialogue: 0,0:07:35.60,0:07:37.02,main,MEGICULA,0,0,0,,Certo.
Dialogue: 0,0:07:37.02,0:07:39.65,main,MEGICULA,0,0,0,,Come supponevo,\Nnon riesco davvero a capire.
Dialogue: 0,0:07:39.65,0:07:41.20,main,MEGICULA,0,0,0,,È tutto molto interessante,
Dialogue: 0,0:07:41.20,0:07:44.75,main,MEGICULA,0,0,0,,ma non posso permettermi\Ndi perdere altro tempo qui.
Dialogue: 0,0:07:47.77,0:07:49.38,main,MEGICULA,0,0,0,,Magia di segni maledetti.
Dialogue: 0,0:07:50.16,0:07:52.41,main,MEGICULA,0,0,0,,Vita deflagrante.
Dialogue: 0,0:07:54.12,0:07:55.88,main,MEGICULA,0,0,0,,Ora Loropechika esploderà,
Dialogue: 0,0:07:55.88,0:07:59.46,main,MEGICULA,0,0,0,,uccidendo ogni singolo\Nessere umano nel castello.
Dialogue: 0,0:07:59.92,0:08:02.13,main,MEGICULA,0,0,0,,E, una volta fatto questo,
Dialogue: 0,0:08:02.13,0:08:05.38,main,MEGICULA,0,0,0,,potrò manifestarmi completamente\Nin questo mondo.
Dialogue: 0,0:08:13.26,0:08:17.44,main,NOELLE,0,0,0,,Loropechika!
Dialogue: 0,0:08:31.14,0:08:32.87,main,ASTA,0,0,0,,Ragazzi, per un pelo!
Dialogue: 0,0:08:34.12,0:08:35.54,main,ASTA,0,0,0,,Sono arrivato appena in tempo!
Dialogue: 0,0:08:36.29,0:08:37.54,italics,NOELLE,0,0,0,,Giusto.
Dialogue: 0,0:08:37.54,0:08:39.38,main,ASTA,0,0,0,,Eccoci qui sani e salvi!
Dialogue: 0,0:08:39.38,0:08:41.05,main,ASTA,0,0,0,,Hai visto, Noelle?!
Dialogue: 0,0:08:41.05,0:08:43.10,italics,NOELLE,0,0,0,,Me l'hai insegnato tu.
Dialogue: 0,0:08:44.89,0:08:48.53,main,NOELLE,0,0,0,,Non sono né sana né salva, Astambecille!
Dialogue: 0,0:08:53.46,0:08:55.24,main,MEGICULA,0,0,0,,E quell'umano?
Dialogue: 0,0:08:55.88,0:08:57.86,main,ASTA,0,0,0,,La Regina Loropechika è…
Dialogue: 0,0:08:57.86,0:09:01.94,main,ASTA,0,0,0,,Abbiamo impedito che esplodesse, \Nma è ancora coperta di maledizioni!
Dialogue: 0,0:09:01.94,0:09:05.44,main,LIEBE,0,0,0,,C'è aperto solo un portale per l'aldilà,
Dialogue: 0,0:09:05.81,0:09:08.44,main,LIEBE,0,0,0,,che ci fa qui un demone\Ndi rango supremo?!
Dialogue: 0,0:09:08.77,0:09:10.09,main,LIEBE,0,0,0,,Parliamoci chiaro,
Dialogue: 0,0:09:10.09,0:09:14.14,main,LIEBE,0,0,0,,se non possiamo usare lo Unite,\Nnon abbiamo chance di vincere.
Dialogue: 0,0:09:14.78,0:09:18.81,main,MEGICULA,0,0,0,,È riuscito a fare tutto questo \Nall'interno de Il Mondo Avvizzisce.
Dialogue: 0,0:09:18.81,0:09:19.94,main,MEGICULA,0,0,0,,Ah, ma certo.
Dialogue: 0,0:09:19.94,0:09:24.51,main,MEGICULA,0,0,0,,Dev'essere l'umano con l'anti-magia\Ndi cui parlavano Vanica e i suoi fratelli.
Dialogue: 0,0:09:25.24,0:09:26.75,italics,MEGICULA,0,0,0,,Estremamente interessante,
Dialogue: 0,0:09:26.75,0:09:30.72,italics,MEGICULA,0,0,0,,ma rischia di portare a una situazione\Nassolutamente impensabile.
Dialogue: 0,0:09:31.47,0:09:33.72,main,MEGICULA,0,0,0,,Ora basta giocare.
Dialogue: 0,0:09:35.30,0:09:37.14,main,MEGICULA,0,0,0,,Per prima cosa,
Dialogue: 0,0:09:37.58,0:09:40.47,main,MEGICULA,0,0,0,,ucciderò Vanica e Loropechika\Nuna volta per tutte.
Dialogue: 0,0:09:40.47,0:09:42.98,main,MEGICULA,0,0,0,,E, fatto questo, \Nmi manifesterò completamente.
Dialogue: 0,0:09:44.98,0:09:46.14,main,MEGICULA,0,0,0,,Cosa?
Dialogue: 0,0:09:46.14,0:09:47.73,italics,MEGICULA,0,0,0,,I segni maledetti sono spariti?
Dialogue: 0,0:09:56.35,0:09:58.27,main,CHARLOTTE,0,0,0,,Non dimenticarti…
Dialogue: 0,0:09:58.87,0:10:01.00,main,CHARLOTTE,0,0,0,,che io sono ancora in piedi!
Dialogue: 0,0:10:01.28,0:10:03.22,main,MEGICULA,0,0,0,,Quella donna? Com'è possibile?
Dialogue: 0,0:10:03.22,0:10:05.58,main,MEGICULA,0,0,0,,Non dovrebbe potersi nemmeno muovere.
Dialogue: 0,0:10:06.00,0:10:08.84,italics,MEGICULA,0,0,0,,Anzi, il suo potere magico \Nsta addirittura aumentando.
Dialogue: 0,0:10:10.42,0:10:12.76,main,RILL,0,0,0,,È un tipo di incantesimo\Na cui non sono abituato
Dialogue: 0,0:10:12.76,0:10:14.76,main,RILL,0,0,0,,e ci ho messo un po' ad attivarlo.
Dialogue: 0,0:10:22.06,0:10:24.42,italics,RILL,0,0,0,,Finché resta attivo,\NValhalla al crepuscolo
Dialogue: 0,0:10:24.42,0:10:26.84,italics,RILL,0,0,0,,potenzia il mana\Ndi tutti gli alleati nell'area
Dialogue: 0,0:10:26.84,0:10:31.24,italics,RILL,0,0,0,,e impedisce loro di morire,\Nnon importa quanti danni subiscano!
Dialogue: 0,0:10:31.24,0:10:33.03,main,RILL,0,0,0,,Per qualche minuto, siamo invincibili!
Dialogue: 0,0:10:33.68,0:10:36.30,italics,RILL,0,0,0,,Quando finirà, le ferite torneranno.
Dialogue: 0,0:10:36.30,0:10:38.62,italics,RILL,0,0,0,,Ma in questo momento, che importa?!
Dialogue: 0,0:10:40.15,0:10:41.78,main,ASTA,0,0,0,,È incredibile, Rill!
Dialogue: 0,0:10:41.78,0:10:44.45,main,ASTA,0,0,0,,A proposito,\Nsono troppo felice che tu sia vivo!
Dialogue: 0,0:10:44.45,0:10:48.92,italics,RILL,0,0,0,,Se non fosse arrivato Asta, non l'avrei \Ncompletata prima dell'esplosione.
Dialogue: 0,0:10:48.92,0:10:52.38,main,RILL,0,0,0,,Grazie a lui ho potuto dipingere\Nla mia opera magna!
Dialogue: 0,0:10:52.85,0:10:56.74,italics,MEGICULA,0,0,0,,Da soli sarebbero \Ndel tutto insignificanti,
Dialogue: 0,0:10:56.74,0:10:59.69,italics,MEGICULA,0,0,0,,ma collaborando\Nriescono a fare cose simili.
Dialogue: 0,0:11:00.23,0:11:03.43,main,MEGICULA,0,0,0,,Voi umani \Nsiete creature davvero affascinanti!
Dialogue: 0,0:11:08.72,0:11:10.24,main,MEGICULA,0,0,0,,Sotto questa torre
Dialogue: 0,0:11:10.24,0:11:14.53,main,MEGICULA,0,0,0,,dormono i Dark Disciples\Nmorti per intrattenere me e Vanica.
Dialogue: 0,0:11:14.79,0:11:16.82,main,MEGICULA,0,0,0,,Infonderò in loro la forza dei demoni
Dialogue: 0,0:11:16.82,0:11:18.82,main,MEGICULA,0,0,0,,e quella di Acier Silva e Vanica,
Dialogue: 0,0:11:18.82,0:11:22.73,main,MEGICULA,0,0,0,,le cui anime sono sotto il mio controllo.
Dialogue: 0,0:11:24.54,0:11:27.95,main,MEGICULA,0,0,0,,Cadaveri animati,\N fatti di sangue e acciaio.
Dialogue: 0,0:11:32.10,0:11:34.70,main,MEGICULA,0,0,0,,Cento in tutto.
Dialogue: 0,0:11:53.65,0:11:56.19,main,ASTA,0,0,0,,Miseriaccia, \Nho male a ogni fibra del corpo!
Dialogue: 0,0:11:56.19,0:11:58.36,main,ASTA,0,0,0,,Oh cavolo, ci stanno attaccando!
Dialogue: 0,0:12:04.73,0:12:07.18,main,UNDINE,0,0,0,,Grazie di aver salvato Loropechika!
Dialogue: 0,0:12:07.18,0:12:09.88,main,ASTA,0,0,0,,Di nulla, \Ne grazie a te di aver salvato noi!
Dialogue: 0,0:12:09.88,0:12:14.05,main,ASTA,0,0,0,,Scusami tantissimo, \Nin questo momento sono inutile!
Dialogue: 0,0:12:14.40,0:12:16.00,main,ASTA,0,0,0,,Il resto spetta a voi!
Dialogue: 0,0:12:16.88,0:12:19.38,main,NOELLE,0,0,0,,Ma sei appena arrivato,\Nin che senso "il resto"?!
Dialogue: 0,0:12:19.38,0:12:21.80,main,ASTA,0,0,0,,Noelle! So che puoi farcela!
Dialogue: 0,0:12:22.61,0:12:24.49,italics,NOELLE,0,0,0,,Lo immaginavo.
Dialogue: 0,0:12:24.49,0:12:27.89,italics,NOELLE,0,0,0,,Avrai fatto una delle tue solite pazzie.
Dialogue: 0,0:12:28.60,0:12:29.98,italics,NOELLE,0,0,0,,Ora puoi anche riposare.
Dialogue: 0,0:12:30.78,0:12:32.88,italics,NOELLE,0,0,0,,Basta che tu sia arrivato…
Dialogue: 0,0:12:33.94,0:12:36.23,italics,NOELLE,0,0,0,,Basta pensare a te…
Dialogue: 0,0:12:37.24,0:12:39.54,italics,NOELLE,0,0,0,,per ritrovare le forze!
Dialogue: 0,0:12:40.78,0:12:43.62,italics,NOELLE,0,0,0,,Ma tu guarda, allora è vero.
Dialogue: 0,0:12:44.16,0:12:46.30,italics,NOELLE,0,0,0,,Finora ho accampato scuse.
Dialogue: 0,0:12:46.30,0:12:49.12,italics,NOELLE,0,0,0,,Tu guarda in che situazione\Ndovevo capirlo.
Dialogue: 0,0:12:50.17,0:12:53.75,italics,NOELLE,0,0,0,,Mi sa che amo davvero Asta.
Dialogue: 0,0:12:54.15,0:12:56.86,italics,NOELLE,0,0,0,,Ora, però, siamo sul campo di battaglia.
Dialogue: 0,0:12:56.86,0:12:59.51,italics,NOELLE,0,0,0,,E devo sconfiggere Megicula!
Dialogue: 0,0:12:59.51,0:13:01.36,main,NOELLE,0,0,0,,Andiamo, Undine!
Dialogue: 0,0:13:01.88,0:13:03.96,main,NOELLE,0,0,0,,Livello sacro finale!
Dialogue: 0,0:13:11.19,0:13:13.44,main,ASTA,0,0,0,,Nooo! Sei favolosa!
Dialogue: 0,0:13:14.14,0:13:16.66,main,NOELLE,0,0,0,,Pensa tu a difendere Loropechika, Asta!
Dialogue: 0,0:13:16.66,0:13:18.44,main,ASTA,0,0,0,,Ahia! Sì, certo!
Dialogue: 0,0:13:21.68,0:13:25.62,main,UNDINE,0,0,0,,Non abbiamo abbastanza forza sacre\Nper occuparci di questo intero esercito!
Dialogue: 0,0:13:27.22,0:13:30.36,italics,RILL,0,0,0,,Magia di pittura! Signore del Valhalla!
Dialogue: 0,0:13:31.99,0:13:33.99,italics,RILL,0,0,0,,Noelle, col suo livello sacro,
Dialogue: 0,0:13:33.99,0:13:37.63,italics,RILL,0,0,0,,e Charlotte, col suo attacco \Nanti-maledizione, sono indispensabili!
Dialogue: 0,0:13:39.03,0:13:41.84,main,RILL,0,0,0,,Perciò toccherà a me coprire entrambe!
Dialogue: 0,0:13:41.84,0:13:45.72,italics,CHARLOTTE,0,0,0,,Magia di vere spine!\NSplendida lancia del potere scarlatto!
Dialogue: 0,0:13:48.26,0:13:52.44,main,MEGICULA,0,0,0,,Voi umani vi evolvete costantemente,\Ne ancora di più durante gli scontri.
Dialogue: 0,0:13:54.62,0:13:56.11,main,MEGICULA,0,0,0,,È proprio vero.
Dialogue: 0,0:14:03.58,0:14:07.37,main,MEGICULA,0,0,0,,Non esistono creature migliori\Nda usare come giocattoli.
Dialogue: 0,0:14:12.61,0:14:13.87,main,RILL,0,0,0,,Noelle!
Dialogue: 0,0:14:24.05,0:14:25.14,main,NOELLE,0,0,0,,Luck!
Dialogue: 0,0:14:25.39,0:14:27.76,main,LUCK,0,0,0,,Penso io ad aprirti la strada, seguimi!
Dialogue: 0,0:14:27.76,0:14:29.90,main,RILL,0,0,0,,Bene, così si fa, gente!
Dialogue: 0,0:14:29.90,0:14:32.52,main,RILL,0,0,0,,Mi sento traboccare di ispirazione!
Dialogue: 0,0:14:33.20,0:14:35.52,italics,RILL,0,0,0,,Sarebbe perfetto se, a illuminarci la via,
Dialogue: 0,0:14:35.52,0:14:37.87,italics,RILL,0,0,0,,avessimo un altro mago del fulmine!
Dialogue: 0,0:14:47.35,0:14:50.41,italics,GAJA,0,0,0,,Sono praticamente più morto che vivo…
Dialogue: 0,0:14:53.03,0:14:54.62,italics,GAJA,0,0,0,,ma non importa.
Dialogue: 0,0:14:55.25,0:14:59.88,italics,GAJA,0,0,0,,Sono grato di poter tornare a combattere\Nper la Regina Loropechika!
Dialogue: 0,0:15:00.54,0:15:02.38,main,LUCK,0,0,0,,Gaja!
Dialogue: 0,0:15:06.45,0:15:07.82,main,LUCK,0,0,0,,Sei pronto?
Dialogue: 0,0:15:07.82,0:15:08.80,main,GAJA,0,0,0,,Certo.
Dialogue: 0,0:15:23.67,0:15:24.99,italics,NOELLE,0,0,0,,Ora!
Dialogue: 0,0:15:32.07,0:15:34.70,main,MEGICULA,0,0,0,,La mia manifestazione non è completa,
Dialogue: 0,0:15:34.70,0:15:37.39,main,MEGICULA,0,0,0,,ma il fatto che siate riusciti\Na tenermi testa finora…
Dialogue: 0,0:15:38.08,0:15:40.84,main,MEGICULA,0,0,0,,è davvero un'enorme sorpresa.
Dialogue: 0,0:15:41.71,0:15:43.41,main,MEGICULA,0,0,0,,Tuttavia, è come pensavo.
Dialogue: 0,0:15:45.93,0:15:47.68,main,MEGICULA,0,0,0,,Non basta.
Dialogue: 0,0:15:58.45,0:16:00.44,main,NOZEL,0,0,0,,Con quale sfacciato coraggio…
Dialogue: 0,0:16:00.44,0:16:03.94,main,NOZEL,0,0,0,,osi tornare a mostrarti \Ndavanti alla mia famiglia?
Dialogue: 0,0:16:07.18,0:16:11.65,main,NOZEL,0,0,0,,Non ho parole per esprimere\Nquanto ho aspettato questo momento.
Dialogue: 0,0:16:17.70,0:16:22.84,italics,NOZEL,0,0,0,,Ho visto la maledizione che hai scagliato\Nsu mia madre distruggerla lentamente.
Dialogue: 0,0:16:23.30,0:16:25.82,italics,NOZEL,0,0,0,,Nessuno sapeva \Ndella sua esistenza, in famiglia,
Dialogue: 0,0:16:25.82,0:16:28.84,italics,NOZEL,0,0,0,,perciò pensarono fosse\Nuna conseguenza del parto.
Dialogue: 0,0:16:29.49,0:16:32.77,italics,NOZEL,0,0,0,,La magia di segni maledetti \Nscagliata su mia madre
Dialogue: 0,0:16:32.77,0:16:34.85,italics,NOZEL,0,0,0,,ebbe un effetto secondario su di me.
Dialogue: 0,0:16:36.05,0:16:41.07,italics,NOZEL,0,0,0,,Mi avrebbe ucciso, se avessi rivelato \Nche Megicula aveva ucciso Acier Silva.
Dialogue: 0,0:16:41.66,0:16:46.77,italics,NOZEL,0,0,0,,E anche il mio interlocutore\Nsarebbe stato maledetto allo stesso modo.
Dialogue: 0,0:16:46.77,0:16:50.07,italics,NOZEL,0,0,0,,Un incantesimo \Nfatto per diffondersi come un morbo.
Dialogue: 0,0:16:50.97,0:16:53.65,flashbackitalics,NOZEL BAMBINO,0,0,0,,Non posso dirlo a nessuno.
Dialogue: 0,0:16:53.65,0:16:55.99,flashbackitalics,NOZEL BAMBINO,0,0,0,,Devo pensarci io, devo fare qualcosa.
Dialogue: 0,0:16:56.37,0:16:58.35,flashbackitalics,NOZEL BAMBINO,0,0,0,,Devo salvare la mamma.
Dialogue: 0,0:16:58.35,0:17:00.46,flashbackitalics,NOZEL BAMBINO,0,0,0,,Devo spezzare la maledizione!
Dialogue: 0,0:17:01.04,0:17:03.69,flashback,ACIER,0,0,0,,Nozel… basta così.
Dialogue: 0,0:17:07.66,0:17:11.22,flashback,ACIER,0,0,0,,Se continui così, \Nmetterai in pericolo anche la tua vita.
Dialogue: 0,0:17:11.82,0:17:13.07,flashback,NOZEL BAMBINO,0,0,0,,Ma io…
Dialogue: 0,0:17:13.80,0:17:16.99,flashback,ACIER,0,0,0,,Non è facile per le persone\Ndiventare più forti.
Dialogue: 0,0:17:19.70,0:17:21.47,flashback,ACIER,0,0,0,,Ma non devi preoccuparti.
Dialogue: 0,0:17:22.78,0:17:25.82,flashback,ACIER,0,0,0,,Tu… anzi, tutti voi…
Dialogue: 0,0:17:26.31,0:17:28.86,flashback,ACIER,0,0,0,,un giorno sarete molto più forti di me.
Dialogue: 0,0:17:30.22,0:17:32.24,flashback,ACIER,0,0,0,,Perciò devi vivere…
Dialogue: 0,0:17:33.01,0:17:34.16,flashback,ACIER,0,0,0,,Nozel.
Dialogue: 0,0:17:44.11,0:17:48.53,italics,NOZEL,0,0,0,,Un anno dopo la maledizione, \Nmia madre morì.
Dialogue: 0,0:17:48.53,0:17:54.59,italics,NOZEL,0,0,0,,Un anno che io passai a guardare, \Nsenza poter fare assolutamente nulla.
Dialogue: 0,0:17:58.78,0:18:00.10,flashbackitalics,NOZEL BAMBINO,0,0,0,,Più forte.
Dialogue: 0,0:18:04.01,0:18:06.40,flashbackitalics,NOZEL,0,0,0,,Devo diventare più forte.
Dialogue: 0,0:18:07.82,0:18:10.90,flashbackitalics,NOZEL,0,0,0,,Così, un giorno,\N potrò vendicare mia madre.
Dialogue: 0,0:18:11.49,0:18:13.72,flashbackitalics,NOZEL,0,0,0,,Così potrò proteggere\N i miei fratelli e sorelle!
Dialogue: 0,0:18:15.09,0:18:18.53,flashbackitalics,NOZEL,0,0,0,,Nebra e Solid\Ndiventano sempre più forti,
Dialogue: 0,0:18:18.53,0:18:21.37,flashbackitalics,NOZEL,0,0,0,,ma non sono all'altezza \Ndi un avversario simile.
Dialogue: 0,0:18:21.84,0:18:23.27,flashbackitalics,NOZEL,0,0,0,,Mentre Noelle…
Dialogue: 0,0:18:23.27,0:18:26.88,flashback,NOELLE,0,0,0,,Nozel, potresti insegnarmi la magia,\Nfratello mio?
Dialogue: 0,0:18:27.49,0:18:29.90,flashbackitalics,NOZEL,0,0,0,,Se non ha speranze di diventare più forte,
Dialogue: 0,0:18:29.90,0:18:32.88,flashbackitalics,NOZEL,0,0,0,,allora è meglio che resti isolata.
Dialogue: 0,0:18:33.84,0:18:37.72,flashback,NOZEL,0,0,0,,Sul campo di battaglia \Nnon c'è spazio per fallimenti come te.
Dialogue: 0,0:18:38.32,0:18:40.99,flashbackitalics,NOZEL,0,0,0,,Piuttosto che permettere \Nche provi ciò che ho provato io,
Dialogue: 0,0:18:40.99,0:18:43.15,flashbackitalics,NOZEL,0,0,0,,è meglio che non combatta.
Dialogue: 0,0:18:44.13,0:18:49.95,flashback,Nozel,0,0,0,,Perché nostra madre è dovuta morire\Nper dare alla luce una creatura come te?
Dialogue: 0,0:18:51.15,0:18:54.03,flashback,Nozel,0,0,0,,Tu hai ucciso nostra madre.
Dialogue: 0,0:18:55.66,0:18:56.98,flashbackitalics,NOZEL,0,0,0,,Falso.
Dialogue: 0,0:18:57.71,0:18:59.58,flashbackitalics,NOZEL,0,0,0,,Io l'ho uccisa!
Dialogue: 0,0:19:00.84,0:19:03.72,flashbackitalics,NOZEL,0,0,0,,Con la mia inutilità e la mia incapacità.
Dialogue: 0,0:19:04.10,0:19:07.18,flashbackitalics,NOZEL,0,0,0,,Sono scappato, terrorizzato\Nall'idea di perdere qualcos'altro.
Dialogue: 0,0:19:07.18,0:19:10.40,flashbackitalics,NOZEL,0,0,0,,Sono un vigliacco\Nsenza il coraggio di proteggere nulla.
Dialogue: 0,0:19:11.90,0:19:15.87,flashbackitalics,NOZEL,0,0,0,,A questo punto, \Nnon ho alcun diritto di starti accanto.
Dialogue: 0,0:19:16.91,0:19:18.14,flashbackitalics,NOZEL,0,0,0,,Più forte…
Dialogue: 0,0:19:20.05,0:19:21.56,flashbackitalics,NOZEL,0,0,0,,Ancora più forte!
Dialogue: 0,0:19:25.16,0:19:28.35,flashbackitalics,NOZEL,0,0,0,,La cosa logica da fare \Nè diventare Imperatore Magico.
Dialogue: 0,0:19:29.45,0:19:33.69,flashbackitalics,NOZEL,0,0,0,,Io… non posso morire qui!
Dialogue: 0,0:19:34.33,0:19:37.93,flashbackitalics,NOZEL,0,0,0,,Ho affrontato nemici che usavano \Nincantesimi empi come quel demone.
Dialogue: 0,0:19:37.93,0:19:39.20,flashbackitalics,NOZEL,0,0,0,,Perciò…
Dialogue: 0,0:19:39.63,0:19:41.49,flashbackitalics,NOZEL,0,0,0,,Per quel momento che prima o poi arriverà…
Dialogue: 0,0:19:47.26,0:19:48.35,main,NOZEL,0,0,0,,Vorrei…
Dialogue: 0,0:19:49.00,0:19:52.00,main,NOZEL,0,0,0,,offrire la mia gratitudine \Na tutti voi qui presenti.
Dialogue: 0,0:19:58.61,0:20:00.14,main,NOZEL,0,0,0,,Ebbene…
Dialogue: 0,0:20:00.14,0:20:02.16,main,NOZEL,0,0,0,,finalmente ci rivediamo!
Dialogue: 0,0:20:02.94,0:20:06.07,italics,NOZEL,0,0,0,,In questo attacco metterò\Ntutto ciò che sono stato finora.
Dialogue: 0,0:20:10.47,0:20:12.87,main,MEGICULA,0,0,0,,Che riunione commovente.
Dialogue: 0,0:20:12.87,0:20:14.70,main,MEGICULA,0,0,0,,È di questo che si tratta?
Dialogue: 0,0:20:20.53,0:20:24.29,main,MEGICULA,0,0,0,,Mi dispiace, \Nma non possiedo emozioni simili.
Dialogue: 0,0:20:27.01,0:20:31.46,flashback,ACIER,0,0,0,,Tu hai la forza dell'acciaio\Ne la flessibilità dell'acqua.
Dialogue: 0,0:20:31.46,0:20:33.42,main,NOZEL,0,0,0,,Non puoi difenderti da questo!
Dialogue: 0,0:20:35.44,0:20:39.63,italics,NOZEL,0,0,0,,Sangue che vola ovunque…\NAcciaio che lo trapassa…
Dialogue: 0,0:20:40.25,0:20:44.14,italics,NOZEL,0,0,0,,Eppure, non riesco\Na trafiggere il suo cuore.
Dialogue: 0,0:20:44.99,0:20:47.56,italics,NOZEL,0,0,0,,A quanto pare, avevo torto.
Dialogue: 0,0:20:47.77,0:20:51.06,italics,NOZEL,0,0,0,,Non avrei dovuto \Nmetterla da parte e isolarla.
Dialogue: 0,0:20:53.02,0:20:56.17,italics,NOZEL,0,0,0,,Dovevamo diventare più forti assieme.
Dialogue: 0,0:21:01.10,0:21:02.97,main,NOELLE,0,0,0,,Non ci siamo mai arresi!
Dialogue: 0,0:21:03.32,0:21:06.67,main,NOELLE,0,0,0,,È per questo che\N saremo noi a vincere, Megicula!
Dialogue: 0,0:21:14.07,0:21:15.86,italics,MEGICULA,0,0,0,,Ero in guardia,
Dialogue: 0,0:21:15.86,0:21:19.62,italics,MEGICULA,0,0,0,,ma pensavo che degli umani\Nnon mi avrebbero mai sconfitto.
Dialogue: 0,0:21:22.35,0:21:24.83,main,MEGICULA,0,0,0,,A quanto pare ho sottovalutato…
Dialogue: 0,0:21:24.83,0:21:26.31,main,MEGICULA,0,0,0,,tanto voi…
Dialogue: 0,0:21:26.31,0:21:29.12,main,MEGICULA,0,0,0,,quanto la vostra vera forza.
Dialogue: 0,0:21:30.21,0:21:33.30,italics,MEGICULA,0,0,0,,Forse è per questo che ho finito
Dialogue: 0,0:21:33.30,0:21:37.42,italics,MEGICULA,0,0,0,,per farmi affascinare\Ndal potere delle emozioni umane.
Dialogue: 0,0:21:51.88,0:21:56.38,main,ACIER,0,0,0,,Siete entrambi diventati così forti.

