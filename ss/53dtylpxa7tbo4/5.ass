Dialogue: 0,0:00:15.00,0:00:18.25,flashback,YOUNG NOZEL (FB),0,0,0,,‫أمي!
Dialogue: 0,0:01:48.56,0:01:53.97,Ep Title,EP TITLE,0,0,0,,‫{\c&HF7F8FF&}ما وراء المثابرة
Dialogue: 0,0:01:57.50,0:01:59.97,main,MEGICULA,0,0,0,,‫بعد أن انتهى مستوى القداسة لديك،
Dialogue: 0,0:02:00.27,0:02:02.98,main,MEGICULA,0,0,0,,‫لم تعد لديك وسيلة لهزيمتي.
Dialogue: 0,0:02:03.19,0:02:09.48,main,MEGICULA,0,0,0,,‫حتى لو وجّهت هجومًا آخر\N‫‫بمستوى القداسة، فلن يصل إليّ.
Dialogue: 0,0:02:09.78,0:02:14.49,main,MEGICULA,0,0,0,,‫لقد ملأ سحر العالم المضمحلّ\N‫‫هذه المنطقة بأكملها.
Dialogue: 0,0:02:15.17,0:02:17.58,main,MEGICULA,0,0,0,,‫لذا لن يأتي أحد لإنقاذك،
Dialogue: 0,0:02:17.58,0:02:20.24,main,MEGICULA,0,0,0,,‫وحتى لو أتى أحد، فلن يستطيع فعل شيء.
Dialogue: 0,0:02:20.72,0:02:23.00,main,MEGICULA,0,0,0,,‫أليس هذا سببًا كافيًا لتستسلمي؟
Dialogue: 0,0:02:23.41,0:02:25.85,main,MEGICULA,0,0,0,,‫مع أنني استمتعت كثيرًا، أيتها البشرية.
Dialogue: 0,0:02:32.31,0:02:33.21,italics,NOELLE (INT),0,0,0,,‫غاجا؟!
Dialogue: 0,0:02:36.46,0:02:37.28,main,UNDINE,0,0,0,,‫غاجا!
Dialogue: 0,0:02:40.81,0:02:45.69,main,GAJA,0,0,0,,‫لن يؤلمك هذا، لكن سامحيني\N‫‫رجاءً أيتها الملكة لوروبيتشكا.
Dialogue: 0,0:02:46.18,0:02:48.98,italics,GAJA (INT),0,0,0,,‫سحر البرق: بولسارانتا.
Dialogue: 0,0:02:54.60,0:02:57.16,italics,GAJA (INT),0,0,0,,‫سيوقف هذا حركتها لبضع ثوان.
Dialogue: 0,0:03:01.43,0:03:02.91,italics,GAJA (INT),0,0,0,,‫في ذلك اليوم…
Dialogue: 0,0:03:03.67,0:03:08.23,italics,GAJA (INT),0,0,0,,‫أقسمت أن أهزم أعداءنا نيابة عنك،\N‫‫وأن أحمي مملكتنا.
Dialogue: 0,0:03:09.16,0:03:10.84,italics,GAJA (INT),0,0,0,,‫لكن قبل ستة أشهر…
Dialogue: 0,0:03:11.65,0:03:16.42,italics,GAJA (INT),0,0,0,,‫عجزت عن صد هجوم ميغيكولا وفانيكا،\N‫‫فأُصبت أنت باللعنة.
Dialogue: 0,0:03:17.63,0:03:21.85,flashback,GAJA (FB),0,0,0,,‫أنا آسف أشد الأسف!\N‫‫لقد أخفقت بصفتي حارسًا للأرواح!
Dialogue: 0,0:03:21.85,0:03:25.10,flashback,LOROPECHIKA (FB),0,0,0,,‫لا، لا، لا! ما زلت حية!
Dialogue: 0,0:03:25.47,0:03:28.10,flashback,LOROPECHIKA (FB),0,0,0,,‫لولا وجودك، لكنت متّ.
Dialogue: 0,0:03:28.34,0:03:33.61,flashback,LOROPECHIKA (FB),0,0,0,,‫وما يسعدني أكثر هو أن مواطنينا\N‫‫لم يُصابوا بأذى.
Dialogue: 0,0:03:33.96,0:03:35.61,flashback,LOROPECHIKA (FB),0,0,0,,‫كل هذا بفضلك يا غاجا!
Dialogue: 0,0:03:38.01,0:03:43.73,italics,GAJA (INT),0,0,0,,‫لأنني حاولت حماية المواطنين\N‫‫والمملكة… وكلّ شيء،
Dialogue: 0,0:03:43.73,0:03:45.64,italics,GAJA (INT),0,0,0,,‫انتهى بك الأمر إلى هذه الحال.
Dialogue: 0,0:03:46.71,0:03:49.37,italics,GAJA (INT),0,0,0,,‫أُجبرت على فعل الأمر الوحيد\N‫‫الذي لم ترغبي في فعله.
Dialogue: 0,0:03:50.49,0:03:54.55,italics,GAJA (INT),0,0,0,,‫لقد أخفقت حقًا بصفتي حارسًا للأرواح.
Dialogue: 0,0:03:55.15,0:03:58.80,italics,GAJA (INT),0,0,0,,‫أكثر من المملكة… كنت أريد حمايتك أنت.
Dialogue: 0,0:03:59.71,0:04:01.53,italics,GAJA (INT),0,0,0,,‫لن أسمح لهم بقتلك.
Dialogue: 0,0:04:01.97,0:04:03.79,italics,GAJA (INT),0,0,0,,‫ولن أسمح لك بأن تقتلي.
Dialogue: 0,0:04:04.38,0:04:08.39,italics,GAJA (INT),0,0,0,,‫لن أموت مهما أصبتني من جراح.
Dialogue: 0,0:04:08.93,0:04:13.82,italics,GAJA (INT),0,0,0,,‫سأحوّل حياتي نفسها إلى سحر…\N‫‫وأدمّر هذه الشيطانة!
Dialogue: 0,0:04:13.82,0:04:15.07,italics,GAJA (INT),0,0,0,,‫هنا والآن…
Dialogue: 0,0:04:15.76,0:04:18.46,italics,GAJA (INT),0,0,0,,‫سأنقذك هذه المرة بكل تأكيد!
Dialogue: 0,0:04:19.05,0:04:25.19,italics,GAJA (INT),0,0,0,,‫سحر البرق المطلق: أبوكاليبرا أستراوزا!
Dialogue: 0,0:04:29.57,0:04:32.62,italics,MEGICULA (INT),0,0,0,,‫لا يستطيع العالم المضمحلّ محو كلّ—
Dialogue: 0,0:04:47.25,0:04:48.67,italics,NOELLE (INT),0,0,0,,‫ضربة واحدة أخرى فحسب!
Dialogue: 0,0:04:49.15,0:04:50.71,italics,NOELLE (INT),0,0,0,,‫لا يهم إن كانت ضعيفة!
Dialogue: 0,0:04:50.71,0:04:55.49,italics,NOELLE (INT),0,0,0,,‫أحتاج فقط إلى قدر من قوة مستوى القداسة\N‫‫يكفي لاختراق قلبها المكشوف!
Dialogue: 0,0:04:58.19,0:05:00.90,main,MEGICULA,0,0,0,,‫إذًا هذه تعويذة يغذيها استنزاف حياة ملقيها.
Dialogue: 0,0:05:04.30,0:05:06.54,main,MEGICULA,0,0,0,,‫لقد فاقت قوتها كل توقعاتي.
Dialogue: 0,0:05:07.70,0:05:11.16,main,MEGICULA,0,0,0,,‫كان ذلك رائعًا أيها البشري.
Dialogue: 0,0:05:11.81,0:05:13.08,main,MEGICULA,0,0,0,,‫لكن للأسف،
Dialogue: 0,0:05:13.08,0:05:18.16,main,MEGICULA,0,0,0,,‫جسدي محمي بلعنة تعافٍ فائقة السرعة.
Dialogue: 0,0:05:18.55,0:05:19.61,main,UNDINE,0,0,0,,‫غاجا!
Dialogue: 0,0:05:23.30,0:05:24.47,main,NOELLE,0,0,0,,‫أونديني!
Dialogue: 0,0:05:25.30,0:05:27.67,main,MEGICULA,0,0,0,,‫هذا شبيه بمعركتنا السابقة.
Dialogue: 0,0:05:28.76,0:05:32.32,main,MEGICULA,0,0,0,,‫لم تعودي قادرة على استخدام\N‫‫قوة مستوى القداسة إطلاقًا.
Dialogue: 0,0:05:32.66,0:05:34.73,main,MEGICULA,0,0,0,,‫هذه المرة… هذه هي النهاية حقًا.
Dialogue: 0,0:05:42.45,0:05:43.49,main,NOELLE,0,0,0,,‫ليس بعد!
Dialogue: 0,0:05:50.74,0:05:51.66,main,MEGICULA,0,0,0,,‫"ليس بعد"؟
Dialogue: 0,0:05:52.64,0:05:55.39,main,MEGICULA,0,0,0,,‫من الواضح أنك لا تستطيعين الانتصار.
Dialogue: 0,0:05:55.75,0:05:57.98,main,MEGICULA,0,0,0,,‫فلماذا تواصلين المقاومة؟
Dialogue: 0,0:05:57.98,0:06:03.13,main,MEGICULA,0,0,0,,‫هل هكذا يتجاوز البشر التوقعات\N‫‫أحيانًا ويبتكرون التعويذات؟
Dialogue: 0,0:06:04.13,0:06:06.90,main,MEGICULA,0,0,0,,‫لكن لا يوجد إنسان حي يستطيع ابتكار
Dialogue: 0,0:06:06.90,0:06:10.95,main,MEGICULA,0,0,0,,‫تعويذة تهزمني داخل العالم المضمحلّ.
Dialogue: 0,0:06:11.30,0:06:15.41,main,MEGICULA,0,0,0,,‫لا يعصي الشياطين أبدًا من يفوقهم رتبة.
Dialogue: 0,0:06:15.41,0:06:17.05,main,MEGICULA,0,0,0,,‫لأن ذلك بلا جدوى على الإطلاق.
Dialogue: 0,0:06:17.05,0:06:18.89,main,MEGICULA,0,0,0,,‫أما أنتم البشر فتتشبثون
Dialogue: 0,0:06:18.89,0:06:23.52,main,MEGICULA,0,0,0,,‫بأفكار سخيفة وتخاطرون\N‫‫بحياتكم من أجل أشياء بلا معنى.
Dialogue: 0,0:06:24.41,0:06:28.41,main,MEGICULA,0,0,0,,‫قاتلت أسيي سيلفا متسلحة بحبها لأطفالها.
Dialogue: 0,0:06:28.41,0:06:29.89,main,MEGICULA,0,0,0,,‫وقاتل ذلك الرجل
Dialogue: 0,0:06:29.89,0:06:33.41,main,MEGICULA,0,0,0,,‫بدافع ولائه للملكة التي أقسم على خدمتها.
Dialogue: 0,0:06:33.86,0:06:38.17,main,MEGICULA,0,0,0,,‫وأنت تقاتلين بأمل غير موجود أصلًا.
Dialogue: 0,0:06:38.17,0:06:40.19,main,MEGICULA,0,0,0,,‫من أجل أمر تافه كهذا…
Dialogue: 0,0:06:40.19,0:06:44.34,main,MEGICULA,0,0,0,,‫لماذا تتشبثون بهذه الأمور\N‫‫مع أن الاستسلام أسهل؟
Dialogue: 0,0:06:47.71,0:06:52.63,italics,NOELLE (INT),0,0,0,,‫لا سبيل لي للفوز؟ أعرف ذلك سلفًا.
Dialogue: 0,0:06:55.46,0:06:59.28,main,NOELLE,0,0,0,,‫أنت محقة… لكن ذلك يخصني،
Dialogue: 0,0:06:59.28,0:07:01.94,main,NOELLE,0,0,0,,‫لذا لا أبالي إن كنت لا تفهمينه.
Dialogue: 0,0:07:03.22,0:07:06.93,italics,NOELLE (INT),0,0,0,,‫ما خطبها؟ إنّها مجنونة تمامًا.
Dialogue: 0,0:07:09.27,0:07:13.50,main,NOELLE,0,0,0,,‫مهما ضؤلت فرصتنا في الفوز،
Dialogue: 0,0:07:13.50,0:07:15.85,main,NOELLE,0,0,0,,‫ثمة أوقات لا بد للبشر فيها من فعل شيء ما!
Dialogue: 0,0:07:16.66,0:07:20.71,italics,NOELLE (INT),0,0,0,,‫والحقيقة أنني حتى الآن\N‫‫أريد أن أجثو وأبكي…
Dialogue: 0,0:07:21.28,0:07:23.89,main,NOELLE,0,0,0,,‫ليس وكأننا نستطيع الفوز ما دمنا لن نستسلم.
Dialogue: 0,0:07:24.34,0:07:27.56,main,NOELLE,0,0,0,,‫لكن إن استسلمنا،\N‫‫فلن يبقى لنا أي أمل للفوز!
Dialogue: 0,0:07:27.87,0:07:30.06,italics,NOELLE (INT),0,0,0,,‫لكن، رغم ذلك…
Dialogue: 0,0:07:30.51,0:07:33.93,main,NOELLE,0,0,0,,‫قوتنا تكمن في عدم استسلامنا!
Dialogue: 0,0:07:37.31,0:07:39.64,main,MEGICULA,0,0,0,,‫ما زلت لا أفهم ذلك.
Dialogue: 0,0:07:39.64,0:07:44.65,main,MEGICULA,0,0,0,,‫هذا مثير للاهتمام…\N‫‫لكن لا وقت لدي لأضيعه بعد الآن.
Dialogue: 0,0:07:47.80,0:07:52.41,main,MEGICULA,0,0,0,,‫سحر صد اللعنات: الحياة المنفجرة.
Dialogue: 0,0:07:54.15,0:07:59.46,main,MEGICULA,0,0,0,,‫سأفجر لوروبيتشكا وأقتل\N‫‫كل البشر في هذه القلعة دفعة واحدة.
Dialogue: 0,0:07:59.95,0:08:02.13,main,MEGICULA,0,0,0,,‫وبعدها…
Dialogue: 0,0:08:02.13,0:08:04.89,main,MEGICULA,0,0,0,,‫سأتجسد هنا تجسدًا كاملًا.
Dialogue: 0,0:08:13.44,0:08:17.59,main,NOELLE,0,0,0,,‫لوروبيتشكا!
Dialogue: 0,0:08:31.17,0:08:32.87,main,ASTA,0,0,0,,‫كان ذلك وشيكًا!
Dialogue: 0,0:08:34.15,0:08:35.54,main,ASTA,0,0,0,,‫وصلت في اللحظة الأخيرة!
Dialogue: 0,0:08:36.32,0:08:37.54,italics,NOELLE (INT),0,0,0,,‫هذا صحيح…
Dialogue: 0,0:08:37.54,0:08:40.73,main,ASTA,0,0,0,,‫لقد التقينا مجددًا ونحن بخير!\N‫‫أليس كذلك يا نويل؟!
Dialogue: 0,0:08:41.09,0:08:43.00,italics,NOELLE (INT),0,0,0,,‫ذلك ما علّمتني إيّاه!
Dialogue: 0,0:08:44.92,0:08:48.43,main,NOELLE,0,0,0,,‫أنا لست بخير إطلاقًا يا غبيّستا!
Dialogue: 0,0:08:53.49,0:08:55.14,main,MEGICULA,0,0,0,,‫ما هذا الإنسان؟
Dialogue: 0,0:08:55.91,0:08:57.59,main,ASTA,0,0,0,,‫أيتها الملكة لوروبيتشكا…
Dialogue: 0,0:08:57.90,0:09:01.94,main,ASTA,0,0,0,,‫أوقفنا انفجارها، لكن ما زالت\N‫‫مصابة بلعنات كثيرة.
Dialogue: 0,0:09:02.26,0:09:05.44,main,LIEBE,0,0,0,,‫لم تُفتح إلى العالم السفلي\N‫‫إلا بوابة واحدة…
Dialogue: 0,0:09:05.84,0:09:08.44,main,LIEBE,0,0,0,,‫فما الذي يفعله هنا شيطان من أعلى رتبة؟!
Dialogue: 0,0:09:08.80,0:09:14.04,main,LIEBE,0,0,0,,‫سأكون صريحًا. لن نفوز\N‫‫أبدًا من دون اتحاد الشيطان!
Dialogue: 0,0:09:14.94,0:09:18.41,main,MEGICULA,0,0,0,,‫استطاع فعل كل ذلك داخل العالم المضمحلّ؟
Dialogue: 0,0:09:18.85,0:09:24.41,main,MEGICULA,0,0,0,,‫فهمت. لا بد أنه صاحب قوة إلغاء السحر\N‫‫الذي تحدثت عنه فانيكا والآخرون.
Dialogue: 0,0:09:25.27,0:09:26.78,italics,MEGICULA (INT),0,0,0,,‫لقد أثار فضولي،
Dialogue: 0,0:09:26.78,0:09:30.62,italics,MEGICULA (INT),0,0,0,,‫لكنه قد يتسبب في وقوع ما لا يمكن تصوره.
Dialogue: 0,0:09:31.50,0:09:33.72,main,MEGICULA,0,0,0,,‫كفى لعبًا.
Dialogue: 0,0:09:35.30,0:09:40.58,main,MEGICULA,0,0,0,,‫سأقتل فانيكا ولوروبيتشكا نهائيًا أولًا…
Dialogue: 0,0:09:40.58,0:09:42.98,main,MEGICULA,0,0,0,,‫ثم أتجسد تمامًا الآن.
Dialogue: 0,0:09:45.22,0:09:46.21,main,MEGICULA,0,0,0,,‫ماذا؟
Dialogue: 0,0:09:46.21,0:09:47.73,italics,MEGICULA (INT),0,0,0,,‫اختفت رموز اللعنة؟
Dialogue: 0,0:09:56.38,0:09:58.17,main,CHARLOTTE,0,0,0,,‫ما زلت…
Dialogue: 0,0:09:59.01,0:10:01.00,main,CHARLOTTE,0,0,0,,‫واقفة هنا!
Dialogue: 0,0:10:01.31,0:10:03.23,main,MEGICULA,0,0,0,,‫تلك المرأة… كيف؟
Dialogue: 0,0:10:03.23,0:10:05.58,main,MEGICULA,0,0,0,,‫كان ينبغي ألا تقوى على التعافي.
Dialogue: 0,0:10:06.04,0:10:08.84,italics,MEGICULA (INT),0,0,0,,‫ليس ذلك فحسب، بل زاد سحرها!
Dialogue: 0,0:10:10.57,0:10:14.76,main,RILL,0,0,0,,‫هذا ليس نوع التعويذات التي اعتدت عليها،\N‫‫لذا استغرق تفعيلها بعض الوقت.
Dialogue: 0,0:10:22.09,0:10:24.55,italics,RILL (INT),0,0,0,,‫ما دامت فالهالا الشفق مفعّلة،
Dialogue: 0,0:10:24.55,0:10:26.97,italics,RILL (INT),0,0,0,,‫تعزز سحر أي رفيق داخل نطاقها
Dialogue: 0,0:10:26.97,0:10:31.29,italics,RILL (INT),0,0,0,,‫وتمنع موته مهما اشتد الضرر الذي تلقاه!
Dialogue: 0,0:10:31.29,0:10:33.03,main,RILL,0,0,0,,‫نحن لا نُقهر لبضع دقائق فحسب!
Dialogue: 0,0:10:33.72,0:10:36.40,italics,RILL (INT),0,0,0,,‫حين تنتهي، سيعود الضرر إلينا.
Dialogue: 0,0:10:36.40,0:10:38.62,italics,RILL (INT),0,0,0,,‫لكن من يكترث لذلك الآن؟
Dialogue: 0,0:10:38.62,0:10:41.81,main,ASTA,0,0,0,,‫هذا مذهل يا ريل!
Dialogue: 0,0:10:41.81,0:10:44.46,main,ASTA,0,0,0,,‫وأنا سعيد للغاية لأنك ما زلت حيًا!
Dialogue: 0,0:10:44.46,0:10:48.92,italics,RILL (INT),0,0,0,,‫لو لم يظهر أستا،\N‫‫لما انتهيت قبل وقوع ذلك الانفجار.
Dialogue: 0,0:10:49.38,0:10:52.38,main,RILL,0,0,0,,‫وبفضل ذلك، قد أُنجز تحفتي العظمى!
Dialogue: 0,0:10:52.89,0:10:56.77,italics,MEGICULA (INT),0,0,0,,‫كل واحد منهم تافه لا يُعتد به بمفرده،
Dialogue: 0,0:10:56.77,0:10:59.59,italics,MEGICULA (INT),0,0,0,,‫لكن حين يوحّدون قواهم\N‫‫يستطيعون فعل كل هذا…
Dialogue: 0,0:11:00.26,0:11:03.33,main,MEGICULA,0,0,0,,‫أنتم البشر مثيرون للاهتمام حقًّا!
Dialogue: 0,0:11:08.75,0:11:14.53,main,MEGICULA,0,0,0,,‫يرقد تحت البرج حواريو الظلام الذين\N‫‫ماتوا لإمتاع فانيكا وإمتاعي.
Dialogue: 0,0:11:14.90,0:11:16.84,main,MEGICULA,0,0,0,,‫سأمنحهم قوة الشياطين،
Dialogue: 0,0:11:16.84,0:11:22.63,main,MEGICULA,0,0,0,,‫وقوة أسيي سيلفا وفانيكا أيضًا،\N‫‫اللتين أحتفظ بروحيهما.
Dialogue: 0,0:11:24.54,0:11:27.85,main,MEGICULA,0,0,0,,‫جثث حية من الدم والفولاذ…
Dialogue: 0,0:11:32.13,0:11:34.60,main,MEGICULA,0,0,0,,‫مئة جثة إجمالًا.
Dialogue: 0,0:11:53.68,0:11:56.22,main,ASTA,0,0,0,,‫جسدي يؤلمني فعلًا من كل ناحية!
Dialogue: 0,0:11:56.22,0:11:58.36,main,ASTA,0,0,0,,‫إننا نُسحب!
Dialogue: 0,0:12:04.76,0:12:07.21,main,UNDINE,0,0,0,,‫شكرًا لإنقاذك لوروبيتشكا!
Dialogue: 0,0:12:07.21,0:12:09.88,main,ASTA,0,0,0,,‫على الرحب! وشكرًا على إنقاذنا!
Dialogue: 0,0:12:10.14,0:12:14.05,main,ASTA,0,0,0,,‫آسف! أنا عديم الفائدة تمامًا الآن!
Dialogue: 0,0:12:14.51,0:12:16.00,main,ASTA,0,0,0,,‫الباقي عليكم!
Dialogue: 0,0:12:16.00,0:12:19.53,main,NOELLE,0,0,0,,‫ماذا؟! لقد وصلت للتو! عمّ تتحدث؟!
Dialogue: 0,0:12:19.53,0:12:21.80,main,ASTA,0,0,0,,‫نويل! الأمر بين يديك!
Dialogue: 0,0:12:22.64,0:12:24.13,italics,NOELLE (INT),0,0,0,,‫أعرف ذلك.
Dialogue: 0,0:12:24.53,0:12:27.89,italics,NOELLE (INT),0,0,0,,‫أنا واثقة أنك تهورت كثيرًا كعادتك.
Dialogue: 0,0:12:28.63,0:12:29.98,italics,NOELLE (INT),0,0,0,,‫لقد فعلت ما يكفي.
Dialogue: 0,0:12:30.81,0:12:32.78,italics,NOELLE (INT),0,0,0,,‫مجرد حضورك…
Dialogue: 0,0:12:33.97,0:12:36.13,italics,NOELLE (INT),0,0,0,,‫ومجرد التفكير فيك…
Dialogue: 0,0:12:37.46,0:12:39.44,italics,NOELLE (INT),0,0,0,,‫يمنحني القوة!
Dialogue: 0,0:12:40.81,0:12:43.62,italics,NOELLE (INT),0,0,0,,‫إذًا هذا صحيح.
Dialogue: 0,0:12:44.33,0:12:46.42,italics,NOELLE (INT),0,0,0,,‫ظللت أختلق الأعذار حتى الآن،
Dialogue: 0,0:12:46.42,0:12:48.81,italics,NOELLE (INT),0,0,0,,‫لكن لم أتوقع أن أدرك ذلك في وقت كهذا…
Dialogue: 0,0:12:50.33,0:12:53.75,italics,NOELLE (INT),0,0,0,,‫أظن أنني أحب أستا حتمًا.
Dialogue: 0,0:12:54.33,0:12:56.49,italics,NOELLE (INT),0,0,0,,‫لكننا في ساحة المعركة الآن.
Dialogue: 0,0:12:56.90,0:12:59.26,italics,NOELLE (INT),0,0,0,,‫سأهزم ميغيكولا الآن!
Dialogue: 0,0:12:59.71,0:13:01.51,main,NOELLE,0,0,0,,‫هيا بنا يا أونديني!
Dialogue: 0,0:13:02.03,0:13:03.86,main,NOELLE,0,0,0,,‫مستوى القداسة النهائي!
Dialogue: 0,0:13:11.19,0:13:13.44,main,ASTA,0,0,0,,‫أنت رائعة جدًا!
Dialogue: 0,0:13:14.12,0:13:16.69,main,NOELLE,0,0,0,,‫اعتنِ بلوروبيتشكا يا أستا!
Dialogue: 0,0:13:16.69,0:13:18.44,main,ASTA,0,0,0,,‫آه! حسنًا!
Dialogue: 0,0:13:21.83,0:13:26.18,main,UNDINE,0,0,0,,‫ليس لدينا ما يكفي من قوة مستوى\N‫‫القداسة لمواجهة كل هذا الجيش!
Dialogue: 0,0:13:27.25,0:13:30.26,italics,RILL (INT),0,0,0,,‫سحر الصور: سيد فالهالا.
Dialogue: 0,0:13:32.02,0:13:34.02,italics,RILL (INT),0,0,0,,‫نويل ومستوى القداسة خاصتها
Dialogue: 0,0:13:34.02,0:13:37.53,italics,RILL (INT),0,0,0,,‫وشارلوت بهجومها الخاص\N‫‫المضاد للعنات ضروريان!
Dialogue: 0,0:13:39.22,0:13:41.84,main,RILL,0,0,0,,‫وهذا يعني أن عليّ تقديم دعم قوي!
Dialogue: 0,0:13:41.84,0:13:45.65,italics,CHARLOTTE (INT),0,0,0,,‫سحر الورد البري الحقيقي:\N‫‫رمح الكرمة القرمزية!
Dialogue: 0,0:13:48.29,0:13:52.04,main,MEGICULA,0,0,0,,‫لا تكفون عن التطور في المعارك أيها البشر.
Dialogue: 0,0:13:54.65,0:13:56.11,main,MEGICULA,0,0,0,,‫أنتم حقًا…
Dialogue: 0,0:14:03.38,0:14:07.00,main,MEGICULA,0,0,0,,‫أفضل الدمى للتسلية.
Dialogue: 0,0:14:12.64,0:14:13.87,main,RILL,0,0,0,,‫نويل!
Dialogue: 0,0:14:24.05,0:14:25.14,main,NOELLE,0,0,0,,‫لاك!
Dialogue: 0,0:14:25.39,0:14:27.76,main,LUCK,0,0,0,,‫سأفتح طريقًا لك، لذا اتبعيني!
Dialogue: 0,0:14:28.07,0:14:29.86,main,RILL,0,0,0,,‫هذا رائع يا رفاق!
Dialogue: 0,0:14:29.86,0:14:33.22,main,RILL,0,0,0,,‫الإلهام يتدفق إليّ بلا توقف!
Dialogue: 0,0:14:33.22,0:14:35.52,italics,RILL (INT),0,0,0,,‫لو كان هناك ساحر برق آخر يرشدنا،
Dialogue: 0,0:14:35.81,0:14:37.77,italics,RILL (INT),0,0,0,,‫لكان الأمر أفضل بكثير!
Dialogue: 0,0:14:47.38,0:14:50.29,italics,GAJA (INT),0,0,0,,‫أنا ميت تقريبًا بالفعل…
Dialogue: 0,0:14:53.20,0:14:54.62,italics,GAJA (INT),0,0,0,,‫لكن رغم ذلك…
Dialogue: 0,0:14:55.39,0:14:59.50,italics,GAJA (INT),0,0,0,,‫أنا ممتن لفرصة القتال مجددًا\N‫‫من أجل الملكة لوروبيتشكا!
Dialogue: 0,0:15:00.71,0:15:02.71,main,LUCK,0,0,0,,‫غاجا!
Dialogue: 0,0:15:06.48,0:15:07.63,main,LUCK,0,0,0,,‫لنفعلها!
Dialogue: 0,0:15:08.03,0:15:08.81,main,GAJA,0,0,0,,‫أجل.
Dialogue: 0,0:15:23.85,0:15:24.82,italics,NOELLE (INT),0,0,0,,‫الآن!
Dialogue: 0,0:15:32.25,0:15:34.79,main,MEGICULA,0,0,0,,‫رغم أنني لم أكتمل بعد،
Dialogue: 0,0:15:34.79,0:15:37.40,main,MEGICULA,0,0,0,,‫استطعتم أن تضغطوا عليّ إلى هذا الحد.
Dialogue: 0,0:15:38.08,0:15:40.84,main,MEGICULA,0,0,0,,‫لقد تفاجأت حقًا.
Dialogue: 0,0:15:41.84,0:15:43.31,main,MEGICULA,0,0,0,,‫لكن مع ذلك…
Dialogue: 0,0:15:45.96,0:15:47.68,main,MEGICULA,0,0,0,,‫هذه هي النهاية.
Dialogue: 0,0:15:58.57,0:16:03.96,main,NOZEL,0,0,0,,‫كيف تجرئين على الظهور أمام عائلتي مجددًا؟
Dialogue: 0,0:16:07.21,0:16:11.55,main,NOZEL,0,0,0,,‫لا تدركين كم انتظرت هذه اللحظة.
Dialogue: 0,0:16:17.73,0:16:22.84,italics,NOZEL (INT),0,0,0,,‫بعدما حلت اللعنة بأمي،\N‫‫ضُعفت سريعًا
Dialogue: 0,0:16:23.42,0:16:25.85,italics,NOZEL (INT),0,0,0,,‫لم يكن أفراد عائلتنا يعلمون شيئًا،
Dialogue: 0,0:16:25.85,0:16:28.43,italics,NOZEL (INT),0,0,0,,‫فظنوا أن السبب هو ولادتها الأخيرة.
Dialogue: 0,0:16:29.52,0:16:32.84,italics,NOZEL (INT),0,0,0,,‫حين أُلقي سحر صد اللعنات على أمي،
Dialogue: 0,0:16:32.84,0:16:35.39,italics,NOZEL (INT),0,0,0,,‫أصابتني آثار جانبية منه.
Dialogue: 0,0:16:36.08,0:16:39.51,italics,NOZEL (INT),0,0,0,,‫لو أخبرت أحدًا أن ميغيكولا كانت\N‫‫متورطة في موت أسيي سيلفا،
Dialogue: 0,0:16:39.51,0:16:40.97,italics,NOZEL (INT),0,0,0,,‫لمتّ.
Dialogue: 0,0:16:41.69,0:16:46.75,italics,NOZEL (INT),0,0,0,,‫وإن أخبرت أحدًا، فستصيبه اللعنة أيضًا.
Dialogue: 0,0:16:46.75,0:16:49.97,italics,NOZEL (INT),0,0,0,,‫كانت تعويذة تنتشر كالمرض.
Dialogue: 0,0:16:51.00,0:16:53.35,flashback italics,YOUNG NOZEL (INT)(FB),0,0,0,,‫لا أستطيع إخبار أحد.
Dialogue: 0,0:16:53.69,0:16:55.89,flashback italics,YOUNG NOZEL (INT)(FB),0,0,0,,‫يجب أن أفعل شيئًا بنفسي.
Dialogue: 0,0:16:56.40,0:16:58.07,flashback italics,YOUNG NOZEL (INT)(FB),0,0,0,,‫عليّ إنقاذ أمي!
Dialogue: 0,0:16:58.49,0:17:00.51,flashback italics,YOUNG NOZEL (INT)(FB),0,0,0,,‫عليّ إيجاد سبيل لفك اللعنة!
Dialogue: 0,0:17:01.14,0:17:03.59,flashback,ACIER (FB),0,0,0,,‫نوزيل… هذا يكفي.
Dialogue: 0,0:17:07.69,0:17:11.22,flashback,ACIER (FB),0,0,0,,‫إن واصلت ذلك، فستكون حياتك في خطر أيضًا.
Dialogue: 0,0:17:11.85,0:17:12.97,flashback,YOUNG NOZEL (FB),0,0,0,,‫لكن…
Dialogue: 0,0:17:13.83,0:17:16.89,flashback,ACIER (FB),0,0,0,,‫لا يصبح المرء قويًا بهذه السهولة.
Dialogue: 0,0:17:19.73,0:17:21.37,flashback,ACIER (FB),0,0,0,,‫لكن لا تقلق.
Dialogue: 0,0:17:22.81,0:17:25.72,flashback,ACIER (FB),0,0,0,,‫أنت… وكلكم…
Dialogue: 0,0:17:26.34,0:17:28.76,flashback,ACIER (FB),0,0,0,,‫ستصبحون أقوى مني يومًا ما.
Dialogue: 0,0:17:30.25,0:17:31.85,flashback,ACIER (FB),0,0,0,,‫لذا عش…
Dialogue: 0,0:17:33.19,0:17:34.06,flashback,ACIER (FB),0,0,0,,‫يا نوزيل.
Dialogue: 0,0:17:44.14,0:17:48.13,italics,NOZEL (INT),0,0,0,,‫ماتت أمي بعد عام من إصابتها باللعنة.
Dialogue: 0,0:17:48.57,0:17:54.59,italics,NOZEL (INT),0,0,0,,‫وطوال ذلك العام،\N‫‫لم أستطع سوى المشاهدة عاجزًا.
Dialogue: 0,0:17:58.81,0:18:00.10,flashback italics,YOUNG NOZEL (INT)(FB),0,0,0,,‫أقوى…
Dialogue: 0,0:18:04.04,0:18:06.30,flashback italics,NOZEL (INT)(FB),0,0,0,,‫عليّ أن أصبح أقوى.
Dialogue: 0,0:18:07.85,0:18:13.73,flashback italics,NOZEL (INT)(FB),0,0,0,,‫لأثأر لأمي يومًا ما! ولأحمي إخوتي!
Dialogue: 0,0:18:15.12,0:18:18.22,flashback italics,NOZEL (INT)(FB),0,0,0,,‫يزداد نيبرا وسوليد قوة أيضًا،
Dialogue: 0,0:18:18.57,0:18:21.37,flashback italics,NOZEL (INT)(FB),0,0,0,,‫لكنهما ليسا ندين لخصم كهذا.
Dialogue: 0,0:18:21.87,0:18:22.96,flashback italics,NOZEL (INT)(FB),0,0,0,,‫وأما نويل…
Dialogue: 0,0:18:23.31,0:18:26.88,flashback,NOELLE (FB),0,0,0,,‫نوزيل… هلّا تعلمني السحر؟
Dialogue: 0,0:18:27.52,0:18:29.93,flashback italics,NOZEL (INT)(FB),0,0,0,,‫ما دامت لا فرصة أمامها لتصبح أقوى،
Dialogue: 0,0:18:29.93,0:18:32.88,flashback italics,NOZEL (INT)(FB),0,0,0,,‫فالأفضل أن أحبسها بعيدًا.
Dialogue: 0,0:18:33.87,0:18:37.72,flashback,NOZEL (FB),0,0,0,,‫لا مكان لفاشلة مثلك في ساحة المعركة.
Dialogue: 0,0:18:38.44,0:18:41.10,flashback italics,NOZEL (INT)(FB),0,0,0,,‫إن كانت ستعاني ما عانيته فحسب،
Dialogue: 0,0:18:41.10,0:18:42.95,flashback italics,NOZEL (INT)(FB),0,0,0,,‫فعليّ إبعادها عن القتال…
Dialogue: 0,0:18:44.16,0:18:49.85,flashback,NOZEL (FB),0,0,0,,‫لماذا اضطرت أمي للموت وهي تلد شخصًا مثلك؟
Dialogue: 0,0:18:51.41,0:18:53.93,flashback,NOZEL (FB),0,0,0,,‫أنت قتلت أمي.
Dialogue: 0,0:18:55.66,0:18:56.99,flashback italics,NOZEL (INT)(FB),0,0,0,,‫لا!
Dialogue: 0,0:18:57.74,0:18:59.48,flashback italics,NOZEL (INT)(FB),0,0,0,,‫أنا من قتلها!
Dialogue: 0,0:19:00.87,0:19:03.62,flashback italics,NOZEL (INT)(FB),0,0,0,,‫أنا عديم الفائدة ولم أستطع فعل شيء.
Dialogue: 0,0:19:04.17,0:19:07.25,flashback italics,NOZEL (INT)(FB),0,0,0,,‫خفت أن أفقد المزيد، فهربت.
Dialogue: 0,0:19:07.25,0:19:10.14,flashback italics,NOZEL (INT)(FB),0,0,0,,‫أنا جبان ليست لديّ العزيمة لحماية أي شيء.
Dialogue: 0,0:19:11.93,0:19:15.77,flashback italics,NOZEL (INT)(FB),0,0,0,,‫ليس لي الحق في التدخل في أمرك بعد الآن.
Dialogue: 0,0:19:16.94,0:19:18.14,flashback italics,NOZEL (INT)(FB),0,0,0,,‫أقوى…
Dialogue: 0,0:19:20.08,0:19:21.56,flashback italics,NOZEL (INT)(FB),0,0,0,,‫أقوى!
Dialogue: 0,0:19:25.19,0:19:28.56,flashback italics,NOZEL (INT)(FB),0,0,0,,‫كان الحل المنطقي أن أسعى\N‫‫لأن أصبح إمبراطور السحر.
Dialogue: 0,0:19:29.48,0:19:33.68,flashback italics,NOZEL (INT)(FB),0,0,0,,‫لا يمكنني أن أموت هنا…
Dialogue: 0,0:19:34.36,0:19:38.11,flashback italics,NOZEL (INT)(FB),0,0,0,,‫تمكنت من مقاتلة أعداء يستخدمون\N‫‫سحرًا شريرًا مثل تلك الشيطانة.
Dialogue: 0,0:19:38.11,0:19:41.49,flashback italics,NOZEL (INT)(FB),0,0,0,,‫ولذلك، من أجل اليوم الذي سيأتي حتمًا…
Dialogue: 0,0:19:47.45,0:19:48.25,main,NOZEL,0,0,0,,‫أريد…
Dialogue: 0,0:19:49.00,0:19:52.42,main,NOZEL,0,0,0,,‫أن أشكر الجميع هنا الآن.
Dialogue: 0,0:19:58.64,0:20:02.06,main,NOZEL,0,0,0,,‫أخيرًا… نلتقي مجددًا.
Dialogue: 0,0:20:03.05,0:20:05.85,main,NOZEL,0,0,0,,‫سأسخّر كل ما كنت عليه\N‫‫وكل ما أملكه في هذا الهجوم!
Dialogue: 0,0:20:10.50,0:20:14.36,main,MEGICULA,0,0,0,,‫لقاء مؤثر… أهذا ما يحدث؟
Dialogue: 0,0:20:20.56,0:20:24.29,main,MEGICULA,0,0,0,,‫آسفة، لكنني لا أملك مثل هذه المشاعر.
Dialogue: 0,0:20:27.04,0:20:31.46,flashback,ACIER (FB),0,0,0,,‫لديك صلابة الفولاذ ومرونة الماء.
Dialogue: 0,0:20:31.69,0:20:33.42,main,NOZEL,0,0,0,,‫لا تظني أنك تستطيعين صد هذا!
Dialogue: 0,0:20:35.47,0:20:39.63,italics,NOZEL (INT),0,0,0,,‫الدم يتطاير… والفولاذ يشق طريقه…
Dialogue: 0,0:20:40.28,0:20:44.14,italics,NOZEL (INT),0,0,0,,‫ومع ذلك، لا أستطيع تدمير قلبها.
Dialogue: 0,0:20:45.02,0:20:47.56,italics,NOZEL (INT),0,0,0,,‫أظن أنني كنت مخطئًا في النهاية.
Dialogue: 0,0:20:47.80,0:20:51.06,italics,NOZEL (INT),0,0,0,,‫ما كان ينبغي أن أحبسها\N‫‫أو أبعدها عن هذا.
Dialogue: 0,0:20:53.05,0:20:56.07,italics,NOZEL (INT),0,0,0,,‫كان علينا أن نصبح أقوى معًا.
Dialogue: 0,0:21:01.21,0:21:02.87,main,NOELLE,0,0,0,,‫لم نستسلم!
Dialogue: 0,0:21:03.42,0:21:06.24,main,NOELLE,0,0,0,,‫ولهذا سنفوز بهذه المعركة يا ميغيكولا!
Dialogue: 0,0:21:14.10,0:21:19.52,italics,MEGICULA (INT),0,0,0,,‫كنت حذرة، لكنني ظننت أنني\N‫‫لن أخسر أمام البشر…
Dialogue: 0,0:21:22.38,0:21:29.02,main,MEGICULA,0,0,0,,‫يبدو أنني أسأت تقدير… قوتكم الحقيقية.
