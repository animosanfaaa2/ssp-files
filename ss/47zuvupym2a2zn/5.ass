Dialogue: 0,0:14:16.71,0:14:18.38,Default,Virgo,0,0,0,,!كما توقعت
Dialogue: 0,0:14:25.72,0:14:28.34,Default,Scorpius,0,0,0,,!عجبًا! أليس هذا كاستور
Dialogue: 0,0:14:28.61,0:14:31.02,Default,Scorpius,0,0,0,,ماذا تفعل هنا؟
Dialogue: 0,0:14:31.02,0:14:32.80,Default,Karkinos,0,0,0,,!لم نلتقِ منذ زمن
Dialogue: 0,0:14:32.80,0:14:34.33,Default,Libra,0,0,0,,.لم نلتقِ منذ مئتي سنة
Dialogue: 0,0:14:34.33,0:14:35.17,Default,Aigokeros,0,0,0,,.نعم
Dialogue: 0,0:14:35.17,0:14:36.27,Default,Aries,0,0,0,,!مرحبًا
Dialogue: 0,0:14:36.27,0:14:37.16,Default,Castor,0,0,0,,.نعم
Dialogue: 0,0:14:37.16,0:14:38.48,Default,Castor,0,0,0,,هل كنتُم بخير جميعًا؟
Dialogue: 0,0:14:38.48,0:14:39.02,Default,Aries,0,0,0,,!نعم
Dialogue: 0,0:14:39.77,0:14:41.89,Default,Castor,0,0,0,,.لم أركِ منذ زمن يا سيّدتي لوفاس
Dialogue: 0,0:14:42.35,0:14:45.14,Default,Castor,0,0,0,,.لطالما آمنتُ بأنّك ستعودين يومًا ما
Dialogue: 0,0:14:45.14,0:14:45.73,Default,Lufas,0,0,0,,.نعم
Dialogue: 0,0:14:46.01,0:14:49.94,Default,Lufas,0,0,0,,يسرّنا رؤيتك سالمًا\N.وبخير أيضًا يا كاستور
Dialogue: 0,0:14:49.94,0:14:50.63,Default,Castor,0,0,0,,!نعم
Dialogue: 0,0:14:57.68,0:14:59.16,sign_generic,Sign,0,0,0,,{\b1\fs18\fnTimes New Roman\bord0\blur1.5\t(0,464,\blur0)\t(0,464,\bord0.75)\c&HF6FDFC&\t(0,464,\c&HC7BB7B&)\3c&HD9E5BB&\pos(320,299.333)}انضمّ كاستور إلى فرقتك
Dialogue: 0,0:14:59.85,0:15:00.97,italics,Lufas,0,0,0,,.كاستور
Dialogue: 0,0:15:01.28,0:15:04.10,italics,Lufas,0,0,0,,في اللّعبة، قُدِّم مع أخته الصغيرة في\Nحزمة واحدة تحت تصنيف
Dialogue: 0,0:15:04.10,0:15:05.79,italics,Lufas,0,0,0,,الوحوش المعروفة\N"باسم "الشقيقين الجنيين
Dialogue: 0,0:15:06.24,0:15:07.36,italics,Lufas,0,0,0,,،لكن في هذا العالم
Dialogue: 0,0:15:07.36,0:15:09.92,italics,Lufas,0,0,0,,أهو يعمل بمفرده تمامًا؟
Dialogue: 1,0:15:08.03,0:15:11.34,stats,Sign,0,0,0,,{\frz270\fs8\move(356,-95,356,157.847,0,3310)}كاستور من النجوم السماوية الاثني عشر
Dialogue: 0,0:15:08.03,0:15:11.34,stats,Sign,0,0,0,,{\c&HA1B75D&\an7\blur4\bord0\shad0\fscx100\fscy100\p1\move(350,-95,350,157.847,0,3310)}m 0 -55 l 16 -55 16 55 0 55
Dialogue: 0,0:15:10.40,0:15:11.77,italics,Lufas,0,0,0,,لكن في المقابل، تبدو بياناته أيضًا
Dialogue: 0,0:15:11.77,0:15:13.69,italics,Lufas,0,0,0,,.مختلفة عمّا أعرفه
Dialogue: 0,0:15:14.54,0:15:17.81,Default,Lufas,0,0,0,,.تبدو مرهقًا جدًا
Dialogue: 0,0:15:19.28,0:15:20.77,Default,Castor,0,0,0,,…بشأن هذا الأمر
Dialogue: 0,0:15:22.23,0:15:23.52,Default,Castor,0,0,0,,!أعتذر
Dialogue: 0,0:15:23.96,0:15:26.73,Default,Castor,0,0,0,,قبل أيّام، استطاع ملك\Nالشياطين سرقة
Dialogue: 0,0:15:26.73,0:15:29.19,Default,Castor,0,0,0,,مفتاح بلوغ السماوات\N!الذي ائتمنتني عليه
Dialogue: 0,0:15:29.19,0:15:31.02,italics,Lufas,0,0,0,,!مفتاح بلوغ السماوات؟
Dialogue: 0,0:15:31.02,0:15:32.33,italics,Lufas,0,0,0,,!ما هذا؟
Dialogue: 0,0:15:32.33,0:15:33.93,italics,Lufas,0,0,0,,!لم يكن في اللّعبة
Dialogue: 0,0:15:34.40,0:15:36.39,italics,Lufas,0,0,0,,.عليّ أن أسأل دينا لاحقًا
Dialogue: 0,0:15:37.16,0:15:38.93,Default,Lufas,0,0,0,,.لا بأس. لا تقلق
Dialogue: 0,0:15:38.93,0:15:39.51,Default,Castor,0,0,0,,!نعم
Dialogue: 0,0:15:39.51,0:15:40.25,Default,Lufas,0,0,0,,.دينا
Dialogue: 0,0:15:40.25,0:15:41.00,Default,Dina,0,0,0,,!نعم
Dialogue: 0,0:15:41.59,0:15:43.21,Default,Lufas,0,0,0,,.تولّي علاجه
Dialogue: 0,0:15:43.21,0:15:43.99,Default,Dina,0,0,0,,!نعم
Dialogue: 0,0:15:45.01,0:15:46.27,Default,Castor,0,0,0,,ومن أنتِ؟
Dialogue: 0,0:15:46.27,0:15:50.90,top,Dina,0,0,0,,نعم! أنا مستشارة السيّدة\N!لوفاس وقد لازمتُها طيلة الوقت
Dialogue: 0,0:15:47.44,0:15:48.34,Default,Lufas,0,0,0,,،والآن
Dialogue: 0,0:15:48.34,0:15:50.46,Default,Lufas,0,0,0,,.لنستمع إلى ما حدث
Dialogue: 0,0:15:50.90,0:15:51.80,Default,Virgo,0,0,0,,.نعم
Dialogue: 0,0:15:55.13,0:15:57.48,Default,Lufas,0,0,0,,…تحالف ساجيتاريوس مع ليون
Dialogue: 0,0:15:57.48,0:15:59.18,Default,Lufas,0,0,0,,ما رأيكم جميعًا؟
Dialogue: 0,0:15:59.18,0:16:00.48,Default,Karkinos,0,0,0,,.يا له من أحمق
Dialogue: 0,0:16:00.48,0:16:01.77,Default,Aigokeros,0,0,0,,.لا أرى في تصرّفه سوى قِصر نظر
Dialogue: 0,0:16:01.77,0:16:03.43,Default,Libra,0,0,0,,.إنّه أحمق ميؤوس من أمره
Dialogue: 0,0:16:03.43,0:16:05.98,Default,Aries,0,0,0,,.أجد تصرفه غير معقول بعض الشيء أيضًا
Dialogue: 0,0:16:05.98,0:16:07.69,Default,Scorpius,0,0,0,,.عليه أن يموت
Dialogue: 0,0:16:07.95,0:16:08.89,italics,Lufas,0,0,0,,…مهلًا
Dialogue: 0,0:16:08.89,0:16:15.04,Default,Aigokeros,0,0,0,,قد يكون مرض التنين الحارس\N.مرتبطًا بهذا الأمر أيضًا
Dialogue: 0,0:16:18.17,0:16:19.62,Default,Karkinos,0,0,0,,…أيعقل أنّك
Dialogue: 0,0:16:20.44,0:16:21.83,Default,Scorpius,0,0,0,,!لستُ الفاعلة
Dialogue: 0,0:16:21.83,0:16:23.58,Default,Scorpius,0,0,0,,،عندما كنتُ أخطّط لمهاجمة دراوبنير
Dialogue: 0,0:16:23.58,0:16:25.36,Default,Scorpius,0,0,0,,،أدركتُ أنَّ قتال التنين سيكون مزعجًا
Dialogue: 0,0:16:25.36,0:16:28.21,Default,Scorpius,0,0,0,,لذا خططتُ فقط لنشر السم\Nكي أمرضه وأوهن قوّته
Dialogue: 0,0:16:28.21,0:16:30.59,Default,Scorpius,0,0,0,,!قبل أن آخذ وقتي في قتله بنفسي
Dialogue: 0,0:16:30.59,0:16:31.92,Default,Viro,0,0,0,,!مـ-محال
Dialogue: 0,0:16:32.20,0:16:33.38,Default,Karkinos,0,0,0,,.يا لكِ من حمقاء
Dialogue: 0,0:16:33.38,0:16:34.60,Default,Aigokeros,0,0,0,,.لا أرى في تصرّفها سوى قصر نظر
Dialogue: 0,0:16:34.60,0:16:36.33,Default,Libra,0,0,0,,.إنّها حمقاء ميؤوس من أمرها
Dialogue: 0,0:16:36.33,0:16:39.35,Default,Aries,0,0,0,,.أجد تصرّفها غير معقول بعض الشيء أيضًا
Dialogue: 0,0:16:39.35,0:16:41.64,Default,Scorpius,0,0,0,,!بحقّكم
Dialogue: 0,0:16:42.23,0:16:43.85,Default,Scorpius,0,0,0,,!لـ-لكن ذلك  غريب
Dialogue: 0,0:16:43.85,0:16:44.98,Default,Scorpius,0,0,0,,،أستطيع تفهّم تصرف ليون
Dialogue: 0,0:16:44.98,0:16:48.07,Default,Scorpius,0,0,0,,لكن أيعقل أن يفعل\Nساجيتاريوس مثل تلك الحماقة؟
Dialogue: 0,0:16:48.07,0:16:52.28,Default,Karkinos,0,0,0,,ساجيتاريوس الذي أعرفه\N.كان أكثر حذرًا واتزانًا
Dialogue: 0,0:16:52.28,0:16:55.88,italics,Lufas,0,0,0,,أي أنَّ ثمة أمرًا آخر\N.يجري في الخفاء
Dialogue: 0,0:16:56.28,0:16:59.68,italics,Lufas,0,0,0,,كما أنَّ الرسالة التي تركها\N.لليبرا لا تبدو منطقية
Dialogue: 0,0:17:00.01,0:17:04.12,italics,Lufas,0,0,0,,كأنّه يقول لنا\N"أنا مع ليون لذا توخوا الحذر"
Dialogue: 0,0:17:04.96,0:17:06.36,Default,Lufas,0,0,0,,.اتخذنا قرارنا
Dialogue: 0,0:17:06.36,0:17:09.47,Default,Lufas,0,0,0,,!هدفنا التالي هو استعادة ليون وساجيتاريوس
Dialogue: 0,0:17:09.88,0:17:13.23,Default,Lufas,0,0,0,,.سنتحقق مجددًا من نواياهُما الحقيقية
Dialogue: 0,0:17:13.23,0:17:14.10,Default,All,0,0,0,,!نعم
Dialogue: 0,0:17:13.23,0:17:14.10,top,Libra,0,0,0,,.مفهوم
Dialogue: 0,0:17:14.10,0:17:15.09,Default,Lufas,0,0,0,,،دينا
Dialogue: 0,0:17:15.09,0:17:17.01,Default,Lufas,0,0,0,,هل تعرفين أين يوجد ليون؟
Dialogue: 0,0:17:17.01,0:17:19.19,Default,Dina,0,0,0,,!في تيرفينغ على الأرجح
Dialogue: 0,0:17:19.19,0:17:21.19,Default,Dina,0,0,0,,إنّها في الأساس اتحاد\Nيضم أشباه البشر
Dialogue: 0,0:17:21.19,0:17:23.31,Default,Dina,0,0,0,,.الذين يُصنّفون كوحوش
Dialogue: 0,0:17:23.86,0:17:28.54,Default,Dina,0,0,0,,تقع تيرفينغ في المنطقة التي\N.تُعدّ الأخطر ضمن أراضي البشر
Dialogue: 0,0:17:28.89,0:17:30.82,Default,Lufas,0,0,0,,منطقة خطيرة؟
Dialogue: 0,0:17:30.82,0:17:31.42,Default,Dina,0,0,0,,.نعم
Dialogue: 0,0:17:31.42,0:17:34.38,Default,Dina,0,0,0,,.إنّها قريبة من موطن قوم الشياطين
Dialogue: 0,0:17:34.38,0:17:36.93,Default,Dina,0,0,0,,بنى أشباه البشر قراهم واستقرّوا هناك
Dialogue: 0,0:17:36.93,0:17:39.66,Default,Dina,0,0,0,,.هربًا من أعين البشر
Dialogue: 0,0:17:39.66,0:17:43.40,Default,Dina,0,0,0,,،قوم السمك، قوم الحشرات\N،قوم النباتات، قوم الأفاعي
Dialogue: 0,0:17:43.40,0:17:45.02,Default,Dina,0,0,0,,.إلى جانب أجناس أخرى متنوعة
Dialogue: 0,0:17:45.02,0:17:48.80,Default,Dina,0,0,0,,.وهناك أيضًا موطن ساجيتاريوس، قرية القنطور
Dialogue: 0,0:17:50.12,0:17:54.01,italics,Lufas,0,0,0,,ربّما يعرف ساجيتاريوس أحوال\N.أبناء قومه من القناطير
Dialogue: 0,0:17:55.23,0:17:57.01,Default,Virgo,0,0,0,,!سيّدتي لوفاس
Dialogue: 0,0:17:57.01,0:17:59.00,Default,Virgo,0,0,0,,!وصل سي والآخرون
Dialogue: 0,0:17:59.00,0:17:59.91,Default,Jean,0,0,0,,!مرحبًا
Dialogue: 0,0:17:59.91,0:18:01.05,Default,Sei,0,0,0,,.آسف
Dialogue: 0,0:18:01.05,0:18:02.47,Default,Gantz,0,0,0,,.تأخرنا قليلًا
Dialogue: 0,0:18:02.47,0:18:04.11,Default,Virgo,0,0,0,,أين نيك والبقية؟
Dialogue: 0,0:18:04.11,0:18:09.11,Default,Jean,0,0,0,,جروحهم عميقة قليلًا لذا\N.يتعافون في دراوبنير
Dialogue: 0,0:18:09.11,0:18:10.10,Default,Petto,0,0,0,,.صحيح
Dialogue: 0,0:18:10.10,0:18:10.83,Default,Petto,0,0,0,,!لهذا
Dialogue: 0,0:18:11.69,0:18:14.98,Default,Petto,0,0,0,,أتيتُ لأحلّ محلّهم\N!لأعوض غيابهم
Dialogue: 0,0:18:14.98,0:18:17.46,Default,Petto,0,0,0,,،لكن لو كان لدينا المزيد من الإكسير
Dialogue: 0,0:18:17.46,0:18:19.85,Default,Petto,0,0,0,,.لربّما استطعنا معالجة جروحهم أيضًا
Dialogue: 0,0:18:20.72,0:18:24.44,Default,Jean,0,0,0,,مع ذلك! إنّه دواء أسطوري، صحيح؟
Dialogue: 0,0:18:24.44,0:18:26.56,Default,Jean,0,0,0,,!لا ينبغي إهداره عليهم
Dialogue: 0,0:18:28.42,0:18:32.46,italics,Lufas,0,0,0,,إن كانُوا بحاجة إلى الإكسير، فلديّ\N.في مرقد الملك ما يزيد عن حاجتي
Dialogue: 0,0:18:33.93,0:18:35.45,Default,Lufas,0,0,0,,.يسعدنا  قدومك يا بطل
Dialogue: 0,0:18:36.55,0:18:38.38,Default,Lufas,0,0,0,,يبدو أنّ لديك أسئلة لنا؟
Dialogue: 0,0:18:38.86,0:18:40.35,Default,Sei,0,0,0,,!نـ-نعم
Dialogue: 0,0:18:42.39,0:18:43.61,Default,Lufas,0,0,0,,.بالطبع
Dialogue: 0,0:18:43.61,0:18:47.68,Default,Lufas,0,0,0,,أتيتَ للقائنا لتتأكد\Nما إن كنّا حقًا
Dialogue: 0,0:18:47.68,0:18:50.98,Default,Lufas,0,0,0,,.أعداء هذا العالم كما تصفنا الأسطورة
Dialogue: 0,0:18:50.98,0:18:51.91,Default,Sei,0,0,0,,.نعم
Dialogue: 0,0:18:53.19,0:18:56.99,Default,Lufas,0,0,0,,لا ننوي حاليًا معارضتك
Dialogue: 0,0:18:56.99,0:19:02.66,Default,Lufas,0,0,0,,رغم أنّنا سبق وصرّحنا بذلك منذ\N.استدعائنا إلى هذا العالم أوّل مرة
Dialogue: 0,0:19:05.95,0:19:11.15,Default,Sei,0,0,0,,أهذا يعني أنّكم ستتعاونون\Nمعنا لقتال قوم الشياطين؟
Dialogue: 0,0:19:11.15,0:19:12.66,Default,Lufas,0,0,0,,،لن يكون هذا خيارًا سيئًا
Dialogue: 0,0:19:12.66,0:19:14.34,Default,Lufas,0,0,0,,.لكن لدينا أمورًا أخرى تتطلب اهتمامنا أولًا
Dialogue: 0,0:19:14.34,0:19:15.31,Default,Sei,0,0,0,,أمور أخرى؟
Dialogue: 0,0:19:15.31,0:19:19.13,Default,Lufas,0,0,0,,،ليون يحرّض الوحوش وأشباه البشر
Dialogue: 0,0:19:19.13,0:19:22.51,Default,Lufas,0,0,0,,.ويبدو أنّه يسعى لجرّهم نحو الهلاك
Dialogue: 0,0:19:22.51,0:19:25.61,Default,Lufas,0,0,0,,إنَّ أخطاء أتباعنا تعدّ أخطائنا\N.نحن بصفتنا سيّدتهم
Dialogue: 0,0:19:25.92,0:19:28.52,Default,Lufas,0,0,0,,.ولهذا، علينا إيقاف ذلك الأحمق
Dialogue: 0,0:19:28.52,0:19:29.14,Default,Jean,0,0,0,,…في هذه الحالة
Dialogue: 0,0:19:29.14,0:19:31.13,Default,Jean,0,0,0,,!هذا الأمر مرتبط بما نفعله أيضًا
Dialogue: 0,0:19:31.13,0:19:34.73,Default,Jean,0,0,0,,إن اتحدت تلك الوحوش وشنّت\N!الحرب، فستكون العواقب وخيمة
Dialogue: 0,0:19:34.73,0:19:38.65,Default,Gantz,0,0,0,,!لنتعاون معًا لإيقاف ليون ذاك يا لوفاس
Dialogue: 0,0:19:38.65,0:19:39.57,Default,Lufas,0,0,0,,…لا
Dialogue: 0,0:19:39.57,0:19:41.22,italics,Lufas,0,0,0,,،أقدّر حماسكم
Dialogue: 0,0:19:41.22,0:19:43.14,italics,Lufas,0,0,0,,…لكن بمستواهم هذا
Dialogue: 0,0:19:43.98,0:19:46.45,Default,Lufas,0,0,0,,سيتحول موقع تواجد\N.ليون إلى ساحة معركة
Dialogue: 0,0:19:46.45,0:19:48.90,Default,Lufas,0,0,0,,نودّ التوجه إلى هناك برفقة\N.النجوم السماوية الاثني عشر
Dialogue: 0,0:19:48.90,0:19:49.49,Default,Sei,0,0,0,,…لكن
Dialogue: 0,0:19:49.49,0:19:50.95,Default,Lufas,0,0,0,,،بدلًا من مرافقتنا
Dialogue: 0,0:19:50.95,0:19:55.71,Default,Lufas,0,0,0,,نريد منكم أن تتحرّوا أمر\N.موطن ساجيتاريوس، قرية القناطير
Dialogue: 0,0:19:55.71,0:19:56.63,Default,Dina,0,0,0,,!نعم
Dialogue: 0,0:19:56.63,0:19:58.79,Default,Lufas,0,0,0,,.سنكلّف فيرغو وكاستور بمرافقتكم
Dialogue: 0,0:19:59.78,0:20:02.62,Default,Lufas,0,0,0,,سيكون العمل أيسر بوجود\Nأشخاص مألوفين لكم، صحيح؟
Dialogue: 0,0:20:03.03,0:20:06.35,Default,Lufas,0,0,0,,كاستور، نعتذر لتكليفك بهذه المهمة\N،بعد لقائنا مجددًا بوقت قصير
Dialogue: 0,0:20:06.35,0:20:08.52,Default,Lufas,0,0,0,,.لكن أرجو أن تعتني بفيرغو وفرقة البطل
Dialogue: 0,0:20:08.52,0:20:11.06,Default,Castor,0,0,0,,!اتركي الأمر لي يا سيّدتي لوفاس
Dialogue: 0,0:20:12.49,0:20:16.11,Default,Lufas,0,0,0,,هل تعرفين ما هو مفتاح\Nبلوغ السماوات يا دينا؟
Dialogue: 0,0:20:17.16,0:20:19.01,Default,Dina,0,0,0,,،لا أعرف كلّ التفاصيل
Dialogue: 0,0:20:19.01,0:20:20.83,Default,Dina,0,0,0,,لكن يُقال أنّ من يمتلكه
Dialogue: 0,0:20:20.83,0:20:24.07,Default,Dina,0,0,0,,سينال القدرة على تغيير \N.أُسس هذا العالم
Dialogue: 0,0:20:24.07,0:20:26.11,Default,Lufas,0,0,0,,أُسس هذا العالم؟
Dialogue: 0,0:20:26.11,0:20:29.22,Default,Lufas,0,0,0,,يمتلك القدرة على ثني القوانين إذًا؟
Dialogue: 0,0:20:29.22,0:20:31.29,Default,Lufas,0,0,0,,يبدو هذا شبيهًا\N.بصلاحيات مدير النظام
Dialogue: 0,0:20:31.29,0:20:35.39,Default,Dina,0,0,0,,.أو مدير لعبة مُنح مثل تلك السلطة
Dialogue: 0,0:20:36.75,0:20:40.66,italics,Lufas,0,0,0,,لِم أعهد بشيء كهذا إلى\Nكاستور بدلًا من استخدامه أثناء
Dialogue: 0,0:20:40.66,0:20:42.25,italics,Lufas,0,0,0,,المعركة ضد الأبطال السبعة؟
Dialogue: 0,0:20:45.11,0:20:48.18,stats,Sign,0,0,0,,{\bord1.5\blur2\an1\frz270\fs10\3c&HC6D052&\move(642.524,84.571,384,84.571,0,3053)}عرق
Dialogue: 1,0:20:45.11,0:20:48.18,stats,Sign,0,0,0,,{\bord1.5\blur2\an1\frz270\fs6\3c&HC6D052&\move(644.524,120.571,385.5,120.571,0,3053)}كائن اصطناعي
Dialogue: 0,0:20:45.11,0:20:48.18,stats,Sign,0,0,0,,{\c&H979F26&\an7\blur4\bord0\shad0\fscx100\fscy100\p1\move(640.524,120.571,380.5,120.571,0,3053)}m 0 -10 l 10 -10 10 45 0 45
Dialogue: 0,0:20:45.24,0:20:48.18,stats,Sign,0,0,0,,{\bord1.5\blur2\an1\frz270\fs10\3c&HC6D052&\move(642.524,84.571,384,84.571,0,3053)}المستوى
Dialogue: 0,0:20:45.86,0:20:48.18,stats,Sign,0,0,0,,{\bord1.5\blur2\an1\frz270\fs10\3c&HC6D052&\move(643.524,85,385,85,0,3053)}سوزوكي
Dialogue: 0,0:20:48.58,0:20:49.89,Default,Lufas,0,0,0,,ما الأمر يا بطل؟
Dialogue: 0,0:20:49.89,0:20:51.34,Default,Sei,0,0,0,,ما هذا يا لوفاس-سان؟
Dialogue: 0,0:20:51.34,0:20:52.22,Default,Lufas,0,0,0,,.سوزوكي
Dialogue: 0,0:20:52.22,0:20:53.45,Default,Sei,0,0,0,,!لم أقصد هذا
Dialogue: 0,0:20:53.45,0:20:54.90,Default,Sei,0,0,0,,!لِم تملكين عربة سكنية؟
Dialogue: 0,0:20:54.90,0:20:56.58,Default,Lufas,0,0,0,,.بدا لي أنّها مناسبة للرحلات الطويلة
Dialogue: 0,0:20:56.58,0:20:58.49,Default,Lufas,0,0,0,,أكنتَ تفضّل شاحنة بدلًا منها؟
Dialogue: 0,0:20:58.49,0:21:00.69,Default,Sei,0,0,0,,…لا، هذه ليست المشكلة. ما أعنيه
Dialogue: 0,0:21:00.69,0:21:02.07,Default,Luafs,0,0,0,,.نحن نفهم
Dialogue: 0,0:21:02.07,0:21:03.90,Default,Luafs,0,0,0,,،حسنًا، لا يمكننا الخوض في التفاصيل
Dialogue: 0,0:21:03.90,0:21:08.03,Default,Luafs,0,0,0,,لكن تصادف أنَّ لدينا بعض\N.المعرفة عن ذلك العالم أيضًا
Dialogue: 0,0:21:08.03,0:21:09.98,Default,Sei,0,0,0,,…ماذا؟ فهمت
Dialogue: 0,0:21:15.51,0:21:18.15,Default,Lufas,0,0,0,,.والآن، علينا أن نذهب أيضًا
Dialogue: 0,0:21:18.96,0:21:21.08,Default,Lufas,0,0,0,,وجهتنا هي تيرفينغ، صحيح؟
Dialogue: 0,0:21:21.08,0:21:22.01,Default,Dina,0,0,0,,!نعم
Dialogue: 0,0:21:22.01,0:21:22.97,Default,Dina,0,0,0,,…لكن
Dialogue: 0,0:21:22.97,0:21:25.93,Default,Aigokeros,0,0,0,,.قد يُسبّب ذلك بعض المتاعب
Dialogue: 0,0:21:26.72,0:21:29.92,Default,Dina,0,0,0,,.تقع ميولنير مباشرة بجوار تيرفينغ
Dialogue: 0,0:21:29.92,0:21:32.74,Default,Dina,0,0,0,,وهي الدولة التي تحكمها\N.بينيتناش، إحدى الأبطال السبعة
Dialogue: 0,0:21:33.18,0:21:36.43,Default,Dina,0,0,0,,.تختلف بينيتناش عن بقية الأبطال السبعة
Dialogue: 0,0:21:36.84,0:21:37.97,Default,Dina,0,0,0,,إنّها الوحيدة
Dialogue: 0,0:21:37.97,0:21:40.16,Default,Dina,0,0,0,,التي حافظت على القوة\N.التي امتلكتها في أوج مجدها
Dialogue: 0,0:21:40.51,0:21:42.90,Default,Dina,0,0,0,,إنّها مهووسة بك على نحو\Nغير مألوف يا سيّدتي لوفاس
Dialogue: 0,0:21:43.16,0:21:47.38,Default,Dina,0,0,0,,.وهدفها الأعظم هو قتلكِ بيديها
Dialogue: 0,0:21:47.38,0:21:49.37,Default,Dina,0,0,0,,.إنّها أخطر كائن موجود
Dialogue: 0,0:21:51.52,0:21:52.89,italics,Lufas,0,0,0,,…بينيتناش
Dialogue: 0,0:21:54.45,0:21:55.83,Default,Benetnasch,0,0,0,,!أشعر بحضوركِ
Dialogue: 0,0:21:56.11,0:21:58.81,Default,Benetnasch,0,0,0,,،لنكمل من حيث توقفنا ذلك اليوم
Dialogue: 0,0:21:58.81,0:22:00.55,Default,Benetnasch,0,0,0,,!يا عدوّتي اللدودة
Dialogue: 0,0:22:00.92,0:22:04.05,Default,Benetnasch,0,0,0,,سأقتلك هذه المرّة
Dialogue: 0,0:22:06.23,0:22:08.40,Default,Benetnasch,0,0,0,,!يا لوفاس مافاهل

