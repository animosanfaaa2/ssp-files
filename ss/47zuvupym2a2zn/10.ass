Dialogue: 0,0:02:48.97,0:02:50.35,Default,Virgo,0,0,0,,Hm? O co chodzi?
Dialogue: 0,0:02:50.81,0:02:52.46,Default,Sei,0,0,0,,Lubi pani lasy?
Dialogue: 0,0:02:53.86,0:02:55.88,Default,Virgo,0,0,0,,Mów mi po prostu Virgo.
Dialogue: 0,0:02:55.88,0:02:57.98,Default,Virgo,0,0,0,,Krępuje mnie, gdy jesteś\Ntaki uprzejmy.
Dialogue: 0,0:02:57.98,0:02:59.66,Default,Sei,0,0,0,,Dobrze!
Dialogue: 0,0:03:00.53,0:03:05.09,Default,Virgo,0,0,0,,Odkąd pamiętam,\Nmieszkałam w lesie.
Dialogue: 0,0:03:05.44,0:03:08.58,Default,Virgo,0,0,0,,Dlatego las mnie uspokaja.
Dialogue: 0,0:03:09.62,0:03:11.76,Default,Kross,0,0,0,,To nietypowe.
Dialogue: 0,0:03:11.76,0:03:12.48,Default,Sei,0,0,0,,Hm?
Dialogue: 0,0:03:12.48,0:03:13.58,Default,Kross,0,0,0,,Niebioskrzydli zwykle
Dialogue: 0,0:03:13.84,0:03:17.14,Default,Kross,0,0,0,,nie przepadają za lasami,\Nbo jest w nich dużo many.
Dialogue: 0,0:03:17.95,0:03:20.14,Default,Virgo,0,0,0,,Mnie to nie przeszkadza.
Dialogue: 0,0:03:20.14,0:03:22.96,Default,Virgo,0,0,0,,Słyszałam jednak,\Nże zwykli niebioskrzydli
Dialogue: 0,0:03:22.96,0:03:25.60,Default,Virgo,0,0,0,,żyją na szczytach gór,\Ngdzie mana się nie gromadzi.
Dialogue: 0,0:03:25.60,0:03:26.34,Default,Kross,0,0,0,,Hm…
Dialogue: 0,0:03:26.77,0:03:27.92,Default,Kross,0,0,0,,W takim razie
Dialogue: 0,0:03:27.92,0:03:30.71,Default,Kross,0,0,0,,może to wpływ twoich rodziców.
Dialogue: 0,0:03:31.08,0:03:33.69,Default,Kross,0,0,0,,Gdy rodzice wchłoną dużo many,
Dialogue: 0,0:03:33.69,0:03:35.28,Default,Kross,0,0,0,,czasem rodzi się niebioskrzydły,
Dialogue: 0,0:03:35.28,0:03:37.94,Default,Kross,0,0,0,,któremu mana nie przeszkadza.
Dialogue: 0,0:03:38.32,0:03:40.90,Default,Kross,0,0,0,,Na przykład Lufas Maphaahl.
Dialogue: 0,0:03:43.00,0:03:45.95,Default,Kross,0,0,0,,Są zapisy, według których\Nweszła nawet do Helheimu
Dialogue: 0,0:03:46.38,0:03:50.03,Default,Kross,0,0,0,,pełnego gęstej many\Ni nawet się nie skrzywiła.
Dialogue: 0,0:03:51.41,0:03:54.42,Default,Sei,0,0,0,,Ale Virgo ma śnieżnobiałe skrzydła?
Dialogue: 0,0:03:54.42,0:03:55.13,Default,Kross,0,0,0,,Tak.
Dialogue: 0,0:03:55.41,0:03:57.05,Default,Kross,0,0,0,,Zmiany wywołane przez manę
Dialogue: 0,0:03:57.05,0:04:00.35,Default,Kross,0,0,0,,nie zawsze widać na zewnątrz.
Dialogue: 0,0:04:00.35,0:04:02.65,Default,Kross,0,0,0,,Podobno oboje rodzice Lufas
Dialogue: 0,0:04:02.65,0:04:04.98,Default,Kross,0,0,0,,również mieli białe skrzydła.
Dialogue: 0,0:04:06.13,0:04:08.08,Default,Sei,0,0,0,,Czyli, w przeciwieństwie do Lufas,
Dialogue: 0,0:04:08.08,0:04:10.88,Default,Sei,0,0,0,,u Virgo nie zmienił się wygląd
Dialogue: 0,0:04:10.88,0:04:13.52,Default,Sei,0,0,0,,i zachowała śnieżnobiałe skrzydła?
Dialogue: 0,0:04:13.84,0:04:15.84,Default,Kross,0,0,0,,To jedna z możliwości.
Dialogue: 0,0:04:17.74,0:04:19.18,italics,Sei,0,0,0,,Jeśli tak,
Dialogue: 0,0:04:19.18,0:04:23.15,italics,Sei,0,0,0,,rodzice Virgo musieli\Nwchłonąć mnóstwo many.
Dialogue: 0,0:04:23.38,0:04:26.08,italics,Sei,0,0,0,,Virgo jest wnuczką jednej\Nz Dwunastu Gwiazd, prawda?
Dialogue: 0,0:04:26.08,0:04:29.54,italics,Sei,0,0,0,,Ale mówiła też, że\Nprzygarnęła ją Parthenos.
Dialogue: 0,0:04:30.73,0:04:33.21,italics,Sei,0,0,0,,Czyli kim byli jej rodzice?
Dialogue: 0,0:04:34.19,0:04:36.00,Default,Sei,0,0,0,,Hm…
Dialogue: 0,0:04:36.46,0:04:37.66,Default,Petto,0,0,0,,Już niedaleko!
Dialogue: 0,0:04:37.66,0:04:39.42,Default,Petto,0,0,0,,Smok strażnik jest tam!
Dialogue: 0,0:04:39.82,0:04:40.71,Default,All,0,0,0,,Tak!
Dialogue: 0,0:04:52.60,0:04:55.45,Default,Petto,0,0,0,,S-smok strażnik?
Dialogue: 0,0:04:57.26,0:04:58.96,Default,Petto,0,0,0,,Jak to możliwe?
Dialogue: 0,0:04:59.85,0:05:01.75,Default,Petto,0,0,0,,K-kto…
Dialogue: 0,0:05:01.75,0:05:03.99,Default,Petto,0,0,0,,Kto mógł to zrobić?
Dialogue: 0,0:05:03.99,0:05:05.05,Default,Lamia,0,0,0,,Hm?
Dialogue: 0,0:05:05.05,0:05:08.45,Default,Lamia,0,0,0,,Rzadko ktoś odwiedza ten las.
Dialogue: 0,0:05:11.17,0:05:15.12,Default,Merman,0,0,0,,Wygląda na to, że przyszliście\Nuleczyć smoka strażnika.
Dialogue: 0,0:05:15.12,0:05:17.46,Default,Merman,0,0,0,,Ale teraz to już bez sensu!
Dialogue: 0,0:05:18.04,0:05:19.63,Default,Petto,0,0,0,,Przeklęte potwory!
Dialogue: 0,0:05:19.63,0:05:21.50,Default,Petto,0,0,0,,Odejdźcie od smoka strażnika!
Dialogue: 0,0:05:22.65,0:05:23.46,Default,Sei,0,0,0,,„Potwory”?
Dialogue: 0,0:05:23.92,0:05:25.09,Default,Sei,0,0,0,,Ci ludzie?
Dialogue: 0,0:05:25.85,0:05:26.73,Default,Sargess,0,0,0,,Hm…
Dialogue: 0,0:05:26.73,0:05:28.06,Default,Sargess,0,0,0,,Potwory, co?
Dialogue: 0,0:05:28.06,0:05:29.37,Default,Sargess,0,0,0,,Można tak powiedzieć.
Dialogue: 0,0:05:29.37,0:05:32.09,Default,Sargess,0,0,0,,W obecnym świecie jesteśmy potworami.
Dialogue: 0,0:05:32.09,0:05:34.89,Default,Sargess,0,0,0,,Tak określają nas inni.
Dialogue: 0,0:05:34.89,0:05:35.53,Default,Lamia,0,0,0,,Tsk!
Dialogue: 0,0:05:35.53,0:05:40.61,Default,Sargess,0,0,0,,Ale czym właściwie\Nróżnimy się od was?
Dialogue: 0,0:05:41.36,0:05:44.95,Default,Sargess,0,0,0,,Potrafimy rozmawiać.
Dialogue: 0,0:05:44.95,0:05:47.95,Default,Sargess,0,0,0,,Możemy się porozumieć\Ni zbliżyć do siebie.
Dialogue: 0,0:05:47.95,0:05:51.53,Default,Sargess,0,0,0,,Poza wyglądem niczym się nie różnimy.
Dialogue: 0,0:05:52.47,0:05:54.04,italics,Sei,0,0,0,,Ci ludzie…
Dialogue: 0,0:05:54.04,0:05:55.87,Default,Petto,0,0,0,,Sss!
Dialogue: 0,0:05:55.87,0:05:57.32,Default,Petto,0,0,0,,Milczeć, potwory!
Dialogue: 0,0:05:57.32,0:05:59.72,Default,Petto,0,0,0,,Żartujecie, mówiąc,\Nże możemy żyć w zgodzie
Dialogue: 0,0:05:59.72,0:06:01.59,Default,Petto,0,0,0,,po zranieniu smoka strażnika!
Dialogue: 0,0:06:05.38,0:06:07.06,Default,Lamia,0,0,0,,Przestań, Sarge.
Dialogue: 0,0:06:07.40,0:06:11.85,Default,Lamia,0,0,0,,Postanowiliśmy działać, bo od wieków\Nignorują takie argumenty.
Dialogue: 0,0:06:11.85,0:06:15.01,Default,Lamia,0,0,0,,Teraz tylko lord Leon\Nmoże nas uratować!
Dialogue: 0,0:06:15.01,0:06:17.53,Default,Lamia,0,0,0,,Nie możemy już liczyć na ludzi!
Dialogue: 0,0:06:18.06,0:06:19.12,Default,Kross,0,0,0,,Niemożliwe!
Dialogue: 0,0:06:19.43,0:06:21.37,Default,Sei,0,0,0,,Kross, kim jest Leon?
Dialogue: 0,0:06:21.86,0:06:24.78,Default,Kross,0,0,0,,Leon Lew z Dwunastu Niebiańskich Gwiazd.
Dialogue: 0,0:06:25.45,0:06:28.74,Default,Kross,0,0,0,,Zanim Lufas Maphaahl\Ndoszła do władzy,
Dialogue: 0,0:06:28.74,0:06:31.22,Default,Kross,0,0,0,,był w czwórce najsilniejszych\Ni strzegł równowagi!
Dialogue: 0,0:06:31.22,0:06:33.05,Default,Kross,0,0,0,,Jest najsilniejszy\Nz Dwunastu Gwiazd,
Dialogue: 0,0:06:33.05,0:06:36.00,Default,Kross,0,0,0,,to Król Lwów,\Nwładca wszystkich potworów!
Dialogue: 0,0:06:36.98,0:06:39.76,Default,Dryad,0,0,0,,Lord Leon opuścił już\NDwanaście Niebiańskich Gwiazd
Dialogue: 0,0:06:39.76,0:06:41.98,Default,Dryad,0,0,0,,i wrócił na poziom 1000!
Dialogue: 0,0:06:41.98,0:06:44.06,Default,Dryad,0,0,0,,Gdyby lord Leon walczył na serio,
Dialogue: 0,0:06:44.06,0:06:46.18,Default,Dryad,0,0,0,,rozgromiłby ludzi i demony,
Dialogue: 0,0:06:46.18,0:06:48.42,Default,Dryad,0,0,0,,otwierając dla nas nową epokę!
Dialogue: 0,0:06:50.88,0:06:54.60,Default,Sargess,0,0,0,,To my chcemy\Nzmienić ten świat!
Dialogue: 0,0:06:54.60,0:06:58.68,Default,Merman,0,0,0,,Przyszliśmy zabić smoka strażnika\Nna znak wypowiedzenia wojny!
Dialogue: 0,0:06:58.68,0:06:59.52,Default,Lamia,0,0,0,,Hej!
Dialogue: 0,0:06:59.52,0:07:01.78,Default,Lamia,0,0,0,,Nie wygaduj rzeczy,\Nktórych nie powinieneś!
Dialogue: 0,0:07:01.78,0:07:03.48,Default,Dryad,0,0,0,,Spokojnie!
Dialogue: 0,0:07:03.48,0:07:05.69,Default,Dryad,0,0,0,,Wystarczy ich uciszyć
Dialogue: 0,0:07:06.33,0:07:07.65,Default,Dryad,0,0,0,,tu i teraz!
Dialogue: 0,0:07:08.24,0:07:09.48,Default,Petto,0,0,0,,Miau!
Dialogue: 0,0:07:21.50,0:07:23.38,Default,Dryad,0,0,0,,Tak jak mówił lord Leon,
Dialogue: 0,0:07:23.38,0:07:26.17,Default,Dryad,0,0,0,,z dzisiejszą ludzkością koniec!
Dialogue: 0,0:07:26.17,0:07:28.32,italics,Sei,0,0,0,,K-koniec?
Dialogue: 0,0:07:28.32,0:07:30.67,italics,Sei,0,0,0,,To najlepszy wojownik\Nludzkości, Święty Miecza!
Dialogue: 0,0:07:31.07,0:07:33.39,italics,Sei,0,0,0,,A oni radzą sobie z nim tak łatwo?
Dialogue: 0,0:07:31.32,0:07:33.39,stats,Sign,0,0,0,,{\fs9\c&HFCFDFF&\fad(90,0)\t(90,257,\c&HFCFFDF&)\4c&HFAFE7F&\t(90,257,\4c&HB9C45F&)\3c&HFAFE7F&\t(90,257,\3c&HB9C45F&)\bord1.5\shad\pos(129.286,275.429)}Owadoludzie
