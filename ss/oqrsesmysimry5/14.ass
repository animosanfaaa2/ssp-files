Dialogue: 0,0:00:01.46,0:00:04.72,Default,,0,0,0,,秋咲驹根町民房烧毁
Dialogue: 0,0:00:04.72,0:00:07.73,Default,,0,0,0,,纵火杀人 未报导
Dialogue: 0,0:00:07.73,0:00:10.77,Default,,0,0,0,,大手门大楼重要人士遭杀害
Dialogue: 0,0:00:10.77,0:00:13.69,Default,,0,0,0,,目前封锁媒体报导
Dialogue: 0,0:00:13.69,0:00:16.17,Default,,0,0,0,,第2码头第7仓库
Dialogue: 0,0:00:16.17,0:00:18.60,Default,,0,0,0,,306号房的客人
Dialogue: 0,0:00:18.60,0:00:21.02,Default,,0,0,0,,工作完成 未报导
Dialogue: 0,0:00:23.07,0:00:24.37,Default,,0,0,0,,我是灰崎
Dialogue: 0,0:00:24.37,0:00:27.22,Default,,0,0,0,,306号房 街并先生的后续呢
Dialogue: 0,0:00:27.64,0:00:30.16,Default,,0,0,0,,清洁小组已经抵达现场
Dialogue: 0,0:00:30.16,0:00:32.74,Default,,0,0,0,,本人说会自己回来
Dialogue: 0,0:00:33.47,0:00:35.76,Default,,0,0,0,,预计2小时后到达
Dialogue: 0,0:00:35.76,0:00:37.70,Default,,0,0,0,,知道了 我会做准备
Dialogue: 0,0:00:41.04,0:00:43.38,Default,,0,0,0,,那沙罗前辈 我走了
Dialogue: 0,0:00:44.83,0:00:48.05,Default,,0,0,0,,小柴小姐 妳今天下班了吗
Dialogue: 0,0:00:49.22,0:00:51.52,Default,,0,0,0,,306号房的街并先生
Dialogue: 0,0:00:51.52,0:00:53.53,Default,,0,0,0,,说还要一个半小时才会回来
Dialogue: 0,0:00:54.83,0:00:55.51,Default,,0,0,0,,是
Dialogue: 0,0:00:56.05,0:00:57.27,Default,,0,0,0,,别偷懒喔
Dialogue: 0,0:00:58.46,0:00:59.31,Default,,0,0,0,,是
Dialogue: 0,0:00:59.64,0:01:00.69,Default,,0,0,0,,再见
Dialogue: 0,0:01:00.69,0:01:02.44,Default,,0,0,0,,辛苦了
Dialogue: 0,0:01:03.99,0:01:08.53,Default,,0,0,0,,(ParL Mart 8 甜点祭)
Dialogue: 0,0:01:19.16,0:01:21.79,Default,,0,0,0,,烟又涨价了?
Dialogue: 0,0:01:22.61,0:01:25.25,Default,,0,0,0,,物价到底怎么了啊
Dialogue: 0,0:01:25.25,0:01:26.88,Default,,0,0,0,,能不能饶了我
Dialogue: 0,0:01:29.06,0:01:31.04,Default,,0,0,0,,请给我27号
Dialogue: 0,0:01:31.04,0:01:32.05,Default,,0,0,0,,好
Dialogue: 0,0:01:33.22,0:01:34.54,Default,,0,0,0,,(杀手侦探)\N(店员推荐 角色抽奖)\N还有抽一次这个
Dialogue: 0,0:01:35.10,0:01:35.85,Default,,0,0,0,,是这个吧
Dialogue: 0,0:01:35.85,0:01:36.45,Default,,0,0,0,,(角色抽奖)\N是这个吧
Dialogue: 0,0:01:36.45,0:01:37.36,Default,,0,0,0,,(角色抽奖)\N给您
Dialogue: 0,0:01:39.06,0:01:41.02,Default,,0,0,0,,我忘记带钱包了
Dialogue: 0,0:01:42.94,0:01:44.86,Default,,0,0,0,,该选哪一个
Dialogue: 0,0:01:46.96,0:01:48.40,Default,,0,0,0,,对不起
Dialogue: 0,0:01:48.40,0:01:50.87,Default,,0,0,0,,您很喜欢杀手侦探吧
Dialogue: 0,0:01:53.21,0:01:54.41,Default,,0,0,0,,并没有
Dialogue: 0,0:01:55.27,0:01:57.15,Default,,0,0,0,,(杀手侦探)\N(店员推荐 角色抽奖)\N因为广告牌很可爱
Dialogue: 0,0:01:58.76,0:02:02.06,Default,,0,0,0,,我对可爱的东西没什么抵抗力
Dialogue: 0,0:02:02.06,0:02:04.21,Default,,0,0,0,,该怎么办
Dialogue: 0,0:02:08.25,0:02:11.05,Default,,0,0,0,,不是给您的 是借您的
Dialogue: 0,0:02:13.19,0:02:15.87,Default,,0,0,0,,因为那个广告牌是我画的
Dialogue: 0,0:02:15.87,0:02:17.36,Default,,0,0,0,,算是我的责任吧
Dialogue: 0,0:02:20.06,0:02:21.39,Default,,0,0,0,,我想起来了
Dialogue: 0,0:02:22.35,0:02:24.35,Default,,0,0,0,,我以前也是那样
Dialogue: 0,0:02:25.97,0:02:27.48,Default,,0,0,0,,松来小姐妳啊
Dialogue: 0,0:02:28.80,0:02:31.69,Default,,0,0,0,,不要那么轻易借钱给别人比较好喔
Dialogue: 0,0:02:34.35,0:02:36.31,Default,,0,0,0,,这个500圆
Dialogue: 0,0:02:36.31,0:02:38.16,Default,,0,0,0,,在全部抽完之前 先借我吧
Dialogue: 0,0:02:38.83,0:02:40.74,Default,,0,0,0,,可以是可以 为什么
Dialogue: 0,0:02:41.67,0:02:42.95,Default,,0,0,0,,求个好彩头
Dialogue: 0,0:02:44.07,0:02:48.30,Default,,0,0,0,,我怎么可能坐\N连名字都不知道的人的机车啊
Dialogue: 0,0:02:49.60,0:02:52.26,Default,,0,0,0,,身边的人都叫我小柴
Dialogue: 0,0:02:52.65,0:02:54.88,Default,,0,0,0,,妳是松来?
Dialogue: 0,0:02:58.93,0:02:59.84,Default,,0,0,0,,喂
Dialogue: 0,0:02:59.84,0:03:01.38,Default,,0,0,0,,(D奖玩偶)
Dialogue: 0,0:03:01.70,0:03:03.76,Default,,0,0,0,,就当作很可爱吧
Dialogue: 0,0:03:04.51,0:03:05.73,Default,,0,0,0,,光留
Dialogue: 0,0:03:08.18,0:03:09.61,Default,,0,0,0,,我叫松来光留
Dialogue: 0,0:03:09.61,0:03:10.62,Default,,0,0,0,,(ParL Mart 8 甜点祭)
Dialogue: 0,0:03:10.62,0:03:13.61,Default,,0,0,0,,妳从以前就很会画画吗
Dialogue: 0,0:03:14.47,0:03:17.36,Default,,0,0,0,,我也不知道以前怎样
Dialogue: 0,0:03:18.58,0:03:21.33,Default,,0,0,0,,不过姊姊常常夸奖我
Dialogue: 0,0:03:22.83,0:03:24.37,Default,,0,0,0,,喂 生朗
Dialogue: 0,0:03:24.37,0:03:26.83,Default,,0,0,0,,我不是叫你别碰吗
Dialogue: 0,0:03:31.72,0:03:34.34,Default,,0,0,0,,我去火葬了姊姊
Dialogue: 0,0:03:36.80,0:03:38.01,Default,,0,0,0,,妳看 我穿着丧服
Dialogue: 0,0:03:38.01,0:03:39.47,Default,,0,0,0,,很难接话吧
Dialogue: 0,0:03:40.84,0:03:42.85,Default,,0,0,0,,所以我自己先剧透
Dialogue: 0,0:03:44.15,0:03:45.35,Default,,0,0,0,,没事的
Dialogue: 0,0:03:46.08,0:03:49.45,Default,,0,0,0,,我早就知道她活不久了
Dialogue: 0,0:03:49.45,0:03:51.19,Default,,0,0,0,,一直都在做准备
Dialogue: 0,0:03:51.84,0:03:55.54,Default,,0,0,0,,但火葬结束 回到家后
Dialogue: 0,0:03:55.54,0:03:58.20,Default,,0,0,0,,就不知道该如何是好
Dialogue: 0,0:04:00.91,0:04:03.20,Default,,0,0,0,,带我去海边吧
Dialogue: 0,0:04:03.70,0:04:05.78,Default,,0,0,0,,风好凉
Dialogue: 0,0:04:06.24,0:04:08.62,Default,,0,0,0,,为什么是海啊
Dialogue: 0,0:04:09.10,0:04:10.38,Default,,0,0,0,,绘图日记
Dialogue: 0,0:04:11.71,0:04:13.25,Default,,0,0,0,,绘图日记
Dialogue: 0,0:04:13.25,0:04:15.76,Default,,0,0,0,,小时候 我和姊姊一起
Dialogue: 0,0:04:15.76,0:04:18.09,Default,,0,0,0,,写过绘图交换日记
Dialogue: 0,0:04:18.58,0:04:22.04,Default,,0,0,0,,结果在去海边的那一天结束了
Dialogue: 0,0:04:25.27,0:04:26.57,Default,,0,0,0,,我会照办
Dialogue: 0,0:04:27.32,0:04:29.06,Default,,0,0,0,,您妹妹的事
Dialogue: 0,0:04:29.06,0:04:33.32,Default,,0,0,0,,我想想起为什么在那里结束
Dialogue: 0,0:04:34.46,0:04:36.41,Default,,0,0,0,,因为绘图日记的事
Dialogue: 0,0:04:36.41,0:04:38.53,Default,,0,0,0,,已经无法问本人了吧
Dialogue: 0,0:04:45.07,0:04:47.35,Default,,0,0,0,,我请妳喝咖啡
Dialogue: 0,0:04:51.74,0:04:53.32,Default,,0,0,0,,沙罗前辈
Dialogue: 0,0:04:53.32,0:04:56.21,Default,,0,0,0,,谢谢妳代替我值晚班
Dialogue: 0,0:04:59.09,0:05:01.55,Default,,0,0,0,,拜托妳啰 小柴
Dialogue: 0,0:05:02.57,0:05:06.71,Default,,0,0,0,,执行杀手松来满留小姐
Dialogue: 0,0:05:07.57,0:05:10.02,Default,,0,0,0,,为妹妹留下的死亡服务
Dialogue: 0,0:05:15.86,0:05:16.55,Default,,0,0,0,,(Inhuman)
Dialogue: 0,0:05:16.55,0:05:17.32,Default,,0,0,0,,(1.无人性的 像怪物般)
Dialogue: 0,0:05:17.32,0:05:18.14,Default,,0,0,0,,(2.没有人情味)
Dialogue: 0,0:05:18.14,0:05:18.95,Default,,0,0,0,,(3.冷酷的 残酷的)
Dialogue: 0,0:06:40.18,0:06:44.63,Default,,0,0,0,,《异人酒店》
Dialogue: 0,0:06:49.56,0:06:53.11,Default,,0,0,0,,(委托21 机车日记2)
Dialogue: 0,0:06:56.41,0:06:57.52,Default,,0,0,0,,变暖和了
Dialogue: 0,0:06:59.63,0:07:01.51,Default,,0,0,0,,我们现在在这里
Dialogue: 0,0:07:01.51,0:07:02.31,Default,,0,0,0,,要再往前走吗
Dialogue: 0,0:07:05.03,0:07:06.39,Default,,0,0,0,,就这样一直走
Dialogue: 0,0:07:06.85,0:07:08.97,Default,,0,0,0,,沿海有一个停车场
Dialogue: 0,0:07:36.98,0:07:37.81,Default,,0,0,0,,就是这里
Dialogue: 0,0:07:37.81,0:07:38.71,Default,,0,0,0,,停车
Dialogue: 0,0:07:39.98,0:07:41.13,Default,,0,0,0,,到了
Dialogue: 0,0:07:42.22,0:07:43.76,Default,,0,0,0,,到了喔 小柴
Dialogue: 0,0:07:46.44,0:07:47.72,Default,,0,0,0,,可是…
Dialogue: 0,0:07:48.45,0:07:49.72,Default,,0,0,0,,可是啊
Dialogue: 0,0:07:50.57,0:07:52.43,Default,,0,0,0,,好冷
Dialogue: 0,0:07:53.21,0:07:56.77,Default,,0,0,0,,应该说 风好大
Dialogue: 0,0:07:59.43,0:08:00.93,Default,,0,0,0,,真的是这里吗
Dialogue: 0,0:08:00.93,0:08:03.69,Default,,0,0,0,,妳上次来的时候 应该还很小吧
Dialogue: 0,0:08:08.73,0:08:10.15,Default,,0,0,0,,(刨冰 特制热狗)
Dialogue: 0,0:08:17.66,0:08:19.25,Default,,0,0,0,,绝对是这里
Dialogue: 0,0:08:26.45,0:08:28.24,Default,,0,0,0,,如果要下去海边
Dialogue: 0,0:08:28.24,0:08:30.22,Default,,0,0,0,,机车就先停在这里…
Dialogue: 0,0:08:30.22,0:08:31.64,Default,,0,0,0,,不行
Dialogue: 0,0:08:32.50,0:08:35.03,Default,,0,0,0,,明明地点就是这里
Dialogue: 0,0:08:35.03,0:08:36.77,Default,,0,0,0,,我却想不起来
Dialogue: 0,0:08:41.02,0:08:43.94,Default,,0,0,0,,为什么当时不继续写绘图日记了呢
Dialogue: 0,0:08:46.59,0:08:50.07,Default,,0,0,0,,终于到了期待已久的海边
Dialogue: 0,0:08:50.62,0:08:52.44,Default,,0,0,0,,虽然今天已经天黑了
Dialogue: 0,0:08:52.44,0:08:55.24,Default,,0,0,0,,但明天我要尽情游泳
Dialogue: 0,0:08:55.24,0:08:58.16,Default,,0,0,0,,不知道能不能看到鱼
Dialogue: 0,0:08:58.16,0:09:01.25,Default,,0,0,0,,喂 别随便偷看别人的日记啦
Dialogue: 0,0:09:02.45,0:09:04.85,Default,,0,0,0,,到这里为止 的确看起来都很开心
Dialogue: 0,0:09:04.85,0:09:05.91,Default,,0,0,0,,可是…
Dialogue: 0,0:09:06.89,0:09:10.13,Default,,0,0,0,,后面的页面被撕掉了
Dialogue: 0,0:09:10.13,0:09:11.55,Default,,0,0,0,,为什么呢
Dialogue: 0,0:09:12.37,0:09:15.72,Default,,0,0,0,,上面写的是抵达这个海边\N隔天的事情吗
Dialogue: 0,0:09:16.84,0:09:18.23,Default,,0,0,0,,不知道
Dialogue: 0,0:09:22.29,0:09:25.38,Default,,0,0,0,,潮水的味道明明如此令人怀念
Dialogue: 0,0:09:32.30,0:09:35.16,Default,,0,0,0,,(绘图日记)
Dialogue: 0,0:09:35.16,0:09:36.71,Default,,0,0,0,,那个
Dialogue: 0,0:09:36.71,0:09:39.91,Default,,0,0,0,,我想想起来的理由 还有后续
Dialogue: 0,0:09:42.58,0:09:43.74,Default,,0,0,0,,听说姊姊
Dialogue: 0,0:09:43.74,0:09:46.64,Default,,0,0,0,,(绘图日记 松来光留)\N最后一天在看这个
Dialogue: 0,0:09:50.01,0:09:51.22,Default,,0,0,0,,(绘图日记 松来光留)\N可是
Dialogue: 0,0:09:51.45,0:09:54.27,Default,,0,0,0,,一直想不起来
Dialogue: 0,0:09:54.27,0:09:56.69,Default,,0,0,0,,是不是代表用不着想起来呢
Dialogue: 0,0:10:05.56,0:10:08.50,Default,,0,0,0,,(姑姑)\N(光留 谢谢妳一直以来的努力)
Dialogue: 0,0:10:10.55,0:10:12.33,Default,,0,0,0,,(我想妳姊姊)
Dialogue: 0,0:10:12.33,0:10:14.20,Default,,0,0,0,,(一定直到最后一刻都很幸福)
Dialogue: 0,0:10:20.70,0:10:21.71,Default,,0,0,0,,光留
Dialogue: 0,0:10:23.80,0:10:25.33,Default,,0,0,0,,真好笑
Dialogue: 0,0:10:27.67,0:10:31.48,Default,,0,0,0,,那些完全不肯帮助我们的人
Dialogue: 0,0:10:31.48,0:10:34.89,Default,,0,0,0,,随意谈论姊姊也无所谓吧
Dialogue: 0,0:10:35.76,0:10:39.23,Default,,0,0,0,,当我们只剩下彼此时
Dialogue: 0,0:10:39.23,0:10:42.11,Default,,0,0,0,,还有知道姊姊的病情时
Dialogue: 0,0:10:42.65,0:10:45.79,Default,,0,0,0,,也将它包装成美丽又悲伤的故事
Dialogue: 0,0:10:45.79,0:10:49.38,Default,,0,0,0,,只要像这样满足并遗忘就行了吧
Dialogue: 0,0:10:51.97,0:10:53.24,Default,,0,0,0,,那么…
Dialogue: 0,0:10:56.18,0:10:59.24,Default,,0,0,0,,想忘却忘不掉的我呢
Dialogue: 0,0:11:01.41,0:11:04.00,Default,,0,0,0,,我…我啊
Dialogue: 0,0:11:06.86,0:11:09.75,Default,,0,0,0,,在卧床不起的姊姊身旁
Dialogue: 0,0:11:09.75,0:11:13.86,Default,,0,0,0,,小小声地说出"饶了我"的事呢
Dialogue: 0,0:11:13.86,0:11:15.37,Default,,0,0,0,,姊姊她…
Dialogue: 0,0:11:15.37,0:11:18.93,Default,,0,0,0,,姊姊她死后\N我的心里松了一口气的事呢
Dialogue: 0,0:11:19.64,0:11:22.60,Default,,0,0,0,,想着以后不用再照顾她
Dialogue: 0,0:11:22.60,0:11:24.52,Default,,0,0,0,,终于结束了
Dialogue: 0,0:11:25.20,0:11:26.73,Default,,0,0,0,,这件事呢
Dialogue: 0,0:11:28.98,0:11:30.23,Default,,0,0,0,,所以…
Dialogue: 0,0:11:34.81,0:11:37.62,Default,,0,0,0,,所以 我…
Dialogue: 0,0:11:49.88,0:11:52.58,Default,,0,0,0,,明明是因为想要忘记才画的
Dialogue: 0,0:11:57.39,0:11:58.55,Default,,0,0,0,,什么
Dialogue: 0,0:12:00.40,0:12:08.05,Default,,0,0,0,,这大概是最后一次回来了吧
Dialogue: 0,0:12:13.64,0:12:14.64,Default,,0,0,0,,那幅画…
Dialogue: 0,0:12:15.12,0:12:16.02,Default,,0,0,0,,画?
Dialogue: 0,0:12:16.57,0:12:17.82,Default,,0,0,0,,给我看
Dialogue: 0,0:12:19.27,0:12:23.19,Default,,0,0,0,,其实我本来不打算给别人看
Dialogue: 0,0:12:23.19,0:12:24.06,Default,,0,0,0,,可是…
Dialogue: 0,0:12:24.66,0:12:27.00,Default,,0,0,0,,拜托了 给我看
Dialogue: 0,0:12:40.25,0:12:43.50,Default,,0,0,0,,我为了自己
Dialogue: 0,0:12:44.43,0:12:47.39,Default,,0,0,0,,为了发泄枯燥生活的郁闷
Dialogue: 0,0:12:47.96,0:12:51.06,Default,,0,0,0,,为了洗净那些混浊的情感
Dialogue: 0,0:12:52.17,0:12:54.41,Default,,0,0,0,,为了遗忘一切
Dialogue: 0,0:12:55.52,0:12:58.99,Default,,0,0,0,,我才画下姊姊最后的模样
Dialogue: 0,0:13:07.16,0:13:11.71,Default,,0,0,0,,就算想忘 我也已经忘不了了啊
Dialogue: 0,0:13:21.54,0:13:22.89,Default,,0,0,0,,姊姊
Dialogue: 0,0:13:30.93,0:13:32.00,Default,,0,0,0,,别放开
Dialogue: 0,0:13:32.00,0:13:34.15,Default,,0,0,0,,光留 走啰
Dialogue: 0,0:13:34.15,0:13:35.15,Default,,0,0,0,,可是…
Dialogue: 0,0:13:37.11,0:13:38.80,Default,,0,0,0,,抓紧了喔
Dialogue: 0,0:13:38.80,0:13:39.90,Default,,0,0,0,,小柴
Dialogue: 0,0:13:44.73,0:13:46.25,Default,,0,0,0,,小柴 太快了
Dialogue: 0,0:13:46.25,0:13:47.41,Default,,0,0,0,,太快了啦
Dialogue: 0,0:13:47.81,0:13:51.87,Default,,0,0,0,,我最讨厌那些天真软弱的话
Dialogue: 0,0:13:52.72,0:13:55.92,Default,,0,0,0,,越听越让人觉得火大
Dialogue: 0,0:13:57.74,0:14:01.38,Default,,0,0,0,,因为除此之外 妳还能做什么
Dialogue: 0,0:14:02.77,0:14:03.61,Default,,0,0,0,,生气吧
Dialogue: 0,0:14:07.02,0:14:10.56,Default,,0,0,0,,对让妳讨厌姊姊的这一切生气吧
Dialogue: 0,0:14:11.03,0:14:13.91,Default,,0,0,0,,对擅自消耗生命的疾病
Dialogue: 0,0:14:13.91,0:14:15.64,Default,,0,0,0,,对明明什么都没做
Dialogue: 0,0:14:15.64,0:14:18.27,Default,,0,0,0,,却跑来丧礼上哭的那些亲戚
Dialogue: 0,0:14:18.66,0:14:21.88,Default,,0,0,0,,对完全不肯帮助我们的社会
Dialogue: 0,0:14:22.42,0:14:25.50,Default,,0,0,0,,所以 如果妳还想伸出手
Dialogue: 0,0:14:25.84,0:14:27.03,Default,,0,0,0,,那就别放开
Dialogue: 0,0:14:30.10,0:14:33.82,Default,,0,0,0,,反正人类这种生物迟早会忘掉
Dialogue: 0,0:14:43.02,0:14:45.69,Default,,0,0,0,,所以 如果忘不掉的话
Dialogue: 0,0:14:45.69,0:14:46.89,Default,,0,0,0,,(绘图日记)
Dialogue: 0,0:14:49.90,0:14:52.70,Default,,0,0,0,,现在紧紧抱住也无所谓吧
Dialogue: 0,0:15:06.22,0:15:07.66,Default,,0,0,0,,没错
Dialogue: 0,0:15:09.12,0:15:10.70,Default,,0,0,0,,我…
Dialogue: 0,0:15:50.02,0:15:53.41,Default,,0,0,0,,我溺水了
Dialogue: 0,0:15:57.99,0:15:59.44,Default,,0,0,0,,然后…
Dialogue: 0,0:16:11.21,0:16:13.15,Default,,0,0,0,,为什么要画出来啊
Dialogue: 0,0:16:13.94,0:16:15.89,Default,,0,0,0,,小满这个笨蛋
Dialogue: 0,0:16:17.26,0:16:18.54,Default,,0,0,0,,光留
Dialogue: 0,0:16:19.05,0:16:20.86,Default,,0,0,0,,我不写日记了
Dialogue: 0,0:16:23.82,0:16:25.57,Default,,0,0,0,,妳不写了吗
Dialogue: 0,0:16:25.57,0:16:27.81,Default,,0,0,0,,不写了 不写了
Dialogue: 0,0:16:28.22,0:16:32.24,Default,,0,0,0,,可是我最喜欢光留画的画了
Dialogue: 0,0:16:48.80,0:16:49.97,Default,,0,0,0,,光留
Dialogue: 0,0:16:55.04,0:16:56.04,Default,,0,0,0,,光留?
Dialogue: 0,0:17:01.74,0:17:05.11,Default,,0,0,0,,我想起来了喔 姊姊
Dialogue: 0,0:17:07.91,0:17:09.88,Default,,0,0,0,,《异人酒店》
Dialogue: 0,0:17:14.77,0:17:16.57,Default,,0,0,0,,埋葬于黑暗中的真凶
Dialogue: 0,0:17:16.57,0:17:19.14,Default,,0,0,0,,杀手侦探 现正热播中
Dialogue: 0,0:17:19.82,0:17:22.48,Default,,0,0,0,,原来是这个啊
Dialogue: 0,0:17:22.48,0:17:24.34,Default,,0,0,0,,沙罗小姐
Dialogue: 0,0:17:25.55,0:17:26.55,Default,,0,0,0,,怎么了
Dialogue: 0,0:17:26.80,0:17:28.47,Default,,0,0,0,,小柴小姐她
Dialogue: 0,0:17:28.47,0:17:32.03,Default,,0,0,0,,完全不告诉我上次的工作内容
Dialogue: 0,0:17:32.89,0:17:36.69,Default,,0,0,0,,让妹妹光留小姐接受自己的死
Dialogue: 0,0:17:36.69,0:17:38.95,Default,,0,0,0,,希望我们协助这件事
Dialogue: 0,0:17:38.95,0:17:41.73,Default,,0,0,0,,松来满留小姐最后的愿望
Dialogue: 0,0:17:43.46,0:17:45.20,Default,,0,0,0,,应该是害羞吧
Dialogue: 0,0:17:46.08,0:17:48.14,Default,,0,0,0,,那个小柴小姐吗
Dialogue: 0,0:17:48.14,0:17:52.35,Default,,0,0,0,,她虽然不像你一样会为对方着想
Dialogue: 0,0:17:52.35,0:17:55.26,Default,,0,0,0,,但说不定比你更擅长陪伴对方喔
Dialogue: 0,0:18:00.59,0:18:03.11,Default,,0,0,0,,(ParL Mart 8 甜点祭)
Dialogue: 0,0:18:04.88,0:18:06.79,Default,,0,0,0,,真是的 不要跑啦
Dialogue: 0,0:18:12.76,0:18:16.33,Default,,0,0,0,,小柴在好坏方面 都很笨拙
Dialogue: 0,0:19:24.39,0:19:26.08,Default,,0,0,0,,欢迎光临
Dialogue: 0,0:19:29.47,0:19:31.46,Default,,0,0,0,,感冒的鼻音好重
Dialogue: 0,0:19:32.36,0:19:34.66,Default,,0,0,0,,毕竟我掉到冬天的海里
Dialogue: 0,0:19:34.66,0:19:37.12,Default,,0,0,0,,没死就已经算走运了吧
Dialogue: 0,0:19:37.12,0:19:38.75,Default,,0,0,0,,不过手机坏了
Dialogue: 0,0:19:40.68,0:19:42.41,Default,,0,0,0,,得买新手机了
Dialogue: 0,0:19:42.41,0:19:43.98,Default,,0,0,0,,(魔幻蓝11 Air)\N得买新手机了
Dialogue: 0,0:19:44.51,0:19:46.70,Default,,0,0,0,,与亲戚之间的关系
Dialogue: 0,0:19:46.70,0:19:50.12,Default,,0,0,0,,我认为可以趁这个机会就此断掉
Dialogue: 0,0:19:51.33,0:19:52.98,Default,,0,0,0,,那不是很好吗
Dialogue: 0,0:19:52.98,0:19:53.98,Default,,0,0,0,,另一边呢
Dialogue: 0,0:19:55.43,0:19:56.86,Default,,0,0,0,,没事吧
Dialogue: 0,0:19:58.44,0:19:59.74,Default,,0,0,0,,妳等我一下
Dialogue: 0,0:20:01.72,0:20:02.72,Default,,0,0,0,,什么
Dialogue: 0,0:20:10.40,0:20:11.63,Default,,0,0,0,,(绘图日记 松来光留)\N妳看
Dialogue: 0,0:20:12.65,0:20:14.74,Default,,0,0,0,,(绘图日记 松来光留)\N皱巴巴的
Dialogue: 0,0:20:15.19,0:20:16.72,Default,,0,0,0,,破破烂烂
Dialogue: 0,0:20:19.82,0:20:22.01,Default,,0,0,0,,虽然是我擅自画的
Dialogue: 0,0:20:22.76,0:20:26.28,Default,,0,0,0,,不过很可爱 所以妳会原谅我吧
Dialogue: 0,0:20:27.58,0:20:31.28,Default,,0,0,0,,一月 在姊姊的丧礼回程途中
Dialogue: 0,0:20:31.28,0:20:33.26,Default,,0,0,0,,去了那片久违的大海
Dialogue: 0,0:20:35.10,0:20:37.14,Default,,0,0,0,,在寒冷的冬天深夜里
Dialogue: 0,0:20:37.14,0:20:39.11,Default,,0,0,0,,搭乘奇怪家伙的机车
Dialogue: 0,0:20:39.95,0:20:41.57,Default,,0,0,0,,超级冷
Dialogue: 0,0:20:42.14,0:20:45.50,Default,,0,0,0,,可是风感觉很舒适 真不可思议
Dialogue: 0,0:20:47.76,0:20:50.75,Default,,0,0,0,,(绘图日记)\N我应该更可爱才对
Dialogue: 0,0:20:57.24,0:21:03.10,Default,,0,0,0,,然后 我又在海里溺水了
Dialogue: 0,0:22:46.31,0:22:48.16,Default,,0,0,0,,稍微休息一下
Dialogue: 0,0:22:52.70,0:22:54.21,Default,,0,0,0,,真是的
Dialogue: 0,0:22:55.66,0:22:56.68,Default,,0,0,0,,这个
Dialogue: 0,0:22:56.68,0:22:59.04,Default,,0,0,0,,(素描本)
Dialogue: 0,0:22:59.41,0:23:00.77,Default,,0,0,0,,是姊姊的
Dialogue: 0,0:23:17.15,0:23:18.98,Default,,0,0,0,,搞什么啊
Dialogue: 0,0:23:21.58,0:23:23.32,Default,,0,0,0,,明明就画了
Dialogue: 0,0:23:27.12,0:23:29.98,Default,,0,0,0,,(下集待续)
Dialogue: 0,0:23:29.98,0:23:35.00,Default,,0,0,0,,(下集 委托22 登山社)

