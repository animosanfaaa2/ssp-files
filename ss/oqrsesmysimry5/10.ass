Dialogue: 0,0:00:01.46,0:00:04.63,Default,,0,0,0,,Kebakaran rumah di Akisaki Komagane-cho.
Dialogue: 0,0:00:04.71,0:00:07.63,Default,,0,0,0,,Pembakaran dan pembunuhan.\NTidak dilaporkan.
Dialogue: 0,0:00:07.72,0:00:10.68,Default,,0,0,0,,VIP dibunuh di Gedung Otemon.
Dialogue: 0,0:00:10.76,0:00:13.60,Default,,0,0,0,,Pemadaman media diberlakukan.
Dialogue: 0,0:00:13.68,0:00:16.10,Default,,0,0,0,,Dermaga 2, Gudang 7.
Dialogue: 0,0:00:16.18,0:00:18.52,Default,,0,0,0,,Tamu di Kamar 306.
Dialogue: 0,0:00:18.60,0:00:21.02,Default,,0,0,0,,Pekerjaan selesai. Tidak dilaporkan.
Dialogue: 0,0:00:23.07,0:00:24.27,Default,,0,0,0,,Ini Haizaki.
Dialogue: 0,0:00:24.36,0:00:27.24,Default,,0,0,0,,Kamar 306. Bagaimana status Tn. Machinami?
Dialogue: 0,0:00:27.65,0:00:30.07,Default,,0,0,0,,Kru pembersih telah tiba di lokasi.
Dialogue: 0,0:00:30.16,0:00:32.74,Default,,0,0,0,,Dia bilang akan kembali sendiri.
Dialogue: 0,0:00:33.49,0:00:35.66,Default,,0,0,0,,Perkiraan tiba dalam dua jam.
Dialogue: 0,0:00:35.74,0:00:37.70,Default,,0,0,0,,Dimengerti. Akan kusiapkan.
Dialogue: 0,0:00:41.04,0:00:43.38,Default,,0,0,0,,Sara-senpai, aku pergi.
Dialogue: 0,0:00:44.84,0:00:48.05,Default,,0,0,0,,Nn. Koshiba, kau sudah selesai bekerja?
Dialogue: 0,0:00:49.22,0:00:51.43,Default,,0,0,0,,Tn. Machinami di Kamar 306 bilang
Dialogue: 0,0:00:51.51,0:00:53.55,Default,,0,0,0,,dia akan kembali 1,5 jam lagi.
Dialogue: 0,0:00:54.85,0:00:55.68,Default,,0,0,0,,Ya.
Dialogue: 0,0:00:56.06,0:00:57.27,Default,,0,0,0,,Jangan bermalas-malasan.
Dialogue: 0,0:00:58.48,0:00:59.31,Default,,0,0,0,,Ya.
Dialogue: 0,0:00:59.64,0:01:00.60,Default,,0,0,0,,Sampai jumpa.
Dialogue: 0,0:01:00.69,0:01:02.44,Default,,0,0,0,,Kerja bagus hari ini.
Dialogue: 0,0:01:03.98,0:01:08.53,Default,,0,0,0,,(PARL MART 8 FESTIVAL HIDANGAN PENUTUP)
Dialogue: 0,0:01:19.16,0:01:21.79,Default,,0,0,0,,Harga rokok naik lagi?
Dialogue: 0,0:01:22.62,0:01:25.17,Default,,0,0,0,,Ada apa dengan biaya hidup belakangan ini?
Dialogue: 0,0:01:25.25,0:01:26.88,Default,,0,0,0,,Yang benar saja.
Dialogue: 0,0:01:29.05,0:01:30.97,Default,,0,0,0,,Nomor 27.
Dialogue: 0,0:01:31.05,0:01:32.05,Default,,0,0,0,,Tentu.
Dialogue: 0,0:01:33.22,0:01:34.55,Default,,0,0,0,,(DETEKTIF PEMBUNUH)\N(UNDIAN KARAKTER REKOMENDASI STAF)\NDan satu undian untuk ini.
Dialogue: 0,0:01:35.10,0:01:35.93,Default,,0,0,0,,Yang ini, bukan?
Dialogue: 0,0:01:36.01,0:01:36.85,Default,,0,0,0,,(UNDIAN KARAKTER)\NYang ini, bukan?
Dialogue: 0,0:01:36.93,0:01:37.76,Default,,0,0,0,,(UNDIAN KARAKTER)\NSilakan.
Dialogue: 0,0:01:39.06,0:01:41.02,Default,,0,0,0,,Aku lupa dompetku.
Dialogue: 0,0:01:42.94,0:01:44.86,Default,,0,0,0,,Mana yang harus kupilih?
Dialogue: 0,0:01:46.94,0:01:48.32,Default,,0,0,0,,Maafkan aku.
Dialogue: 0,0:01:48.40,0:01:50.86,Default,,0,0,0,,Kau sangat suka Detektif Pembunuh, bukan?
Dialogue: 0,0:01:53.20,0:01:54.41,Default,,0,0,0,,Tidak juga.
Dialogue: 0,0:01:55.28,0:01:57.16,Default,,0,0,0,,(DETEKTIF PEMBUNUH)\N(UNDIAN KARAKTER REKOMENDASI STAF)\NHanya saja tulisannya menggemaskan.
Dialogue: 0,0:01:58.74,0:02:01.96,Default,,0,0,0,,Aku punya kelemahan\Nterhadap hal-hal yang menggemaskan.
Dialogue: 0,0:02:02.04,0:02:04.21,Default,,0,0,0,,Apa yang harus kulakukan?
Dialogue: 0,0:02:08.25,0:02:11.05,Default,,0,0,0,,Aku tidak memberikannya kepadamu,\Naku meminjamkannya.
Dialogue: 0,0:02:13.18,0:02:15.80,Default,,0,0,0,,Aku yang menggambarnya.
Dialogue: 0,0:02:15.89,0:02:17.35,Default,,0,0,0,,Jadi, aku merasa bertanggung jawab.
Dialogue: 0,0:02:20.06,0:02:21.39,Default,,0,0,0,,Aku ingat sekarang.
Dialogue: 0,0:02:22.35,0:02:24.35,Default,,0,0,0,,Dahulu aku juga seperti itu.
Dialogue: 0,0:02:25.98,0:02:27.48,Default,,0,0,0,,Nona Matsuki…
Dialogue: 0,0:02:28.82,0:02:31.69,Default,,0,0,0,,Jangan meminjamkan uang semudah itu.
Dialogue: 0,0:02:34.36,0:02:36.24,Default,,0,0,0,,Ini 500 yen.
Dialogue: 0,0:02:36.32,0:02:38.16,Default,,0,0,0,,Pinjamkan kepadaku\Nsampai aku menggambar semuanya.
Dialogue: 0,0:02:38.83,0:02:40.74,Default,,0,0,0,,Aku bisa, tapi kenapa?
Dialogue: 0,0:02:41.66,0:02:42.95,Default,,0,0,0,,Untuk keberuntungan.
Dialogue: 0,0:02:44.08,0:02:48.29,Default,,0,0,0,,Aku tidak bisa naik motor dengan orang\Nyang namanya tidak kukenal.
Dialogue: 0,0:02:49.59,0:02:52.26,Default,,0,0,0,,Orang-orang memanggilku Koshiba.
Dialogue: 0,0:02:52.63,0:02:54.88,Default,,0,0,0,,Kau Matsuki?
Dialogue: 0,0:02:58.93,0:02:59.76,Default,,0,0,0,,Hei.
Dialogue: 0,0:02:59.85,0:03:01.39,Default,,0,0,0,,(BONEKA HADIAH D)
Dialogue: 0,0:03:01.68,0:03:03.77,Default,,0,0,0,,Anggap saja itu menggemaskan.
Dialogue: 0,0:03:04.52,0:03:05.73,Default,,0,0,0,,Hikaru.
Dialogue: 0,0:03:08.19,0:03:09.52,Default,,0,0,0,,Aku Hikaru Matsuki.
Dialogue: 0,0:03:09.61,0:03:10.52,Default,,0,0,0,,(PARL MART 8 FESTIVAL HIDANGAN PENUTUP)
Dialogue: 0,0:03:10.61,0:03:13.61,Default,,0,0,0,,Apa kau selalu pandai menggambar?
Dialogue: 0,0:03:14.49,0:03:17.36,Default,,0,0,0,,Aku tidak yakin,
Dialogue: 0,0:03:18.57,0:03:21.33,Default,,0,0,0,,tapi kakakku selalu memujiku.
Dialogue: 0,0:03:22.83,0:03:24.29,Default,,0,0,0,,Hei, Ikuro!
Dialogue: 0,0:03:24.37,0:03:26.83,Default,,0,0,0,,Bukankah sudah kubilang\Njangan menyentuhnya?
Dialogue: 0,0:03:31.71,0:03:34.34,Default,,0,0,0,,Aku baru saja mengkremasi kakakku.
Dialogue: 0,0:03:36.80,0:03:37.93,Default,,0,0,0,,Lihat? Aku memakai pakaian berkabung.
Dialogue: 0,0:03:38.01,0:03:39.47,Default,,0,0,0,,Ini topik yang canggung, bukan?
Dialogue: 0,0:03:40.85,0:03:42.85,Default,,0,0,0,,Jadi, aku akan merusak suasana.
Dialogue: 0,0:03:44.14,0:03:45.35,Default,,0,0,0,,Tidak apa-apa.
Dialogue: 0,0:03:46.06,0:03:49.35,Default,,0,0,0,,Aku tahu hidupnya tidak lama lagi.
Dialogue: 0,0:03:49.44,0:03:51.19,Default,,0,0,0,,Aku sudah mempersiapkannya.
Dialogue: 0,0:03:51.86,0:03:55.44,Default,,0,0,0,,Tapi setelah kremasi, saat aku pulang,
Dialogue: 0,0:03:55.53,0:03:58.20,Default,,0,0,0,,aku merasa hampa.
Dialogue: 0,0:04:00.91,0:04:03.20,Default,,0,0,0,,Bawa aku ke pantai.
Dialogue: 0,0:04:03.70,0:04:05.79,Default,,0,0,0,,Anginnya dingin.
Dialogue: 0,0:04:06.25,0:04:08.62,Default,,0,0,0,,Kenapa pantai?
Dialogue: 0,0:04:09.08,0:04:10.38,Default,,0,0,0,,Buku harian bergambar.
Dialogue: 0,0:04:11.71,0:04:13.17,Default,,0,0,0,,Buku harian bergambar!
Dialogue: 0,0:04:13.25,0:04:15.67,Default,,0,0,0,,Saat masih kecil, aku dan kakakku
Dialogue: 0,0:04:15.76,0:04:18.09,Default,,0,0,0,,bertukar buku harian bergambar.
Dialogue: 0,0:04:18.59,0:04:22.05,Default,,0,0,0,,Tapi itu berakhir\Npada hari kami pergi ke pantai.
Dialogue: 0,0:04:25.27,0:04:26.56,Default,,0,0,0,,Aku akan mengurusnya.
Dialogue: 0,0:04:27.31,0:04:28.98,Default,,0,0,0,,Mengenai kakakmu…
Dialogue: 0,0:04:29.06,0:04:33.32,Default,,0,0,0,,Aku ingin ingat\Nkenapa itu berakhir di sana.
Dialogue: 0,0:04:34.44,0:04:36.32,Default,,0,0,0,,Karena ini soal buku harian bergambar,
Dialogue: 0,0:04:36.40,0:04:38.53,Default,,0,0,0,,aku tidak bisa menanyakannya lagi.
Dialogue: 0,0:04:45.08,0:04:47.37,Default,,0,0,0,,Aku akan mentraktirmu kopi.
Dialogue: 0,0:04:51.75,0:04:53.25,Default,,0,0,0,,Sara-senpai.
Dialogue: 0,0:04:53.34,0:04:56.21,Default,,0,0,0,,Terima kasih\Nsudah menggantikan sif malamku.
Dialogue: 0,0:04:59.09,0:05:01.55,Default,,0,0,0,,Aku mengandalkanmu, Koshiba.
Dialogue: 0,0:05:02.55,0:05:06.72,Default,,0,0,0,,Melakukan upacara kematian terakhir
Dialogue: 0,0:05:07.56,0:05:10.02,Default,,0,0,0,,untuk pembunuh, Mitsuru Matsuki.
Dialogue: 0,0:05:15.86,0:05:16.69,Default,,0,0,0,,(INHUMAN)
Dialogue: 0,0:05:16.78,0:05:17.61,Default,,0,0,0,,(1. TIDAK MANUSIAWI, SEPERTI MONSTER)
Dialogue: 0,0:05:17.69,0:05:18.94,Default,,0,0,0,,(2. KURANG KEHANGATAN ATAU EMPATI)\N(3. DINGIN DAN KEJAM)
Dialogue: 0,0:06:40.19,0:06:44.61,Default,,0,0,0,,(HOTEL INHUMANS)
Dialogue: 0,0:06:49.58,0:06:53.12,Default,,0,0,0,,(PERMINTAAN 21:\NJURNAL PERJALANAN SEPEDA MOTOR, BAGIAN 2)
Dialogue: 0,0:06:56.42,0:06:57.50,Default,,0,0,0,,Udaranya makin hangat.
Dialogue: 0,0:06:59.63,0:07:01.42,Default,,0,0,0,,Kita sudah sampai.
Dialogue: 0,0:07:01.50,0:07:02.34,Default,,0,0,0,,Haruskah kita teruskan?
Dialogue: 0,0:07:05.01,0:07:06.38,Default,,0,0,0,,Ayo teruskan saja.
Dialogue: 0,0:07:06.84,0:07:08.97,Default,,0,0,0,,Ada tempat parkir di tepi laut.
Dialogue: 0,0:07:37.00,0:07:37.83,Default,,0,0,0,,Ini tempatnya.
Dialogue: 0,0:07:37.92,0:07:38.75,Default,,0,0,0,,Berhenti.
Dialogue: 0,0:07:39.96,0:07:41.13,Default,,0,0,0,,Kita sudah sampai.
Dialogue: 0,0:07:42.21,0:07:43.76,Default,,0,0,0,,Ini tempatnya, Koshiba!
Dialogue: 0,0:07:46.42,0:07:47.72,Default,,0,0,0,,Tapi…
Dialogue: 0,0:07:48.47,0:07:49.72,Default,,0,0,0,,Tapi…
Dialogue: 0,0:07:50.55,0:07:52.43,Default,,0,0,0,,Dingin sekali!
Dialogue: 0,0:07:53.22,0:07:56.77,Default,,0,0,0,,Maksudku, anginnya kencang sekali.
Dialogue: 0,0:07:59.44,0:08:00.86,Default,,0,0,0,,Benarkah ini tempatnya?
Dialogue: 0,0:08:00.94,0:08:03.69,Default,,0,0,0,,Kau pasti masih sangat muda\Nsaat kali terakhir datang ke sini?
Dialogue: 0,0:08:08.74,0:08:10.16,Default,,0,0,0,,(ES SERUT, HOT DOG SPESIAL)
Dialogue: 0,0:08:17.66,0:08:19.25,Default,,0,0,0,,Pasti ini tempatnya.
Dialogue: 0,0:08:26.46,0:08:28.13,Default,,0,0,0,,Jika kita akan ke pantai,
Dialogue: 0,0:08:28.22,0:08:30.14,Default,,0,0,0,,aku akan memarkir motornya di sini…
Dialogue: 0,0:08:30.22,0:08:31.64,Default,,0,0,0,,Tidak.
Dialogue: 0,0:08:32.51,0:08:34.93,Default,,0,0,0,,Meski tahu ini tempatnya,
Dialogue: 0,0:08:35.01,0:08:36.77,Default,,0,0,0,,aku masih tidak ingat.
Dialogue: 0,0:08:41.02,0:08:43.94,Default,,0,0,0,,Kenapa aku berhenti menggambar\Ndi buku harian bergambar ini?
Dialogue: 0,0:08:46.61,0:08:50.07,Default,,0,0,0,,"Akhirnya tiba di pantai yang kunantikan."
Dialogue: 0,0:08:50.61,0:08:52.37,Default,,0,0,0,,"Hari ini sudah gelap,"
Dialogue: 0,0:08:52.45,0:08:55.16,Default,,0,0,0,,"tapi aku akan berenang\Nsepenuh hati besok."
Dialogue: 0,0:08:55.24,0:08:58.08,Default,,0,0,0,,"Entah apa aku akan melihat ikan."
Dialogue: 0,0:08:58.16,0:09:01.25,Default,,0,0,0,,Hei, jangan membaca buku harian seseorang\Ntanpa izin.
Dialogue: 0,0:09:02.46,0:09:04.75,Default,,0,0,0,,Sepertinya kau bersenang-senang\Nsampai saat ini.
Dialogue: 0,0:09:04.84,0:09:05.92,Default,,0,0,0,,Tapi…
Dialogue: 0,0:09:06.88,0:09:10.05,Default,,0,0,0,,Halaman setelah ini dirobek.
Dialogue: 0,0:09:10.13,0:09:11.55,Default,,0,0,0,,Kenapa?
Dialogue: 0,0:09:12.39,0:09:15.72,Default,,0,0,0,,Apa halaman itu tentang hari\Nsetelah kau tiba di pantai ini?
Dialogue: 0,0:09:16.85,0:09:18.22,Default,,0,0,0,,Entahlah.
Dialogue: 0,0:09:22.27,0:09:25.40,Default,,0,0,0,,Meskipun aroma air pasang\Nterasa sangat nostalgia.
Dialogue: 0,0:09:32.28,0:09:35.07,Default,,0,0,0,,(BUKU HARIAN BERGAMBAR)
Dialogue: 0,0:09:35.16,0:09:36.62,Default,,0,0,0,,Begini…
Dialogue: 0,0:09:36.70,0:09:39.91,Default,,0,0,0,,Ada alasan lain aku ingin mengingatnya.
Dialogue: 0,0:09:42.58,0:09:43.67,Default,,0,0,0,,Kudengar kakakku
Dialogue: 0,0:09:43.75,0:09:46.63,Default,,0,0,0,,(BUKU HARIAN BERGAMBAR, HIKARU MATSUKI)\Nmelihat ini di hari terakhirnya.
Dialogue: 0,0:09:50.01,0:09:51.22,Default,,0,0,0,,(BUKU HARIAN BERGAMBAR, HIKARU MATSUKI)\NTapi…
Dialogue: 0,0:09:51.47,0:09:54.18,Default,,0,0,0,,aku tidak ingat.
Dialogue: 0,0:09:54.26,0:09:56.68,Default,,0,0,0,,Apa itu artinya aku tidak boleh ingat?
Dialogue: 0,0:10:05.56,0:10:08.48,Default,,0,0,0,,(BIBI: TERIMA KASIH ATAS KERJA KERASNYA)
Dialogue: 0,0:10:10.53,0:10:12.24,Default,,0,0,0,,(AKU YAKIN KAKAKMU)
Dialogue: 0,0:10:12.32,0:10:14.20,Default,,0,0,0,,(BAHAGIA SAMPAI AKHIR)
Dialogue: 0,0:10:20.70,0:10:21.70,Default,,0,0,0,,Hikaru.
Dialogue: 0,0:10:23.79,0:10:25.33,Default,,0,0,0,,Lucu sekali.
Dialogue: 0,0:10:27.67,0:10:31.38,Default,,0,0,0,,Orang-orang\Nyang tidak pernah membantu kita
Dialogue: 0,0:10:31.46,0:10:34.88,Default,,0,0,0,,berpikir mereka bisa membicarakan kakakku\Nsesuka mereka.
Dialogue: 0,0:10:35.76,0:10:39.14,Default,,0,0,0,,Saat kami hanya punya satu sama lain
Dialogue: 0,0:10:39.22,0:10:42.10,Default,,0,0,0,,dan saat kami tahu\Ntentang penyakit kakakku,
Dialogue: 0,0:10:42.64,0:10:45.69,Default,,0,0,0,,mereka mengemasnya\Nmenjadi kisah yang indah dan tragis.
Dialogue: 0,0:10:45.77,0:10:49.36,Default,,0,0,0,,Mereka pikir tidak ada salahnya\Nmerasa puas dan melupakannya.
Dialogue: 0,0:10:51.99,0:10:53.24,Default,,0,0,0,,Kalau begitu…
Dialogue: 0,0:10:56.20,0:10:59.24,Default,,0,0,0,,Bagaimana denganku,\Nyang ingin melupakan, tapi tidak bisa?
Dialogue: 0,0:11:01.41,0:11:04.00,Default,,0,0,0,,Aku… Aku…
Dialogue: 0,0:11:06.88,0:11:09.67,Default,,0,0,0,,Saat aku berada di sisi kakakku\Nyang terbaring sakit,
Dialogue: 0,0:11:09.75,0:11:13.80,Default,,0,0,0,,aku berbisik, "Beri aku kelegaan."
Dialogue: 0,0:11:13.88,0:11:15.30,Default,,0,0,0,,Kakakku…
Dialogue: 0,0:11:15.38,0:11:18.93,Default,,0,0,0,,Saat dia meninggal, aku merasa lega.
Dialogue: 0,0:11:19.64,0:11:22.52,Default,,0,0,0,,Aku memikirkan bagaimana aku\Ntidak perlu mengurusnya lagi.
Dialogue: 0,0:11:22.60,0:11:24.52,Default,,0,0,0,,Itu akhirnya berakhir.
Dialogue: 0,0:11:25.18,0:11:26.73,Default,,0,0,0,,Aku berpikir begitu.
Dialogue: 0,0:11:28.98,0:11:30.23,Default,,0,0,0,,Jadi…
Dialogue: 0,0:11:34.82,0:11:37.61,Default,,0,0,0,,Jadi, aku…
Dialogue: 0,0:11:49.88,0:11:52.59,Default,,0,0,0,,Aku menggambarnya\Nkarena ingin melupakannya.
Dialogue: 0,0:11:57.38,0:11:58.55,Default,,0,0,0,,Apa?
Dialogue: 0,0:12:00.39,0:12:04.47,Default,,0,0,0,,Ini mungkin kali terakhir
Dialogue: 0,0:12:04.56,0:12:08.06,Default,,0,0,0,,aku akan kembali ke sini?
Dialogue: 0,0:12:13.65,0:12:14.65,Default,,0,0,0,,Gambar itu…
Dialogue: 0,0:12:15.11,0:12:16.03,Default,,0,0,0,,Gambar?
Dialogue: 0,0:12:16.57,0:12:17.82,Default,,0,0,0,,Tunjukkan.
Dialogue: 0,0:12:19.28,0:12:23.12,Default,,0,0,0,,Sebenarnya aku tidak berniat\Nmenunjukkannya kepada siapa pun.
Dialogue: 0,0:12:23.20,0:12:24.08,Default,,0,0,0,,Tapi…
Dialogue: 0,0:12:24.66,0:12:27.00,Default,,0,0,0,,Kumohon. Tunjukkan.
Dialogue: 0,0:12:40.26,0:12:43.51,Default,,0,0,0,,Aku melakukannya untuk diriku sendiri.
Dialogue: 0,0:12:44.43,0:12:47.39,Default,,0,0,0,,Untuk melampiaskan rasa frustrasi\Nhidupku yang menyesakkan.
Dialogue: 0,0:12:47.98,0:12:51.06,Default,,0,0,0,,Untuk menghapus perasaan kelam itu.
Dialogue: 0,0:12:52.19,0:12:54.40,Default,,0,0,0,,Untuk melupakan semuanya.
Dialogue: 0,0:12:55.53,0:12:58.99,Default,,0,0,0,,Itu sebabnya aku menggambar\Nmomen terakhir kakakku.
Dialogue: 0,0:13:07.16,0:13:11.71,Default,,0,0,0,,Meski ingin melupakannya,\Naku tak bisa lagi!
Dialogue: 0,0:13:21.55,0:13:22.89,Default,,0,0,0,,Kakak!
Dialogue: 0,0:13:30.94,0:13:31.89,Default,,0,0,0,,Jangan lepaskan!
Dialogue: 0,0:13:31.98,0:13:34.06,Default,,0,0,0,,Hikaru, ayo.
Dialogue: 0,0:13:34.15,0:13:35.15,Default,,0,0,0,,Tapi…
Dialogue: 0,0:13:37.11,0:13:38.74,Default,,0,0,0,,Pegang yang erat!
Dialogue: 0,0:13:38.82,0:13:39.90,Default,,0,0,0,,Koshiba.
Dialogue: 0,0:13:44.74,0:13:46.16,Default,,0,0,0,,Koshiba, kau terlalu cepat!
Dialogue: 0,0:13:46.24,0:13:47.41,Default,,0,0,0,,Terlalu cepat!
Dialogue: 0,0:13:47.83,0:13:51.87,Default,,0,0,0,,Aku benci kata-kata naif dan lemah itu.
Dialogue: 0,0:13:52.71,0:13:55.92,Default,,0,0,0,,Makin mendengarnya, aku makin marah.
Dialogue: 0,0:13:57.75,0:14:01.38,Default,,0,0,0,,Karena apa lagi yang bisa kau lakukan?
Dialogue: 0,0:14:02.76,0:14:03.59,Default,,0,0,0,,Marahlah!
Dialogue: 0,0:14:07.01,0:14:10.56,Default,,0,0,0,,Marahlah pada semua hal\Nyang membuatmu membenci kakakmu.
Dialogue: 0,0:14:11.02,0:14:13.81,Default,,0,0,0,,Pada penyakit yang dengan egois\Nmenghabiskan hidupmu.
Dialogue: 0,0:14:13.90,0:14:15.56,Default,,0,0,0,,Pada kerabat yang tidak melakukan apa pun,
Dialogue: 0,0:14:15.65,0:14:18.27,Default,,0,0,0,,tapi datang ke pemakaman untuk menangis.
Dialogue: 0,0:14:18.65,0:14:21.86,Default,,0,0,0,,Pada masyarakat yang menolak membantumu.
Dialogue: 0,0:14:22.40,0:14:25.49,Default,,0,0,0,,Jadi, jika kau masih ingin menggapainya…
Dialogue: 0,0:14:25.82,0:14:27.03,Default,,0,0,0,,Maka jangan lepaskan!
Dialogue: 0,0:14:30.12,0:14:33.83,Default,,0,0,0,,Manusia adalah makhluk\Nyang akan lupa cepat atau lambat.
Dialogue: 0,0:14:43.01,0:14:45.59,Default,,0,0,0,,Jadi, jika kau tidak bisa lupa,
Dialogue: 0,0:14:45.68,0:14:46.89,Default,,0,0,0,,(BUKU HARIAN BERGAMBAR)
Dialogue: 0,0:14:49.89,0:14:52.68,Default,,0,0,0,,tidak ada salahnya\Nmemegangnya erat-erat sekarang.
Dialogue: 0,0:15:06.24,0:15:07.66,Default,,0,0,0,,Benar.
Dialogue: 0,0:15:09.12,0:15:10.70,Default,,0,0,0,,Aku…
Dialogue: 0,0:15:50.03,0:15:53.41,Default,,0,0,0,,Aku tenggelam.
Dialogue: 0,0:15:58.00,0:15:59.46,Default,,0,0,0,,Lalu…
Dialogue: 0,0:16:11.22,0:16:13.14,Default,,0,0,0,,Kenapa kau menggambar itu?
Dialogue: 0,0:16:13.93,0:16:15.89,Default,,0,0,0,,Mi-chan, dasar bodoh!
Dialogue: 0,0:16:17.27,0:16:18.56,Default,,0,0,0,,Hikaru.
Dialogue: 0,0:16:19.06,0:16:20.86,Default,,0,0,0,,Aku tidak mau menggambar\Ndi buku harian lagi!
Dialogue: 0,0:16:23.82,0:16:25.48,Default,,0,0,0,,Tidak mau?
Dialogue: 0,0:16:25.57,0:16:27.82,Default,,0,0,0,,Tidak mau!
Dialogue: 0,0:16:28.24,0:16:32.24,Default,,0,0,0,,Tapi aku paling suka gambar Hikaru.
Dialogue: 0,0:16:48.80,0:16:49.97,Default,,0,0,0,,Hikaru.
Dialogue: 0,0:16:55.01,0:16:56.02,Default,,0,0,0,,Hikaru?
Dialogue: 0,0:17:01.73,0:17:05.11,Default,,0,0,0,,Aku ingat sekarang, Kak.
Dialogue: 0,0:17:07.90,0:17:09.86,Default,,0,0,0,,(HOTEL INHUMANS)
Dialogue: 0,0:17:14.78,0:17:16.49,Default,,0,0,0,,Pelaku yang dikubur dalam kegelapan…
Dialogue: 0,0:17:16.58,0:17:19.12,Default,,0,0,0,,Detektif Pembunuh sedang tayang.
Dialogue: 0,0:17:19.83,0:17:22.38,Default,,0,0,0,,Jadi, begitu rupanya.
Dialogue: 0,0:17:22.46,0:17:24.34,Default,,0,0,0,,Nn. Sara.
Dialogue: 0,0:17:25.54,0:17:26.55,Default,,0,0,0,,Ada apa?
Dialogue: 0,0:17:26.80,0:17:28.38,Default,,0,0,0,,Nn. Koshiba…
Dialogue: 0,0:17:28.46,0:17:32.05,Default,,0,0,0,,Dia tak mau memberitahuku apa pun\Ntentang pekerjaan terakhirnya.
Dialogue: 0,0:17:32.89,0:17:36.60,Default,,0,0,0,,Membantu sang adik, Hikaru,\Nmenerima kematian kakaknya…
Dialogue: 0,0:17:36.68,0:17:38.85,Default,,0,0,0,,Itu permintaannya.
Dialogue: 0,0:17:38.93,0:17:41.73,Default,,0,0,0,,Itu keinginan terakhir Mitsuru Matsuki.
Dialogue: 0,0:17:43.44,0:17:45.19,Default,,0,0,0,,Dia mungkin hanya malu.
Dialogue: 0,0:17:46.07,0:17:48.07,Default,,0,0,0,,Nn. Koshiba?
Dialogue: 0,0:17:48.15,0:17:52.28,Default,,0,0,0,,Dia mungkin tidak perhatian sepertimu,
Dialogue: 0,0:17:52.36,0:17:55.24,Default,,0,0,0,,tapi dia mungkin lebih baik\Nmendampingi seseorang.
Dialogue: 0,0:18:00.58,0:18:03.12,Default,,0,0,0,,(PARL MART 8 FESTIVAL HIDANGAN PENUTUP)
Dialogue: 0,0:18:04.88,0:18:06.79,Default,,0,0,0,,Ayo, jangan lari!
Dialogue: 0,0:18:12.76,0:18:16.35,Default,,0,0,0,,Koshiba ceroboh dalam hal baik dan buruk.
Dialogue: 0,0:19:24.37,0:19:26.08,Default,,0,0,0,,Selamat datang.
Dialogue: 0,0:19:29.46,0:19:31.46,Default,,0,0,0,,Kau terdengar sangat bindeng.
Dialogue: 0,0:19:32.38,0:19:34.59,Default,,0,0,0,,Aku jatuh ke laut saat musim dingin.
Dialogue: 0,0:19:34.67,0:19:37.05,Default,,0,0,0,,Aku beruntung tidak mati.
Dialogue: 0,0:19:37.13,0:19:38.76,Default,,0,0,0,,Tapi ponselku rusak.
Dialogue: 0,0:19:40.68,0:19:42.35,Default,,0,0,0,,Aku harus membeli yang baru.
Dialogue: 0,0:19:42.43,0:19:43.97,Default,,0,0,0,,(MAGIC BLUE 11 AIR)\NAku harus membeli yang baru.
Dialogue: 0,0:19:44.52,0:19:46.60,Default,,0,0,0,,Mengenai kerabat,
Dialogue: 0,0:19:46.69,0:19:50.11,Default,,0,0,0,,kurasa ini kesempatan bagus\Nuntuk memutuskan hubungan dengan mereka.
Dialogue: 0,0:19:51.32,0:19:52.90,Default,,0,0,0,,Bukankah itu bagus?
Dialogue: 0,0:19:52.98,0:19:53.98,Default,,0,0,0,,Bagaimana dengan pihak lainnya?
Dialogue: 0,0:19:55.44,0:19:56.86,Default,,0,0,0,,Kau baik-baik saja?
Dialogue: 0,0:19:58.45,0:19:59.74,Default,,0,0,0,,Tunggu sebentar.
Dialogue: 0,0:20:01.70,0:20:02.70,Default,,0,0,0,,Apa?
Dialogue: 0,0:20:10.38,0:20:11.63,Default,,0,0,0,,(BUKU HARIAN BERGAMBAR HIKARU MATSUKI)\NLihat.
Dialogue: 0,0:20:12.63,0:20:14.76,Default,,0,0,0,,(BUKU HARIAN BERGAMBAR HIKARU MATSUKI)\NSemuanya berkerut.
Dialogue: 0,0:20:15.17,0:20:16.72,Default,,0,0,0,,Ini lusuh.
Dialogue: 0,0:20:19.80,0:20:22.01,Default,,0,0,0,,Aku menggambarnya tanpa bertanya,
Dialogue: 0,0:20:22.76,0:20:26.27,Default,,0,0,0,,tapi ini menggemaskan,\Njadi kau akan memaafkanku, kan?
Dialogue: 0,0:20:27.56,0:20:31.19,Default,,0,0,0,,"Januari. Dalam perjalanan pulang\Ndari pemakaman kakakku,
Dialogue: 0,0:20:31.27,0:20:33.27,Default,,0,0,0,,aku pergi ke pantai itu\Nsetelah sekian lama.
Dialogue: 0,0:20:35.11,0:20:37.07,Default,,0,0,0,,Di tengah malam musim dingin,
Dialogue: 0,0:20:37.15,0:20:39.11,Default,,0,0,0,,aku naik motor orang aneh.
Dialogue: 0,0:20:39.95,0:20:41.57,Default,,0,0,0,,Udaranya dingin sekali.
Dialogue: 0,0:20:42.16,0:20:45.49,Default,,0,0,0,,Tapi anginnya terasa sejuk. Itu aneh."
Dialogue: 0,0:20:47.75,0:20:50.75,Default,,0,0,0,,(BUKU HARIAN BERGAMBAR)\NAku seharusnya lebih menggemaskan.
Dialogue: 0,0:20:57.26,0:21:03.10,Default,,0,0,0,,"Lalu, aku jatuh ke laut lagi."
Dialogue: 0,0:22:46.32,0:22:48.16,Default,,0,0,0,,Istirahat sebentar.
Dialogue: 0,0:22:52.71,0:22:54.21,Default,,0,0,0,,Sejujurnya…
Dialogue: 0,0:22:55.67,0:22:56.58,Default,,0,0,0,,Ini…
Dialogue: 0,0:22:56.67,0:22:59.04,Default,,0,0,0,,(BUKU SKETSA)
Dialogue: 0,0:22:59.42,0:23:00.75,Default,,0,0,0,,Ini milik kakakku.
Dialogue: 0,0:23:17.15,0:23:18.98,Default,,0,0,0,,Apa-apaan ini?
Dialogue: 0,0:23:21.57,0:23:23.32,Default,,0,0,0,,Dia benar-benar menggambarnya.
Dialogue: 0,0:23:27.11,0:23:29.91,Default,,0,0,0,,(BERSAMBUNG)
Dialogue: 0,0:23:29.99,0:23:35.00,Default,,0,0,0,,(BERIKUTNYA PERMINTAAN 22: KLUB MENDAKI)

