Dialogue: 0,0:00:01.23,0:00:07.19,Default,,0,0,0,,รายงานการพยายามฆ่าโดยการวางเพลิง\Nบ้านทั้งหลังในเขตอากิซากิ เมืองโคมากาเนะ
Dialogue: 0,0:00:07.65,0:00:13.45,Default,,0,0,0,,การสังหารบุคคลสำคัญ ณ อาคารโอเทมอน\Nปัจจุบันกำลังควบคุมข่าวสารอยู่
Dialogue: 0,0:00:13.45,0:00:16.18,Default,,0,0,0,,โกดังที่เจ็ด ท่าเทียบเรือที่สอง
Dialogue: 0,0:00:16.18,0:00:20.92,Default,,0,0,0,,งานของลูกค้าห้อง 306\Nเสร็จสิ้นแต่ยังไม่มีรายงาน
Dialogue: 0,0:00:22.92,0:00:27.26,Default,,0,0,0,,ไฮซากิเองค่ะ รายงานความคืบหน้า\Nของท่านมาจินามิ ห้อง 306 ล่ะคะ
Dialogue: 0,0:00:27.51,0:00:30.01,Default,,0,0,0,,หน่วยเก็บกวาดเข้าพื้นที่แล้วเรียบร้อย
Dialogue: 0,0:00:30.01,0:00:33.14,Default,,0,0,0,,และเจ้าตัวบอกว่าจะกลับมาด้วยตัวเอง
Dialogue: 0,0:00:33.39,0:00:35.60,Default,,0,0,0,,คาดว่าจะมาถึงในอีกสองชั่วโมง
Dialogue: 0,0:00:35.60,0:00:37.73,Default,,0,0,0,,รับทราบ\Nเดี๋ยวฉันเตรียมตัวรอค่ะ
Dialogue: 0,0:00:40.94,0:00:43.48,Default,,0,0,0,,ถ้างั้นเราไปก่อนนะ รุ่นพี่ซาระ
Dialogue: 0,0:00:44.65,0:00:47.82,Default,,0,0,0,,อ๊ะ คุณโคชิบะ\Nวันนี้เลิกงานแล้วเหรอครับ
Dialogue: 0,0:00:49.07,0:00:53.49,Default,,0,0,0,,เห็นว่าท่านมาจินามิ ห้อง 306\Nจะกลับมาถึงในอีก 1 ชั่วโมงครึ่งแน่ะ
Dialogue: 0,0:00:54.08,0:00:55.33,Default,,0,0,0,,อ้อ ได้ครับ
Dialogue: 0,0:00:55.87,0:00:57.16,Default,,0,0,0,,อย่าอู้ละกัน
Dialogue: 0,0:00:57.58,0:00:59.29,Default,,0,0,0,,อ๊ะ… ครับ
Dialogue: 0,0:00:59.29,0:01:00.50,Default,,0,0,0,,ขอตัว
Dialogue: 0,0:01:00.50,0:01:02.58,Default,,0,0,0,,เหนื่อย… เหนื่อยหน่อยนะครับ
Dialogue: 0,0:01:19.68,0:01:21.69,Default,,0,0,0,,บุหรี่ขึ้นราคาอีกแล้วเหรอ
Dialogue: 0,0:01:22.48,0:01:24.56,Default,,0,0,0,,ค่าครองชีพนี่มันยังไงกันเนี่ยถามจริง
Dialogue: 0,0:01:25.06,0:01:27.07,Default,,0,0,0,,ช่วยขึ้นลงแต่พอดีหน่อยเถอะ
Dialogue: 0,0:01:27.48,0:01:28.94,Default,,0,0,0,,ค่ะ…
Dialogue: 0,0:01:28.94,0:01:30.99,Default,,0,0,0,,ขอเบอร์ 27
Dialogue: 0,0:01:30.99,0:01:32.07,Default,,0,0,0,,ได้ค่ะ
Dialogue: 0,0:01:32.07,0:01:33.11,Default,,0,0,0,,(นักสืบแอสแซสซิน เสี่ยงโชคคาแร็กเตอร์)
Dialogue: 0,0:01:33.11,0:01:34.57,Default,,0,0,0,,เอาอันนี้ด้วยใบนึง\N(นักสืบแอสแซสซิน เสี่ยงโชคคาแร็กเตอร์)
Dialogue: 0,0:01:34.95,0:01:36.20,Default,,0,0,0,,เท่านี้แหละ
Dialogue: 0,0:01:36.20,0:01:37.37,Default,,0,0,0,,นี่ค่ะ
Dialogue: 0,0:01:38.99,0:01:41.00,Default,,0,0,0,,ลืมกระเป๋าตังซะได้
Dialogue: 0,0:01:42.87,0:01:45.25,Default,,0,0,0,,ซื้ออันไหนดีเนี่ย
Dialogue: 0,0:01:46.79,0:01:50.88,Default,,0,0,0,,ขอโทษนะคะ\Nคุณชอบนักสืบแอสแซสซินสินะคะ
Dialogue: 0,0:01:50.88,0:01:51.88,Default,,0,0,0,,หืม
Dialogue: 0,0:01:51.88,0:01:54.26,Default,,0,0,0,,เปล่านะ ไม่ได้ชอบ
Dialogue: 0,0:01:54.26,0:01:54.76,Default,,0,0,0,,เอ๊ะ
Dialogue: 0,0:01:54.76,0:01:57.18,Default,,0,0,0,,ป้ายโปรโมตมันน่ารักดีนี่นา\N(นักสืบแอสแซสซิน เสี่ยงโชคคาแร็กเตอร์)
Dialogue: 0,0:01:58.64,0:02:01.89,Default,,0,0,0,,เรานี่แพ้ทางของน่ารักจริง ๆ
Dialogue: 0,0:02:01.89,0:02:04.27,Default,,0,0,0,,อืม… เอายังไงดีนะ
Dialogue: 0,0:02:08.07,0:02:10.94,Default,,0,0,0,,ฉันไม่ได้ให้ฟรี ๆ นะคะ\Nแต่ให้ยืมค่ะ
Dialogue: 0,0:02:13.03,0:02:17.41,Default,,0,0,0,,ป้ายโปรโมตนั่นฉันเป็นคนวาดเอง\Nก็เลยต้องรับผิดชอบละมั้ง
Dialogue: 0,0:02:19.93,0:02:21.47,Default,,0,0,0,,ทำเอานึกถึงเลย
Dialogue: 0,0:02:22.12,0:02:24.33,Default,,0,0,0,,ฉันเองก็เคยมีเรื่องแบบนั้นเหมือนกัน
Dialogue: 0,0:02:25.88,0:02:27.46,Default,,0,0,0,,คุณมัตสึกิน่ะ
Dialogue: 0,0:02:27.46,0:02:28.13,Default,,0,0,0,,เอ๊ะ
Dialogue: 0,0:02:28.63,0:02:31.63,Default,,0,0,0,,อย่าให้คนยืมเงินง่ายขนาดนั้นจะดีกว่านะ
Dialogue: 0,0:02:34.22,0:02:36.18,Default,,0,0,0,,เงินห้าร้อยเยนนี่น่ะ
Dialogue: 0,0:02:36.18,0:02:38.05,Default,,0,0,0,,ขอฉันยืมจนกว่าจะจบโปรได้ไหม
Dialogue: 0,0:02:38.68,0:02:40.85,Default,,0,0,0,,ก็ได้อยู่หรอก แต่ยืมไปทำไมล่ะ
Dialogue: 0,0:02:41.56,0:02:42.93,Default,,0,0,0,,ถือเคล็ดน่ะ
Dialogue: 0,0:02:44.02,0:02:48.27,Default,,0,0,0,,ฉันจะนั่งมอเตอร์ไซค์\Nของคนที่ไม่รู้จักแม้แต่ชื่อได้ยังไงกันล่ะ
Dialogue: 0,0:02:49.48,0:02:52.23,Default,,0,0,0,,คนรอบข้างจะเรียกเราว่าโคชิบะ
Dialogue: 0,0:02:52.57,0:02:54.95,Default,,0,0,0,,ส่วนเธอก็มัตสึกิ…
Dialogue: 0,0:02:58.66,0:02:59.83,Default,,0,0,0,,นี่
Dialogue: 0,0:02:59.83,0:03:01.41,Default,,0,0,0,,(ตุ๊กตารางวัลดี)
Dialogue: 0,0:03:01.62,0:03:03.58,Default,,0,0,0,,ถือว่าน่ารักแล้วกัน
Dialogue: 0,0:03:04.37,0:03:05.62,Default,,0,0,0,,ฮิคารุ
Dialogue: 0,0:03:07.96,0:03:09.63,Default,,0,0,0,,มัตสึกิ ฮิคารุ
Dialogue: 0,0:03:10.46,0:03:13.76,Default,,0,0,0,,ฮิคารุวาดรูปเก่งตั้งแต่เมื่อก่อนแล้วเหรอ
Dialogue: 0,0:03:15.01,0:03:17.09,Default,,0,0,0,,ก็ไม่รู้เหมือนกันนะ
Dialogue: 0,0:03:18.47,0:03:21.18,Default,,0,0,0,,แต่ก็มีพี่คอยชมอยู่แหละ
Dialogue: 0,0:03:22.72,0:03:26.73,Default,,0,0,0,,เฮ้ย อิคุโร\Nบอกแล้วไงว่าอย่าแตะต้อง
Dialogue: 0,0:03:31.57,0:03:34.36,Default,,0,0,0,,เราเผาศพพี่สาวฉันแล้วละ
Dialogue: 0,0:03:36.65,0:03:39.57,Default,,0,0,0,,นี่ไง ฉันใส่ชุดไว้ทุกข์อยู่\Nคงจะตบมุกยากล่ะสิ
Dialogue: 0,0:03:40.70,0:03:42.87,Default,,0,0,0,,เพราะงั้นฉันเลยสปอยล์ตัวเองน่ะ
Dialogue: 0,0:03:44.04,0:03:45.96,Default,,0,0,0,,ฉันไม่เป็นไรหรอก
Dialogue: 0,0:03:45.96,0:03:49.29,Default,,0,0,0,,ฉันรู้อยู่แล้วว่าเธอคงเหลือเวลาไม่มาก
Dialogue: 0,0:03:49.29,0:03:51.17,Default,,0,0,0,,เตรียมใจเอาไว้ตลอดนั่นแหละ
Dialogue: 0,0:03:51.75,0:03:55.13,Default,,0,0,0,,แต่พอฉันกลับบ้านหลังจากเผาศพเธอ…
Dialogue: 0,0:03:55.42,0:03:58.05,Default,,0,0,0,,ก็ไม่รู้ว่าจะต้องทำอะไรดี
Dialogue: 0,0:04:00.84,0:04:03.10,Default,,0,0,0,,ช่วยพาฉันไปทะเลที
Dialogue: 0,0:04:03.64,0:04:05.64,Default,,0,0,0,,ลมเย็นสบายดีจัง
Dialogue: 0,0:04:06.10,0:04:08.77,Default,,0,0,0,,นี่ ทำไมต้องไปทะเลล่ะ
Dialogue: 0,0:04:08.77,0:04:10.65,Default,,0,0,0,,ไดอารี่
Dialogue: 0,0:04:10.65,0:04:11.44,Default,,0,0,0,,เอ๋
Dialogue: 0,0:04:11.44,0:04:13.19,Default,,0,0,0,,ไดอารี่
Dialogue: 0,0:04:13.19,0:04:15.61,Default,,0,0,0,,เมื่อตอนสมัยเด็กฉันกับพี่เขา
Dialogue: 0,0:04:15.61,0:04:18.15,Default,,0,0,0,,ได้แลกไดอารี่รูปวาดด้วยกันน่ะ
Dialogue: 0,0:04:18.40,0:04:21.82,Default,,0,0,0,,สมุดเล่มนั้นมันจบในวันที่ไปทะเล
Dialogue: 0,0:04:25.08,0:04:26.66,Default,,0,0,0,,รับเรื่องแล้วค่ะ
Dialogue: 0,0:04:27.08,0:04:28.91,Default,,0,0,0,,เรื่องของท่านน้องสาวน่ะ
Dialogue: 0,0:04:28.91,0:04:33.17,Default,,0,0,0,,ฉันอยากนึกให้ออก\Nว่าทำไมมันถึงจบลงตรงนั้น
Dialogue: 0,0:04:34.30,0:04:38.47,Default,,0,0,0,,ก็ฉันถามเรื่องไดอารี่รูปวาดกับเจ้าตัวไม่ได้แล้วนี่
Dialogue: 0,0:04:44.97,0:04:47.31,Default,,0,0,0,,เดี๋ยวฉันเลี้ยงกาแฟเธอนะ
Dialogue: 0,0:04:51.60,0:04:56.23,Default,,0,0,0,,รุ่นพี่ซาระ\Nขอบคุณที่เข้ากะดึกแทนมาก ๆ เลย
Dialogue: 0,0:04:58.94,0:05:01.57,Default,,0,0,0,,ฝากด้วยล่ะ โคชิบะ
Dialogue: 0,0:05:02.45,0:05:06.74,Default,,0,0,0,,ดำเนินการบริการปลิดชีพ\Nจากท่านมัตสึกิ มิตสึรุ
Dialogue: 0,0:05:07.41,0:05:09.79,Default,,0,0,0,,ผู้เป็นนักฆ่าแด่ท่านน้องสาว
Dialogue: 0,0:05:15.84,0:05:16.88,Default,,0,0,0,,(อินฮิวแมน)\N(inhuman (adj) inhjuman)
Dialogue: 0,0:05:16.88,0:05:17.92,Default,,0,0,0,,(หนึ่ง อมนุษย์ ราวกับสัตว์ประหลาด)\N(สอง ไร้ความเป็นมนุษย์)
Dialogue: 0,0:05:17.92,0:05:18.96,Default,,0,0,0,,(สาม โหดเหี้ยม อำมหิต)
Dialogue: 0,0:06:39.63,0:06:45.26,Default,,0,0,0,,(โรงแรมเพชฌฆาต)
Dialogue: 0,0:06:49.30,0:06:53.35,Default,,0,0,0,,(คำขอที่ยี่สิบเอ็ด ไดอารี่ส์มอเตอร์ไซค์ สอง)
Dialogue: 0,0:06:56.23,0:06:57.56,Default,,0,0,0,,อุ่นดีจัง
Dialogue: 0,0:06:59.48,0:07:02.32,Default,,0,0,0,,ตอนนี้เราอยู่ที่นี่กันแล้ว\Nยังต้องไปต่อไหม
Dialogue: 0,0:07:03.90,0:07:06.32,Default,,0,0,0,,อืม ตรงไปแบบนี้เรื่อย ๆ
Dialogue: 0,0:07:06.66,0:07:09.32,Default,,0,0,0,,แล้วจะมีลานจอดรถอยู่ริมชายฝั่งน่ะ
Dialogue: 0,0:07:36.69,0:07:38.40,Default,,0,0,0,,ตรงนี้แหละ จอดรถที
Dialogue: 0,0:07:39.77,0:07:41.15,Default,,0,0,0,,ถึงแล้ว
Dialogue: 0,0:07:42.02,0:07:43.98,Default,,0,0,0,,ถึงที่แล้วละ โคชิบะ
Dialogue: 0,0:07:46.03,0:07:47.40,Default,,0,0,0,,แต่ว่า…
Dialogue: 0,0:07:48.28,0:07:50.07,Default,,0,0,0,,แต่ว่านะ…
Dialogue: 0,0:07:50.37,0:07:52.70,Default,,0,0,0,,หนาวจัง
Dialogue: 0,0:07:52.99,0:07:56.87,Default,,0,0,0,,แถมลมก็แรงสุด ๆ
Dialogue: 0,0:07:59.25,0:08:03.50,Default,,0,0,0,,ใช่ที่นี่แน่นะ\Nครั้งก่อนที่มาก็เป็นช่วงสมัยยังเด็กไม่ใช่เหรอ
Dialogue: 0,0:08:08.18,0:08:10.26,Default,,0,0,0,,(ไส้กรอกแฟรงค์เฟิร์ต)
Dialogue: 0,0:08:16.43,0:08:17.35,Default,,0,0,0,,อืม
Dialogue: 0,0:08:17.35,0:08:19.23,Default,,0,0,0,,เป็นที่นี่แน่นอน
Dialogue: 0,0:08:26.32,0:08:30.16,Default,,0,0,0,,ถ้าจะลงไปถึงตรงชายหาด\Nก็ต้องจอดมอเตอร์ไซค์ไว้ตรงนี้…
Dialogue: 0,0:08:30.16,0:08:31.78,Default,,0,0,0,,ไม่ไหวแฮะ
Dialogue: 0,0:08:32.37,0:08:36.75,Default,,0,0,0,,สถานที่ก็คือตรงนี้แท้ ๆ\Nแต่กลับนึกไม่ออกเลย
Dialogue: 0,0:08:40.87,0:08:43.75,Default,,0,0,0,,ทำไมถึงเลิกวาดไดอารี่กันนะ
Dialogue: 0,0:08:46.46,0:08:50.30,Default,,0,0,0,,ในที่สุดก็ถึงทะเลที่ตั้งตารอแล้ว
Dialogue: 0,0:08:50.30,0:08:55.06,Default,,0,0,0,,ถึงวันนี้จะมืดแล้วก็เถอะ\Nแต่พรุ่งนี้จะว่ายน้ำให้เต็มอิ่มเลย
Dialogue: 0,0:08:55.06,0:08:58.02,Default,,0,0,0,,- จะได้เจอคุณปลาบ้างไหมนะ\N- จะได้เจอคุณปลาบ้างไหมนะ
Dialogue: 0,0:08:58.02,0:09:01.19,Default,,0,0,0,,เดี๋ยว อย่ามาดูไดอารี่คนอื่นตามใจชอบสิ
Dialogue: 0,0:09:01.19,0:09:04.82,Default,,0,0,0,,อืม ก็ดูตั้งตารอจนมาถึงที่นี่จริง ๆ
Dialogue: 0,0:09:04.82,0:09:05.73,Default,,0,0,0,,แต่ว่า…
Dialogue: 0,0:09:05.73,0:09:09.32,Default,,0,0,0,,อืม หน้าต่อไปถูกฉีกทิ้งไปน่ะสิ
Dialogue: 0,0:09:10.03,0:09:11.78,Default,,0,0,0,,ทำไมกันนะ
Dialogue: 0,0:09:12.28,0:09:15.70,Default,,0,0,0,,ได้วาดเรื่องราวในวันรุ่งขึ้น\Nหลังจากมาถึงทะเลด้วยเหรอ
Dialogue: 0,0:09:16.70,0:09:18.29,Default,,0,0,0,,ไม่รู้สิ
Dialogue: 0,0:09:20.58,0:09:25.21,Default,,0,0,0,,เฮ้อ กลิ่นทะเลชวนให้คิดถึงมากเลยแท้ ๆ
Dialogue: 0,0:09:34.97,0:09:39.98,Default,,0,0,0,,คือว่า…\Nเหตุผลที่ฉันอยากนึกให้ออกมีมากกว่านั้นนะ
Dialogue: 0,0:09:42.44,0:09:46.73,Default,,0,0,0,,เห็นว่าพี่อ่านสมุดเล่มนี้ในวันสุดท้ายของชีวิตน่ะ
Dialogue: 0,0:09:49.90,0:09:51.24,Default,,0,0,0,,แต่ว่า…
Dialogue: 0,0:09:51.24,0:09:56.74,Default,,0,0,0,,การที่ฉันลืมมันไปแบบนี้…\Nฉันไม่จำเป็นต้องนึกให้ออกต่อไปหรือเปล่า
Dialogue: 0,0:10:05.54,0:10:08.55,Default,,0,0,0,,(คุณอา)\N(ฮิคารุจัง ขอบคุณที่พยายามมาตลอดนะจ๊ะ)
Dialogue: 0,0:10:10.46,0:10:12.22,Default,,0,0,0,,(อาคิดว่าพี่สาวหนู)
Dialogue: 0,0:10:12.22,0:10:14.22,Default,,0,0,0,,(ต้องเป็นคนที่มีความสุข\Nจนวาระสุดท้ายแน่นอนจ้ะ)
Dialogue: 0,0:10:20.47,0:10:21.68,Default,,0,0,0,,ฮิคารุ
Dialogue: 0,0:10:23.56,0:10:25.44,Default,,0,0,0,,ตลกมากเลย
Dialogue: 0,0:10:27.52,0:10:31.36,Default,,0,0,0,,บรรดาผู้คนที่ไม่ได้ช่วยเหลืออะไรเลยสักนิด
Dialogue: 0,0:10:31.36,0:10:34.82,Default,,0,0,0,,มาพูดถึงพี่สาวฉันแบบส่ง ๆ แบบนี้ได้เลยงั้นสิ
Dialogue: 0,0:10:35.61,0:10:38.66,Default,,0,0,0,,ในตอนที่พวกเราอยู่ด้วยกันเพียงลำพัง
Dialogue: 0,0:10:39.12,0:10:42.20,Default,,0,0,0,,และแม้แต่ตอนที่รู้อาการป่วยของพี่
Dialogue: 0,0:10:42.54,0:10:45.62,Default,,0,0,0,,การสรุปมันให้เป็นเรื่องเศร้าที่สวยงาม
Dialogue: 0,0:10:45.62,0:10:49.46,Default,,0,0,0,,แล้วพอใจกับการทำแบบนั้น\Nก็ลืมเลือนมันไปได้เลยงั้นสิ
Dialogue: 0,0:10:51.76,0:10:53.13,Default,,0,0,0,,ถ้างั้น…
Dialogue: 0,0:10:56.01,0:10:59.39,Default,,0,0,0,,แล้วตัวฉันที่อยากลืมแต่ลืมมันไม่ลงล่ะ
Dialogue: 0,0:11:01.22,0:11:03.98,Default,,0,0,0,,แล้ว… แล้วที่ฉัน…
Dialogue: 0,0:11:06.65,0:11:13.61,Default,,0,0,0,,เคยพูดว่าพอทีเถอะโดยไม่ให้พี่ได้ยิน\Nอยู่ข้าง ๆ เธอที่นอนติดเตียงอยู่ล่ะ
Dialogue: 0,0:11:13.61,0:11:18.87,Default,,0,0,0,,แล้วที่ฉัน… กลับโล่งใจอยู่ลึก ๆ\Nหลังจากที่พี่ตายไปล่ะ
Dialogue: 0,0:11:19.54,0:11:24.96,Default,,0,0,0,,แล้วที่เคยคิดว่า\Nเท่านี้ก็ไม่ต้องคอยดูแลแล้ว…
Dialogue: 0,0:11:24.96,0:11:26.92,Default,,0,0,0,,ในที่สุดมันก็จบลงสักทีล่ะ
Dialogue: 0,0:11:28.79,0:11:30.21,Default,,0,0,0,,เพราะงั้น…
Dialogue: 0,0:11:34.51,0:11:35.88,Default,,0,0,0,,เพราะอย่างงั้น…
Dialogue: 0,0:11:36.05,0:11:37.22,Default,,0,0,0,,ฉัน…
Dialogue: 0,0:11:49.81,0:11:52.52,Default,,0,0,0,,ถึงได้วาดมันขึ้นมาเพราะอยากลืมแท้ ๆ
Dialogue: 0,0:11:57.20,0:11:58.36,Default,,0,0,0,,อะไรเหรอ
Dialogue: 0,0:12:00.20,0:12:03.45,Default,,0,0,0,,นี่อาจจะเป็นครั้งสุดท้าย
Dialogue: 0,0:12:03.45,0:12:08.17,Default,,0,0,0,,ที่ได้กลับมาที่บ้านก็ได้
Dialogue: 0,0:12:12.29,0:12:14.59,Default,,0,0,0,,นี่ รูปนั้นน่ะ
Dialogue: 0,0:12:14.84,0:12:15.96,Default,,0,0,0,,รูปเหรอ
Dialogue: 0,0:12:16.38,0:12:17.80,Default,,0,0,0,,ขอพี่ดูหน่อยสิ
Dialogue: 0,0:12:19.18,0:12:23.01,Default,,0,0,0,,ฉันไม่ได้ตั้งใจจะเอาให้เธอดูเลย
Dialogue: 0,0:12:23.01,0:12:23.93,Default,,0,0,0,,แต่ว่า…
Dialogue: 0,0:12:24.26,0:12:27.02,Default,,0,0,0,,ขอร้องละ ขอพี่ดูหน่อย
Dialogue: 0,0:12:40.03,0:12:41.32,Default,,0,0,0,,ภาพนั้นน่ะ…
Dialogue: 0,0:12:41.99,0:12:43.41,Default,,0,0,0,,ฉันวาดไปเพื่อตัวเอง
Dialogue: 0,0:12:44.25,0:12:47.42,Default,,0,0,0,,เพื่อระบายชีวิตประจำวันเดิม ๆ ออกมา
Dialogue: 0,0:12:47.83,0:12:50.96,Default,,0,0,0,,เพื่อชำระล้างอารมณ์ที่ขุ่นมัว
Dialogue: 0,0:12:52.00,0:12:54.13,Default,,0,0,0,,และเพื่อให้ลืมเรื่องราวทุกเรื่อง
Dialogue: 0,0:12:55.42,0:12:58.47,Default,,0,0,0,,ฉันเลยวาดภาพวาระสุดท้ายของพี่ออกมา
Dialogue: 0,0:13:07.02,0:13:11.65,Default,,0,0,0,,ถึงอยากลืมมากแค่ไหน\Nแต่ฉันก็ลืมมันไม่ลงแล้วละ
Dialogue: 0,0:13:21.40,0:13:22.86,Default,,0,0,0,,พี่คะ
Dialogue: 0,0:13:29.70,0:13:30.62,Default,,0,0,0,,เอ๊ะ
Dialogue: 0,0:13:30.79,0:13:32.87,Default,,0,0,0,,อย่าปล่อยมือนะ ฮิคารุ
Dialogue: 0,0:13:32.87,0:13:33.71,Default,,0,0,0,,ไปกันเถอะ
Dialogue: 0,0:13:33.71,0:13:35.09,Default,,0,0,0,,แต่ว่า…
Dialogue: 0,0:13:36.96,0:13:38.71,Default,,0,0,0,,จับเอาไว้แน่น ๆ ล่ะ
Dialogue: 0,0:13:38.71,0:13:40.01,Default,,0,0,0,,โคชิบะ
Dialogue: 0,0:13:44.55,0:13:47.47,Default,,0,0,0,,โคชิบะ เร็วไปแล้ว\Nบอกว่าเร็วไปแล้วไง
Dialogue: 0,0:13:47.68,0:13:51.52,Default,,0,0,0,,เราน่ะ\Nเกลียดเรื่องราวชวนเลี่ยนที่สุดเลย
Dialogue: 0,0:13:52.56,0:13:55.81,Default,,0,0,0,,ยิ่งได้ฟังมากเท่าไหร่\Nยิ่งหงุดหงิดอย่างเลี่ยงไม่ได้เลย
Dialogue: 0,0:13:57.44,0:14:01.53,Default,,0,0,0,,ก็เรื่องนี้ ฮิคารุทำอะไรได้มากกว่านั้นด้วยเหรอ
Dialogue: 0,0:14:02.53,0:14:03.49,Default,,0,0,0,,โกรธซะสิ
Dialogue: 0,0:14:06.83,0:14:10.45,Default,,0,0,0,,โกรธทุกอย่างที่ทำให้เธอเกลียดพี่สาวตัวเองสิ
Dialogue: 0,0:14:10.79,0:14:13.42,Default,,0,0,0,,โกรธอาการป่วยที่บั่นทอนชีวิตพี่ไปตามใจชอบ
Dialogue: 0,0:14:13.83,0:14:18.42,Default,,0,0,0,,โกรธพวกญาติพี่น้องที่มาร้องห่มร้องไห้\Nในงานศพทั้ง ๆ ที่ไม่ได้ทำอะไรสักอย่างด้วยสิ
Dialogue: 0,0:14:18.59,0:14:21.84,Default,,0,0,0,,โกรธสังคมที่ไม่ยอมช่วยเหลือเลยแม้แต่นิด
Dialogue: 0,0:14:22.26,0:14:25.59,Default,,0,0,0,,เพราะอย่างนั้น\Nถ้าเธอยังเอื้อมมือออกไปคว้ามันอยู่
Dialogue: 0,0:14:25.59,0:14:27.05,Default,,0,0,0,,ก็อย่าปล่อยมันไปเชียว
Dialogue: 0,0:14:30.02,0:14:33.44,Default,,0,0,0,,ยังไงซะสักวันหนึ่งมนุษย์เราก็ลืมมันไปอยู่ดี
Dialogue: 0,0:14:42.90,0:14:45.70,Default,,0,0,0,,ดังนั้นถ้าเกิดเธอลืมไม่ได้
Dialogue: 0,0:14:49.74,0:14:52.54,Default,,0,0,0,,ตอนนี้กอดมันเอาไว้ก็ได้นี่
Dialogue: 0,0:15:04.38,0:15:05.38,Default,,0,0,0,,อ้อ…
Dialogue: 0,0:15:06.09,0:15:07.47,Default,,0,0,0,,จริงด้วย
Dialogue: 0,0:15:08.97,0:15:10.26,Default,,0,0,0,,ในตอนนั้น…
Dialogue: 0,0:15:49.80,0:15:53.43,Default,,0,0,0,,ในตอนนั้น… เราจมน้ำนี่เอง
Dialogue: 0,0:15:57.94,0:15:59.52,Default,,0,0,0,,หลังจากนั้น…
Dialogue: 0,0:16:11.12,0:16:13.08,Default,,0,0,0,,ทำไมถึงวาดมันกันล่ะ
Dialogue: 0,0:16:13.79,0:16:17.16,Default,,0,0,0,,มี้จังคนบ้า
Dialogue: 0,0:16:17.16,0:16:18.62,Default,,0,0,0,,ฮิคารุ
Dialogue: 0,0:16:19.00,0:16:20.96,Default,,0,0,0,,หนูไม่วาดไดอารี่แล้ว
Dialogue: 0,0:16:23.67,0:16:25.26,Default,,0,0,0,,จะเลิกแล้วเหรอ
Dialogue: 0,0:16:25.51,0:16:27.80,Default,,0,0,0,,เลิกแล้ว ไม่วาดแล้ว
Dialogue: 0,0:16:28.13,0:16:32.01,Default,,0,0,0,,พี่ชอบรูปวาดของฮิคารุที่สุดแท้ ๆ นะ
Dialogue: 0,0:16:48.70,0:16:49.99,Default,,0,0,0,,ฮิคารุ
Dialogue: 0,0:16:54.91,0:16:55.99,Default,,0,0,0,,ฮิคารุ
Dialogue: 0,0:17:01.58,0:17:05.21,Default,,0,0,0,,หนูนึกออกแล้วละ พี่
Dialogue: 0,0:17:07.71,0:17:09.92,Default,,0,0,0,,โรงแรมเพชฌฆาต
Dialogue: 0,0:17:14.60,0:17:16.47,Default,,0,0,0,,ฝังคนร้ายตัวจริงสู่ความมืดมิด
Dialogue: 0,0:17:16.47,0:17:19.27,Default,,0,0,0,,นักสืบแอสแซสซิน\Nกำลังฉายด้วยความนิยมล้นหลาม
Dialogue: 0,0:17:19.68,0:17:22.10,Default,,0,0,0,,อ้อ เรื่องนี้เองเหรอ
Dialogue: 0,0:17:22.40,0:17:24.06,Default,,0,0,0,,นี่ คุณซาระครับ
Dialogue: 0,0:17:25.36,0:17:26.61,Default,,0,0,0,,มีอะไรเหรอคะ
Dialogue: 0,0:17:26.61,0:17:32.07,Default,,0,0,0,,คุณโคชิบะน่ะครับ\Nเขาไม่ยอมเล่างานเมื่อวันก่อนให้ฟังสักนิดเลยอะ
Dialogue: 0,0:17:32.78,0:17:36.53,Default,,0,0,0,,เรื่องคำขอในวาระสุดท้ายของท่านมัตสึกิ มิตสึรุ
Dialogue: 0,0:17:36.53,0:17:41.58,Default,,0,0,0,,ที่ว่าขอให้ช่วยให้ท่านฮิคารุผู้เป็นน้องสาว\N"ยอมรับความตายของเธอ" นั่นน่ะ
Dialogue: 0,0:17:42.29,0:17:45.09,Default,,0,0,0,,อ้อ เธอคงอายละมั้งคะ
Dialogue: 0,0:17:45.09,0:17:47.71,Default,,0,0,0,,เอ๋ คุณโคชิบะคนนั้นน่ะเหรอ
Dialogue: 0,0:17:48.00,0:17:52.22,Default,,0,0,0,,เด็กคนนั้นอาจจะไม่คอยอยู่เคียงข้าง\Nเอาใจใส่เหมือนกับคุณอิคุโร
Dialogue: 0,0:17:52.22,0:17:54.93,Default,,0,0,0,,แต่อาจจะคอยอยู่เป็นเพื่อน\Nมากกว่าคุณก็ได้นะคะ
Dialogue: 0,0:17:55.22,0:17:56.30,Default,,0,0,0,,หืม
Dialogue: 0,0:18:04.81,0:18:06.65,Default,,0,0,0,,โธ่ อย่าวิ่งสิ
Dialogue: 0,0:18:12.61,0:18:16.32,Default,,0,0,0,,โคชิบะเป็นคนเงอะงะ\Nทั้งในแง่ดีและแง่ร้ายน่ะค่ะ
Dialogue: 0,0:19:24.23,0:19:26.23,Default,,0,0,0,,ยินดีต้อนรับค่ะ
Dialogue: 0,0:19:29.31,0:19:31.40,Default,,0,0,0,,เสียงเปลี่ยนสุด ๆ เลยนะนั่น
Dialogue: 0,0:19:32.19,0:19:36.95,Default,,0,0,0,,ตกทะเลช่วงกลางฤดูหนาวเลยนะ\Nไม่ตายก็บุญโขแล้วมั้ง
Dialogue: 0,0:19:36.95,0:19:38.82,Default,,0,0,0,,ถึงโทรศัพท์จะม่องเท่งแล้วก็เถอะ
Dialogue: 0,0:19:40.53,0:19:44.00,Default,,0,0,0,,ต้องไปซื้อโทรศัพท์ใหม่แล้วสิ
Dialogue: 0,0:19:44.37,0:19:49.92,Default,,0,0,0,,เอาเถอะ ก็คิดอยู่แหละว่า\Nถือโอกาสนี้ตัดความสัมพันธ์กับญาติก็ดีละมั้ง
Dialogue: 0,0:19:51.17,0:19:52.84,Default,,0,0,0,,ก็ดีนี่
Dialogue: 0,0:19:52.84,0:19:53.92,Default,,0,0,0,,อันนั้นล่ะ
Dialogue: 0,0:19:53.92,0:19:54.92,Default,,0,0,0,,หืม
Dialogue: 0,0:19:55.26,0:19:56.80,Default,,0,0,0,,มันโอเคดีหรือเปล่า
Dialogue: 0,0:19:57.13,0:19:59.76,Default,,0,0,0,,อ๋อ รอแป๊บนึงนะ
Dialogue: 0,0:20:00.80,0:20:02.68,Default,,0,0,0,,เอ๊ะ อะไรน่ะ
Dialogue: 0,0:20:10.31,0:20:11.65,Default,,0,0,0,,แต่นแต๊น
Dialogue: 0,0:20:12.48,0:20:14.90,Default,,0,0,0,,เหวอ ยับหมดเลย
Dialogue: 0,0:20:15.07,0:20:16.61,Default,,0,0,0,,เยินเลยนะ
Dialogue: 0,0:20:19.66,0:20:22.03,Default,,0,0,0,,ถึงฉันจะวาดโดยไม่ขอก็เถอะ
Dialogue: 0,0:20:22.66,0:20:26.08,Default,,0,0,0,,แต่น่ารัก ๆ แบบนี้\Nโคชิบะคงยอมให้วาดใช่หรือเปล่า
Dialogue: 0,0:20:27.46,0:20:33.25,Default,,0,0,0,,เดือนมกราคม หลังกลับมาจากงานศพของพี่\Nหนูก็ได้ไปทะเลในรอบนานนม
Dialogue: 0,0:20:34.96,0:20:38.88,Default,,0,0,0,,ไปด้วยมอเตอร์ไซค์ของคนแปลก ๆ\Nกลางดึกช่วงกลางฤดูหนาว
Dialogue: 0,0:20:39.76,0:20:41.59,Default,,0,0,0,,มันหนาวสุด ๆ
Dialogue: 0,0:20:41.97,0:20:45.39,Default,,0,0,0,,แต่ลมกลับเย็นสบายก็แปลกใจดีเหมือนกัน
Dialogue: 0,0:20:47.60,0:20:50.60,Default,,0,0,0,,นี่ เราน่ารักกว่านั้นนะ
Dialogue: 0,0:20:57.07,0:20:59.99,Default,,0,0,0,,แล้วทีนี้ หนูก็…
Dialogue: 0,0:21:00.49,0:21:02.87,Default,,0,0,0,,จมทะเลอีกแล้วละ
Dialogue: 0,0:22:46.18,0:22:48.18,Default,,0,0,0,,พักสักหน่อยแล้วกัน
Dialogue: 0,0:22:52.56,0:22:54.89,Default,,0,0,0,,ปัดโธ่…
Dialogue: 0,0:22:55.23,0:22:56.65,Default,,0,0,0,,นี่มัน…
Dialogue: 0,0:22:59.27,0:23:00.90,Default,,0,0,0,,สมุดของพี่นี่
Dialogue: 0,0:23:17.04,0:23:19.09,Default,,0,0,0,,อะไรของพี่เนี่ย
Dialogue: 0,0:23:21.50,0:23:23.17,Default,,0,0,0,,วาดเอาไว้ด้วยนี่
Dialogue: 0,0:23:27.05,0:23:29.97,Default,,0,0,0,,(โปรดติดตามตอนต่อไป)
Dialogue: 0,0:23:29.97,0:23:34.98,Default,,0,0,0,,(ตอนต่อไป)\N(คำขอที่ยี่สิบสอง วันเดอร์เฟอเกิล)

