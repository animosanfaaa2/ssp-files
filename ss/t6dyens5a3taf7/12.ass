Dialogue: 0,0:01:13.72,0:01:22.65,Default,,0,0,0,,CHITOSE TRONG CHAI RAMUNE
Dialogue: 0,0:01:33.05,0:01:36.73,Default,,0,0,0,,Cho chúng nó đấu thật sao?\NKết quả thấy rõ luôn rồi đấy.
Dialogue: 0,0:01:37.15,0:01:40.69,Default,,0,0,0,,Cậu hơi bị coi thường\Nchủ lực bên tôi thì phải.
Dialogue: 0,0:01:41.13,0:01:43.30,Default,,0,0,0,,Trường Fuji là một đội bóng mạnh.
Dialogue: 0,0:01:43.30,0:01:47.13,Default,,0,0,0,,Kết hợp với bạn Hậu vệ Dẫn bóng đó\Nthì cũng đe dọa được bên tôi đấy.
Dialogue: 0,0:01:47.13,0:01:50.91,Default,,0,0,0,,Ý cậu là nếu có cả Nana\Nthì đấu tập mới có ý nghĩa…
Dialogue: 0,0:01:50.91,0:01:54.00,Default,,0,0,0,,còn với cá nhân Umi\Nthì chẳng đáng bỏ công sao?
Dialogue: 0,0:01:56.35,0:02:00.07,Default,,0,0,0,,Ý là khi hai đứa hợp lại\Nmới tạo thành mối đe dọa.
Dialogue: 0,0:02:00.49,0:02:03.87,Default,,0,0,0,,Lẽ nào cậu đang thấy bản thân mình\Ntrong đó hả?
Dialogue: 0,0:02:07.03,0:02:07.97,Default,,0,0,0,,Làm gì có.
Dialogue: 0,0:02:08.43,0:02:13.14,Default,,0,0,0,,Bức tường mà con bé phải đối mặt\Nlớn hơn của tôi nhiều.
Dialogue: 0,0:02:14.05,0:02:18.07,Default,,0,0,0,,Nói trước, tuyển thủ của tôi không non đâu.
Dialogue: 0,0:02:21.23,0:02:23.73,Default,,0,0,0,,Trường Ashiba vẫn chẳng thay đổi gì nhỉ.
Dialogue: 0,0:02:32.72,0:02:33.87,Default,,0,0,0,,Được rồi.
Dialogue: 0,0:02:34.55,0:02:35.70,Default,,0,0,0,,Bắt đầu nhé?
Dialogue: 0,0:02:36.87,0:02:37.80,Default,,0,0,0,,Luật thế nào?
Dialogue: 0,0:02:38.23,0:02:41.70,Default,,0,0,0,,Ném từ đâu cũng tính là một điểm.\NĐược 10 điểm thì thắng.
Dialogue: 0,0:02:41.70,0:02:43.47,Default,,0,0,0,,Bị cướp bóng thì đổi quyền tấn công.
Dialogue: 0,0:02:44.00,0:02:45.80,Default,,0,0,0,,Mời cậu tấn công trước.
Dialogue: 0,0:02:45.97,0:02:49.80,Default,,0,0,0,,Ái chà, thế thì đúng là chu đáo thật.
Dialogue: 0,0:02:50.08,0:02:51.43,Default,,0,0,0,,Là sao cơ?
Dialogue: 0,0:02:53.12,0:02:56.39,Default,,0,0,0,,Umi là kiểu ghi điểm ở gần rổ…
Dialogue: 0,0:02:56.76,0:02:59.31,Default,,0,0,0,,còn Todo thì chuyên ném 3 điểm từ xa.
Dialogue: 0,0:03:00.31,0:03:05.99,Default,,0,0,0,,Nhưng luật ném từ đâu cũng một điểm\Nchắc là chấp vì chênh lệch chiều cao.
Dialogue: 0,0:03:06.20,0:03:08.13,Default,,0,0,0,,Lại còn nhường quyền tấn công trước…
Dialogue: 0,0:03:08.77,0:03:10.30,Default,,0,0,0,,Đúng là khinh người quá mức.
Dialogue: 0,0:03:12.48,0:03:14.41,Default,,0,0,0,,Trông cậu có vẻ bất mãn nhỉ?
Dialogue: 0,0:03:14.55,0:03:15.53,Default,,0,0,0,,Không.
Dialogue: 0,0:03:15.80,0:03:18.76,Default,,0,0,0,,Cậu nhận lời thách đấu\Nlà biết ơn lắm rồi.
Dialogue: 0,0:03:19.39,0:03:23.96,Default,,0,0,0,,Đổi lại, nếu tớ thắng\Nthì đấu lại với luật công bằng hơn nhé.
Dialogue: 0,0:03:24.33,0:03:26.57,Default,,0,0,0,,Được. Hay đấy.
Dialogue: 0,0:03:34.28,0:03:35.40,Default,,0,0,0,,Ồ…
Dialogue: 0,0:03:35.64,0:03:37.73,Default,,0,0,0,,Có động lực hơn một chút chưa?
Dialogue: 0,0:03:37.89,0:03:41.25,Default,,0,0,0,,Trước giờ gần như không có cơ hội\Nđấu trực tiếp…
Dialogue: 0,0:03:41.51,0:03:44.27,Default,,0,0,0,,nhưng cậu nhanh hơn tôi tưởng\Ngấp khoảng ba lần đấy.
Dialogue: 0,0:03:44.63,0:03:48.57,Default,,0,0,0,,Kỹ thuật dẫn bóng, xuất phát và đổi hướng\Ncủa Umi cực kỳ nhanh.
Dialogue: 0,0:03:48.77,0:03:51.32,Default,,0,0,0,,Cướp bóng từ tay cậu ấy không dễ đâu.
Dialogue: 0,0:03:53.54,0:03:55.43,Default,,0,0,0,,Nào, lại nhé.
Dialogue: 0,0:03:55.57,0:03:57.50,Default,,0,0,0,,Cậu mà chớp mắt là bị vượt qua đấy.
Dialogue: 0,0:04:09.07,0:04:11.22,Default,,0,0,0,,Aomi… nhỉ?
Dialogue: 0,0:04:11.47,0:04:12.93,Default,,0,0,0,,Gọi Haru cũng được.
Dialogue: 0,0:04:13.23,0:04:16.27,Default,,0,0,0,,Khá đấy, Haru. Cậu cũng gọi tôi là Mai đi.
Dialogue: 0,0:04:16.44,0:04:19.27,Default,,0,0,0,,Ok, Mai. Chơi tới bến luôn nào.
Dialogue: 0,0:04:19.57,0:04:22.30,Default,,0,0,0,,Không, tôi thừa nhận cậu rồi,\Nnên đến đây thôi.
Dialogue: 0,0:04:22.87,0:04:25.40,Default,,0,0,0,,Thế là ý gì nhỉ?
Dialogue: 0,0:04:39.83,0:04:41.27,Default,,0,0,0,,Chỉ là tiểu xảo nhỉ.
Dialogue: 0,0:04:41.48,0:04:44.96,Default,,0,0,0,,Không tác dụng với người\Ncó khả năng bật nhảy ngang cậu đâu.
Dialogue: 0,0:04:45.27,0:04:46.52,Default,,0,0,0,,Đáng ghét…
Dialogue: 0,0:04:46.79,0:04:48.34,Default,,0,0,0,,Quả nhiên là vậy.
Dialogue: 0,0:04:48.34,0:04:50.43,Default,,0,0,0,,Do khác biệt chiều cao nhỉ.
Dialogue: 0,0:04:50.84,0:04:53.51,Default,,0,0,0,,Nếu Todo ném một cú tốt nhất…
Dialogue: 0,0:04:53.68,0:04:58.81,Default,,0,0,0,,thì dù tớ có nhảy hết cỡ\Ncũng chưa chắc chặn được.
Dialogue: 0,0:04:59.43,0:05:03.40,Default,,0,0,0,,Nhưng nếu với Haru\Nthì chỉ cần nhảy nhẹ là với tới.
Dialogue: 0,0:05:03.76,0:05:06.41,Default,,0,0,0,,Nghĩa là dù nhảy chậm một chút\Nthì vẫn kịp à.
Dialogue: 0,0:05:06.83,0:05:11.57,Default,,0,0,0,,Cú nhảy của Umi có thời gian trên không\Nrất dài, nhưng Todo cũng vậy.
Dialogue: 0,0:05:11.80,0:05:16.33,Default,,0,0,0,,Nếu không thể tận dụng thời gian trên không\Nđể giành ưu thế, người cao hơn sẽ thắng.
Dialogue: 0,0:05:17.99,0:05:21.16,Default,,0,0,0,,Đừng nhầm mà tỏ ra thương hại nhé, Chitose.
Dialogue: 0,0:05:22.53,0:05:25.15,Default,,0,0,0,,Cậu ấy đang cố gắng làm gương đấy.
Dialogue: 0,0:05:28.77,0:05:31.40,Default,,0,0,0,,Quả nhiên cậu sẽ làm vậy nhỉ.
Dialogue: 0,0:05:32.80,0:05:34.00,Default,,0,0,0,,Nhưng đáng tiếc…
Dialogue: 0,0:05:41.49,0:05:44.44,Default,,0,0,0,,Haru mà cao thêm 20cm\Nthì có lẽ đã khác.
Dialogue: 0,0:05:45.11,0:05:49.28,Default,,0,0,0,,Nhưng trong bóng rổ, 20cm đó\Ncó thể là tất cả đấy.
Dialogue: 0,0:05:49.90,0:05:53.82,Default,,0,0,0,,Chà… muốn thử thi đấu với Haru\Ncao 1m7 ghê.
Dialogue: 0,0:05:55.33,0:05:58.66,Default,,0,0,0,,Đừng có nói như thể\Ncậu đã thắng như vậy chứ.
Dialogue: 0,0:05:59.11,0:06:00.41,Default,,0,0,0,,Vẫn muốn tiếp tục à?
Dialogue: 0,0:06:00.67,0:06:02.83,Default,,0,0,0,,Tất nhiên. Chuẩn bị thua đi.
Dialogue: 0,0:06:05.36,0:06:07.37,Default,,0,0,0,,Todo Mai kinh thật.
Dialogue: 0,0:06:07.57,0:06:10.42,Default,,0,0,0,,Nhưng không ngờ Umi lại thua thảm như vậy.
Dialogue: 0,0:06:10.42,0:06:12.30,Default,,0,0,0,,Chênh lệch tận 20cm đấy.
Dialogue: 0,0:06:12.30,0:06:14.50,Default,,0,0,0,,Chiều cao cũng là tài năng mà.
Dialogue: 0,0:06:14.50,0:06:16.37,Default,,0,0,0,,Nhưng hơi thất vọng đấy.
Dialogue: 0,0:06:16.37,0:06:19.17,Default,,0,0,0,,Bình thường Umi hay lớn tiếng\Nchỉ đạo lắm cơ mà.
Dialogue: 0,0:06:19.17,0:06:21.81,Default,,0,0,0,,Nếu Nana làm đội trưởng thì…
Dialogue: 0,0:06:23.51,0:06:25.48,Default,,0,0,0,,Được rồi, tập trung.
Dialogue: 0,0:06:28.69,0:06:31.03,Default,,0,0,0,,Định đứng đó đến bao giờ hả?
Dialogue: 0,0:06:32.23,0:06:35.32,Default,,0,0,0,,Mau đi gọi con ngốc đó về đây.
Dialogue: 0,0:06:49.76,0:06:51.38,Default,,0,0,0,,Chào, nấm lùn.
Dialogue: 0,0:06:53.05,0:06:57.09,Default,,0,0,0,,Đến an ủi người ta\Nthì hơi bị muộn đấy.
Dialogue: 0,0:06:57.57,0:06:59.87,Default,,0,0,0,,Để hôn lên trán cậu\Nmột cái nhé?
Dialogue: 0,0:07:00.17,0:07:03.39,Default,,0,0,0,,Có bảo cậu làm người ta xấu hổ thêm đâu.
Dialogue: 0,0:07:06.67,0:07:09.40,Default,,0,0,0,,Đối thủ có vẻ đáng gờm nhỉ.
Dialogue: 0,0:07:10.64,0:07:12.61,Default,,0,0,0,,"Đối thủ" à…
Dialogue: 0,0:07:12.91,0:07:16.99,Default,,0,0,0,,Người ta còn chẳng nhớ tên tớ,\Nđúng là đau thật…
Dialogue: 0,0:07:16.99,0:07:17.86,Default,,0,0,0,,Ui da!
Dialogue: 0,0:07:18.05,0:07:22.54,Default,,0,0,0,,Ngốc này! Tớ cũng chẳng nhớ\Nmặt mũi đối thủ đâu.
Dialogue: 0,0:07:24.25,0:07:26.60,Default,,0,0,0,,Nhưng cách chơi thì luôn in sâu\Ntrong tâm trí.
Dialogue: 0,0:07:27.75,0:07:29.67,Default,,0,0,0,,Todo Mai cũng nói vậy mà.
Dialogue: 0,0:07:30.19,0:07:33.27,Default,,0,0,0,,Nhanh hơn tôi tưởng\Ngấp khoảng ba lần đấy.
Dialogue: 0,0:07:33.76,0:07:35.67,Default,,0,0,0,,Cái từ "tưởng" đấy.
Dialogue: 0,0:07:35.92,0:07:39.05,Default,,0,0,0,,Nếu hoàn toàn không nhớ\Nthì sẽ không nói như thế đâu.
Dialogue: 0,0:07:41.76,0:07:42.90,Default,,0,0,0,,Ra vậy.
Dialogue: 0,0:07:51.70,0:07:53.31,Default,,0,0,0,,Chẳng biết từ lúc nào mà Yuuko…
Dialogue: 0,0:07:53.31,0:07:57.65,Default,,0,0,0,,lại nói cậu ấy chỉ tham gia CLB cho vui,\Nkhông bận tâm đến chuyện thắng thua.
Dialogue: 0,0:07:58.36,0:08:02.70,Default,,0,0,0,,Tôi thề là tôi chưa bao giờ coi thường\Ncách tiếp cận thể thao như thế.
Dialogue: 0,0:08:05.25,0:08:08.29,Default,,0,0,0,,Ném bóng xa hơn ngày hôm qua…
Dialogue: 0,0:08:08.97,0:08:12.97,Default,,0,0,0,,Lần đầu đánh trúng bóng, hay bắt được một quả bóng cao…
Dialogue: 0,0:08:14.17,0:08:17.97,Default,,0,0,0,,Lẽ ra chỉ cần như vậy\Nlà đủ thấy mãn nguyện rồi mà…
Dialogue: 0,0:08:20.37,0:08:23.10,Default,,0,0,0,,Saku, Haru!
Dialogue: 0,0:08:28.36,0:08:32.40,Default,,0,0,0,,Giá mà tụi mình cũng có thể\Ntận hưởng thể thao một cách vui vẻ như thế.
Dialogue: 0,0:08:32.96,0:08:35.60,Default,,0,0,0,,Tụi mình thì không thể đâu.
Dialogue: 0,0:08:36.17,0:08:38.65,Default,,0,0,0,,Vì tâm hồn đã bị trói buộc mất rồi.
Dialogue: 0,0:08:40.23,0:08:43.77,Default,,0,0,0,,Từ nhỏ, mỗi ngày đều ép cơ thể tập luyện\Nđến kiệt sức.
Dialogue: 0,0:08:44.49,0:08:48.97,Default,,0,0,0,,Trải qua biết bao lần thất bại,\Nnhiều đêm mất ngủ vì nuối tiếc.
Dialogue: 0,0:08:50.23,0:08:52.53,Default,,0,0,0,,Dù vậy, mình vẫn muốn trở nên mạnh hơn.
Dialogue: 0,0:08:52.58,0:08:54.31,Default,,0,0,0,,Muốn trở thành số một.
Dialogue: 0,0:08:55.09,0:08:59.90,Default,,0,0,0,,Và kể cả khi đã từ bỏ,\Ntâm hồn vẫn không được giải thoát.
Dialogue: 0,0:09:00.09,0:09:03.30,Default,,0,0,0,,Đúng là chỉ có thể nói là "đã bị trói buộc".
Dialogue: 0,0:09:04.99,0:09:07.39,Default,,0,0,0,,Cậu nghĩ sao về những gì Mai nói?
Dialogue: 0,0:09:07.75,0:09:09.57,Default,,0,0,0,,Vụ 20cm ấy hả?
Dialogue: 0,0:09:09.76,0:09:11.65,Default,,0,0,0,,Đúng là một sự thật không thể phủ nhận.
Dialogue: 0,0:09:12.01,0:09:14.81,Default,,0,0,0,,Phải rồi nhỉ. Tớ cũng nghĩ vậy.
Dialogue: 0,0:09:15.72,0:09:20.90,Default,,0,0,0,,Nhưng… những cô gái có chiều cao\Ncũng có cái khổ riêng.
Dialogue: 0,0:09:21.63,0:09:26.03,Default,,0,0,0,,Với chiều cao đó, việc chạy nhảy liên tục\Nrất dễ dính chấn thương.
Dialogue: 0,0:09:26.52,0:09:29.93,Default,,0,0,0,,Dù là một ngôi sao bóng rổ,\Nnhưng là con gái…
Dialogue: 0,0:09:29.93,0:09:32.87,Default,,0,0,0,,chắc cậu ấy cũng từng phải nhận\Nnhững lời chê bai ác ý.
Dialogue: 0,0:09:33.88,0:09:39.38,Default,,0,0,0,,Tớ không muốn làm người chỉ biết nhìn\Ncái người khác có rồi sinh lòng ghen tị đâu.
Dialogue: 0,0:09:42.39,0:09:45.17,Default,,0,0,0,,Hỏi cậu một câu nhé.
Dialogue: 0,0:09:46.39,0:09:48.97,Default,,0,0,0,,Cậu có nghĩ\Nnỗ lực nhất định sẽ được đền đáp không?
Dialogue: 0,0:09:49.29,0:09:50.93,Default,,0,0,0,,Nếu tiếp tục nỗ lực chạy không ngừng,
Dialogue: 0,0:09:50.93,0:09:55.81,Default,,0,0,0,,liệu một ngày nào đó, tớ có thể đánh bại Mai\Nvà những đối thủ mạnh khác không?
Dialogue: 0,0:09:57.09,0:09:59.33,Default,,0,0,0,,Những điều Haru đang trăn trở lúc này…
Dialogue: 0,0:09:59.33,0:10:02.61,Default,,0,0,0,,chắc hẳn là những khát khao thuần khiết\Nnhưng lại quá đỗi trừu tượng.
Dialogue: 0,0:10:03.76,0:10:08.62,Default,,0,0,0,,Cảm giác như cậu ấy đang hỏi\N"cách sống của tớ có sai không?" vậy.
Dialogue: 0,0:10:10.33,0:10:12.07,Default,,0,0,0,,Chuyện đó thì tớ chịu.
Dialogue: 0,0:10:12.24,0:10:17.79,Default,,0,0,0,,Nhưng… giống như chẳng ai chứng minh được\Nlà nỗ lực sẽ được đền đáp…
Dialogue: 0,0:10:17.79,0:10:21.46,Default,,0,0,0,,chẳng ai chứng minh được\Nlà sẽ công cốc cả.
Dialogue: 0,0:10:23.04,0:10:27.80,Default,,0,0,0,,Nếu mỗi ngày ném thêm 100 quả bóng\Nthì chẳng phải có thể giỏi hơn sao?
Dialogue: 0,0:10:28.08,0:10:30.18,Default,,0,0,0,,Có thể trở thành số một chăng?
Dialogue: 0,0:10:30.53,0:10:34.02,Default,,0,0,0,,Vậy nếu ném 200 hay 300 quả thì sao?
Dialogue: 0,0:10:35.19,0:10:38.10,Default,,0,0,0,,Người duy nhất thấy được kết quả\Nchỉ có bản thân mà thôi.
Dialogue: 0,0:10:38.47,0:10:42.15,Default,,0,0,0,,Nếu thực sự muốn biết câu trả lời\Nthì cậu hãy tự tìm hiểu đi.
Dialogue: 0,0:10:44.23,0:10:46.45,Default,,0,0,0,,Thật tốt vì đã hỏi cậu.
Dialogue: 0,0:10:46.63,0:10:49.62,Default,,0,0,0,,Câu trả lời rất đúng ý tớ đấy. Yêu lắm cơ.
Dialogue: 0,0:10:53.47,0:10:56.62,Default,,0,0,0,,Tớ sẽ tiếp tục chiến đấu.\NChitose cũng đừng bỏ chạy nhé.
Dialogue: 0,0:11:22.79,0:11:25.76,Default,,0,0,0,,Bác ơi, cho bốn xiên lớn có sốt.
Dialogue: 0,0:11:25.76,0:11:29.59,Default,,0,0,0,,Lại nữa à? Tại mấy đứa mà chẳng buôn bán\Nđược gì cả.
Dialogue: 0,0:11:30.08,0:11:32.33,Default,,0,0,0,,Năm người phải không?\NCòn cô bé kia?
Dialogue: 0,0:11:32.59,0:11:34.43,Default,,0,0,0,,Cháu cũng xiên lớn ạ.
Dialogue: 0,0:11:34.43,0:11:36.67,Default,,0,0,0,,Vậy còn cậu bé đeo kính to tướng kia?
Dialogue: 0,0:11:36.67,0:11:39.60,Default,,0,0,0,,Dạ, cháu thì một xiên thường sốt yakisoba ạ.
Dialogue: 0,0:11:39.60,0:11:42.90,Default,,0,0,0,,Gì chứ, ẻo lả thế. Gọi xiên lớn luôn đi nhé.
Dialogue: 0,0:11:43.17,0:11:44.52,Default,,0,0,0,,Rốt cuộc muốn thế nào?
Dialogue: 0,0:11:47.55,0:11:51.57,Default,,0,0,0,,Cơ mà… Ucchi với Yuzuki thì lo giữ dáng\Nnên không nói…
Dialogue: 0,0:11:51.80,0:11:53.32,Default,,0,0,0,,sao không rủ Yuuko?
Dialogue: 0,0:11:56.07,0:11:58.57,Default,,0,0,0,,Bảo là sợ rong biển dính răng\Nnên không đi.
Dialogue: 0,0:11:59.77,0:12:01.14,Default,,0,0,0,,Gì vậy chứ?
Dialogue: 0,0:12:01.40,0:12:02.44,Default,,0,0,0,,Hừ.
Dialogue: 0,0:12:03.73,0:12:06.84,Default,,0,0,0,,Đúng rồi, Kenta đã thích ai chưa?
Dialogue: 0,0:12:08.15,0:12:10.34,Default,,0,0,0,,Sao tự dưng hỏi thế, Asano?
Dialogue: 0,0:12:10.34,0:12:12.87,Default,,0,0,0,,Thì mùa hè là mùa của tình yêu mà.
Dialogue: 0,0:12:12.87,0:12:13.60,Default,,0,0,0,,Tình yêu!
Dialogue: 0,0:12:13.84,0:12:17.87,Default,,0,0,0,,Năm ngoái cũng vậy, mùa hè đến\Nlà xuất hiện một đống cặp đôi.
Dialogue: 0,0:12:17.87,0:12:19.60,Default,,0,0,0,,Thật đáng ghen tị.
Dialogue: 0,0:12:19.77,0:12:23.98,Default,,0,0,0,,Nhưng hết hè thì cũng là cái kết\Ncủa nhiều cuộc tình mà.
Dialogue: 0,0:12:23.98,0:12:25.92,Default,,0,0,0,,Thế thì cho đáng đời thôi.
Dialogue: 0,0:12:26.23,0:12:28.19,Default,,0,0,0,,Thế, còn cậu thì sao, Kenta?
Dialogue: 0,0:12:29.11,0:12:31.97,Default,,0,0,0,,Tớ cũng không biết\Ncó nên hỏi câu này không…
Dialogue: 0,0:12:32.27,0:12:34.95,Default,,0,0,0,,Giả sử, giả sử thôi nhé…
Dialogue: 0,0:12:35.20,0:12:38.88,Default,,0,0,0,,Nếu cậu thích một người,\Nmà người đó lại thích bạn cậu…
Dialogue: 0,0:12:38.88,0:12:41.75,Default,,0,0,0,,Hay cậu và bạn cậu\Nlại thích cùng một người…
Dialogue: 0,0:12:42.52,0:12:44.52,Default,,0,0,0,,thì các cậu sẽ làm thế nào?
Dialogue: 0,0:12:52.33,0:12:53.68,Default,,0,0,0,,Hả?
Dialogue: 0,0:12:55.39,0:12:58.93,Default,,0,0,0,,Gì vậy hả, Kenta? Muốn tuyên chiến với bọn này à?
Dialogue: 0,0:12:58.93,0:13:00.18,Default,,0,0,0,,K-Không phải!
Dialogue: 0,0:13:00.18,0:13:01.94,Default,,0,0,0,,Ucchi hả? Hay Yuzuki?
Dialogue: 0,0:13:02.10,0:13:05.19,Default,,0,0,0,,Khoan, đừng nói là Haru đấy nhé!
Dialogue: 0,0:13:05.53,0:13:08.73,Default,,0,0,0,,Cái gì mà "đừng nói là" chứ?
Dialogue: 0,0:13:09.15,0:13:13.49,Default,,0,0,0,,Ồ, Yamazaki, cậu nhìn Haru-chan\Nnhư thế sao?
Dialogue: 0,0:13:13.73,0:13:16.70,Default,,0,0,0,,Không, không, không!\NTuyệt đối không có chuyện đó đâu.
Dialogue: 0,0:13:16.70,0:13:18.24,Default,,0,0,0,,Cậu đừng lo, Aomi.
Dialogue: 0,0:13:18.45,0:13:22.50,Default,,0,0,0,,Xin lỗi, Yamazaki,\Nnhưng phản ứng đó hơi bị tổn thương đấy.
Dialogue: 0,0:13:23.53,0:13:26.23,Default,,0,0,0,,Kaito đã lên tiếng cứu nguy\Nthật đúng lúc.
Dialogue: 0,0:13:26.67,0:13:30.67,Default,,0,0,0,,Nhưng có lẽ cậu ấy không hề\Nmuốn đóng vai trò đó.
Dialogue: 0,0:13:31.33,0:13:34.27,Default,,0,0,0,,Cái tên bị gạt ra một cách vô thức kia…
Dialogue: 0,0:13:34.54,0:13:37.52,Default,,0,0,0,,có lẽ giờ đang lạc lối trong lặng lẽ…
Dialogue: 0,0:13:37.52,0:13:40.06,Default,,0,0,0,,như chiếc bập bênh\Ncô đơn trong ánh hoàng hôn vậy.
Dialogue: 0,0:13:42.19,0:13:44.20,Default,,0,0,0,,Tôi đơn giản lắm.
Dialogue: 0,0:13:44.20,0:13:48.93,Default,,0,0,0,,Nếu thích ai thì muốn được người đó đáp lại,\Nđược hẹn hò thì còn gì bằng.
Dialogue: 0,0:13:49.41,0:13:54.56,Default,,0,0,0,,Nhưng nếu người đem lại niềm vui lớn nhất\Ncho cô ấy lại là thằng bạn thân…
Dialogue: 0,0:13:54.56,0:13:57.53,Default,,0,0,0,,thì tôi không muốn cố chen ngang đâu.
Dialogue: 0,0:13:58.80,0:14:03.75,Default,,0,0,0,,Bởi vì điều khiến tôi rung động\Nlà nụ cười khi họ ở bên nhau mà.
Dialogue: 0,0:14:04.21,0:14:08.33,Default,,0,0,0,,Vì vậy, nếu có lúc\Ntôi muốn thay đổi mối quan hệ đó…
Dialogue: 0,0:14:08.33,0:14:12.71,Default,,0,0,0,,thì đó là lúc tôi cảm thấy\Ntôi có thể đem lại nhiều nụ cười hơn cho cô ấy.
Dialogue: 0,0:14:13.13,0:14:15.84,Default,,0,0,0,,Đến lúc đó, có phải đánh nhau\Ntôi cũng giành.
Dialogue: 0,0:14:16.72,0:14:19.47,Default,,0,0,0,,Tớ thì chẳng hiểu nổi chuyện đó.
Dialogue: 0,0:14:20.16,0:14:22.89,Default,,0,0,0,,Tớ muốn tự mang lại nụ cười\Ncho người mình yêu.
Dialogue: 0,0:14:23.17,0:14:27.77,Default,,0,0,0,,Muốn bảo vệ họ khi họ buồn,\Nmuốn ở bên họ khi họ khóc.
Dialogue: 0,0:14:27.98,0:14:30.48,Default,,0,0,0,,Tớ không muốn ai khác làm điều đó cả.
Dialogue: 0,0:14:31.04,0:14:32.32,Default,,0,0,0,,Kiểu vậy.
Dialogue: 0,0:14:32.77,0:14:34.65,Default,,0,0,0,,Haru mạnh mẽ thật.
Dialogue: 0,0:14:34.65,0:14:38.57,Default,,0,0,0,,Nhưng đúng là mùa hè cứ làm ta háo hức,\Nnhư sắp có chuyện gì vậy.
Dialogue: 0,0:14:38.70,0:14:40.81,Default,,0,0,0,,Ừ, đúng là thế thật.
Dialogue: 0,0:14:41.05,0:14:43.34,Default,,0,0,0,,Có câu "trọn một mùa hè" mà.
Dialogue: 0,0:14:43.80,0:14:47.33,Default,,0,0,0,,Chỉ có mùa hè là có khởi đầu và kết thúc rõ ràng.
Dialogue: 0,0:14:48.00,0:14:53.38,Default,,0,0,0,,Vì vậy, sau mỗi mùa hè, tớ lại cảm thấy\Nbản thân đã có gì đó thay đổi.
Dialogue: 0,0:14:55.75,0:14:59.26,Default,,0,0,0,,Vậy năm nay đã có gì thay đổi nhỉ.
Dialogue: 0,0:15:02.52,0:15:03.45,Default,,0,0,0,,Chào mừng.
Dialogue: 0,0:15:06.77,0:15:08.77,Default,,0,0,0,,Chitose… đấy à?
Dialogue: 0,0:15:09.66,0:15:10.52,Default,,0,0,0,,Chào thầy.
Dialogue: 0,0:15:10.52,0:15:13.42,Default,,0,0,0,,Chắc đang thấy "đáng đời", đúng không?
Dialogue: 0,0:15:13.42,0:15:15.36,Default,,0,0,0,,Ý thầy là sao ạ?
Dialogue: 0,0:15:17.05,0:15:18.95,Default,,0,0,0,,Chưa nghe thì thôi.
Dialogue: 0,0:15:23.03,0:15:28.13,Default,,0,0,0,,Saku, người đó cứ u uất mãi đấy.
Dialogue: 0,0:15:28.42,0:15:30.88,Default,,0,0,0,,Bảo là mình đã vùi dập một tài năng lớn.
Dialogue: 0,0:15:31.34,0:15:33.84,Default,,0,0,0,,Cháu không nghĩ mình bị thầy ấy vùi dập đâu.
Dialogue: 0,0:15:34.06,0:15:37.17,Default,,0,0,0,,Dù lý do là gì, chính cháu\Nđã tự quyết định bỏ.
Dialogue: 0,0:15:37.58,0:15:41.55,Default,,0,0,0,,Người lớn không phải lúc nào cũng\Nđúng hết được.
Dialogue: 0,0:15:41.80,0:15:44.00,Default,,0,0,0,,Bác chỉ muốn nói vậy thôi.
Dialogue: 0,0:15:46.39,0:15:48.99,Default,,0,0,0,,Dù bây giờ có nói thế đi nữa…
Dialogue: 0,0:15:49.68,0:15:51.94,Default,,0,0,0,,thì cũng không thể tìm thấy lối thoát\Ncho mùa hè đó.
Dialogue: 0,0:15:57.24,0:15:58.50,Default,,0,0,0,,Chitose.
Dialogue: 0,0:15:59.58,0:16:00.70,Default,,0,0,0,,Được gọi kìa.
Dialogue: 0,0:16:02.90,0:16:05.40,Default,,0,0,0,,FUJI
Dialogue: 0,0:16:08.39,0:16:11.42,Default,,0,0,0,,Yusuke bị chấn thương,\Ncần hai tuần để hồi phục ư?
Dialogue: 0,0:16:12.04,0:16:14.92,Default,,0,0,0,,Cậu ấy bị trật mắt cá chân\Nlúc trượt về gôn.
Dialogue: 0,0:16:15.59,0:16:17.69,Default,,0,0,0,,Trận đầu giải mùa hè là tuần sau.
Dialogue: 0,0:16:18.42,0:16:19.50,Default,,0,0,0,,Không kịp nổi.
Dialogue: 0,0:16:19.82,0:16:24.33,Default,,0,0,0,,Giải đấu đã cận kề, đúng ra\Nkhông nên cố như vậy khi đấu tập chứ.
Dialogue: 0,0:16:24.95,0:16:29.56,Default,,0,0,0,,Không, ít nhất thì đối với bóng chày,\Ncậu ấy luôn là người nghiêm túc và nhiệt huyết.
Dialogue: 0,0:16:30.15,0:16:33.23,Default,,0,0,0,,Dù mình là chân chạy,\Ncậu ấy cũng sẽ không do dự mà lao vào.
Dialogue: 0,0:16:34.73,0:16:37.83,Default,,0,0,0,,Đối với Yusuke, người không được\Nthi đấu năm ngoái,
Dialogue: 0,0:16:38.04,0:16:41.20,Default,,0,0,0,,đây là cơ hội để nhắm tới Koshien mùa hè,\Nvậy mà…
Dialogue: 0,0:16:45.80,0:16:47.24,Default,,0,0,0,,Đối thủ trận đầu tiên là ai?
Dialogue: 0,0:16:47.50,0:16:48.47,Default,,0,0,0,,Trường Ekkou.
Dialogue: 0,0:16:48.68,0:16:51.08,Default,,0,0,0,,Đến bốc thăm cũng xui xẻo luôn à,\Ncái thằng này…
Dialogue: 0,0:16:51.58,0:16:55.57,Default,,0,0,0,,Vậy mang hoa đến thăm bệnh cậu ấy\Nlà được chứ gì.
Dialogue: 0,0:16:55.85,0:16:58.59,Default,,0,0,0,,Biết là chuyện này thật quá đáng,\Nnhưng Saku…
Dialogue: 0,0:17:00.63,0:17:02.25,Default,,0,0,0,,Xin cậu hãy quay lại đội bóng.
Dialogue: 0,0:17:03.13,0:17:05.47,Default,,0,0,0,,Có hiểu cậu vừa nói gì không?
Dialogue: 0,0:17:05.82,0:17:08.93,Default,,0,0,0,,Khi đấu với Ekkou thì chắc chắn\Nsẽ phải đọ tay ném.
Dialogue: 0,0:17:09.13,0:17:11.26,Default,,0,0,0,,Hãy cho bọn tôi mượn sức mạnh.
Dialogue: 0,0:17:11.45,0:17:15.17,Default,,0,0,0,,Dù vậy cũng đâu dễ đến mức\Ntôi quay về là thắng.
Dialogue: 0,0:17:15.65,0:17:17.77,Default,,0,0,0,,Đừng coi thường bóng chày như thế.
Dialogue: 0,0:17:18.44,0:17:21.97,Default,,0,0,0,,Vì biết cậu không bao giờ coi thường bóng chày\Nnên tôi mới nhờ cậu.
Dialogue: 0,0:17:22.54,0:17:25.13,Default,,0,0,0,,Yusuke bảo cậu tìm tôi hả?
Dialogue: 0,0:17:25.37,0:17:26.60,Default,,0,0,0,,Không.
Dialogue: 0,0:17:26.60,0:17:29.67,Default,,0,0,0,,Cậu ấy bảo tuyệt đối không được\Nnói với Saku.
Dialogue: 0,0:17:29.86,0:17:33.53,Default,,0,0,0,,Cậu ấy nói chắc chắn Saku\Nđang phiền não chuyện gì khác…
Dialogue: 0,0:17:33.53,0:17:35.54,Default,,0,0,0,,chứ không phải không muốn quay lại\Nchơi bóng chày.
Dialogue: 0,0:17:37.59,0:17:40.92,Default,,0,0,0,,Nếu là chuyện hôm đó\Nthì muốn tôi xin lỗi bao nhiêu lần cũng được.
Dialogue: 0,0:17:41.14,0:17:46.84,Default,,0,0,0,,Tôi muốn trao cho Yusuke, người đã luôn\Ncố gắng suốt một năm qua, một cơ hội thi đấu!
Dialogue: 0,0:17:54.44,0:17:57.81,Default,,0,0,0,,Đừng có mạnh miệng!
Dialogue: 0,0:17:58.19,0:18:01.03,Default,,0,0,0,,Tại sao lúc Chitose rút lui thì các cậu\Nkhông nói thế?
Dialogue: 0,0:18:01.29,0:18:03.56,Default,,0,0,0,,Nếu vẫn coi Chitose là bạn…
Dialogue: 0,0:18:03.95,0:18:07.82,Default,,0,0,0,,thì có lẽ bây giờ, cậu ấy\Nvẫn đang đuổi theo quả bóng cùng các cậu rồi.
Dialogue: 0,0:18:08.01,0:18:12.45,Default,,0,0,0,,Nếu ghét cậu ấy đến mức không thèm chốt hạ\Nthì còn có thể hiểu.
Dialogue: 0,0:18:12.81,0:18:16.33,Default,,0,0,0,,Nếu là vậy thì đừng bao giờ\Ndính dáng đến Chitose nữa!
Dialogue: 0,0:18:16.96,0:18:18.86,Default,,0,0,0,,Cậu thì hiểu cái gì chứ?
Dialogue: 0,0:18:18.86,0:18:21.28,Default,,0,0,0,,Ờ, chẳng muốn hiểu…
Dialogue: 0,0:18:21.28,0:18:24.97,Default,,0,0,0,,cảm giác của một đám hèn nhát\Nchỉ biết cam chịu thất bại đâu.
Dialogue: 0,0:18:25.72,0:18:27.71,Default,,0,0,0,,Trong giải đấu giải mùa hè năm ngoái,
Dialogue: 0,0:18:27.71,0:18:30.76,Default,,0,0,0,,các cậu đã mất đi ý chí chiến đấu\Ngiữa chừng đúng không?
Dialogue: 0,0:18:30.98,0:18:33.08,Default,,0,0,0,,Rồi bắt đầu biện hộ với lý do rằng…
Dialogue: 0,0:18:33.08,0:18:38.06,Default,,0,0,0,,với cái đội bóng này, khi đấu với đội mạnh,\Nchúng ta đã làm rất tốt rồi.
Dialogue: 0,0:18:38.23,0:18:43.69,Default,,0,0,0,,Chỉ có Chitose là cố gắng hết sức\Nđể giành chiến thắng cho đến phút cuối.
Dialogue: 0,0:18:44.66,0:18:47.83,Default,,0,0,0,,Nhìn thấy người tài năng hơn mình thất bại,
Dialogue: 0,0:18:47.83,0:18:50.95,Default,,0,0,0,,cái tôi bé xíu của các cậu\Ncó thấy thỏa mãn không?
Dialogue: 0,0:18:54.84,0:18:57.62,Default,,0,0,0,,Xin lỗi, nhưng tôi không đổi ý đâu.
Dialogue: 0,0:19:00.25,0:19:02.00,Default,,0,0,0,,Làm mất thời gian của cậu rồi.
Dialogue: 0,0:19:07.98,0:19:10.90,Default,,0,0,0,,Chitose, đợi tớ tập xong nhé.
Dialogue: 0,0:19:11.82,0:19:15.27,Default,,0,0,0,,Hôm nay không được về một mình\Nđâu đấy.
Dialogue: 0,0:19:18.87,0:19:21.15,Default,,0,0,0,,Đau đấy, đồ ngốc.
Dialogue: 0,0:19:37.43,0:19:40.48,Default,,0,0,0,,Tớ thường hay đến chỗ này lắm.
Dialogue: 0,0:19:40.48,0:19:44.04,Default,,0,0,0,,Mỗi khi gặp chuyện buồn ở CLB, mỗi khi\Ncó chuyện bực bội,
Dialogue: 0,0:19:44.04,0:19:46.07,Default,,0,0,0,,mỗi khi cảm thấy sắp đánh mất bản thân.
Dialogue: 0,0:19:47.43,0:19:51.21,Default,,0,0,0,,Và mỗi khi cảm thấy tương lai thật mù mịt.
Dialogue: 0,0:19:51.83,0:19:54.79,Default,,0,0,0,,Haru cũng có những lúc như thế sao?
Dialogue: 0,0:19:55.22,0:19:59.33,Default,,0,0,0,,Chơi bóng rổ với chiều cao này\Nthì toàn những lúc như vậy thôi.
Dialogue: 0,0:19:59.90,0:20:02.77,Default,,0,0,0,,Nên tớ sẽ đến đây để hét to lên.
Dialogue: 0,0:20:03.05,0:20:06.77,Default,,0,0,0,,Như trút hết mọi bực tức xuống dòng sông,\Nvà hét lên…
Dialogue: 0,0:20:06.77,0:20:08.69,Default,,0,0,0,,Umi là đồ ngốc!
Dialogue: 0,0:20:08.96,0:20:09.78,Default,,0,0,0,,Kiểu vậy.
Dialogue: 0,0:20:10.17,0:20:13.32,Default,,0,0,0,,Đừng có trút giận vào dòng sông chứ.\NNói với Umi đi.
Dialogue: 0,0:20:15.00,0:20:17.62,Default,,0,0,0,,Nhắm đến đỉnh cao mệt thật đấy.
Dialogue: 0,0:20:17.82,0:20:22.17,Default,,0,0,0,,Nhưng may thay, tớ luôn có\Nnhững người bạn tốt bên cạnh.
Dialogue: 0,0:20:22.46,0:20:29.72,Default,,0,0,0,,Bây giờ cũng có Nana, Sen, You,\Ntuy hay phàn nàn nhưng vẫn luôn ở bên tớ.
Dialogue: 0,0:20:31.02,0:20:35.89,Default,,0,0,0,,Đúng như Mai nói,\Ntớ là một tuyển thủ khiếm khuyết.
Dialogue: 0,0:20:36.34,0:20:40.18,Default,,0,0,0,,Nhưng nếu có họ bên cạnh,\Nlần tới tớ nhất định sẽ không thua.
Dialogue: 0,0:20:44.61,0:20:46.48,Default,,0,0,0,,Còn nhớ chuyện ở vách đá không?
Dialogue: 0,0:20:46.71,0:20:49.11,Default,,0,0,0,,Cái xích đu lúc hoàng hôn ấy.
Dialogue: 0,0:20:49.29,0:20:52.31,Default,,0,0,0,,Người thua sẽ… để xem nào…
Dialogue: 0,0:20:52.70,0:20:57.45,Default,,0,0,0,,Một lúc nào đó… sẽ thổ lộ hết những\Nyếu đuối thầm kín với người thắng thì sao?
Dialogue: 0,0:20:57.58,0:20:58.73,Default,,0,0,0,,Chơi luôn!
Dialogue: 0,0:20:59.38,0:21:02.47,Default,,0,0,0,,Là người chiến thắng lần đó,\NHaru-chan ra lệnh.
Dialogue: 0,0:21:02.47,0:21:04.54,Default,,0,0,0,,Hãy thổ lộ ngay tại đây đi.
Dialogue: 0,0:21:05.54,0:21:09.40,Default,,0,0,0,,Viên bi thủy tinh lăn lóc trong lòng\Nphát ra tiếng kêu leng keng.
Dialogue: 0,0:21:10.09,0:21:15.16,Default,,0,0,0,,Đó là một âm thanh yếu ớt, đã bị giam giữ\Ntrong chai thủy tinh suốt bao lâu nay.
Dialogue: 0,0:21:16.39,0:21:17.80,Default,,0,0,0,,Sẽ ổn thôi.
Dialogue: 0,0:21:18.22,0:21:22.85,Default,,0,0,0,,Dù Chitose có đau khổ thế nào,\Ntớ cũng sẽ mang lại nụ cười cho cậu.
Dialogue: 0,0:21:23.39,0:21:28.40,Default,,0,0,0,,Sẽ ở bên khi cậu buồn bã,\Ncùng trút giận khi cậu bực tức.
Dialogue: 0,0:21:28.90,0:21:34.17,Default,,0,0,0,,Sẽ mắng cậu khi cậu yếu đuối,\Nvà tiếp thêm dũng khí khi cậu không thể đứng lên.
Dialogue: 0,0:21:35.34,0:21:37.73,Default,,0,0,0,,Nên hãy kể đi.
Dialogue: 0,0:21:39.94,0:21:43.07,Default,,0,0,0,,Ôi, đúng là chói mắt thật.
Dialogue: 0,0:21:44.06,0:21:47.03,Default,,0,0,0,,Những gánh nặng mình đã mang theo\Nbấy lâu nay…
Dialogue: 0,0:21:47.03,0:21:49.55,Default,,0,0,0,,có lẽ có thể giao phó hết cho cô gái này.
Dialogue: 0,0:21:50.41,0:21:53.71,Default,,0,0,0,,Khoảng trống tối tăm cứ bám chặt\Ntrong trái tim bấy lâu nay…
Dialogue: 0,0:21:53.71,0:21:56.66,Default,,0,0,0,,có lẽ cô gái này có thể xua tan hết.
Dialogue: 0,0:21:58.18,0:22:02.87,Default,,0,0,0,,Bằng nụ cười mạnh mẽ và tươi sáng\Nnhư ánh mặt trời đó.
Dialogue: 0,0:23:36.83,0:23:40.04,Default,,0,0,0,,Kỳ tới: Orihime giận dỗi và Hikoboshi bận rộn

